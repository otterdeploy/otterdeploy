      "file": "packages/api/src/caddy/builder.ts",
      "exports": ["*"]
    },
    {
      "file": "packages/api/src/lib/platform-runtime-settings.ts",
      "exports": ["*"]
    },
    // Vendored shadcn/ui primitives. Each file is the whole upstream component
    // surface, so parts of it are unused until a screen reaches for them —
    // deleting those would fork the file from upstream and `shadcn add` would
    // just put them back. Same reasoning as ui/field.tsx above.
    {
      "file": "apps/web/src/shared/components/ui/alert-dialog.tsx",
