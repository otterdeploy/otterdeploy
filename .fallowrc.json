{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Patterns are RESOLVED FROM THE REPO ROOT, not per-workspace. Each app's
  // main entry already comes from its package.json `main`; everything listed
  // here is a process the module graph cannot reach by static import.
  "entry": [
    // Spawned as `bun run src/build-one.ts <deploymentId>` inside the
    // throwaway helper container — see apps/builder/src/helper-args.ts.
    "apps/builder/src/build-one.ts",
    // Deployed as a swarm GLOBAL service, one task per node; boots from raw
    // env with no DB — see docs/designs/server-health-agent.md.
    "apps/server/src/health-agent.ts",
    // TanStack Start server entry.
    "apps/www/src/start.ts",
    // One-shot operator/CI scripts, invoked by path from package.json scripts.
    "scripts/**/*.{ts,js,mjs}",
    "apps/*/scripts/**/*.{ts,js,mjs}",
    "packages/*/scripts/**/*.{ts,js,mjs}",
    "test-infra/scripts/**/*.{ts,js,mjs}"
  ],
  // `brand/` is deliberately outside the bun workspaces (see brand/package.json:
  // Playwright is build-time-only and must not enter the app dependency graph),
  // so analysing it only produces undeclared-workspace noise.
  "ignorePatterns": ["research/**", ".agents/**", ".claude/**", "brand/**"],
  // `collections/*` is the virtual module fumadocs-mdx generates at postinstall
  // for apps/www; it has no package.json entry to resolve against.
  //
  // `maxmind` and `ssh2-sftp-client` are optional deps reached only through
  // runtime-resolved dynamic imports (edge-logs/geo.ts builds the module name
  // as a variable; db/storage.ts lazy-imports the sftp backend), so the static
  // graph can never see them. Both package.jsons carry a note explaining why.
  "ignoreDependencies": ["collections", "maxmind", "ssh2-sftp-client"],
  "workspaces": {
    "packages": ["apps/*", "packages/*"]
  },
  "duplicates": {
    "minOccurrences": 2
  },
  "rules": {},
  "ignoreExports": [
    // In-flight branch-head/deployment-sha work (commit 48340ad6): defined and
    // documented (see the `fetchPullRequestHead` doc in github-pulls.ts) but not
    // yet wired to a caller. Not dead code — don't let `fix` unexport it.
    {
      "file": "packages/api/src/git/github-app.ts",
      "exports": ["fetchBranchHeadSha"]
    },
    {
      "file": "apps/web/src/features/projects/components/new-resource/form-primitives.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/shared/components/ui/field.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/features/projects/components/graph/resource-node.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/features/projects/components/graph/resource-to-node.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/features/projects/components/framework-logo.tsx",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/features/projects/components/new-resource/frameworks.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/cli/src/config-file.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/cli/src/config.ts",
      "exports": ["*"]
    },
    {
      "file": "packages/api/src/routers/backups/contract.ts",
      "exports": ["*"]
    },
    {
      "file": "packages/api/src/routers/notifications/contract.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/features/backups/shared.tsx",
