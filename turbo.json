{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "www#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "OTTERDEPLOY_DOCS_VERSION",
        "OTTERDEPLOY_OPENAPI_SPEC_URL",
        "OTTERSTACK_OPENAPI_SPEC_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
      "outputs": [".output/**", ".wrangler/deploy/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "www#typecheck": {
      "outputs": ["src/routeTree.gen.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false
    },
    "//#infra": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["//#infra"],
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "interactive": true,
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:start": {
      "cache": false,
      "persistent": true
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    }
  }
}
