# Home Assistant 2026.8.3 environment schema (@env-spec / varlock format).
#
# The compose previously pinned the floating minor tag
# `ghcr.io/home-assistant/home-assistant:2025.8`, which on 2026-09-03
# (research date) still resolved to 2025.8.3, an image built 2025-08-21 and
# twelve months stale. It is now pinned to 2026.8.3 (released 2026-08-21).
# 2026.9.0 shipped 2026-09-02, one day before this research; Home Assistant
# ships a feature release on the first Wednesday of every month and patches
# it for the rest of the month, so the matured 2026.8 line is the pin and
# 2026.9 becomes it once its own patches land.
#
# READ THIS FIRST: Home Assistant is NOT configured through the environment.
# Its configuration surface is `/config/configuration.yaml` (the mounted
# `homeassistant-config` volume) plus the onboarding flow and the UI's own
# config entries, stored in `/config/.storage`. Everything an operator
# normally tunes is a YAML key or a UI setting, not a variable: the time
# zone, the HTTP server port, trusted proxies, TLS, logging levels, every
# integration and its credentials. This file is therefore deliberately short.
# Padding it with plausible-looking `HASS_*` names would be fiction: no such
# variables exist.
#
# Source: grep of `os.environ` / `os.getenv` across the whole `homeassistant/`
# package at tag 2026.8.3, plus the image's own S6 service script
# (`rootfs/etc/services.d/home-assistant/run`) and the `ENV` lines baked into
# the published amd64 image config. That grep returns exactly nine names, and
# nothing else in the tree reads the environment: SOFT_FILE_LIMIT,
# HA_DISABLE_LOG_FILE, HA_DUPLICATE_LOG_FILE, SETUP_PORT, REQUESTS_CA_BUNDLE,
# and the four Supervisor ones (SUPERVISOR, SUPERVISOR_TOKEN,
# SUPERVISOR_CORE_API_SOCKET, SUPERVISOR_RESTORE_JOB_ID). There is no dotenv
# loader in the codebase, so a `.env` file inside /config does nothing.
#
# The four Supervisor variables are NOT declared below on purpose. They are
# injected by Home Assistant Supervisor (the OS / Supervised installs); this
# template is Home Assistant Container, where nothing sets them and nothing
# should. Merely having `SUPERVISOR` present in the environment flips Core
# into Supervisor mode: the default HTTP port becomes 80 instead of 8123, the
# `home-assistant.log` file is suppressed, and the `hassio` integration is
# force-loaded and then errors out because there is no Supervisor to talk to.
#
# Note also that Home Assistant does NOT honour HTTP_PROXY/HTTPS_PROXY: its
# aiohttp sessions are created without `trust_env`, so those standard
# variables are ignored no matter what you set them to.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Configuration.yaml", https://www.home-assistant.io/docs/configuration/)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# Container-local timezone, the one variable the compose sets. Home Assistant
# Core never reads it; `homeassistant/util/dt.py` starts at UTC and is
# overridden only by the `homeassistant: time_zone:` key in
# configuration.yaml (or by what you pick during onboarding, persisted to
# /config/.storage/core.config). TZ is honoured by the C library underneath,
# so it is what the Python `logging` timestamps and any subprocess see. Set
# it to match your `time_zone:` so log lines and entity history read the
# same; changing it alone will NOT move automations or sun triggers.
# @docs("Basic configuration - time_zone", https://www.home-assistant.io/docs/configuration/basic/)
TZ=UTC

# Overrides the DEFAULT HTTP port Core listens on when configuration.yaml
# does not pin one (`homeassistant/components/http/config.py`,
# default_server_port). The compose exposes container port 8123 with no
# override, so this is that port's twin: setting it without also changing
# the exposed port breaks routing to the UI. An unparseable value is logged
# and ignored, falling back to 8123. An explicit `http: server_port:` in
# configuration.yaml wins over this variable.
# @type=port
# @docs("HTTP integration", https://www.home-assistant.io/integrations/http/)
SETUP_PORT=8123

# Maximum open file descriptors (RLIMIT_NOFILE soft limit) Core raises itself
# to at startup, read by `homeassistant/util/resource.py`. It never lowers an
# already-higher limit and never exceeds the hard limit. Raise it only if the
# log shows "Too many open files". A large install with many integrations
# and long-lived websockets is the usual cause.
# @type=number
SOFT_FILE_LIMIT=2048

# ─── Logging ──────────────────────────────────────────────────────────────

# Set truthy (1/true/yes/on/enable) to stop Core writing
# /config/home-assistant.log entirely; log output then only goes to the
# container's stdout, i.e. `docker logs`. Useful when the config volume is
# on slow or wear-sensitive storage. An unparseable value is warned about
# and ignored. This is about the log FILE only, not per-integration log
# LEVELS, which are the `logger:` block in configuration.yaml.
# @type=boolean
# @docs("Logger integration", https://www.home-assistant.io/integrations/logger/)
HA_DISABLE_LOG_FILE=

# Supervisor-install-only escape hatch: under Supervisor the log file is
# suppressed by default, and setting this to any value (presence is what
# counts) writes it anyway. On this container install the log file is
# already written, so this does nothing. Listed because it appears in the
# same code path and gets copied out of Supervisor compose snippets.
HA_DUPLICATE_LOG_FILE=

# ─── TLS for outbound requests ────────────────────────────────────────────

# Path INSIDE the container to a PEM bundle used to verify TLS certificates
# on outbound connections (`homeassistant/util/ssl.py` reuses the requests
# convention). Empty falls back to the certifi bundle shipped in the image.
# Point it at a file you mount into /config when an integration has to talk
# to a device or service with a private/self-signed CA. This replaces the
# trust store rather than adding to it, so the bundle must contain the public
# roots you still need.
REQUESTS_CA_BUNDLE=

# ─── Image runtime (baked into the published image) ───────────────────────

# Python's object allocator. The image's S6 run script exports `mimalloc`
# (bundled in CPython 3.13+) unless you set something else; it uses
# noticeably less memory than the jemalloc preload older images used. Set
# `pymalloc` to fall back to CPython's default allocator if you hit an
# allocator-specific crash.
# @type=enum(mimalloc, pymalloc, malloc, default)
# @docs("Home Assistant S6 run script (2026.8.3)", https://github.com/home-assistant/core/blob/2026.8.3/rootfs/etc/services.d/home-assistant/run)
PYTHONMALLOC=mimalloc

# Dead knob, kept because old Home Assistant compose files set it. jemalloc
# was removed in favour of mimalloc; at 2026.8.3 the run script only logs a
# warning that the variable no longer has any effect. Use PYTHONMALLOC.
DISABLE_JEMALLOC=

# Milliseconds S6 waits for Home Assistant to finish shutting down before
# killing it. The image bakes 240000 (4 min), deliberately above Core's own
# staged shutdown budget of 210s (20 + 100 + 60 + 30, `core.py`). Lowering it
# below that risks a container stopped mid-write, i.e. a corrupt
# /config/.storage.
# @type=number
S6_SERVICES_GRACETIME=240000

# Extra Python wheel index used when Home Assistant installs an integration's
# requirements at runtime (uv is the installer; the PIP_ twin is kept for the
# few paths that still shell out to pip). The image bakes Home Assistant's
# own musllinux wheel index, which is what makes adding an integration take
# seconds instead of compiling. Override only to point at an internal mirror;
# emptying it forces source builds inside the container.
# @type=url
# @docs("Home Assistant wheels index", https://wheels.home-assistant.io/)
UV_EXTRA_INDEX_URL=https://wheels.home-assistant.io/musllinux-index/
# @type=url
PIP_EXTRA_INDEX_URL=https://wheels.home-assistant.io/musllinux-index/
