# Penpot 2.17.2 environment schema (@env-spec / varlock format).
#
# One release train, three images: penpotapp/frontend:2.17.2,
# penpotapp/backend:2.17.2 and penpotapp/exporter:2.17.2 are cut and pushed
# together and must always carry the SAME tag; a mixed set is not a supported
# configuration. Bundled alongside them: postgres:15-alpine (upstream's own
# compose still pins Postgres 15 at this tag) and valkey/valkey:8-alpine.
#
# Source: the code at tag 2.17.2, not the docs page.
#   backend/src/app/config.clj      the malli `schema:config`, i.e. the complete
#                                   set of keys the backend accepts, plus the
#                                   `default` map most default values below are
#                                   copied from;
#   common/src/app/common/flags.cljc  every flag name, and the `default` vector
#                                   that says which flags are on when
#                                   PENPOT_FLAGS is empty;
#   exporter/src/app/config.cljs    the exporter's own (much smaller) schema;
#   backend/src/app/http.clj, app/db.clj, app/media/local.clj, app/setup.clj,
#                                   app/auth/oidc.clj for the defaults that live
#                                   in the modules rather than in config.clj;
#   docker/images/files/nginx-entrypoint.sh  the frontend image is nginx + a
#                                   bash entrypoint: it reads its environment at
#                                   container start and rewrites js/config.js
#                                   and nginx.conf from it.
# Cross-checked against docker/images/docker-compose.yaml at the same tag.
#
# How the names work: `read-env` takes every variable starting with `PENPOT_`,
# strips the prefix and kebab-cases the rest, so each key below is PENPOT_ plus
# the config key in upper snake case. An unknown PENPOT_* variable is ignored,
# but a KNOWN key with a value of the wrong shape fails `validate!` and the
# backend prints the explain and exits. It will not boot half-configured.
#
# Where upstream's own compose is stale at this tag:
#   - it still sets PENPOT_HTTP_SERVER_MAX_MULTIPART_BODY_SIZE. 2.17.2 removed
#     that key from the config schema; http.clj now derives the multipart limit
#     from PENPOT_HTTP_SERVER_MAX_BODY_SIZE. Setting it does nothing, so it is
#     not declared here.
#   - it sets VALKEY_EXTRA_FLAGS on the valkey container. That is a Bitnami
#     convention; the official valkey/valkey image never reads it, so this
#     stack does not set it either.
#   - the pre-2.11 storage spellings (PENPOT_ASSETS_STORAGE_BACKEND,
#     PENPOT_STORAGE_ASSETS_*) are still accepted at 2.17.2 but deprecated;
#     only the PENPOT_OBJECTS_STORAGE_* names are declared here.
#
# Deliberately not declared: the ~20 PENPOT_QUOTES_* per-team/per-file limits,
# the executor/worker parallelism knobs, the rpc rlimit/climit config paths and
# the audit-log archive keys. All real at this tag and all listed in
# config.clj; none of them are things a first deploy touches.
#
# @defaultSensitive=false @defaultRequired=infer
# @docs("Penpot configuration reference", https://help.penpot.app/technical-guide/configuration/)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# The absolute, browser-visible base URL of this instance, scheme included (an
# https:// origin with the exact host your users type). All three services get
# it: the frontend bakes it into js/config.js, the backend builds invitation,
# password-reset and email-verification links and scopes session cookies with
# it, and the exporter uses it as the origin it renders. It must match what
# users actually type; a mismatch produces working pages with broken logins
# and dead share links. One side effect worth knowing: config.clj's
# `parse-flags` silently adds `disable-secure-session-cookies` when this URI
# is http:// and the host is not localhost, because a Secure cookie would
# never be sent back over plain HTTP.
# @required
# @type=url
# @docs("Penpot URI", https://help.penpot.app/technical-guide/configuration/#penpot-uri)
PENPOT_PUBLIC_URI=${PENPOT_PUBLIC_URI}

# The feature-flag string, and the single biggest lever on this instance's
# behaviour. A whitespace- or comma-separated list of `enable-<flag>` /
# `disable-<flag>` tokens applied IN ORDER on top of the built-in default set,
# so a later token wins over an earlier one. Set identically on the frontend
# (which gates UI) and the backend (which gates the API). A flag on one side
# only means a button that 500s, or an endpoint with no way to reach it.
#
# On by default at 2.17.2 (flags.cljc `default`): registration,
# login-with-password, email-verification, secure-session-cookies, onboarding,
# dashboard-templates-section, google-fonts-provider, backend-worker,
# backend-api-doc, component-thumbnails and the render/token feature set.
#
# The ones an operator usually touches:
#   disable-registration        closes public sign-up; existing users and
#                               invitations still work. The one flag that turns
#                               a public instance into an invite-only one.
#   disable-email-verification  accounts are usable immediately, with no proof
#                               the address exists. THIS STACK SETS IT, because
#                               it ships no SMTP server and with verification on
#                               nobody could finish a sign-up. Combined with
#                               registration being on by default, anyone who can
#                               reach the URL can create an account: put it
#                               behind a private network, or add SMTP
#                               (enable-smtp + PENPOT_SMTP_*) and drop this flag,
#                               or add disable-registration.
#   enable-smtp                 actually send mail; without it every email is
#                               dropped (add log-emails to print them to the
#                               container log instead).
#   log-invitation-tokens       prints invitation tokens to the log so you can
#                               invite people with no SMTP at all. Anyone with
#                               log access can then accept those invitations.
#   enable-login-with-google | -gitlab | -github | -oidc | -ldap
#                               turn on a provider; each also needs its
#                               PENPOT_<PROVIDER>_* keys below.
#   enable-oidc-registration    lets OIDC create accounts even when general
#                               registration is disabled.
#   enable-email-whitelist / enable-email-blacklist
#                               enforce the domain lists below.
#   disable-secure-session-cookies  drops the Secure attribute on session
#                               cookies. THIS STACK SETS IT so a plain-http
#                               deployment can log in; remove it once you
#                               terminate TLS.
#   enable-prepl-server         opens the prepl socket that the `manage.py`
#                               administrative script drives.
#   enable-webhooks, enable-audit-log, enable-access-tokens
#   enable-mcp                  makes the frontend proxy /mcp/* to a
#                               penpotapp/mcp container. This stack runs no such
#                               service, so leaving it off is correct.
#   enable-air-gapped-conf      frontend only: strips the external locations and
#                               force-disables Google Fonts and the templates
#                               section.
#   enable-demo-users           creates throwaway accounts that expire in 7 days.
#                               Demo only.
# @docs("How the configuration works", https://help.penpot.app/technical-guide/configuration/#how-the-configuration-works)
PENPOT_FLAGS=disable-email-verification disable-secure-session-cookies

# The master secret. setup.clj derives every other key from it (tokens-key, and
# one shared key per subsystem via `keys/derive` with a per-subsystem salt), so
# it is what signs session/auth tokens, invitation tokens, email-verification
# and password-reset tokens. Anyone who knows this value can mint a valid
# session for ANY account on this instance and forge invitations. A weak,
# guessable, or reused value (copied from a blog post, shared with another
# deployment, or upstream's own `change-this-insecure-key`) is a full
# authentication bypass, and a shared value means one compromised instance
# unlocks the others. Generate it yourself:
# `python3 -c "import secrets; print(secrets.token_urlsafe(64))"`.
# Leave it unset and the backend generates a random key on every boot and logs
# `using autogenerated secret-key, it will change on each restart`. Every
# session and every pending invitation dies at each restart. Since 2.12 the
# EXPORTER requires it too (its schema marks :secret-key mandatory and the
# process exits without it) and derives the shared key it authenticates to the
# backend with from it: backend and exporter must carry the SAME value or
# exports fail. Rotating it logs everyone out and invalidates pending tokens.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("Secret key", https://help.penpot.app/technical-guide/configuration/#secret-key)
PENPOT_SECRET_KEY=${PENPOT_SECRET_KEY}

# Identifies this node in log lines, audit events and error reports. Cosmetic
# for a single-container deployment; useful when several backends share a
# database. Default "localhost".
PENPOT_HOST=

# Tenant label stamped on audit/telemetry records and used to namespace some
# storage keys. Leave alone unless you run several Penpot instances against one
# set of shared resources. Default "default".
PENPOT_TENANT=

# Email addresses (whitespace- or comma-separated) treated as instance admins:
# they are the only profiles allowed through the /dbg debug endpoints
# (http/debug.clj, `only-admins-allowed`) and they receive the quota-reached
# notification emails from rpc/quotes.clj. It does not grant anything inside a
# team.
PENPOT_ADMINS=

# ─── Service wiring ───────────────────────────────────────────────────────

# Where the frontend's nginx proxies /api, /ws and /assets. The port is the
# backend's own PENPOT_HTTP_SERVER_PORT (6060). Change one and you must change
# the other. otterdeploy fills the hostname in from the stack.
# @type=url
PENPOT_BACKEND_URI=http://${{stack.backend.HOST}}:6060

# Where the frontend proxies /export. 6061 is the exporter's fixed listen port
# in exporter/src/app/config.cljs. Platform-owned.
# @type=url
PENPOT_EXPORTER_URI=http://${{stack.exporter.HOST}}:6061

# The URL the EXPORTER uses to reach Penpot from inside the container network
# when it drives a headless browser to render a board. Added in 2.17.0
# (issue #10627) precisely so the internal address can differ from the public
# one; without it the exporter would try to fetch PENPOT_PUBLIC_URI and depend
# on external DNS and TLS resolving from inside the network. Points at the
# frontend's own 8080 listener. Platform-owned.
# @type=url
# @docs("Exporter", https://help.penpot.app/technical-guide/configuration/#exporter)
PENPOT_INTERNAL_URI=http://${{stack.frontend.HOST}}:8080

# Upstream for the optional "nitrate" module, proxied by the frontend at
# /nitrate. Defaults to http://penpot-nitrate:3000, which this stack does not
# run; because that proxy_pass carries $request_uri, nginx resolves the name
# lazily at request time, so an absent nitrate service costs a 502 on those
# routes and nothing else.
PENPOT_NITRATE_URI=

# MCP server upstreams, only wired up when PENPOT_FLAGS contains `enable-mcp`
# (nginx-entrypoint.sh deletes the location block otherwise). They need a
# penpotapp/mcp:2.17.2 container, which this stack does not run. Defaults
# http://penpot-mcp:4401 and http://penpot-mcp:4402.
PENPOT_MCP_URI=
PENPOT_MCP_URI_WS=

# DNS resolver nginx uses for the lazily-resolved upstreams. The entrypoint
# reads it out of the container's /etc/resolv.conf; only set it if that file is
# wrong for your network.
PENPOT_INTERNAL_RESOLVER=

# Set truthy ("true"/"t"/"1") on hosts where IPv6 is off at the kernel level;
# the entrypoint then drops nginx's `listen [::]:8080` line, which would
# otherwise abort startup. PENPOT_IPV6_LISTEN_DIRECTIVE overrides that whole
# directive instead, for the rare case you need different listen options.
# @type=boolean
PENPOT_DISABLE_IPV6_LISTEN=
PENPOT_IPV6_LISTEN_DIRECTIVE=

# ─── HTTP server ──────────────────────────────────────────────────────────

# The backend's listen address. 6060 is what PENPOT_BACKEND_URI above points
# at; moving it without updating that URI takes the whole app down.
# @type=port
PENPOT_HTTP_SERVER_PORT=6060
PENPOT_HTTP_SERVER_HOST=0.0.0.0

# Maximum request body, in bytes; 367001600 is 350 MiB and is the cap on file
# imports and asset uploads. Read TWICE, by two different programs: the backend
# (http.clj, which also derives its multipart limit from it) and the frontend's
# nginx entrypoint (client_max_body_size). Raise it in both places or nginx
# rejects the upload before the backend ever sees it.
# @type=number
PENPOT_HTTP_SERVER_MAX_BODY_SIZE=367001600

# Thread-pool sizing for the HTTP layer. Empty lets the runtime pick from the
# available CPUs, which is right for almost everyone.
# @type=number
PENPOT_HTTP_SERVER_IO_THREADS=
# @type=number
PENPOT_HTTP_SERVER_MAX_WORKER_THREADS=

# Explicit origin allowlist (whitespace- or comma-separated) for the RPC API's
# CORS support, which is itself off unless `enable-cors` is in PENPOT_FLAGS.
# 2.17.0 hardened this to fail CLOSED: with the flag on and no allowlist, the
# middleware logs a warning and emits no CORS headers rather than reflecting
# the request's Origin, which with credentials enabled would be a CSRF and
# data-exfiltration hole.
PENPOT_ALLOWED_ORIGINS=

# ─── Database ─────────────────────────────────────────────────────────────

# Connection to the bundled Postgres. No port in the URI means the default
# 5432; the username and password are supplied separately below rather than
# embedded here. Platform-owned: otterdeploy resolves the sibling's hostname.
# @docs("Database", https://help.penpot.app/technical-guide/configuration/#database)
PENPOT_DATABASE_URI=postgresql://${{stack.db.HOST}}/penpot

# Must match the POSTGRES_USER / POSTGRES_PASSWORD the db container is
# initialised with, below.
PENPOT_DATABASE_USERNAME=penpot
# @sensitive
PENPOT_DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# HikariCP pool bounds. Max defaults to 60 connections (db.clj `defaults`); min
# defaults to whatever max is, i.e. a fixed-size pool. Lower max if Postgres'
# own max_connections is the tighter limit.
# @type=number
PENPOT_DATABASE_MAX_POOL_SIZE=60
# @type=number
PENPOT_DATABASE_MIN_POOL_SIZE=

# Boots the backend against a read-only database: the app comes up and serves
# reads, every write fails. For maintenance windows and read replicas only.
# @type=boolean
PENPOT_DATABASE_READONLY=false

# ─── Bundled PostgreSQL 15 ────────────────────────────────────────────────

# Consumed once, by the postgres image's entrypoint, to initialise an empty
# data directory; they must agree with the PENPOT_DATABASE_* values above.
# Changing them after first boot does nothing. The database is already
# created, and the app then fails to authenticate.
POSTGRES_DB=penpot
POSTGRES_USER=penpot

# The password for that role, and the value PENPOT_DATABASE_PASSWORD is wired
# to. It is the only credential guarding the design database (every file, every
# asset reference, every account row) from anything else that can reach the
# container network.
# @required
# @sensitive
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Extra flags for `initdb` on first boot. `--data-checksums` makes Postgres
# detect silent corruption on read; upstream's own compose sets it, and it
# cannot be turned on later without recreating the cluster.
POSTGRES_INITDB_ARGS=--data-checksums

# ─── Valkey ───────────────────────────────────────────────────────────────

# Valkey (a Redis fork; Penpot kept the historical variable name) carries the
# websocket notification fan-out between backend nodes and the exporter's job
# handoff, and caches with the `enable-redis-cache` flag. Backend and exporter
# MUST point at the same instance and database index or exports never come
# back. Nothing durable lives here: a wiped Valkey costs live cursors, not
# data. Platform-owned.
# @docs("Valkey", https://help.penpot.app/technical-guide/configuration/#valkey)
PENPOT_REDIS_URI=redis://${{stack.valkey.HOST}}/0

# Size of the shared Netty pool used for Valkey and the S3 SDK (added in 2.11
# when PENPOT_STORAGE_ASSETS_S3_IO_THREADS was folded into it). Empty means
# derived from the CPU count.
# @type=number
PENPOT_NETTY_IO_THREADS=

# ─── Assets storage ───────────────────────────────────────────────────────

# Where uploaded images, fonts and file thumbnails live. `fs` keeps them on
# disk in the shared penpot-assets volume; `s3` sends them to an S3-compatible
# bucket configured below.
# @type=enum(fs, s3)
# @docs("Storage", https://help.penpot.app/technical-guide/configuration/#storage)
PENPOT_OBJECTS_STORAGE_BACKEND=fs

# The on-disk directory for the `fs` backend. It is also the mount point of the
# penpot-assets volume on BOTH the backend (which writes the files) and the
# frontend (whose nginx serves them via an internal redirect), which is why the
# two containers share one volume. Change it and nginx serves 404s for every
# uploaded image.
PENPOT_OBJECTS_STORAGE_FS_DIRECTORY=/opt/data/assets

# For PENPOT_OBJECTS_STORAGE_BACKEND=s3. The endpoint is only needed for
# non-AWS providers (MinIO, R2, Backblaze).
PENPOT_OBJECTS_STORAGE_S3_BUCKET=
PENPOT_OBJECTS_STORAGE_S3_REGION=
# @type=url
PENPOT_OBJECTS_STORAGE_S3_ENDPOINT=
# Read by the AWS SDK inside the backend, not by Penpot's own config, which is
# why they are the only two keys here without a PENPOT_ prefix. Ignored
# entirely with the fs backend.
# @docs("AWS S3 backend", https://help.penpot.app/technical-guide/configuration/#aws-s3-backend)
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=

# Where the file DATA (the design documents themselves, as opposed to uploaded
# media) is kept. `legacy-db` and `db` store it in Postgres; `storage` offloads
# it to the objects storage above, which is what large instances want. Migrating
# between them is a background task, not a restart.
# @type=enum(db, legacy-db, storage)
# @docs("File data storage", https://help.penpot.app/technical-guide/configuration/#file-data-storage)
PENPOT_FILE_DATA_BACKEND=legacy-db

# ─── Email ────────────────────────────────────────────────────────────────

# SMTP is what makes registration verification, team invitations and password
# resets work. None of these are read unless `enable-smtp` is in PENPOT_FLAGS;
# without that flag Penpot silently drops every message (add `log-emails` to
# print them to the container log instead). This stack ships no SMTP server, so
# they are empty and the flags disable verification (see PENPOT_FLAGS).
# @docs("Email configuration", https://help.penpot.app/technical-guide/configuration/#email-configuration)
PENPOT_SMTP_HOST=
# @type=port
PENPOT_SMTP_PORT=
PENPOT_SMTP_USERNAME=
# @sensitive
PENPOT_SMTP_PASSWORD=
# STARTTLS on an otherwise plain connection (TLS) versus implicit TLS on
# connect (SSL). Set exactly one; both off means credentials cross the wire in
# the clear.
# @type=boolean
PENPOT_SMTP_TLS=false
# @type=boolean
PENPOT_SMTP_SSL=false

# From/Reply-To on every message Penpot sends. The defaults are upstream's own
# example values and will be rejected or spam-foldered by any real provider.
# Set both to an address on a domain you control and that the SMTP account is
# allowed to send as.
PENPOT_SMTP_DEFAULT_FROM=Penpot <no-reply@example.com>
PENPOT_SMTP_DEFAULT_REPLY_TO=Penpot <no-reply@example.com>

# How long after a profile change Penpot waits before it will send another
# verification email, as a duration string. Anti-abuse throttle; default 15m.
PENPOT_EMAIL_VERIFY_THRESHOLD=15m

# Paths to files INSIDE the backend container, one domain per line, that allow
# or deny registration by email domain. They are enforced only with the
# matching `enable-email-whitelist` / `enable-email-blacklist` flag, and the
# files have to be mounted into the container yourself.
PENPOT_EMAIL_DOMAIN_WHITELIST=
PENPOT_EMAIL_DOMAIN_BLACKLIST=

# ─── Registration & authentication ────────────────────────────────────────

# Comma- or whitespace-separated list of email domains allowed to register.
# Setting it to non-empty content auto-enables the email-whitelist flag (kept
# for backward compatibility since 2.1), so this single variable is the
# smallest way to turn an open sign-up into "my company only", but it checks
# the domain of a self-asserted address, so it is only as strong as email
# verification is: with `disable-email-verification` set, anyone can claim an
# address at an allowed domain.
# @docs("Registration and authentication", https://help.penpot.app/technical-guide/configuration/#registration-and-authentication)
PENPOT_REGISTRATION_DOMAIN_WHITELIST=

# Name of the cookie holding the session token, and how long it lives (a
# duration string, e.g. "720h"). Rename the cookie only if something else on
# the same domain already owns the name.
PENPOT_AUTH_TOKEN_COOKIE_NAME=auth-token
PENPOT_AUTH_TOKEN_COOKIE_MAX_AGE=

# OAuth app credentials for the social providers. Each pair does nothing until
# the matching `enable-login-with-*` flag is in PENPOT_FLAGS. Register the
# callback URL as https://<your-domain>/api/auth/oidc/callback, the single
# unified endpoint since 2.12; the older per-provider
# /api/auth/oauth/<provider>/callback form was removed, and an app still
# configured with it fails at sign-in.
# @docs("Authentication providers", https://help.penpot.app/technical-guide/configuration/#authentication-providers)
PENPOT_GOOGLE_CLIENT_ID=
# @sensitive
PENPOT_GOOGLE_CLIENT_SECRET=
PENPOT_GITHUB_CLIENT_ID=
# @sensitive
PENPOT_GITHUB_CLIENT_SECRET=
PENPOT_GITLAB_CLIENT_ID=
# @sensitive
PENPOT_GITLAB_CLIENT_SECRET=
# Base URL of the GitLab instance; default https://gitlab.com. Point it at your
# own GitLab for a self-hosted one.
# @type=url
# @docs("GitLab", https://help.penpot.app/technical-guide/configuration/#gitlab)
PENPOT_GITLAB_BASE_URI=

# Generic OIDC provider. With PENPOT_OIDC_BASE_URI set, Penpot discovers the
# rest from <base>/.well-known/openid-configuration (and, since 2.17.0, caches
# the discovery instead of refetching it per login); the explicit *_URI keys
# below are only for providers whose discovery document is wrong or absent.
# @type=url
# @docs("OpenID Connect", https://help.penpot.app/technical-guide/configuration/#openid-connect)
PENPOT_OIDC_BASE_URI=
PENPOT_OIDC_CLIENT_ID=
# @sensitive
PENPOT_OIDC_CLIENT_SECRET=
# @type=url
PENPOT_OIDC_AUTH_URI=
# @type=url
PENPOT_OIDC_TOKEN_URI=
# @type=url
PENPOT_OIDC_USER_URI=
# @type=url
PENPOT_OIDC_JWKS_URI=
# Scopes requested at authorisation; default "openid profile email".
PENPOT_OIDC_SCOPES=
# Where the profile comes from: the userinfo endpoint, the id_token claims, or
# "auto" (id_token when it carries the attributes, userinfo otherwise).
# @type=enum(auto, userinfo, token)
PENPOT_OIDC_USER_INFO_SOURCE=
# Claim names to read the user's email and display name from; defaults "email"
# and "name". Change them for providers that use non-standard claims.
PENPOT_OIDC_EMAIL_ATTR=
PENPOT_OIDC_NAME_ATTR=
# Require the user to hold one of these roles (whitespace- or comma-separated)
# in the claim named by PENPOT_OIDC_ROLES_ATTR, else the login is refused. The
# only way to restrict WHO may sign in through a provider that is otherwise
# open to your whole directory.
PENPOT_OIDC_ROLES=
PENPOT_OIDC_ROLES_ATTR=
# Frontend-only: the label on the SSO button ("Login with <name>"). Read by the
# nginx entrypoint, not by the backend, so it belongs on the frontend service.
PENPOT_OIDC_NAME=

# LDAP / Active Directory. Needs `enable-login-with-ldap`. `:username` in the
# query is substituted with what the user typed. The defaults shown are
# config.clj's and suit OpenLDAP; Active Directory usually wants
# sAMAccountName / mail / displayName and a base DN of your OU.
# @docs("LDAP", https://help.penpot.app/technical-guide/configuration/#ldap)
PENPOT_LDAP_HOST=
# @type=port
PENPOT_LDAP_PORT=
# LDAPS on connect (SSL) versus StartTLS upgrade on the plain port. With
# neither, the bind password and every user password cross the network
# unencrypted.
# @type=boolean
PENPOT_LDAP_SSL=false
# @type=boolean
PENPOT_LDAP_STARTTLS=false
PENPOT_LDAP_BASE_DN=
PENPOT_LDAP_BIND_DN=
# @sensitive
PENPOT_LDAP_BIND_PASSWORD=
PENPOT_LDAP_USER_QUERY=(|(uid=:username)(mail=:username))
PENPOT_LDAP_ATTRS_USERNAME=uid
PENPOT_LDAP_ATTRS_EMAIL=mail
PENPOT_LDAP_ATTRS_FULLNAME=cn

# ─── Exporter ─────────────────────────────────────────────────────────────

# Scratch directory for renders in progress inside the exporter container.
# Default /tmp/penpot.
PENPOT_TEMPDIR=

# Size of the headless-browser pool. Each live browser costs real memory, so
# max is the practical cap on concurrent exports (default 5); min 0 means
# browsers are only started on demand.
# @type=number
PENPOT_BROWSER_POOL_MAX=
# @type=number
PENPOT_BROWSER_POOL_MIN=

# Pre-shared key the exporter authenticates to the backend with. Leave it empty
# and BOTH sides derive the same key from PENPOT_SECRET_KEY, which is why this
# stack does not set it. If you do set it, set the identical value on the
# backend and the exporter; setting it on one side only breaks every export.
# @sensitive
PENPOT_EXPORTER_SHARED_KEY=

# Shared key guarding the backend's /management HTTP API (the administrative
# surface behind the manage CLI). Empty disables the API: setup.clj logs
# "key is disabled because empty string found" and the routes reject
# everything. A leaked value is administrative access to the instance.
# @sensitive
PENPOT_MANAGEMENT_API_KEY=

# ─── Media & processing limits ────────────────────────────────────────────

# Per-file upload ceilings in bytes; both default to 30 MiB (31457280). They
# are checked before the body limit above, so the effective cap is the smaller
# of the two.
# @type=number
PENPOT_MEDIA_MAX_FILE_SIZE=31457280
# @type=number
PENPOT_FONT_MAX_FILE_SIZE=31457280

# Sandbox limits on the child processes that convert uploaded fonts (added in
# 2.17.0): address-space ceiling in MiB, CPU seconds, and wall-clock seconds
# before the process is killed. They exist so a malicious or malformed font
# cannot pin the backend's CPU or exhaust its memory.
# @type=number
PENPOT_FONT_PROCESS_MEM=512
# @type=number
PENPOT_FONT_PROCESS_CPU=30
# @type=number
PENPOT_FONT_PROCESS_TIMEOUT=60

# Resource limits handed to ImageMagick (as MAGICK_*_LIMIT) when it processes
# an uploaded bitmap. These were also added in 2.17.0 and are the same class
# of protection: a crafted image that would otherwise decompress into
# gigabytes is refused instead. The area/width/height limits bound the decoded
# pixel count; width and height have no default.
# @docs("ImageMagick resource limits", https://help.penpot.app/technical-guide/configuration/#imagemagick-resource-limits)
PENPOT_IMAGEMAGICK_THREAD_LIMIT=2
PENPOT_IMAGEMAGICK_MEMORY_LIMIT=256MiB
PENPOT_IMAGEMAGICK_MAP_LIMIT=512MiB
PENPOT_IMAGEMAGICK_AREA_LIMIT=128MP
PENPOT_IMAGEMAGICK_DISK_LIMIT=1GiB
PENPOT_IMAGEMAGICK_TIME_LIMIT=30
PENPOT_IMAGEMAGICK_WIDTH_LIMIT=
PENPOT_IMAGEMAGICK_HEIGHT_LIMIT=

# Hosts and CIDRs for the SSRF guard that vets outbound fetches (OIDC
# discovery, webhooks, remote imports). Allowed hosts punch a hole for an
# internal provider you deliberately want reachable; extra blocked CIDRs widen
# the deny list. Whitespace- or comma-separated. Every entry you allow is a URL
# a user of this instance can make the server fetch.
PENPOT_SSRF_ALLOWED_HOSTS=
PENPOT_SSRF_EXTRA_BLOCKED_CIDRS=

# ─── Telemetry & diagnostics ──────────────────────────────────────────────

# When true, a periodic task posts anonymous instance statistics (version,
# enabled flags, object counts) to Penpot's servers, and config.clj's
# `parse-flags` adds the `enable-telemetry` flag for you. Upstream's own
# compose ships it ON; this stack ships it OFF, so nothing leaves the box
# unless you opt in. Turn it on if you want to support the project; the
# payload is assembled in backend/src/app/tasks/telemetry.clj and can be read
# before you decide.
# @type=boolean
# @docs("Telemetries", https://help.penpot.app/technical-guide/configuration/#telemetries)
PENPOT_TELEMETRY_ENABLED=false

# Where those reports go (default https://telemetry.penpot.app/) and a free-text
# label identifying how the instance was installed. Both are inert while
# PENPOT_TELEMETRY_ENABLED is false.
# @type=url
PENPOT_TELEMETRY_URI=
PENPOT_TELEMETRY_REFERER=

# Incoming-webhook URL that unhandled backend exceptions are posted to
# (Mattermost/Slack style). Anyone holding the URL can post into that channel,
# and the reports themselves contain stack traces and request context.
# @sensitive
# @type=url
PENPOT_ERROR_REPORT_WEBHOOK=

# Email address that in-app user feedback is delivered to. Needs the
# `enable-user-feedback` flag and working SMTP.
# @type=email
PENPOT_USER_FEEDBACK_DESTINATION=

# ─── Housekeeping ─────────────────────────────────────────────────────────

# Grace period before a deleted team/project/file is actually purged, as a
# duration string, the window in which a deletion can still be undone.
# Default 7 days; the file-clean delay (default 2 days) is the equivalent for
# orphaned file data.
PENPOT_DELETION_DELAY=
PENPOT_FILE_CLEAN_DELAY=

# Automatic version history: snapshot a file every N changes, and never more
# often than the timeout. Lower `every` keeps more restore points at the cost
# of storage.
# @type=number
# @docs("Autosave", https://help.penpot.app/technical-guide/configuration/#autosave)
PENPOT_AUTO_FILE_SNAPSHOT_EVERY=5
PENPOT_AUTO_FILE_SNAPSHOT_TIMEOUT=3h

# The prepl socket the `manage.py` administrative script attaches to; only
# opened with `enable-prepl-server` in PENPOT_FLAGS. Defaults are localhost and
# 6063. Keep the host on the loopback interface, because anything that can
# reach this port can evaluate arbitrary code inside the backend.
PENPOT_PREPL_HOST=localhost
# @type=port
PENPOT_PREPL_PORT=6063
