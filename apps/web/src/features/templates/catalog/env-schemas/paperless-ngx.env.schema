# Paperless-ngx 3.1.2 (image ghcr.io/paperless-ngx/paperless-ngx:3.1.2)
# environment schema (@env-spec / varlock format).
#
# Source: the code, at the pinned tag. Paperless-ngx is Django; in v3 the
# single src/paperless/settings.py became a package:
# src/paperless/settings/__init__.py (the settings themselves),
# settings/parsers.py (the coercers: str_to_bool, get_bool_from_env,
# get_int_from_env, get_float_from_env, get_path_from_env, get_list_from_env,
# get_choice_from_env), and settings/custom.py (parse_db_settings,
# parse_redis_url, parse_hosting_settings, the Celery beat schedule). Those
# three files plus docker/rootfs/etc/s6-overlay/** (the container-only knobs)
# are where every PAPERLESS_* read lives; a grep of "PAPERLESS_[A-Z0-9_]+"
# across src/ finds 188 of them at this tag. This file covers the compose-set
# keys plus the groups an operator actually touches (paths, database, redis,
# Tika/Gotenberg, OCR, consumer, workers, web/proxy, authentication, outbound
# mail). The FULL surface is documented upstream, one heading per variable, in
# docs/configuration.md at this tag (linked below); anything not declared here
# is there.
#
# Where the docs and the code disagree, the code wins. Two live examples at
# 3.1.2: docker/compose/docker-compose.env still ships
# `PAPERLESS_SECRET_KEY=change-me`, a value settings/__init__.py now refuses to
# boot on; and docs/configuration.md still lists PAPERLESS_DBSSLMODE /
# DBSSLROOTCERT / DBSSLCERT / DBSSLKEY / DB_POOLSIZE / DB_TIMEOUT as their own
# variables. Those are still read by settings/custom.py at 3.1.2, but they
# are deprecated and scheduled for removal in v3.2 in favour of the single
# PAPERLESS_DB_OPTIONS string, so only PAPERLESS_DB_OPTIONS is declared here.
#
# @docs links point at docs/*.md on github.com at tag v3.1.2 rather than at
# docs.paperless-ngx.com: that host sits behind a Cloudflare managed challenge
# and answers 403 to every non-browser client, so a link there could never be
# verified. The GitHub blobs are the same documents at the exact pinned
# version and answer 200.
#
# Upgrade note for an existing v2 stack: docs/migration-v3.md requires
# stepping through 2.20.15 before 3.x, and v3 makes PAPERLESS_SECRET_KEY
# mandatory, requires PAPERLESS_DBENGINE to be set explicitly for PostgreSQL
# (it is no longer inferred from PAPERLESS_DBHOST; the compose sets it), and
# removed PAPERLESS_OCR_SKIP_ARCHIVE_FILE in favour of
# PAPERLESS_ARCHIVE_FILE_GENERATION.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Paperless-ngx configuration reference", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# The instance's public origin, scheme and host, no trailing path.
# _parse_paperless_url() in settings/__init__.py appends it to
# CSRF_TRUSTED_ORIGINS and CORS_ALLOWED_ORIGINS and appends its hostname to
# ALLOWED_HOSTS, so this one value is what makes logins, form POSTs and the
# API work from the real domain. Get it wrong and every write request fails
# CSRF verification with a 403 while GETs still look fine.
# @required
# @type=url
# @docs("Hosting & Security", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#hosting--security-hosting-and-security)
PAPERLESS_URL=${PAPERLESS_URL}

# Django's SECRET_KEY. Signs session cookies, password-reset and email-
# confirmation links, and every other signed payload, so ANY party who knows
# it can forge a session or a token and log in as any user. Upstream ships a
# well-known default in its own example config
# (docker/compose/docker-compose.env contains the literal
# `PAPERLESS_SECRET_KEY=change-me`), and installs that copy the value verbatim;
# treat any key you did not generate yourself as public. 3.1.2 refuses to
# start when this is unset, blank, or exactly "change-me"
# (ImproperlyConfigured, settings/__init__.py). Generate with
# `openssl rand -base64 48`. Rotating it after first boot invalidates every
# existing session and signed token.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("v3 migration: secret key is now required", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/migration-v3.md)
PAPERLESS_SECRET_KEY=${PAPERLESS_SECRET_KEY}

# IANA timezone for stored and displayed timestamps. The compose pins UTC;
# changing it does not retroactively convert already-stored dates.
PAPERLESS_TIME_ZONE=UTC

# Comma-separated hostnames Django will answer for. Defaults to `*` (any
# Host header), which is what the platform's router needs; narrowing it is a
# hardening step, and when it is not `*` the code appends `localhost` itself
# so the container healthcheck keeps working. PAPERLESS_URL's hostname is
# added automatically, so you do not need to repeat it here.
PAPERLESS_ALLOWED_HOSTS=

# Extra comma-separated origins (scheme + host, no path) accepted for CSRF-
# protected POSTs, beyond PAPERLESS_URL. Only needed when the app is reached
# on more than one origin: a second domain, or an internal name used
# alongside the public one.
PAPERLESS_CSRF_TRUSTED_ORIGINS=

# Comma-separated origins allowed to call the API from a browser. Defaults to
# http://localhost:8000; PAPERLESS_URL is appended automatically. Set this
# only for a separate front-end or a third-party web client.
PAPERLESS_CORS_ALLOWED_HOSTS=

# Django debug mode. Leaks settings, SQL and stack traces into HTTP responses
# and must stay off on anything reachable from a network.
# @type=boolean
PAPERLESS_DEBUG=false

# ─── First-run superuser ───────────────────────────────────────────────────

# Username of the superuser the container creates on first start
# (docker/rootfs/.../init-superuser + documents/management/commands/
# manage_superuser.py). Only acted on when PAPERLESS_ADMIN_USER is set; the
# management command's own fallback is "admin". This account is a full
# superuser (it can read every document in the instance and manage all other
# users), so name it something that is not guessable alongside a strong
# password below.
# @required
# @docs("PAPERLESS_ADMIN_USER", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#hosting--security-hosting-and-security)
PAPERLESS_ADMIN_USER=${PAPERLESS_ADMIN_USER}

# Password for that superuser, applied at container start. It stays in the
# service's environment for the life of the stack, so anyone who can read the
# stack's variables can log in as the superuser; rotate it in the UI after
# first login if that matters to you. Without it the superuser is never
# created and the login page has no account to accept.
# @required
# @sensitive
# @type=string(minLength=12)
PAPERLESS_ADMIN_PASSWORD=${PAPERLESS_ADMIN_PASSWORD}

# E-mail recorded for that superuser. Defaults to root@localhost, which is
# fine until you enable outbound mail and want password resets to arrive.
# @type=email
PAPERLESS_ADMIN_MAIL=

# ─── Bundled PostgreSQL ────────────────────────────────────────────────────

# Database backend: sqlite, postgresql, or mariadb. v3 no longer infers
# PostgreSQL from the presence of PAPERLESS_DBHOST, because parse_db_settings()
# in settings/custom.py requires this to be set explicitly, and the compose
# sets it to match the bundled Postgres service.
# @type=enum(sqlite, postgresql, mariadb)
# @docs("Database", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#database)
PAPERLESS_DBENGINE=postgresql

# Hostname of the bundled Postgres. Platform-owned: resolved from the stack's
# own service graph, never typed.
PAPERLESS_DBHOST=${{stack.db.HOST}}

# Port of the database server. Empty uses the driver default (5432), which is
# what the bundled Postgres listens on.
# @type=port
PAPERLESS_DBPORT=

# Database name. Must match POSTGRES_DB on the bundled Postgres below.
PAPERLESS_DBNAME=paperless

# Database role. Must match POSTGRES_USER on the bundled Postgres below.
PAPERLESS_DBUSER=paperless

# Database password. The compose threads the platform's POSTGRES_PASSWORD
# prompt into both this and the Postgres service's own POSTGRES_PASSWORD, so
# the two can never drift.
# @required
# @sensitive
PAPERLESS_DBPASS=${POSTGRES_PASSWORD}

# v3's single place for advanced driver options, replacing the per-option
# PAPERLESS_DBSSL* / DB_POOLSIZE / DB_TIMEOUT variables (still read at 3.1.2,
# removed in v3.2). Comma-separated key=value pairs, e.g.
# `sslmode=require,sslrootcert=/certs/ca.pem,pool.max_size=10`. Not needed for
# the bundled Postgres, which is reached over the stack's private network.
# @docs("Database advanced options", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/migration-v3.md)
PAPERLESS_DB_OPTIONS=

# Database created by the bundled Postgres image on first boot. Must match
# PAPERLESS_DBNAME above.
POSTGRES_DB=paperless

# Role created by the bundled Postgres image on first boot. Must match
# PAPERLESS_DBUSER above.
POSTGRES_USER=paperless

# Password for that role. Platform prompt key, generated once and threaded
# into PAPERLESS_DBPASS above; changing it after first boot does not change
# the password already stored in the Postgres volume.
# @required
# @sensitive
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# ─── Bundled Redis broker ──────────────────────────────────────────────────

# Celery broker and websocket channel layer. parse_redis_url() in
# settings/custom.py accepts redis://, rediss://, unix:// and redis+socket://
# forms; the compose points it at the bundled broker on the stack's private
# network. Without a reachable broker nothing is consumed, no scheduled task
# runs, and the UI's live progress never updates.
# @required
# @docs("Message broker", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#message-broker)
PAPERLESS_REDIS=redis://${{stack.broker.HOST}}:6379

# Key prefix for everything Paperless stores in Redis. Only needed when a
# Redis instance is shared with another Paperless install; the bundled broker
# is dedicated, so this stays empty.
PAPERLESS_REDIS_PREFIX=

# ─── Tika & Gotenberg ──────────────────────────────────────────────────────

# Route Office documents and .eml e-mail through Tika + Gotenberg instead of
# refusing them. The compose enables it and runs both sidecars. Note the Tika
# image is pinned, not floated: Tika 4.0.0 removed the /tika/form/* endpoints
# the bundled tika-client still uses, so a floating tag silently breaks every
# Office/.eml document.
# @type=boolean
# @docs("Tika", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#tika-tika)
PAPERLESS_TIKA_ENABLED=1

# Tika server base URL. Platform-owned: the bundled sidecar's address on the
# stack's private network.
PAPERLESS_TIKA_ENDPOINT=http://${{stack.tika.HOST}}:9998

# Gotenberg base URL, used to render Office documents and e-mail to PDF.
# Platform-owned: the stack's OWN Gotenberg sidecar, which is started with
# JavaScript disabled and a file:///tmp allow-list so converted e-mail cannot
# fetch tracking pixels or run script.
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://${{stack.gotenberg.HOST}}:3000

# ─── Paths ─────────────────────────────────────────────────────────────────

# Index, classification model, logs and the SQLite database (unused here)
# live under this directory. Defaults to /usr/src/paperless/data, which is
# the path the compose's data volume is mounted at. Change it and the volume
# stops covering the data Paperless writes.
# @docs("Paths and folders", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#paths-and-folders)
PAPERLESS_DATA_DIR=

# Originals, archive PDFs, thumbnails and share-link bundles. Defaults to
# /usr/src/paperless/media, matching the compose's media volume. This is the
# directory that holds the actual documents.
PAPERLESS_MEDIA_ROOT=

# Watched directory: anything dropped here is consumed. Defaults to
# /usr/src/paperless/consume, matching the compose's consume volume.
PAPERLESS_CONSUMPTION_DIR=

# Where soft-deleted documents are moved instead of being erased. Empty means
# no trash directory: deletions after the retention delay below are permanent.
PAPERLESS_TRASH_DIR=

# Days a document stays in the trash before it is emptied. Minimum 1;
# the code clamps anything lower.
# @type=number
PAPERLESS_EMPTY_TRASH_DELAY=30

# Log files. Defaults to <PAPERLESS_DATA_DIR>/log.
PAPERLESS_LOGGING_DIR=

# Working directory for intermediate files during OCR and consumption.
# Defaults to a "paperless" directory inside the system temp dir. Point it at
# a larger or faster filesystem if you consume very large scans.
PAPERLESS_SCRATCH_DIR=

# ─── OCR ───────────────────────────────────────────────────────────────────

# Tesseract language(s) used for OCR, `+`-joined for multiple (e.g. `deu+eng`).
# Every language named here must be installed in the image; the image ships
# English, German, Italian, Spanish and French.
# @docs("OCR settings", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#ocr-settings-ocr)
PAPERLESS_OCR_LANGUAGE=eng

# Extra Tesseract language packs to apt-install at container start,
# whitespace-separated (e.g. `tur ces`). Read by the image's s6 init, not by
# Django. Each start with a non-empty value costs a package download.
PAPERLESS_OCR_LANGUAGES=

# When to run OCR: auto (only when the PDF has no usable text layer), force
# (always, discarding any existing text), redo (re-OCR, keeping the original),
# or off. v3 decoupled this from archive generation and REMOVED the old `skip`
# / `skip_noarchive` values. Setting them now logs a startup warning and
# falls back to auto.
# @type=enum(auto, force, redo, off)
PAPERLESS_OCR_MODE=auto

# When to produce the archived PDF/A copy: auto (only when OCR produced new
# text), always, or never. This is the v3 replacement for
# PAPERLESS_OCR_SKIP_ARCHIVE_FILE.
# @type=enum(auto, always, never)
PAPERLESS_ARCHIVE_FILE_GENERATION=auto

# Output format for the archived copy. pdfa is the archival standard; pdf
# skips the conversion.
PAPERLESS_OCR_OUTPUT_TYPE=pdfa

# Only OCR the first N pages of each document. Empty means all pages.
# @type=number
PAPERLESS_OCR_PAGES=

# Assumed DPI for images that carry no resolution metadata. Empty lets
# OCRmyPDF decide; scans that OCR poorly often just need this set to 300.
# @type=number
PAPERLESS_OCR_IMAGE_DPI=

# unpaper pre-processing: clean, clean-final, or none. `clean-final` writes
# the cleaned image into the output rather than only using it for OCR.
# @type=enum(clean, clean-final, none)
PAPERLESS_OCR_CLEAN=clean

# Correct small scanner skew before OCR.
# @type=boolean
PAPERLESS_OCR_DESKEW=true

# Detect and correct page rotation before OCR.
# @type=boolean
PAPERLESS_OCR_ROTATE_PAGES=true

# Confidence a rotation must reach before the page is turned. Lower rotates
# more eagerly and gets it wrong more often.
# @type=number
PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD=12.0

# Extra OCRmyPDF arguments as a JSON object, e.g. `{"invalidate_digital_signatures": true}`.
# Anything here is passed straight through and can break consumption.
PAPERLESS_OCR_USER_ARGS=

# ─── Consumer ──────────────────────────────────────────────────────────────

# Seconds between polls of the consume directory. 0 (the default) uses
# filesystem notifications instead, which is right for a local volume;
# network filesystems that do not deliver events need a positive value here.
# @type=number
# @docs("Document consumption", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#document-consumption-consume_config)
PAPERLESS_CONSUMER_POLLING_INTERVAL=0

# Seconds a file must stop changing before it is treated as fully written.
# v3 unified the old inotify/polling delay-and-retry settings into this one.
# @type=number
PAPERLESS_CONSUMER_STABILITY_DELAY=5

# Descend into subdirectories of the consume directory.
# @type=boolean
PAPERLESS_CONSUMER_RECURSIVE=false

# Turn each consume subdirectory into a tag on the documents found in it.
# Requires PAPERLESS_CONSUMER_RECURSIVE.
# @type=boolean
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=false

# JSON array of REGEX patterns matched against the filename. v3 switched this
# from fnmatch globs to regex, and user entries are ADDED to the built-in
# defaults rather than replacing them, so a v2 value copied across will not
# behave the same.
PAPERLESS_CONSUMER_IGNORE_PATTERNS=

# JSON array of directory NAMES (not paths) to skip entirely. New in v3;
# also additive to the defaults.
PAPERLESS_CONSUMER_IGNORE_DIRS=

# Reject a document whose checksum already exists. v3 changed the default:
# duplicates are now accepted and flagged in the UI instead of being dropped.
# Set true to restore the v2 behaviour.
# @type=boolean
PAPERLESS_CONSUMER_DELETE_DUPLICATES=false

# Scan incoming pages for separator barcodes and split the document there.
# @type=boolean
# @docs("Barcodes", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#barcodes-barcodes)
PAPERLESS_CONSUMER_ENABLE_BARCODES=false

# Read the archive serial number from a barcode with the ASN prefix.
# @type=boolean
PAPERLESS_CONSUMER_ENABLE_ASN_BARCODE=false

# Prefix identifying an ASN barcode.
PAPERLESS_CONSUMER_ASN_BARCODE_PREFIX=ASN

# Barcode value that marks a page as a document separator. The default
# PATCHT is the standard Patch-T sheet most scanners print.
PAPERLESS_CONSUMER_BARCODE_STRING=PATCHT

# Naming template for stored originals and archive copies, e.g.
# `{created_year}/{correspondent}/{title}`. Empty keeps Paperless's own
# layout. Changing it renames existing files on the next run.
PAPERLESS_FILENAME_FORMAT=

# Placeholder handling in PAPERLESS_FILENAME_FORMAT: leave "none" segments in
# the path or drop them. GHSA-2jhj-xqrq-rmrq (fixed in this 3.1.2) was a path
# traversal that only triggered with this enabled. The fix is in the pinned
# image, but there is still no reason to turn it on unless you need it.
# @type=boolean
PAPERLESS_FILENAME_FORMAT_REMOVE_NONE=false

# Day/month/year order used when parsing dates out of document text.
PAPERLESS_DATE_ORDER=DMY

# Script run before / after each document is consumed. v3 REMOVED the
# positional arguments these used to receive; everything now arrives as
# environment variables, so a v2 script must be rewritten before it is
# pointed at here. Paths are inside the container.
# @docs("Consume script positional arguments removed", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/migration-v3.md)
PAPERLESS_PRE_CONSUME_SCRIPT=
PAPERLESS_POST_CONSUME_SCRIPT=

# ─── Workers & web server ──────────────────────────────────────────────────

# Celery worker processes: how many documents can be consumed at once. Each
# one costs memory; 1 is the default and is right for small instances.
# @type=number
# @docs("Software tweaks", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#software-tweaks-software_tweaks)
PAPERLESS_TASK_WORKERS=1

# Threads each worker uses for OCR. Empty derives a value from
# PAPERLESS_TASK_WORKERS and the visible CPU count.
# @type=number
PAPERLESS_THREADS_PER_WORKER=

# Seconds before a consumption task is killed. Raise it for very large or
# very slow scans.
# @type=number
PAPERLESS_WORKER_TIMEOUT=1800

# Granian HTTP worker processes (v3 replaced gunicorn with Granian). Read by
# the image's s6 init.
# @type=number
# @docs("Docker-specific options", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#docker-specific-options-docker)
PAPERLESS_WEBSERVER_WORKERS=1

# Port the container listens on. The compose exposes 8000 with no override,
# so this is that port's twin: change one without the other and the service
# stops being routable.
# @type=port
PAPERLESS_PORT=8000

# Address the container binds. Defaults to `::` (dual-stack any), which is
# what the stack network needs; binding a loopback address makes the service
# unreachable from the router.
PAPERLESS_BIND_ADDR=

# ─── Reverse proxy ─────────────────────────────────────────────────────────

# Serve the app under a sub-path (e.g. /paperless) instead of the domain
# root. Every generated link, the login URL and the static prefix are built
# from it, so it must match the proxy's path exactly.
# @docs("Hosting & Security", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#hosting--security-hosting-and-security)
PAPERLESS_FORCE_SCRIPT_NAME=

# URL prefix static assets are served from. Defaults to <base>/static/ and
# only needs changing when a CDN or an outer proxy serves them.
PAPERLESS_STATIC_URL=

# Trust the X-Forwarded-Host / X-Forwarded-Port headers when building
# absolute URLs. Only turn these on behind a proxy that SETS those headers
# itself; a proxy that merely forwards what the client sent lets the client
# choose the host Paperless puts in password-reset links.
# @type=boolean
PAPERLESS_USE_X_FORWARD_HOST=false
# @type=boolean
PAPERLESS_USE_X_FORWARD_PORT=false

# JSON two-element array naming the header and value that mean "this request
# arrived over HTTPS", e.g. `["HTTP_X_FORWARDED_PROTO", "https"]`. Same
# caveat: the proxy must overwrite the header, not pass it through.
PAPERLESS_PROXY_SSL_HEADER=

# Comma-separated proxy IPs / CIDRs, the number of proxy hops in
# X-Forwarded-For, and the header to read the client IP from. allauth uses
# these to rate-limit logins by client address; behind a proxy, getting them
# wrong shows up as a 403 on the login form rather than as a rate-limit
# message.
# @docs("Reverse proxy and login rate limiting", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/migration-v3.md)
PAPERLESS_TRUSTED_PROXIES=
# @type=number
PAPERLESS_ALLAUTH_TRUSTED_PROXY_COUNT=
PAPERLESS_ALLAUTH_TRUSTED_CLIENT_IP_HEADER=

# gzip/brotli responses in the app rather than at the proxy.
# @type=boolean
PAPERLESS_ENABLE_COMPRESSION=true

# ─── Authentication ────────────────────────────────────────────────────────

# Let anyone reach the sign-up form and create their own account. Off by
# default, and it should stay off on an instance holding your documents.
# @type=boolean
# @docs("Authentication & SSO", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#authentication--sso-authentication)
PAPERLESS_ACCOUNT_ALLOW_SIGNUPS=false

# Scheme used in the links allauth mails out (verification, password reset).
# Leave https unless the instance is genuinely served over plain HTTP.
# @type=enum(http, https)
PAPERLESS_ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# Session lifetime in seconds. Default is three weeks.
# @type=number
PAPERLESS_SESSION_COOKIE_AGE=1814400

# Throttle applied to login and token requests, in DRF rate syntax. Loosening
# it makes password guessing cheaper.
PAPERLESS_TOKEN_THROTTLE_RATE=5/min

# AUTH-DISABLING KNOB. Any request carrying the header named below is trusted
# as that username, with no password: paperless.auth.HttpRemoteUserMiddleware
# is installed and RemoteUserBackend is put FIRST in the authentication
# chain. That is only safe if the reverse proxy strips the header from
# incoming client requests and re-sets it after authenticating. If it does
# not (or if the container port is reachable directly, bypassing the proxy),
# anyone can impersonate any user, including the superuser, with a single
# header. The _API variant extends the same trust to the REST API; upstream
# has already had to fix a case where header auth stayed active on the API
# even with that variant off (GHSA-72w4-hxqq-c256, patched 2.8.6). Leave both
# off unless you are deliberately running SSO behind a proxy you control.
# @type=boolean
PAPERLESS_ENABLE_HTTP_REMOTE_USER=false
# @type=boolean
PAPERLESS_ENABLE_HTTP_REMOTE_USER_API=false

# The header consulted when the flags above are on, in Django's WSGI form
# (HTTP_ + upper-cased header name with dashes as underscores). Default
# HTTP_REMOTE_USER means the `Remote-User` header.
PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME=HTTP_REMOTE_USER

# AUTH-DISABLING KNOB. Setting a username here inserts AutoLoginMiddleware,
# which logs EVERY request in as that user with no credentials at all. It is
# a single-user, trusted-network convenience; on anything reachable from a
# network it hands the instance to whoever finds the URL.
PAPERLESS_AUTO_LOGIN_USERNAME=

# Hide the username/password form so only the configured SSO provider can be
# used, and send /accounts/login straight to it. Set these ONLY once SSO is
# working. Together they can lock you out of an instance whose provider is
# misconfigured. The documented escape hatch is to unset them and restart.
# @type=boolean
PAPERLESS_DISABLE_REGULAR_LOGIN=false
# @type=boolean
PAPERLESS_REDIRECT_LOGIN_TO_SSO=false

# django-allauth provider configuration as a JSON object (OIDC issuer,
# client id, client secret, scopes). Contains a client secret, so it is
# handled as a credential.
# @sensitive
PAPERLESS_SOCIALACCOUNT_PROVIDERS=

# Create a local account the first time someone authenticates through a
# social/OIDC provider. Whether that is safe depends entirely on who your
# provider will issue tokens for.
# @type=boolean
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=true

# Map provider group claims onto Paperless groups, and optionally onto staff
# and superuser status. The two group names below grant admin rights to
# anyone your identity provider puts in them.
# @type=boolean
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=false
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS_CLAIM=groups
PAPERLESS_SOCIAL_ACCOUNT_SYNC_STAFF_GROUP=
PAPERLESS_SOCIAL_ACCOUNT_SYNC_SUPERUSER_GROUP=

# ─── Outbound e-mail ───────────────────────────────────────────────────────

# SMTP server used for password resets, verification and document sharing.
# The default `localhost` means "no mail": EMAIL_ENABLED is computed as
# EMAIL_HOST != "localhost" or EMAIL_HOST_USER != "", and while it is false
# account e-mail verification is forced to "none".
# @docs("Email sending", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#email-sending)
PAPERLESS_EMAIL_HOST=localhost

# SMTP port. 587 for STARTTLS, 465 for implicit TLS.
# @type=port
PAPERLESS_EMAIL_PORT=25

# SMTP username.
PAPERLESS_EMAIL_HOST_USER=

# SMTP password.
# @sensitive
PAPERLESS_EMAIL_HOST_PASSWORD=

# From address on outgoing mail. Empty falls back to the SMTP username.
PAPERLESS_EMAIL_FROM=

# STARTTLS on a plain connection, or implicit TLS from the first byte. Set
# exactly one; enabling both is a configuration error.
# @type=boolean
PAPERLESS_EMAIL_USE_TLS=false
# @type=boolean
PAPERLESS_EMAIL_USE_SSL=false

# ─── Container ─────────────────────────────────────────────────────────────

# UID/GID the process runs as inside the container, applied by the image's
# s6 init. Only matters when the consume or export directory is a host bind
# mount whose ownership must line up; with named volumes the defaults are
# fine, and they are ignored entirely when the container is started as a
# non-root user.
# @type=number
# @docs("Docker-specific options", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#docker-specific-options-docker)
USERMAP_UID=
# @type=number
USERMAP_GID=

# ─── Misc ──────────────────────────────────────────────────────────────────

# Title and logo shown in the UI. The logo is a path relative to the media
# root; upstream has patched stored-XSS bugs in SVG logo handling before
# (GHSA-6p53-hqqw-8j62), so treat an uploaded SVG as untrusted content.
# @docs("Frontend settings", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#frontend-settings)
PAPERLESS_APP_TITLE=
PAPERLESS_APP_LOGO=

# Record who changed what on documents and metadata. On by default; the
# history is what lets you answer "when did this get retagged, and by whom".
# @type=boolean
# @docs("Audit trail", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#audit-trail)
PAPERLESS_AUDIT_LOG_ENABLED=true

# Ask GitHub whether a newer release exists and show it in the UI. The
# literal string "default" means "not answered yet" and the UI prompts once;
# true or false answers it permanently.
PAPERLESS_ENABLE_UPDATE_CHECK=default

# NLTK-backed stemming and stop-words for the automatic classifier. Costs
# memory; turning it off makes suggestions cruder, not broken.
# @type=boolean
PAPERLESS_ENABLE_NLTK=true

# Let workflow webhooks reach private/loopback addresses. On by default,
# which makes an operator-authored webhook an SSRF primitive against the
# stack's private network. Set false when workflows are only meant to call
# out to the internet.
# @type=boolean
# @docs("Workflow webhooks", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#workflow-webhooks)
PAPERLESS_WEBHOOKS_ALLOW_INTERNAL_REQUESTS=true

# The v3 "Paperless AI" features (LLM suggestions, document chat). Off by
# default; enabling it needs an LLM backend, model and API key, all of which
# are documented in the configuration reference's AI section.
# @type=boolean
# @docs("AI", https://github.com/paperless-ngx/paperless-ngx/blob/v3.1.2/docs/configuration.md#ai-ai)
PAPERLESS_AI_ENABLED=false
