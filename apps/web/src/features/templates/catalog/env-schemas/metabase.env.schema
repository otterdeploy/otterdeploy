# Metabase 0.63.16.4 (OSS) environment schema (@env-spec / varlock format).
#
# The compose pins metabase/metabase:v0.63.16.4, the newest immutable OSS
# build on 2026-09-04 (research date); `latest`, `v0.63.x` and `v0.63.16.x`
# all resolve to the same digest
# (sha256:1fa6f6b523a44159c26f6eb0704ed6189a8c7863fdab9e0c2483f388728c7ce3).
# The repo is actively shipping: v0.63.16.4 was pushed 2026-09-03. Metabase's
# 4th version component is a hotfix build, and 63.16.1→63.16.4 are almost
# entirely security backports (LIKE-metacharacter escaping in search, LDAP
# server-certificate validation, site-url derivation restricted to
# authenticated superusers, X-Metabase-Session preferred over the session
# cookie, single-statement enforcement for impersonated SQL-JDBC queries,
# rejection of unneeded JDBC connection properties, settings stored encrypted
# under the setting's name), so the newest build is taken over a more
# "settled" one on purpose.
#
# Source: Metabase is Clojure and derives env names from `defsetting` macros
# (`site-url` -> `MB_SITE_URL`) plus `config/config-str` keys
# (`:mb-db-type` -> `MB_DB_TYPE`, `:max-session-age` -> `MAX_SESSION_AGE`,
# which is NOT MB_-prefixed). Read at tag v0.63.16.4 from
# src/metabase/config/core.clj (app-defaults), src/metabase/app_db/env.clj,
# src/metabase/system/settings.clj, src/metabase/channel/settings.clj,
# src/metabase/sso/settings.clj, src/metabase/embedding/settings.clj,
# src/metabase/public_sharing/settings.clj, src/metabase/session/settings.clj,
# src/metabase/server/instance.clj, src/metabase/util/encryption.clj,
# src/metabase/plugins/impl.clj and bin/docker/run_metabase.sh, then
# cross-checked against docs/configuring-metabase/environment-variables.md in
# the same tree.
#
# This file covers what the compose sets plus the groups an operator actually
# reaches for: application database, site identity, web server, secrets,
# email, authentication, sharing/embedding, uploads, plugins, logging and the
# container entrypoint. Metabase exposes ~345 env-settable settings in total;
# the full surface is documented upstream on the environment-variables page
# linked below, and anything an admin can set in the UI can also be set here
# (an env-provided value then becomes read-only in the UI).

# @defaultSensitive=false @defaultRequired=infer
# @docs("Metabase environment variables", https://www.metabase.com/docs/latest/configuring-metabase/environment-variables)
# ---

# ─── Application database (bundled Postgres) ──────────────────────────────

# Which database Metabase stores its own questions, dashboards, users and
# permissions in. Left unset Metabase falls back to an embedded H2 file,
# which upstream explicitly does not support for production. The compose sets
# "postgres" and ships a Postgres sibling for it.
# @required @type=enum(postgres, mysql, h2)
# @docs("Configuring the application database", https://www.metabase.com/docs/latest/installation-and-operation/configuring-application-database)
MB_DB_TYPE=postgres

# Hostname of the application database. Platform-owned: resolved to the
# bundled `db` service, never typed by hand.
# @required
MB_DB_HOST=${{stack.db.HOST}}

# Port of the application database. Matches the bundled Postgres, which
# listens on the default 5432.
# @required @type=port
MB_DB_PORT=5432

# Database name inside the application database. Must match POSTGRES_DB on
# the bundled Postgres or Metabase connects to a database that does not exist.
# @required
MB_DB_DBNAME=metabase

# Role Metabase connects as. Must match POSTGRES_USER below.
# @required
MB_DB_USER=metabase

# Password for MB_DB_USER, the same generated secret the bundled Postgres is
# created with.
# @required @sensitive
MB_DB_PASS=${POSTGRES_PASSWORD}

# Full JDBC/URI connection string for the application database. When set it
# WINS over MB_DB_HOST/PORT/DBNAME and even determines MB_DB_TYPE
# (app_db/env.clj derives the type from the string). Leave empty here: the
# compose already describes the bundled database field by field.
# @sensitive
MB_DB_CONNECTION_URI=

# Path to a client SSL certificate (PEM) used when connecting to an external
# application database over TLS. Not needed for the bundled Postgres, which
# is reached over the private stack network.
MB_DB_SSL_CERT=

# When "false", Metabase prints the pending Liquibase migrations and exits
# instead of applying them, for operators who run schema changes by hand
# before an upgrade. Leave "true" or the container will not start after a
# version bump.
# @type=boolean
# @docs("Upgrading Metabase", https://www.metabase.com/docs/latest/installation-and-operation/upgrading-metabase)
MB_DB_AUTOMIGRATE=true

# Logs every SQL statement Metabase issues against its OWN application
# database. Very noisy; a debugging aid, not a production setting.
# @type=boolean
MB_DB_LOGGING=true

# Only read when MB_DB_TYPE is h2 (or unset): the path to the H2 file.
# Irrelevant with the bundled Postgres, kept declared because the container
# entrypoint relocates this file during an H2-to-Postgres migration.
# @docs("Migrating from H2", https://www.metabase.com/docs/latest/installation-and-operation/migrating-from-h2)
MB_DB_FILE=metabase.db

# Docker-secret variants read by bin/docker/run_metabase.sh: the value is read
# from the file at this path and exported under the name without `_FILE`.
# Only these three application-database variables have a `_FILE` twin. Setting
# both a variable and its `_FILE` twin makes the entrypoint fail.
MB_DB_USER_FILE=
MB_DB_PASS_FILE=
MB_DB_CONNECTION_URI_FILE=

# ─── Bundled Postgres (the `db` service) ──────────────────────────────────

# Role the Postgres image creates on first boot. Metabase connects as this
# role, so it must equal MB_DB_USER.
# @required
POSTGRES_USER=metabase

# Password for that role, generated by otterdeploy and shared with
# MB_DB_PASS. Changing it after the data volume exists does NOT change the
# role's password, because Postgres only reads it on first initialization.
# @required @sensitive
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Database created on first boot. Must equal MB_DB_DBNAME.
# @required
POSTGRES_DB=metabase

# ─── Secrets and at-rest encryption ───────────────────────────────────────

# Encrypts the credentials of every data warehouse you connect Metabase to,
# plus other secret settings, inside the application database. WITHOUT IT the
# passwords for your connected databases sit in the app DB in a recoverable
# form: anyone with a copy of the Postgres volume, a backup, or read access to
# the app DB can extract them. Minimum 16 characters, enforced at startup
# (util/encryption.clj asserts the length); use a random base64 string. Once
# set, it is NOT rotatable in place: rotating or losing the key leaves every
# saved connection undecryptable and Metabase failing to read those settings,
# so treat it as permanent for the life of the volume and back it up with the
# database.
# @required @sensitive @type=string(minLength=16)
# @docs("Encrypting database details at rest", https://www.metabase.com/docs/latest/databases/encrypting-details-at-rest)
MB_ENCRYPTION_SECRET_KEY=

# When set, calls to the internal `/api/notify/*` endpoints must present it in
# the `X-Metabase-Apikey` header; unset, those endpoints are open to anyone
# who can reach the container. Unrelated to the per-user API keys created in
# the admin UI.
# @sensitive
MB_API_KEY=

# ─── Site identity ────────────────────────────────────────────────────────

# The absolute URL Metabase believes it is served from, used to build links
# in emails and subscriptions, auth/SSO redirects and embedding origins. If
# left empty Metabase learns it from the request headers of the first
# AUTHENTICATED admin (63.16.4 narrowed that derivation to authenticated
# superusers); set it explicitly for anything provisioned headlessly. Include
# the scheme: http:// and https:// behave differently.
# @type=url
# @docs("Metabase settings", https://www.metabase.com/docs/latest/configuring-metabase/settings)
MB_SITE_URL=

# Display name of this instance, shown in the UI and in outgoing email.
MB_SITE_NAME=Metabase

# Default UI/report language for the instance, as an ISO code ("en", "fr",
# "pt_BR"). Individual users can still override it in their own settings.
# @docs("Localization", https://www.metabase.com/docs/latest/configuring-metabase/localization)
MB_SITE_LOCALE=en

# Address shown to users as "contact your admin" and used as the reply target
# for some system emails.
# @type=email
MB_ADMIN_EMAIL=

# Timezone used when Metabase reports and groups by date, e.g.
# "America/New_York". Empty means the database's own timezone is used.
# @docs("Timezones", https://www.metabase.com/docs/latest/configuring-metabase/timezones)
MB_REPORT_TIMEZONE=

# Which day charts and "week" groupings start on.
# @type=enum(sunday, monday, tuesday, wednesday, thursday, friday, saturday)
MB_START_OF_WEEK=sunday

# Sends anonymous product-usage telemetry to Metabase. Set to "false" to turn
# it off entirely.
# @type=boolean
# @docs("Information collection", https://www.metabase.com/docs/latest/installation-and-operation/information-collection)
MB_ANON_TRACKING_ENABLED=true

# Periodically fetches static.metabase.com/version-info.json to tell admins a
# newer release exists. "false" makes the instance stop calling out.
# @type=boolean
MB_CHECK_FOR_UPDATES=true

# Seeds the demo "E-commerce insights" content on a brand-new instance. Set
# "false" to start with an empty Metabase; ignored once setup has run.
# @type=boolean
MB_LOAD_SAMPLE_CONTENT=true

# ─── Web server (Jetty) ───────────────────────────────────────────────────

# Address Jetty binds to. The JAR defaults to localhost, but the image's
# entrypoint (bin/docker/run_metabase.sh) exports 0.0.0.0 when this is empty,
# which is what the container network needs. Setting it to localhost here
# would make the service unreachable.
# @docs("Customizing the Jetty web server", https://www.metabase.com/docs/latest/configuring-metabase/customizing-jetty-webserver)
MB_JETTY_HOST=0.0.0.0

# Port Jetty listens on. The compose exposes container port 3000 and the
# healthcheck curls http://localhost:3000/api/health. Change this and both
# the route and the healthcheck break.
# @type=port
MB_JETTY_PORT=3000

# Size of the Jetty request-handling thread pool. Raise it only for genuinely
# concurrent instances; every thread also holds application-database
# connections.
# @type=number
MB_JETTY_MAXTHREADS=50

# Terminate TLS inside the container instead of at a reverse proxy. Requires
# MB_JETTY_SSL_PORT plus a Java keystore mounted into the container.
# Unnecessary behind otterdeploy's own HTTPS termination.
# @type=boolean
MB_JETTY_SSL=
# @type=port
MB_JETTY_SSL_PORT=
MB_JETTY_SSL_KEYSTORE=
# @sensitive
MB_JETTY_SSL_KEYSTORE_PASSWORD=

# Answers every plain-HTTP request with a redirect to the HTTPS form of
# MB_SITE_URL. Only safe once MB_SITE_URL is an https:// URL and TLS actually
# terminates in front of the container; otherwise it produces a redirect loop.
# @type=boolean
MB_REDIRECT_ALL_REQUESTS_TO_HTTPS=false

# ─── Sessions and passwords ───────────────────────────────────────────────

# Absolute session lifetime in MINUTES, not an inactivity timeout. Note the
# name: this one is read as `MAX_SESSION_AGE`, with no MB_ prefix. Default is
# 20160 (14 days).
# @type=number
# @docs("Changing session expiration", https://www.metabase.com/docs/latest/people-and-groups/changing-session-expiration)
MAX_SESSION_AGE=20160

# Inactivity timeout, as a JSON object on ONE line, e.g.
# {"amount":120,"unit":"minutes"} with unit one of seconds/minutes/hours.
# Empty means sessions only end at MAX_SESSION_AGE.
MB_SESSION_TIMEOUT=

# "true" forces browser-session cookies, so every session ends when the
# browser closes and the "Remember me" checkbox is overridden.
# @type=boolean
MB_SESSION_COOKIES=

# Strength class enforced on locally-managed passwords. "weak" also disables
# the common-password blocklist; "strong-enough" only enforces a 15-character
# minimum.
# @type=enum(weak, normal, strong, strong-enough)
# @docs("Changing password complexity", https://www.metabase.com/docs/latest/people-and-groups/changing-password-complexity)
MB_PASSWORD_COMPLEXITY=normal

# Minimum password length, overriding the length implied by
# MB_PASSWORD_COMPLEXITY. Applies to new passwords only.
# @type=number
MB_PASSWORD_LENGTH=6

# ─── Email (SMTP) ─────────────────────────────────────────────────────────

# SMTP server that sends dashboard subscriptions, alerts, invites and password
# resets. With no host configured those features are silently unavailable.
# @docs("Setting up email", https://www.metabase.com/docs/latest/configuring-metabase/email)
MB_EMAIL_SMTP_HOST=
# @type=port
MB_EMAIL_SMTP_PORT=
# Connection protocol. "none" (the default) sends unencrypted. Pick starttls
# on 587 or ssl on 465 for any server outside the private network.
# @type=enum(none, ssl, tls, starttls)
MB_EMAIL_SMTP_SECURITY=none
MB_EMAIL_SMTP_USERNAME=
# @sensitive
MB_EMAIL_SMTP_PASSWORD=

# Envelope sender. The upstream default is a metabase.com address that your
# own SMTP provider will almost certainly refuse to send as, so set a domain
# you control.
# @type=email
MB_EMAIL_FROM_ADDRESS=notifications@metabase.com

# Display name shown next to the sender address. Rejected at save time if it
# contains any of ( ) < > [ ] : ; @ / \ , . "
MB_EMAIL_FROM_NAME=

# Reply-To addresses, as a one-line JSON array of email strings, e.g.
# ["support@example.com"]. Each entry is validated as an email address.
MB_EMAIL_REPLY_TO=

# Metabase BCCs subscription recipients by default so they cannot see each
# other. "false" puts everyone in the To: header instead.
# @type=boolean
MB_BCC_ENABLED=true

# Splits a notification with more recipients than this into several messages,
# working around providers (SES and friends) that reject oversized recipient
# lists. 0 disables the batching.
# @type=number
MB_EMAIL_MAX_RECIPIENTS_PER_MESSAGE=50

# Docker-secret variants handled by the image entrypoint, same rule as the
# MB_DB_* ones: value comes from the file at this path.
MB_EMAIL_SMTP_USERNAME_FILE=
MB_EMAIL_SMTP_PASSWORD_FILE=

# ─── Authentication ───────────────────────────────────────────────────────

# Google Sign-In OAuth client ID from the Google Cloud console. Metabase
# rejects any value not ending in ".apps.googleusercontent.com"; setting it is
# what enables the Google login button.
# @docs("Google Sign-In", https://www.metabase.com/docs/latest/people-and-groups/google-sign-in)
MB_GOOGLE_AUTH_CLIENT_ID=

# Turns the configured Google Sign-In on or off without clearing the client
# ID. Defaults to enabled whenever a client ID is present.
# @type=boolean
MB_GOOGLE_AUTH_ENABLED=

# Master switch for LDAP authentication; the rest of the MB_LDAP_* values are
# only consulted when this is true.
# @type=boolean
# @docs("LDAP", https://www.metabase.com/docs/latest/people-and-groups/ldap)
MB_LDAP_ENABLED=false
MB_LDAP_HOST=
# 389 for plain/StartTLS, 636 for LDAPS.
# @type=port
MB_LDAP_PORT=389
# @type=enum(none, ssl, starttls)
MB_LDAP_SECURITY=none
# Path to a JKS trust store of CA certificates used to validate the LDAP
# server's TLS certificate. As of 63.16.4 Metabase validates that certificate
# instead of accepting any presented chain, so a private CA needs this.
MB_LDAP_TRUST_STORE=
# Distinguished Name Metabase binds as to look users up.
MB_LDAP_BIND_DN=
# @sensitive
MB_LDAP_PASSWORD=
# Search base for users, searched recursively.
MB_LDAP_USER_BASE=
# The literal {login} is replaced with whatever the user typed.
MB_LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(|(uid={login})(mail={login})))
MB_LDAP_ATTRIBUTE_EMAIL=mail
MB_LDAP_ATTRIBUTE_FIRSTNAME=givenName
MB_LDAP_ATTRIBUTE_LASTNAME=sn
# Maps LDAP group membership onto Metabase groups; needs MB_LDAP_GROUP_BASE.
# @type=boolean
MB_LDAP_GROUP_SYNC=false
MB_LDAP_GROUP_BASE=

# Docker-secret variants for the two LDAP bind values, handled by the image
# entrypoint.
MB_LDAP_BIND_DN_FILE=
# @sensitive
MB_LDAP_PASSWORD_FILE=

# Allows the built-in email/password login form alongside SSO. Only honored on
# paid plans; on this OSS image local login is always available.
# @type=boolean
MB_ENABLE_PASSWORD_LOGIN=true

# ─── Sharing and embedding ────────────────────────────────────────────────

# Lets admins mint public, UNAUTHENTICATED links and iframes for questions and
# dashboards. It defaults to ON: anyone holding such a link sees that data
# without logging in, and the underlying query runs with no permission check.
# Set "false" on instances with sensitive data.
# @type=boolean
# @docs("Public links", https://www.metabase.com/docs/latest/embedding/public-links)
MB_ENABLE_PUBLIC_SHARING=true

# Static embedding: signed-JWT iframes of individual questions/dashboards.
# @type=boolean
# @docs("Static embedding", https://www.metabase.com/docs/latest/embedding/static-embedding)
MB_ENABLE_EMBEDDING_STATIC=false

# The HMAC key those static-embedding JWTs are signed with. Anyone who learns
# it can mint a token for any embeddable question or dashboard, including
# parameter values you meant to lock. Treat it like a password and rotate it
# if it leaks.
# @sensitive
MB_EMBEDDING_SECRET_KEY=

# Interactive (full-app) embedding, a paid feature; the toggle exists on OSS
# but the functionality is licensed.
# @type=boolean
# @docs("Interactive embedding", https://www.metabase.com/docs/latest/embedding/full-app-embedding)
MB_ENABLE_EMBEDDING_INTERACTIVE=false

# Space-delimited allowlist of origins permitted to frame the interactive
# embed. Keep it to the exact origins you own. A wildcard here is what turns
# embedding into a clickjacking surface.
MB_EMBEDDING_APP_ORIGINS_INTERACTIVE=

# Embedding via the React SDK, and the origins allowed to use it.
# @type=boolean
# @docs("Embedded analytics SDK", https://www.metabase.com/docs/latest/embedding/introduction)
MB_ENABLE_EMBEDDING_SDK=false
MB_EMBEDDING_APP_ORIGINS_SDK=

# Modular ("simple") embedding.
# @type=boolean
MB_ENABLE_EMBEDDING_SIMPLE=false

# ─── Uploads ──────────────────────────────────────────────────────────────

# Which connected database receives CSV uploads, as a one-line JSON object:
# {"db_id":2,"schema_name":"public","table_prefix":"upload_"}. Uploads write
# real tables into that database, so point it at a schema you are willing to
# let analysts create tables in, never the Metabase application database.
# The older MB_UPLOADS_ENABLED / MB_UPLOADS_DATABASE_ID /
# MB_UPLOADS_SCHEMA_NAME / MB_UPLOADS_TABLE_PREFIX variables were removed in
# 0.50 and are ignored at this version.
# @docs("Uploading data", https://www.metabase.com/docs/latest/databases/uploads)
MB_UPLOADS_SETTINGS=

# ─── Plugins (database drivers) ───────────────────────────────────────────

# Directory scanned at boot for third-party driver .jar files. Defaults to
# ./plugins under the image's /app working directory; Metabase falls back to a
# temp directory (losing drivers on restart) if it cannot write there, so a
# persistent driver set needs this pointed at a mounted volume.
# @docs("Community drivers", https://www.metabase.com/docs/latest/developers-guide/community-drivers)
MB_PLUGINS_DIR=plugins

# YAML file of settings, databases and users applied at startup. Requires a
# paid token feature (config-text-file); on this OSS image it is inert.
# @docs("Configuration file", https://www.metabase.com/docs/latest/configuring-metabase/config-file)
MB_CONFIG_FILE_PATH=config.yml

# ─── Logging ──────────────────────────────────────────────────────────────

# ANSI color and emoji in log output. Both default to true off Windows; set
# "false" for log collectors that would otherwise store escape codes.
# @type=boolean
# @docs("Log configuration", https://www.metabase.com/docs/latest/configuring-metabase/log-configuration)
MB_COLORIZE_LOGS=true
# @type=boolean
MB_EMOJI_IN_LOGS=true

# Comma-separated Clojure namespaces to trace, e.g. "metabase.query-processor".
# Extremely verbose; a debugging aid only.
MB_NS_TRACE=

# Enables internal test-only API endpoints. Never set this on a deployed
# instance.
# @type=boolean
MB_ENABLE_TEST_ENDPOINTS=false

# ─── Container / JVM ──────────────────────────────────────────────────────

# Extra flags for the JVM the entrypoint launches, e.g. "-Xmx2g" for a heap
# cap, or "-Dlog4j.configurationFile=file:///path/log4j2.xml" to swap in a
# custom log configuration. Appended to the image's own JAVA_OPTS.
JAVA_OPTS=

# Sets -Duser.timezone for the JVM. Affects how the JVM parses and prints
# times; MB_REPORT_TIMEZONE is what controls query results.
JAVA_TIMEZONE=

# UID/GID the entrypoint runs Metabase as, so a mounted host directory ends up
# owned correctly. Default 2000/2000.
# @type=number
MUID=2000
# @type=number
MGID=2000
