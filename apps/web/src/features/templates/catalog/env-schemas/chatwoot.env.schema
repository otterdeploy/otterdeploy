# Chatwoot v4.17.1-ce environment schema (@env-spec / varlock format).
#
# The compose pins chatwoot/chatwoot:v4.17.1-ce, the Community Edition build of
# the v4.17.1 tag (published 2026-08-27). CE is the same tree with `enterprise/`
# and `spec/enterprise/` deleted and `CW_EDITION=ce` baked in
# (.github/workflows/publish_foss_docker.yml), which is what a self-hosted
# install without an enterprise license runs. It is also the tag that dodges
# chatwoot/chatwoot#12078, where the untagged `v4.x` images crash-loop on a
# FRESH database before the operator can run the one-time migration.
#
# Source: grep of `ENV[` / `ENV.fetch(` across app/, lib/, config/, db/ at
# v4.17.1, plus the ERB-evaluated config/database.yml, config/storage.yml,
# config/secrets.yml, config/puma.rb, config/sidekiq.yml, config/scout_apm.yml,
# config/newrelic.yml and config/elastic_apm.yml.
#
# Two things the code does that .env.example does not say:
#
#   * `GlobalConfigService.load(KEY, default)` (lib/global_config_service.rb)
#     reads the DB-backed InstallationConfig FIRST and only falls back to
#     `ENV.fetch(KEY)`, at which point it WRITES the env value into the
#     database once. Every key in the "App Configs" section below is therefore
#     a one-shot seed: after first boot the value lives in Super Admin > App
#     Configs and editing the env var changes nothing.
#   * The docker entrypoint does not migrate. docker/entrypoints/rails.sh only
#     waits for Postgres and runs `bundle check`; a fresh install needs one
#     `bundle exec rails db:chatwoot_prepare` in the rails container, and the
#     database must have the pgvector extension available (hence the bundled
#     pgvector/pgvector:pg16 image).
#
# Where .env.example and the code disagree, the code wins and is used below:
# LOG_SIZE (example 500, code default 1024), RACK_ATTACK_LIMIT (example 300,
# code default 3000), REDIS_ALFRED_SIZE (example 10, code default 5), SMTP_PORT
# (example 1025 for the dev mailhog, code default 587). .env.example also lists
# FCM_SERVER_KEY, RAILS_INBOUND_EMAIL_PASSWORD, MAILGUN_INGRESS_SIGNING_KEY and
# MANDRILL_INGRESS_API_KEY, none of which v4.17.1 reads from the environment at
# all (the Action Mailbox ingress credentials come from Rails credentials).
#
# Not declared here, deliberately:
#   * `360DIALOG_BASE_URL` (app/services/whatsapp/providers/whatsapp_360_dialog_service.rb,
#     which defaults to the 360dialog WABA v1 gateway) is real but starts with a
#     digit, so it is not a legal @env-spec key. Set it on the service directly
#     if you self-host a 360dialog gateway.
#   * Keys read only from `enterprise/`, which the -ce image deletes:
#     VOICE_CALL_STUN_URLS, STRIPE_WEBHOOK_SECRET, CHATWOOT_HUB_URL.
#   * Rake-task arguments that are read from ENV but are not deployment
#     configuration: ACCOUNT_ID, INBOX_ID, IDS, LIMIT, COUNT, BATCH_SIZE,
#     CSV_INPUT, INPUT, OUTPUT, FROM, STATUS, SCHEMA, SLA_POLICY_ID,
#     UPDATE_BLOB_SERVICE_NAME, ANNOTATERB_SKIP_ON_DB_TASKS.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Chatwoot environment variables", https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Public URL of this installation, with scheme and no trailing slash. Every
# link Chatwoot builds comes from it: widget script snippets, email links,
# OAuth callbacks, and the help center when HELPCENTER_URL is unset
# (lib/chatwoot_app.rb). Wrong here means a working app that hands out
# unreachable URLs.
# @required
# @type=url
FRONTEND_URL=

# Rails' signing/encryption secret for cookies and sessions
# (config/secrets.yml). This must be a GENERATED RANDOM STRING, not a URL, not
# a hostname, and not a value reused from another app: anyone who knows it can
# forge a session for any agent. Generate with `openssl rand -hex 64` (or
# `bundle exec rake secret`) and keep it alphanumeric. Changing it after first
# boot logs every user out.
# @required
# @sensitive
# @type=string(minLength=32)
SECRET_KEY_BASE=

# Rails environment the container boots in. `production` is what the image is
# built for: any other value changes asset serving, caching, logging, and
# turns Rack::Attack off entirely.
# @required
# @type=enum(production, development, staging, test)
RAILS_ENV=production

# Node environment, set by the compose to match RAILS_ENV. The Ruby code never
# reads it; it exists for the asset tooling baked into the image.
# @type=enum(production, development)
NODE_ENV=production

# Free-form label for how this instance was installed, reported with the
# telemetry ping (lib/chatwoot_hub.rb). `docker` is what upstream's own compose
# uses. Purely informational.
INSTALLATION_ENV=docker

# Separate public URL for the help center / portal pages, when they are served
# on their own domain. Empty means the portal is served from FRONTEND_URL.
# @type=url
HELPCENTER_URL=

# Locale used for unauthenticated pages, and the default language given to
# newly created accounts (app/controllers/concerns/switch_locale.rb). Empty
# falls back to `en`.
DEFAULT_LOCALE=

# Redirect every request to HTTPS and mark session cookies `Secure`
# (config/environments/production.rb, config/initializers/session_store.rb).
# Leave false when otterdeploy's proxy already terminates TLS in front of the
# container and speaks plain HTTP to it, otherwise the app and the proxy will
# redirect at each other forever.
# @type=boolean
FORCE_SSL=false

# Serve the compiled frontend assets from the Rails process itself. The image
# is built with it on and there is no separate asset server in this compose,
# so turning it off serves a blank dashboard.
# @type=boolean
RAILS_SERVE_STATIC_FILES=true

# Absolute base URL of a CDN to rewrite asset hosts to, e.g.
# https://cdn.example.com. Empty serves assets from FRONTEND_URL.
# @type=url
ASSET_CDN_HOST=

# Disables every dashboard (frontend) route and leaves only the APIs
# (config/routes.rb). Only for a headless installation driven entirely through
# the platform API.
# @type=boolean
CW_API_ONLY_SERVER=false

# Blanks out the `enterprise/` code path even when it is present. Already
# implied by the -ce image, which ships no `enterprise/` directory at all
# (lib/chatwoot_app.rb).
# @type=boolean
DISABLE_ENTERPRISE=

# Edition label reported with telemetry. The -ce image bakes in `ce`; do not
# override.
CW_EDITION=

# ─── Bundled Postgres ──────────────────────────────────────────────────────
# The db service runs pgvector/pgvector:pg16 because Chatwoot v4 requires the
# pgvector extension; a plain postgres image fails `db:chatwoot_prepare`.
# @docs("Upgrade to Chatwoot v4 (pgvector)", https://www.chatwoot.com/docs/self-hosted/runbooks/upgrade-to-chatwoot-v4)

# Hostname of the bundled Postgres, resolved by the platform. Never type a
# literal here.
# @required
POSTGRES_HOST=${{stack.db.HOST}}

# Port the app connects on. The bundled image listens on the default 5432;
# docker/entrypoints/helpers/pg_database_url.rb exports 5432 when this is
# empty, so leaving it blank is correct.
# @type=port
POSTGRES_PORT=

# Role Chatwoot connects as, and the role the bundled Postgres creates on
# first boot (POSTGRES_USER below). Both are set to `chatwoot` by the compose;
# they must stay in step.
# @required
POSTGRES_USERNAME=chatwoot

# Password for that role, on both sides of the connection. Platform prompt
# key: generated once and threaded into the app, the worker, and the bundled
# Postgres. Changing it after first boot requires changing the role's password
# in Postgres too.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database name. Set to `chatwoot` by the compose and matched by the bundled
# Postgres' POSTGRES_DB. Without it, production would default to
# `chatwoot_production` (config/database.yml) and find nothing.
# @required
POSTGRES_DATABASE=chatwoot

# Database the bundled Postgres image creates on first boot. Consumed by the
# db service only, and it must equal POSTGRES_DATABASE above.
# @required
POSTGRES_DB=chatwoot

# Superuser the bundled Postgres image creates on first boot. Consumed by the
# db service only, and it must equal POSTGRES_USERNAME above.
# @required
POSTGRES_USER=chatwoot

# Per-statement timeout applied to every connection (config/database.yml).
# Accepts a Postgres interval string; the built-in default is `14s`, chosen to
# sit just under the request timeout. Raise it only for a known slow report.
POSTGRES_STATEMENT_TIMEOUT=14s

# How often, in seconds, ActiveRecord's reaper hunts for connections orphaned
# by dead threads.
# @type=number
DB_POOL_REAPING_FREQUENCY=30

# ─── Bundled Redis ─────────────────────────────────────────────────────────
# Redis carries Sidekiq's queues, ActionCable, the online-presence keys, and
# the GlobalConfig cache. Losing it loses queued jobs, not conversations.

# Connection URL for the bundled Redis, assembled by the platform from the
# generated password and the sibling's hostname. Never type a literal here.
# @required
# @sensitive
REDIS_URL=redis://:${REDIS_PASSWORD}@${{stack.redis.HOST}}:6379

# Password for that Redis. Platform prompt key: the compose passes it both to
# `redis-server --requirepass` and to the app, and lib/redis/config.rb sends it
# on every connection. It is also the default password used for sentinels.
# @required
# @sensitive
REDIS_PASSWORD=

# Comma-separated `host:port` list of Redis Sentinels, e.g.
# `sentinel1:26379,sentinel2:26379`. Setting it switches the client into
# sentinel mode and REDIS_URL is replaced by `redis://<master name>`. Leave
# empty for the bundled single-node Redis.
# @docs("Redis Sentinel", https://redis.io/docs/latest/operate/oss_and_stack/management/sentinel/)
REDIS_SENTINELS=

# Master name to ask the sentinels for. Only read when REDIS_SENTINELS is set;
# the built-in default is `mymaster`.
REDIS_SENTINEL_MASTER_NAME=

# Password for the sentinels themselves, when it differs from REDIS_PASSWORD.
# Set it to an empty string only if the sentinels take no password.
# @sensitive
REDIS_SENTINEL_PASSWORD=

# `none` disables TLS certificate verification for Redis connections
# (config/application.rb). Only needed for a managed Redis with a self-signed
# chain; anything other than the literal `none` keeps full verification.
# @type=enum(none)
REDIS_OPENSSL_VERIFY_MODE=

# Set to any non-empty value to stop the ActionCable adapter from sending the
# `CLIENT SETNAME` command, which some managed Redis proxies reject
# (config/initializers/actioncable.rb).
REDIS_DISABLE_CLIENT_COMMAND=

# Connection-pool sizes for Chatwoot's two named Redis pools: `alfred` (the
# GlobalConfig / online-status pool) and `velma` (the ActionCable pool).
# @type=number
REDIS_ALFRED_SIZE=5
# @type=number
REDIS_VELMA_SIZE=10

# ─── Web and worker processes ──────────────────────────────────────────────

# Port Puma binds inside the container (config/puma.rb). The compose exposes
# container port 3000 and passes `-p 3000` on the command line, so changing
# this alone does nothing; change both or routing breaks.
# @type=port
PORT=3000

# Puma threads per worker, and also the ActiveRecord pool size in the web
# process (config/database.yml). RAILS_MIN_THREADS defaults to the max, i.e.
# no thread pool shrinking.
# @type=number
RAILS_MAX_THREADS=5
# @type=number
RAILS_MIN_THREADS=

# Puma worker processes. `0` (the default) runs single-process, which is what
# a one-container deployment wants; each extra worker is another full copy of
# the app in memory.
# @type=number
# @docs("Puma DSL", https://puma.io/puma/Puma/DSL.html)
WEB_CONCURRENCY=0

# Sidekiq threads in the worker process, and the ActiveRecord pool size there
# (config/sidekiq.yml, config/database.yml). Raising it raises the database
# connection count by the same amount.
# @type=number
# @docs("Sidekiq concurrency", https://github.com/sidekiq/sidekiq/wiki/Advanced-Options)
SIDEKIQ_CONCURRENCY=10

# Logs a line every time Sidekiq dequeues a job. Very loud; for debugging a
# stuck queue only.
# @type=boolean
ENABLE_SIDEKIQ_DEQUEUE_LOGGER=false

# ─── Logging ───────────────────────────────────────────────────────────────

# Send logs to the container's stdout instead of writing log files inside the
# container. Set by the compose; turning it off hides the logs in a volume-less
# filesystem.
# @type=boolean
RAILS_LOG_TO_STDOUT=true

# Rails log level.
# @type=enum(debug, info, warn, error, fatal, unknown)
LOG_LEVEL=info

# Max size in MEGABYTES of the on-disk log file before rotation. Only relevant
# when RAILS_LOG_TO_STDOUT is off.
# @type=number
LOG_SIZE=1024

# Replace Rails' multi-line request logs with lograge's one-line-per-request
# format (config/initializers/lograge.rb).
# @type=boolean
LOGRAGE_ENABLED=false

# ─── File storage (Active Storage) ─────────────────────────────────────────
# Picks a service block out of config/storage.yml. `local` writes to
# /app/storage, which the compose backs with the chatwoot-storage volume; any
# other value needs the matching credentials below and makes that volume dead
# weight.
# @docs("Configuring S3 as cloud storage", https://www.chatwoot.com/docs/configuring-s3-bucket-as-cloud-storage)

# @type=enum(local, amazon, google, microsoft, s3_compatible)
ACTIVE_STORAGE_SERVICE=local

# Upload attachments straight from the browser to the storage backend with a
# signed URL, skipping the Rails process. Requires a CORS policy on the bucket
# and is meaningless with the `local` service.
# @type=boolean
DIRECT_UPLOADS_ENABLED=

# Restrict libvips to its audited image loaders when generating attachment
# previews. Baked into the image as 1; only unset it if a legitimate upload
# format stops rendering.
VIPS_BLOCK_UNTRUSTED=1

# Amazon S3 (ACTIVE_STORAGE_SERVICE=amazon). AWS_REGION is also the fallback
# region for the Sidekiq CloudWatch reporter further down.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Google Cloud Storage (ACTIVE_STORAGE_SERVICE=google). GCS_CREDENTIALS is the
# service-account JSON key, as a single line.
GCS_PROJECT=
# @sensitive
GCS_CREDENTIALS=
GCS_BUCKET=

# Azure Blob Storage (ACTIVE_STORAGE_SERVICE=microsoft). Leave
# AZURE_STORAGE_BLOB_HOST empty unless you front the account with a custom
# domain.
AZURE_STORAGE_ACCOUNT_NAME=
# @sensitive
AZURE_STORAGE_ACCESS_KEY=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_BLOB_HOST=

# Any S3-compatible endpoint: MinIO, DigitalOcean Spaces, R2, Backblaze B2
# (ACTIVE_STORAGE_SERVICE=s3_compatible). STORAGE_FORCE_PATH_STYLE=true is what
# MinIO and most self-hosted gateways need.
STORAGE_ENDPOINT=
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
# @sensitive
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
# @type=boolean
STORAGE_FORCE_PATH_STYLE=false

# ─── Outgoing email (SMTP) ─────────────────────────────────────────────────
# config/initializers/mailer.rb. If SMTP_ADDRESS is blank, Rails falls back to
# `sendmail`, which does not exist in this image: no password resets, no
# invitations, no conversation-reply emails. Set SMTP_ADDRESS for a working
# install.

# Envelope sender for every outgoing email. Accepts a bare address or a
# `Name <address>` pair. Empty falls back to Chatwoot's own
# `Chatwoot <accounts@chatwoot.com>`, which will not pass your domain's SPF.
MAILER_SENDER_EMAIL=

# SMTP relay hostname. Empty selects the sendmail delivery method, which this
# image cannot satisfy.
SMTP_ADDRESS=
# @type=port
SMTP_PORT=587
SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=
# Auth mechanism offered to the relay. Left empty, Rails sends none; when set,
# the default is `login`.
# @type=enum(plain, login, cram_md5)
SMTP_AUTHENTICATION=
# Domain announced in the SMTP HELO/EHLO. Some relays check it against the
# sender domain.
SMTP_DOMAIN=
# Upgrade the connection with STARTTLS when the relay advertises it (port 587).
# @type=boolean
SMTP_ENABLE_STARTTLS_AUTO=true
# Certificate verification for the SMTP TLS session. `none` accepts any
# certificate; only for an internal relay with a self-signed chain.
# @type=enum(none, peer, client_once, fail_if_no_peer_cert)
SMTP_OPENSSL_VERIFY_MODE=peer
# Implicit TLS from the first byte (port 465), as opposed to STARTTLS. Set
# only one of these, and only if your relay requires it: the initializer skips
# them entirely when they are unset.
# @type=boolean
SMTP_SSL=
# @type=boolean
SMTP_TLS=
# Connection and read timeouts in seconds. Empty uses the Ruby net/smtp
# defaults.
# @type=number
SMTP_OPEN_TIMEOUT=
# @type=number
SMTP_READ_TIMEOUT=

# ─── Incoming email (Action Mailbox) ───────────────────────────────────────
# Conversation continuity: replies to notification emails land back on the
# conversation.
# @docs("Action Mailbox basics", https://edgeguides.rubyonrails.org/action_mailbox_basics.html)

# Domain the reply-to addresses are generated on, e.g. `reply.example.com`.
# Without it, outgoing emails carry no address that can be replied to. Seeded
# once into Super Admin > App Configs (GlobalConfig), and overridable per
# account.
MAILER_INBOUND_EMAIL_DOMAIN=

# Which Action Mailbox ingress accepts inbound mail. `relay` is the generic
# HTTP endpoint used with Postfix/Exim/Qmail; the rest are provider webhooks.
# @type=enum(relay, mailgun, mandrill, postmark, sendgrid, ses)
# @docs("Set up an email channel", https://www.chatwoot.com/docs/product/channels/email/create-channel)
RAILS_INBOUND_EMAIL_SERVICE=relay

# SNS topic ARN Action Mailbox will accept SES notifications from, e.g.
# `arn:aws:sns:us-east-1:123456789012:chatwoot-inbound`. Only read when
# RAILS_INBOUND_EMAIL_SERVICE=ses.
ACTION_MAILBOX_SES_SNS_TOPIC=

# Seconds allowed for processing one IMAP message before the fetch job gives
# up on it. Seeded once into Super Admin > App Configs.
# @type=number
EMAIL_PROCESSING_TIMEOUT_SECONDS=60

# Allows the platform API's email-channel migration endpoint to run. Leave off
# unless you are following a migration runbook.
# @type=boolean
EMAIL_CHANNEL_MIGRATION=false

# ─── Security and access ───────────────────────────────────────────────────

# Active Record Encryption keys, required only for MFA/2FA
# (config/application.rb). All three must be set together; generate them with
# `bundle exec rails db:encryption:init` inside the rails container and never
# reuse another environment's. Losing them makes every encrypted column
# unreadable, so back them up with SECRET_KEY_BASE.
# @sensitive
# @docs("Active Record Encryption", https://guides.rubyonrails.org/active_record_encryption.html)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# @sensitive
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# @sensitive
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Rails' master key for config/credentials.yml.enc. The image ships no
# encrypted credentials file, so this stays empty for a normal deployment.
# @sensitive
RAILS_MASTER_KEY=

# Concurrent sessions kept per user; the oldest is dropped past this count
# (app/controllers/devise_overrides/sessions_controller.rb).
# @type=number
MAX_USER_SESSIONS=25

# Allow browsers on other origins to call the API directly
# (config/initializers/cors.rb). The chat widget does not need it; a
# third-party frontend does.
# @type=boolean
ENABLE_API_CORS=false

# Lets SafeFetch (link previews, webhook targets, avatar fetches) reach private
# and loopback addresses. Off is the SSRF-safe default; turn it on only if you
# genuinely need Chatwoot to call services on your internal network.
# @type=boolean
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false

# Lets the super-admin console seed demo accounts and reports. Off in
# production by default, and it should stay off on a real instance: it writes
# fabricated conversations into the database.
# @type=boolean
ENABLE_ACCOUNT_SEEDING=false

# ─── Rate limiting (Rack::Attack) ──────────────────────────────────────────
# config/initializers/rack_attack.rb. Throttling is active only in
# RAILS_ENV=production. Every ENABLE_* below is a switch and every RATE_LIMIT_*
# is the count for the same rule; a widget switch only applies while
# ENABLE_RACK_ATTACK_WIDGET_API is on.
# @docs("Rack::Attack", https://github.com/rack/rack-attack)

# Master switch, and the global per-IP request budget per minute.
# @type=boolean
ENABLE_RACK_ATTACK=true
# @type=number
RACK_ATTACK_LIMIT=3000

# Comma-separated IPs that bypass every throttle, e.g. `127.0.0.1,::1`. Add
# your own monitoring here rather than raising the global limit.
RACK_ATTACK_ALLOWED_IPS=

# Parent switch for all widget throttles.
# @type=boolean
ENABLE_RACK_ATTACK_WIDGET_API=true

# Widget conversation creates per minute, keyed on (IP, website token).
# @type=boolean
ENABLE_RACK_ATTACK_WIDGET_CONVERSATIONS=true
# @type=number
RATE_LIMIT_WIDGET_CONVERSATIONS=30

# Widget message creates per minute, keyed on (IP, website token).
# @type=boolean
ENABLE_RACK_ATTACK_WIDGET_MESSAGES=true
# @type=number
RATE_LIMIT_WIDGET_MESSAGES=60

# Widget contact updates per hour, per IP.
# @type=boolean
ENABLE_RACK_ATTACK_WIDGET_CONTACTS=true
# @type=number
RATE_LIMIT_WIDGET_CONTACTS=60

# Widget page loads (new sessions) per hour, per IP.
# @type=boolean
ENABLE_RACK_ATTACK_WIDGET_LOAD=true
# @type=number
RATE_LIMIT_WIDGET_LOAD=200

# Widget transcript emails per hour, per IP.
# @type=boolean
ENABLE_RACK_ATTACK_WIDGET_TRANSCRIPT=true
# @type=number
RATE_LIMIT_WIDGET_TRANSCRIPT=5

# Dashboard and API throttles: conversation transcripts per hour, conversation
# deletes per minute, agent creates and deletes per day, contact searches per
# minute, conversation meta calls per minute, and the two report-API budgets
# per minute (per user and per account).
# @type=number
RATE_LIMIT_CONVERSATION_TRANSCRIPT=1000
# @type=number
RATE_LIMIT_CONVERSATION_DELETE=60
# @type=number
RATE_LIMIT_AGENT_CREATE=100
# @type=number
RATE_LIMIT_AGENT_DELETE=50
# @type=number
RATE_LIMIT_CONTACT_SEARCH=100
# @type=number
RATE_LIMIT_CONVERSATIONS_META=30
# @type=number
RATE_LIMIT_REPORTS_API_USER_LEVEL=100
# @type=number
RATE_LIMIT_REPORTS_API_ACCOUNT_LEVEL=1000

# ─── Product limits and behaviour ──────────────────────────────────────────

# Seconds an agent's or a contact's presence key lives in Redis before they
# are shown offline (lib/online_status_tracker.rb). The dashboard heartbeat is
# tuned to these; raising them makes "online" stickier and staler.
# @type=number
PRESENCE_DURATION=20
# @type=number
CONTACT_PRESENCE_DURATION=90

# Conversations per page in the inbox list.
# @type=number
CONVERSATION_RESULTS_PER_PAGE=25

# Messages a single conversation may accept per minute before it is
# rate-limited (lib/limits.rb).
# @type=number
CONVERSATION_MESSAGE_PER_MINUTE_LIMIT=200

# Conversations one auto-assignment job pass will hand out.
# @type=number
AUTO_ASSIGNMENT_BULK_LIMIT=100

# Emits inbox-level webhook events (app/models/inbox.rb). Any non-empty value
# turns it on; it is off by default because it multiplies webhook traffic.
ENABLE_INBOX_EVENTS=

# Enables the housekeeping job that deletes contact-inbox rows with no
# conversation older than 90 days.
# @type=boolean
REMOVE_STALE_CONTACT_INBOX_JOB_STATUS=false

# ─── App Configs seeded from the environment ───────────────────────────────
# Everything in this section goes through GlobalConfigService: the value is
# read from the database first, and an env var is only used ONCE, on the first
# boot that needs it, after which it is written into Super Admin > App Configs.
# Editing these later has no effect; edit them in the admin UI.
# @docs("Integrations configuration", https://www.chatwoot.com/docs/self-hosted/configuration/features/integrations)

# Controls self-service sign-up. `false` (the default here, unlike Chatwoot
# Cloud) closes the sign-up endpoints; `api_only` hides the UI but keeps the
# account API open.
# @type=enum(true, false, api_only)
ENABLE_ACCOUNT_SIGNUP=false

# Facebook / Instagram Messenger channels. FB_VERIFY_TOKEN and IG_VERIFY_TOKEN
# are strings you invent and then paste into the webhook setup on Meta's side.
# @docs("Meta app dashboard", https://developers.facebook.com/apps)
FB_APP_ID=
# @sensitive
FB_APP_SECRET=
# @sensitive
FB_VERIFY_TOKEN=
# @sensitive
IG_VERIFY_TOKEN=

# X / Twitter DM channel. Needs an app with the Account Activity API and a
# dev environment label.
# @docs("X developer portal", https://developer.twitter.com/en/portal/dashboard)
TWITTER_APP_ID=
TWITTER_CONSUMER_KEY=
# @sensitive
TWITTER_CONSUMER_SECRET=
TWITTER_ENVIRONMENT=

# Slack integration (mirror conversations into a Slack channel).
# @docs("Slack apps", https://api.slack.com/apps)
SLACK_CLIENT_ID=
# @sensitive
SLACK_CLIENT_SECRET=

# "Sign in with Google" for agents. The callback URL must be
# <FRONTEND_URL>/omniauth/google_oauth2/callback and registered on the OAuth
# client.
# @docs("Google Cloud credentials", https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
# @sensitive
GOOGLE_OAUTH_CLIENT_SECRET=
# @type=url
GOOGLE_OAUTH_CALLBACK_URL=

# Microsoft / Office 365 email channel OAuth app (Entra ID app registration).
AZURE_APP_ID=
# @sensitive
AZURE_APP_SECRET=

# Base URL for the WhatsApp Cloud API. The default is
# https://graph.facebook.com; override only to pin a Graph API host.
# @type=url
# @docs("WhatsApp Cloud channel", https://www.chatwoot.com/docs/product/channels/whatsapp/whatsapp-cloud)
WHATSAPP_CLOUD_BASE_URL=

# ─── Push notifications ────────────────────────────────────────────────────

# Web Push VAPID keypair. Read once at first use and then stored in the
# database as the VAPID_KEYS app config; if left empty, Chatwoot generates a
# pair itself, which is the sane choice for a self-hosted instance. Supply
# them only to keep an existing keypair across a rebuild.
# @sensitive
# @docs("VAPID key generator", https://d3v.one/vapid-key-generator/)
VAPID_PUBLIC_KEY=
# @sensitive
VAPID_PRIVATE_KEY=

# Relays mobile push notifications through Chatwoot's hosted push server,
# which is how the official iOS/Android apps receive them. Turn it off for an
# air-gapped instance; the official apps then get no notifications.
# @type=boolean
ENABLE_PUSH_RELAY_SERVER=true

# Identifiers served on /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json, so a custom mobile app build can claim your
# domain's deep links. The defaults in .env.example are Chatwoot's own app IDs;
# leave empty unless you ship your own build.
IOS_APP_ID=
ANDROID_BUNDLE_ID=
ANDROID_SHA256_CERT_FINGERPRINT=

# App Store numeric ID; when set, the dashboard renders an Apple smart app
# banner.
IOS_APP_IDENTIFIER=

# ─── Search (OpenSearch / Elasticsearch) ───────────────────────────────────
# Chatwoot gates advanced search on `enterprise? && OPENSEARCH_URL.present?`
# (lib/chatwoot_app.rb). The -ce image has no enterprise directory, so on this
# template these configure the Searchkick client but never enable the feature.
# They are declared because the code still reads them, not because they do
# anything here.
# @docs("OpenSearch documentation", https://opensearch.org/docs/latest/)

# @type=url
OPENSEARCH_URL=
# API key WITHOUT the `ApiKey ` scheme prefix. Either name works;
# OPENSEARCH_API_KEY is checked first.
# @sensitive
OPENSEARCH_API_KEY=
# @sensitive
ELASTICSEARCH_API_KEY=
# SigV4 credentials for AWS-managed OpenSearch, used when no API key is given.
OPENSEARCH_AWS_ACCESS_KEY_ID=
# @sensitive
OPENSEARCH_AWS_SECRET_ACCESS_KEY=
OPENSEARCH_AWS_REGION=us-east-1

# ─── IP geolocation ────────────────────────────────────────────────────────

# MaxMind license key. Present, it schedules a job that downloads the GeoLite2
# City database and turns on IP-based contact location. Empty, contacts simply
# carry no location.
# @sensitive
# @docs("GeoLite2 free geolocation data", https://dev.maxmind.com/geoip/geolite2-free-geolocation-data)
IP_LOOKUP_API_KEY=

# Where that database is downloaded from. The default is
# https://download.maxmind.com/app/geoip_download; override only for an
# internal mirror.
# @type=url
IP_LOOKUP_BASE_URL=

# ─── Billing ───────────────────────────────────────────────────────────────

# Stripe secret key (config/initializers/stripe.rb). Only relevant if you bill
# your own tenants through Chatwoot's billing code; a normal self-hosted
# instance leaves it empty.
# @sensitive
STRIPE_SECRET_KEY=

# ─── Observability ─────────────────────────────────────────────────────────

# Sentry. SENTRY_DSN switches on backend error reporting; SENTRY_FRONTEND_DSN
# overrides the DSN handed to the browser (it falls back to SENTRY_DSN).
# @sensitive
# @docs("What is a DSN", https://docs.sentry.io/product/sentry-basics/dsn-explainer/)
SENTRY_DSN=
# @sensitive
SENTRY_FRONTEND_DSN=
# Any non-empty value samples 10% of requests as performance transactions.
ENABLE_SENTRY_TRANSACTIONS=
# Any non-empty value stops Sentry from attaching user identifiers to events.
# Chatwoot sends default PII unless you set this.
DISABLE_SENTRY_PII=

# New Relic. The license key alone loads and enables the agent; the logging
# flags are off unless set.
# @sensitive
# @docs("New Relic", https://newrelic.com/)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
# @type=boolean
NEW_RELIC_AGENT_ENABLED=
# @type=boolean
NEW_RELIC_APPLICATION_LOGGING_ENABLED=
# @type=boolean
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=
# @type=boolean
NEW_RELIC_APPLICATION_LOGGING_DECORATING_ENABLED=
NEW_RELIC_LOG_LEVEL=

# Scout APM. SCOUT_MONITOR is only consulted when SCOUT_KEY is present.
# @sensitive
# @docs("Scout APM Ruby configuration", https://scoutapm.com/docs/ruby/configuration)
SCOUT_KEY=
SCOUT_NAME=
# @type=boolean
SCOUT_MONITOR=true

# Elastic APM. The secret token is what switches the agent on
# (config/elastic_apm.yml); the server URL is where it reports.
# @docs("Elastic APM Ruby agent", https://www.elastic.co/guide/en/apm/agent/ruby/current/getting-started-rails.html)
# @type=url
ELASTIC_APM_SERVER_URL=
# @sensitive
ELASTIC_APM_SECRET_TOKEN=

# Datadog. Setting the agent URL is what loads the tracer at boot
# (config/application.rb), e.g. http://datadog-agent:8126.
# @type=url
# @docs("Datadog Ruby tracing", https://docs.datadoghq.com/tracing/trace_collection/dd_libraries/ruby/)
DD_TRACE_AGENT_URL=

# Judoscale autoscaling adapter; setting the URL loads the gem.
# @type=url
JUDOSCALE_URL=

# Publish Sidekiq queue depth and latency to AWS CloudWatch from the worker
# process. Credentials default to the instance role; the dedicated keys below
# exist because the shared AWS_* keys are scoped to S3 and lack
# cloudwatch:PutMetricData. The region falls back to AWS_REGION, then
# us-east-1.
# @type=boolean
ENABLE_SIDEKIQ_CLOUDWATCH=false
SIDEKIQ_CLOUDWATCH_NAMESPACE=Chatwoot/Sidekiq
# Publish interval in seconds; values under 60 bill as high-resolution metrics.
# @type=number
SIDEKIQ_CLOUDWATCH_INTERVAL=60
SIDEKIQ_CLOUDWATCH_AWS_ACCESS_KEY_ID=
# @sensitive
SIDEKIQ_CLOUDWATCH_AWS_SECRET_ACCESS_KEY=
SIDEKIQ_CLOUDWATCH_AWS_REGION=

# Commit SHA shown in the super-admin console when the image carries no
# .git_sha file (config/initializers/git_sha.rb). Named after Heroku's slug
# variable; harmless to leave empty.
HEROKU_SLUG_COMMIT=

# Any non-empty value stops the periodic anonymous usage ping to Chatwoot's
# hub (lib/chatwoot_hub.rb), which otherwise reports instance metrics.
DISABLE_TELEMETRY=

# ─── Development-only ──────────────────────────────────────────────────────
# Read only when RAILS_ENV is not production. Listed so the editor does not
# suggest them as production knobs.

# Opens outgoing mail in a browser tab instead of sending it.
LETTER_OPENER=
# Any non-empty value hides the rack-mini-profiler badge.
DISABLE_MINI_PROFILER=
# Set by GitHub Codespaces; switches the dev host allowlist.
CODESPACES=
