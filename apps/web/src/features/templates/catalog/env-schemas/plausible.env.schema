# Plausible Community Edition v3.2.1 (image
# ghcr.io/plausible/community-edition:v3.2.1) environment schema
# (@env-spec / varlock format).
#
# Source: the v3.2.1 source tree of github.com/plausible/analytics (the CE
# image is built from that repo with MIX_ENV=ce). Plausible is Elixir, so the
# whole runtime surface is `config/runtime.exs`: every key below is a
# `get_var_from_path_or_env / get_int_from_path_or_env /
# get_bool_from_path_or_env(config_dir, "KEY", default)` call there, plus the
# two raw `System.get_env` reads (CONFIG_DIR, SITE_DEFAULT_INGEST_THRESHOLD)
# and `rel/overlays/import_extra_config.exs` (EXTRA_CONFIG_PATH). Defaults
# below are the third argument of those calls at v3.2.1, resolved for
# `config_env() == :ce`, which is what the published image runs.
#
# Things the wiki's configuration page does not make obvious:
#
#   * Every lookup is "file first, env second": if a file named after the key
#     exists under CONFIG_DIR (default /run/secrets) its trimmed contents win
#     over the environment variable. That is the docker-secrets support.
#   * An EMPTY string is not the same as unset. `System.get_env/2` only
#     returns the default when the variable is absent, and this compose sets
#     BASE_URL, SECRET_KEY_BASE and TOTP_VAULT_KEY unconditionally, so
#     leaving any of them blank makes the container raise at boot rather
#     than fall back to a default.
#   * DISABLE_REGISTRATION defaults to `invite_only` in CE (not `false` as a
#     plain reading of the code suggests) because `config_env()` is `:ce`.
#   * LOG_LEVEL defaults to `notice` in CE, `warning` elsewhere.
#   * LISTEN_IP's code default is 127.0.0.1, but the image bakes
#     `ENV LISTEN_IP=0.0.0.0`; clearing it makes the app unreachable from
#     outside the container.
#   * ECTO_IPV6 / ECTO_CH_IPV6 and CLICKHOUSE_MAX_BUFFER_SIZE still parse but
#     only log a deprecation warning; they no longer change behaviour.
#   * Cloud-only keys (Paddle, HelpScout, Bunny, SITE_DEFAULT_INGEST_THRESHOLD)
#     are read but inert while SELFHOST is true, which is the CE default.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Plausible CE configuration reference", https://github.com/plausible/community-edition/wiki/configuration)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# Public URL this instance is served on, scheme included. It is not cosmetic:
# it sets the Phoenix endpoint's host/port/path, the default sender address,
# the SMTP HELO hostname, the allowed websocket origin, and whether session
# cookies are marked Secure. Boot raises if it is missing or does not start
# with http/https.
# @required @type=url
# @docs("BASE_URL", https://github.com/plausible/community-edition/wiki/configuration#base_url)
BASE_URL=

# Phoenix's signing/encryption seed. Everything session-shaped derives from
# it: the session cookie, the "remember me" token, password-reset and invite
# tokens, and (when TOTP_VAULT_KEY is unset) the 2FA vault key. Anyone who
# learns this value can forge a session for any user, including an admin, so
# treat it exactly like a private key: generate it with
# `openssl rand -base64 48`, never reuse it across instances, and never
# commit it. Boot raises if it is absent or shorter than 32 bytes. Rotating
# it logs everyone out and invalidates every outstanding invite and reset
# link.
# @required @sensitive @type=string(minLength=32)
# @docs("SECRET_KEY_BASE", https://github.com/plausible/community-edition/wiki/configuration#secret_key_base)
SECRET_KEY_BASE=

# Key that encrypts every user's TOTP secret at rest, so a stolen database
# dump is not a stolen set of 2FA seeds. Must be base64 of exactly 32 bytes
# (`openssl rand -base64 32`); anything else raises at boot. If it were left
# unset the code would derive one from SECRET_KEY_BASE, but this compose
# always passes the variable, so an empty value is a crash, not a fallback.
# Setting it explicitly is also what lets SECRET_KEY_BASE be rotated without
# bricking every enrolled authenticator.
# @required @sensitive
# @docs("TOTP_VAULT_KEY", https://github.com/plausible/community-edition/wiki/configuration#totp_vault_key)
TOTP_VAULT_KEY=

# Address the HTTP listener binds inside the container. The image sets
# 0.0.0.0 (the code's own default is 127.0.0.1, which would only ever answer
# from inside the container). Both IPv4 and IPv6 literals are accepted; an
# unparseable value raises.
LISTEN_IP=0.0.0.0

# Plain-HTTP port. HTTP_PORT is checked first and PORT second, so the
# effective listener is 8000 unless one of them is set. The compose exposes
# container port 8000. Change either of these without changing the exposed
# port and routing breaks.
# @type=port
HTTP_PORT=
# @type=port
PORT=8000

# Setting this turns on Plausible's own TLS listener and its built-in ACME
# client (site_encrypt), which orders a Let's Encrypt certificate for
# BASE_URL's host. It refuses to run for an IP address or a dotless/localhost
# domain, and ACME's http-01 challenge needs HTTP_PORT to be 80. Leave empty
# when a reverse proxy already terminates TLS, which is the normal
# otterdeploy setup.
# @type=port
# @docs("HTTPS_PORT", https://github.com/plausible/community-edition/wiki/configuration#https_port)
HTTPS_PORT=
# ACME directory the built-in certificate client talks to; only read when
# HTTPS_PORT is set. Point it at Let's Encrypt's staging directory while
# testing so you do not burn rate limits.
# @type=url
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# Origin the dashboard's live-update websocket connects to. Empty means "same
# origin as BASE_URL", which is right behind a normal proxy. If set, its host
# must end with BASE_URL's host or boot raises. Cross-domain websocket auth
# is not supported.
WEBSOCKET_URL=

# Marks session cookies Secure. Default follows BASE_URL's scheme (true for
# https, false for http). Forcing it false on an https deployment means the
# session cookie can leak over a downgraded request.
# @type=boolean
SECURE_COOKIE=

# Filename of the tracking script served at /js/<name>.js. Renaming it is the
# usual dodge for content blockers that match on "script.js".
CUSTOM_SCRIPT_NAME=script

# Free-form environment label attached to Sentry events and internal config;
# it does not switch any behaviour on its own.
ENVIRONMENT=prod

# Version string reported to Sentry when the image carries no OCI version
# label. The published images set BUILD_METADATA at build time, so this is
# rarely what actually shows up.
APP_VERSION=0.0.1

# Hostname tag attached to Sentry events and OpenTelemetry resources, for
# telling several instances apart. Purely diagnostic.
APP_HOST=

# JSON blob of OCI image labels/tags, baked into the image by its Dockerfile
# (`ENV BUILD_METADATA`); it is where the version and commit shown in
# diagnostics come from. Unparseable JSON only warns and falls back to empty.
# Not something an operator sets.
BUILD_METADATA=

# ─── Secrets from files ───────────────────────────────────────────────────

# Directory searched BEFORE the environment for every key in this file: if
# `<CONFIG_DIR>/SECRET_KEY_BASE` exists, its trimmed contents win. This is
# how Docker/Swarm secrets are consumed. The path need not exist.
# @docs("Docker secrets support", https://github.com/plausible/community-edition/wiki/configuration#docker-secrets-support)
CONFIG_DIR=/run/secrets

# Path to an extra Elixir config file imported at release boot
# (rel/overlays/import_extra_config.exs). It can set anything the app's config
# tree exposes, so it is effectively arbitrary code with the app's
# privileges. Only point it at a file you control inside the image or a
# mounted volume.
# @docs("EXTRA_CONFIG_PATH", https://github.com/plausible/community-edition/wiki/configuration#extra_config_path)
EXTRA_CONFIG_PATH=

# ─── Registration and access ──────────────────────────────────────────────

# Who may create an account. `invite_only` (the CE default) accepts sign-ups
# only through an emailed invitation; `true` closes registration entirely,
# which is the right setting once your users exist; `false` opens
# registration to ANYONE who can reach BASE_URL: on a public URL that means
# strangers can create accounts and add sites to your instance. Any other
# value raises at boot. This is the single most consequential access knob in
# the file, because Plausible has no separate "public/private" switch.
# @type=enum(true, false, invite_only)
# @docs("DISABLE_REGISTRATION", https://github.com/plausible/community-edition/wiki/configuration#disable_registration)
DISABLE_REGISTRATION=invite_only

# Requires a new account to click an emailed link before it can be used. Off
# by default in CE, and it needs working mail (see the Email section). Turn
# it on together with SMTP, or accounts get stuck unverified.
# @type=boolean
ENABLE_EMAIL_VERIFICATION=false

# Comma-separated numeric user IDs granted super-admin rights (the /crm
# views and cross-account access). Non-numeric entries are silently dropped.
# Grant it to as few database user IDs as possible.
ADMIN_USER_IDS=

# hCaptcha keys for the registration form. Both must be set for the challenge
# to appear; with registration open (`DISABLE_REGISTRATION=false`) this is
# the only thing between you and automated sign-ups.
# @docs("hCaptcha", https://www.hcaptcha.com/)
HCAPTCHA_SITEKEY=
# @sensitive
HCAPTCHA_SECRET=

# Writes a log line for every failed login attempt, so fail2ban and friends
# have something to match on. Off by default.
# @type=boolean
LOG_FAILED_LOGIN_ATTEMPTS=false

# Self-hosted mode. True (the CE default) keeps billing, trial notifications
# and the cloud-only cron queues switched off. Setting it false turns on
# Plausible Cloud behaviour (subscription checks, Paddle, usage limits),
# which on a self-hosted instance mostly means features that lock themselves.
# @type=boolean
SELFHOST=true

# SSO/SAML implementation. `fake` is a stub adapter used for development that
# does NOT verify a real identity provider's assertions; `real` is the actual
# SAML adapter. Never expose an SSO login flow while this is `fake`. Any
# other value crashes at boot.
# @type=enum(fake, real)
SSO_SAML_ADAPTER=fake

# Comma-separated DNS servers (host or host:port) used to verify SSO domain
# ownership. Empty uses the system resolver. Addresses must be IP literals;
# a hostname here raises at boot.
SSO_VERIFICATION_NAMESERVERS=

# Enterprise licence key. CE runs fine without one.
# @sensitive
LICENSE_KEY=

# Signing secret for Nolt single sign-on (the feedback board link in the
# Plausible Cloud UI). Irrelevant to a self-hosted instance.
# @sensitive
NOLT_SSO_SECRET=

# ─── PostgreSQL (bundled `db` service) ────────────────────────────────────

# Connection URL for the app's own database: users, sites, sessions, Oban
# job queue. Platform-owned: otterdeploy resolves the bundled Postgres
# service's hostname and threads POSTGRES_PASSWORD in, so it must stay
# character-for-character what the compose sets. `sslmode` in the query
# string is honoured (`disable`, `require`, `verify-ca`, `verify-full`); TLS
# is off by default because the database is co-located.
# @required @sensitive
# @docs("DATABASE_URL", https://github.com/plausible/community-edition/wiki/configuration#database_url)
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/plausible_db

# Password for the bundled Postgres superuser. It is the same value that
# appears inside DATABASE_URL, so changing one without the other breaks the
# connection. Generate it (`openssl rand -base64 24`) and keep it secret:
# it is direct read/write access to every account and site record.
# @required @sensitive
POSTGRES_PASSWORD=

# Database the bundled Postgres image creates on first start, matching the
# path in DATABASE_URL. Read by the postgres entrypoint, not by Plausible.
# @docs("Postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_DB=plausible_db

# Path inside the container to a PEM CA bundle for the Postgres connection.
# Setting it forces verify_peer, overriding whatever `sslmode` says. Only
# needed when pointing DATABASE_URL at an external, TLS-terminated database.
DATABASE_CACERTFILE=

# Deprecated unix-socket directory; it only prints a warning telling you to
# express the same thing in DATABASE_URL. Leave empty.
DATABASE_SOCKET_DIR=

# Deprecated. Connections now try IPv6 with IPv4 fallback automatically, so
# setting this only logs a warning.
# @type=boolean
ECTO_IPV6=

# ─── ClickHouse (bundled `events-db` service) ─────────────────────────────

# HTTP URL of the ClickHouse database that stores raw events and the
# aggregates behind every dashboard query. Platform-owned: the host is
# resolved from the bundled events-db service, so it must match the compose
# exactly. Plausible opens four pools against this one URL (read, ingest,
# async-insert, import-deletion).
# @required
# @docs("CLICKHOUSE_DATABASE_URL", https://github.com/plausible/community-edition/wiki/configuration#clickhouse_database_url)
CLICKHOUSE_DATABASE_URL=http://${{stack.events-db.HOST}}:8123/plausible_events_db

# Tells the ClickHouse image to skip creating its default user/profile files
# so the server starts with its built-in `default` user and no password,
# acceptable only because events-db is not published outside the stack. Read
# by the ClickHouse entrypoint, not by Plausible.
# @docs("ClickHouse server image", https://hub.docker.com/r/clickhouse/clickhouse-server)
CLICKHOUSE_SKIP_USER_SETUP=1

# PEM CA bundle for the ClickHouse connection; only relevant when pointing
# CLICKHOUSE_DATABASE_URL at an external TLS endpoint.
CLICKHOUSE_CACERTFILE=

# Deprecated; connections already try IPv6 with IPv4 fallback. Setting it
# only logs a warning.
# @type=boolean
ECTO_CH_IPV6=false

# Size of the ingest connection pool. Raise it only if event ingestion is
# actually queueing; each connection costs ClickHouse memory. A non-integer
# value crashes at boot.
# @type=number
CLICKHOUSE_INGEST_POOL_SIZE=5

# How long buffered events sit before being flushed to ClickHouse, in
# milliseconds. Lower means fresher dashboards and more, smaller inserts.
# @type=number
CLICKHOUSE_FLUSH_INTERVAL_MS=5000

# Flush early once the in-memory event buffer reaches this many bytes. Events
# still in the buffer are lost if the container is killed, so this and the
# flush interval together bound how much data a crash can cost.
# @type=number
CLICKHOUSE_MAX_BUFFER_SIZE_BYTES=100000

# Deprecated predecessor of CLICKHOUSE_MAX_BUFFER_SIZE_BYTES. Setting it does
# nothing except log a warning at boot.
CLICKHOUSE_MAX_BUFFER_SIZE=

# ClickHouse storage policy applied to the tables Plausible creates (for
# tiered/volume storage set up in ClickHouse's own config). Empty uses the
# server default.
CLICKHOUSE_DEFAULT_STORAGE_POLICY=

# Rows buffered per batch while importing historical data from Google
# Analytics or a CSV export.
# @type=number
IMPORTED_MAX_BUFFER_SIZE=10000

# ─── Storage paths ────────────────────────────────────────────────────────

# Writable directory for state that must outlive a restart: the MaxMind
# database cache, the tzdata cache, ACME certificates, and (when enabled)
# session-transfer files. The image sets DEFAULT_DATA_DIR=/var/lib/plausible
# and this falls back to it, so leaving it empty is correct unless you mount
# somewhere else. Note this compose does not mount a volume there; set this
# to a mounted path if you enable HTTPS_PORT or MaxMind.
DATA_DIR=

# Baked into the image (/var/lib/plausible) as the last fallback for
# DATA_DIR. Not something an operator normally sets.
DEFAULT_DATA_DIR=/var/lib/plausible

# Alternative name for the same directory: DATA_DIR and PERSISTENT_CACHE_DIR
# fall back to each other, and the first non-empty one wins.
PERSISTENT_CACHE_DIR=

# Writes in-flight session state to <persistent cache>/sessions on shutdown
# so a restart does not split visitors' sessions. Off by default in CE, and
# it does nothing unless a persistent directory is available.
# @type=boolean
ENABLE_SESSION_TRANSFER=false

# Temporary directory for the Erlang VM. Empty uses the system default; the
# upstream compose points it inside the data volume so large CSV
# imports/exports do not fill the container's writable layer.
TMPDIR=

# ─── Email ────────────────────────────────────────────────────────────────

# Which Bamboo adapter delivers mail (invitations, password resets,
# verification links and weekly reports). `Bamboo.Mua` (the default) sends
# directly over SMTP, with MX lookups, from the container itself, which most
# residential and cloud networks block; `Bamboo.LocalAdapter` swallows mail
# entirely. Point it at a real relay or an API adapter for a working
# instance. An unknown value raises at boot.
# @type=enum(Bamboo.Mua, Bamboo.SMTPAdapter, Bamboo.PostmarkAdapter, Bamboo.MailgunAdapter, Bamboo.MandrillAdapter, Bamboo.SendGridAdapter, Bamboo.LocalAdapter, Bamboo.TestAdapter)
# @docs("Email configuration", https://github.com/plausible/community-edition/wiki/configuration#email)
MAILER_ADAPTER=Bamboo.Mua

# From address on every outgoing email. Defaults to plausible@<host of
# BASE_URL>, which most relays will reject unless you own that domain.
# @type=email
MAILER_EMAIL=

# Display name paired with MAILER_EMAIL ("Plausible Analytics <...>"). Empty
# sends the bare address.
MAILER_NAME=

# SMTP relay host. With the default Bamboo.Mua adapter, leaving this empty
# means direct-to-MX delivery; setting it switches to a relay. With
# Bamboo.SMTPAdapter the default is the literal hostname `mail`.
# @docs("SMTP_HOST_ADDR", https://github.com/plausible/community-edition/wiki/configuration#smtp_host_addr)
SMTP_HOST_ADDR=
# Relay port. Default is 587 under Bamboo.Mua and 25 under
# Bamboo.SMTPAdapter. Port 465 implies implicit TLS unless
# SMTP_HOST_SSL_ENABLED says otherwise.
# @type=port
SMTP_HOST_PORT=
# Relay credentials. Under Bamboo.Mua setting only one of the two raises at
# boot; supply both or neither.
SMTP_USER_NAME=
# @sensitive
SMTP_USER_PWD=
# Forces implicit TLS (SMTPS) to the relay. Empty means "infer from the
# port"; false means STARTTLS if the relay offers it.
# @type=boolean
SMTP_HOST_SSL_ENABLED=
# Delivery attempts before giving up (Bamboo.SMTPAdapter only). Defaults to 2.
# @type=number
SMTP_RETRIES=
# Whether Bamboo.Mua performs MX lookups for recipient domains. Turn off when
# sending through a relay that handles routing.
# @type=boolean
SMTP_MX_LOOKUPS_ENABLED=true
# Erlang TLS 1.3 middlebox compatibility mode. Enable it when TLS to the
# relay hangs or resets behind an inspecting firewall.
# @type=boolean
SMTP_MIDDLEBOX_COMP_MODE=false

# API keys for the corresponding MAILER_ADAPTER; each is read only when that
# adapter is selected, and only the matching one needs a value.
# @sensitive
POSTMARK_API_KEY=
# @sensitive
MAILGUN_API_KEY=
# Sending domain registered with Mailgun.
MAILGUN_DOMAIN=
# Mailgun API base, e.g. https://api.eu.mailgun.net/v3 for the EU region.
MAILGUN_BASE_URI=
# @sensitive
MANDRILL_API_KEY=
# @sensitive
SENDGRID_API_KEY=

# ─── Geolocation ──────────────────────────────────────────────────────────

# Path inside the container to the .mmdb file used to turn visitor IPs into
# countries/cities. Defaults to the DB-IP country database shipped in the
# image, so location data works out of the box at country granularity. If
# neither this nor MAXMIND_LICENSE_KEY resolves, boot raises.
# @docs("IP geolocation", https://github.com/plausible/community-edition/wiki/configuration#ip-geolocation)
IP_GEOLOCATION_DB=

# Explicit path to the bundled country database; IP_GEOLOCATION_DB falls back
# to it. Overriding is only useful when swapping in a different DB-IP file.
GEOLITE2_COUNTRY_DB=

# Set a MaxMind licence key to download and auto-update a GeoLite2 database
# instead of using the bundled file, which is what enables city-level
# breakdowns. It requires a writable DATA_DIR to cache into.
# @sensitive
# @docs("MaxMind integration", https://github.com/plausible/community-edition/wiki/Maxmind-Integration)
MAXMIND_LICENSE_KEY=

# Which MaxMind edition to fetch when a licence key is set. GeoLite2-City
# gives city granularity; GeoLite2-Country stops at countries.
MAXMIND_EDITION=GeoLite2-City

# Path to an alternative GeoNames dataset for resolving city/region names.
# Empty uses the dataset bundled with the `location` library.
GEONAMES_SOURCE_FILE=

# ─── Integrations ─────────────────────────────────────────────────────────

# Google OAuth client used for the Search Console keyword integration and for
# importing historical Google Analytics data. Both halves are needed, and the
# OAuth app's redirect URI must point at BASE_URL. Without them those two
# features are simply absent.
# @docs("Google integration", https://github.com/plausible/community-edition/wiki/Google-Integration)
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Browserless endpoint used by the "verify your installation" check, which
# loads the customer's page in a headless browser. The defaults point at a
# service this compose does not run, so the automated verification step just
# fails; tracking itself is unaffected.
# @type=url
BROWSERLESS_ENDPOINT=http://0.0.0.0:3000
# @sensitive
BROWSERLESS_TOKEN=dummy_token

# S3-compatible storage for CSV imports and exports. While true (the
# default), exports are streamed straight to the browser instead. Setting it
# false makes ALL six S3_* keys below mandatory, and boot raises listing the
# missing ones.
# @type=boolean
S3_DISABLED=true
# @sensitive
S3_ACCESS_KEY_ID=
# @sensitive
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Full endpoint URL; its scheme, host and port are parsed apart, e.g.
# https://<account>.r2.cloudflarestorage.com.
# @type=url
S3_ENDPOINT=
S3_EXPORTS_BUCKET=
S3_IMPORTS_BUCKET=

# Open Exchange Rates app ID, used to convert revenue-goal amounts between
# currencies. Rates are refreshed daily; without it revenue metrics stay in
# their original currency.
# @sensitive
OPEN_EXCHANGE_RATES_APP_ID=

# ─── Plausible Cloud only ─────────────────────────────────────────────────
# Read at boot but inert while SELFHOST is true, which is the CE default.
# They exist because CE and Plausible Cloud share one codebase.

# Paddle billing credentials for the hosted product's subscription flows.
PADDLE_VENDOR_ID=
# @sensitive
PADDLE_VENDOR_AUTH_CODE=

# Help Scout support-widget credentials. The signature key authenticates
# Help Scout's callbacks and the vault key encrypts stored conversations.
HELP_SCOUT_APP_ID=
# @sensitive
HELP_SCOUT_APP_SECRET=
# @sensitive
HELP_SCOUT_SIGNATURE_KEY=
# @sensitive
HELP_SCOUT_VAULT_KEY=

# Bunny CDN pull zone purged after the tracker script is updated.
BUNNY_PULLZONE_ID=
# @sensitive
BUNNY_API_KEY=

# Default per-site hourly ingestion cap on the hosted product; only read when
# SELFHOST is false. Empty means no cap.
# @type=number
SITE_DEFAULT_INGEST_THRESHOLD=

# ─── Logging, jobs and observability ──────────────────────────────────────

# Log line shape. `standard` is human-readable text; `json` emits structured
# JSON for a log shipper. Any other value crashes the config step at boot.
# @type=enum(standard, json)
LOG_FORMAT=standard

# Minimum level emitted. Defaults to `notice` in CE. The value must be a
# known Elixir log level or boot raises.
# @type=enum(emergency, alert, critical, error, warning, notice, info, debug)
LOG_LEVEL=notice

# Stops the Oban scheduler: no email reports, no traffic-spike notifications,
# no session cleanup, no salt rotation. Only useful when running a second
# container purely to serve traffic.
# @type=boolean
DISABLE_CRON=false

# PromEx metrics are disabled by default. Setting this false starts the
# Prometheus metrics collection inside the app.
# @type=boolean
PROMEX_DISABLED=true

# Sentry DSN for error reporting. Empty means nothing is sent off-box. The
# DSN is a credential for your Sentry project.
# @sensitive
SENTRY_DSN=
# Finch HTTP timeouts, in milliseconds, for delivering events to Sentry.
# @type=number
SENTRY_FINCH_POOL_TIMEOUT=5000
# @type=number
SENTRY_FINCH_RECEIVE_TIMEOUT=15000

# OpenTelemetry traces are exported to Honeycomb only when BOTH the API key
# and the dataset are set; otherwise tracing is switched off entirely.
# @sensitive
HONEYCOMB_API_KEY=
HONEYCOMB_DATASET=
# Fraction of traces sampled, 0 to 1. A non-numeric value crashes at boot.
# @type=number
OTEL_SAMPLER_RATIO=0.5
