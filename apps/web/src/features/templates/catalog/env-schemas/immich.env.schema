# Immich v3.1.0 environment schema (@env-spec / varlock format).
#
# The compose now pins ghcr.io/immich-app/immich-server:v3.1.0 and
# ghcr.io/immich-app/immich-machine-learning:v3.1.0 (previously v1.128.0,
# nineteen months and two majors behind). v3.1.0 is the newest non-prerelease
# on 2026-09-03, the research date; v3.2.0-rc.2 exists but is a prerelease.
#
# Source: `EnvSchema` in server/src/dtos/env.dto.ts plus a grep of
# `process.env.` across server/src, server/bin/start.sh, and the
# pydantic-settings `Settings`/`NonPrefixedSettings` classes in
# machine-learning/immich_ml/config.py, all at tag v3.1.0. Cross-checked
# against docs.immich.app/install/environment-variables.
#
# Where code and docs disagree, the code wins and is called out inline:
#   * IMMICH_TRUSTED_PROXIES defaults to `linklocal,uniquelocal` in
#     config.repository.ts; the docs page shows an empty default.
#   * MACHINE_LEARNING_MODEL_INTER_OP_THREADS / _INTRA_OP_THREADS are `0`
#     ("let ONNX Runtime decide") in config.py; the docs show 1 and 2, which
#     are the values ort.py substitutes for 0 on a CPU-only provider.
#   * IMMICH_LOG_LEVEL also accepts `fatal` and IMMICH_ENV also accepts
#     `testing` (server/src/enum.ts); neither is on the docs page.
#   * MACHINE_LEARNING_ROCM_PRECISION and MACHINE_LEARNING_TEST_FULL are read
#     by config.py but absent from the docs page.
#   * IMMICH_MACHINE_LEARNING_URL / _ENABLED are read by the code
#     (server/src/config.ts) but were dropped from the docs page, because in
#     v3 they only seed the DEFAULT of a system-config setting (see below).
#
# NOT env any more: most of Immich's behaviour (storage template, thumbnail
# and transcoding settings, job concurrency, OAuth, SMTP, backup schedule,
# the smart-search / facial-recognition / OCR model names, the machine
# learning URL list) lives in system settings in the admin UI and is stored
# in the database. These are not dead keys, they were never env keys; do not
# expect to find e.g. an SMTP_HOST here. Admin > Settings is the place.
#
# Baked into the images and deliberately not declared: IMMICH_BUILD,
# IMMICH_BUILD_URL, IMMICH_BUILD_IMAGE, IMMICH_BUILD_IMAGE_URL,
# IMMICH_REPOSITORY, IMMICH_REPOSITORY_URL, IMMICH_SOURCE_REF,
# IMMICH_SOURCE_COMMIT, IMMICH_SOURCE_URL (server/Dockerfile,
# machine-learning/Dockerfile; build provenance shown on the about screen),
# the IMMICH_THIRD_PARTY_* quartet (for redistributors of a forked image),
# IMMICH_BUILD_DATA, DEVICE (set per hardware-accelerated ML image variant),
# and MACHINE_LEARNING_DEVICE_ID (the gunicorn arbiter assigns it per worker
# from MACHINE_LEARNING_DEVICE_IDS).

# @defaultSensitive=false @defaultRequired=infer
# @docs("Immich environment variables", https://docs.immich.app/install/environment-variables)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Password for the bundled Postgres `immich` role. The compose passes it to
# the server as DB_PASSWORD and to the database container as
# POSTGRES_PASSWORD, so the two can never drift. Postgres is initialised with
# this value on the first boot only: changing it later needs an ALTER ROLE
# inside the database, not just a redeploy.
# @required @sensitive
# @docs("Database environment variables", https://docs.immich.app/install/environment-variables#database)
DB_PASSWORD=

# Where Immich stores originals, thumbnails, encoded video and profile
# images inside the container. Left empty the server probes `/data` then
# `/usr/src/app/upload` (server/src/services/storage.service.ts) and uses
# whichever exists. That is `/data` here, which is the compose's
# `immich-upload` volume. Pointing this at a host path breaks the mount check.
IMMICH_MEDIA_LOCATION=

# Fallback timezone for exiftool when a photo carries no timezone, and the
# clock for log timestamps and cron-scheduled jobs. A TZ identifier such as
# `Etc/UTC` or `Europe/Berlin`; empty means the container's own UTC.
# @docs("List of tz database time zones", https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=

# Runtime environment. `production` is the only supported value for a real
# deployment; `development` and `testing` switch on dev behaviour and a
# staging license key.
# @type=enum(production, development, testing)
IMMICH_ENV=production

# When `false`, the `/auth/admin-sign-up` endpoint is disabled. Immich has no
# admin account until someone claims one through that endpoint on first
# visit, so leave it `true` until you have signed up, then set it `false` to
# stop anyone else claiming the instance.
# @type=boolean
IMMICH_ALLOW_SETUP=true

# Comma-separated IPs or CIDR ranges whose `X-Forwarded-For` header the
# server will believe when deciding a request's client address (used for
# rate limiting and audit). Defaults to `linklocal,uniquelocal`, the private
# ranges, which already covers a reverse proxy on the same Docker network.
# @docs("Reverse Proxy", https://docs.immich.app/administration/reverse-proxy)
IMMICH_TRUSTED_PROXIES=

# Path to a JSON file of system settings inside the container. Setting it
# makes the whole admin settings screen read-only: the file becomes the
# source of truth and nothing can be changed from the UI. Leave empty to
# keep settings editable and stored in the database.
# @docs("System Settings", https://docs.immich.app/administration/system-settings)
IMMICH_CONFIG_FILE=

# Path to a JSON file of helmet options, or the literal `true` to use the
# image's own `server/helmet.json`. The default (`false`) is deliberate: the
# stock helmet policy sets `upgrade-insecure-requests`, which breaks any
# HTTP-only deployment.
# @docs("Helmet default configuration", https://helmetjs.github.io/)
IMMICH_HELMET_FILE=false

# When `true`, the server keeps starting even if the media mount check finds
# the upload volume missing or unwritable. That check is what stops Immich
# from writing a fresh empty library over a volume that failed to mount, so
# only set this when the check is a false positive.
# @type=boolean
# @docs("System Integrity", https://docs.immich.app/administration/system-integrity)
IMMICH_IGNORE_MOUNT_CHECK_ERRORS=

# When `true`, thumbnails are generated for images libvips rejects as
# invalid instead of skipping them. Slower, and some results will be
# garbage; useful for salvaging a damaged import.
# @type=boolean
IMMICH_PROCESS_INVALID_IMAGES=

# Overrides the CPU core count `server/bin/start.sh` auto-detects. It is used
# for one thing: sizing libuv's thread pool (UV_THREADPOOL_SIZE) when the
# count exceeds 4. Set it if the container's cgroup quota is smaller than
# the host's core count.
# @type=number
CPU_CORES=

# ─── Listen address ──────────────────────────────────────────────────────

# Address the server binds inside the container. Empty binds all interfaces,
# which is what the compose's published port 2283 needs.
IMMICH_HOST=

# Port the server listens on. The compose exposes container port 2283 with no
# override, so this is that port's twin: change one without the other and
# routing breaks. The machine learning container reads the same variable and
# defaults to 3003 there instead.
# @type=port
IMMICH_PORT=2283

# ─── Database ────────────────────────────────────────────────────────────

# PLATFORM-OWNED: the sibling Postgres service's hostname, never typed.
# @required
# @docs("Database environment variables", https://docs.immich.app/install/environment-variables#database)
DB_HOSTNAME=${{stack.database.HOST}}

# Postgres role Immich connects as. Fixed by the compose, which passes the
# same value to the database container as POSTGRES_USER.
# @required
DB_USERNAME=immich

# Database name. Fixed by the compose, which passes the same value to the
# database container as POSTGRES_DB.
# @required
DB_DATABASE_NAME=immich

# Postgres port. Empty means 5432, which is what the bundled image listens
# on.
# @type=port
DB_PORT=

# Full connection string, as an alternative to the five DB_* parts above.
# When set it wins and DB_HOSTNAME / DB_PORT / DB_USERNAME / DB_PASSWORD /
# DB_DATABASE_NAME are all ignored. Only fill this in when pointing Immich
# at an external Postgres instead of the bundled one. Format:
# postgresql://user:password@host:5432/immich (append `?sslmode=require` for
# TLS; `pg_dumpall`, which the backup job shells out to, parses the same
# string).
# @sensitive @type=url
# @docs("Standalone Postgres", https://docs.immich.app/administration/postgres-standalone)
DB_URL=

# TLS mode for the database connection. Empty lets node-postgres decide,
# which is plaintext on a private Docker network. Only meaningful with an
# external database.
# @type=enum(disable, allow, prefer, require, verify-full)
DB_SSL_MODE=

# Which vector extension backs smart search and facial recognition. Empty
# auto-detects by inspecting the database, preferring VectorChord over
# pgvector. v3 dropped pgvecto.rs entirely, so `vectors` is no longer an
# accepted value; the bundled image ships VectorChord 0.4.3, inside the
# `>=0.3 <2` range server/src/constants.ts enforces at boot.
# @type=enum(vectorchord, pgvector)
# @docs("Migrating to VectorChord", https://docs.immich.app/install/upgrading)
DB_VECTOR_EXTENSION=

# When `true`, the server does not run schema migrations on startup. Only for
# an operator who applies migrations out of band; a version bump with this
# set leaves the schema behind the code and the server will fail on the first
# query that needs a new column.
# @type=boolean
DB_SKIP_MIGRATIONS=false

# ─── Bundled Postgres container ──────────────────────────────────────────
# Fixed by the compose, not operator-editable. Declared because every key the
# compose sets on the bundled database service belongs in this schema.

# Role created on first initialisation. Mirrors DB_USERNAME.
# @required
# @docs("Docker Compose install", https://docs.immich.app/install/docker-compose)
POSTGRES_USER=immich

# Set by the compose from DB_PASSWORD, so the server and the database can
# never disagree. Fill in DB_PASSWORD, not this.
# @required @sensitive
POSTGRES_PASSWORD=${DB_PASSWORD}

# Database created on first initialisation. Mirrors DB_DATABASE_NAME.
# @required
POSTGRES_DB=immich

# Passed to `initdb` the one time the data directory is created. Data
# checksums let Postgres detect silent corruption of the photo index; they
# cannot be turned on later without re-initialising the cluster.
POSTGRES_INITDB_ARGS=--data-checksums

# Read by the immich-app/postgres image's entrypoint, not by Immich itself:
# `HDD` swaps in postgresql.hdd.conf, which lowers effective_io_concurrency
# for spinning disks. Empty keeps the SSD profile.
# @type=enum(SSD, HDD)
# @docs("immich-app/base-images", https://github.com/immich-app/base-images)
DB_STORAGE_TYPE=

# ─── Redis (Valkey) ──────────────────────────────────────────────────────

# PLATFORM-OWNED: the sibling Valkey service's hostname, never typed. Immich
# uses it as the BullMQ broker for every background job (thumbnails,
# metadata extraction, smart search, facial recognition).
# @required
# @docs("Redis environment variables", https://docs.immich.app/install/environment-variables#redis)
REDIS_HOSTNAME=${{stack.redis.HOST}}

# Redis port. Empty means 6379, which is what the bundled Valkey listens on.
# @type=port
REDIS_PORT=

# Credentials for the queue. The bundled Valkey runs unauthenticated on the
# private stack network, so both stay empty; fill them in only when pointing
# at an external Redis.
REDIS_USERNAME=
# @sensitive
REDIS_PASSWORD=

# Numeric Redis database index. Empty means 0. Change it only when sharing
# one Redis between several apps.
# @type=number
REDIS_DBINDEX=

# Unix socket path to Redis. When set, REDIS_HOSTNAME / REDIS_PORT /
# REDIS_USERNAME / REDIS_PASSWORD / REDIS_DBINDEX are all ignored. Not usable
# across containers.
REDIS_SOCKET=

# Full ioredis configuration, for Sentinel or cluster setups: the literal
# prefix `ioredis://` followed by a base64-encoded JSON ioredis options
# object. When set it wins over every other REDIS_* variable.
# @sensitive
# @docs("ioredis connection options", https://ioredis.readthedocs.io/en/latest/README/)
REDIS_URL=

# ─── Machine learning (server side) ──────────────────────────────────────

# PLATFORM-OWNED: the sibling machine-learning service, never typed. Careful
# with this one. In v3 it only seeds the DEFAULT of the `machineLearning.urls`
# system setting (server/src/config.ts). Once an admin saves the Machine
# Learning section in Admin > Settings the database value takes over and
# editing this variable stops having any effect.
# @required @type=url
# @docs("System Settings", https://docs.immich.app/administration/system-settings)
IMMICH_MACHINE_LEARNING_URL=http://${{stack.immich-machine-learning.HOST}}:3003

# Set to the string `false` to seed machine learning off, disabling smart
# search, facial recognition and OCR. Same caveat as the URL above: it is a
# default for a system setting, not a live switch, and the admin UI toggle
# wins once saved.
# @type=boolean
IMMICH_MACHINE_LEARNING_ENABLED=true

# ─── Machine learning container ──────────────────────────────────────────
# Read by the Python service (machine-learning/immich_ml/config.py) with the
# MACHINE_LEARNING_ prefix and `__` as the nesting separator. Everything
# about WHICH models run is a system setting in the admin UI; these control
# how the container executes them.

# Directory the downloaded ONNX models are cached in. The image sets it to
# /cache, which is the compose's `immich-model-cache` volume; empty here
# means that image default stands. Point it elsewhere and every model is
# re-downloaded on the next container recreate.
# @docs("Machine learning environment variables", https://docs.immich.app/install/environment-variables#machine-learning)
MACHINE_LEARNING_CACHE_FOLDER=

# Seconds a model stays resident after its last use before being unloaded to
# reclaim RAM. `0` or less keeps every model loaded forever.
# @type=number
MACHINE_LEARNING_MODEL_TTL=300

# Seconds between checks of the TTL above. `0` or less disables the sweeper.
# @type=number
MACHINE_LEARNING_MODEL_TTL_POLL_S=10

# Gunicorn worker processes. Each one holds its own copy of every loaded
# model in memory, so raising this multiplies RAM use. Required to be >1 for
# multi-GPU.
# @type=number
MACHINE_LEARNING_WORKERS=1

# Seconds a worker may be unresponsive before it is killed and respawned.
# The ROCm image variant raises the built-in default to 900.
# @type=number
MACHINE_LEARNING_WORKER_TIMEOUT=300

# HTTP keep-alive timeout in seconds. Raise it behind a load balancer that
# reuses connections aggressively.
# @type=number
MACHINE_LEARNING_HTTP_KEEPALIVE_TIMEOUT_S=2

# Size of the thread pool that serves inference requests. Empty means the
# container's CPU core count. Tune this first when the ML service is the
# bottleneck; `0` or less disables the pool.
# @type=number
MACHINE_LEARNING_REQUEST_THREADS=

# ONNX Runtime threading. `0` means "let the runtime decide", which on a
# CPU-only provider resolves to 1 inter-op thread and one intra-op thread per
# core (machine-learning/immich_ml/sessions/ort.py). The docs page shows
# those resolved values as if they were the defaults; the settings really
# default to 0.
# @type=number
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=0
# @type=number
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=0

# Pre-allocates a CPU memory arena so repeated inference does not fragment
# the heap. Turning it off lowers idle RSS at the cost of throughput.
# @type=boolean
MACHINE_LEARNING_MODEL_ARENA=true

# Models to load at startup instead of on the first request, so the first
# search or backup does not stall. Comma-separated model names, matching the
# ones selected in Admin > Settings > Machine Learning. Only the CLIP textual
# model is needed for search; preload the rest only if you have the RAM.
MACHINE_LEARNING_PRELOAD__CLIP__TEXTUAL=
MACHINE_LEARNING_PRELOAD__CLIP__VISUAL=
MACHINE_LEARNING_PRELOAD__FACIAL_RECOGNITION__RECOGNITION=
MACHINE_LEARNING_PRELOAD__FACIAL_RECOGNITION__DETECTION=
MACHINE_LEARNING_PRELOAD__OCR__RECOGNITION=
MACHINE_LEARNING_PRELOAD__OCR__DETECTION=

# Caps how many faces are fed to the recognition model in one pass. Empty
# means unbounded (the OpenVINO variant forces 1).
# @type=number
MACHINE_LEARNING_MAX_BATCH_SIZE__FACIAL_RECOGNITION=
# Caps how many detected text boxes the OCR model recognises in one pass.
# @type=number
MACHINE_LEARNING_MAX_BATCH_SIZE__OCR=6

# ─── Machine learning hardware acceleration ──────────────────────────────
# Only meaningful on the hardware-accelerated ML image variants
# (-cuda, -rocm, -openvino, -armnn, -rknn). This template runs the plain CPU
# image, where these are inert.

# Device indices to spread MACHINE_LEARNING_WORKERS across, comma-separated,
# assigned round-robin. Needs MACHINE_LEARNING_WORKERS greater than 1 to do
# anything.
# @docs("ML Hardware Acceleration", https://docs.immich.app/features/ml-hardware-acceleration)
MACHINE_LEARNING_DEVICE_IDS=0

# ARM NN acceleration (Mali GPUs), if the runtime is present.
# @type=boolean
MACHINE_LEARNING_ANN=true
# Runs ARM NN operations at half precision: faster, less accurate.
# @type=boolean
MACHINE_LEARNING_ANN_FP16_TURBO=false
# ARM NN GPU tuning effort: 1 rapid, 2 normal, 3 exhaustive.
# @type=number
MACHINE_LEARNING_ANN_TUNING_LEVEL=2

# RKNN acceleration (Rockchip NPUs), if the runtime is present.
# @type=boolean
MACHINE_LEARNING_RKNN=true
# RKNN runtime threads spun up per inference.
# @type=number
MACHINE_LEARNING_RKNN_THREADS=1

# Floating-point precision for the OpenVINO provider. FP16 is faster with
# some accuracy loss.
# @type=enum(FP32, FP16)
MACHINE_LEARNING_OPENVINO_PRECISION=FP32

# Same knob for the ROCm provider (config.py `rocm_precision`, wired into
# migraphx_fp16_enable). Read by the code but missing from the docs page.
# @type=enum(FP32, FP16)
MACHINE_LEARNING_ROCM_PRECISION=FP32

# Upstream's own end-to-end model test switch. Not something a deployment
# should set; it makes the service pull and exercise every model.
# @type=boolean
MACHINE_LEARNING_TEST_FULL=false

# ─── Workers ─────────────────────────────────────────────────────────────

# Which of the server's workers this container runs, comma-separated from
# `api`, `microservices`, `maintenance`. Empty runs `api,microservices`, the
# single-container shape this template uses. Splitting them across two
# containers is only worth it at scale, and both halves still need every
# DB_* and REDIS_* variable above.
# @docs("Jobs and Workers", https://docs.immich.app/administration/jobs-workers)
IMMICH_WORKERS_INCLUDE=

# Subtracted from the included set. `maintenance` is the worker behind
# maintenance mode; excluding `microservices` leaves the API up while no
# background jobs run.
IMMICH_WORKERS_EXCLUDE=

# ─── Logging & telemetry ─────────────────────────────────────────────────

# Verbosity of both the server and the machine learning container (the
# Python service reads the same variable). Empty means `log`. `fatal` is
# accepted by server/src/enum.ts but absent from the docs page.
# @type=enum(verbose, debug, log, warn, error, fatal)
IMMICH_LOG_LEVEL=log

# `json` switches the server's log lines to structured JSON for a log
# shipper; `console` keeps the human-readable form.
# @type=enum(console, json)
IMMICH_LOG_FORMAT=console

# `true` strips ANSI colour from log output. Read by both the server and the
# machine learning container.
# @type=boolean
NO_COLOR=false

# Turns on the Prometheus metrics endpoints, which are off entirely by
# default. `all`, or a comma-separated subset of `host`, `api`, `io`,
# `repo`, `job`. An unrecognised name makes the server refuse to boot.
# @docs("Monitoring", https://docs.immich.app/features/monitoring)
IMMICH_TELEMETRY_INCLUDE=

# Subtracted from the included set, same vocabulary.
IMMICH_TELEMETRY_EXCLUDE=

# Ports the OTEL/Prometheus metrics are served on, one per worker. Only
# listening when IMMICH_TELEMETRY_INCLUDE is set; the compose publishes
# neither, so scraping needs another exposed port.
# @type=port
IMMICH_API_METRICS_PORT=8081
# @type=port
IMMICH_MICROSERVICES_METRICS_PORT=8082

# ─── Plugins ─────────────────────────────────────────────────────────────

# When `true`, the server will install plugins from outside its own curated
# list. Third-party plugin code runs with the server's privileges, which is
# why this is off by default.
# @type=boolean
IMMICH_ALLOW_EXTERNAL_PLUGINS=false

# Absolute path inside the container where plugins are installed. Must be an
# absolute path or the server refuses to start. The compose mounts no volume
# there, so anything installed is lost on recreate unless you add one.
IMMICH_PLUGINS_INSTALL_FOLDER=

# ─── Docker secrets ──────────────────────────────────────────────────────
# `server/bin/start.sh` reads the file each of these points at and exports
# its contents under the name without the `_FILE` suffix, before Node starts.
# Setting both a variable and its `_FILE` twin is not an error; the twin is
# ignored when the plain variable is already set. Only these six have a file
# form.

# Directory of secret files named after the plain variables, e.g.
# `/run/secrets` for Docker secrets. Checked as a fallback for every `_FILE`
# variable below that is left empty.
# @docs("Secrets", https://docs.immich.app/install/environment-variables#secrets)
CREDENTIALS_DIRECTORY=

DB_URL_FILE=
DB_HOSTNAME_FILE=
DB_DATABASE_NAME_FILE=
DB_USERNAME_FILE=
DB_PASSWORD_FILE=
REDIS_PASSWORD_FILE=
