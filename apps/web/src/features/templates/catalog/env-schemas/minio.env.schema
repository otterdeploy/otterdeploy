# MinIO RELEASE.2025-09-07T16-13-09Z — environment schema (@env-spec / varlock format).
#
# The compose pins `minio/minio:latest`; that tag resolves today (2026-08-29,
# checked against Docker Hub) to RELEASE.2025-09-07T16-13-09Z, MinIO's last
# publicly-tagged release before it stopped publishing new AGPL community
# release tags to Docker Hub — "latest" has not moved since.
#
# Source: grep of `"MINIO_` across internal/config/**/*.go and env.Get(...) /
# env.IsSet(...) call sites in cmd/common-main.go and cmd/server-main.go at
# that tag. MinIO's real env surface is 300+ names (per-KMS provider, per
# notification target, replication, ILM, etc.) — internal/config/constants.go
# alone lists 30-plus "Top level common ENVs". Only the ones relevant to a
# single-node, single-drive deploy behind a reverse proxy (this template's
# shape) are declared here, grouped; the rest are cluster/notification/KMS
# surface this template does not wire up. All are optional except the root
# credentials, which the compose sets and MinIO refuses to boot without.

# @defaultSensitive=false @defaultRequired=infer
# @docs("MinIO server reference", https://min.io/docs/minio/container/reference/minio-server/minio-server.html)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The root (superuser) access key. Must be at least 3 characters. MinIO
# refuses to start if this or MINIO_ROOT_PASSWORD is unset while the other
# is set; if both are unset it falls back to insecure dev defaults
# (minioadmin/minioadmin), which is why this is required here.
# @required @type=string(minLength=3)
MINIO_ROOT_USER=

# The root (superuser) secret key. Must be at least 8 characters.
# @required @sensitive @type=string(minLength=8)
MINIO_ROOT_PASSWORD=

# ─── Console / browser ───────────────────────────────────────────────────

# Enables the web console (the service the compose exposes on :9001 as
# --console-address). "off" leaves only the S3 API on :9000.
# @type=enum(on, off)
MINIO_BROWSER=on

# The externally-reachable URL of the console, e.g. the platform's generated
# domain. Only needed if the console misdetects its own origin (mixed
# HTTP/HTTPS behind a proxy); most single-domain deploys don't need it.
# @docs("MinIO browser configuration", https://min.io/docs/minio/container/administration/console/index.html)
# @type=url
MINIO_BROWSER_REDIRECT_URL=

# The externally-reachable URL of the S3 API itself (not the console).
# Presigned URLs and any client that asks MinIO for its own address use
# this instead of the in-container address.
# @type=url
MINIO_SERVER_URL=

# Comma-separated bucket-domain suffixes for virtual-hosted-style requests
# (bucket.example.com instead of example.com/bucket). Empty = path-style
# only, which is what most S3 SDKs default to and what this template's
# single generated domain supports without extra DNS.
MINIO_DOMAIN=

# ─── API ─────────────────────────────────────────────────────────────────

# Origin(s) allowed to call the S3 API from a browser (fetch/XHR), e.g. a
# web app doing direct-to-bucket uploads. Default * allows any origin.
MINIO_API_CORS_ALLOW_ORIGIN=*

# Hard cap on simultaneous S3 API requests before MinIO replies 503; 0 is
# uncapped, sized automatically from available memory.
# @type=number
MINIO_API_REQUESTS_MAX=0

# ─── Storage behavior ────────────────────────────────────────────────────

# Enables on-the-fly compression for the extensions/mime-types below.
# @type=enum(on, off)
MINIO_COMPRESSION_ENABLE=off

# Comma-separated file extensions compressed when compression is on.
MINIO_COMPRESSION_EXTENSIONS=.txt,.log,.csv,.json,.tar,.xml,.bin

# Comma-separated MIME types compressed when compression is on.
MINIO_COMPRESSION_MIME_TYPES=text/*,application/json,application/xml,binary/octet-stream

# Free-space floor on the drive backing /data, e.g. "5%" or "5GB"; MinIO
# marks the drive unhealthy for new writes below it. Empty = compiled-in
# default (a percentage of total drive size).
MINIO_ROOTDRIVE_THRESHOLD_SIZE=

# ─── Misc ────────────────────────────────────────────────────────────────

# "off" disables MinIO's built-in update-availability check. Irrelevant to
# how the platform updates the image, but stops an outbound call the
# container otherwise makes on startup.
# @type=enum(on, off)
MINIO_UPDATE=on
