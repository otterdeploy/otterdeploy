# ToolJet 3.20.218-lts (EE) environment schema (@env-spec / varlock format).
#
# The compose pins tooljet/tooljet:v3.20.218-lts. `tooljet/tooljet` is the
# ENTERPRISE build; the community build is a separate repo,
# `tooljet/tooljet-ce`. Both publish the same `vX.Y.Z-lts` stream, and the EE
# image runs unlicensed on the free tier, so nothing here needs a licence.
# The `ee-lts-latest` tag this pin was taken from moves almost daily (it was
# v3.20.222-lts, pushed 2026-09-03, on the 2026-09-04 research date); 218 is
# the matured sibling and no open advisory reaches past 3.20.180.
#
# Source: grep of `process.env.*` and `configService.get('*')` across
# server/src, server/ee, server/scripts and server/ormconfig.ts at
# v3.20.218-lts, plus the EE entrypoint (docker/LTS/ee/ee-entrypoint.sh) and
# the boot-time Joi gate in server/scripts/database-config-utils.ts.
#
# Where the docs and .env.example drift from the code at this tag:
#   * `SMTP_HOST` does not exist. The SMTP server hostname is `SMTP_DOMAIN`
#     (server/src/modules/smtp/dto.ts reads SMTP_DOMAIN as `host`).
#   * the env-vars page lists `REDIS_USER`; the code only reads
#     `REDIS_USERNAME` (server/src/modules/app/loader.ts).
#   * `CHECK_FOR_UPDATES`, `TOOLJET_DB_RECONFIG`, `ENABLE_MARKETPLACE_FEATURE`
#     and `TOOLJET_WORKFLOW_SANDBOX_BYPASS` appear in .env.example / the
#     official .env.internal.example but are read nowhere in this tree, so
#     they are not declared below.
#   * `GOOGLE_CLIENT_ID` / `GOOGLE_CLIENT_SECRET` in .env.example are dead;
#     Google SSO reads the `SSO_GOOGLE_OAUTH2_*` names.
#
# The ToolJet Database is served by PostgREST. The EE image bakes PostgREST
# v12.2.0 in and the entrypoint will start it in-container when PGRST_HOST
# begins with `localhost:`, but unsupervised; this stack runs it as its own
# `postgrest` service on the same version instead.
#
# ToolJet has no object-storage configuration of its own: app definitions,
# uploads and (encrypted) datasource credentials all live in Postgres. S3 /
# GCS / Azure appear only as datasources the operator connects from the UI.

# @defaultSensitive=false @defaultRequired=infer
# @docs("ToolJet environment variables", https://docs.tooljet.ai/docs/setup/env-vars/)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The instance's own public URL, scheme included. Far more than cosmetic at
# this version: it is the allow-list for the CSRF Origin check that guards
# every mutation (server/src/helpers/bootstrap.helper.ts), the CORS origin,
# the base for every emailed invite/reset link, and the redirect base for SSO.
# Wrong or missing and login silently fails with rejected mutations. Must
# start with http:// or https:// and carry no trailing slash.
# @required
# @type=url
# @docs("Changing the ToolJet domain", https://docs.tooljet.ai/docs/setup/tooljet-domain-change/)
TOOLJET_HOST=

# Port the NestJS server binds. The compose exposes container port 80 and
# sets this to match; leave them in step. Unset, the server listens on 3000
# (server/src/main.ts) and the exposed port answers nothing.
# @type=port
PORT=80

# Whether the same process also serves the built React client. "false" turns
# the container into an API-only backend, which needs a separately hosted
# frontend, which is not what this single-service template deploys.
# @type=boolean
SERVE_CLIENT=true

# Address the server binds inside the container. Default `::` (dual-stack
# wildcard) is what the container network needs; narrowing it will make the
# published port unreachable.
LISTEN_ADDR=

# Serve ToolJet under a path prefix instead of the domain root, e.g. `/apps/`.
# Must start AND end with a slash or boot throws
# (server/src/helpers/utils.helper.ts). Empty means root.
# @docs("Deploying ToolJet on a subpath", https://docs.tooljet.ai/docs/setup/tooljet-subpath/)
SUB_PATH=

# Set only when the client is served from a different origin than the API;
# it is baked into the client bundle as the API base. Empty is correct for
# this template, where one container serves both.
TOOLJET_SERVER_URL=

# Reported with telemetry so ToolJet knows how the instance was installed.
# Purely informational; it changes no behaviour.
DEPLOYMENT_PLATFORM=docker

# DANGER: "true" does not merely widen CORS, it short-circuits the
# same-origin check on state-changing requests entirely
# (bootstrap.helper.ts: `if (ENABLE_CORS === 'true') return;`). Only set it
# when you genuinely serve the frontend from another origin, and understand
# you are trading away the CSRF guard.
# @type=boolean
ENABLE_CORS=

# Extra origins appended to the Content-Security-Policy, comma separated.
# Needed when apps embed assets, fonts or iframes from a third-party CDN.
# @docs("Whitelist CDN domains", https://docs.tooljet.ai/docs/tj-setup/whitelist-cdn-domains/)
CSP_WHITELISTED_DOMAINS=

# Route all outbound HTTP from ToolJet (datasource calls, marketplace plugin
# downloads, licence checks) through a forward proxy.
# @docs("Connecting via HTTP proxy", https://docs.tooljet.ai/docs/setup/http-proxy/)
TOOLJET_HTTP_PROXY=

# Application log verbosity (pino). Unset falls back to ORM_LOGGING, which in
# production means warn: errors and slow queries only, no request log. Set
# `info` if you want per-request access logs in `docker logs`.
# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=

# ─── Secrets ─────────────────────────────────────────────────────────────

# The crown jewel. This key encrypts and decrypts EVERY stored datasource
# credential (the Postgres/MySQL/Mongo passwords, REST API keys, OAuth
# tokens and AI provider keys your users connect) plus environment
# constants, SSO client secrets and instance settings
# (server/src/modules/encryption/service.ts; the entity list is in
# server/scripts/rotate-lockbox-key.ts). Exactly 64 hex characters,
# `openssl rand -hex 32`. Lose it and every one of those secrets is
# unrecoverable ciphertext; there is no escrow and no reset. Change it in
# place and the existing rows are orphaned: ToolJet will not decrypt them and
# every datasource fails until each credential is re-entered by hand. Rotate
# only with the supported script, never by editing this value.
# @required
# @sensitive
# @type=string(matches=/^[0-9a-fA-F]{64}$/)
# @docs("Lockbox master key rotation", https://docs.tooljet.ai/docs/tj-setup/lockbox-master-key-rotation/)
LOCKBOX_MASTER_KEY=

# Signs session cookies and every JWT the app issues
# (server/src/modules/auth/module.ts, session/jwt/jwt.strategy.ts).
# `openssl rand -hex 64`. Leaking it lets anyone mint a valid session for any
# user; changing it invalidates all live sessions, which is the safe response
# to a leak. Unset, the app boots but token verification is unsound.
# @required
# @sensitive
SECRET_KEY_BASE=

# Root secret from which each user's TOTP seed is derived, for enterprise
# two-factor auth. Enabling 2FA without it throws
# (server/src/modules/auth/mfa/totp-util.service.ts). Replacing it breaks
# every enrolled authenticator app at once.
# @sensitive
# @docs("Two-factor authentication", https://docs.tooljet.ai/docs/user-management/authentication/2fa/)
MFA_MASTER_SECRET=

# ─── Application database ────────────────────────────────────────────────

# Host of the Postgres that holds app definitions, users and the encrypted
# credential rows. Points at the bundled `db` service; the entrypoint blocks
# on it for up to 300s before migrating.
# @required
# @docs("Database configuration", https://docs.tooljet.ai/docs/setup/env-vars/)
PG_HOST=${{stack.db.HOST}}

# @type=port
PG_PORT=5432

# Database name. Must NOT equal TOOLJET_DB below, since create-database.ts
# refuses to boot if the two match.
PG_DB=tooljet

# Role ToolJet connects as. Same role the bundled Postgres creates as its
# superuser, which matters because ToolJet runs `createdb` on first boot.
PG_USER=tooljet

# Password for that role, threaded from the prompted POSTGRES_PASSWORD.
# @required
# @sensitive
PG_PASS=${POSTGRES_PASSWORD}

# ToolJet creates PG_DB, TOOLJET_DB and the sample database at boot, which
# needs CREATEDB on the role above. Set "false" against a managed Postgres
# where you cannot grant that, and create the databases and extensions
# yourself first.
# @type=boolean
PG_DB_OWNER=

# Alternative to the five PG_* keys above: one connection string, parsed into
# them (server/scripts/database-config-utils.ts). Setting it forces
# `ssl: { rejectUnauthorized: false }`, so append `?sslmode=disable` for a
# plaintext link. Leave empty here. The compose supplies the discrete keys.
# @sensitive
DATABASE_URL=

# PEM of a CA to trust for the Postgres TLS handshake, for managed databases
# with a private root. Read straight out of the environment by ormconfig.ts.
CA_CERT=

# ─── Bundled Postgres ────────────────────────────────────────────────────

# Superuser the `db` container creates on first boot; ToolJet connects as it
# (PG_USER above) and needs its CREATEDB right.
POSTGRES_USER=tooljet

# The one database password in this stack. Only reachable on the stack's
# private network, but it is a full read/write path to every app definition
# and every encrypted credential row, so generate it, do not choose it.
# Generate it as HEX (`openssl rand -hex 24`), not base64: it is interpolated
# into PGRST_DB_URI's userinfo, where a `/` from the base64 alphabet ends the
# userinfo early and libpq reads the rest of the password as the hostname.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot; the twin of PG_DB.
POSTGRES_DB=tooljet

# ─── ToolJet Database ────────────────────────────────────────────────────

# Name of the second database backing the built-in table editor ("ToolJet
# Database"), created automatically at boot. Must differ from PG_DB.
# @docs("ToolJet Database", https://docs.tooljet.ai/docs/tooljet-db/tooljet-database/)
TOOLJET_DB=tooljet_db

# Host for that second database, the same bundled Postgres here.
TOOLJET_DB_HOST=${{stack.db.HOST}}

# @type=port
TOOLJET_DB_PORT=5432

# Role used to create and own tooljet_db. Not optional: the boot-time Joi
# gate in server/scripts/database-config-utils.ts marks TOOLJET_DB_USER
# `required` with no fallback to PG_USER, so leaving it unset makes
# `db:create:prod` throw and the container exit before the app starts.
# @required
TOOLJET_DB_USER=tooljet

# @required
# @sensitive
TOOLJET_DB_PASS=${POSTGRES_PASSWORD}

# Statement timeout in ms for queries the table editor runs. Default 60000.
# @type=number
TOOLJET_DB_STATEMENT_TIMEOUT=

# Row and file-size ceilings for CSV bulk upload into a ToolJet Database
# table. Defaults are 5000 rows and 5 MB.
# @type=number
TOOLJET_DB_BULK_UPLOAD_MAX_ROWS=
# @type=number
TOOLJET_DB_BULK_UPLOAD_MAX_CSV_FILE_SIZE_MB=

# ─── PostgREST ───────────────────────────────────────────────────────────

# ToolJet Database queries are proxied to PostgREST, which runs as its own
# service in this stack. This is the URL the ToolJet server proxies to
# (server/src/modules/tooljet-db/services/postgrest-proxy.service.ts); a value
# starting `localhost:` would instead make the entrypoint launch PostgREST
# inside the app container, unsupervised.
# @required
# @docs("ToolJet Database", https://docs.tooljet.ai/docs/tooljet-db/tooljet-database/)
PGRST_HOST=http://${{stack.postgrest.HOST}}:3000

# HS256 secret shared by both services: ToolJet mints a short-lived token per
# request and signs it with this, PostgREST verifies it. They must match
# exactly or every table read fails; if it is unset PostgREST refuses
# authentication outright. `openssl rand -hex 32`. Keep it distinct from
# SECRET_KEY_BASE, which is only ever trusted by PostgREST.
# @required
# @sensitive
PGRST_JWT_SECRET=${PGRST_JWT_SECRET}

# Connection string PostgREST opens against the ToolJet Database. Points at
# the bundled Postgres and the TOOLJET_DB database, which the tooljet service
# creates on its first boot; until then PostgREST exits and is restarted.
# Note the password lands in URI userinfo, so it must not contain `/` or `@`;
# that is why POSTGRES_PASSWORD is generated as hex.
# @required
# @sensitive
PGRST_DB_URI=postgres://tooljet:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/tooljet_db

# Postgres function PostgREST calls to configure itself per connection.
# ToolJet installs `postgrest.pre_config` by migration; changing this name
# leaves PostgREST without the schema and role setup ToolJet expects.
PGRST_DB_PRE_CONFIG=postgrest.pre_config

# Port PostgREST listens on inside the stack network. The twin of the port in
# PGRST_HOST above: change one and you must change the other.
# @type=port
PGRST_SERVER_PORT=3000

# PostgREST's own log verbosity.
# @type=enum(crit, error, warn, info)
PGRST_LOG_LEVEL=info

# ─── Redis and workflows ─────────────────────────────────────────────────

# Empty or `localhost` makes the entrypoint start a Redis inside this
# container, fine for a single instance, and what this template relies on.
# Point it at an external Redis (v7.x) the moment you run more than one
# ToolJet process, or the workflow queue is not shared; the entrypoint then
# blocks up to 300s waiting for it and exits if it never answers.
# @docs("Workflows and external Redis", https://docs.tooljet.ai/docs/setup/docker/)
REDIS_HOST=

# @type=port
REDIS_PORT=

REDIS_USERNAME=
# @sensitive
REDIS_PASSWORD=
# @type=number
REDIS_DB=
# @type=boolean
REDIS_TLS=

# "true" makes this process consume the BullMQ workflow queue and load
# schedules. Unset, workflows can still be run by hand from the editor but
# nothing scheduled ever fires.
# @type=boolean
WORKER=

# Workflow jobs a worker runs at once (default 5) and the per-workflow
# execution ceiling in seconds (default 60).
# @type=number
TOOLJET_WORKFLOW_CONCURRENCY=
# @type=number
WORKFLOW_TIMEOUT_SECONDS=

# ─── Signup and sessions ─────────────────────────────────────────────────

# OPEN BY DEFAULT. Every guard reads `DISABLE_SIGNUPS !== 'true'`
# (server/src/modules/onboarding/guards/signup-disable.guard.ts), so an
# unset value means anyone who can reach TOOLJET_HOST can create an account.
# On a public address set this to "true" immediately after creating the first
# admin and invite users instead.
# @type=boolean
# @docs("Self-signup", https://docs.tooljet.ai/docs/user-management/onboard-users/self-signup-user/)
DISABLE_SIGNUPS=

# Same switch for accounts arriving via SSO: "true" lets existing users log
# in through the IdP but stops it from creating new ones.
# @type=boolean
SSO_DISABLE_SIGNUPS=

# Comma-separated email domains allowed to sign up or sign in via SSO. Empty
# accepts any domain the IdP asserts.
SSO_ACCEPTED_DOMAINS=

# Session lifetime in minutes. Default 14400 (10 days).
# @type=number
USER_SESSION_EXPIRY=

# Failed sign-ins before an account is locked (and the switch to turn that
# off entirely, which you should not).
# @type=number
PASSWORD_RETRY_LIMIT=
# @type=boolean
DISABLE_PASSWORD_RETRY_LIMIT=

# Minutes an emailed invite / password-reset link stays valid. Default 0,
# which means no expiry, so set it.
# @type=number
LINK_EXPIRY_MINUTES=

# Days before a password must be changed; empty disables expiry.
# @type=number
PASSWORD_EXPIRY_DAYS=

# ─── SSO ─────────────────────────────────────────────────────────────────

# Instance-level Google sign-in. Presence of the client ID is what enables
# the provider (server/src/modules/auth/util.service.ts); the client secret
# is configured per workspace in the UI, not here. Redirect URI is
# <TOOLJET_HOST>/sso/google.
# @docs("Google SSO", https://docs.tooljet.ai/docs/user-management/sso/google/)
SSO_GOOGLE_OAUTH2_CLIENT_ID=

# Instance-level GitHub sign-in. The host is only needed for GitHub
# Enterprise Server; leave it empty for github.com.
# @docs("GitHub SSO", https://docs.tooljet.ai/docs/user-management/sso/github/)
SSO_GIT_OAUTH2_CLIENT_ID=
# @sensitive
SSO_GIT_OAUTH2_CLIENT_SECRET=
SSO_GIT_OAUTH2_HOST=

# Milliseconds ToolJet waits on an OIDC provider's discovery/token endpoints.
# Default 3500, which is tight for a slow IdP.
# @type=number
OIDC_CONNECTION_TIMEOUT=

# ─── Email ───────────────────────────────────────────────────────────────

# Envelope From for invites, password resets and comment notifications. With
# no SMTP configured these emails are never delivered, so the only way to
# onboard a second user is the invitation link shown in the UI.
# @type=email
# @docs("SMTP configuration", https://docs.tooljet.ai/docs/tj-setup/smtp-setup/configuration/)
DEFAULT_FROM_EMAIL=

# The SMTP server HOSTNAME, despite the name: server/src/modules/smtp/dto.ts
# reads SMTP_DOMAIN as the transport host. There is no SMTP_HOST at this
# version whatever the docs suggest.
SMTP_DOMAIN=

# @type=port
SMTP_PORT=

SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=

# "true" stops ToolJet sending anything and logs a preview instead.
# @type=boolean
SMTP_DISABLED=

# Comma-separated domains ToolJet refuses to email, a blast-radius guard for
# a staging instance restored from production data.
FILTERED_DOMAINS_FOR_EMAIL=

# ─── Plugins and features ────────────────────────────────────────────────

# Where marketplace plugin bundles are fetched from at runtime. Defaults to
# ToolJet's public S3 bucket; point it at your own mirror for an instance
# with no egress, and remember TOOLJET_HTTP_PROXY if egress is proxied.
# @type=url
# @docs("Marketplace", https://docs.tooljet.ai/docs/marketplace/marketplace-overview/)
TOOLJET_MARKETPLACE_URL=

# Loads plugins from the local filesystem instead of the marketplace bundle,
# for developing a plugin, not for production.
# @type=boolean
ENABLE_MARKETPLACE_DEV_MODE=

# Real-time collaborative editing of an app (default on) and in-app comments
# (default off).
# @type=boolean
ENABLE_MULTIPLAYER_EDITING=
# @type=boolean
COMMENT_FEATURE_ENABLE=

# Block embedding ToolJet apps in an iframe entirely, or allow it for private
# (authenticated) apps as well as public ones. Enabling private embed widens
# who can reach an authenticated app, so pair it with CSP_WHITELISTED_DOMAINS.
# @type=boolean
DISABLE_APP_EMBED=
# @type=boolean
ENABLE_PRIVATE_APP_EMBED=

# Enterprise licence key for paid features. The free tier of this same EE
# image needs nothing here; the value is also settable from the UI, which is
# where it lands in the database.
# @sensitive
# @docs("Self-hosted licensing", https://docs.tooljet.ai/docs/tj-setup/licensing/self-hosted/)
LICENSE_KEY=

# ─── Observability ───────────────────────────────────────────────────────

# Exposes a Prometheus scrape endpoint at /metrics. It is unauthenticated,
# so only enable it where the port is not publicly reachable.
# @type=boolean
# @docs("Observability with OpenTelemetry", https://docs.tooljet.ai/docs/tj-setup/observability/observability-otel/)
ENABLE_METRICS=

# Master switch for OTel traces/metrics; the three exporter endpoints below
# do nothing without it. OTEL_EXPORTER_OTLP_LOGS is separately the on/off
# switch for shipping logs, at LOG_LEVEL verbosity.
# @type=boolean
ENABLE_OTEL=
# @type=url
OTEL_EXPORTER_OTLP_TRACES=
# @type=url
OTEL_EXPORTER_OTLP_METRICS=
# @type=url
OTEL_EXPORTER_OTLP_LOGS=

# Extra header sent to the OTLP collector, usually its auth token.
# @sensitive
OTEL_HEADER=

# TypeORM query-log verbosity, and the historical fallback for LOG_LEVEL when
# that is unset. `all` logs every statement (useful once, expensive always).
# @type=enum(all, warn, error)
ORM_LOGGING=

# ToolJet phones home once a day with instance telemetry. Set "true" to stop
# it. (The value is read as a string; only the exact "true" disables.)
# @type=boolean
DISABLE_TOOLJET_TELEMETRY=

# APM integration. `SENTRY_DNS` is spelled that way in the code; it is the
# Sentry DSN.
# @type=enum(sentry)
APM_VENDOR=
# @sensitive
SENTRY_DNS=
# @type=boolean
SENTRY_DEBUG=
