# Twenty v2.37.5 (image twentycrm/twenty:v2.37.5, run twice: the `twenty`
# server and the `worker`) environment schema (@env-spec / varlock format).
#
# Source: the decorated `ConfigVariables` class at
# packages/twenty-server/src/engine/core-modules/twenty-config/config-variables.ts,
# read at git tag `twenty/v2.37.5` (Twenty tags releases with a `twenty/`
# prefix; the Docker tag is the bare `v2.37.5`). That class (not a raw
# process.env grep) is the authoritative surface: NestJS validates it with
# class-validator at boot and every read goes through TwentyConfigService.
# Cross-checked against packages/twenty-docker/docker-compose.yml,
# packages/twenty-docker/.env.example, packages/twenty-server/.env.example and
# packages/twenty-docker/twenty/entrypoint.sh at the same tag.
#
# THE BIG ONE: most of this is not really environment configuration any more.
# `IS_CONFIG_VARIABLES_IN_DB_ENABLED` defaults to TRUE, and only 37 of the
# class's 232 variables are marked `isEnvOnly`. For every other key, the
# lookup order in TwentyConfigService.get() is: database row first (set from
# Settings > Admin Panel > Configuration Variables), environment second. So a
# value set here is a seed/fallback that an admin can silently override in the
# UI, and editing it later will look like it did nothing. The env-only keys
# (the ones the admin panel cannot touch) are: APP_SECRET, ENCRYPTION_KEY,
# FALLBACK_ENCRYPTION_KEY, PG_DATABASE_URL, PG_DATABASE_REPLICA_URL, PG_SSL_*,
# PG_POOL_*, PG_DATABASE_*_TIMEOUT_MS, SEARCH_ILIKE_FALLBACK_TIMEOUT_MS,
# REDIS_URL, REDIS_QUEUE_URL, WORKER_ENABLED_QUEUES, WORKER_EXCLUDED_QUEUES,
# SERVER_URL, NODE_ENV, NODE_PORT, SERVER_KEEP_ALIVE_TIMEOUT_MS, TRUST_PROXY,
# AI_STREAM_SHUTDOWN_DRAIN_MS, IS_CONFIG_VARIABLES_IN_DB_ENABLED, SSL_*_PATH,
# APP_VERSION, WORKSPACE_SCHEMA_DDL_LOCKED, DPA_DEPLOYMENT_REGION, LOG_LEVELS,
# LOGGER_DRIVER, EXCEPTION_HANDLER_DRIVER, METER_DRIVER, EVENT_SINKS,
# SENTRY_TRACES_SAMPLE_RATE, SENTRY_PROFILES_SAMPLE_RATE and MINTLIFY_*.
# Set IS_CONFIG_VARIABLES_IN_DB_ENABLED=false to make this file authoritative
# for everything, at the cost of a restart per change.
#
# Where the docs and the code disagree at this version:
#
#   * The setup page says `IS_MULTIWORKSPACE_ENABLED` "can only be configured
#     via .env file". It is NOT `isEnvOnly` in config-variables.ts at v2.37.5;
#     it is a database-backed variable like the rest, so the admin panel wins.
#   * `IS_SIGN_UP_DISABLED` no longer exists (it is absent from the class at
#     v2.32.0 through v2.37.5, and there is no such string anywhere in the
#     repo). Open signup is now governed by
#     IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS (default TRUE, refuses a
#     sign-up with no pending invitation and no approved access domain) plus
#     IS_MULTIWORKSPACE_ENABLED (default FALSE, which additionally stops any
#     second workspace being created). Both are database-backed: an admin can
#     turn them off in the UI, so the env value is a first-boot default only.
#   * `DISABLE_DB_MIGRATIONS` and `DISABLE_CRON_JOBS_REGISTRATION` are not
#     config variables at all. The image's entrypoint.sh reads them from the
#     shell before Node starts. They never reach the admin panel.
#   * `APP_SECRET` is described in .env.example as legacy. It still works and
#     is still the only secret this template asks for: when ENCRYPTION_KEY is
#     unset, resolveEncryptionKeysOrThrow() falls back to APP_SECRET for the
#     at-rest envelope. A new install should set a dedicated ENCRYPTION_KEY.
#   * Upgrading past v2.34 needs PostgreSQL >= 15; the bundled db is 16.
#
# Deliberately not declared: the cloud-only surface the class carries but a
# self-hosted CRM never reads. That means Stripe/billing, AWS SES / Resend /
# Tatami emailing-domain drivers, Cloudflare custom-domain provisioning,
# onboarding credit rewards, People Data Labs, Mintlify doc search, and the
# Lambda sub-hosting knobs. See the reference below for the full 232.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Twenty self-host configuration reference", https://docs.twenty.com/developers/self-host/capabilities/setup)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# Public base URL of this instance, protocol included. The browser resolves
# the API from its own origin, so the UI loads without it, but the server
# uses SERVER_URL for every generated link (invitation and verification
# emails, OAuth callbacks, file tokens) and to decide whether to mark session
# cookies `secure`. Set it to the https:// URL you actually serve, or logins
# behind TLS break and emailed links point at localhost.
# @required @type=url
# @docs("Understanding SERVER_URL", https://docs.twenty.com/developers/self-host/capabilities/docker-compose)
SERVER_URL=

# Signs and verifies every token Twenty issues (access, refresh, login,
# invitation and file tokens) and, when ENCRYPTION_KEY is unset, is also the
# key for the at-rest `enc:v2:` envelope around OAuth tokens, TOTP secrets,
# signing-key private keys and sensitive config rows. A weak or shared value
# lets anyone who knows it forge a token for any user in any workspace and
# decrypt everything the database holds; never reuse another instance's.
# Generate with `openssl rand -base64 32`. Changing it invalidates every
# session and refresh token (all users are logged out) and, unless the old
# value is handed to FALLBACK_ENCRYPTION_KEY, makes existing encrypted rows
# undecryptable. Env-only: the admin panel cannot read or set it.
# @required @sensitive @type=string(minLength=32)
# @docs("Encryption keys", https://docs.twenty.com/developers/self-host/capabilities/setup#encryption-keys)
APP_SECRET=

# Primary at-rest encryption key, preferred over APP_SECRET on new installs.
# Leave empty and Twenty falls back to APP_SECRET (the legacy path this
# compose uses); set it and it takes over, at which point losing it means
# losing every secret in the database. Generate with `openssl rand -base64 32`.
# @sensitive @type=string(minLength=32)
# @docs("Encryption keys", https://docs.twenty.com/developers/self-host/capabilities/setup#encryption-keys)
ENCRYPTION_KEY=

# Verification-only second key, used during a rotation: set it to the PREVIOUS
# ENCRYPTION_KEY so rows written under the old key stay decryptable and
# sessions signed with it still verify. Remove it once the re-encryption
# command has finished.
# @sensitive
# @docs("Key rotation guide", https://docs.twenty.com/developers/self-host/capabilities/key-rotation)
FALLBACK_ENCRYPTION_KEY=

# Runtime mode. Production is the image default and the only sane value here:
# `development` prefills a demo login, turns on verbose TypeORM logging, and
# flips LOGIC_FUNCTION_TYPE / CODE_INTERPRETER_TYPE from DISABLED to the
# unsandboxed LOCAL driver.
# @type=enum(production, development, test)
NODE_ENV=production

# Port the NestJS server listens on inside the container. The compose exposes
# container port 3000 with no override, so changing this without changing the
# exposed port breaks routing.
# @type=port
NODE_PORT=3000

# Idle keep-alive timeout (ms) of the HTTP server. Keep it ABOVE the idle
# timeout of whatever proxy sits in front (nginx, ALB, Cloudflare: usually
# 60s) so the proxy, not Node, is the side that closes a pooled connection.
# Otherwise you get sporadic 502s under load.
# @type=number
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000

# Express `trust proxy` setting. Decides whether X-Forwarded-* headers are
# honoured, which is what makes request.protocol return "https" behind a
# TLS-terminating proxy, and therefore whether session cookies get the
# `secure` flag. The default trusts loopback plus RFC1918/ULA peers, correct
# for the reverse-proxy deployment otterdeploy runs. Set it to `false` only if
# the container is exposed directly to the internet; a blanket `true` lets any
# client spoof its own source IP for rate limiting.
# @docs("Express behind proxies", https://expressjs.com/en/guide/behind-proxies.html)
TRUST_PROXY=loopback, linklocal, uniquelocal

# Chooses where non-env-only configuration is read from. True (the default)
# means the database row wins and Settings > Admin Panel > Configuration
# Variables is the real control surface; false pins everything to this file
# and makes the admin panel read-only. With multiple containers (server +
# worker) the database mode is what keeps them in sync: changes propagate
# within ~15s without redeploying either.
# @type=boolean
# @docs("Configuration management", https://docs.twenty.com/developers/self-host/capabilities/setup)
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true

# Version string the server reports about itself (health endpoint, admin
# panel, Sentry release). The image bakes the right value in; leave empty.
APP_VERSION=

# Stable UUID identifying this server instance. Generated during database
# seeding and persisted there. It is only read from the environment when
# IS_CONFIG_VARIABLES_IN_DB_ENABLED is false.
SERVER_ID=

# ─── Startup behaviour (image entrypoint, not the config class) ───────────

# Read by the image's /app/entrypoint.sh, before Node starts. "true" skips the
# schema init, `command:prod upgrade` and cache flushes at boot. The compose
# leaves it false on the `twenty` service so migrations run exactly once, and
# sets it to "true" on the `worker` so the two containers cannot race each
# other through the same migration.
# @type=boolean
# @docs("Docker entrypoint", https://github.com/twentyhq/twenty/blob/main/packages/twenty-docker/twenty/entrypoint.sh)
DISABLE_DB_MIGRATIONS=false

# Same entrypoint, same split: "true" skips `cron:register:all`, which is what
# schedules the recurring message/calendar sync and workflow cron triggers.
# The compose registers them from the `twenty` service and sets "true" on the
# `worker`. Disabling it on both leaves every scheduled job unregistered.
# @type=boolean
DISABLE_CRON_JOBS_REGISTRATION=false

# Emergency lock for hot upgrades: blocks all workspace DDL, which also blocks
# sign-up, workspace deletion and any metadata change. Leave off.
# @type=boolean
WORKSPACE_SCHEMA_DDL_LOCKED=false

# ─── PostgreSQL (bundled `db` service) ────────────────────────────────────

# Connection URL for the single database holding the core schema and every
# workspace schema. Platform-owned: otterdeploy resolves the bundled Postgres
# host and threads POSTGRES_PASSWORD through, so it must stay
# character-for-character what the compose sets. It is env-only, read before
# the config store exists, so the admin panel can never change it. Twenty
# v2.34+ requires PostgreSQL 15 or newer; the bundled image is 16.
# @required @sensitive
# @docs("Upgrade guide", https://docs.twenty.com/developers/self-host/capabilities/upgrade-guide)
PG_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/default

# Password for the bundled Postgres superuser. It is the same value embedded
# in PG_DATABASE_URL, so changing one without the other breaks every
# connection. Generate it (`openssl rand -base64 24`) and treat it as full
# read/write access to every CRM record. Avoid characters that need
# percent-encoding in a URL; upstream's own docs ask for "a strong password
# without special characters" for exactly this reason.
# @required @sensitive
POSTGRES_PASSWORD=

# Superuser the bundled Postgres image creates on first start; must match the
# user in PG_DATABASE_URL. Read by the postgres entrypoint, not by Twenty.
# @docs("Postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=postgres

# Database the bundled Postgres image creates on first start, matching the
# path in PG_DATABASE_URL. Changing it after the first boot does nothing,
# because the volume already has the old database.
POSTGRES_DB=default

# Optional read-replica URL. When set, read-only queries are routed to it.
# Only for an external, replicated Postgres; the bundled single node has none.
# @sensitive
PG_DATABASE_REPLICA_URL=

# Accept a self-signed certificate when the database connection uses TLS.
# Irrelevant for the bundled, co-located database; needed for some managed
# providers that present their own CA.
# @type=boolean
PG_SSL_ALLOW_SELF_SIGNED=false

# Upper bound on clients in this process's pg pool. Both the server and the
# worker open their own pool, so the real ceiling against Postgres is roughly
# this times the number of containers, so keep it under the server's
# max_connections.
# @type=number
PG_POOL_MAX_CONNECTIONS=10

# How long (ms) an idle pooled client is kept before being closed.
# @type=number
PG_POOL_IDLE_TIMEOUT_MS=600000

# Let the pool release the event loop when every client is idle.
# @type=boolean
PG_POOL_ALLOW_EXIT_ON_IDLE=true

# Statement timeout (ms) applied to queries on the primary.
# @type=number
PG_DATABASE_PRIMARY_TIMEOUT_MS=10000

# Statement timeout (ms) applied to queries on PG_DATABASE_REPLICA_URL.
# @type=number
PG_DATABASE_REPLICA_TIMEOUT_MS=10000

# Timeout (ms) for the per-object ILIKE fallback search, which only runs when
# the tsvector query returns nothing on the first page (CJK input, mostly).
# On timeout that object is skipped rather than failing the search.
# @type=number
SEARCH_ILIKE_FALLBACK_TIMEOUT_MS=2000

# ─── Redis and the worker (bundled `redis` service) ───────────────────────

# Cache and BullMQ queue backend, shared by the server and the worker.
# Platform-owned: the host comes from the bundled redis service, so it must
# match the compose exactly. Env-only. Twenty needs an eviction policy of
# `noeviction` on the queue database (upstream's own compose starts redis
# with `--maxmemory-policy noeviction`) because an evicted job key is a
# silently lost background job.
# @required @sensitive
# @docs("Redis client patterns", https://redis.io/docs/latest/develop/clients/patterns/)
REDIS_URL=redis://${{stack.redis.HOST}}:6379

# Optional second Redis for queues only, so cache pressure cannot evict jobs.
# Advanced; leave empty to keep both on REDIS_URL.
# @sensitive
REDIS_QUEUE_URL=

# Comma-separated allowlist of queues this container processes. Empty means
# all of them, which is what a single-worker deployment wants. Only useful
# when running several dedicated worker containers.
WORKER_ENABLED_QUEUES=

# Comma-separated denylist, applied after WORKER_ENABLED_QUEUES. Used to keep
# a long-running queue off a general-purpose worker.
WORKER_EXCLUDED_QUEUES=

# How long (ms) a worker shutdown waits for in-flight AI chat streams before
# aborting them into a retryable state. Must be lower than the container's
# stop grace period or the process is killed mid-abort.
# @type=number
AI_STREAM_SHUTDOWN_DRAIN_MS=300000

# Time-to-live, in seconds, of cached metadata/workspace entries in Redis.
# @type=number
CACHE_STORAGE_TTL=604800

# ─── File storage ─────────────────────────────────────────────────────────

# Where uploaded files, avatars and attachments live. The compose sets `local`
# and mounts a named volume at the local-storage path, so files survive
# restarts on a single node. The value is upper-snake-cased before matching,
# so `local`/`LOCAL` and `s3`/`S3`/`S_3` are all accepted. Use S3 if you ever
# run more than one server container: with `local` each replica sees only its
# own files. Database-backed, so the admin panel can flip it under you.
# @type=enum(local, s3)
# @docs("S3 storage", https://docs.twenty.com/developers/self-host/capabilities/setup#s3-storage)
STORAGE_TYPE=local

# Directory inside the container used when STORAGE_TYPE is local, relative to
# the server package root. The compose mounts its volume at
# /app/packages/twenty-server/.local-storage, which is this default. Changing
# it moves uploads off the volume and they are lost on restart.
STORAGE_LOCAL_PATH=.local-storage

# Bucket region slug ("eu-west-3" on AWS, provider-specific elsewhere).
# Required once STORAGE_TYPE is s3.
STORAGE_S3_REGION=

# Bucket name. Required once STORAGE_TYPE is s3.
STORAGE_S3_NAME=

# Custom endpoint for S3-compatible services (MinIO, Spaces, R2). Leave empty
# for native AWS S3, where the SDK derives the endpoint from the region.
# @type=url
STORAGE_S3_ENDPOINT=

# Access key ID. Leave empty to use the default AWS credential chain (IAM
# role, instance profile) instead of a static key.
# @sensitive
STORAGE_S3_ACCESS_KEY_ID=

# Secret access key. Required when STORAGE_S3_ACCESS_KEY_ID is set, ignored
# otherwise.
# @sensitive
STORAGE_S3_SECRET_ACCESS_KEY=

# Serve downloads as 302 redirects to presigned S3 URLs and let uploads go
# straight to the bucket, instead of proxying bytes through the server. Saves
# bandwidth, but the bucket must allow your frontend origin in its CORS rules.
# @type=boolean
STORAGE_S3_PRESIGNED_URL_ENABLED=false

# Publicly reachable endpoint to sign URLs against, for when
# STORAGE_S3_ENDPOINT is an internal address browsers cannot resolve.
# @type=url
STORAGE_S3_PRESIGNED_URL_BASE=

# Lifetime, in seconds, of a generated presigned URL.
# @type=number
STORAGE_S3_PRESIGNED_URL_EXPIRES_IN=900

# ─── Sign-up, workspaces and passwords ────────────────────────────────────

# The signup gate on a self-hosted CRM. TRUE (the default) refuses any sign-up
# that has no pending invitation and no approved access domain, and limits
# creating further workspaces to server admins. Setting it to false on an
# internet-reachable instance means anyone who can load the page can create an
# account. It is ignored during initial setup, while no workspace exists, so
# the first person to reach a fresh instance becomes its admin. Put the
# instance behind auth or claim it immediately after deploying. Replaces the
# removed IS_SIGN_UP_DISABLED. Database-backed: an admin can flip it in the UI.
# @type=boolean
# @docs("Restricting workspace creation", https://docs.twenty.com/developers/self-host/capabilities/setup#multi-workspace-mode)
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# Single-workspace mode by default: one workspace per instance, the first user
# becomes admin, and new signups stop once that workspace exists. Turning it
# on makes this a multi-tenant SaaS: every workspace gets its own subdomain,
# nobody gets automatic admin, and you need a wildcard DNS record.
# @type=boolean
# @docs("Multi-workspace mode", https://docs.twenty.com/developers/self-host/capabilities/setup#multi-workspace-mode)
IS_MULTIWORKSPACE_ENABLED=false

# Subdomain users sign in at when multi-workspace mode is on
# (app.example.com). Ignored in single-workspace mode.
DEFAULT_SUBDOMAIN=app

# Allow email + password sign-in at all. Turn it off only once an SSO provider
# below is configured and proven to work, or you lock yourself out.
# @type=boolean
AUTH_PASSWORD_ENABLED=true

# Require a verified email address before an account can be used. Off by
# default, and it needs a working EMAIL_DRIVER, since with the default LOGGER
# driver the verification mail only ever reaches the container log.
# @type=boolean
IS_EMAIL_VERIFICATION_REQUIRED=false

# Prefills the demo account tim@apple.dev in the login form. A local
# development convenience; never enable it on a deployed instance.
# @type=boolean
SIGN_IN_PREFILLED=false

# Lets server admins toggle any feature flag for any workspace from the admin
# panel. Off by default; that panel can enable unreleased behaviour.
# @type=boolean
IS_FEATURE_FLAG_MANAGEMENT_ENABLED=false

# ─── Google SSO and Gmail / Google Calendar ───────────────────────────────

# Turns on "Continue with Google" on the sign-in page. Needs the client ID,
# secret and both callback URLs below, registered on an OAuth 2.0 client in
# Google Cloud. Configure these in Settings > Admin Panel > Configuration
# Variables unless IS_CONFIG_VARIABLES_IN_DB_ENABLED is false.
# @type=boolean
# @docs("Gmail and Google Calendar integration", https://docs.twenty.com/developers/self-host/capabilities/setup#gmail-google-calendar-integration)
AUTH_GOOGLE_ENABLED=false

# OAuth 2.0 client ID from the Google Cloud console.
# @docs("Google Cloud credentials", https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_CLIENT_ID=

# OAuth 2.0 client secret. Anyone holding it can complete the sign-in flow for
# your instance, so treat it as a credential.
# @sensitive
AUTH_GOOGLE_CLIENT_SECRET=

# Redirect URI for the SSO flow. Must be registered verbatim on the Google
# client: https://your-domain/auth/google/redirect
# @type=url
AUTH_GOOGLE_CALLBACK_URL=

# Redirect URI for the mailbox/calendar API grant (a different, wider scope
# set than sign-in): https://your-domain/auth/google-apis/get-access-token
# @type=url
AUTH_GOOGLE_APIS_CALLBACK_URL=

# Sync Gmail messages into the CRM timeline. Requires the Google OAuth client
# above plus the messaging cron jobs registered on the worker.
# @type=boolean
MESSAGING_PROVIDER_GMAIL_ENABLED=false

# Sync Google Calendar events into the CRM timeline. Same prerequisites.
# @type=boolean
CALENDAR_PROVIDER_GOOGLE_ENABLED=false

# Google Cloud Pub/Sub topic Gmail push notifications publish to
# (projects/<project>/topics/<topic>). Only needed for webhook-driven sync
# instead of polling.
MESSAGING_GMAIL_PUBSUB_TOPIC=

# Service account email authorised to deliver those Pub/Sub pushes; the signed
# OIDC token on each push is verified against it. A wrong value here means
# unverified pushes are accepted or all pushes are rejected.
MESSAGING_GMAIL_PUBSUB_VERIFICATION_EMAIL=

# Master switch for provider push notifications on connected accounts. Needs
# publicly reachable webhook endpoints; polling is used when off.
# @type=boolean
IS_CONNECTED_ACCOUNT_WEBHOOK_SUBSCRIPTION_ENABLED=false

# ─── Microsoft SSO and Microsoft 365 ──────────────────────────────────────

# Turns on Microsoft sign-in. Needs an app registration in Microsoft Entra ID
# with the redirect URIs below and the Graph Mail/Calendar permissions.
# @type=boolean
# @docs("Register an app with Microsoft Entra ID", https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app)
AUTH_MICROSOFT_ENABLED=false

# Application (client) ID of the Entra app registration.
AUTH_MICROSOFT_CLIENT_ID=

# Client secret of that registration. Expires on Microsoft's schedule, and
# sign-in breaks silently when it lapses.
# @sensitive
AUTH_MICROSOFT_CLIENT_SECRET=

# Redirect URI for Microsoft SSO:
# https://your-domain/auth/microsoft/redirect
# @type=url
AUTH_MICROSOFT_CALLBACK_URL=

# Redirect URI for the Microsoft mail/calendar API grant:
# https://your-domain/auth/microsoft-apis/get-access-token
# @type=url
AUTH_MICROSOFT_APIS_CALLBACK_URL=

# Sync Outlook mail into the CRM timeline. Users need a Microsoft 365 licence.
# @type=boolean
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false

# Sync Outlook calendar events into the CRM timeline.
# @type=boolean
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false

# ─── IMAP / SMTP / CalDAV accounts ────────────────────────────────────────

# Lets a workspace member connect a plain IMAP/SMTP/CalDAV mailbox with a
# username and password. Those credentials are stored encrypted under
# ENCRYPTION_KEY/APP_SECRET. Historically (GHSA-mq5c-qp77-2cv3, fixed in
# 2.7.0) they were readable by any workspace member, so keep the instance
# current. Turn it off if you do not want passwords held here at all.
# @type=boolean
# @docs("Mailbox", https://docs.twenty.com/user-guide/calendar-emails/capabilities/mailbox)
IS_IMAP_SMTP_CALDAV_ENABLED=true

# Dial the provider once when an account is saved, to verify the credentials.
# Turning it off accepts unvalidated settings silently.
# @type=boolean
IS_IMAP_SMTP_CALDAV_CONNECTION_TEST_ENABLED=true

# Messages pulled per batch during an import. Lower it when Gmail, Outlook or
# an IMAP host starts rate limiting the sync.
# @type=number
MESSAGING_MESSAGES_GET_BATCH_SIZE=400

# ─── Sessions, cookies and token lifetimes ────────────────────────────────

# SameSite attribute of the session cookie. `none` (required for a split
# frontend/API origin) also requires https, and widens CSRF exposure. Keep
# `lax` for a same-origin deployment.
# @type=enum(lax, strict, none)
# @docs("API and front-end on separate hosts", https://docs.twenty.com/developers/self-host/capabilities/setup#api-and-front-end-on-separate-hosts)
AUTH_COOKIE_SAME_SITE=lax

# Extra browser origins allowed to send credentialed cross-origin requests,
# comma separated. SERVER_URL and FRONTEND_URL are already trusted. Every
# origin listed here can drive the API as a signed-in user, so list only your
# own frontends.
AUTH_COOKIE_ALLOWED_ORIGINS=

# Hard ceiling on a cookie session, fixed at sign-in and never extended.
SESSION_ABSOLUTE_LIFETIME=180d

# Inactivity window after which a cookie session expires.
SESSION_IDLE_TIMEOUT=30d

# Lifetime of the short-lived API access token. Shorter means a stolen token
# is useful for less time, at the cost of more refreshes.
ACCESS_TOKEN_EXPIRES_IN=30m

# Lifetime of the refresh token that mints new access tokens.
REFRESH_TOKEN_EXPIRES_IN=60d

# Window in which the same refresh token may be presented twice (two tabs
# refreshing at once) before it counts as replay and triggers suspicious
# activity handling.
REFRESH_TOKEN_REUSE_GRACE_PERIOD=1m

# Lifetime of the one-shot token that turns a completed login into a session.
LOGIN_TOKEN_EXPIRES_IN=15m

# Lifetime of the token embedded in file URLs. Longer values mean an attachment
# link stays fetchable by anyone who copied it.
FILE_TOKEN_EXPIRES_IN=1d

# How long a workspace invitation link stays valid.
INVITATION_TOKEN_EXPIRES_IN=30d

# Lifetime of internal short-term tokens (impersonation, one-off flows).
SHORT_TERM_TOKEN_EXPIRES_IN=5m

# Lifetime of the workspace-agnostic token used before a workspace is chosen.
WORKSPACE_AGNOSTIC_TOKEN_EXPIRES_IN=30m

# Window after authenticating on the workspace-agnostic domain during which a
# user can auto-login to a workspace without re-authenticating.
WORKSPACE_AUTO_LOGIN_WINDOW=30m

# How long an email verification link stays valid.
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=1h

# How long a password reset link stays valid.
PASSWORD_RESET_TOKEN_EXPIRES_IN=5m

# Days the current JWT signing key stays valid before the rotation cron issues
# a new one. Empty disables automatic rotation, which means one compromised
# key stays valid indefinitely.
# @type=number
# @docs("Key rotation guide", https://docs.twenty.com/developers/self-host/capabilities/key-rotation)
SIGNING_KEY_ROTATION_DAYS=

# ─── Captcha ──────────────────────────────────────────────────────────────

# Puts a captcha in front of sign-up and sign-in. Empty means none, which is
# the default. Worth setting if you deliberately allow open sign-up. The
# value is upper-snake-cased, so `turnstile` and `TURNSTILE` both work.
# @type=enum(turnstile, google_recaptcha)
# @docs("Cloudflare Turnstile", https://developers.cloudflare.com/turnstile/)
CAPTCHA_DRIVER=

# Public site key of the captcha widget.
# @sensitive
# @docs("reCAPTCHA v3", https://developers.google.com/recaptcha/docs/v3)
CAPTCHA_SITE_KEY=

# Server-side secret used to verify the captcha response.
# @sensitive
CAPTCHA_SECRET_KEY=

# ─── Outgoing email ───────────────────────────────────────────────────────

# How Twenty sends mail. The default LOGGER writes the message to the
# container log and delivers nothing, so invitations, password resets and
# email verification all appear to work and never arrive. Switch to SMTP for a
# real instance. Upper-snake-cased, so `smtp` works too.
# @type=enum(logger, smtp)
# @docs("Email configuration", https://docs.twenty.com/developers/self-host/capabilities/setup#email-configuration)
EMAIL_DRIVER=LOGGER

# Envelope sender address. Must be one your SMTP relay is allowed to send as,
# or mail is rejected or spam-filed.
# @type=email
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Display name in the From header. Upstream's default is a Twenty-branded
# placeholder; change it.
EMAIL_FROM_NAME=Felix from Twenty

# SMTP server hostname.
EMAIL_SMTP_HOST=

# SMTP port. 587 for STARTTLS, 465 for implicit TLS.
# @type=port
EMAIL_SMTP_PORT=587

# SMTP username. Gmail and Office 365 with 2FA need an app password, not the
# account password.
# @sensitive
# @docs("Sign in with app passwords", https://support.google.com/accounts/answer/185833)
EMAIL_SMTP_USER=

# SMTP password or app password.
# @sensitive
EMAIL_SMTP_PASSWORD=

# Sends mail over an unencrypted connection. Only for a relay on the same
# private network; on anything else it puts EMAIL_SMTP_PASSWORD and every
# message on the wire in clear text.
# @type=boolean
EMAIL_SMTP_NO_TLS=false

# ─── Code execution (workflows and AI) ────────────────────────────────────

# Driver for workflow logic functions. DISABLED is the default under
# NODE_ENV=production and is the safe choice: LOCAL runs user-authored code in
# the server's own Node process with no sandbox, so anyone who can edit a
# workflow gets code execution on the host. Use LAMBDA if you need it in
# production.
# @type=enum(DISABLED, LOCAL, LAMBDA)
# @docs("Logic functions and code interpreter", https://docs.twenty.com/developers/self-host/capabilities/setup#logic-functions-code-interpreter)
LOGIC_FUNCTION_TYPE=DISABLED

# Driver for the AI code interpreter, with the same warning: LOCAL is
# unsandboxed execution on the host, E_2_B runs it in an isolated sandbox.
# @type=enum(DISABLED, LOCAL, E_2_B)
CODE_INTERPRETER_TYPE=DISABLED

# API key for the E2B sandbox, required when CODE_INTERPRETER_TYPE is E_2_B.
# @sensitive
# @docs("E2B documentation", https://e2b.dev/docs)
E2B_API_KEY=

# Region for LOGIC_FUNCTION_TYPE=LAMBDA.
LOGIC_FUNCTION_LAMBDA_REGION=

# IAM role ARN the Lambda executions assume.
LOGIC_FUNCTION_LAMBDA_ROLE=

# Access key ID used to deploy and invoke those functions.
# @sensitive
LOGIC_FUNCTION_LAMBDA_ACCESS_KEY_ID=

# Matching secret access key.
# @sensitive
LOGIC_FUNCTION_LAMBDA_SECRET_ACCESS_KEY=

# ─── AI providers ─────────────────────────────────────────────────────────

# API key for OpenAI models. Set any of these and the AI features (chat,
# agents, workflow AI actions) light up for every workspace member, and the
# key is billed against your account, so treat it as a spend control too.
# @sensitive
# @docs("AI overview", https://docs.twenty.com/user-guide/ai/overview)
OPENAI_API_KEY=

# API key for Anthropic (Claude) models.
# @sensitive
ANTHROPIC_API_KEY=

# API key for Google AI (Gemini) models.
# @sensitive
GOOGLE_API_KEY=

# API key for xAI (Grok) models.
# @sensitive
XAI_API_KEY=

# API key for Groq inference.
# @sensitive
GROQ_API_KEY=

# API key for Mistral models.
# @sensitive
MISTRAL_API_KEY=

# JSON object of extra provider configurations, deep-merged over the built-in
# catalogue: custom endpoints, extra regions, self-hosted gateways. Single
# line, e.g. {"openai":{"baseUrl":"https://gateway.example.com/v1"}}.
# @sensitive
AI_PROVIDERS={}

# Offers an AI chat at the end of onboarding to help set the workspace up.
# @type=boolean
IS_ONBOARDING_AI_CHAT_ENABLED=false

# ─── Outbound requests and API limits ─────────────────────────────────────

# SSRF guard for everything Twenty fetches on a user's behalf: HTTP workflow
# actions, webhooks, and IMAP/SMTP/CalDAV connections. On by default, it
# blocks private and link-local addresses. Turning it off lets any workspace
# member point a workflow at your internal network or a cloud metadata
# endpoint. Leave it on unless you have a specific, firewalled reason.
# @type=boolean
# @docs("Set up a webhook trigger", https://docs.twenty.com/user-guide/workflows/how-tos/connect-to-other-tools/set-up-a-webhook-trigger)
OUTBOUND_HTTP_SAFE_MODE_ENABLED=true

# Fetches company logos from Twenty's hosted icon service. Turn it off for an
# instance that must make no outbound calls to twenty.com.
# @type=boolean
ALLOW_REQUESTS_TO_TWENTY_ICONS=true

# Burst rate-limit window, in milliseconds, for API requests.
# @type=number
API_RATE_LIMITING_SHORT_TTL_IN_MS=1000

# Requests allowed inside that burst window.
# @type=number
API_RATE_LIMITING_SHORT_LIMIT=100

# Sustained rate-limit window, in milliseconds.
# @type=number
API_RATE_LIMITING_LONG_TTL_IN_MS=60000

# Requests allowed inside the sustained window.
# @type=number
API_RATE_LIMITING_LONG_LIMIT=100

# Cap on how many records one mutation may touch, so a single bad call cannot
# rewrite an entire object.
# @type=number
MUTATION_MAXIMUM_AFFECTED_RECORDS=100

# Maximum selected fields in a GraphQL query, a denial-of-service guard.
# @type=number
GRAPHQL_MAX_FIELDS=2000

# Maximum root resolvers in one GraphQL query.
# @type=number
GRAPHQL_MAX_ROOT_RESOLVERS=20

# Complexity ceiling for Common API queries.
# @type=number
COMMON_QUERY_COMPLEXITY_LIMIT=2000

# ─── URLs and domains ─────────────────────────────────────────────────────

# Only needed when the frontend is served from a different origin than the
# API. Empty means same-origin, which is what this compose runs.
# @type=url
# @docs("API and front-end on separate hosts", https://docs.twenty.com/developers/self-host/capabilities/setup#api-and-front-end-on-separate-hosts)
FRONTEND_URL=

# Base URL for the isolated public domain used to serve HTTP logic functions
# away from the app origin. Leave empty on a self-hosted instance.
# @type=url
PUBLIC_DOMAIN_URL=

# ─── Logging, telemetry and diagnostics ───────────────────────────────────

# Log levels the server emits, comma separated, from
# log/error/warn/debug/verbose/performance. Env-only, read before the config
# store exists.
# @docs("Troubleshooting", https://docs.twenty.com/developers/self-host/capabilities/troubleshooting)
LOG_LEVELS=log,error,warn,performance

# Logging backend. Console is the only implementation at this version.
# @type=enum(CONSOLE)
LOGGER_DRIVER=CONSOLE

# Buffers log lines before flushing them.
# @type=boolean
LOGGER_IS_BUFFER_ENABLED=true

# Where unhandled exceptions go. CONSOLE keeps them local; SENTRY needs
# SENTRY_DSN below.
# @type=enum(CONSOLE, SENTRY)
EXCEPTION_HANDLER_DRIVER=CONSOLE

# Sentry DSN for server-side errors and traces. A DSN is a write-only
# credential, but it identifies your project, so do not publish it.
# @sensitive
# @docs("What is a DSN", https://docs.sentry.io/product/sentry-basics/dsn-explainer/)
SENTRY_DSN=

# Separate DSN handed to the browser bundle for front-end errors. This one is
# genuinely public once the app loads.
# @sensitive
SENTRY_FRONT_DSN=

# Environment tag attached to Sentry events (production, staging, ...).
SENTRY_ENVIRONMENT=

# Share of server traces sampled, 0 to 1. Env-only.
# @type=number
SENTRY_TRACES_SAMPLE_RATE=0.1

# Share of sampled server traces that are also profiled, 0 to 1. Env-only.
# @type=number
SENTRY_PROFILES_SAMPLE_RATE=0.01

# Share of front-end traces sampled, 0 to 1. Browser traces propagate their
# decision to the server, so this also drives server traces they start.
# @type=number
SENTRY_FRONT_TRACES_SAMPLE_RATE=0.1

# Metrics exporters, comma separated: OpenTelemetry, Console. Empty exports
# nothing.
METER_DRIVER=

# TypeORM logging categories, comma separated, from
# query/schema/error/warn/info/log/migration. `query` is very loud.
TYPEORM_LOGGING=error

# Sends anonymous usage telemetry to Twenty. On by default. Set it to false
# for an air-gapped or privacy-sensitive deployment.
# @type=boolean
TELEMETRY_ENABLED=true

# Turns on the ClickHouse-backed product analytics pipeline. Requires
# CLICKHOUSE_URL; there is no ClickHouse in this stack, so leave it off.
# @type=boolean
ANALYTICS_ENABLED=false

# ClickHouse connection URL for that pipeline. Empty here.
# @sensitive
CLICKHOUSE_URL=

# Ordered list of sinks the event pipeline writes to; the first is the read
# store. Inert while ANALYTICS_ENABLED is false and CLICKHOUSE_URL is empty.
EVENT_SINKS=clickhouse

# Rolling window, in minutes, for the health metrics shown in the admin panel.
# @type=number
HEALTH_METRICS_TIME_WINDOW_IN_MINUTES=5

# ─── Support widget ───────────────────────────────────────────────────────

# Embeds Front's support chat in the UI. NONE, the default, embeds nothing and
# is what a self-hosted instance wants.
# @type=enum(NONE, FRONT)
# @docs("Community settings", https://docs.twenty.com/user-guide/settings/capabilities/community-settings)
SUPPORT_DRIVER=NONE

# Front chat identifier, when SUPPORT_DRIVER is FRONT.
# @sensitive
SUPPORT_FRONT_CHAT_ID=

# HMAC key used to sign the identity handed to that chat widget.
# @sensitive
SUPPORT_FRONT_HMAC_KEY=

# ─── Marketplace apps ─────────────────────────────────────────────────────

# npm registry Twenty resolves marketplace app packages from. Point it at an
# internal mirror to control what can be installed.
# @type=url
# @docs("Publishing apps", https://docs.twenty.com/developers/extend/apps/operations/publishing)
APP_REGISTRY_URL=https://registry.npmjs.org

# CDN the registry's files are served through.
# @type=url
APP_REGISTRY_CDN_URL=https://unpkg.com

# Auth token for that registry, for private packages.
# @sensitive
APP_REGISTRY_TOKEN=

# Registers the cron that syncs the marketplace catalogue from the registry.
# Turn it off to stop the automatic outbound catalogue import.
# @type=boolean
MARKETPLACE_CATALOG_SYNC_CRON_ENABLED=true

# Largest tarball, in bytes, accepted when registering an application.
# @type=number
MAX_TARBALL_UPLOAD_SIZE_BYTES=104857600

# ─── Enterprise, billing and other cloud-only knobs ───────────────────────

# Enterprise licence key. Empty runs the community build, which is what this
# template deploys.
# @sensitive
# @docs("Pricing plans", https://docs.twenty.com/user-guide/billing/capabilities/pricing-plans)
ENTERPRISE_KEY=

# Signed enterprise validity token (JWT), used as a fallback when none is
# stored in the database.
# @sensitive
ENTERPRISE_VALIDITY_TOKEN=

# Declares this instance as a billable production instance or the one free
# development instance a subscription may register. Only meaningful with an
# enterprise key.
# @type=enum(production, development)
ENTERPRISE_INSTANCE_TYPE=production

# Stripe-backed billing for multi-tenant hosting. Off, and irrelevant to a
# self-hosted single-workspace CRM.
# @type=boolean
IS_BILLING_ENABLED=false

# Region shown on the data processing agreement. Affects displayed text only.
# @type=enum(EU, US)
DPA_DEPLOYMENT_REGION=EU

# ─── Misc ─────────────────────────────────────────────────────────────────

# Renders inline previews for uploaded attachments.
# @type=boolean
# @docs("Record pages", https://docs.twenty.com/user-guide/layout/capabilities/record-pages)
IS_ATTACHMENT_PREVIEW_ENABLED=true

# Turns on Google Places address autocomplete and maps. Needs the key below,
# and sends address input to Google.
# @type=boolean
IS_MAPS_AND_ADDRESS_AUTOCOMPLETE_ENABLED=false

# Google Maps/Places API key for that feature. Restrict it by referrer or IP
# in the Google console; an unrestricted key is billable by anyone.
# @sensitive
GOOGLE_MAP_API_KEY=

# Path inside the container to a TLS private key, for terminating HTTPS in the
# Node process itself. Intended for local development. Behind otterdeploy's
# proxy, leave both empty.
SSL_KEY_PATH=

# Matching certificate path for SSL_KEY_PATH.
SSL_CERT_PATH=
