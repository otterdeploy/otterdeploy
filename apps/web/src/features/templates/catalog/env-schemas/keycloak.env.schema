# Keycloak 26.7.3 (image quay.io/keycloak/keycloak:26.7.3) environment schema
# (@env-spec / varlock format).
#
# Source: the option definitions in the source tree at tag 26.7.3, in
# `quarkus/config-api/src/main/java/org/keycloak/config/*Options.java`
# (HttpOptions, HostnameV2Options, DatabaseOptions, ProxyOptions,
# HealthOptions, MetricsOptions, ManagementOptions, CachingOptions,
# FeatureOptions, BootstrapAdminOptions, LoggingOptions), cross-checked
# against the generated "All configuration" reference for 26.7.3, which is
# produced from those same classes.
#
# A raw `getenv` grep is the WRONG tool here: Keycloak reads almost nothing
# by name. Every CLI option has an environment twin, synthesised at runtime
# by `quarkus/runtime/.../configuration/KcEnvConfigSource.java`: any variable
# named `KC_<NAME>` becomes the option `kc.<name>` with `_` mapped to `-`
# (KcEnvConfigSource:88). So `--db-url-host` is `KC_DB_URL_HOST`, and the
# honest key list is the option list, not a grep. New in 26.7: a `KCRAW_`
# prefix for values containing `$` that must not be interpolated, and a
# `KCKEY_` companion for option names that do not survive the mapping
# (KcEnvConfigSource:43-44, 82-85). Setting both `KC_X` and `KCRAW_X` is a
# hard startup failure.
#
# This file covers what the compose sets plus the groups an operator
# actually reaches for: hostname, HTTP/TLS, database, proxy, health and
# metrics, features, logging, cache, and the bootstrap admin. It is NOT the
# full surface. 26.7.3 defines roughly 250 `KC_*` variables (telemetry,
# tracing, syslog, Infinispan sizing, FIPS, vault, truststore, per-datasource
# named keys). The complete, version-pinned list is upstream's "All
# configuration" page linked below; anything on it can be set here by the
# same `KC_` rule.
#
# Two precedence facts that decide whether a value here does anything:
#
#   * Command-line parameters beat environment variables (Configuring
#     Keycloak, "Configuring sources for Keycloak": CLI > env > conf file >
#     keystore). This compose passes `--proxy-headers=xforwarded` and
#     `--hostname-strict=false` on the command line, so KC_PROXY_HEADERS and
#     KC_HOSTNAME_STRICT set here are IGNORED. Both are called out below.
#   * Some options are build-time (health-enabled, metrics-enabled, db,
#     features). The container's entrypoint re-augments automatically when
#     they change, at the cost of a slower first boot after the change.
#
# The image itself bakes `KC_RUN_IN_CONTAINER=true` (quarkus/container/
# Dockerfile:26). That is what makes the HTTP listener bind 0.0.0.0 instead
# of localhost (HttpPropertyMappers.getHttpHost). Do not override it. The
# image exposes 8080 (HTTP), 8443 (HTTPS) and 9000 (management). The compose
# publishes 8080 only. Since 26.5 `curl` is no longer in the container, so a
# healthcheck must not shell out to it.
#
# The compose runs `start` (production mode) against the bundled Postgres and
# prompts for KEYCLOAK_HOSTNAME, KEYCLOAK_ADMIN_PASSWORD and
# POSTGRES_PASSWORD. Nothing else is needed for a first boot.

# @defaultSensitive=false @defaultRequired=infer
# @docs("All configuration options", https://www.keycloak.org/server/all-config)
# ---

# ─── Platform prompt keys ──────────────────────────────────────────────────
# What otterdeploy asks for before the stack is created. Each is threaded by
# the compose into the KC_* variable that actually carries it, further down.

# Public address Keycloak is reached at, e.g. `id.example.com` or a full URL
# with a scheme and path, such as `id.example.com/auth`. Every issuer URL,
# redirect URI check, OIDC discovery document and token `iss` claim is built
# from it, so a wrong value here breaks every client that trusts this
# server. Threaded into KC_HOSTNAME below.
# @required
# @docs("Configuring the hostname (v2)", https://www.keycloak.org/server/hostname)
KEYCLOAK_HOSTNAME=

# Username for the initial (temporary) admin of the `master` realm. Empty
# means the compose substitutes `admin`. This name is ALSO the legacy
# environment variable Keycloak itself still reads as a deprecated fallback
# for the bootstrap admin (QuarkusKeycloakApplication:59, 109). Keycloak logs
# a deprecation warning and points you at KC_BOOTSTRAP_ADMIN_USERNAME, which
# is what the compose sets explicitly.
KEYCLOAK_ADMIN=

# Password for that first admin account. This is the single credential that
# owns the entire identity provider: whoever has it can mint tokens for any
# user, add an identity provider, rewrite client secrets and silently
# impersonate anyone in every application that trusts this Keycloak. A weak,
# reused or default value hands over not just this service but every app
# behind it. Generate it (`openssl rand -base64 32`), never reuse it, and
# replace the temporary admin with a named account after first login.
# `KEYCLOAK_ADMIN_PASSWORD` is also the legacy variable name Keycloak reads
# as a deprecated fallback. Threaded into KC_BOOTSTRAP_ADMIN_PASSWORD.
# @required
# @sensitive
# @docs("Bootstrapping and recovering an admin account", https://www.keycloak.org/server/bootstrap-admin-recovery)
KEYCLOAK_ADMIN_PASSWORD=

# Password for the bundled PostgreSQL's `keycloak` role. The compose puts the
# same value in the database container's POSTGRES_PASSWORD and in
# KC_DB_PASSWORD; the two must stay identical or Keycloak cannot connect.
# Generate with `openssl rand -base64 24`.
# @required
# @sensitive
POSTGRES_PASSWORD=

# ─── Bundled PostgreSQL (service `db`) ─────────────────────────────────────
# Read by the postgres:17-alpine image's own entrypoint, and only on the very
# first boot against an empty data directory. Changing them later renames
# nothing. POSTGRES_PASSWORD is the prompt key declared above.

# Role the entrypoint creates and that Keycloak logs in as. Mirrored by
# KC_DB_USERNAME.
# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=keycloak

# Database the entrypoint creates. It is the database name at the end of
# KC_DB_URL; the two must agree.
POSTGRES_DB=keycloak

# ─── Hostname ──────────────────────────────────────────────────────────────

# Address at which the server is exposed. A bare hostname lets scheme, port
# and context path be resolved from the request; a full URL fixes all of
# them. Set by the compose from KEYCLOAK_HOSTNAME.
# @required
# @docs("Configuring the hostname (v2)", https://www.keycloak.org/server/hostname)
KC_HOSTNAME=${KEYCLOAK_HOSTNAME}

# Separate address for the admin console, when it is exposed through a
# different reverse-proxy hostname than KC_HOSTNAME. Empty means the admin
# console lives at KC_HOSTNAME.
KC_HOSTNAME_ADMIN=

# Whether the hostname is fixed rather than resolved from request headers.
# The option's own default is `true`, and upstream says it should stay `true`
# in production. THIS COMPOSE PASSES `--hostname-strict=false` ON THE COMMAND
# LINE, which outranks this variable, so setting it here has no effect. With
# strict resolution off, Keycloak trusts the incoming Host/X-Forwarded-Host
# header to build issuer and redirect URLs, so an untrusted client that can
# reach the container directly can make it emit links pointing at an attacker
# host. Only acceptable behind a proxy that overwrites Host, which is how
# otterdeploy fronts it; edit the compose's `command:` if you want strict.
# @type=boolean
KC_HOSTNAME_STRICT=

# Resolve backchannel (server-to-server) URLs from the request instead of
# from KC_HOSTNAME. Needed only when applications reach Keycloak over a
# private network address different from the public one; requires KC_HOSTNAME
# to be a full URL.
# @type=boolean
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=false

# Exposes a diagnostic page at /realms/master/hostname-debug that prints how
# every URL was derived. Useful while wiring a proxy; turn it off afterwards.
# @type=boolean
KC_HOSTNAME_DEBUG=false

# ─── HTTP / TLS ────────────────────────────────────────────────────────────

# Enables the plain-HTTP listener. Off by default in production mode; the
# compose sets it to `true` because otterdeploy terminates TLS at its proxy
# and speaks HTTP to the container over the internal network. If you expose
# this container directly, or put an untrusted hop between the proxy and
# Keycloak, plain HTTP means passwords, authorization codes and tokens travel
# in clear text. Terminate TLS in the container instead (see the HTTPS
# options below) and set this back to `false`.
# @type=boolean
# @docs("Configuring TLS", https://www.keycloak.org/server/enabletls)
KC_HTTP_ENABLED=true

# Port the HTTP listener binds. The compose publishes container port 8080
# with no override, so changing this without changing the compose breaks
# routing.
# @type=port
KC_HTTP_PORT=8080

# Interface the HTTP listener binds. Empty is correct here: the image sets
# KC_RUN_IN_CONTAINER, which makes the default 0.0.0.0 so the container
# network can reach it.
KC_HTTP_HOST=

# Path prefix everything is served under. `/auth` reproduces the pre-17
# layout; anything set here must match the path in KC_HOSTNAME.
KC_HTTP_RELATIVE_PATH=/

# Port for the HTTPS listener, used only when a certificate or key store is
# configured below. Not published by this compose.
# @type=port
KC_HTTPS_PORT=8443

# Server certificate (chain) and its private key, both PEM, as paths inside
# the container (mount them in). Setting both makes Keycloak terminate TLS
# itself, which is what you want when the network between the proxy and this
# container is not trusted.
# @docs("Configuring TLS", https://www.keycloak.org/server/enabletls)
KC_HTTPS_CERTIFICATE_FILE=
KC_HTTPS_CERTIFICATE_KEY_FILE=

# Alternative to the PEM pair: one key store (PKCS12/JKS) holding both. The
# password option's upstream default is the literal string `password`, which
# is only ever right for a throwaway store. Set a real one whenever you
# point at a real key store.
KC_HTTPS_KEY_STORE_FILE=
# @sensitive
KC_HTTPS_KEY_STORE_PASSWORD=

# ─── Reverse proxy ─────────────────────────────────────────────────────────

# Which forwarding headers to honour: `forwarded` (RFC 7239) or `xforwarded`
# (X-Forwarded-*). THIS COMPOSE PASSES `--proxy-headers=xforwarded` on the
# command line, which outranks this variable. Never enable a header family
# your proxy does not itself overwrite: if clients can set X-Forwarded-For or
# X-Forwarded-Proto, they can forge the client IP that brute-force detection
# and event logs record, and convince Keycloak it is on HTTPS when it is not.
# @type=enum(forwarded, xforwarded)
# @docs("Using a reverse proxy", https://www.keycloak.org/server/reverseproxy)
KC_PROXY_HEADERS=

# Comma-separated IPs or CIDRs whose forwarding headers are trusted; headers
# from any other source are ignored. Empty means every address is trusted,
# which is only safe when nothing but the proxy can open a connection to this
# container. Set it to your proxy's address if the container port is reachable
# more widely.
KC_PROXY_TRUSTED_ADDRESSES=

# Accept the HAProxy PROXY protocol instead of forwarding headers. Mutually
# exclusive with KC_PROXY_HEADERS: enabling both is a startup error.
# @type=boolean
KC_PROXY_PROTOCOL_ENABLED=false

# ─── Database ──────────────────────────────────────────────────────────────

# Database vendor. The compose runs the bundled PostgreSQL, so `postgres`.
# The option's own default, `dev-file`, is an embedded H2 file store that is
# deprecated in production mode and loses data on container replacement.
# Build-time: changing it re-augments the image on next boot.
# @required
# @type=enum(dev-file, dev-mem, mariadb, mssql, mysql, oracle, postgres)
# @docs("Configuring the database", https://www.keycloak.org/server/db)
KC_DB=postgres

# Full JDBC URL. Platform-owned: points at the bundled `db` service, and its
# database name must match POSTGRES_DB. When set, the KC_DB_URL_HOST /
# _PORT / _DATABASE parts are ignored.
# @required
KC_DB_URL=jdbc:postgresql://${{stack.db.HOST}}:5432/keycloak

# Database user. Must match the bundled Postgres's POSTGRES_USER.
# @required
KC_DB_USERNAME=keycloak

# Password for that user. Set by the compose from POSTGRES_PASSWORD.
# @required
# @sensitive
KC_DB_PASSWORD=${POSTGRES_PASSWORD}

# Schema Keycloak's tables live in. Empty uses the driver's default
# (`public` on PostgreSQL).
KC_DB_SCHEMA=

# Connection pool sizing. Empty initial/min sizes let Agroal grow on demand;
# 100 is the upstream maximum. The pool bounds how many requests can touch
# the database at once, so raising it without raising Postgres's own
# max_connections just moves the failure.
# @type=number
KC_DB_POOL_INITIAL_SIZE=
# @type=number
KC_DB_POOL_MIN_SIZE=
# @type=number
KC_DB_POOL_MAX_SIZE=100

# Use XA (two-phase commit) transactions. Only relevant when a custom
# provider enlists a second resource; leave off for a single database.
# @type=boolean
KC_TRANSACTION_XA_ENABLED=false

# ─── Bootstrap admin ───────────────────────────────────────────────────────
# These create the FIRST administrator of the `master` realm, and only when
# that realm does not yet exist (QuarkusKeycloakApplication.createTemporaryAdmin).
# The account they create is the root of trust for every realm, client and
# user on this server.

# Username of the temporary admin. Set by the compose from KEYCLOAK_ADMIN,
# defaulting to `admin`; the option's own default is `temp-admin`. A
# predictable username plus a weak KC_BOOTSTRAP_ADMIN_PASSWORD is a complete
# takeover of the identity provider and of every application that trusts it,
# so treat the pair as one credential.
# @required
# @docs("Bootstrapping and recovering an admin account", https://www.keycloak.org/server/bootstrap-admin-recovery)
KC_BOOTSTRAP_ADMIN_USERNAME=${KEYCLOAK_ADMIN:-admin}

# Password of the temporary admin. Set by the compose from
# KEYCLOAK_ADMIN_PASSWORD. There is no rate limit on the admin console before
# you configure one, and this account can read and rewrite every realm: a
# guessable value here is the whole identity provider. Log in once, create a
# named admin, then delete the temporary account.
# @required
# @sensitive
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Instead of (or besides) a human admin, bootstrap a service account for
# automation. The secret is a full-privilege client credential with the same
# blast radius as the admin password. Empty leaves no service account; the
# client id's own default is `temp-admin`.
KC_BOOTSTRAP_ADMIN_CLIENT_ID=
# @sensitive
KC_BOOTSTRAP_ADMIN_CLIENT_SECRET=

# ─── Health, metrics and the management interface ──────────────────────────

# Exposes /health, /health/ready and /health/live. Off by default; enable it
# if you want container or proxy health checks (note `curl` was removed from
# the image in 26.5, so probe over HTTP rather than shelling out). Build-time.
# Since 26.7 the HTTP and management ports open while startup is still in
# progress when this is on. Set KC_SERVER_ASYNC_BOOTSTRAP=false for the old
# behaviour.
# @type=boolean
# @docs("Configuring health checks", https://www.keycloak.org/server/health)
KC_HEALTH_ENABLED=false

# Exposes Prometheus metrics at /metrics. Off by default. Build-time.
# @type=boolean
# @docs("Enabling Keycloak metrics", https://www.keycloak.org/observability/configuration-metrics)
KC_METRICS_ENABLED=false

# Health and metrics are served on a separate management listener, port 9000,
# which this compose does not publish. That is the point: they stay on the
# internal network. Publish 9000 only to a scrape target you trust.
# @type=port
# @docs("Configuring the management interface", https://www.keycloak.org/server/management-interface)
KC_HTTP_MANAGEMENT_PORT=9000

# Path prefix on that management listener.
KC_HTTP_MANAGEMENT_RELATIVE_PATH=/

# Moves health and metrics back onto the main HTTP port and disables the
# management interface. Upstream advises against it: it puts unauthenticated
# operational endpoints on the same port the public internet reaches.
# @type=boolean
KC_LEGACY_OBSERVABILITY_INTERFACE=false

# ─── Features ──────────────────────────────────────────────────────────────

# Comma-separated preview/disabled-by-default features to switch on, e.g.
# `token-exchange,admin-fine-grained-authz`, optionally version-pinned
# (`admin-fine-grained-authz:v2`). Preview features are not covered by the
# same support and hardening guarantees as supported ones. Build-time.
# @docs("Enabling and disabling features", https://www.keycloak.org/server/features)
KC_FEATURES=

# Comma-separated default-on features to switch off. The smaller the enabled
# surface, the smaller the attack surface. Build-time.
KC_FEATURES_DISABLED=

# ─── Logging ───────────────────────────────────────────────────────────────

# Where log records go: any of `console`, `file`, `syslog` (comma-separated).
# The compose keeps the default so records land on stdout for the platform's
# log viewer.
# @docs("Configuring logging", https://www.keycloak.org/server/logging)
KC_LOG=console

# Root log level. Per-category overrides use the same option with a suffix,
# e.g. `KC_LOG_LEVEL_ORG_KEYCLOAK_EVENTS=debug`. `debug` on a public server
# writes request detail to logs, so keep it short-lived.
# @type=enum(off, fatal, error, warn, info, debug, trace, all)
KC_LOG_LEVEL=info

# Console record format. `json` emits structured records for a log pipeline.
# @type=enum(default, json)
KC_LOG_CONSOLE_OUTPUT=default

# ─── Cache ─────────────────────────────────────────────────────────────────

# Session/authentication cache mechanism. `ispn` (embedded Infinispan, the
# default under `start`) is what allows more than one replica to share
# sessions; `local` is single-node only and is the default under `start-dev`.
# @type=enum(ispn, local)
# @docs("Configuring distributed caches", https://www.keycloak.org/server/caching)
KC_CACHE=

# JGroups discovery stack for the embedded cache when running more than one
# replica. Empty uses `jdbc-ping`, which discovers peers through the database
# and needs no extra network configuration.
KC_CACHE_STACK=

# ─── Security misc ─────────────────────────────────────────────────────────

# Comma-separated paths (files or directories) of PEM/PKCS12 certificates
# added to the truststore Keycloak uses for outbound TLS: LDAP servers,
# identity providers, SMTP. Without them a private CA is rejected, and the
# fix is to add the CA here, never to disable verification.
# @docs("Configuring trusted certificates", https://www.keycloak.org/server/keycloak-truststore)
KC_TRUSTSTORE_PATHS=

# Java KeyStore holding sensitive options (kc.db-password and friends) so
# they never appear in the environment. The keystore's own password still
# has to be supplied, so this only helps if that one is injected differently
# from the values it protects.
KC_CONFIG_KEYSTORE=
# @sensitive
KC_CONFIG_KEYSTORE_PASSWORD=
