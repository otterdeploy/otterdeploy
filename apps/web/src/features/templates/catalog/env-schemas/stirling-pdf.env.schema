# Stirling PDF 2.14.3 environment schema (@env-spec / varlock format).
#
# The compose used to float on `ghcr.io/stirling-tools/stirling-pdf:latest`;
# it now pins 2.14.3. On the 2026-09-04 research date `latest`, `2.14.3` and
# the newest GitHub release (v2.14.3, 2026-08-06) all resolved to the same
# index digest sha256:3b3670fce70b396ec56ba380a3cc7858e0abf83fe13f31c88f7737847763a396
# (image config created 2026-08-06), so the pin is a no-op today and only
# stops the drift. The repo is actively maintained: 2.13.x and 2.14.x shipped
# in the eight weeks before that date.
#
# Stirling publishes three image variants per release: plain (`2.14.3`,
# `latest`), `-fat` (Calibre + extra conversion tooling baked in) and
# `-ultra-lite`. This template runs the PLAIN variant. That matters for
# security: only `-ultra-lite` is built without the authentication module.
#
# Source: settings.yml.template, ApplicationProperties.java, InitialSecuritySetup.java,
# application.properties and the container entrypoint (scripts/init.sh →
# scripts/init-without-ocr.sh) at tag v2.14.3, cross-checked against
# docs.stirlingpdf.com/Configuration.
#
# THESE NAMES ARE A PROJECTION, NOT A NATIVE ENV SURFACE. Stirling PDF is
# Java/Spring Boot: the real configuration file is /configs/settings.yml (the
# /configs volume), created from settings.yml.template on first start. Every
# key below except the few marked "env-only" is a settings.yml YAML path read
# through Spring's relaxed binding, where dots become underscores and
# camelCase words run together, so `security.initialLogin.username` is
# SECURITY_INITIALLOGIN_USERNAME and `processExecutor.sessionLimit.libreOfficeSessionLimit`
# is PROCESSEXECUTOR_SESSIONLIMIT_LIBREOFFICESESSIONLIMIT. The template's own
# header states the convention; the docs spell out the same examples. An
# environment variable wins over the value in settings.yml, but the file is
# still rewritten from the template on upgrade, so treat env as the source of
# truth for anything you care about.
#
# SECURITY: the honest picture at 2.14.3, which is NOT the v1 picture:
#  * Login is ON by default on this variant. settings.yml.template ships
#    `security.enableLogin: true`, and the auth module is compiled into every
#    image except `-ultra-lite`. First start creates a **published default
#    admin account, `admin` / `stirling`**, flagged firstLogin so the UI
#    prompts for a change (InitialSecuritySetup.createDefaultAdminUser). That
#    prompt is a prompt, not a wall. Change it immediately, or bootstrap your
#    own admin with SECURITY_INITIALLOGIN_USERNAME / _PASSWORD before first boot.
#  * Set SECURITY_ENABLELOGIN=false and the instance becomes fully
#    unauthenticated: anyone who can reach port 8080 can upload documents, run
#    every tool, and call the whole /api/v1 surface, with X-Frame-Options
#    forced to DISABLED. Only do that behind your own auth proxy.
#  * SECURITY_CUSTOMGLOBALAPIKEY mints a permanent CUSTOM_API_USER whose
#    X-API-KEY bypasses interactive login for the entire REST API.
#  * SYSTEM_CORSALLOWEDORIGINS empty (the default) does NOT disable CORS; it
#    falls back to allowing ALL origins with credentials.
#  * MCP_ENABLED exposes Stirling's tools to MCP clients; MCP_AUTH_MODE=apikey
#    reduces that to a shared header.
#  * SYSTEM_ENABLEURLTOPDF is documented upstream as "INTERNAL ONLY, known
#    security issues"; SYSTEM_DISABLESANITIZE turns off HTML sanitisation;
#    POLICIES_ALLOWEDFOLDERROOTS hands folder automations host paths.
#  * The compose's DISABLE_ADDITIONAL_FEATURES="true" does NOT turn auth off
#    here. See its note below. Do not read it as a security setting.
#
# The compose sets no secret and prompts for nothing: out of the box Stirling
# PDF needs no environment at all. Everything below is optional hardening or
# integration, and every default shown is the value settings.yml.template (or
# the image/entrypoint) ships at 2.14.3.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Stirling PDF configuration reference", https://docs.stirlingpdf.com/Configuration/)
# ---

# ─── Set by this compose (both inert at v2) ──────────────────────────────

# A v1 leftover this template still carries. In v2 it is a **Gradle build-time
# flavour switch** (settings.gradle / build.gradle: core vs proprietary vs
# saas), not a runtime setting. Nothing in the running application reads it.
# The published plain image is built with STIRLING_FLAVOR=proprietary, so the
# login/SSO/audit module is present regardless of what this says. The only
# runtime code that touches a similar name is PostHog telemetry, and it reads
# a different variable (ADDITIONAL_FEATURES_OFF). Setting it to "false" would
# not add anything either; to get a build without those features you pull the
# `-ultra-lite` tag instead.
# @type=boolean
# @docs("V1 → V2 settings changes", https://docs.stirlingpdf.com/Migration/Settings-Changes/)
DISABLE_ADDITIONAL_FEATURES=true

# Also a v1 leftover. It was the language list handed to the Alpine
# font-installer (scripts/installFonts.sh, `apk add font-*`). The v2 image is
# Debian-based and its entrypoint never calls that script, so this value has
# no effect. Use SYSTEM_DEFAULTLOCALE for the UI language and UI_LANGUAGES to
# restrict the picker.
LANGS=en_GB

# ─── Server and addressing ───────────────────────────────────────────────

# Port the embedded Jetty server listens on (Spring Boot's own `server.port`).
# The compose exposes container port 8080 with no override, so this is that
# port's twin: change it here without changing the exposed port and routing
# breaks.
# @type=port
# @docs("Docker install", https://docs.stirlingpdf.com/Installation/Docker%20Install/)
SERVER_PORT=8080

# Servlet context path (`server.servlet.context-path`), for serving Stirling
# under a sub-path of a reverse proxy, e.g. `/pdf`. Must start with `/`.
# Upstream's own healthcheck interpolates this variable, so a custom value has
# to be reflected in any healthcheck you add.
SYSTEM_ROOTURIPATH=/

# Public base URL of THIS backend (`system.backendUrl`). Required for SSO to
# work: it is where the IdP posts SAML responses and OAuth callbacks, and what
# the SP metadata document advertises. Empty falls back to
# http://localhost:8080, which is wrong for anything but local dev.
# @type=url
SYSTEM_BACKENDURL=

# Public URL users reach the app on (`system.frontendUrl`), used to build
# invite-email links, share links and the mobile-scanner QR payload. Falls
# back to SYSTEM_BACKENDURL when empty.
# @type=url
SYSTEM_FRONTENDURL=

# Force a UI language for users who have not picked one (`system.defaultLocale`),
# e.g. `en-US`, `de-DE`. Empty auto-detects from the browser and falls back to
# en-US. This is the v2 replacement for the compose's dead LANGS.
SYSTEM_DEFAULTLOCALE=

# Allowed browser origins (`system.corsAllowedOrigins`), comma-separated, e.g.
# `https://pdf.example.com,https://intranet.example.com`. WARNING: empty is
# not "CORS off"; it falls back to allowing every origin, with credentials.
# Set it explicitly for any instance reachable from a browser you do not own.
SYSTEM_CORSALLOWEDORIGINS=

# `true` serves an allow-all /robots.txt (`system.googlevisibility`); `false`
# serves disallow-all so the instance stays out of search engines. Leave false
# for a private deployment, since an indexed PDF tool attracts uploads.
# @type=boolean
SYSTEM_GOOGLEVISIBILITY=false

# ─── Authentication ──────────────────────────────────────────────────────

# Master auth switch (`security.enableLogin`). settings.yml.template ships
# `true`, and this image has the auth module compiled in, so the default here
# is login REQUIRED. Setting it to false leaves every tool and every
# /api/v1 endpoint open to anyone who reaches the port, and additionally
# forces X-Frame-Options off. Changing it takes effect on restart.
# @type=boolean
# @docs("System and security settings", https://docs.stirlingpdf.com/Configuration/Security/System%20and%20Security/)
SECURITY_ENABLELOGIN=true

# Bootstrap admin account, consumed once by InitialSecuritySetup when the user
# table is empty (`security.initialLogin.username` / `.password`). Set BOTH or
# neither: with both set Stirling creates that ADMIN user with firstLogin
# cleared; with either missing it falls back to the well-known default pair
# `admin` / `stirling` and only nudges you to change it. Editing these after
# the first boot does nothing, because the H2 database under /configs already
# has the account.
SECURITY_INITIALLOGIN_USERNAME=
# @sensitive
SECURITY_INITIALLOGIN_PASSWORD=

# Which sign-in paths are offered (`security.loginMethod`). `normal` is
# username/password only, `oauth2` / `saml2` hide the local form entirely,
# which is useful once SSO works, so nobody can fall back to a local password.
# @type=enum(all, normal, oauth2, saml2)
SECURITY_LOGINMETHOD=all

# Failed-attempt lockout (`security.loginAttemptCount`,
# `security.loginResetTimeMinutes`): lock an account after N tries, for M
# minutes. Set the count to -1 to disable the built-in lockout when you are
# handling brute force with fail2ban instead.
# @type=number
# @docs("fail2ban integration", https://docs.stirlingpdf.com/Configuration/Security/fail2ban/)
SECURITY_LOGINATTEMPTCOUNT=5
# @type=number
SECURITY_LOGINRESETTIMEMINUTES=120

# A static, never-expiring API key (`security.customGlobalAPIKey`). On startup
# Stirling creates/updates a CUSTOM_API_USER holding it, and that key
# authenticates the whole REST API through the X-API-KEY header: no login, no
# per-user attribution, no rotation unless you rotate this value. Leave empty
# and issue per-user keys from the UI instead unless you specifically need a
# machine credential.
# @sensitive
# @docs("API access", https://docs.stirlingpdf.com/API/)
SECURITY_CUSTOMGLOBALAPIKEY=

# X-Frame-Options header (`security.xFrameOptions`). Note the app forces
# DISABLED whenever login is off, so this only bites on an authenticated
# instance.
# @type=enum(DENY, SAMEORIGIN, DISABLED)
SECURITY_XFRAMEOPTIONS=DENY

# When login is disabled, `false` hides the settings button in the UI
# (`system.showSettingsWhenNoLogin`). It hides a button, it does not add
# authorization, and the underlying endpoints stay reachable.
# @type=boolean
SYSTEM_SHOWSETTINGSWHENNOLOGIN=true

# Lifetime of the web session JWT in minutes (`security.jwt.tokenExpiryMinutes`).
# Upstream marks the JWT block as still under development at this version.
# @type=number
SECURITY_JWT_TOKENEXPIRYMINUTES=1440

# ─── Single sign-on (OIDC / OAuth2) ──────────────────────────────────────

# Generic OIDC provider (`security.oauth2.*`). Requires SECURITY_ENABLELOGIN=true
# and a correct SYSTEM_BACKENDURL or the callback lands on localhost. The
# issuer is the discovery URL; Stirling reads /.well-known/openid-configuration
# from it. Named provider blocks also exist for Keycloak, Google and GitHub
# (SECURITY_OAUTH2_CLIENT_KEYCLOAK_CLIENTID and friends) if you prefer those.
# @type=boolean
# @docs("OAuth SSO configuration", https://docs.stirlingpdf.com/Configuration/Security/OAuth%20SSO%20Configuration/)
SECURITY_OAUTH2_ENABLED=false
# @type=url
SECURITY_OAUTH2_ISSUER=
SECURITY_OAUTH2_CLIENTID=
# @sensitive
SECURITY_OAUTH2_CLIENTSECRET=

# Display/name of the provider, the scopes requested, and the claim used as
# the Stirling username (`security.oauth2.provider` / `.scopes` / `.useAsUsername`).
SECURITY_OAUTH2_PROVIDER=google
SECURITY_OAUTH2_SCOPES=openid, profile, email
SECURITY_OAUTH2_USEASUSERNAME=email

# Whether an unknown SSO subject gets an account created on the fly
# (`security.oauth2.autoCreateUser`), and whether SSO logins are refused until
# an admin has pre-registered the user (`.blockRegistration`). Leaving
# autoCreateUser true on a public IdP means anyone in that IdP gets an account.
# @type=boolean
SECURITY_OAUTH2_AUTOCREATEUSER=true
# @type=boolean
SECURITY_OAUTH2_BLOCKREGISTRATION=false

# SAML2 (`security.saml2.enabled`). Only functional for paid enterprise
# licences. It also needs premium.enabled and a licence key, so on a plain
# self-host this stays false.
# @type=boolean
# @docs("Single sign-on configuration", https://docs.stirlingpdf.com/Configuration/Security/Single%20Sign-On%20Configuration/)
SECURITY_SAML2_ENABLED=false

# ─── Exposed surface: endpoints, MCP, SSRF guards ────────────────────────

# `metrics.enabled` gates the informational /api/v1/info/* endpoints (the
# health/status probe upstream's own healthcheck curls). Turn it off and you
# lose that probe.
# @type=boolean
# @docs("Endpoint and feature customisation", https://docs.stirlingpdf.com/Configuration/Customisation/Endpoint%20or%20Feature%20Customisation/)
METRICS_ENABLED=true

# Disable individual tools or whole groups (`endpoints.toRemove`,
# `endpoints.groupsToRemove`), comma-separated, e.g.
# `img-to-pdf,remove-pages` and `LibreOffice,DeveloperTools,Automation`. This
# is the blunt instrument for shrinking what an unauthenticated or
# lightly-trusted user can reach.
ENDPOINTS_TOREMOVE=
ENDPOINTS_GROUPSTOREMOVE=

# URL-to-PDF conversion (`system.enableUrlToPDF`). settings.yml.template marks
# it "INTERNAL ONLY, known security issues, should not be used externally",
# because it fetches arbitrary URLs from inside your network. Leave false
# unless the instance is isolated.
# @type=boolean
# @docs("SSRF protection", https://docs.stirlingpdf.com/Configuration/Security/SSRF-Protection/)
SYSTEM_ENABLEURLTOPDF=false

# `true` turns OFF HTML sanitisation (`system.disableSanitize`), which the
# template warns "can lead to injections in HTML". Only flip it if you fully
# trust every uploader.
# @type=boolean
SYSTEM_DISABLESANITIZE=false

# The SSRF guard applied when Stirling fetches remote resources for HTML
# processing (`system.html.urlSecurity.*`). MEDIUM blocks RFC1918, loopback,
# link-local and cloud metadata (169.254.169.254); MAX is allow-list only
# (SYSTEM_HTML_URLSECURITY_ALLOWEDDOMAINS); OFF removes all restrictions.
# @type=boolean
SYSTEM_HTML_URLSECURITY_ENABLED=true
# @type=enum(MAX, MEDIUM, OFF)
SYSTEM_HTML_URLSECURITY_LEVEL=MEDIUM

# Absolute host directories folder automations may read from and write to
# (`policies.allowedFolderRoots`), comma-separated. Empty (the default)
# disables folder sources and outputs entirely, which is the safe setting;
# anything you list here becomes reachable from a saved automation.
# @docs("Folder scanning", https://docs.stirlingpdf.com/Configuration/Storage/Folder%20Scanning/)
POLICIES_ALLOWEDFOLDERROOTS=

# MCP server (`mcp.*`): exposes Stirling's PDF tools to MCP clients over a
# /mcp endpoint. Off by default and worth leaving off. Turning it on adds a
# second, machine-facing entry point to every tool. `oauth` validates tokens
# against an external IdP (issuer URI and an RFC 8707 resource id are
# required); `apikey` accepts a Stirling per-user API key in X-API-KEY, which
# is lower friction and correspondingly weaker.
# @type=boolean
# @docs("MCP server", https://docs.stirlingpdf.com/Configuration/Automation/MCP%20Server/)
MCP_ENABLED=false
# @type=enum(oauth, apikey)
MCP_AUTH_MODE=oauth
# @type=url
MCP_AUTH_ISSUERURI=
MCP_AUTH_RESOURCEID=

# ─── Upload limits and timeouts ──────────────────────────────────────────

# Per-file upload cap (`system.fileUploadLimit`), a number 0-999 followed by
# KB / MB / GB, e.g. `100MB`. Empty means no Stirling-level limit, and the
# Spring multipart caps below apply instead.
# @docs("Extra settings", https://docs.stirlingpdf.com/Configuration/Customisation/Extra-Settings/)
SYSTEM_FILEUPLOADLIMIT=

# Two env-only aliases for the same limit, read directly by
# ApplicationProperties before settings.yml is consulted:
# SYSTEMFILEUPLOADLIMIT takes the full form ("100MB"), SYSTEM_MAXFILESIZE takes
# a bare number of megabytes between 1 and 999 (out-of-range values are logged
# and ignored). SYSTEMFILEUPLOADLIMIT wins if both are set.
SYSTEMFILEUPLOADLIMIT=
# @type=number
SYSTEM_MAXFILESIZE=

# Hard servlet-level multipart ceilings (`spring.servlet.multipart.*`). These
# are the outer bound: a request larger than this is rejected by Jetty before
# Stirling sees it, whatever the limits above say.
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=2000MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=2000MB

# Async request timeout in milliseconds (`spring.mvc.async.request-timeout`),
# 20 minutes by default. Raise it if large OCR or LibreOffice jobs are being
# cut off mid-conversion.
# @type=number
SYSTEM_CONNECTIONTIMEOUTMILLISECONDS=1200000

# Maximum DPI accepted for PDF→image conversion (`system.maxDPI`). A cap on
# how much memory one request can ask for.
# @type=number
SYSTEM_MAXDPI=500

# ─── Conversion workers and process limits ───────────────────────────────

# How many concurrent sessions each external tool gets
# (`processExecutor.sessionLimit.*`) and how long a LibreOffice conversion may
# run (`processExecutor.timeoutMinutes.*`). Each extra LibreOffice session
# costs roughly 50MB of idle RAM; raise it only if you have the memory and are
# seeing conversions queue.
# @type=number
# @docs("Process limits", https://docs.stirlingpdf.com/Configuration/Operations/Process-Limits/)
PROCESSEXECUTOR_SESSIONLIMIT_LIBREOFFICESESSIONLIMIT=1
# @type=number
PROCESSEXECUTOR_SESSIONLIMIT_TESSERACTSESSIONLIMIT=1
# @type=number
PROCESSEXECUTOR_SESSIONLIMIT_GHOSTSCRIPTSESSIONLIMIT=8
# @type=number
PROCESSEXECUTOR_TIMEOUTMINUTES_LIBREOFFICETIMEOUTMINUTES=30

# Entrypoint-only aliases, read by scripts/init-without-ocr.sh before it
# consults settings.yml, and used to decide how many unoserver processes to
# start alongside the JVM. Empty means "follow the settings.yml values above".
UNO_SERVER_AUTO=
# @type=number
UNO_SERVER_COUNT=
# @type=number
UNO_SERVER_CONVERSION_TIMEOUT_MINUTES=
# @type=number
UNO_SERVER_HEALTH_INTERVAL=30

# ─── External database (Pro/Enterprise) ──────────────────────────────────

# By default Stirling keeps users, settings and job metadata in an embedded H2
# file under /configs (the stirling-configs volume), so the volume IS the
# database. Back it up accordingly. `system.datasource.enableCustomDatabase`
# switches to an external Postgres and is gated to enterprise licences at this
# version. Set the URL form or the host/port/name form, not both.
# @type=boolean
# @docs("External database", https://docs.stirlingpdf.com/Configuration/Storage/External%20Database/)
SYSTEM_DATASOURCE_ENABLECUSTOMDATABASE=false
SYSTEM_DATASOURCE_CUSTOMDATABASEURL=
# @type=enum(h2, postgresql)
SYSTEM_DATASOURCE_TYPE=postgresql
SYSTEM_DATASOURCE_HOSTNAME=
# @type=port
SYSTEM_DATASOURCE_PORT=5432
SYSTEM_DATASOURCE_NAME=
# Credentials for that external database. settings.yml.template ships the
# placeholder pair postgres/postgres; supply real ones.
SYSTEM_DATASOURCE_USERNAME=
# @sensitive
SYSTEM_DATASOURCE_PASSWORD=

# Server-side file storage for logged-in users (`storage.*`), marked ALPHA
# upstream. Requires SECURITY_ENABLELOGIN=true; the `database` and `s3`
# providers additionally require a Pro/Enterprise licence. Off means files
# live only in the browser session and the temp directory.
# @type=boolean
# @docs("File sharing and storage", https://docs.stirlingpdf.com/Configuration/Storage/File-Sharing-Storage/)
STORAGE_ENABLED=false
# @type=enum(local, database, s3)
STORAGE_PROVIDER=local

# ─── Outbound mail ───────────────────────────────────────────────────────

# SMTP (`mail.*`), used for user invites and share-by-email. Nothing is sent
# until MAIL_ENABLED=true, and invites additionally need
# SECURITY_ENABLELOGIN=true. settings.yml.template ships the placeholder host
# smtp.example.com; the key below is left empty because it is yours to supply.
# @type=boolean
MAIL_ENABLED=false
MAIL_HOST=
# @type=port
MAIL_PORT=587
MAIL_USERNAME=
# @sensitive
MAIL_PASSWORD=
# @type=email
MAIL_FROM=
# STARTTLS on port 587; set MAIL_SSLENABLE=true instead for implicit TLS on 465.
# @type=boolean
MAIL_STARTTLSENABLE=true

# ─── Telemetry ───────────────────────────────────────────────────────────

# Master analytics toggle (`system.enableAnalytics`). It is deliberately
# tri-state: `true` on, `false` off, and empty/null means the app asks an admin
# on first launch. The two sub-toggles (PostHog product analytics, the Scarf
# tracking pixel) follow the master unless set explicitly. Set false on any
# instance where phoning home is not acceptable.
# @docs("Analytics and telemetry", https://docs.stirlingpdf.com/analytics-telemetry/)
SYSTEM_ENABLEANALYTICS=
SYSTEM_ENABLEPOSTHOG=
SYSTEM_ENABLESCARF=

# Env-only, read straight from the environment by UIDataController: `true`
# shows the in-app user survey. Empty leaves it off.
SHOW_SURVEY=

# Whether the UI advertises new upstream releases (`system.showUpdate`). It
# reaches out to check.
# @type=boolean
SYSTEM_SHOWUPDATE=true

# ─── Container runtime and JVM ───────────────────────────────────────────

# UID/GID the application drops to, and the umask applied to files it writes
# (image defaults 1000/1000/022, applied by the entrypoint). Match these to
# the owner of the mounted volumes if you bind-mount host paths instead of
# using the named volumes.
# @type=number
# @docs("Path structure and permissions", https://docs.stirlingpdf.com/Installation/Path%20Structure/)
PUID=1000
# @type=number
PGID=1000
UMASK=022

# JVM tuning. The profile picks the GC preset baked into the image:
# `balanced` is G1GC, `performance` is generational Shenandoah (and silently
# falls back to balanced on images that lack it). Heap sizing is computed from
# the container memory limit, so prefer setting the container limit over
# hand-writing -Xmx. JAVA_BASE_OPTS replaces the profile wholesale;
# JAVA_CUSTOM_OPTS is appended after it.
# @type=enum(balanced, performance)
# @docs("Performance optimization", https://docs.stirlingpdf.com/Configuration/Operations/Performance-Optimization/)
STIRLING_JVM_PROFILE=balanced
JAVA_BASE_OPTS=
JAVA_CUSTOM_OPTS=

# Ahead-of-time class cache. Off in the image; enabling it trades a slower
# first boot (a training run) for faster subsequent starts, and writes its
# cache into /configs.
# @type=boolean
STIRLING_AOT_ENABLE=false

# Where the entrypoint and the app expect settings.yml. It lives on the
# stirling-configs volume; move it and the volume no longer covers your
# configuration.
CONFIG_FILE=/configs/settings.yml

# Scratch space for conversions (image default, also exported as TMPDIR). It
# is NOT one of the compose's named volumes, so it lives in the container's
# writable layer. Point it at a mounted path if you process files large
# enough to matter.
STIRLING_TEMPFILES_DIRECTORY=/tmp/stirling-pdf
