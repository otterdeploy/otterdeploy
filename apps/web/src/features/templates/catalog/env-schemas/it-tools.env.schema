# IT Tools 2024.10.22-7ca5933 — environment schema (@env-spec / varlock format).
#
# The compose pins corentinth/it-tools:latest. On 2024-08-29 (research date)
# that tag shares its digest with 2024.10.22-7ca5933, the newest GitHub
# release (v2024.10.22-7ca5933); only `nightly` is newer.
#
# Source: grep of process.env / import.meta.env across the v2024.10.22-7ca5933
# tarball. IT Tools is a static Vite/Vue SPA copied into nginx:stable-alpine
# (NGINX_VERSION=1.26.2 in the published image config). The app reads NO
# environment at runtime: the only process.env reads are in vite.config.ts
# (BASE_URL, baked in at image build and not overridable here) and the
# playwright config. What the running container DOES honor is the nginx
# image's /docker-entrypoint.d scripts, taken from nginx/docker-nginx at
# 1.26.1 (identical to 1.27.2 apart from a whitespace trim). Those are the
# only items below. Upstream documents none of this; its README is one
# `docker run` line.
#
# Nothing here is required. An empty environment is the supported install.

# @defaultSensitive=false @defaultRequired=infer
# @docs("IT Tools repository", https://github.com/CorentinTh/it-tools)
# ---

# ─── nginx entrypoint ─────────────────────────────────────────────────────
# Knobs read by the base image's /docker-entrypoint.sh before nginx starts.
# The three NGINX_ENTRYPOINT_* switches are tested with `[ -n "$VAR" ]`: ANY
# non-empty value turns them on, so "false" also enables them. Leave empty
# to keep the default off.

# Silences the entrypoint's own "Launching ..." / "Configuration complete"
# lines. nginx's access and error logs are unaffected.
# @docs("nginx image environment reference", https://hub.docker.com/_/nginx)
NGINX_ENTRYPOINT_QUIET_LOGS=

# Rewrites `worker_processes` in nginx.conf to match the container's CPU
# quota/cpuset instead of nginx's default of 1. Harmless for a static site.
NGINX_ENTRYPOINT_WORKER_PROCESSES_AUTOTUNE=

# Exports NGINX_LOCAL_RESOLVERS (the nameservers from /etc/resolv.conf) for
# use in envsubst templates. The shipped config has no template, so this
# does nothing unless you mount one.
NGINX_ENTRYPOINT_LOCAL_RESOLVERS=

# envsubst templating. At boot every *.template under the template dir is
# rendered to the output dir. The shipped server block is copied to
# /etc/nginx/conf.d/default.conf at build, so a mounted
# default.conf.template REPLACES it: keep `root /usr/share/nginx/html` and
# the `try_files ... /index.html` fallback or deep links 404.
NGINX_ENVSUBST_TEMPLATE_DIR=/etc/nginx/templates
NGINX_ENVSUBST_TEMPLATE_SUFFIX=.template
NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d

# Same for stream (TCP/UDP) templates; a stream block is appended to
# nginx.conf when one is found. Not something a static site needs.
NGINX_ENVSUBST_STREAM_TEMPLATE_SUFFIX=.stream-template
NGINX_ENVSUBST_STREAM_OUTPUT_DIR=/etc/nginx/stream-conf.d

# Regex (awk syntax) restricting which environment variable names envsubst
# is allowed to substitute. Empty means every variable in the environment.
NGINX_ENVSUBST_FILTER=
