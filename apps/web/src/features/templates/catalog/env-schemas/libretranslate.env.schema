# LibreTranslate 1.9.6 environment schema (@env-spec / varlock format).
#
# The template previously ran libretranslate/libretranslate:latest. On
# 2026-09-04 (research date) `latest` (digest sha256:7e7b72b0…) was a build of
# `main` pushed 2026-09-03, NOT any tagged release. The newest stable tag is
# v1.9.6 (2026-05-26, digest sha256:1de2d705…), so the compose now pins
# v1.9.6. Nothing on `main` since v1.9.6 is a security fix (UI translations,
# `--trust-forwarded-for`, a configurable gunicorn `LT_TIMEOUT`, and a CI
# action pin), so the matured tag wins. The repo is actively maintained:
# 41 tagged releases, seven of them in 2026.
#
# Source: libretranslate/default_values.py at v1.9.6. LibreTranslate is
# Python/Flask and has NO hand-written env handling: `_default_options_objects`
# in that file lists every CLI option, and
# `DEFAULT_ARGUMENTS = {obj['name']: _get_value(**obj) ...}` builds each
# argparse default by reading `os.environ['LT_' + name]` (`_prefix = 'LT_'`)
# with a str/int/bool coercion. libretranslate/main.py then feeds DEFARGS into
# every `parser.add_argument(...)`. So the env surface is exactly the 41
# entries in that list, one LT_* twin per `--flag`, and nothing else. Booleans
# accept TRUE/True/true/1 and FALSE/False/false/0; anything else falls back to
# the default. Ints that do not parse silently fall back too.
#
# scripts/entrypoint.sh is the image ENTRYPOINT: it re-reads LT_HOST/LT_PORT/
# LT_THREADS after the model boot pass and execs gunicorn with
# `--workers $LT_THREADS --bind $BIND_ADDR:$LT_PORT`.
#
# SECURITY: read this before exposing the service. LibreTranslate ships with
# NO authentication. Out of the box every endpoint (/translate,
# /translate_file, /detect) is anonymous and unmetered: an instance on a public
# URL is a free translation proxy that anyone can point a scraper at and burn
# your CPU on, and file translation will happily chew through uploads. The
# only abuse controls that exist are LT_API_KEYS + LT_REQUIRE_API_KEY_ORIGIN
# (or LT_UNDER_ATTACK) and the LT_*REQ_LIMIT / LT_CHAR_LIMIT /
# LT_BATCH_LIMIT knobs below. Set at least a rate limit before publishing.
# The compose sets neither, so this template starts fully open.

# @defaultSensitive=false @defaultRequired=infer
# @docs("LibreTranslate arguments reference", https://docs.libretranslate.com/guides/installation/#arguments)
# ---

# ─── Serving ─────────────────────────────────────────────────────────────

# Address gunicorn binds to. The default 127.0.0.1 is special-cased by
# scripts/entrypoint.sh, which rewrites it to `[::]` (or 0.0.0.0 when IPv6 is
# disabled) so the container is reachable. Leave it alone. Any other value is
# passed through verbatim and will make the container unreachable from the
# platform network.
LT_HOST=127.0.0.1

# Port gunicorn listens on. The compose exposes container port 5000 with no
# override, so this is that port's twin: change one without the other and
# routing breaks.
# @type=port
LT_PORT=5000

# gunicorn worker processes (`--workers $LT_THREADS`). Each worker loads its
# own copy of every model in LT_LOAD_ONLY, so memory is roughly this value
# times the model set. That is the main reason a small box OOMs on startup.
# @type=number
LT_THREADS=4

# Serve the app under a path prefix, e.g. `/translate`, with a 301 from `/`.
# Only needed when a reverse proxy mounts LibreTranslate somewhere other than
# the domain root. A leading slash is added if you omit it.
LT_URL_PREFIX=

# Werkzeug debug/reloader mode. Never enable on anything reachable: the
# debugger exposes an interactive console.
# @type=boolean
LT_DEBUG=false

# Make the built-in server terminate TLS itself with an adhoc certificate.
# Pointless behind otterdeploy's proxy, which already terminates TLS.
# @type=boolean
LT_SSL=

# ─── Languages and models ────────────────────────────────────────────────

# Comma-separated language codes to load. The compose sets this (overridable
# per-deploy) because loading every model costs several GB of RAM and a long
# first boot; an empty value means "load everything argos-translate has".
# Codes must be ones the model index actually publishes.
# @docs("Supported languages", https://docs.libretranslate.com/guides/supported_languages/)
LT_LOAD_ONLY=en,es,fr,de,pt

# Download/refresh language models at startup. The compose keeps the model
# directory in the `libretranslate-models` volume mounted at
# /home/libretranslate/.local, so models survive restarts; turning this on
# checks for newer packages on every boot (the entrypoint unsets it before
# gunicorn so workers do not each repeat the download).
# @type=boolean
LT_UPDATE_MODELS=false

# Reinstall every model at startup even if it is already present. A repair
# switch for a corrupted model volume, not something to leave on, since it
# re-downloads gigabytes on every boot.
# @type=boolean
LT_FORCE_UPDATE_MODELS=false

# ─── Abuse controls: API keys ────────────────────────────────────────────

# Enable the API key database, which gates access and allows per-key rate
# limits. Keys are created with the `ltmanage keys` CLI inside the container;
# there is no web admin for them. This alone does not require a key. Pair it
# with LT_REQUIRE_API_KEY_ORIGIN or LT_UNDER_ATTACK, otherwise anonymous
# requests still go through at the default limits.
# @type=boolean
# @docs("Manage API keys", https://docs.libretranslate.com/guides/manage_api_keys/)
LT_API_KEYS=false

# Path to the API key SQLite database, relative to /app inside the container
# unless absolute. NOTE: this template's only volume covers the model
# directory, so at the default path the key database lives in the container
# filesystem and is lost on redeploy. Point it at a mounted path before you
# rely on issued keys.
LT_API_KEYS_DB_PATH=db/api_keys.db

# Query this HTTP endpoint for key validity instead of the local database
# (used to share one key store across a fleet). The URL receives the
# submitted key, so it must be trusted and reachable from the container.
# @type=url
LT_API_KEYS_REMOTE=

# Require an API key for every request whose Origin header does not match this
# domain. This is the switch that actually closes an open instance: with
# LT_API_KEYS on, set this to your own site's origin (or `*` for none) so the
# web UI keeps working while programmatic callers must present a key.
LT_REQUIRE_API_KEY_ORIGIN=

# Require an API key unless the client also sends a rotating secret that the
# bundled web UI computes. Anti-scraping friction for the public UI, not
# authentication: the secret is derivable from the JavaScript you serve.
# @type=boolean
LT_REQUIRE_API_KEY_SECRET=false

# Require an API key unless the client's request fingerprint matches. Same
# caveat as the secret: it raises the cost of scripted abuse, it does not
# authenticate anyone.
# @type=boolean
LT_REQUIRE_API_KEY_FINGERPRINT=false

# Under-attack mode: every request must carry a valid API key, no origin or
# fingerprint escape hatch. The blunt instrument for when an open instance is
# being drained.
# @type=boolean
LT_UNDER_ATTACK=false

# URL shown in the web UI telling visitors where to obtain an API key.
# Cosmetic. It changes a link, it grants nothing.
# @type=url
LT_GET_API_KEY_LINK=

# ─── Abuse controls: rate and size limits ────────────────────────────────

# Maximum characters per translation request; -1 means unlimited. With no
# limit, one request can pin a worker for a long time.
# @type=number
# @docs("API usage", https://docs.libretranslate.com/guides/api_usage/)
LT_CHAR_LIMIT=-1

# Requests per minute per client; -1 means unlimited. The single most
# important knob on a public instance.
# @type=number
LT_REQ_LIMIT=-1

# Requests per hour per client, applied on top of LT_REQ_LIMIT. -1 disables.
# @type=number
LT_HOURLY_REQ_LIMIT=-1

# With LT_HOURLY_REQ_LIMIT set, adds extra hourly ceilings that decrease
# logarithmically for each additional hour, so sustained scraping is throttled
# harder than a burst. 0 disables the decay.
# @type=number
LT_HOURLY_REQ_LIMIT_DECAY=0

# Requests per day per client, applied on top of LT_REQ_LIMIT. -1 disables.
# @type=number
LT_DAILY_REQ_LIMIT=-1

# How many rate-limit violations a client may rack up before it is banned
# outright. -1 disables banning, so offenders just keep getting 429s.
# @type=number
LT_REQ_FLOOD_THRESHOLD=-1

# Charge slow requests extra against the rate limit: a request taking N seconds
# costs max(N / this, actual cost). Stops a few huge translations from being
# as cheap as a few small ones. -1 disables.
# @type=number
LT_REQ_TIME_COST=-1

# Maximum number of texts in one batch /translate call; -1 means unlimited,
# which lets a single request multiply past LT_CHAR_LIMIT.
# @type=number
LT_BATCH_LIMIT=-1

# Maximum alternative translations returned per request; -1 means unlimited.
# Each alternative is extra decoding work, so this is a cost knob too.
# @type=number
LT_ALTERNATIVES_LIMIT=-1

# Storage backend flask-limiter counts requests in. The default `memory://` is
# per-process, so with LT_THREADS > 1 the effective limit is multiplied by the
# worker count. Point it at a shared `redis://…` URI for accurate limits.
# @docs("flask-limiter storage configuration", https://flask-limiter.readthedocs.io/en/stable/configuration.html)
LT_REQ_LIMIT_STORAGE=memory://

# ─── Web UI and frontend ─────────────────────────────────────────────────

# Turn off the bundled translation web UI and serve the API only. The compose
# sets this to false, so the UI is served, which is also what makes the
# instance trivially discoverable and usable by strangers. Set it to true for
# an API-only deployment.
# @type=boolean
LT_DISABLE_WEB_UI=false

# Hide the request/response API examples in the web UI. Cosmetic: the API is
# still reachable and still documented at the /docs spec endpoint.
# @type=boolean
LT_HIDE_API=false

# Default source language preselected in the UI; `auto` means detect.
LT_FRONTEND_LANGUAGE_SOURCE=auto

# Default target language preselected in the UI; `locale` follows the
# visitor's browser locale.
LT_FRONTEND_LANGUAGE_TARGET=locale

# Force the UI's interface language instead of negotiating it from the
# visitor's Accept-Language header. Empty means negotiate.
LT_FRONTEND_LANGUAGE=

# Browser title for the web UI. Empty uses "LibreTranslate".
LT_FRONTEND_TITLE=

# Milliseconds the UI waits after typing stops before translating. Raise it to
# cut request volume from the UI.
# @type=number
LT_FRONTEND_TIMEOUT=500

# ─── Features ────────────────────────────────────────────────────────────

# Enable the POST /suggest endpoint, which lets ANY visitor submit
# user-authored text into db/suggestions.db (libretranslate/suggestions.py).
# That is unmoderated, unauthenticated user-submitted data landing in a SQLite
# file inside the container: it can be spammed, it is not covered by this
# template's model volume, and reviewing it means shelling in. Leave off
# unless you actively curate the submissions.
# @type=boolean
# @docs("POST /suggest", https://docs.libretranslate.com/api/operations/suggest/)
LT_SUGGESTIONS=false

# Disable document translation (/translate_file and /download_file). File
# uploads are the most expensive and most abusable endpoint on an open
# instance; turning them off is the cheapest hardening available.
# @type=boolean
LT_DISABLE_FILES_TRANSLATION=false

# Cache translation output for the listed API keys, or `all` to cache
# everything. Comma-separated. A shared cache across tenants means one user's
# translations can be served to another. Only use `all` on a single-tenant
# instance.
LT_TRANSLATION_CACHE=

# ─── Observability ───────────────────────────────────────────────────────

# Expose GET /metrics with Prometheus counters. The endpoint is exempt from
# rate limiting and its labels include per-request client IPs and API keys, so
# do not enable it on a public URL without the token below.
# @type=boolean
# @docs("Prometheus metrics", https://docs.libretranslate.com/guides/installation/#prometheus-metrics)
LT_METRICS=false

# Bearer token required on /metrics. Empty means the endpoint is fully
# anonymous whenever LT_METRICS is on.
# @sensitive
LT_METRICS_AUTH_TOKEN=

# ─── Multi-process and multi-node ────────────────────────────────────────

# Storage URI processes use to share state (API key cache, secrets) across
# gunicorn workers. `memory://` is per-process; a `redis://…` URI is what makes
# LT_REQUIRE_API_KEY_SECRET and friends behave consistently across workers.
LT_SHARED_STORAGE=memory://

# Mark this replica as secondary in a multi-node setup so it does not run the
# primary's scheduled model-update work. Meaningless for the single replica
# this template deploys.
# @type=boolean
LT_SECONDARY=false
