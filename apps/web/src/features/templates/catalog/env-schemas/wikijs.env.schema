# Wiki.js 2.5.314 (image ghcr.io/requarks/wiki:2.5.314) environment schema
# (@env-spec / varlock format).
#
# Source: at tag v2.5.314, the config loader (`server/core/config.js`,
# `server/helpers/config.js`'s `parseConfigValue`) and the `config.yml` the
# Docker image actually ships (`dev/build/config.yml`, copied to
# /wiki/config.yml by `dev/build/Dockerfile`), plus a repo-wide grep of
# `process.env.` across server/ and dev/.
#
# HOW CONFIG WORKS HERE. Wiki.js is a Node app configured by a YAML file, not
# by environment variables. The image's config.yml is a template full of
# `$(VAR)` / `$(VAR:default)` placeholders, and `parseConfigValue` substitutes
# `process.env[VAR]` into it at boot. So the ONLY environment variables that
# reach Wiki.js settings are the ones that appear in that shipped template:
# DB_TYPE, DB_HOST, DB_PORT, DB_USER, DB_PASS, DB_NAME, DB_FILEPATH, DB_SSL,
# SSL_ACTIVE, LETSENCRYPT_DOMAIN, LETSENCRYPT_EMAIL, LOG_LEVEL, LOG_FORMAT and
# HA_ACTIVE, plus a handful read straight from `process.env` in code
# (CONFIG_FILE, DB_PASS_FILE, DB_SSL_CA, DATABASE_URL, UPGRADE_COMPANION,
# UPGRADE_COMPANION_REF, PORT, HEROKU, NODE_ENV, dockerdev). A placeholder
# whose variable is unset substitutes the literal string "undefined"; the
# boolean-ish switches (DB_SSL, SSL_ACTIVE, HA_ACTIVE) compare strictly against
# true/'true'/1/'1', so "undefined" reads as off, which is why an unset
# variable behaves like a sane default rather than an error.
#
# EVERYTHING ELSE LIVES IN THE DATABASE. Site title and host URL, auth
# strategies, groups and permissions, mail/SMTP, search engine, storage
# targets, rendering, uploads, theming, the security panel (trust-proxy,
# CSP/HSTS, upload scanning) and the HTTPS-redirect toggle are all stored in
# the `settings` table and edited in the admin UI (`server/core/config.js`
# `loadFromDb` merges them over the file config). None of them are settable
# from the environment at 2.x. Do not expect an env var for them.
#
# SECURITY: FIRST-RUN SETUP IS UNAUTHENTICATED. With an empty database
# Wiki.js boots into setup mode (`server/setup.js`), which serves the wizard on
# `app.get('*')` and accepts `POST /finalize` with NO authentication and no
# token whatsoever. It is first-visitor-wins: whoever loads the page first
# creates the administrator account and owns the wiki. Complete setup before
# the instance is reachable from the internet, or keep it behind the platform's
# access control until you have.
#
# SECURITY: VERSION. 2.5.314 (2026-05-01) is the newest stable release. It
# includes 2.5.313's fix for GHSA-cq3g-mwrg-v2rv, a critical privilege
# escalation where any account holding `manage:users` could add itself to the
# Administrators group via the `users.update` GraphQL mutation. Do not run an
# older 2.5.x. Wiki.js 3.x exists only as alpha/beta pre-releases, so 2.x is
# still the supported line.
#
# Cross-checked against the docs' "Environment Variables" list, which is
# accurate as far as it goes but omits LOG_LEVEL, LOG_FORMAT, DATABASE_URL,
# UPGRADE_COMPANION / UPGRADE_COMPANION_REF, PORT/HEROKU and NODE_ENV. Two
# variables the docs list are build-time only and are NOT included below:
# CURRENT_THEME is a webpack DefinePlugin constant baked in at build
# (`dev/webpack/webpack.prod.js`), not read at runtime.
#
# The compose prompts for POSTGRES_PASSWORD only, and threads it unchanged into
# the wiki container's DB_PASS and the bundled Postgres' POSTGRES_PASSWORD.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Wiki.js Docker installation & environment variables", https://docs.requarks.io/install/docker)
# ---

# ─── Database connection ─────────────────────────────────────────────────────

# Database engine. Substituted into `db.type` in the image's config.yml, which
# selects the knex client in `server/core/db.js` (postgres -> pg). Wiki.js
# ships no database of its own; this stack pairs it with Postgres.
# @required
# @type=enum(postgres, mysql, mariadb, mssql, sqlite)
# @docs("Supported database engines", https://docs.requarks.io/install/requirements)
DB_TYPE=postgres

# Hostname of the database server, resolved by the platform to the bundled
# Postgres service. Ignored when DB_TYPE is sqlite.
# @required
DB_HOST=${{stack.db.HOST}}

# Port of the database server. Postgres' default; the twin of the port the
# bundled `db` service listens on, so changing one without the other breaks the
# connection.
# @required
# @type=port
DB_PORT=5432

# Database user Wiki.js connects as. Must match the bundled Postgres'
# POSTGRES_USER below. That role is created at first init and never renamed.
# @required
DB_USER=wikijs

# Password for DB_USER. Set by the compose from POSTGRES_PASSWORD above.
# Use DB_PASS_FILE instead if you would rather mount the value as a file.
# @required
# @sensitive
DB_PASS=${POSTGRES_PASSWORD}

# Name of the database Wiki.js uses. Must match the bundled Postgres'
# POSTGRES_DB below; Wiki.js runs its own knex migrations inside it at every
# boot.
# @required
DB_NAME=wiki

# Path to the SQLite file, substituted into `db.storage`. Read only when
# DB_TYPE is sqlite; irrelevant to this Postgres stack.
DB_FILEPATH=

# Alternative to DB_PASS: absolute path, inside the container, to a file whose
# contents are the database password (a Docker secret). Read directly in
# `server/core/config.js`; when set it overwrites `db.pass` and the process
# exits if the file cannot be read.
# @docs("Database environment variables", https://docs.requarks.io/install/docker#database)
DB_PASS_FILE=

# Enables TLS on the database connection. Accepts `1` or `true`; anything else
# (including unset) leaves it off. With this on and no DB_SSL_CA, Wiki.js
# connects with `rejectUnauthorized: true`, so the server's certificate must
# chain to a CA the container already trusts. The bundled Postgres on the
# platform's private network does not need this.
# @type=boolean
DB_SSL=false

# The database's CA certificate as a SINGLE line of base64: no spaces, no
# newlines, and WITHOUT the `-----BEGIN/END CERTIFICATE-----` lines, which
# `server/core/db.js` re-adds after re-wrapping at 64 characters. Setting it
# forces DB_SSL on and pins verification to this CA. Requires 2.3+.
DB_SSL_CA=

# Undocumented escape hatch read directly in `server/core/db.js`: a full
# connection string (e.g. postgres://user:pass@host:5432/db) that REPLACES
# DB_HOST / DB_PORT / DB_USER / DB_PASS / DB_NAME wholesale. DB_TYPE is still
# what picks the driver, and the file-based sslOptions block is skipped in this
# mode, so prefer the discrete variables above unless you need a URL.
# @sensitive
DATABASE_URL=

# ─── Bundled Postgres ────────────────────────────────────────────────────────

# Role the official Postgres image creates on first init, and the role Wiki.js
# authenticates as. Matches DB_USER above.
# @docs("Official Postgres image: environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=wikijs

# Password for that role. Platform prompt key: generated once at install and
# threaded, unchanged, into both this variable and DB_PASS above. It is only
# applied when the data volume is empty, so changing it later does not re-key
# an already-initialised database. Wiki.js keeps every page, user and setting
# in here, so this is a full read/write path to the whole wiki.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first init. Matches DB_NAME above.
POSTGRES_DB=wiki

# ─── HTTPS (Let's Encrypt, in-container) ─────────────────────────────────────

# Turns on the container's own HTTPS listener on port 3443, provisioned by
# Let's Encrypt (the image's config.yml hardcodes `provider: letsencrypt`).
# Accepts `1` or `true`; `server/master.js` compares strictly, so unset is off.
# Leave this off when the platform already terminates TLS in front of the
# service. Running both means Wiki.js competing for an ACME challenge it
# cannot see. A custom certificate is not settable from the environment at all;
# that needs a mounted config file (see CONFIG_FILE).
# @type=boolean
# @docs("HTTPS with Let's Encrypt", https://docs.requarks.io/install/docker#https)
SSL_ACTIVE=false

# The fully-qualified domain the Let's Encrypt certificate is requested for. It
# must resolve to this container and port 80 must stay reachable from the
# internet for issuance AND for every renewal. Only read when SSL_ACTIVE is on.
LETSENCRYPT_DOMAIN=

# Administrator email registered with Let's Encrypt for expiry notices. Only
# read when SSL_ACTIVE is on.
# @type=email
LETSENCRYPT_EMAIL=

# ─── High availability ───────────────────────────────────────────────────────

# Set to `1` or `true` when several Wiki.js instances share one database, so
# configuration and cache invalidation are propagated between them over
# Postgres LISTEN/NOTIFY (`server/core/db.js`). PostgreSQL ONLY (it silently
# does nothing on any other engine). Leave off for a single instance.
# @type=boolean
# @docs("High-Availability mode", https://docs.requarks.io/install/docker#high-availability)
HA_ACTIVE=false

# ─── Logging ─────────────────────────────────────────────────────────────────

# Winston log level. This is one of only two placeholders in the image's
# config.yml with a built-in default (`$(LOG_LEVEL:info)`), so leaving it unset
# genuinely yields `info` rather than the string "undefined".
# @type=enum(error, warn, info, verbose, debug, silly)
LOG_LEVEL=info

# `json` switches every log line to structured JSON (`server/core/logger.js`);
# anything else keeps the human-readable console format. Also defaulted in the
# image's config.yml (`$(LOG_FORMAT:default)`).
# @type=enum(default, json)
LOG_FORMAT=default

# ─── Config file override ────────────────────────────────────────────────────

# Path, resolved against /wiki, to a YAML config file to load INSTEAD of the
# image's /wiki/config.yml. Use this when you need settings the environment
# cannot express: a custom PEM/PFX certificate, `db.sslOptions`, `db.schema`,
# the connection pool, `bindIP` or `bodyParserLimit`. Note that a file you
# supply yourself has no `$(VAR)` placeholders, so every DB_* variable above
# stops being read once you mount one.
# @docs("Mounting a config file", https://docs.requarks.io/install/docker#alternative-mount-the-config-file)
CONFIG_FILE=

# ─── Upgrade companion ───────────────────────────────────────────────────────

# Presence of this variable is what unlocks the "Upgrade" button in
# Administration > System (`server/graph/resolvers/system.js`); it expects the
# separate `requarks/wiki-update-companion` container to be running with access
# to the Docker socket. That container can replace this one, so only enable it
# if you want in-app upgrades rather than repinning the image tag here.
# @docs("Wiki.js update companion", https://github.com/requarks/wiki-update-companion)
UPGRADE_COMPANION=

# Optional container name/reference passed to the companion so it knows which
# container to replace. Only read when UPGRADE_COMPANION is set.
UPGRADE_COMPANION_REF=

# ─── Runtime (rarely needed) ─────────────────────────────────────────────────

# Read in `server/core/config.js` ONLY when the configured port is below 1 or
# HEROKU is set. The image's config.yml hardcodes `port: 3000`, so on this
# stack PORT is inert. The listening port is 3000 and the compose exposes it.
# @type=port
PORT=

# Presence-only flag for Heroku-style dynos: when set, the configured port is
# discarded in favour of PORT (defaulting to 80). Leave empty here.
HEROKU=

# Node's environment flag. `development` sets IS_DEBUG in `server/index.js`,
# which turns on verbose behaviour meant for contributors. The image does not
# set it; leave empty for normal production behaviour.
# @type=enum(production, development)
NODE_ENV=

# Development-only trap, read lowercase in `server/core/config.js`: when set to
# anything, the loader looks for `dev/containers/config.yml`, which does not
# exist in the release image, and the process exits. Never set this.
# @docs("Troubleshooting Wiki.js", https://docs.requarks.io/troubleshooting)
dockerdev=
