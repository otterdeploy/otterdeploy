# Gotenberg 8 (gotenberg/gotenberg:8 resolves to v8.36.0 today, same digest as
# the 8.36.0 tag) — environment schema (@env-spec / varlock format).
#
# Source: cmd/gotenberg.go at v8.36.0. Gotenberg has no config file and almost
# no direct env reads; instead, after parsing the command line it walks every
# registered --flag and overrides it from the env var named by upper-casing the
# flag and swapping "-" for "_" (fs.VisitAll in cmd/gotenberg.go). So every
# item below that is not in the "Direct env reads" section is a flag twin, and
# an env value beats whatever the compose passes on the command line: our
# compose runs `gotenberg --api-port=3000 --api-timeout=60s`, so API_PORT and
# API_TIMEOUT are recorded at those values, not at the binary's defaults.
# Deprecated flags (log-format, log-enable-gcp-fields, api-trace-header,
# api-disable-health-check-logging, chromium-incognito, pdfengines-engines,
# prometheus-disable-route-logging, webhook-error-*-list) are left out.
#
# Direct reads that the configuration page does not list: OTEL_SERVICE_NAME
# (cmd/gotenberg.go), OTEL_METRICS_EXEMPLAR_FILTER (internal/otel), the
# *_BIN_PATH lookups, GOTENBERG_VERSIONS_DIR_PATH, and the HTTP_PROXY /
# HTTPS_PROXY / ALL_PROXY trio that the *_ENABLE_ENVIRONMENT_PROXY flags
# validate at startup (pkg/gotenberg/outbound.go).
#
# The compose sets NO environment keys; everything here is optional and the
# service converts documents with nothing filled in. The API is unauthenticated
# unless you turn on basic auth or OIDC below.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Gotenberg configuration reference", https://gotenberg.dev/docs/configuration)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Port the API listens on. The compose passes --api-port=3000 and exposes that
# port; setting a different value here silently wins over the flag and the
# route stops answering.
# @type=port
API_PORT=3000

# Name of ANOTHER env var to read the port from (e.g. PORT on Cloud Run).
# Leave empty; API_PORT is authoritative here.
API_PORT_FROM_ENV=

# IP to bind to. Empty binds every interface, which is what the container
# network needs.
API_BIND_IP=

# Time limit for a single conversion request. The compose passes
# --api-timeout=60s; env overrides it. Go duration syntax (30s, 2m).
API_TIMEOUT=60s

# Time limit for the API to start (Chromium/LibreOffice warm-up counts).
API_START_TIMEOUT=30s

# Max request body size, e.g. 50MB. Empty means unlimited.
API_BODY_LIMIT=

# Prefix every route is served under. Keep the leading and trailing slash.
API_ROOT_PATH=/

# Header Gotenberg reads/writes to correlate a request with its logs.
API_CORRELATION_ID_HEADER=Gotenberg-Trace

# Serve TLS directly. Both files must be inside the container.
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=

# Exposes a /debug route that dumps build and runtime data.
# @type=boolean
API_ENABLE_DEBUG_ROUTE=false

# Collect build data (module versions) at startup for /debug and /version.
# @type=boolean
GOTENBERG_BUILD_DEBUG_DATA=true

# Time given to in-flight conversions when the container stops.
GOTENBERG_GRACEFUL_SHUTDOWN_DURATION=30s

# @type=boolean
GOTENBERG_HIDE_BANNER=false

# ─── Auth ────────────────────────────────────────────────────────────────
# Without one of these blocks anyone who can reach the port can convert.

# Turn on HTTP basic auth. When true, both GOTENBERG_API_BASIC_AUTH_* values
# are read directly from the env (pkg/modules/api/api.go) and startup fails
# if either is empty. Mutually exclusive with OIDC.
# @type=boolean
API_ENABLE_BASIC_AUTH=false
GOTENBERG_API_BASIC_AUTH_USERNAME=
# @sensitive
GOTENBERG_API_BASIC_AUTH_PASSWORD=

# Bearer-token auth against an OIDC issuer instead of basic auth. Issuer and
# audience are mandatory once enabled; JWKS URL is discovered from the
# issuer's well-known document when left empty.
# @type=boolean
API_ENABLE_OIDC_AUTH=false
# @type=url
API_OIDC_ISSUER=
API_OIDC_AUDIENCE=
# @type=url
API_OIDC_JWKS_URL=

# ─── Chromium ────────────────────────────────────────────────────────────
# @docs("Convert URL to PDF with Chromium", https://gotenberg.dev/docs/convert-with-chromium/convert-url-to-pdf)

# Launch Chromium at boot instead of on the first conversion. Costs memory,
# saves the first caller a cold start.
# @type=boolean
CHROMIUM_AUTO_START=false

# Conversions before Chromium restarts itself (leak hygiene). 0 disables.
# @type=number
CHROMIUM_RESTART_AFTER=100

# Parallel conversions. Chromium supports at most 6.
# @type=number
CHROMIUM_MAX_CONCURRENCY=6

# Requests queued beyond that before Gotenberg answers 503. 0 = unbounded.
# @type=number
CHROMIUM_MAX_QUEUE_SIZE=0

# Stop Chromium after this idle duration; 0 keeps it running.
CHROMIUM_IDLE_SHUTDOWN_TIMEOUT=0

CHROMIUM_START_TIMEOUT=20s

# @type=boolean
CHROMIUM_ALLOW_INSECURE_LOCALHOST=false
# @type=boolean
CHROMIUM_IGNORE_CERTIFICATE_ERRORS=false
# @type=boolean
CHROMIUM_DISABLE_WEB_SECURITY=false
# @type=boolean
CHROMIUM_ALLOW_FILE_ACCESS_FROM_FILES=false
# @type=boolean
CHROMIUM_DISABLE_JAVASCRIPT=false
# @type=boolean
CHROMIUM_CLEAR_CACHE=false
# @type=boolean
CHROMIUM_CLEAR_COOKIES=false
# @type=boolean
CHROMIUM_CLEAR_STORAGE=false

# Chromium's --host-resolver-rules, e.g. "MAP * 0.0.0.0, EXCLUDE localhost".
CHROMIUM_HOST_RESOLVER_RULES=

# Unauthenticated proxy for Chromium. For a proxy with credentials use
# CHROMIUM_ENABLE_ENVIRONMENT_PROXY and the HTTP(S)_PROXY vars instead.
CHROMIUM_PROXY_SERVER=
# @type=boolean
CHROMIUM_ENABLE_ENVIRONMENT_PROXY=false

# Comma-separated regexes that URLs must match / must not match.
# @docs("Outbound URL filtering", https://gotenberg.dev/docs/outbound-url-filtering)
CHROMIUM_ALLOW_LIST=
# The default blocks every file:// URL except the per-request /tmp workspace.
CHROMIUM_DENY_LIST=^file:(?!//\/tmp/).*

# SSRF guards: reject hosts that resolve to private (RFC1918, loopback,
# link-local) or public IPs. Turn on deny-private if untrusted callers can
# submit URLs.
# @type=boolean
CHROMIUM_DENY_PRIVATE_IPS=false
# @type=boolean
CHROMIUM_DENY_PUBLIC_IPS=false

# Removes every Chromium route (HTML, URL, Markdown, screenshots).
# @type=boolean
CHROMIUM_DISABLE_ROUTES=false

# ─── LibreOffice ─────────────────────────────────────────────────────────
# @docs("Convert Office documents with LibreOffice", https://gotenberg.dev/docs/convert-with-libreoffice/convert-to-pdf)

# @type=boolean
LIBREOFFICE_AUTO_START=false
# LibreOffice leaks; it is restarted every N conversions by default.
# @type=number
LIBREOFFICE_RESTART_AFTER=10
# @type=number
LIBREOFFICE_MAX_QUEUE_SIZE=0
LIBREOFFICE_IDLE_SHUTDOWN_TIMEOUT=0
LIBREOFFICE_START_TIMEOUT=20s

# Outbound fetches from documents (embedded images, linked content).
LIBREOFFICE_ALLOW_LIST=
LIBREOFFICE_DENY_LIST=
# @type=boolean
LIBREOFFICE_DENY_PRIVATE_IPS=false
# @type=boolean
LIBREOFFICE_DENY_PUBLIC_IPS=false
# @type=boolean
LIBREOFFICE_ENABLE_ENVIRONMENT_PROXY=false
# @type=boolean
LIBREOFFICE_DISABLE_ROUTES=false

# ─── PDF engines ─────────────────────────────────────────────────────────
# Which bundled engine handles each PDF operation, comma-separated in order of
# preference. Engines: pdfcpu, qpdf, exiftool, pdftk, libreoffice-pdfengine.

PDFENGINES_CONVERT_ENGINES=libreoffice-pdfengine
PDFENGINES_MERGE_ENGINES=qpdf,pdfcpu,pdftk
PDFENGINES_SPLIT_ENGINES=pdfcpu,qpdf,pdftk
PDFENGINES_FLATTEN_ENGINES=qpdf
PDFENGINES_ENCRYPT_ENGINES=qpdf,pdfcpu
PDFENGINES_ROTATE_ENGINES=pdfcpu,qpdf,pdftk
PDFENGINES_STAMP_ENGINES=pdfcpu
PDFENGINES_WATERMARK_ENGINES=pdfcpu
PDFENGINES_OPTIMIZE_IMAGES_ENGINES=pdfcpu
PDFENGINES_EMBED_ENGINES=pdfcpu
PDFENGINES_EMBED_METADATA_ENGINES=qpdf
PDFENGINES_FACTUR_X_ENGINES=qpdf
PDFENGINES_READ_METADATA_ENGINES=exiftool
PDFENGINES_WRITE_METADATA_ENGINES=exiftool
PDFENGINES_READ_BOOKMARKS_ENGINES=pdfcpu
PDFENGINES_WRITE_BOOKMARKS_ENGINES=pdfcpu
# @type=boolean
PDFENGINES_DISABLE_ROUTES=false

# ─── Download from ───────────────────────────────────────────────────────
# The "downloadFrom" form field lets a caller point Gotenberg at a URL to
# fetch inputs from. Same filtering model as Chromium.

# @type=boolean
API_DISABLE_DOWNLOAD_FROM=false
API_DOWNLOAD_FROM_ALLOW_LIST=
API_DOWNLOAD_FROM_DENY_LIST=
# @type=boolean
API_DOWNLOAD_FROM_DENY_PRIVATE_IPS=false
# @type=boolean
API_DOWNLOAD_FROM_DENY_PUBLIC_IPS=false
# @type=boolean
API_DOWNLOAD_FROM_ENABLE_ENVIRONMENT_PROXY=false
# @type=number
API_DOWNLOAD_FROM_MAX_RETRY=4

# ─── Webhook ─────────────────────────────────────────────────────────────
# Async mode: the result is POSTed to a caller-supplied URL instead of being
# returned inline.
# @docs("Webhook delivery", https://gotenberg.dev/docs/webhook-download)

# @type=boolean
WEBHOOK_DISABLE=false
# Wait for the webhook to be delivered before answering the request.
# @type=boolean
WEBHOOK_ENABLE_SYNC_MODE=false
WEBHOOK_ALLOW_LIST=
WEBHOOK_DENY_LIST=
# @type=boolean
WEBHOOK_DENY_PRIVATE_IPS=false
# @type=boolean
WEBHOOK_DENY_PUBLIC_IPS=false
# @type=boolean
WEBHOOK_ENABLE_ENVIRONMENT_PROXY=false
WEBHOOK_CLIENT_TIMEOUT=30s
# @type=number
WEBHOOK_MAX_RETRY=4
WEBHOOK_RETRY_MIN_WAIT=1s
WEBHOOK_RETRY_MAX_WAIT=30s

# ─── Outbound proxy ──────────────────────────────────────────────────────
# Read by Go's httpproxy when any *_ENABLE_ENVIRONMENT_PROXY flag is true.
# Each set value must parse as a proxy URL (http://user:pass@host:3128) or
# the module refuses to start (pkg/gotenberg/outbound.go).

# @sensitive @type=url
HTTP_PROXY=
# @sensitive @type=url
HTTPS_PROXY=
# @sensitive @type=url
ALL_PROXY=
NO_PROXY=

# ─── Logging & telemetry ─────────────────────────────────────────────────
# @docs("Telemetry", https://gotenberg.dev/docs/telemetry)

# @type=enum(error, warn, info, debug)
LOG_LEVEL=info
# auto picks json when stdout is not a TTY, which it is not in a container.
# @type=enum(auto, json, text)
LOG_STD_FORMAT=auto
# @type=enum(lower, upper)
LOG_STD_LEVEL_CASE=lower
# @type=boolean
LOG_STD_ENABLE_GCP_FIELDS=false
LOG_FIELDS_PREFIX=

# Telemetry for the noisy system routes is off by default.
# @type=boolean
API_DISABLE_HEALTH_CHECK_ROUTE_TELEMETRY=true
# @type=boolean
API_DISABLE_ROOT_ROUTE_TELEMETRY=true
# @type=boolean
API_DISABLE_VERSION_ROUTE_TELEMETRY=true
# @type=boolean
API_DISABLE_DEBUG_ROUTE_TELEMETRY=true

# OpenTelemetry SDK settings, read by the OTel Go SDK and cmd/gotenberg.go.
# The image ships every exporter set to "none"; point OTEL_EXPORTER_OTLP_ENDPOINT
# at a collector and switch the exporters to otlp to emit.
OTEL_SERVICE_NAME=gotenberg
# @type=enum(none, otlp, console)
OTEL_TRACES_EXPORTER=none
# @type=enum(none, otlp, prometheus, console)
OTEL_METRICS_EXPORTER=none
# @type=enum(none, otlp, console)
OTEL_LOGS_EXPORTER=none
# @type=enum(grpc, http/protobuf)
OTEL_EXPORTER_OTLP_PROTOCOL=
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=
# @type=boolean
OTEL_EXPORTER_OTLP_INSECURE=
# Presence alone switches the metrics exemplar filter (internal/otel/otel.go).
OTEL_METRICS_EXEMPLAR_FILTER=

# Prometheus scrape endpoint.
# @docs("Prometheus metrics route", https://gotenberg.dev/docs/system/prometheus-metrics)
PROMETHEUS_NAMESPACE=gotenberg
PROMETHEUS_METRICS_PATH=/prometheus/metrics
PROMETHEUS_COLLECT_INTERVAL=1s
# @type=boolean
PROMETHEUS_DISABLE_COLLECT=false
# @type=boolean
PROMETHEUS_DISABLE_ROUTE_TELEMETRY=true

# ─── Image internals ─────────────────────────────────────────────────────
# Set by the Dockerfile; read via os.LookupEnv. Only change them if you
# rebuild the image with the binaries somewhere else.

TZ=UTC
CHROMIUM_BIN_PATH=/usr/bin/chromium
CHROMIUM_HYPHEN_DATA_DIR_PATH=/opt/gotenberg/chromium-hyphen-data
LIBREOFFICE_BIN_PATH=/usr/lib/libreoffice/program/soffice.bin
UNOCONVERTER_BIN_PATH=/usr/bin/unoconverter
PDFTK_BIN_PATH=/usr/bin/pdftk
QPDF_BIN_PATH=/usr/bin/qpdf
EXIFTOOL_BIN_PATH=/usr/bin/exiftool
PDFCPU_BIN_PATH=/usr/bin/pdfcpu
GOTENBERG_VERSIONS_DIR_PATH=/opt/gotenberg/versions
