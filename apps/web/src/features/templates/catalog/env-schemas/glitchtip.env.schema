# GlitchTip 6.2.6 environment schema (@env-spec / varlock format).
#
# The compose pins glitchtip/glitchtip:6.2.6 on all three GlitchTip services
# (web, worker, and the one-shot migrate job). 6.2.6 is the newest tag in the
# upstream repo and, on 2026-09-04 (the research date), the same digest
# docker.io's floating `latest`, `6` and `6.2` tags resolve to
# (sha256:a3d8eb1b36c1e160…, pushed 2026-08-08), so nothing newer is being
# withheld from the pin.
#
# Source: grep of `env.` / `os.environ` / `os.getenv` across
# glitchtip/settings.py at tag v6.2.6 in gitlab.com/glitchtip/glitchtip-backend
# (GlitchTip is a single Django project and that one file is its entire
# django-environ surface), plus bin/*.sh for the variables the container's
# entrypoint reads before Django is imported. Cross-checked against the
# Configuration section of glitchtip.com/documentation/install.
#
# Where the docs and the 6.2.6 code disagree:
#  - The docs describe CACHE_URL, CACHE_SENTINEL_URL, CACHE_SENTINEL_SERVICE_NAME
#    and CACHE_SENTINEL_DB. Nothing in the 6.2.6 tree reads any of them: the
#    cache and task broker location is VALKEY_URL and nothing else
#    (settings.py:1052-1075). They are omitted here rather than documented as
#    working knobs.
#  - ENABLE_OPEN_USER_REGISTRATION no longer means what its name says. At 6.2.6
#    it is the first name checked for ENABLE_ORGANIZATION_CREATION
#    (settings.py:1271). User self-signup is ENABLE_USER_REGISTRATION.
#  - The docs say migrations "automatically happen". That is only true for the
#    all-in-one role: bin/run-all-in-one.sh runs migrate + maintain_partitions
#    unless SKIP_INIT, bin/start.sh migrates only on Heroku dynos, and the plain
#    web role (bin/run-web.sh -> granian) migrates nothing. That is why this
#    template runs a separate one-shot `migrate` service on the same image with
#    the same environment.
#  - The 6.2.6 changelog notes that any install keeping months of events in
#    PostgreSQL should raise the server's max_locks_per_transaction (512 is the
#    suggested floor). That is a postgres.conf setting, not an env var, so it
#    cannot be expressed here. It is a knob on the bundled `db` service.
#
# Billing/SaaS-only variables (STRIPE_*, CHATWOOT_*, PLAUSIBLE_*,
# GLITCHTIP_FREE_TIER_EVENTS, GLITCHTIP_OVERAGE_MAX_CAP_CENTS) are read by
# settings.py but only do anything on an app.glitchtip.com-shaped install with
# Stripe keys present; they are omitted.

# @defaultSensitive=false @defaultRequired=infer
# @docs("GlitchTip installation and configuration reference", https://glitchtip.com/documentation/install)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The public URL GlitchTip is reached at, scheme included: an https:// or
# http:// origin, no trailing path. Every external link GlitchTip emits
# (invitation emails, password resets, alert deep links, the DSN shown in the
# UI) is built from it, and settings.py refuses to boot if the scheme is not
# http/https. It also decides the default for SESSION_COOKIE_SECURE and
# CSRF_COOKIE_SECURE: https here means secure cookies without further config,
# http means they stay off.
# @required @type=url
GLITCHTIP_DOMAIN=

# Django's signing key. It signs session cookies, password-reset and email
# confirmation tokens, and CSRF tokens; anyone who learns it can forge a session
# for any account, including the instance owner, or mint a password-reset link
# for any address. Generate 50+ random characters
# (`python -c 'import secrets; print(secrets.token_urlsafe(50))'`) and never
# reuse it across instances. Left unset the image falls back to the literal
# "change_me" and only logs a RuntimeWarning at boot. It does not refuse to
# start, so an unset key is a silently forgeable instance. Rotating it logs
# everyone out and invalidates outstanding reset links.
# @required @sensitive
SECRET_KEY=

# Overrides the URL derived from GLITCHTIP_DOMAIN. Only useful when the domain
# users type differs from the one GlitchTip should advertise; leave empty to let
# GLITCHTIP_DOMAIN decide.
# @type=url
GLITCHTIP_URL=
# DigitalOcean App Platform's name for GLITCHTIP_DOMAIN. It is checked first,
# before GLITCHTIP_DOMAIN, so setting it silently overrides the domain above.
# @type=url
APP_URL=

# Comma-separated hostnames Django will answer for. The image ships the "*"
# wildcard, which accepts any Host header: a forged Host reaches cache
# poisoning and password-reset links pointed at an attacker's domain. Restrict
# it to the hostname(s) you actually serve. A non-default value here also
# silences the boot-time warning.
# @docs("Django ALLOWED_HOSTS", https://docs.djangoproject.com/en/stable/ref/settings/#allowed-hosts)
ALLOWED_HOSTS=*

# Comma-separated origins (scheme included) allowed to submit state-changing
# form posts. Required when a reverse proxy terminates TLS on a different
# origin than GlitchTip sees, otherwise logins fail CSRF validation.
# @docs("Django CSRF_TRUSTED_ORIGINS", https://docs.djangoproject.com/en/stable/ref/settings/#csrf-trusted-origins)
CSRF_TRUSTED_ORIGINS=

# Serve GlitchTip under a sub-path of the domain, e.g. /glitchtip. Empty means
# it owns the root. Read as FORCE_SCRIPT_NAME; FORCE_SCRIPT_NAME is the
# fallback name.
BASE_PATH=
FORCE_SCRIPT_NAME=

# Instance name shown in the UI, markdown supported. Purely cosmetic:
# "[Acme's](https://acme.example) GlitchTip".
GLITCHTIP_INSTANCE_NAME=

# IANA timezone used to render every timestamp server-side.
TIME_ZONE=UTC

# Trust the process's HTTP_PROXY / HTTPS_PROXY / NO_PROXY variables for
# GlitchTip's own outbound requests (uptime checks, webhooks, OIDC discovery).
# Off means those variables are ignored.
# @type=boolean
PROXY_ENV=False

# Rejects new events at ingest while true. Intended for database maintenance
# windows; events sent during the freeze are lost, not queued.
# @type=boolean
MAINTENANCE_EVENT_FREEZE=False

# Kubernetes health-check helper: when set, the value is appended to
# ALLOWED_HOSTS so a kubelet probing the pod IP is not rejected. Leave empty
# under Docker Compose.
POD_IP=

# Version string GlitchTip reports about itself (startup banner, its own error
# reports). The image bakes the real version in at build time; setting it here
# only makes the instance lie about which build it is.
GLITCHTIP_VERSION=

# ─── Bundled PostgreSQL ──────────────────────────────────────────────────

# Password for the bundled Postgres `glitchtip` role. Also embedded in
# DATABASE_URL below, so the two can never drift.
# @required @sensitive
POSTGRES_PASSWORD=

# Role and database the bundled Postgres container creates on first boot. They
# are the credentials DATABASE_URL connects with; changing either without
# changing DATABASE_URL breaks every service.
POSTGRES_USER=glitchtip
POSTGRES_DB=glitchtip

# PLATFORM-OWNED: derived from the sibling Postgres service, never typed.
# The only database GlitchTip has. At 6.2.6 the ORM runs on the embedded Rust
# driver (gt_rust.django_backend) and there is no engine switch left, but the
# URL form is unchanged. PostgreSQL 14+ is supported; 15+ is what upstream CI
# now exercises on its minimum lane.
# @required @sensitive
# @docs("GlitchTip DATABASE_URL", https://glitchtip.com/documentation/install)
DATABASE_URL=postgres://glitchtip:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/glitchtip

# Optional replica GlitchTip routes read-only queries to. Empty means every
# query goes to DATABASE_URL.
# @sensitive
READ_ONLY_DATABASE_URL=
# Optional higher-privilege connection used only by migrations and partition
# maintenance, so the web role can hold a table-owner-less grant. When set,
# bin/run-migrate.sh passes `--database maintenance`.
# @sensitive
MAINTENANCE_DATABASE_URL=

# Component-wise alternative to DATABASE_URL. Setting DATABASE_HOST is the
# switch: when it is non-empty these five override the parsed URL's fields, and
# DATABASE_PASSWORD becomes mandatory. Leave all empty when using DATABASE_URL,
# which this template does.
DATABASE_HOST=
# @type=port
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
# @sensitive
DATABASE_PASSWORD=

# Connection pool the Rust driver keeps per process. Size it against your
# Postgres max_connections across web + worker replicas; the ingest lane adds
# up to 12 concurrent tasks on top of VTASKS_CONCURRENCY as of 6.2.6, so a pool
# sized exactly to worker concurrency is now short.
# @type=number
DATABASE_POOL_MIN_SIZE=2
# @type=number
DATABASE_POOL_MAX_SIZE=20
# Seconds a caller waits for a free pooled connection before erroring.
# @type=number
DATABASE_POOL_TIMEOUT=30
# Seconds after which a pooled connection is recycled, bounding per-connection
# memory growth. 0 means never recycle.
# @type=number
DATABASE_POOL_MAX_LIFETIME=0

# Django's persistent-connection age. Since 6.2.2 the Rust driver always pools
# internally, so a non-zero value no longer produces unpooled persistent
# connections the way the old psycopg engine did.
# @type=number
DATABASE_CONN_MAX_AGE=0
# @type=boolean
DATABASE_CONN_HEALTH_CHECKS=False

# Hash sub-partitions created under each time partition of the event, log, span
# and uptime tables. Default dropped from 4 to 2 in 6.2.6. Raising it multiplies
# the partitions (and the indexes on them) that Postgres must lock for work it
# cannot narrow to one organization (retention sweeps, cold-storage archival,
# DDL on a parent), so raise the server's max_locks_per_transaction alongside it.
# Existing partitions keep the modulus they were created with.
# @type=number
PARTITION_HASH_BUCKETS=2

# ─── Bundled Valkey / Redis ──────────────────────────────────────────────

# PLATFORM-OWNED: derived from the sibling Redis service, never typed.
# The legacy name, still read as the fallback for VALKEY_URL
# (settings.py:924), which is why the compose sets it. It drives the Django
# cache, the django-vtasks task broker and session storage all at once.
# @required
REDIS_URL=redis://${{stack.redis.HOST}}:6379/0

# The 6.x name for the same thing and the one checked first. Set it only to
# point at something other than the bundled Redis, using rediss:// or
# valkeys:// for TLS. Setting it to an explicit empty string is the documented
# way to run without Valkey at all, which moves cache, sessions and the task
# queue into Postgres (lower RAM, lower throughput); that is not what this
# template does.
VALKEY_URL=

# Component-wise alternative to VALKEY_URL. Setting VALKEY_HOST (or REDIS_HOST)
# is the switch: when it is non-empty, these compose a URL that wins over both
# VALKEY_URL and REDIS_URL, so leave them empty here.
VALKEY_HOST=
REDIS_HOST=
# @type=port
VALKEY_PORT=
# @type=port
REDIS_PORT=
VALKEY_DATABASE=
REDIS_DATABASE=
# @sensitive
VALKEY_PASSWORD=
# @sensitive
REDIS_PASSWORD=

# TLS to an external Valkey. Path inside the container to the CA PEM that signs
# the server certificate, needed for a private or self-signed CA; mount the
# file in first.
VALKEY_SSL_CA_CERTS=
# Client certificate and key for mutual TLS. Both must be set together.
VALKEY_SSL_CERTFILE=
VALKEY_SSL_KEYFILE=
# "none" skips server-certificate verification entirely: the connection is
# encrypted but unauthenticated, so anything that can intercept it can read and
# rewrite your cache, sessions and task queue. Prefer VALKEY_SSL_CA_CERTS.
# @type=enum(none, optional, required)
VALKEY_SSL_CERT_REQS=required

# ─── Email ───────────────────────────────────────────────────────────────

# From address on every notification, invitation and password-reset GlitchTip
# sends. Unset it and Django's "webmaster@localhost" goes out instead, which
# most receiving mail servers drop.
# @required @type=email
DEFAULT_FROM_EMAIL=

# One-shot SMTP configuration, e.g. smtp://user:password@smtp.example.com:587.
# The compose defaults it to consolemail://, which prints mail to the container
# log instead of sending it: fine to look around with, but account verification
# and password reset are effectively dead until a real transport is set. Careful
# with @ or / inside the password: they must be percent-encoded. Setting this
# overrides most individual EMAIL_* settings below, so use one style or the
# other, not both.
# @sensitive
# @docs("django-environ email URL schemes", https://django-environ.readthedocs.io/en/latest/types.html)
EMAIL_URL=consolemail://

# Individual SMTP settings, the alternative to EMAIL_URL. Each is read only
# when actually present in the environment, so leaving them empty changes
# nothing.
EMAIL_HOST=
# @type=port
EMAIL_PORT=
EMAIL_HOST_USER=
# @sensitive
EMAIL_HOST_PASSWORD=
# @type=boolean
EMAIL_USE_TLS=
# @type=boolean
EMAIL_USE_SSL=
# Socket timeout in seconds for the SMTP conversation.
# @type=number
EMAIL_TIMEOUT=
# Directory messages are written to when EMAIL_BACKEND is the file backend.
EMAIL_FILE_PATH=

# Django mail backend class. Leave at the SMTP default unless switching to an
# API-based provider, where it becomes the Anymail backend for that provider
# (e.g. anymail.backends.mailgun.EmailBackend).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Forces email on or off regardless of what is configured. Unset, GlitchTip
# infers it: email is enabled if any Anymail key, any EMAIL_* transport
# variable, or a non-SMTP backend is present. With email disabled, nothing is
# sent, account verification and password reset are switched off, and the
# frontend hides the email-only UI.
# @type=boolean
EMAIL_ENABLED=

# Prefix prepended to every outgoing subject line, e.g. "[GlitchTip] ".
ACCOUNT_EMAIL_SUBJECT_PREFIX=

# Invitation flood control: at most this many invite emails per interval
# (seconds) per instance.
# @type=number
EMAIL_THROTTLE_COUNT=50
# @type=number
EMAIL_THROTTLE_INTERVAL=300
# Require the inviter's own address to be verified before invitations are sent.
# @type=boolean
EMAIL_INVITE_REQUIRE_VERIFICATION=False

# API keys for the Anymail-backed providers, used instead of SMTP. Only the
# ones present in the environment are passed through, and each needs its
# matching EMAIL_BACKEND. Scaleway was added in 6.2.3.
# @sensitive
# @docs("Anymail supported ESPs", https://anymail.dev/en/stable/esps/)
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
MAILGUN_API_URL=
# @sensitive
MAILGUN_WEBHOOK_SIGNING_KEY=
# @sensitive
SENDGRID_API_KEY=
SENDGRID_API_URL=
# @sensitive
POSTMARK_SERVER_TOKEN=
POSTMARK_API_URL=
# @sensitive
MANDRILL_API_KEY=
# @sensitive
MANDRILL_WEBHOOK_KEY=
MANDRILL_WEBHOOK_URL=
MANDRILL_API_URL=
# @sensitive
SENDINBLUE_API_KEY=
SENDINBLUE_API_URL=
# @sensitive
MAILJET_API_KEY=
# @sensitive
MAILJET_SECRET_KEY=
MAILJET_API_URL=
# @sensitive
POSTAL_API_KEY=
POSTAL_API_URL=
# @sensitive
POSTAL_WEBHOOK_KEY=
# @sensitive
SPARKPOST_API_KEY=
SPARKPOST_API_URL=
# @type=boolean
SPARKPOST_TRACK_INITIAL_OPEN_AS_OPENED=
# @sensitive
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=

# ─── Registration and access ─────────────────────────────────────────────

# Self-signup. True (the shipped default) means anyone who can reach the URL can
# create an account on your error tracker, and error payloads routinely carry
# request bodies, headers and user data. On a public instance set this to False
# after creating your own account: signup then closes, and further users must
# come from a social app or be created by a superuser. Organization invitations
# can still only be sent to users who already exist.
# @type=boolean
ENABLE_USER_REGISTRATION=True

# Same switch for accounts arriving through a configured OAuth/OIDC provider.
# Defaults to whatever ENABLE_USER_REGISTRATION is, so closing self-signup
# closes social signup too unless this is explicitly set back to True.
# @type=boolean
ENABLE_SOCIAL_APPS_USER_REGISTRATION=

# Whether ordinary users may create additional organizations. False (the
# default) leaves that to superusers. Turning it on also flips the default of
# SOCIAL_AUTH_BLOCK_PRIVATE_IPS to on, because non-admin organization managers
# then exist.
# @type=boolean
ENABLE_ORGANIZATION_CREATION=False

# Legacy alias, and a trap: despite the name, at 6.2.6 this sets
# ENABLE_ORGANIZATION_CREATION, not user registration (settings.py:1271). It is
# checked FIRST, so a value here silently overrides ENABLE_ORGANIZATION_CREATION
# above. Leave it empty and use the two accurately-named variables.
# @type=boolean
ENABLE_OPEN_USER_REGISTRATION=

# Django's admin site at /admin/, on by default in 6.x (upstream's own sample
# compose turns it off). It is full read/write over every model, gated only by
# a superuser password, and there is no superuser until you create one with
# `manage.py createsuperuser`. Leave it off unless you need it.
# @type=boolean
ENABLE_ADMIN=True

# The browsable OpenAPI schema at /api/docs. On by default; it exposes the
# shape of the whole API to anonymous visitors, which is information you may
# not want to publish.
# @type=boolean
ENABLE_OPENAPI=True

# Django's debug mode. True serves a full traceback with local variables (and
# with them SECRET_KEY, DATABASE_URL and every other secret) to whoever
# triggered the error, and disables the boot-time warnings about unsafe
# defaults. Never true on a reachable instance.
# @type=boolean
DEBUG=False

# django-debug-toolbar. Development only; it exposes SQL, settings and request
# internals in-page.
# @type=boolean
DEBUG_TOOLBAR=False

# End-to-end test endpoints. Only honored while DEBUG is true (settings.py
# forces it off otherwise), and it disables account rate limits when both are
# on. Never enable on a real instance.
# @type=boolean
ENABLE_TEST_API=False

# Base URL / tenant for the self-hosted identity providers django-allauth needs
# told about. Only the provider you actually use needs a value; social apps
# themselves are configured in the database (Django admin), not here.
SOCIALACCOUNT_PROVIDERS_gitlab_GITLAB_URL=
SOCIALACCOUNT_PROVIDERS_gitea_GITEA_URL=
SOCIALACCOUNT_PROVIDERS_nextcloud_SERVER=
SOCIALACCOUNT_PROVIDERS_microsoft_TENANT=

# Refuses social-auth outbound requests (OIDC discovery, token exchange) to
# private and loopback addresses. Added in 6.2.3 with the per-organization SSO
# feature: organization managers supply their own IdP URLs, which is an SSRF
# vector into your network. Unset, it defaults ON whenever non-admin
# organization managers can exist (billing enabled or open organization
# creation) and OFF otherwise, so a single-org self-host can still use an
# intranet Keycloak. Set to True to force it on.
# @type=boolean
SOCIAL_AUTH_BLOCK_PRIVATE_IPS=

# ─── Cookies and transport security ──────────────────────────────────────

# Marks the session and CSRF cookies Secure. Unset, both default to true when
# GLITCHTIP_DOMAIN is https and false when it is http, which is the right
# answer for both a TLS deployment and a LAN-only one. Forcing them false
# behind https sends session cookies over any plaintext downgrade.
# @type=boolean
# @docs("Django SESSION_COOKIE_SECURE", https://docs.djangoproject.com/en/stable/ref/settings/#session-cookie-secure)
SESSION_COOKIE_SECURE=
# @type=boolean
CSRF_COOKIE_SECURE=
# SameSite policy for the session cookie. "None" (needed only for cross-site
# embedding) requires Secure and removes the browser's CSRF backstop.
# @type=enum(Lax, Strict, None)
SESSION_COOKIE_SAMESITE=Lax
# Session lifetime in seconds. Empty uses Django's default (two weeks).
# @type=number
SESSION_COOKIE_AGE=

# HSTS max-age in seconds, sent only over https. 0 (the default) means no HSTS
# header. 31536000 is one year; commit to TLS on this hostname before setting
# it, because browsers will refuse plaintext for that long.
# @type=number
# @docs("Django SECURE_HSTS_SECONDS", https://docs.djangoproject.com/en/stable/ref/settings/#secure-hsts-seconds)
SECURE_HSTS_SECONDS=0
# @type=boolean
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# @type=boolean
SECURE_HSTS_PRELOAD=False

# Cross-origin API access. GlitchTip ships allow-all because SDKs POST events
# from arbitrary browser origins; the ingest endpoints authenticate by DSN, not
# by cookie. Set to False and list your origins in CORS_ORIGIN_WHITELIST to
# narrow it.
# @type=boolean
CORS_ORIGIN_ALLOW_ALL=True
# Comma-separated origins allowed when CORS_ORIGIN_ALLOW_ALL is False.
CORS_ORIGIN_WHITELIST=

# Content-Security-Policy directives, comma-separated, single-quoting the
# keywords ('self', 'none'). GlitchTip computes sane defaults from your domain;
# override only to admit an extra script/frame source. A nonce is appended to
# default-src, style-src and script-src regardless.
# @docs("Django Content Security Policy", https://docs.djangoproject.com/en/stable/ref/csp/)
CSP_DEFAULT_SRC=
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=
CSP_STYLE_SRC_ELEM=
CSP_FONT_SRC=
CSP_IMG_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_SRC=
CSP_WORKER_SRC=
# Where the browser posts CSP violation reports.
CSP_REPORT_URI=
# True switches the whole policy to Content-Security-Policy-Report-Only: it
# reports violations and blocks nothing. Useful while tuning, not a policy.
# @type=boolean
CSP_REPORT_ONLY=False

# ─── Features ────────────────────────────────────────────────────────────

# Uptime monitoring. False stops dispatching checks and unregisters the uptime
# API; worth turning off on a small instance to save RAM.
# @type=boolean
GLITCHTIP_ENABLE_UPTIME=True

# Lets uptime monitors target RFC1918/loopback/link-local addresses. Off is the
# SSRF guard: with it on, anyone who can create a monitor can probe your
# internal network through the GlitchTip pod, and 6.2.3 extended the check to
# redirect hops and DNS rebinding. Turn on only on a trusted internal instance.
# @type=boolean
GLITCHTIP_UPTIME_ALLOW_PRIVATE_IPS=False

# The same permission for alert webhooks (Discord, Slack-style, Teams, ntfy,
# Zulip, generic) and the project importer. Kept separate on purpose: webhook
# delivery to an internal address is an exfiltration channel, not just a probe.
# @type=boolean
GLITCHTIP_ALLOW_PRIVATE_IPS=False

# OTLP log ingestion (POST /v1/logs) and the logs UI. Disable to save memory on
# a small instance; log events are then rejected at ingest.
# @type=boolean
GLITCHTIP_ENABLE_LOGS=True

# The built-in MCP server, for pointing an AI agent at your issues. Off by
# default. Note it also changes the ASGI interface the web role runs
# (bin/run-granian.sh switches from asginl to asgi so MCP gets a lifespan).
# @type=boolean
GLITCHTIP_ENABLE_MCP=False

# Prometheus metrics endpoint. Off by default; the endpoint is unauthenticated,
# so keep it off the public listener.
# @type=boolean
ENABLE_OBSERVABILITY_API=False

# Instance-wide default for server-side PII scrubbing at ingest, as a JSON
# object matching apps.event_ingest.pii_scrubber.ScrubConfig, e.g.
# {"enabled": true, "scrub_emails": false}. A project's own scrub_config wins.
# Empty means the shipped default {}: scrubbing off unless a project opts in.
# This is a last line of defense for operators who cannot guarantee every client
# SDK scrubs; 6.2.6 widened its recall to `creds` tokens and the `errors`
# section.
GLITCHTIP_PII_SCRUB_DEFAULT=

# Return chunk-upload responses as relative URLs, for setups where the
# externally visible URL differs from the one GlitchTip computes.
# @type=boolean
GLITCHTIP_CHUNK_UPLOAD_USE_RELATIVE_URL=False

# Set "true" to acknowledge the suggested self-host donation. Enables a few
# cosmetic things; no features are gated on it.
# @type=boolean
I_PAID_FOR_GLITCHTIP=

# Paid support license key. Also flips I_PAID_FOR_GLITCHTIP on by its presence,
# and overrides any license row already stored in the database.
# @sensitive
GLITCHTIP_LICENSE_KEY=

# ─── Retention ───────────────────────────────────────────────────────────

# Master retention in days; each per-type variable below falls back to it.
# Retention is enforced by dropping partitions, so more days means more
# partitions and more of Postgres' shared lock table spent on maintenance.
# @type=number
# @docs("GlitchTip data retention", https://glitchtip.com/documentation/install)
GLITCHTIP_RETENTION_DAYS=90

# Per-type overrides. Empty means "use GLITCHTIP_RETENTION_DAYS", except
# releases, which keep their own 365-day default.
# @type=number
GLITCHTIP_EVENT_RETENTION_DAYS=
# @type=number
GLITCHTIP_TRANSACTION_RETENTION_DAYS=
# @type=number
GLITCHTIP_LOG_RETENTION_DAYS=
# Uptime checks are stored in weekly range partitions as of 6.2.6, so a week of
# checks may survive up to 7 days past this figure before its partition drops.
# @type=number
GLITCHTIP_UPTIME_RETENTION_DAYS=
# Sourcemaps and debug symbols.
# @type=number
GLITCHTIP_FILE_RETENTION_DAYS=
# @type=number
GLITCHTIP_RELEASE_RETENTION_DAYS=365

# Days data stays in PostgreSQL ("hot") before it is archived to cold storage.
# Only meaningful with GLITCHTIP_ENABLE_DUCKDB on; without cold storage these
# are simply when the data disappears.
# @type=number
GLITCHTIP_EVENT_HOT_DAYS=30
# @type=number
GLITCHTIP_LOG_HOT_DAYS=7
# Raw span Parquet (the hourly/daily tiers). Trend rollups outlive it and are
# kept for GLITCHTIP_TRANSACTION_RETENTION_DAYS instead.
# @type=number
GLITCHTIP_SPAN_RAW_RETENTION_DAYS=30

# ─── Cold storage (DuckDB) ───────────────────────────────────────────────

# "true" turns on archival of aged data to Parquet, queried back through
# DuckDB. Requires one of the two storage backends below.
# @type=boolean
GLITCHTIP_ENABLE_DUCKDB=

# S3 bucket for cold storage; files get a cold_storage/ prefix. Defaults to
# AWS_STORAGE_BUCKET_NAME when that is set, so an instance with S3 uploads
# already configured needs nothing extra here.
GLITCHTIP_COLD_STORAGE_BUCKET=
# Local directory instead of S3. Must be on a mounted volume, or the archive
# dies with the container.
GLITCHTIP_COLD_STORAGE_DIR=
# False leaves expired cold files in place, for buckets whose lifecycle rules
# do the deleting.
# @type=boolean
GLITCHTIP_COLD_STORAGE_CLEANUP_ENABLED=True

# Memory ceiling for DuckDB queries; over it, DuckDB spills to
# DUCKDB_TEMP_DIRECTORY instead of being OOM-killed. Empty here means
# auto-detected from the container's cgroup limit (25%, capped at 256MB), not
# unlimited. Set the literal empty string in the environment to disable the
# limit.
DUCKDB_MEMORY_LIMIT=
# Thread cap for DuckDB. Empty auto-detects from the cgroup CPU quota (or
# min(cores, 4) on bare metal); DuckDB's own default is the host's core count,
# which blows up peak memory inside a container.
# @type=number
DUCKDB_THREADS=
# Writable path for DuckDB spill-to-disk.
DUCKDB_TEMP_DIRECTORY=/tmp
# Where DuckDB looks for its extensions. The image pre-installs httpfs and aws
# into /opt/duckdb/extensions at build and sets this itself, so nothing is
# downloaded at runtime; override only if you relocate them.
DUCKDB_EXTENSION_DIRECTORY=

# ─── File storage (uploads, sourcemaps, debug symbols) ───────────────────

# Django storage backend for uploaded files. The compose mounts a volume at
# /code/uploads and leaves this at the filesystem default. Switch it to
# storages.backends.s3boto3.S3Boto3Storage, .azure_storage.AzureStorage or
# .gcloud.GoogleCloudStorage to use object storage instead.
DEFAULT_FILE_STORAGE=django.core.files.storage.filesystem.FileSystemStorage

# S3 (or any S3-compatible: R2, B2, MinIO, Spaces). Setting AWS_S3_ENDPOINT_URL
# alone is enough to switch the default storage to S3 and to derive MEDIA_URL.
# @docs("django-storages Amazon S3 backend", https://django-storages.readthedocs.io/en/latest/backends/amazon-S3.html)
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# @type=url
AWS_S3_ENDPOINT_URL=
# Key prefix inside the bucket.
AWS_LOCATION=
# @type=boolean
AWS_S3_USE_SSL=True
# Path to a CA bundle, or "False" to skip TLS verification of the endpoint.
AWS_S3_VERIFY=

# Azure Blob Storage.
# @docs("django-storages Azure backend", https://django-storages.readthedocs.io/en/latest/backends/azure.html)
AZURE_ACCOUNT_NAME=
# @sensitive
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
# Signed-URL lifetime in seconds; needed when the container is not public.
# @type=number
AZURE_URL_EXPIRATION_SECS=

# Google Cloud Storage. Credentials come from the file
# GOOGLE_APPLICATION_CREDENTIALS points at, which must be mounted in.
# @docs("django-storages Google Cloud backend", https://django-storages.readthedocs.io/en/latest/backends/gcloud.html)
GS_BUCKET_NAME=
GS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Public URL prefix for stored media. Derived from AWS_S3_ENDPOINT_URL when
# that is set, "media/" otherwise.
MEDIA_URL=
# Filesystem root for the local storage backend. Empty means the image's
# working directory; the compose volume is mounted at /code/uploads.
MEDIA_ROOT=
# Static-file storage class. Whitenoise's manifest storage is what the image
# ships and collectstatic was run against at build.
STATICFILES_STORAGE=whitenoise.storage.CompressedManifestStaticFilesStorage
# URL prefix static assets are served under; also the path prefix whose traces
# GlitchTip's own Sentry integration samples at zero.
STATIC_URL=/

# ─── Ingest limits ───────────────────────────────────────────────────────

# Maximum size in bytes of an event payload after decompression, enforced
# inside the Rust ingest primitive. The DoS ceiling for ingest bodies; 5 MB.
# @type=number
GLITCHTIP_MAX_UNZIPPED_PAYLOAD_SIZE=5242880

# Caps on an uploaded artifact bundle (sourcemap / debug-file zip), added in
# 6.2.5 to close a zip-bomb denial of service: total bytes actually written on
# expansion, and number of archive members. Both are also checked against the
# archive before it is opened, because reading a huge central directory alone
# cost over a gigabyte of RAM. Raise only if you genuinely ship bigger bundles.
# @type=number
GLITCHTIP_MAX_UNZIPPED_ARCHIVE_SIZE=536870912
# @type=number
GLITCHTIP_MAX_ARCHIVE_MEMBERS=10000

# Django's raw request-body ceiling, ahead of view handling. Empty means the
# computed default: 15 MB, or GLITCHTIP_MAX_UNZIPPED_PAYLOAD_SIZE + 1 MB if
# that is larger, so the two stay coherent. Multipart uploads spill to disk and
# are not covered by it.
# @type=number
DATA_UPLOAD_MAX_MEMORY_SIZE=
# @type=number
DATA_UPLOAD_MAX_NUMBER_FIELDS=

# One in N event requests checks whether the organization is over quota.
# @type=number
GLITCHTIP_THROTTLE_CHECK_INTERVAL=5000

# ─── Web server (granian) ────────────────────────────────────────────────

# Number of granian worker processes. GlitchTip is ASGI, so raising this only
# helps when you are not scaling by adding containers. WEB_CONCURRENCY is the
# Heroku-style fallback; GRANIAN_WORKERS wins.
# @type=number
# @docs("granian", https://github.com/emmett-framework/granian)
GRANIAN_WORKERS=1
# @type=number
WEB_CONCURRENCY=

# Bind address and port inside the container. The compose exposes container
# port 8000 with no override, so changing PORT (or GRANIAN_PORT, which wins)
# without changing the exposed port breaks routing.
GRANIAN_HOST=0.0.0.0
# @type=port
GRANIAN_PORT=
# @type=port
PORT=8000

# Granian log verbosity, used by the all-in-one role.
# @type=enum(critical, error, warning, info, debug)
GRANIAN_LOG_LEVEL=INFO
# Seconds granian waits for a draining worker before SIGKILL. The entrypoint
# forces 60 when unset. Granian's own default is "never", which lets a stuck
# worker sit at full RSS beside its replacement until the cgroup OOM killer
# steps in.
# @type=number
GRANIAN_WORKERS_KILL_TIMEOUT=60
# RSS in MiB at which a worker is respawned (granian starts the replacement
# first, so traffic is not dropped). Empty lets the all-in-one entrypoint pick
# 50% of the cgroup memory limit, floor 1024, or 2048 with no limit set.
# @type=number
GRANIAN_WORKERS_MAX_RSS=
# Directory granian serves static files from. Empty makes the entrypoint use
# "static" if the image built it, else fall back to whitenoise.
GRANIAN_STATIC_PATH_MOUNT=
# Where the multiprocess Prometheus collector writes when ENABLE_OBSERVABILITY_API
# is on and there is more than one worker. The entrypoint creates and clears it.
PROMETHEUS_MULTIPROC_DIR=

# ─── Worker and process roles ────────────────────────────────────────────

# Which role bin/start.sh runs: "web" (granian only, what the compose's
# glitchtip service uses), "worker", or "all_in_one" (granian plus an embedded
# worker, and the only role that migrates on boot). The compose's worker service
# bypasses this by calling bin/run-worker.sh directly.
# @type=enum(web, worker, all_in_one)
SERVER_ROLE=web

# "true" promotes the web role to all_in_one: one container running requests,
# the worker and the scheduler on one event loop. Suits a small instance; this
# template runs them apart instead.
# @type=boolean
GLITCHTIP_EMBED_WORKER=False

# Set by bin/run-worker.sh, not by you: it drops the web-only Django apps and
# names the process glitchtip-worker in self-reported errors.
# @type=boolean
IS_WORKER=False

# Skips migrate + maintain_partitions at boot. Only the all-in-one entrypoint
# reads it; use it when a pre-deploy hook (this template's `migrate` service,
# or the Helm chart) already ran them.
# @type=boolean
SKIP_INIT=False

# Concurrent asyncio tasks a worker runs. As of 6.2.6 the ingest queue has its
# own lane on top of this, so total concurrency is VTASKS_CONCURRENCY + 12.
# Account for that when sizing DATABASE_POOL_MAX_SIZE.
# @type=number
VTASKS_CONCURRENCY=20
# The dedicated ingest lane's concurrency and batch size, both new in 6.2.6. A
# fetched batch holds every task's payload in memory until it completes, so
# these two multiply into the worker's peak RSS while draining a backlog.
# @type=number
VTASKS_INGEST_CONCURRENCY=12
# @type=number
VTASKS_INGEST_BATCH_COUNT=25

# Seconds between gc.collect() + malloc_trim() passes that hand freed heap
# pages back to the OS. 0 disables.
# @type=number
GLITCHTIP_MALLOC_TRIM_INTERVAL=3600

# Seconds frequently-scheduled tasks are debounced by, and the interval between
# alert notification passes.
# @type=number
TASK_DEBOUNCE_DELAY=30
# @type=number
ALERT_NOTIFICATION_INTERVAL=60
# Most issues packed into a single alert payload.
# @type=number
MAX_ISSUES_PER_ALERT=3

# ─── Logging and self-monitoring ─────────────────────────────────────────

# Python root log level. bin/run-worker.sh exports INFO for the worker process
# when unset, so the two services differ unless you set this explicitly.
# @type=enum(CRITICAL, ERROR, WARNING, INFO, DEBUG)
LOG_LEVEL=WARNING

# Swap the log handler class, e.g. for a JSON formatter.
DJANGO_LOGGING_HANDLER_CLASS=logging.StreamHandler

# GlitchTip can report its own errors to a GlitchTip/Sentry DSN. Pointing it at
# this same instance is supported: an internal transport bypasses HTTP and a
# recursion guard stops the feedback loop.
# @sensitive
SENTRY_DSN=
# Separate DSN handed to the frontend bundle, if you want browser errors
# elsewhere. Defaults to SENTRY_DSN.
# @sensitive
SENTRY_FRONTEND_DSN=
# Fraction of error events sent (1.0 = all) and of traces sampled. Keep the
# trace rate low; static-file paths are always sampled at zero.
# @type=number
SENTRY_SAMPLE_RATE=1.0
# @type=number
SENTRY_TRACES_SAMPLE_RATE=0.01
# Forward log records to the DSN as well as errors.
# @type=boolean
SENTRY_ENABLE_LOGS=False
# Overrides the auto-detection of whether SENTRY_DSN points back at this
# instance, which is what arms the loop guard.
# @type=boolean
SENTRY_SELF_REFERENCING=
# Service name attached to self-reported errors. Empty derives it from the
# role: glitchtip-web, glitchtip-worker, or glitchtip for all-in-one.
SENTRY_SERVICE_NAME=
# Environment tag on self-reported errors, e.g. production.
ENVIRONMENT=

# Prints every inbound event's raw JSON to the log. Development only; it puts
# whatever your SDKs send, PII included, into the container log.
# @type=boolean
EVENT_STORE_DEBUG=False
