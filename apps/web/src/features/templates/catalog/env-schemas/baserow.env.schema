# Baserow 2.3.3 environment schema (@env-spec / varlock format).
#
# The compose pins baserow/baserow:2.3.3, the "all-in-one" image (backend +
# web-frontend + Caddy, with an embedded Postgres + Redis it can start on its
# own). Bumped from this template's prior pin of 1.35.1; the 1.x -> 2.x
# changelog has no docker-compose or env-wiring changes, only application
# (API/UI) breaking changes, so no compose edits were required.
#
# Source: grep of `deploy/all-in-one/supervisor/default_baserow_env.sh`,
# `deploy/all-in-one/baserow.sh`, `deploy/all-in-one/supervisor/start.sh` and
# `backend/src/baserow/config/settings/base.py` (the `os.getenv` /
# `set_settings_from_env_if_present` reads) at v2.3.3, cross-checked against
# the live "Configuring Baserow" reference page (verified below). One thing
# that page gets wrong: its "User file upload Configuration" table lists a
# `GC_*` row for Google Cloud Storage passthrough. The code (base.py) only
# ever reads that prefix as `GS_*`, never `GC_*`.
#
# The compose sets only BASEROW_PUBLIC_URL and SECRET_KEY, both as plain
# `${VAR}` operator substitutions matching this template's requiredEnv.
# Everything else below documents the all-in-one image's real config
# surface: leaving it all blank is a fully working single-container install
# with an embedded Postgres + Redis, generating its own secrets on first
# boot (BASEROW_PUBLIC_URL/SECRET_KEY are the two this template still asks
# for explicitly).

# @defaultSensitive=false @defaultRequired=infer
# @docs("Configuring Baserow", https://baserow.io/docs/installation%2Fconfiguration)
# ---

# ─── Core / Access ─────────────────────────────────────────────────────────
# @docs("Access Configuration", https://baserow.io/docs/installation%2Fconfiguration#access-configuration)

# The URL you access Baserow at (must include http:// or https://, plus a
# non-standard port if used). Drives OAuth-style callback links, emailed
# links, and the Django ALLOWED_HOSTS check. Compose passes this straight
# through with no default, so an empty value is refused at boot rather than
# silently falling back to the upstream default of `localhost`.
# @required @type=url
BASEROW_PUBLIC_URL=

# Django's cryptographic signing key (password reset links, sessions). If
# left unset upstream would auto-generate and persist one to
# /baserow/data/.secret, but this template asks for it explicitly so it
# survives a volume reset.
# @required @sensitive
SECRET_KEY=

# Signs JWT access/refresh tokens. Defaults to SECRET_KEY's value when
# blank; only set separately if you want to rotate JWTs without also
# invalidating password-reset links signed with SECRET_KEY.
# @sensitive
BASEROW_JWT_SIGNING_KEY=

# Comma-separated extra hostnames added to Django's ALLOWED_HOSTS. Usually
# unnecessary, since the host in BASEROW_PUBLIC_URL is added automatically.
BASEROW_EXTRA_ALLOWED_HOSTS=

# Where the container stores its data (embedded Postgres/Redis, media,
# plugins) when left at the image default. The compose volume is mounted at
# /baserow/data, matching this default. Change it and the volume stops
# covering the data directory.
DATA_DIR=/baserow/data

# ─── External Postgres (optional) ──────────────────────────────────────────
# Blank across this whole section (the default) means: use the embedded
# Postgres the container starts for itself. Set DATABASE_HOST (or
# DATABASE_URL) to point at an external server instead.
# @docs("Backend Database Configuration", https://baserow.io/docs/installation%2Fconfiguration#backend-database-configuration)

DATABASE_HOST=
# @type=port
DATABASE_PORT=5432
DATABASE_NAME=baserow
DATABASE_USER=baserow
# Blank with an external DATABASE_HOST is invalid; blank with the embedded
# database means one is auto-generated and persisted to
# /baserow/data/.pgpass.
# @sensitive
DATABASE_PASSWORD=
# Full connection string; overrides every DATABASE_* field above when set.
# Format: postgresql://user:password@host:port/dbname
# @sensitive
DATABASE_URL=

# Applies pending Django migrations automatically on startup. Turn off only
# if you run migrations yourself during upgrades.
# @type=boolean
MIGRATE_ON_STARTUP=true

# ─── External Redis (optional) ─────────────────────────────────────────────
# Same pattern as Postgres above: blank means the embedded Redis the
# container starts for itself.
# @docs("Redis Configuration", https://baserow.io/docs/installation%2Fconfiguration#redis-configuration)

REDIS_HOST=
# @type=port
REDIS_PORT=6379
REDIS_USER=
# Blank with the embedded Redis means one is auto-generated and persisted to
# /baserow/data/.redispass.
# @sensitive
REDIS_PASSWORD=
# Full connection string; overrides every REDIS_* field above when set.
# Format: redis://:password@host:port
# @sensitive
REDIS_URL=

# ─── Workers ────────────────────────────────────────────────────────────────
# @docs("Celery Configuration", https://baserow.io/docs/installation%2Fconfiguration#celery-configuration)

# Concurrent Celery worker processes for background jobs (imports, exports,
# webhooks, periodic field updates). The all-in-one image defaults to 1 to
# keep the single container's memory footprint small.
# @type=number
BASEROW_AMOUNT_OF_WORKERS=1

# Concurrent gunicorn worker processes serving the backend API.
# @type=number
BASEROW_AMOUNT_OF_GUNICORN_WORKERS=3

# When BASEROW_AMOUNT_OF_WORKERS is 1, runs export tasks on that same
# worker instead of spawning a dedicated export-worker process. Lowers
# memory use at the cost of export/normal tasks competing for the one
# worker.
# @type=boolean
BASEROW_RUN_MINIMAL=false

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# With EMAIL_SMTP unset, Baserow logs emails to the Celery worker log
# instead of sending them: invites, password resets, and notifications all
# go nowhere until this section is filled in.
# @docs("Email Configuration", https://baserow.io/docs/installation%2Fconfiguration#email-configuration)

FROM_EMAIL=
# Turns on SMTP sending; without it every other EMAIL_SMTP_* value is
# ignored.
# @type=boolean
EMAIL_SMTP=false
# @type=boolean
EMAIL_SMTP_USE_TLS=false
# @type=boolean
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_HOST=
# @type=port
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
# @sensitive
EMAIL_SMTP_PASSWORD=

# ─── Object storage (S3-compatible, optional) ──────────────────────────────
# Unset, user-uploaded files (attachments, exports, avatars) are stored on
# the container's own disk under DATA_DIR/media, covered by the compose
# volume. Setting AWS_ACCESS_KEY_ID switches Baserow to an S3-compatible
# bucket instead. Google Cloud Storage (GS_*) and Azure Blob (AZURE_*) are
# also supported by the code but not enumerated here. See the docs link.
# @docs("User file upload Configuration", https://baserow.io/docs/installation%2Fconfiguration#user-file-upload-configuration)

AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# For S3-compatible providers other than AWS (MinIO, R2, Spaces, ...).
# @type=url
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Overrides where uploaded-file URLs point; useful to serve media from an
# isolated domain. Defaults to <backend url>/media/.
# @type=url
MEDIA_URL=

# ─── Reverse proxy & monitoring ────────────────────────────────────────────

# Set when Baserow sits behind a TLS-terminating reverse proxy, so it emits
# https:// links in paginated API responses instead of http://.
# @type=boolean
BASEROW_ENABLE_SECURE_PROXY_SSL_HEADER=false

# Sentry DSN for backend + frontend error monitoring. Blank disables it.
# @sensitive @type=url
SENTRY_DSN=

# ─── Misc ───────────────────────────────────────────────────────────────────
# @docs("Backend Misc Configuration", https://baserow.io/docs/installation%2Fconfiguration#misc-configuration)

BASEROW_BACKEND_LOG_LEVEL=INFO

# Starts only the MIT-licensed open-source build, skipping the
# premium/enterprise code paths entirely.
# @type=boolean
BASEROW_OSS_ONLY=false
