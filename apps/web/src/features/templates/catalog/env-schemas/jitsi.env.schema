# Jitsi Meet stable-11146-2 environment schema (@env-spec / varlock format).
#
# The stack runs four images, released together and required to carry the SAME
# tag: ghcr.io/jitsi/web, ghcr.io/jitsi/prosody, ghcr.io/jitsi/jicofo and
# ghcr.io/jitsi/jvb, all at stable-11146-2 (2026-08-17).
#
# Registry note: stable-11146 moved image publishing from Docker Hub to GHCR
# (docker-jitsi-meet PR #2271). The old `jitsi/*` Docker Hub repos stopped at
# stable-11031 (2026-06-08) and no longer receive releases, so the compose
# pulls from ghcr.io/jitsi/*.
#
# Source: `env.example` and the per-image confd/tpl templates under
# `<image>/rootfs/defaults/` and `<image>/rootfs/etc/s6-overlay/scripts/` in
# jitsi/docker-jitsi-meet at tag stable-11146-2 (source tarball, grepped for
# `.Env.<NAME>` and shell `$NAME` reads). docker-jitsi-meet is entirely
# env-driven: every container renders its real config from these templates at
# boot, so the templates (not the handbook) are the truth for defaults.
#
# Where env.example and the templates disagree, the templates win and are used
# below. Two variables are listed by env.example and by upstream's compose but
# are read by NOTHING at this tag and are therefore omitted here:
# JICOFO_MAX_MEMORY and VIDEOBRIDGE_MAX_MEMORY.
#
# Not enumerated: the web image alone accepts ~250 `config.js` / `interface_
# config.js` passthrough switches, and jicofo/jvb another ~120 tuning knobs.
# They are exhaustively documented upstream (see the reference link below and
# env.example); this schema covers everything the compose sets plus the groups
# an operator actually touches: URLs and TLS, XMPP wiring, component
# credentials, authentication, JWT, recording, Etherpad, and JVB media / NAT /
# TURN.
#
# This deployment terminates TLS at the platform edge, so the compose sets
# DISABLE_HTTPS=1 and ENABLE_LETSENCRYPT=0 and publishes the web container's
# unprivileged port 8000 (stable-11146 made every image rootless; web moved
# from 80/443 to 8000/8443).

# @defaultSensitive=false @defaultRequired=infer
# @docs("Self-Hosting Jitsi Meet with Docker", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/)
# ---

# ─── Public URL & timezone ────────────────────────────────────────────────

# Platform prompt key for the instance's public URL, threaded unchanged into
# PUBLIC_URL on both web and prosody. Every link, XMPP BOSH/WebSocket origin
# and deep link the client builds comes from it, so it must be the URL users
# actually reach (scheme included, and the port too if non-standard).
# @required
# @type=url
# @docs("Self-Hosting Jitsi Meet with Docker", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/)
JITSI_PUBLIC_URL=

# The public URL as the containers see it. Set by the compose from
# JITSI_PUBLIC_URL above, on both `web` and `prosody`.
# @required
# @type=url
PUBLIC_URL=${JITSI_PUBLIC_URL}

# Container timezone, set on all four services. Affects log timestamps and
# scheduled work only.
TZ=UTC

# ─── TLS at the edge ──────────────────────────────────────────────────────

# "1" makes the web container serve plain HTTP on 8000 and skip all TLS
# material. That is what this stack wants: the platform terminates HTTPS in
# front of it. Set to "0" only if you expose the container directly and want
# it to hold the certificate itself, in which case /storage must be a writable
# volume, because the container refuses to boot otherwise.
# @type=boolean
# @docs("Disable HTTPS", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#disable-https)
DISABLE_HTTPS=1

# "1" has the web container obtain and renew its own Let's Encrypt
# certificate with acme.sh. Meaningless while DISABLE_HTTPS=1, and pointless
# behind the platform edge. Since stable-11146-2 renewal runs as a rootless
# s6 service instead of cron.
# @type=boolean
# @docs("Let's Encrypt configuration", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#lets-encrypt-configuration)
ENABLE_LETSENCRYPT=0

# Domain the certificate is issued for; must resolve to this host publicly.
# Only read when ENABLE_LETSENCRYPT=1.
LETSENCRYPT_DOMAIN=

# Mandatory account e-mail for the ACME registration. Only read when
# ENABLE_LETSENCRYPT=1.
# @type=email
LETSENCRYPT_EMAIL=

# "1" issues against the ACME staging endpoint (untrusted certs, no rate
# limits). Use it for testing the issuance path only.
# @type=boolean
LETSENCRYPT_USE_STAGING=0

# "1" makes the web container redirect plain HTTP to HTTPS itself. Leave off
# when a proxy in front already does it, or you get a redirect loop.
# @type=boolean
ENABLE_HTTP_REDIRECT=0

# Sends Strict-Transport-Security from the web container. Harmless but
# redundant when the edge already sets it; turn off if you are still serving
# any part of the origin over plain HTTP.
# @type=boolean
ENABLE_HSTS=1

# ─── XMPP wiring (platform-owned) ─────────────────────────────────────────

# Hostname of the bundled prosody service. Set by the compose to the
# platform's own reference for the sibling container on web, jicofo and jvb;
# never type a literal here.
# @required
# @docs("Architecture", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#architecture)
XMPP_SERVER=${{stack.prosody.HOST}}

# Base URL nginx in the web container proxies /http-bind and /xmpp-websocket
# to. Points at prosody's HTTP port (5280) on the sibling container.
# @required
# @type=url
XMPP_BOSH_URL_BASE=http://${{stack.prosody.HOST}}:5280

# Prosody's client port, used by jicofo and jvb. The compose leaves it at the
# image default.
# @type=port
XMPP_PORT=5222

# The internal XMPP virtual hosts. These are private to the stack (never
# resolved in DNS, nothing to do with your public domain), but every component
# has to agree on them, so all four services are given the same values.
# Changing one after first boot invalidates the accounts and self-signed
# certificates prosody already generated.
XMPP_DOMAIN=meet.jitsi
# Host that holds the component accounts (focus, jvb, jibri, jigasi).
XMPP_AUTH_DOMAIN=auth.meet.jitsi
# MUC host that conference rooms live on.
XMPP_MUC_DOMAIN=muc.meet.jitsi
# Anonymous host guests are authenticated against when ENABLE_GUESTS=1.
XMPP_GUEST_DOMAIN=guest.meet.jitsi
# Hidden host for the Jibri recorder, so recorders are not shown as
# participants.
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
# Internal MUC host used for the jvb/jibri/jigasi "brewery" rooms that
# jicofo discovers components in.
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi

# Comma-separated extra prosody modules loaded on the internal MUC host. The
# compose sets it empty. Note this knob is consumed by prosody's config
# template; the compose happens to declare it on the jvb service, where it is
# inert.
XMPP_INTERNAL_MUC_MODULES=

# ─── Component credentials (inter-component XMPP secrets) ─────────────────
# Prosody CREATES these accounts from the values below and jicofo/jvb (and,
# if deployed, jibri/jigasi) AUTHENTICATE with them, so each password has to
# be identical on both sides. Upstream ships them EMPTY in env.example and
# provides gen-passwords.sh (openssl rand -hex 16) precisely because the
# setup used to have shared defaults and they were unsafe: anyone who can
# reach prosody's XMPP port with a known or reused password can register as
# `focus` or `jvb`, join every conference, and inject or intercept media.
# Generate a distinct random value per variable, never reuse one across
# components or across deployments. Prosody hard-fails at boot ("FATAL
# ERROR: Jicofo auth password must be set") if the jicofo or jvb password is
# empty.

# Local part of the focus account jicofo authenticates as.
# @required
# @docs("Security note", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#security-note)
JICOFO_AUTH_USER=focus

# Password for the focus account, on prosody (account creation) and jicofo
# (login). Platform prompt key; generate with `openssl rand -hex 16`. A
# placeholder or shared value lets anyone reaching the XMPP port impersonate
# the conference focus.
# @required
# @sensitive
# @docs("gen-passwords.sh", https://github.com/jitsi/docker-jitsi-meet/blob/stable-11146-2/gen-passwords.sh)
JICOFO_AUTH_PASSWORD=

# Legacy XMPP component secret for jicofo. Still prompted and still passed to
# prosody and jicofo by the compose, but no config template at
# stable-11146-2 reads it, because jicofo authenticates as a client account
# (JICOFO_AUTH_USER/PASSWORD) now. Kept so the value survives if a future
# release wires it back; treat it like the other secrets and give it its own
# random value.
# @required
# @sensitive
JICOFO_COMPONENT_SECRET=

# Local part of the account the video bridge authenticates as.
# @required
JVB_AUTH_USER=jvb

# Password for the jvb account, on prosody (account creation) and jvb
# (login). Platform prompt key; generate with `openssl rand -hex 16`. With a
# guessable value an attacker can register a rogue bridge in the brewery MUC
# and have jicofo route real conferences through it.
# @required
# @sensitive
JVB_AUTH_PASSWORD=

# Jigasi (SIP gateway) account. Not part of this stack; set only if you add
# the jigasi service. Same rule: unique random value, never a placeholder.
# @sensitive
# @docs("Jigasi SIP gateway configuration", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#jigasi-sip-gateway-audio-only-configuration)
JIGASI_XMPP_PASSWORD=
JIGASI_XMPP_USER=jigasi

# Jigasi transcriber account, used when ENABLE_TRANSCRIPTIONS=1.
# @sensitive
JIGASI_TRANSCRIBER_PASSWORD=
JIGASI_TRANSCRIBER_USER=transcriber

# Jibri (recording / live streaming) accounts. Not part of this stack. Set
# only if you add the jibri service. JIBRI_RECORDER_* is the hidden recorder
# participant on XMPP_RECORDER_DOMAIN, JIBRI_XMPP_* is the control account
# jibri uses to join the brewery MUC. Both must be unique random values: a
# known password here means an outsider can register a recorder and receive
# every conference's media.
# @sensitive
# @docs("Recording / live streaming with Jibri", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#recording--live-streaming-configuration-with-jibri)
JIBRI_RECORDER_PASSWORD=
JIBRI_RECORDER_USER=recorder
# @sensitive
JIBRI_XMPP_PASSWORD=
JIBRI_XMPP_USER=jibri

# ─── Authentication & guest access ────────────────────────────────────────

# "0" is an OPEN instance: anyone who can reach the URL can create a room
# with any name and invite anyone. That is fine for a private network, and
# abusable on the public internet. Open Jitsi instances get used as free
# relay for spam, harassment and worse, and your bandwidth pays for it. Set
# to "1" and pick an AUTH_TYPE before exposing this publicly.
# @required
# @type=boolean
# @docs("Authentication", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#authentication)
ENABLE_AUTH=0

# "1" lets unauthenticated users JOIN a room that an authenticated user has
# already created (with ENABLE_AUTH=1) or, with ENABLE_AUTH=0, simply lets
# everyone in. Set to "0" together with ENABLE_AUTH=1 for a fully closed
# instance where every participant must log in.
# @required
# @type=boolean
ENABLE_GUESTS=1

# Which backend prosody authenticates against when ENABLE_AUTH=1.
# `internal` uses accounts you create with `prosodyctl --config
# /config/prosody.cfg.lua register <user> meet.jitsi <password>` inside the
# prosody container; `jwt` accepts signed tokens; `ldap` and `matrix`
# delegate. Ignored while ENABLE_AUTH=0.
# @required
# @type=enum(internal, jwt, ldap, matrix)
# @docs("Internal authentication", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#internal-authentication)
AUTH_TYPE=internal

# Registers the auth virtual host so component accounts can log in. Leave on;
# jicofo and jvb need it even when ENABLE_AUTH=0.
# @type=boolean
ENABLE_AUTH_DOMAIN=true

# Knock-to-enter lobby. On by default at this version; moderators admit
# waiting participants one by one.
# @type=boolean
ENABLE_LOBBY=true

# ─── JWT authentication (AUTH_TYPE=jwt) ───────────────────────────────────

# Token `aud`/application identifier your issuer puts in the JWT. Required
# when AUTH_TYPE=jwt; ignored otherwise.
# @docs("Authentication using JWT tokens", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#authentication-using-jwt-tokens)
JWT_APP_ID=

# HS256 shared secret prosody verifies tokens with. Anyone holding it can
# mint a token for any room and any display name, so treat it exactly like
# the component passwords. Leave empty to use JWT_ASAP_KEYSERVER (RS256)
# instead.
# @sensitive
JWT_APP_SECRET=

# Comma-separated list of accepted `iss` values.
JWT_ACCEPTED_ISSUERS=

# Comma-separated list of accepted `aud` values.
JWT_ACCEPTED_AUDIENCES=

# Base URL of a public-key server for ASAP/RS256 tokens; when set, prosody
# fetches the signing key by the token's `kid` instead of using
# JWT_APP_SECRET.
# @type=url
JWT_ASAP_KEYSERVER=

# "1" allows an EMPTY token through, i.e. anonymous access alongside JWT.
# Turning this on defeats the point of requiring tokens.
# @type=boolean
JWT_ALLOW_EMPTY=0

# Prosody authentication provider name. `token` is the standard JWT provider.
JWT_AUTH_TYPE=token

# "true" additionally requires the token's room claim to match the room being
# joined.
# @type=boolean
JWT_ENABLE_DOMAIN_VERIFICATION=false

# ─── Recording, streaming & transcription ─────────────────────────────────
# All of these need extra services this template does not deploy (jibri for
# recording and streaming, jigasi for transcription). They are listed so you
# know which switch to flip if you add them.

# Master switch for Jibri-backed recording/streaming; read by both web (UI)
# and jicofo (dispatch). Does nothing without a running jibri.
# @type=boolean
# @docs("Recording / live streaming with Jibri", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#recording--live-streaming-configuration-with-jibri)
ENABLE_RECORDING=false

# Server-side ("service") recording toggle in the client UI. Defaults to
# whatever ENABLE_RECORDING is.
# @type=boolean
ENABLE_SERVICE_RECORDING=

# "true" hides the in-browser local recording option from the UI.
# @type=boolean
DISABLE_LOCAL_RECORDING=false

# "true" notifies every participant when a local recording starts.
# @type=boolean
ENABLE_LOCAL_RECORDING_NOTIFY_ALL_PARTICIPANT=false

# "true" offers a download/share link for finished recordings.
# @type=boolean
ENABLE_FILE_RECORDING_SHARING=false

# MUC room jicofo discovers jibri instances in; both sides must match.
JIBRI_BREWERY_MUC=jibribrewery

# How long jicofo waits for a jibri to pick up a recording request.
JIBRI_PENDING_TIMEOUT=90 seconds

# Live captions / transcription via jigasi. Needs a jigasi service and a
# speech-to-text backend.
# @type=boolean
# @docs("Transcription configuration", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#transcription-configuration)
ENABLE_TRANSCRIPTIONS=false

# MUC room jicofo discovers jigasi instances in.
JIGASI_BREWERY_MUC=jigasibrewery

# ─── Shared documents (Etherpad) ──────────────────────────────────────────

# In-network base URL of an etherpad-lite container, e.g.
# http://etherpad.meet.jitsi:9001. Setting it makes nginx in the web
# container proxy /etherpad and turns on the shared-document button. Empty
# disables the feature.
# @type=url
# @docs("Shared document editing using Etherpad", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#shared-document-editing-using-etherpad)
ETHERPAD_URL_BASE=

# Public URL of the pad, INCLUDING the trailing /p/ path fragment. Takes
# precedence over ETHERPAD_URL_BASE for what the browser is told to load;
# set it when the pad is reachable on its own hostname.
# @type=url
ETHERPAD_PUBLIC_URL=

# ─── JVB media, NAT and ports ─────────────────────────────────────────────

# Platform prompt key: the PUBLIC IPv4 address participants must send media
# to. The bridge cannot discover it from inside the container, so an
# unreachable or wrong value means everyone connects and then sees no audio
# or video. Get it with `curl -s https://ifconfig.me`.
# @required
# @docs("Running behind NAT or on a LAN", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#running-behind-nat-or-on-a-lan-environment)
JVB_ADVERTISE_IP=

# The address the bridge advertises, set by the compose from
# JVB_ADVERTISE_IP. This name is DEPRECATED upstream in favour of
# JVB_ADVERTISE_IPS (the bridge logs a warning and copies the value across at
# boot); it still works at stable-11146-2.
JVB_ADVERTISE_IP_LEGACY_NOTE=
DOCKER_HOST_ADDRESS=${JVB_ADVERTISE_IP}

# Replacement for DOCKER_HOST_ADDRESS: a comma-separated list of addresses,
# each optionally suffixed with `#port` when the externally visible port
# differs from JVB_PORT (`#` because IPv6 addresses already contain `:`).
# Leave empty to keep using DOCKER_HOST_ADDRESS above.
JVB_ADVERTISE_IPS=

# UDP port the bridge binds and advertises for RTP. Must be open end-to-end;
# the compose publishes exactly this port as UDP. Changing it here without
# changing the published port breaks all media.
# @type=port
JVB_PORT=10000

# "true" also advertises the container's private candidates. Useful on a LAN,
# harmless behind NAT.
# @type=boolean
JVB_ADVERTISE_PRIVATE_CANDIDATES=true

# "1"/"true" turns off the bridge's outbound STUN lookup. Set it for an
# airgapped deployment, where the lookup can only fail and delay startup.
# @type=boolean
JVB_DISABLE_STUN=0

# STUN server the bridge asks for its own reflexive address. The default is
# Jitsi's public relay; point it at your own, or disable STUN entirely, if
# you do not want that outbound dependency.
JVB_STUN_SERVERS=meet-jit-si-turnrelay.jitsi.net:443

# MUC room jicofo discovers bridges in; jicofo and every jvb must agree.
JVB_BREWERY_MUC=jvbbrewery

# Nickname the bridge joins the brewery MUC under. Empty means the container
# hostname, which is what you want with a single bridge.
JVB_MUC_NICKNAME=

# "true" exposes the bridge's COLIBRI REST API on 8080. Debug/stats only;
# do not publish that port.
# @type=boolean
COLIBRI_REST_ENABLED=false

# ─── TURN / STUN advertised to clients ────────────────────────────────────
# Prosody advertises these to browsers so participants behind restrictive
# firewalls can still reach media. Optional: with a public JVB_ADVERTISE_IP
# and UDP 10000 open, direct connections work without them.

# Hostname of a plain (non-TLS) TURN server; comma-separated for several.
# @docs("TURN server configuration", https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/#turn-server-configuration)
TURN_HOST=
# @type=port
TURN_PORT=443
# Comma-separated transports to advertise for TURN_HOST.
# @type=enum(tcp, udp)
TURN_TRANSPORT=tcp

# Hostname of a TURNS (TLS) server; comma-separated for several.
TURNS_HOST=
# @type=port
TURNS_PORT=443

# Shared secret prosody uses to mint time-limited TURN credentials
# (coturn's `static-auth-secret`). Must match the TURN server's own secret.
# @sensitive
TURN_CREDENTIALS=

# Static TURN username/password, as an alternative to TURN_CREDENTIALS.
TURN_USERNAME=
# @sensitive
TURN_PASSWORD=

# Lifetime in seconds of the credentials prosody hands out.
# @type=number
TURN_TTL=86400

# Standalone STUN server advertised to clients.
STUN_HOST=
# @type=port
STUN_PORT=443

# ─── Meeting defaults (subset) ────────────────────────────────────────────
# A small, commonly-changed slice of the web image's config.js passthrough.
# The complete list of ~250 switches is documented upstream in env.example
# and the handbook's advanced configuration section.

# "1" keeps the XMPP WebSocket transport on (BOSH is the fallback). Turning
# it off is only needed behind proxies that cannot upgrade connections.
# @type=boolean
# @docs("env.example at stable-11146-2", https://github.com/jitsi/docker-jitsi-meet/blob/stable-11146-2/env.example)
ENABLE_XMPP_WEBSOCKET=1

# "true" shows the room-picker landing page at /. Set "false" to make the
# root path a dead end and require a room URL.
# @type=boolean
ENABLE_WELCOME_PAGE=true

# "true" shows the device-check screen before joining.
# @type=boolean
ENABLE_PREJOIN_PAGE=true

# "true" allows peer-to-peer mode for 1:1 calls, bypassing the bridge.
# @type=boolean
ENABLE_P2P=true

# "true" enables breakout rooms.
# @type=boolean
ENABLE_BREAKOUT_ROOMS=true

# Default video height requested from the camera, in pixels.
# @type=number
RESOLUTION=720

# @type=boolean
START_WITH_AUDIO_MUTED=false
# @type=boolean
START_WITH_VIDEO_MUTED=false
# "true" joins audio-only by default.
# @type=boolean
START_AUDIO_ONLY=false

# UI language code (e.g. de, fr, es). Empty follows the browser.
DEFAULT_LANGUAGE=

# "1" lets the web container's nginx bind and resolve over IPv6. Turn off on
# hosts without IPv6 or nginx fails to start.
# @type=boolean
ENABLE_IPV6=1
