# Infisical v0.165.2 (image infisical/infisical:v0.165.2) environment schema
# (@env-spec / varlock format).
#
# Source: `backend/src/lib/config/env.ts` at tag v0.165.2. Infisical funnels its
# entire environment through one zod schema in that file, so it (not
# `.env.example`, not the docs page) is the authoritative key list and the
# real source of every default. Cross-checked against
# `docs/self-hosting/configuration/envars.mdx`, `.env.example` and upstream's
# `docker-compose.prod.yml`. Where they disagree, the code wins:
#
#   * The docs give `HOST` a default of `localhost`. That is the *code*
#     default; the standalone image this stack runs bakes HOST=0.0.0.0,
#     PORT=8080, HTTPS_ENABLED=false, NODE_ENV=production, STANDALONE_MODE=true
#     and TELEMETRY_ENABLED=true as image ENV
#     (Dockerfile.standalone-infisical), which is why the compose does not set
#     them and the container is still reachable.
#   * `.env.example` ships a working sample ENCRYPTION_KEY and AUTH_SECRET with
#     a "never use in production" comment above them. They are published values:
#     an instance booted with either has no confidentiality at all. This schema
#     leaves both empty on purpose.
#   * `COOKIE_SECRET_SIGN_KEY` has a hard-coded 64-character default compiled
#     into the source (env.ts). It is public, identical on every unconfigured
#     instance, and it signs the SAML/OIDC/LDAP login session cookies. Left
#     empty here rather than repeated, because writing it down would ship an
#     example secret; set your own.
#   * `ENCRYPTION_KEY` is `optional()` in the zod schema, which reads as if the
#     instance can boot without it. It cannot: KMS init calls
#     `resolveInstanceEncryptionKeyBuffer` (services/kms/kms-fns.ts), which
#     throws "Instance encryption key not found" unless ENCRYPTION_KEY or
#     ROOT_ENCRYPTION_KEY resolves to exactly 32 bytes.
#   * Redis is a hard dependency, enforced by a `.refine` on the schema: the
#     process exits unless one of REDIS_URL / REDIS_SENTINEL_HOSTS /
#     REDIS_CLUSTER_HOSTS is set.
#   * `AUDIT_LOG_STREAMS_ENABLED` and `CLICKHOUSE_AUDIT_LOG_ENABLED` default to
#     true but are inert until a ClickHouse URL / a stream is configured.
#
# Scope: env.ts declares ~270 keys. This file declares the ones a self-hosted
# single-container deployment can actually act on. Deliberately omitted:
# Infisical Cloud-only keys (INFISICAL_CLOUD, INTERCOM_ID, LOOPS_API_KEY,
# HUBSPOT_*, CONTENTFUL_*, PYLON_API_KEY, POSTHOG_*, INTERNAL_REGION),
# Datadog tracer keys, the Go-sidecar shadow flags, dev/test-only switches
# (*_DEVELOPMENT_MODE, BDD_NOCK_API_ENABLED), and the long tail of
# per-provider INF_APP_CONNECTION_* / CLIENT_*_ integration credentials beyond
# the common ones below. All are read at v0.165.2, none needed to run.
#
# The compose prompts for SITE_URL, ENCRYPTION_KEY, AUTH_SECRET and
# POSTGRES_PASSWORD. Nothing else is required: the first visit to SITE_URL
# runs the admin signup that creates the instance's first organization.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Infisical environment variables", https://infisical.com/docs/self-hosting/configuration/envars)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Absolute public URL of this instance, protocol included, in the form
# `scheme://secrets.example.com`; a trailing slash is stripped at parse time.
# Everything user-facing is built from it: the links in invite, password-reset
# and MFA emails, the OAuth/SAML/OIDC callback URLs handed to identity
# providers, and the default CORS allow-list. The app boots with a wrong value
# but SSO callbacks and every emailed link then point at the wrong host.
# @required
# @type=url
# @docs("Infisical environment variables", https://infisical.com/docs/self-hosting/configuration/envars)
SITE_URL=

# TCP port the API/UI listens on inside the container. The image sets 8080 and
# the compose exposes container port 8080 without overriding this, so the two
# are twins: change one without the other and routing breaks.
# @type=port
PORT=8080

# Bind address inside the container. The code default is `localhost`; the
# standalone image overrides it to `0.0.0.0`, which is what the container
# network needs. Narrowing it makes the service unreachable from the proxy.
HOST=0.0.0.0

# Baked into the image already; the compose repeats it. `development` turns on
# dev-only behavior (looser cookies, verbose errors) and is not meant for a
# deployed instance.
# @type=enum(production, development, test)
NODE_ENV=production

# Whether Infisical believes it is being served over HTTPS. The image sets
# `false` because TLS terminates at the proxy in front of it. It gates the
# `Secure` attribute on session cookies, so if you terminate TLS in the
# container itself, set it to `true`.
# @type=boolean
HTTPS_ENABLED=false

# Comma-separated CIDRs (or the aliases `loopback`, `linklocal`,
# `uniquelocal`) of the reverse proxies whose `X-Forwarded-For` header this
# instance should believe. Unset keeps the legacy behavior of trusting the
# header from ANY source, which lets a client spoof its source IP and slip
# past identity IP allow-lists and rate limits. Set it to your proxy's range.
# @docs("Production hardening", https://infisical.com/docs/self-hosting/guides/production-hardening)
TRUSTED_PROXY_CIDRS=

# JSON array of origins allowed to call the API cross-origin, e.g.
# `["scheme://secrets.example.com"]`. Empty means "just SITE_URL", which is
# correct for a normal deployment; malformed JSON throws at boot.
CORS_ALLOWED_ORIGINS=

# JSON array of request headers allowed on cross-origin calls. Empty reflects
# whatever the browser asks for in `Access-Control-Request-Headers`.
CORS_ALLOWED_HEADERS=

# `true` puts the instance in maintenance mode: a server-wide plugin rejects
# mutating requests so long-running migrations can finish undisturbed.
# @type=boolean
MAINTENANCE_MODE=false

# Name given to the organization created by the very first admin signup (or by
# the automated bootstrap endpoint). Only read at that moment; renaming later
# happens in the UI. Falls back to "Admin Org".
# @docs("Automated bootstrapping", https://infisical.com/docs/self-hosting/guides/automated-bootstrapping)
INITIAL_ORGANIZATION_NAME=

# Anonymous product telemetry, on by default in the image. `false` stops the
# outbound analytics calls entirely, the usual choice for an air-gapped or
# privacy-sensitive install.
# @type=boolean
TELEMETRY_ENABLED=true

# Once a week (and at startup) the instance asks GitHub for the latest release
# and shows an "update available" hint. `true` suppresses the request; set it
# on air-gapped instances.
# @type=boolean
DISABLE_UPDATE_CHECK=false

# Turns off the built-in secret scanning feature for the whole instance (the
# UI hides it). Independent of the Radar GitHub App keys further down.
# @type=boolean
DISABLE_SECRET_SCANNING=false

# Turns off public secret sharing (the unauthenticated share links) for the
# whole instance.
# @type=boolean
DISABLE_PUBLIC_SECRET_SHARING=false

# ─── Instance encryption key ───────────────────────────────────────────────
# This is a secrets manager: the two values below are the entire boundary
# between "an encrypted database" and "a plaintext dump of every credential
# your organization stores".

# The root key of the whole instance. It is the AES key that wraps every
# internal KMS key, and those keys in turn encrypt every secret, every dynamic
# secret lease, every PKI private key, every app-connection credential and
# every integration token in the database. Must resolve to exactly 32 bytes: a
# 16-byte hex string (`openssl rand -hex 16`) read as UTF-8, or, for FIPS
# builds, a base64 256-bit key (`openssl rand -base64 32`). Anything else and
# the instance refuses to start with a byte-count error.
#
# What is at risk if it is weak, guessable, copied from a tutorial or reused:
# everything. Anyone who holds this value plus a database dump (a backup file,
# a snapshot, a compromised replica) can decrypt every secret Infisical holds,
# offline, without touching the app, without a login, without leaving an audit
# log entry. The published sample key in upstream's `.env.example`
# (`f13dbc92aaaf86fa7cb0ed8ac3265f47`) is the worst case of this: it is in
# every clone of the repository. Generate a unique key, store it somewhere
# other than this instance, and never reuse it across environments.
#
# Rotating it is NOT a matter of editing this value. Booting with a different
# key leaves every stored ciphertext undecryptable: the instance comes up and
# every secret read fails, because the KMS keys in the database are still
# wrapped with the old one. Rotate through Admin > Encryption ("Generate new
# key"), which re-wraps the KMS keys and keeps the previous key valid for a
# convergence window, then deploy the new value.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("Rotating the encryption key", https://infisical.com/docs/self-hosting/guides/rotating-the-encryption-key)
ENCRYPTION_KEY=

# The older name for the same thing, still read as a fallback when
# ENCRYPTION_KEY is unset, with one difference: ROOT_ENCRYPTION_KEY is
# decoded as base64, ENCRYPTION_KEY as UTF-8, so the same string under the two
# names produces two different AES keys. Leave empty on a new install; only
# set it if you are carrying an existing instance forward, and never set both.
# @sensitive
# @type=string(minLength=32)
# @docs("Rotating the encryption key", https://infisical.com/docs/self-hosting/guides/rotating-the-encryption-key)
ROOT_ENCRYPTION_KEY=

# How long a superseded root key stays archived after a rotation (1-90 days).
# It is a convergence window, not a rollback window: instances that have not
# restarted onto the new key keep working until it lapses, after which the old
# key material is deleted and any backup still encrypted under it can only be
# read with the copy you kept yourself.
# @type=number
# @docs("Rotating the encryption key", https://infisical.com/docs/self-hosting/guides/rotating-the-encryption-key)
KMS_ROOT_KEY_RETENTION_DAYS=7

# Points the root key at a PKCS#11 hardware security module instead of an
# environment variable: path to the vendor's library inside the container, the
# slot PIN, the key label, and the slot number. All four go together, and the
# HSM path is an enterprise feature. When in use, ENCRYPTION_KEY is still
# required for the initial migration to the HSM.
# @docs("HSM integration", https://infisical.com/docs/self-hosting/guides/hsm-integration)
HSM_LIB_PATH=
# @sensitive
HSM_PIN=
HSM_KEY_LABEL=
# @type=number
HSM_SLOT=0

# ─── Authentication secrets and token lifetimes ────────────────────────────

# The signing key for every JWT this instance issues: user session and refresh
# tokens, machine-identity access tokens, signup/invite/MFA/password-reset
# tokens, and the SSO provider-auth token. Must be a random 32-byte base64
# string (`openssl rand -base64 32`); the instance will not start without it
# (the legacy name JWT_AUTH_SECRET is still accepted as a fallback).
#
# What is at risk if it is weak, reused or copied from a tutorial: anyone who
# can guess or obtain it can forge a token for any user or machine identity
# (including an instance admin) and read or rewrite every secret in every
# project. Password, MFA and SSO are all bypassed, because a token is trusted
# on its signature alone. Sharing it between two deployments means a token
# minted by one is honored by the other. Changing it is a forced global sign
# out: every session, invite link and pending reset dies at that moment,
# which is exactly what you want after a suspected leak.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("Infisical environment variables", https://infisical.com/docs/self-hosting/configuration/envars)
AUTH_SECRET=

# Signs the server-side session cookies used during SAML, OIDC and LDAP login
# handshakes (fastify-session). The source compiles in a default: a fixed,
# published 64-character string that is identical on every instance that never
# sets this, so anyone can mint a valid handshake cookie for such an instance.
# Set your own random 32+ character value; the field is empty here rather than
# echoing the built-in one, which is an example secret by definition.
# @sensitive
# @type=string(minLength=32)
COOKIE_SECRET_SIGN_KEY=

# bcrypt work factor for user password hashes. Higher is slower to brute force
# and slower to log in; the deprecated BCRYPT_SALT_ROUND is still read as a
# fallback. Changing it only affects hashes written after the change.
# @type=number
SALT_ROUNDS=10

# Lifetime of an issued access (session) token, as an `ms` duration string.
# An organization's own "user token expiration" setting can shorten it further
# but never extend it.
JWT_AUTH_LIFETIME=10d

# Lifetime of the refresh token that mints new access tokens, i.e. how long a
# browser stays signed in without re-authenticating.
JWT_REFRESH_LIFETIME=90d

# Lifetime of the short-lived token that carries a user through the signup and
# account-recovery flows.
JWT_SIGNUP_LIFETIME=15m

# How long an emailed organization invite stays redeemable.
JWT_INVITE_LIFETIME=1d

# How long the half-authenticated token between password check and MFA code
# stays valid.
JWT_MFA_LIFETIME=5m

# How long the token issued by an external identity provider callback (SAML,
# OIDC, OAuth login) stays valid while the browser completes the handshake.
JWT_PROVIDER_AUTH_LIFETIME=15m

# Ceiling on how long a machine-identity access token may be configured to
# live, parsed as an `ms` duration and enforced when identities are created or
# updated. Lower it to force CI credentials to rotate more often.
MAX_MACHINE_IDENTITY_TOKEN_AGE=90d

# ─── Bundled Postgres ──────────────────────────────────────────────────────
# The stack runs its own postgres:17-alpine. Infisical applies its migrations
# itself at boot; there is no separate migration step. This database holds
# every secret this instance stores (encrypted under ENCRYPTION_KEY). Back it
# up together with, but stored apart from, that key.

# Connection string, assembled by the compose from the prompted
# POSTGRES_PASSWORD and the database service's hostname. Required; the
# instance exits at boot if it cannot connect. Point it elsewhere only when
# moving to an external Postgres, in which case the bundled service goes
# unused.
# @required
# @sensitive
# @docs("Infisical environment variables", https://infisical.com/docs/self-hosting/configuration/envars)
DB_CONNECTION_URI=postgres://infisical:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/infisical

# Role Infisical connects as, created by the Postgres image on first boot. It
# is baked into DB_CONNECTION_URI above; changing it here alone only breaks
# the pair.
POSTGRES_USER=infisical

# Password for that role, used by both the database container and
# DB_CONNECTION_URI. Only reachable on the stack's private network, but it is
# a full read/write path to the ciphertext of every secret and to every
# password hash. Pair a weak value here with a leaked ENCRYPTION_KEY and the
# instance is fully compromised.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot. Baked into DB_CONNECTION_URI above.
POSTGRES_DB=infisical

# Base64-encoded CA certificate used to verify the Postgres server's TLS
# certificate. Needed only for an external database that presents a private
# CA; the bundled service speaks plaintext on the internal network.
DB_ROOT_CERT=

# Primary connection pool bounds. The bundled Postgres allows 100 connections
# in total, so raising DB_POOL_MAX past ~90 (or running several app replicas)
# trades "slow" for "too many clients" errors. DB_POOL_MIN must be <= max or
# boot validation fails.
# @type=number
DB_POOL_MIN=0
# @type=number
DB_POOL_MAX=10

# JSON array of read-replica connection strings, e.g.
# `[{"DB_CONNECTION_URI":"postgres://..."}]`, with their own pool bounds.
# Empty means every query goes to the primary, which is what this stack runs.
# @sensitive
DB_READ_REPLICAS=
# @type=number
DB_REPLICA_POOL_MIN=0
# @type=number
DB_REPLICA_POOL_MAX=10

# Optional separate Postgres for audit logs, so their volume does not sit on
# the primary. Empty keeps audit logs in the main database.
# @sensitive
AUDIT_LOGS_DB_CONNECTION_URI=
AUDIT_LOGS_DB_ROOT_CERT=
# @type=number
AUDIT_LOGS_DB_POOL_MIN=0
# @type=number
AUDIT_LOGS_DB_POOL_MAX=10

# `true` stops writing audit logs to Postgres, which is only sane once
# ClickHouse or an external log stream is receiving them, otherwise you are
# simply running without an audit trail. (The older DISABLE_AUDIT_LOG_STORAGE
# is deprecated in favor of this one; DISABLE_AUDIT_LOG_GENERATION switches
# them off entirely.)
# @type=boolean
DISABLE_POSTGRES_AUDIT_LOG_STORAGE=
# @type=boolean
DISABLE_AUDIT_LOG_GENERATION=false

# ─── Bundled Redis ─────────────────────────────────────────────────────────
# The stack runs its own redis:7-alpine. Redis is not a cache here: it carries
# the job queues (rotations, syncs, webhooks), scheduler locks and rate-limit
# counters, and the instance refuses to start without one. Give it
# persistence and `maxmemory-policy noeviction`; an evicted queue is lost
# work.

# Redis connection string, pointed at the bundled service by the compose. One
# of REDIS_URL, REDIS_SENTINEL_HOSTS or REDIS_CLUSTER_HOSTS must be set or the
# process exits at boot. Use a `rediss://` URL for TLS.
# @required
# @sensitive
# @docs("Redis configuration", https://infisical.com/docs/self-hosting/configuration/envars#redis)
REDIS_URL=redis://${{stack.redis.HOST}}:6379

# Credentials for an external, authenticated Redis (ACL user and password).
# The bundled instance is unauthenticated on the private network, so both stay
# empty here.
REDIS_USERNAME=
# @sensitive
REDIS_PASSWORD=

# Sentinel mode: comma-separated `host:port` pairs, the monitored master's
# name, and optional TLS plus Sentinel-only credentials. Setting the hosts
# switches Infisical off REDIS_URL onto Sentinel discovery.
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER_NAME=mymaster
# @type=boolean
REDIS_SENTINEL_ENABLE_TLS=
REDIS_SENTINEL_USERNAME=
# @sensitive
REDIS_SENTINEL_PASSWORD=

# Cluster mode: comma-separated `host:port` pairs of the cluster's nodes, with
# optional TLS and an AWS ElastiCache DNS lookup mode. Mutually exclusive in
# practice with the Sentinel block above.
REDIS_CLUSTER_HOSTS=
# @type=boolean
REDIS_CLUSTER_ENABLE_TLS=
# @type=boolean
REDIS_CLUSTER_AWS_ELASTICACHE_DNS_LOOKUP_MODE=false

# Whether this container also runs the BullMQ workers, and which slice of them
# (`all`, `standard`, or `secret-scanning` only). A single-container stack
# must leave this at `all`. With the workers off, rotations, syncs, webhooks
# and emails queue up and never run.
# @type=boolean
QUEUE_WORKERS_ENABLED=true
# @type=enum(all, standard, secret-scanning)
QUEUE_WORKER_PROFILE=all

# ─── Audit log destinations (optional) ─────────────────────────────────────

# ClickHouse connection URL for audit-log storage, e.g.
# `https://user:password@host:8443/database`. Empty (this stack's default)
# means the ClickHouse path stays dormant regardless of the flags below; the
# table name and the `true` default only take effect once a URL is set.
# @sensitive
# @docs("Infisical environment variables", https://infisical.com/docs/self-hosting/configuration/envars)
CLICKHOUSE_URL=
# @type=boolean
CLICKHOUSE_AUDIT_LOG_ENABLED=true
CLICKHOUSE_AUDIT_LOG_TABLE_NAME=audit_logs

# Whether audit events may be forwarded to external log streams (Datadog,
# Splunk, an OTLP collector) configured in the UI. `false` disables the
# feature instance-wide.
# @type=boolean
# @docs("Audit log streams", https://infisical.com/docs/documentation/platform/audit-log-streams/audit-log-streams)
AUDIT_LOG_STREAMS_ENABLED=true

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# Without SMTP an instance still runs, but it cannot send organization
# invites, password resets, MFA codes or approval notifications, so every
# user has to be onboarded some other way.

# SMTP relay hostname and port. Port 465 implies implicit TLS; 587 uses
# STARTTLS.
# @docs("Email configuration", https://infisical.com/docs/self-hosting/configuration/envars#email-service)
SMTP_HOST=
# @type=port
SMTP_PORT=587

# Credentials for the relay. For SendGrid the username is the literal
# `apikey`; for most others it is the mailbox address.
SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=

# Envelope sender. Many relays reject a from-address on a domain they do not
# own, so this usually has to match your verified sending domain.
# @type=email
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Infisical

# Hostname announced in the SMTP EHLO/HELO greeting. Empty makes nodemailer
# use the container's hostname, a random container ID, which relays that
# validate the sender hostname (Gmail SMTP relay, for one) reject.
SMTP_HELO_HOST=

# TLS behavior toward the relay. `SMTP_IGNORE_TLS=true` sends mail in the
# clear on non-465 ports; `SMTP_TLS_REJECT_UNAUTHORIZED=false` accepts any
# certificate, including one an attacker on the path presents. Both weaken a
# channel that carries invite and password-reset links. Prefer
# SMTP_CUSTOM_CA_CERT (PEM contents) for a relay with a private CA.
# @type=boolean
SMTP_IGNORE_TLS=false
# @type=boolean
SMTP_REQUIRE_TLS=true
# @type=boolean
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CUSTOM_CA_CERT=

# ─── SSO and social login ──────────────────────────────────────────────────
# OAuth apps registered with the provider, whose callback URL must be
# SITE_URL + the provider's callback path. SAML, OIDC and LDAP are configured
# per organization in the UI (and are paid features) rather than here.

# Google OAuth client for "Continue with Google".
# @docs("Google SSO", https://infisical.com/docs/documentation/platform/sso/google)
CLIENT_ID_GOOGLE_LOGIN=
# @sensitive
CLIENT_SECRET_GOOGLE_LOGIN=

# GitHub OAuth app for "Continue with GitHub".
# @docs("GitHub SSO", https://infisical.com/docs/documentation/platform/sso/github)
CLIENT_ID_GITHUB_LOGIN=
# @sensitive
CLIENT_SECRET_GITHUB_LOGIN=

# GitLab OAuth application for "Continue with GitLab", plus the base URL of a
# self-managed GitLab if you are not using gitlab.com. (The renamed
# URL_GITLAB_LOGIN is still read as a fallback.)
# @docs("GitLab SSO", https://infisical.com/docs/documentation/platform/sso/gitlab)
CLIENT_ID_GITLAB_LOGIN=
# @sensitive
CLIENT_SECRET_GITLAB_LOGIN=
# @type=url
CLIENT_GITLAB_LOGIN_URL=https://gitlab.com

# Organization slug whose SAML login page unauthenticated visitors are sent to
# instead of the generic form, the way to make SSO the only visible door.
# @docs("SSO overview", https://infisical.com/docs/documentation/platform/sso/overview)
DEFAULT_SAML_ORG_SLUG=

# ─── Licensing (paid tiers) ────────────────────────────────────────────────

# License key for the paid self-hosted tiers, validated against the license
# server; LICENSE_KEY_OFFLINE is the air-gapped variant that carries its own
# signature and needs no outbound call. Empty leaves the instance on the free
# tier, which is fully functional for core secret management.
# @sensitive
# @docs("Infisical enterprise edition", https://infisical.com/docs/self-hosting/ee)
LICENSE_KEY=
# @sensitive
LICENSE_KEY_OFFLINE=
# Host the license and entitlement API is called on. Only change it if
# Infisical gave you a different endpoint.
# @type=url
LICENSE_SERVER_URL=https://portal.infisical.com

# ─── Gateways and relays ───────────────────────────────────────────────────
# A Gateway reaches private resources (databases for dynamic secrets, internal
# APIs) from inside your network, so the instance never needs a route to them.
# These keys configure a self-hosted relay for that tunnel; leave empty to use
# Infisical's managed relay or no gateway at all.

# @docs("Gateways", https://infisical.com/docs/documentation/platform/gateways/overview)
GATEWAY_RELAY_ADDRESS=
GATEWAY_RELAY_REALM=
# Shared secret authenticating gateways to the relay: anyone holding it can
# join the tunnel network this instance trusts for private-network access.
# @sensitive
GATEWAY_RELAY_AUTH_SECRET=
# Same role for the newer relay implementation.
# @sensitive
RELAY_AUTH_SECRET=
# Static egress IP to advertise to gateways when this instance sits behind a
# fixed NAT address.
GATEWAY_INFISICAL_STATIC_IP_ADDRESS=

# ─── Outbound network policy ───────────────────────────────────────────────
# Infisical makes outbound requests on behalf of users (app connections,
# dynamic secrets, webhooks, audit-log streams) and runs them through an
# SSRF-safe client that refuses private IP ranges. These flags relax that.

# Global escape hatch letting app connections, dynamic secrets and PKI
# discovery reach internal/private addresses, and disabling DNS-rebinding pin
# protection on that path. Anyone who can create a connection can then make
# this instance probe your internal network. Prefer a Gateway; if you must,
# prefer the two narrower flags below.
# @type=boolean
# @docs("Gateways", https://infisical.com/docs/documentation/platform/gateways/overview)
ALLOW_INTERNAL_IP_CONNECTIONS=false
# Per-feature variants of the same relaxation, scoped to dynamic secrets and
# to audit-log stream targets respectively.
# @type=boolean
DYNAMIC_SECRET_ALLOW_INTERNAL_IP=false
# @type=boolean
AUDIT_LOG_STREAM_ALLOW_INTERNAL_IP=false

# `true` makes SSRF-checked requests bypass any ambient HTTP_PROXY/HTTPS_PROXY
# so the connection lands on the exact IP that passed validation. Correct only
# if this instance does not need a forward proxy to egress; with a proxy in
# use, leave it off.
# @type=boolean
SAFE_REQUEST_FORCE_DIRECT_EGRESS=false

# ─── Platform app connections (optional) ───────────────────────────────────
# Instance-level credentials for the integrations that cannot be configured
# per project, because they represent an OAuth app or a cloud principal owned
# by the instance. Each is only read when someone creates a connection of
# that type; the rest of the INF_APP_CONNECTION_* family follows the same
# pattern and is omitted here.

# IAM user credentials the AWS connections and AWS dynamic secrets fall back
# to when a connection does not carry its own (assume-role is preferred).
# @sensitive
INF_APP_CONNECTION_AWS_ACCESS_KEY_ID=
# @sensitive
INF_APP_CONNECTION_AWS_SECRET_ACCESS_KEY=

# GitHub OAuth app used by GitHub connections (repo/organization secret
# syncs). Distinct from the GitHub App below and from the login OAuth app
# further up.
INF_APP_CONNECTION_GITHUB_OAUTH_CLIENT_ID=
# @sensitive
INF_APP_CONNECTION_GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App credentials for the same integration: client id/secret, the app's
# PEM private key, its numeric id and its slug. The private key signs
# installation tokens and is as good as the app's access to every repository
# it is installed on.
INF_APP_CONNECTION_GITHUB_APP_CLIENT_ID=
# @sensitive
INF_APP_CONNECTION_GITHUB_APP_CLIENT_SECRET=
# @sensitive
INF_APP_CONNECTION_GITHUB_APP_PRIVATE_KEY=
INF_APP_CONNECTION_GITHUB_APP_ID=
INF_APP_CONNECTION_GITHUB_APP_SLUG=

# GitLab OAuth application used by GitLab connections.
INF_APP_CONNECTION_GITLAB_OAUTH_CLIENT_ID=
# @sensitive
INF_APP_CONNECTION_GITLAB_OAUTH_CLIENT_SECRET=

# GCP service-account key JSON (the whole document, on one line) used by GCP
# Secret Manager connections.
# @sensitive
INF_APP_CONNECTION_GCP_SERVICE_ACCOUNT_CREDENTIAL=

# Azure AD application used by the Azure connections (Key Vault, App
# Configuration, client secrets, DevOps). The more specific
# INF_APP_CONNECTION_AZURE_*_CLIENT_ID/SECRET variants fall back to these.
INF_APP_CONNECTION_AZURE_CLIENT_ID=
# @sensitive
INF_APP_CONNECTION_AZURE_CLIENT_SECRET=

# Slack app credentials for approval and access-request notifications.
WORKFLOW_SLACK_CLIENT_ID=
# @sensitive
WORKFLOW_SLACK_CLIENT_SECRET=

# ─── Secret scanning (Radar) ───────────────────────────────────────────────
# The GitHub App that scans connected repositories for leaked credentials.
# Only needed if you use secret scanning; DISABLE_SECRET_SCANNING above turns
# the feature off entirely.

# App id, PEM private key and slug of the scanning GitHub App, plus the
# secret GitHub signs its webhook deliveries with. An empty webhook secret
# means anyone who finds the endpoint can post fabricated scan events.
SECRET_SCANNING_GIT_APP_ID=
# @sensitive
SECRET_SCANNING_PRIVATE_KEY=
SECRET_SCANNING_GIT_APP_SLUG=infisical-radar
# @sensitive
SECRET_SCANNING_WEBHOOK_SECRET=
# Public URL GitHub should deliver those webhooks to, when it differs from
# SITE_URL (a tunnel, or a separate ingress).
SECRET_SCANNING_WEBHOOK_PROXY=

# Per-scan resource ceilings: clone and scan timeouts, memory and CPU budget,
# the largest repository that will be cloned, and the age at which a scan
# stuck in `scanning` is reaped. The reaper threshold must exceed clone + scan
# + 5 minutes of overhead or boot validation fails.
# @type=number
SECRET_SCANNING_CLONE_TIMEOUT_MS=
# @type=number
SECRET_SCANNING_SCAN_TIMEOUT_MS=
# @type=number
SECRET_SCANNING_MEMORY_LIMIT_MB=
# @type=number
SECRET_SCANNING_CPU_THREADS=
# @type=number
SECRET_SCANNING_MAX_REPO_SIZE_MB=
# @type=number
SECRET_SCANNING_STUCK_SCAN_TIMEOUT_MS=

# ─── Observability ─────────────────────────────────────────────────────────

# OpenTelemetry metrics export, off by default. Turn the collection flag on,
# then pick `prometheus` (scrape endpoint) or `otlp` (push to
# OTEL_EXPORT_OTLP_ENDPOINT every OTEL_OTLP_PUSH_INTERVAL milliseconds, with
# optional basic-auth credentials for the collector).
# @type=boolean
# @docs("Monitoring telemetry", https://infisical.com/docs/self-hosting/guides/monitoring-telemetry)
OTEL_TELEMETRY_COLLECTION_ENABLED=false
# @type=enum(prometheus, otlp)
OTEL_EXPORT_TYPE=
# @type=url
OTEL_EXPORT_OTLP_ENDPOINT=
# @type=number
OTEL_OTLP_PUSH_INTERVAL=30000
OTEL_COLLECTOR_BASIC_AUTH_USERNAME=
# @sensitive
OTEL_COLLECTOR_BASIC_AUTH_PASSWORD=
# Drops the metrics whose label sets explode cardinality on a busy instance.
# @type=boolean
OTEL_DROP_HIGH_CARDINALITY_METERS=false

# ─── Miscellaneous ─────────────────────────────────────────────────────────

# Header a terminating proxy puts the client's PEM certificate in, for the
# TLS certificate auth method. Only meaningful if the proxy is configured to
# set it AND TRUSTED_PROXY_CIDRS restricts who may. Otherwise a client can
# simply send the header itself and impersonate any certificate identity.
SSL_CLIENT_CERTIFICATE_HEADER_KEY=x-ssl-client-cert
IDENTITY_TLS_CERT_AUTH_CLIENT_CERTIFICATE_HEADER_KEY=x-identity-tls-cert-auth-client-cert

# Ceiling on concurrently active dynamic-secret leases for the instance.
# @type=number
MAX_LEASE_LIMIT=10000

# AWS credentials used specifically by the PAM AWS IAM resource type, kept
# separate from the app-connection credentials above.
# @sensitive
# @docs("Privileged access management", https://infisical.com/docs/documentation/platform/pam/overview)
PAM_AWS_ACCESS_KEY_ID=
# @sensitive
PAM_AWS_SECRET_ACCESS_KEY=

# Path to an Oracle client `tnsnames.ora` directory inside the container,
# required only for Oracle dynamic secrets and rotations.
TNS_ADMIN=
