# Vaultwarden 1.37.2 environment schema (@env-spec / varlock format).
#
# The compose pins vaultwarden/server:1.37.2, the newest stable release
# (2026-08-22). On 2026-09-04 (research date) that tag and `latest` share one
# digest, sha256:094b5689ed81549bd293418395c7cf495ae9d960fc2d4928cef2083ef913d912.
#
# Source: the `make_config!` macro block in src/config.rs at tag 1.37.2
# (lines 502-940). That macro IS the config surface: each entry's name is
# uppercased into its environment variable, and its `def`/`auto`/`option`
# action is where the defaults below come from. Vaultwarden reads almost
# nothing through a bare `env::var`, so grepping for that alone would miss
# ~140 keys. Cross-checked against .env.template at the same tag, plus the
# handful of true `env::var` reads outside the macro: CONFIG_FILE, ENV_FILE,
# DATA_FOLDER (src/config.rs), TZ (src/util.rs), HTTP_PROXY / HTTPS_PROXY
# (src/api/admin.rs), I_REALLY_WANT_VOLATILE_STORAGE (src/main.rs),
# ROCKET_TLS (src/auth.rs), and the ROCKET_* the image itself bakes in
# (docker/Dockerfile.debian).
#
# Two things the docs get wrong or leave out:
#  - Upstream's default for SIGNUPS_ALLOWED is `true`. This template flips it
#    to `false` in the compose, which is the right default for a password
#    vault; do not "restore" it to match the wiki.
#  - Every value below is only a STARTING value. The /admin page writes
#    overrides into $DATA_FOLDER/config.json, and that file wins over the
#    environment for anything set there (src/config.rs `load()`). A variable
#    that appears not to take effect has almost always been overridden in
#    config.json.
#
# Deliberately not declared, because the code recomputes them and ignores
# whatever the environment says: DOMAIN_SET, DOMAIN_ORIGIN, DOMAIN_PATH,
# SSO_CALLBACK_PATH, and the underscore-prefixed internals (_ENABLE_SMTP,
# _ENABLE_DUO, _ENABLE_YUBICO, _ENABLE_EMAIL_2FA, _DUO_AKEY,
# _ICON_SERVICE_URL, _MAX_NOTE_SIZE). `config.domain_set` in particular is
# assigned from whether DOMAIN was supplied, one line after the builder runs.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Configuration overview", https://github.com/dani-garcia/vaultwarden/wiki/Configuration-overview)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The full external URL this server is reached at: scheme included, host,
# a port only if non-standard, and no trailing slash (it is trimmed for
# you). For a vault at vault.example.com behind TLS, that is the https URL
# of that host.
# This is not cosmetic. It is the WebAuthn/FIDO2 relying-party origin, so a
# wrong or later-changed DOMAIN invalidates every registered security key;
# it is the base for attachment and Send download links, emergency-access
# and invitation email links, and the icon-service and CSP origins. Leaving
# it on the built-in localhost fallback makes passkeys, attachments and
# email links break in ways that look like client bugs.
# @required @type=url
# @docs("Enabling U2F and FIDO2 WebAuthn authentication", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-U2F-%28and-FIDO2-WebAuthn%29-authentication)
DOMAIN=

# Unlocks /admin. Anyone holding this token can read and modify EVERY user
# and organization on this instance: list and delete accounts, disable their
# two-factor, invite users, force-purge organization vaults, and rewrite the
# whole server configuration. Treat it as the most privileged secret here,
# above any single user's master password. Upstream recommends storing an
# Argon2 PHC string rather than plaintext. Generate one with
# `vaultwarden hash` (or `openssl rand -base64 48 | argon2 ...`); a value
# starting with `$argon2` is verified as a hash, anything else is compared
# in constant time as plaintext (src/api/admin.rs `validate_token`). Leave
# EMPTY to keep /admin switched off entirely, which is the safest state if
# you do not need it. Note that changing it does not deauthorize sessions
# already logged into /admin; see ADMIN_SESSION_LIFETIME.
# @required @sensitive
# @docs("Enabling admin page", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-admin-page)
ADMIN_TOKEN=

# Whether strangers can self-register on this vault. Upstream defaults this
# to `true`; the compose deliberately sets `false`, because an internet-
# reachable password manager with open registration lets anyone create an
# account, consume storage, and probe the instance. Keep it false and invite
# people from /admin (or an organization), or fence it with
# SIGNUPS_DOMAINS_WHITELIST if you must turn it on. Users invited by an
# admin can still register while this is false.
# @type=boolean
# @docs("Disable registration of new users", https://github.com/dani-garcia/vaultwarden/wiki/Disable-registration-of-new-users)
SIGNUPS_ALLOWED=false

# Serve the bundled web vault UI at all. `false` turns this into an
# API-only server for the desktop/mobile/browser clients.
# @type=boolean
WEB_VAULT_ENABLED=true

# Where the web vault's static assets live inside the container. The image
# ships them at /web-vault, reached via this path relative to WORKDIR `/`.
WEB_VAULT_FOLDER=web-vault/

# Enables the WebSocket endpoint that pushes live vault updates to browser
# and desktop clients. Since 1.30 it is served on the same port as the API,
# so no extra proxy rule is needed beyond allowing WebSocket upgrades.
# @type=boolean
# @docs("Enabling WebSocket notifications", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-WebSocket-notifications)
ENABLE_WEBSOCKET=true

# ─── Storage ─────────────────────────────────────────────────────────────

# Root of all persistent state: the SQLite database, attachments, sends,
# icon cache and the RSA session-signing key. Relative paths resolve against
# the image's WORKDIR, which is `/`, so the default lands on /data, exactly
# where the compose mounts the vaultwarden-data volume. Changing this
# without moving the volume mount loses every vault on the next recreate.
# @docs("Changing persistent data location", https://github.com/dani-garcia/vaultwarden/wiki/Changing-persistent-data-location)
DATA_FOLDER=data

# Individual overrides for the sub-folders. Empty means "derive from
# DATA_FOLDER", which is what you want unless you are mounting attachments
# on separate storage. RSA_KEY_FILENAME is the private key that signs every
# session JWT: losing it logs everyone out, leaking it lets an attacker mint
# sessions, so it must live on the persistent volume.
ICON_CACHE_FOLDER=
ATTACHMENTS_FOLDER=
SENDS_FOLDER=
TMP_FOLDER=
TEMPLATES_FOLDER=
# @sensitive
RSA_KEY_FILENAME=

# Empty means embedded SQLite at $DATA_FOLDER/db.sqlite3, which is what this
# template runs and what the volume backs up. Set it only to move onto an
# external PostgreSQL or MariaDB/MySQL server:
# `postgresql://user:pass@host/vaultwarden` or
# `mysql://user:pass@host/vaultwarden`. There is no automatic migration
# between backends. Contains a password, so treat it as a secret.
# @sensitive
# @docs("Using the PostgreSQL Backend", https://github.com/dani-garcia/vaultwarden/wiki/Using-the-PostgreSQL-Backend)
DATABASE_URL=

# SQLite write-ahead logging. Leave on; turn it off only for exotic
# filesystems (some network mounts) that cannot do WAL, at a performance
# cost. Only read when the database is created.
# @type=boolean
# @docs("Running without WAL enabled", https://github.com/dani-garcia/vaultwarden/wiki/Running-without-WAL-enabled)
ENABLE_DB_WAL=true

# Connection-pool and startup behavior. DB_CONNECTION_RETRIES is how many
# one-second retries the server makes for the database at boot (0 = retry
# forever), which matters when an external database starts alongside it.
# @type=number
DB_CONNECTION_RETRIES=15
# Seconds to wait for a free pooled connection before erroring.
# @type=number
DATABASE_TIMEOUT=30
# Seconds an idle pooled connection is kept before being closed.
# @type=number
DATABASE_IDLE_TIMEOUT=600
# @type=number
DATABASE_MAX_CONNS=10
# @type=number
DATABASE_MIN_CONNS=2
# SQL run on every new connection, mainly for connection-scoped pragmas.
# Empty uses the backend-specific default.
DATABASE_CONN_INIT=

# ─── Accounts & policy ───────────────────────────────────────────────────

# Require users to prove their email before the account works. On current
# clients this is enforced at signup; on older ones it blocks login until
# verified. Needs working SMTP. Upstream's default is `false`, kept here;
# turn it on (with SMTP configured) before ever setting SIGNUPS_ALLOWED=true.
# @type=boolean
SIGNUPS_VERIFY=false
# Seconds before a verification email is automatically re-sent on a login
# attempt.
# @type=number
SIGNUPS_VERIFY_RESEND_TIME=3600
# How many verification emails are auto-sent before giving up (0 = no
# limit).
# @type=number
SIGNUPS_VERIFY_RESEND_LIMIT=6

# Comma-separated email domains allowed to self-register, e.g.
# "example.com,example.org". Applies even when SIGNUPS_ALLOWED is false,
# which makes it the safe middle ground: your company's domain can sign
# itself up, the rest of the internet cannot. Lower-cased and trimmed at
# load.
SIGNUPS_DOMAINS_WHITELIST=

# Whether organization admins may invite people while self-registration is
# off. This is the intended path for onboarding on a closed instance;
# setting it false means only the /admin page can add users.
# @type=boolean
# @docs("Disable invitations", https://github.com/dani-garcia/vaultwarden/wiki/Disable-invitations)
INVITATIONS_ALLOWED=true

# Hours an organization invite, emergency-access invite, email-verification
# token or account-deletion token stays valid (minimum 1).
# @type=number
INVITATION_EXPIRATION_HOURS=120

# Sender/organization name shown in invitation emails that do not come from
# a specific organization.
INVITATION_ORG_NAME=Vaultwarden

# Comma-separated user emails allowed to create organizations. Blank or
# "all" means everyone; "none" means nobody. Lower-cased at load.
ORG_CREATION_USERS=

# Whether users may hand someone else emergency access to their vault.
# Applies to every user on the instance.
# @type=boolean
EMERGENCY_ACCESS_ALLOWED=true

# Whether users may change their own account email.
# @type=boolean
EMAIL_CHANGE_ALLOWED=true

# Whether users may create Bitwarden Sends (shareable, self-destructing
# secrets). Per-organization control is a policy, not this flag.
# @type=boolean
SENDS_ALLOWED=true

# Server-side PBKDF2 iterations for new users' password hashes; existing
# users are upgraded on their next login. Do not lower it.
# @type=number
PASSWORD_ITERATIONS=600000

# Whether users may set a master-password hint at all.
# @type=boolean
PASSWORD_HINTS_ALLOWED=true

# Renders the password hint straight into the web page when SMTP is not
# configured. That is unauthenticated access to a hint for a named email
# address, so anyone who knows a user's address can read it. Leave off on
# anything reachable from the internet.
# @type=boolean
# @docs("Password hint display", https://github.com/dani-garcia/vaultwarden/wiki/Password-hint-display)
SHOW_PASSWORD_HINT=false

# Minutes before a login that passed the master password but never
# completed 2FA is reported to the user by email, the signal that someone
# else knows their master password. 0 disables the check.
# @type=number
INCOMPLETE_2FA_TIME_LIMIT=3

# Send an email whenever a login comes from a new device, and FAIL that
# login if the email cannot be sent. Good hardening, but it makes SMTP a
# hard dependency of logging in.
# @type=boolean
REQUIRE_DEVICE_EMAIL=false

# Days a trashed item survives before permanent deletion. Empty keeps
# trashed items forever. Global, so tell your users before changing it.
# @type=number
TRASH_AUTO_DELETE_DAYS=

# Per-user and per-organization storage caps in KILOBYTES. Empty means
# unlimited, which on a shared instance means one user can fill the volume.
# @type=number
USER_ATTACHMENT_LIMIT=
# @type=number
ORG_ATTACHMENT_LIMIT=
# @type=number
USER_SEND_LIMIT=

# Organization event/audit logging. Off by default because it grows the
# database; EVENTS_DAYS_RETAIN caps how long rows are kept (empty = keep
# forever) and EVENT_CLEANUP_SCHEDULE does the pruning.
# @type=boolean
ORG_EVENTS_ENABLED=false
# @type=number
EVENTS_DAYS_RETAIN=

# Organization groups. Still marked BETA upstream with known issues; the
# 1.35.x line shipped a cross-organization group-binding advisory
# (GHSA-569v-845w-g82p), fixed, but this remains the least-exercised
# permission path.
# @type=boolean
ORG_GROUPS_ENABLED=false

# Require the Single Organization policy before the Reset Password policy
# can be enabled, matching upstream Bitwarden's behavior.
# @type=boolean
ENFORCE_SINGLE_ORG_WITH_RESET_PW_POLICY=false

# Raise the secure-note limit from 10,000 to 100,000 characters. Marked
# "know the risks": official clients and Bitwarden-server exports may choke
# on the larger notes.
# @type=boolean
INCREASE_NOTE_SIZE_LIMIT=false

# Suppress the clients' post-login welcome dialogs, extension-install
# prompts and premium upsell modals.
# @type=boolean
CLIENT_SUPPRESS_ONBOARDING=false

# ─── Admin page & rate limits ────────────────────────────────────────────

# Turns OFF the ADMIN_TOKEN check on /admin entirely. Only ever set this
# when something else in front of Vaultwarden (an authenticating reverse
# proxy, an SSO forward-auth gateway) already restricts /admin, because
# without that it publishes full instance administration to anyone who can
# reach the URL. If you are unsure, leave it false.
# @type=boolean
# @docs("Disable admin token", https://github.com/dani-garcia/vaultwarden/wiki/Disable-admin-token)
DISABLE_ADMIN_TOKEN=false

# Minutes an authenticated /admin session lasts before it must log in
# again. Short is good: the admin cookie is as powerful as the token.
# @type=number
ADMIN_SESSION_LIFETIME=20

# Rate limits, as an average interval in seconds plus a burst allowance.
# The login pair covers both the password and the 2FA step, so a burst
# below 2 locks people out. Vaultwarden 1.35.7 fixed a brute-force-
# protection bypass here (GHSA-c5rv-q295-7w4g); loosening these undoes the
# protection that fix restored.
# @type=number
# @docs("Hardening Guide", https://github.com/dani-garcia/vaultwarden/wiki/Hardening-Guide)
LOGIN_RATELIMIT_SECONDS=60
# @type=number
LOGIN_RATELIMIT_MAX_BURST=10
# Shared across several unauthenticated endpoints, hence the larger burst.
# @type=number
UNAUTHENTICATED_RATELIMIT_SECONDS=60
# @type=number
UNAUTHENTICATED_RATELIMIT_MAX_BURST=50
# The /admin login attempt limiter. Deliberately strict.
# @type=number
ADMIN_RATELIMIT_SECONDS=300
# @type=number
ADMIN_RATELIMIT_MAX_BURST=3

# ─── Proxy & client IP ───────────────────────────────────────────────────

# Header carrying the real client IP, used for rate limiting and for the
# "new device" / login notification emails. The literal string "none"
# disables header inspection and uses the socket peer address.
# @docs("Proxy examples", https://github.com/dani-garcia/vaultwarden/wiki/Proxy-examples)
IP_HEADER=X-Real-IP

# Which source addresses IP_HEADER is trusted from: "local" (any
# non-global address, i.e. your reverse proxy on the same host or container
# network), "all", or a comma-separated list of IPs/CIDRs. "all" lets any
# client forge its own IP and walk straight past the rate limiter.
IP_HEADER_TRUSTED_PROXIES=local

# Domains permitted to embed the web vault in an <iframe>, space separated.
# Empty forbids all framing (anti-clickjacking); a password vault inside a
# hostile frame is a credential-theft primitive.
ALLOWED_IFRAME_ANCESTORS=

# Extra origins added to the CSP `connect-src`, needed by some forwarded-
# email-alias providers. Empty unless a specific integration demands it.
ALLOWED_CONNECT_SRC=

# ─── Icons & outbound HTTP ───────────────────────────────────────────────

# Which service fetches website favicons: `internal` (this server fetches
# them, so it makes outbound requests to every domain in every vault),
# `bitwarden`, `duckduckgo`, `google`, or a custom template URL containing
# exactly one `{}`. External services see the domains your users store;
# `internal` keeps that private but exposes the server as an HTTP fetcher.
# @docs("Using custom website icons", https://github.com/dani-garcia/vaultwarden/wiki/Using-custom-website-icons)
ICON_SERVICE=internal

# Stop fetching icons entirely while still serving whatever is already
# cached. Pair with ICON_CACHE_TTL=0 or the cache expires and is never
# refilled.
# @type=boolean
DISABLE_ICON_DOWNLOAD=false

# HTTP status used when redirecting to an external icon service: 301, 302,
# 307 or 308.
# @type=enum(301, 302, 307, 308)
ICON_REDIRECT_CODE=302
# Seconds a cached icon is considered fresh.
# @type=number
ICON_CACHE_TTL=2592000
# Seconds before retrying an icon fetch that previously failed.
# @type=number
ICON_CACHE_NEGTTL=259200
# Seconds before an icon download is abandoned.
# @type=number
ICON_DOWNLOAD_TIMEOUT=10

# SSRF guard for the internal HTTP client: refuse to connect to any
# non-global (private, loopback, link-local) address, so a crafted vault
# entry cannot make this server probe your internal network. Vaultwarden
# 1.36.0 fixed a bypass of exactly this via decimal/hex/octal IP encodings
# (GHSA-72vh-x5jq-m82g). Leave it on unless you deliberately want icons for
# intranet hosts.
# @type=boolean
# @docs("Allow icon fetching from internal services", https://github.com/dani-garcia/vaultwarden/wiki/Allow-icon-fetching-from-internal-services)
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true

# Regex of domains/IPs the internal HTTP client must never fetch, e.g.
# `^(?:.*\.)?example\.internal$`. Empty blocks nothing beyond the flag
# above.
HTTP_REQUEST_BLOCK_REGEX=

# Deprecated twins of the two above, still read at this version and copied
# forward into them at load. Use the HTTP_REQUEST_BLOCK_* names instead;
# these exist so old configs keep working.
ICON_BLACKLIST_REGEX=
# @type=boolean
ICON_BLACKLIST_NON_GLOBAL_IPS=true

# Standard proxy variables, honored by the outbound HTTP client (and
# reported on the /admin diagnostics page). Set them if this container can
# only reach the internet through a proxy.
HTTP_PROXY=
HTTPS_PROXY=

# Resolve AAAA before A. For IPv6-only egress.
# @type=boolean
DNS_PREFER_IPV6=false

# ─── Two-factor authentication ───────────────────────────────────────────

# Kill the "remember this device for 30 days" 2FA bypass, forcing a second
# factor on every single login. The checkbox stays visible in the clients
# but is ignored.
# @type=boolean
DISABLE_2FA_REMEMBER=false

# Reject TOTP codes from the neighbouring 30-second windows, accepting only
# the current one. Stricter, but unforgiving of clock drift on phones.
# @type=boolean
AUTHENTICATOR_DISABLE_TIME_DRIFT=false

# Yubico OTP validation. Leave the client id and secret empty to use
# YubiCloud's default servers, or point YUBICO_SERVER at a self-hosted
# validation server. Credentials come from the Yubico API key request page.
# @docs("Enabling Yubikey OTP authentication", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-Yubikey-OTP-authentication)
YUBICO_CLIENT_ID=
# @sensitive
YUBICO_SECRET_KEY=
# @type=url
YUBICO_SERVER=

# Duo Security push MFA, instance-wide (users can still override it per
# account). Values come from a Duo Web SDK / Duo Universal application.
# @docs("Configuration overview", https://github.com/dani-garcia/vaultwarden/wiki/Configuration-overview)
DUO_IKEY=
# @sensitive
DUO_SKEY=
DUO_HOST=
# Fall back to Duo's deprecated iframe "Traditional Prompt" (WebSDK 2)
# instead of the Universal Prompt.
# @type=boolean
DUO_USE_IFRAME=false

# Email as a second factor. Only available when SMTP works (the code
# enables it from _enable_smtp && a configured host or sendmail).
# EMAIL_TOKEN_SIZE is 6-255 digits, though the Bitwarden clients hardcode
# the words "6 digit code" regardless.
# @type=number
# @docs("SMTP Configuration", https://github.com/dani-garcia/vaultwarden/wiki/SMTP-Configuration)
EMAIL_TOKEN_SIZE=6
# Seconds an emailed token stays valid.
# @type=number
EMAIL_EXPIRATION_TIME=600
# Wrong-token attempts before the token is reset and a new email is sent.
# @type=number
EMAIL_ATTEMPTS_LIMIT=3
# Set up email 2FA on registration regardless of organization policy.
# @type=boolean
EMAIL_2FA_ENFORCE_ON_VERIFIED_INVITE=false
# Automatically fall back to email 2FA when it is needed. Marked "know the
# risks" because it makes the user's mailbox a second factor for their
# vault: whoever holds the mailbox holds the 2FA.
# @type=boolean
EMAIL_2FA_AUTO_FALLBACK=false

# ─── SMTP ────────────────────────────────────────────────────────────────

# No mail server is bundled. Without SMTP there is no email verification,
# no invitations, no new-device alerts, no emergency access notification
# and no email 2FA. A vault still works, but every safety net that runs
# through email is off. SMTP_HOST is what switches the whole block on.
# @docs("SMTP Configuration", https://github.com/dani-garcia/vaultwarden/wiki/SMTP-Configuration)
SMTP_HOST=

# Transport security: "starttls" (explicit, ports 587/25), "force_tls"
# (implicit, port 465), or "off" for no encryption. Empty derives it from
# the deprecated SMTP_SSL/SMTP_EXPLICIT_TLS pair, which lands on
# "starttls".
# @type=enum(starttls, force_tls, off)
SMTP_SECURITY=

# Empty derives the port from SMTP_SECURITY: 465 for force_tls, 587 for
# starttls, 25 for off.
# @type=port
SMTP_PORT=

# Envelope sender. Must be an address the SMTP server will accept, or every
# message bounces.
# @type=email
SMTP_FROM=
SMTP_FROM_NAME=Vaultwarden

SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=

# Comma-separated mechanisms from "Plain", "Login", "Xoauth2". Empty picks
# Plain and Login on encrypted connections and nothing otherwise.
SMTP_AUTH_MECHANISM=

# Seconds before giving up on the SMTP connection.
# @type=number
SMTP_TIMEOUT=15

# Hostname announced in the HELO/EHLO. Empty uses the container's hostname,
# which some anti-spam filters dislike.
HELO_NAME=

# Attach the logo to emails instead of hot-linking it from DOMAIN. Turning
# it off means mail clients fetch images from your server, leaking read
# receipts.
# @type=boolean
SMTP_EMBED_IMAGES=true

# Deliver through the local `sendmail` binary instead of an SMTP server.
# SENDMAIL_COMMAND overrides which binary; empty uses the one on $PATH.
# The image does not ship a sendmail, so this needs a custom image or a
# mounted binary.
# @type=boolean
USE_SENDMAIL=false
SENDMAIL_COMMAND=

# Dumps the full SMTP conversation into the logs, usernames and passwords
# included. Troubleshooting only, never left on.
# @type=boolean
SMTP_DEBUG=false

# Accept invalid TLS certificates / hostnames from the SMTP server. Both
# are man-in-the-middle holes on the channel that carries verification and
# 2FA emails.
# @type=boolean
SMTP_ACCEPT_INVALID_CERTS=false
# @type=boolean
SMTP_ACCEPT_INVALID_HOSTNAMES=false

# ─── Mobile push notifications ───────────────────────────────────────────

# Relays vault-change notifications to the official iOS/Android apps
# through Bitwarden's push service. Requires a free installation id/key
# from bitwarden.com/host; without them the apps only sync when opened.
# The relay learns that your instance exists and when it changes, not what
# is in it.
# @type=boolean
# @docs("Enabling Mobile Client push notification", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-Mobile-Client-push-notification)
PUSH_ENABLED=false
# @sensitive
PUSH_INSTALLATION_ID=
# @sensitive
PUSH_INSTALLATION_KEY=
# Regional relay endpoints. Use the EU pair
# (https://push.bitwarden.eu / https://identity.bitwarden.eu) if you
# registered the installation on the EU cloud; a mismatch fails to
# authenticate.
# @type=url
PUSH_RELAY_URI=https://push.bitwarden.com
# @type=url
PUSH_IDENTITY_URI=https://identity.bitwarden.com

# ─── SSO (OpenID Connect) ────────────────────────────────────────────────

# Adds a "Log in with SSO" path alongside master-password login. The
# vault's encryption still hangs off the master password. SSO authenticates
# the session, it does not decrypt the vault. Several SSO advisories were
# fixed across 1.35.x/1.36.0 (CSRF in the authorization flow
# GHSA-pfp2-jhgq-6hg5, email auto-link account takeover GHSA-6x5c-84vm-5j56,
# organization enumeration GHSA-hxqh-ff5p-wfr3), so run SSO only at 1.36.0
# or newer, which this template's 1.37.2 pin satisfies.
# @type=boolean
# @docs("Enabling SSO support using OpenId Connect", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-SSO-support-using-OpenId-Connect)
SSO_ENABLED=false

# Remove the email + master-password login form, leaving SSO as the only
# way in. If the identity provider is down, nobody reaches their vault.
# @type=boolean
SSO_ONLY=false

# Base URL of the provider's discovery document, without the trailing
# `/.well-known/openid-configuration`.
# @type=url
SSO_AUTHORITY=
SSO_CLIENT_ID=
# @sensitive
SSO_CLIENT_SECRET=

# Scopes requested on top of the implicit `openid`.
SSO_SCOPES=email profile
# Extra query parameters appended to the authorization request.
SSO_AUTHORIZE_EXTRA_PARAMS=

# Proof Key for Code Exchange. Leave on; only turn it off for a provider
# that genuinely cannot do PKCE.
# @type=boolean
SSO_PKCE=true

# Bind an SSO identity to an existing local account with the same email
# address.
# @type=boolean
SSO_SIGNUPS_MATCH_EMAIL=true

# Accept an SSO identity whose email the provider has NOT marked verified.
# Upstream states plainly that combining this with
# SSO_SIGNUPS_MATCH_EMAIL=true opens account takeover: anyone who can make
# the IdP assert a victim's address inherits that vault account.
# @type=boolean
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false

# Regex of additional id-token audiences to trust. By default only the
# client id is accepted; widening this weakens token validation.
SSO_AUDIENCE_TRUSTED=

# JSON master-password policy pushed to SSO users, e.g.
# {"enforceOnLogin":false,"minComplexity":3,"minLength":12}.
SSO_MASTER_PASSWORD_POLICY=

# Use SSO for authentication only, then fall back to Vaultwarden's own
# session lifecycle instead of the provider's token lifetimes.
# @type=boolean
SSO_AUTH_ONLY_NOT_SESSION=false

# Seconds to cache the provider's discovery document; 0 or less disables
# caching.
# @type=number
SSO_CLIENT_CACHE_EXPIRATION=0

# Logs complete SSO tokens (needs LOG_LEVEL=debug). Those tokens are live
# credentials, and anything that reads the logs can replay them. Debugging
# only.
# @type=boolean
SSO_DEBUG_TOKENS=false

# ─── Scheduled jobs ──────────────────────────────────────────────────────

# Vaultwarden's own cron, in 6-field form (seconds first). A blank value
# disables that one job; JOB_POLL_INTERVAL_MS=0 disables the scheduler
# entirely, which would also stop trash and Send expiry from ever running.
# @type=number
# @docs("Configuration overview", https://github.com/dani-garcia/vaultwarden/wiki/Configuration-overview)
JOB_POLL_INTERVAL_MS=30000
# Deletes Sends past their expiry (hourly).
SEND_PURGE_SCHEDULE=0 5 * * * *
# Permanently removes trashed items past TRASH_AUTO_DELETE_DAYS (daily).
TRASH_PURGE_SCHEDULE=0 5 0 * * *
# Emails users about logins that stalled at the 2FA step (every minute).
INCOMPLETE_2FA_SCHEDULE=30 * * * * *
# Reminds emergency-access grantors that a request is pending (hourly).
EMERGENCY_NOTIFICATION_REMINDER_SCHEDULE=0 3 * * * *
# Grants emergency-access requests whose wait time has elapsed (hourly).
# Disabling this leaves requests pending forever.
EMERGENCY_REQUEST_TIMEOUT_SCHEDULE=0 7 * * * *
# Prunes the event table past EVENTS_DAYS_RETAIN (daily).
EVENT_CLEANUP_SCHEDULE=0 10 0 * * *
# Clears stale passwordless/device login requests (every minute).
AUTH_REQUEST_PURGE_SCHEDULE=30 * * * * *
# Clears expired Duo contexts; a no-op unless Duo MFA is on.
DUO_CONTEXT_PURGE_SCHEDULE=30 * * * * *
# Clears leftover rows from SSO logins that never completed (daily).
PURGE_INCOMPLETE_SSO_AUTH=0 20 0 * * *

# ─── Logging & diagnostics ───────────────────────────────────────────────

# "trace", "debug", "info", "warn", "error", "off", optionally per module:
# "info,vaultwarden::sso=debug". Anything below info gets noisy fast.
# @docs("Logging", https://github.com/dani-garcia/vaultwarden/wiki/Logging)
LOG_LEVEL=info

# Adds timestamps and module paths to log lines.
# @type=boolean
EXTENDED_LOGGING=true

# strftime format for those timestamps.
LOG_TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S.%3f

# Also write logs to this file inside the container. Empty logs only to
# stdout, which is what the platform collects. Set this only if you also
# mount somewhere to hold it, and rotate it yourself.
LOG_FILE=

# Additionally emit to syslog. Needs a syslog socket inside the container,
# which this image does not provide on its own.
# @type=boolean
USE_SYSLOG=false

# Re-reads the Handlebars templates on every request. Development only; it
# slows the server down.
# @type=boolean
RELOAD_TEMPLATES=false

# Comma-separated client feature flags to force on. Undocumented and
# version-coupled, so only set what a maintainer or release note names.
EXPERIMENTAL_CLIENT_FEATURE_FLAGS=

# HaveIBeenPwned API key, so the password generator and health reports can
# check breaches. Optional; without it those checks are unavailable.
# @sensitive
HIBP_API_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────

# Rocket's own listener settings. The image bakes ROCKET_ADDRESS=0.0.0.0 and
# ROCKET_PORT=80, and the compose exposes container port 80 with no
# override: change ROCKET_PORT here without changing the exposed port and
# routing breaks, and the bundled /healthcheck.sh (which reads ROCKET_PORT
# and ROCKET_ADDRESS itself) starts reporting the container unhealthy while
# the app is fine.
# @type=port
# @docs("Starting a Container", https://github.com/dani-garcia/vaultwarden/wiki/Starting-a-Container)
ROCKET_PORT=80
ROCKET_ADDRESS=0.0.0.0
# Rocket's config profile; the image sets "release".
# @type=enum(release, debug)
ROCKET_PROFILE=release

# Number of worker threads. Empty lets Rocket size it from the available
# CPUs; lower it on very small instances to cut memory.
# @type=number
# @docs("Changing the number of workers", https://github.com/dani-garcia/vaultwarden/wiki/Changing-the-number-of-workers)
ROCKET_WORKERS=

# Terminates TLS inside the container, e.g.
# {certs="/path/certs.pem",key="/path/key.pem"}. Leave empty here, since the
# platform's router already terminates HTTPS in front of this service, and
# setting it also flips the session cookies to Secure in a way that must
# match how clients actually reach DOMAIN.
# @docs("Enabling HTTPS", https://github.com/dani-garcia/vaultwarden/wiki/Enabling-HTTPS)
ROCKET_TLS=

# Where the /admin page persists its overrides. Empty means
# $DATA_FOLDER/config.json. Whatever is in that file beats these variables.
CONFIG_FILE=

# A dotenv file read at startup, in addition to the environment. Empty
# means `.env` next to the binary; the healthcheck defaults it to `/.env`.
# The platform supplies the environment directly, so this normally stays
# empty.
ENV_FILE=

# Escape hatch for the startup check that refuses to run when the data
# folder looks like it is not persistent. Setting it means accepting that
# every vault on this instance can vanish on the next container restart.
# @type=boolean
I_REALLY_WANT_VOLATILE_STORAGE=

# IANA timezone used when formatting timestamps in logs and emails, e.g.
# Europe/Berlin. Empty leaves the container on UTC.
TZ=
