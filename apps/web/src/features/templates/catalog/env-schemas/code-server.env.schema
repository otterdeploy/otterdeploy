# code-server 4.135.0 (image codercom/code-server:4.135.0, Code 1.135.0)
# environment schema (@env-spec / varlock format).
#
# Source: grep of process.env across src/ and patches/ at coder/code-server
# v4.135.0, plus the release image's own shell layer
# (ci/release-image/Dockerfile + entrypoint.sh, which is what actually runs
# here). Cross-checked against docs/FAQ.md and docs/guide.md at the same tag.
#
# code-server has no .env.example and no single "environment variables" page:
# most knobs are CLI flags, and only the subset below has an environment
# twin in src/node/cli.ts. Anything not listed here is a flag or a
# ~/.config/code-server/config.yaml key, not a variable.
#
# Precedence quirks that bite in this compose, all in src/node/cli.ts:
#   - The compose passes `--bind-addr 0.0.0.0:8080`, but bindAddrFromArgs()
#     applies CODE_SERVER_HOST and PORT *after* --bind-addr, so either
#     variable silently overrides the compose's bind address. The container
#     only exposes 8080, so overriding PORT here breaks routing.
#   - PASSWORD, HASHED_PASSWORD and GITHUB_TOKEN are deleted from the
#     process environment right after they are parsed, so terminals and
#     extensions inside the editor never see them.
#   - HASHED_PASSWORD wins over PASSWORD when both are set.
#
# Not declared, because code-server sets them for itself rather than reading
# operator input: CODE_SERVER_PARENT_PID (wrapper.ts, the parent watchdog
# PID), CODE_SERVER_SESSION_SOCKET (cli.ts always overwrites it with the
# --session-socket path), VSCODE_IPC_HOOK_CLI / VSCODE_AGENT_FOLDER /
# VSCODE_SERVER_EXIT_DIAGNOSTICS (VS Code internals from patches/, set per
# terminal session).
#
# The compose prompts for CODE_SERVER_PASSWORD and threads it, unchanged,
# into the container's PASSWORD.

# @defaultSensitive=false @defaultRequired=infer
# @docs("code-server FAQ", https://coder.com/docs/code-server/FAQ)
# ---

# ─── Authentication ────────────────────────────────────────────────────────
# Default auth mode is `password`. On first boot code-server writes
# ~/.config/code-server/config.yaml with a randomly generated password; that
# file lives on the code-server-config volume, so it survives restarts. An
# empty PASSWORD below is falsy and leaves that generated password in force,
# which nobody can read without `docker exec`. Supply CODE_SERVER_PASSWORD.

# Platform prompt key for the editor's login password; threaded unchanged
# into PASSWORD below. This is the only credential guarding a shell with
# sudo on the host container.
# @required
# @sensitive
CODE_SERVER_PASSWORD=

# The plaintext login password, set by the compose from CODE_SERVER_PASSWORD.
# Overrides the `password` entry in config.yaml. Removed from the
# environment after parsing, so it does not leak into editor terminals.
# @required
# @sensitive
PASSWORD=${CODE_SERVER_PASSWORD}

# argon2 hash of the login password (`echo -n pass | npx argon2-cli -e`),
# for not storing the plaintext. Takes priority over PASSWORD when both are
# set. `--hashed-password` cannot be passed on the command line; this
# variable or config.yaml are the only ways in.
# @sensitive
HASHED_PASSWORD=

# Switches authentication to GitHub instead of a password: the token is used
# for the built-in GitHub authentication provider (equivalent to
# `--github-auth`, which likewise refuses to be passed on the command line).
# @sensitive
# @docs("code-server FAQ", https://coder.com/docs/code-server/FAQ)
GITHUB_TOKEN=

# Suffix appended to the session cookie's name. Set this when several
# code-server instances share a parent domain, otherwise their cookies
# collide and logging into one logs you out of the other.
CODE_SERVER_COOKIE_SUFFIX=

# ─── Networking ────────────────────────────────────────────────────────────
# Both of these are applied AFTER the compose's `--bind-addr 0.0.0.0:8080`
# and override it. Leave them empty unless you also change the exposed port.

# Host/IP to bind to. Empty keeps the compose's 0.0.0.0, which is what the
# container network needs; 127.0.0.1 here makes the editor unreachable.
CODE_SERVER_HOST=

# Port to listen on. The compose exposes container port 8080 and passes it
# via --bind-addr, so setting this to anything else strips the service of
# its route.
# @type=port
PORT=

# Template for the URL shown in the PORTS tab when code-server detects a
# process listening inside the workspace. `{{port}}` is substituted, e.g.
# `https://{{port}}.example.com` or the relative `./proxy/{{port}}`. If
# unset and --proxy-domain is in use, code-server derives `//<first
# proxy domain>` itself.
# @docs("Using code-server behind a proxy", https://coder.com/docs/code-server/guide)
VSCODE_PROXY_URI=

# "1" or "true" disables the domain and path proxy routes to forwarded
# ports. The PORTS tab still appears (upstream caveat), the routes just stop
# working, so pair it with `remote.autoForwardPorts: false`.
# @type=enum(1, true)
CS_DISABLE_PROXY=

# ─── Editor behaviour ──────────────────────────────────────────────────────

# "1" or "true" removes the download action from the file explorer and
# editor. A hardening knob only: a terminal inside the editor can still read
# and exfiltrate the same files.
# @type=enum(1, true)
CS_DISABLE_FILE_DOWNLOADS=

# "1" or "true" hides the coder/coder promotion that replaces the
# Help: Getting Started page.
# @type=enum(1, true)
CS_DISABLE_GETTING_STARTED_OVERRIDE=

# Name shown in the browser title, the About dialog, and the login page.
# Falls back to "code-server" when unset.
CODE_SERVER_APP_NAME=code-server

# Extra flags handed to the bundled VS Code server, space-separated like
# NODE_OPTIONS. Appended to any `--vscode-option` flags rather than
# replacing them.
VSCODE_OPTIONS=

# Points the editor at a third-party VS Code Extension Gallery, as the JSON
# object VS Code's product.json expects, e.g.
# {"serviceUrl": "https://open-vsx.org/vscode/gallery"}. Without it the
# image's built-in Open VSX configuration is used; pointing it at
# Microsoft's marketplace violates their terms of use.
# @docs("How do I use my own extensions marketplace?", https://coder.com/docs/code-server/FAQ)
EXTENSIONS_GALLERY=

# ─── Lifecycle ─────────────────────────────────────────────────────────────

# Shuts code-server down after this many seconds with no active browser
# connection (tracked by the heartbeat file under
# ~/.local/share/code-server/heartbeat). Must be greater than 60; code-server
# throws at startup otherwise. Leave empty to run indefinitely. With
# `restart: always` a shutdown here just becomes a restart loop.
# @type=number
CODE_SERVER_IDLE_TIMEOUT_SECONDS=

# Seconds a disconnected client may stay away before its session (terminals,
# running tasks) is torn down and a browser refresh starts fresh. Upstream
# default is 10800 (3 hours).
# @type=number
CODE_SERVER_RECONNECTION_GRACE_TIME=

# Path to the YAML config file, replacing the default
# ~/.config/code-server/config.yaml. That default is on the
# code-server-config volume; moving it off means the generated password and
# any settings are recreated on every container rebuild.
CODE_SERVER_CONFIG=

# ─── Logging ───────────────────────────────────────────────────────────────

# Log verbosity. Read only when neither --log nor --verbose is passed; the
# compose passes neither, so this variable is in force. Values outside the
# set are ignored silently.
# @type=enum(trace, debug, info, warn, error)
LOG_LEVEL=

# Only ever compared against "development", which turns on i18next's debug
# output. Not otherwise a production/development switch in code-server.
# @type=enum(production, development)
NODE_ENV=

# ─── Outbound proxy ────────────────────────────────────────────────────────
# Used by code-server's own outbound requests (extension gallery, update
# check). First non-empty of HTTPS_PROXY, https_proxy, HTTP_PROXY,
# http_proxy wins, and the same variable is not re-read per request, so all
# four are equivalent here.

HTTPS_PROXY=
https_proxy=
HTTP_PROXY=
http_proxy=

# ─── Container ─────────────────────────────────────────────────────────────
# Read by the image's entrypoint.sh, not by code-server's TypeScript.

# Renames the built-in `coder` user (uid 1000) to this name at startup so
# `docker exec` lands on a matching account. Cosmetic: $HOME stays
# /home/coder either way, because the entrypoint cannot move the mounted
# volumes.
# @docs("Docker install", https://coder.com/docs/code-server/install#docker)
DOCKER_USER=

# Directory scanned at startup; every executable file found in it is run
# before code-server starts, for workspace preparation. The image sets it to
# /entrypoint.d (the Dockerfile interpolates an unset $HOME, so it is NOT
# ~/entrypoint.d as the referenced issue suggests) and nothing is mounted
# there by this template.
ENTRYPOINTD=/entrypoint.d

# Locale baked into the image by the Dockerfile; en_US.UTF-8 is the only
# locale generated, so another value falls back to the C locale.
LANG=en_US.UTF-8

# Timezone for the container's clock, read by glibc/tzdata: terminal and
# log timestamps, not the editor UI, which uses the browser's timezone.
# Empty means UTC.
TZ=
