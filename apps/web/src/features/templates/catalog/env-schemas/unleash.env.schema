# Unleash 8.1.0 (image unleashorg/unleash-server:8.1.0) environment schema
# (@env-spec / varlock format).
#
# The compose previously floated on `:latest`; pinned to 8.1.0 on 2026-09-04
# (research date), the newest stable release (v8.1.0, 2026-08-05). `latest`,
# `8`, `8.1` and `8.1.0` all carry digest
# sha256:16f3ffb914880e7d0f23629a0c1b77aebea3aa619b0305f76eb50b3fb75998a9,
# so pinning changes nothing about what runs today; it only stops the tag
# from moving under the stack. The repo is actively maintained (main-edge
# rebuilt daily; 8.1.0 is a month old).
#
# Source: `process.env` grep across src/ at v8.1.0, read at the point of use.
# Almost every server option is resolved in src/lib/create-config.ts, with a
# handful elsewhere (services/user-service.ts for the bootstrap admin,
# services/api-token-service.ts for INIT_* tokens, middleware/session-db.ts
# for UNLEASH_SECRET, util/anonymise.ts for the encryption keys).
#
# Where the configuration reference and the code disagree, the code wins here:
#  - LOG_LEVEL: docs say the default is `info`; create-config.ts falls back to
#    LogLevel.error, so an unconfigured server logs errors only (and an
#    unrecognised level silently becomes `error` too).
#  - HTTP_HOST: docs say `0.0.0.0`; the code passes `undefined` to
#    server.listen, which binds every interface (dual-stack); same effect,
#    but there is no literal default to copy.
#  - DATABASE_HOST / DATABASE_USERNAME / DATABASE_PASSWORD: docs list defaults
#    `localhost` / `unleash_user` / `password`; the code has none. They are
#    irrelevant here anyway because DATABASE_URL is set and wins.
#  - INIT_ADMIN_API_TOKENS is read by the code but missing from the docs table
#    (only the BACKEND/CLIENT/FRONTEND ones are documented). So are
#    UNLEASH_SECRET, PORT, SEND_TELEMETRY, ENABLE_OAS, UNLEASH_DEMO and
#    AUTH_TYPE=none.
#  - HTTP_PROXY / HTTPS_PROXY / NO_PROXY / NODE_EXTRA_CA_CERTS are documented
#    as supported; nothing in the source reads them and the image ships no
#    proxy agent (Node 22 does not route fetch through them by default), so
#    they are NOT declared below.
#  - The two client rate-limit variables are crossed in create-config.ts:
#    REGISTER_CLIENT_RATE_LIMIT_PER_MINUTE feeds the metrics limiter and
#    CLIENT_METRICS_RATE_LIMIT_PER_MINUTE feeds the register limiter. Both
#    default to 6000, so it only shows if you set one of them.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Configure Unleash (self-hosting reference)", https://docs.getunleash.io/deploy/configuring-unleash)
# ---

# ─── Server and public URL ───────────────────────────────────────────────

# Public URL this instance is reachable at, answered by the platform from the
# service's own primary domain. Unleash cannot derive it: it is baked into
# password-reset and invite links, and into the links integrations (Slack,
# Datadog, webhooks) send out. The upstream fallback is the localhost:4242
# default, which makes every emailed link dead on arrival, which is why the
# compose sets it. Override it only to point at a different public entry
# point, and include the base path if BASE_URI_PATH is set.
# @required
# @type=url
# @docs("Configure the Unleash instance URL", https://docs.getunleash.io/deploy/configuring-unleash#configure-the-unleash-instance-url)
UNLEASH_URL=${{stack.unleash.PUBLIC_URL}}

# Port the server listens on inside the container. The compose exposes
# container port 4242, this default's twin. Change one without the other and
# routing breaks. `PORT` is the fallback, read only when HTTP_PORT is unset.
# @type=port
HTTP_PORT=4242
PORT=

# Address to bind. Empty means "every interface", which is what the container
# network needs; set it only to restrict the listener.
HTTP_HOST=

# Serve Unleash under a sub-path (`/unleash`) instead of the root. Normalised
# to a leading slash with no trailing one, and it also becomes the session
# cookie's path, so a mismatch with the proxy path logs users straight back
# out. Empty = root.
BASE_URI_PATH=

# Absolute URL prefix the Admin UI loads its static assets from, for serving
# them off a CDN. Empty serves them from Unleash itself.
CDN_PREFIX=

# Seconds an idle keep-alive connection is held. Raise it above the proxy's
# own idle timeout to avoid 502s from races on connection reuse.
# @type=number
SERVER_KEEPALIVE_TIMEOUT=15

# Disable gzip/brotli of responses. Only useful when something in front of
# Unleash compresses instead.
# @type=boolean
SERVER_DISABLE_COMPRESSION=false

# On SIGINT/SIGTERM, stop accepting connections and close the DB pool before
# exiting; the timeout (milliseconds) is how long that is allowed to take
# before a hard exit.
# @type=boolean
GRACEFUL_SHUTDOWN_ENABLE=true
# @type=number
GRACEFUL_SHUTDOWN_TIMEOUT=1000

# Serve the OpenAPI spec and the /docs/openapi UI. On by default: it exposes
# the shape of the API (not data: endpoints still require a token unless
# AUTH_ENABLE_API_TOKEN is off), so turn it off if you would rather not
# publish it.
# @type=boolean
ENABLE_OAS=true

# Phone home: Unleash reports anonymous instance statistics to
# version.unleash.run, which is also how the "new version available" banner
# works. CHECK_VERSION=false stops the version poll; SEND_TELEMETRY=false
# stops the payload that goes with it. UNLEASH_VERSION_URL redirects both.
# @type=boolean
CHECK_VERSION=true
# @type=boolean
SEND_TELEMETRY=true
# @type=url
UNLEASH_VERSION_URL=https://version.unleash.run

# ─── Database ────────────────────────────────────────────────────────────

# Connection string for the bundled Postgres, assembled by the compose from
# the prompted POSTGRES_PASSWORD and the db service's hostname. Parsed with
# pg-connection-string and merged OVER the individual DATABASE_* settings, so
# whatever it carries wins. Unleash 8 requires Postgres 15 or newer (the
# bundled one is 17) and runs its migrations on every boot.
# @required
# @sensitive
# @docs("Configure the database", https://docs.getunleash.io/deploy/configuring-unleash#configure-the-database)
DATABASE_URL=postgres://unleash:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/unleash

# TLS for the database connection. Read with JSON.parse, so the value must be
# valid JSON: `false`, `true`, or an object of node-postgres SSL options.
# `disable` or `require` throw at boot. The compose sets `false` because the
# bundled Postgres is on the stack's private network and speaks plaintext.
DATABASE_SSL=false

# Path to a file holding a full connection string (docker/Kubernetes secret
# style). Read only if the file exists, and merged AFTER DATABASE_URL, so it
# wins over it.
DATABASE_URL_FILE=

# Individual connection parts, used only when DATABASE_URL is unavailable,
# for example when moving to an external Postgres by clearing DATABASE_URL.
# The code has no host/user/password defaults, despite what the docs table
# claims.
DATABASE_HOST=
# @type=port
DATABASE_PORT=5432
DATABASE_NAME=unleash
DATABASE_USERNAME=
# @sensitive
DATABASE_PASSWORD=

# Schema Unleash owns inside that database. Migrations create it if missing.
DATABASE_SCHEMA=public

# Connection pool bounds and how long (ms) an idle connection survives. Four
# connections is enough for a small instance; raise DATABASE_POOL_MAX before
# blaming Unleash for queueing under SDK metrics bursts.
# @type=number
DATABASE_POOL_MIN=0
# @type=number
DATABASE_POOL_MAX=4
# @type=number
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# `application_name` reported on each connection; shows up in pg_stat_activity.
DATABASE_APPLICATION_NAME=unleash

# Skip the migration run at startup. Only for instances where a separate job
# migrates; a stale schema otherwise fails in ways that look like data loss.
# @type=boolean
DATABASE_DISABLE_MIGRATION=false

# TLS material for an EXTERNAL Postgres, ignored while DATABASE_SSL is set
# (it short-circuits all of these). The three *_FILE paths must exist inside
# the container; supplying any of them flips DATABASE_SSL_REJECT_UNAUTHORIZED
# to true unless you set it explicitly. DATABASE_SSL_CA_CONFIG is the
# alternative "whole SSL config as a JSON file" form.
# @type=boolean
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CERT_FILE=
DATABASE_SSL_KEY_FILE=
DATABASE_SSL_CA_CONFIG=

# ─── Bundled Postgres ────────────────────────────────────────────────────

# Role and database the postgres:17-alpine container creates on first boot,
# matching the user and database name in DATABASE_URL. Changing either
# without changing DATABASE_URL leaves Unleash unable to connect; changing
# them after the volume exists does nothing at all, because initdb only runs
# on an empty data directory.
POSTGRES_USER=unleash
POSTGRES_DB=unleash

# Password for that role, used by both the database container and
# DATABASE_URL. Private to the stack network, but it is still full read/write
# access to every flag, token hash and user record Unleash stores.
# @required
# @sensitive
POSTGRES_PASSWORD=

# ─── Authentication and first-boot credentials ───────────────────────────

# SECURITY, read this one. On the very first boot, when the user table is
# empty, Unleash creates an admin account with username `admin` and password
# `unleash4all` (services/user-service.ts) and logs that password in
# plaintext. Setting UNLEASH_DEFAULT_ADMIN_USERNAME **and**
# UNLEASH_DEFAULT_ADMIN_PASSWORD replaces both. The code needs BOTH
# (`username && password`), so setting only the password leaves the well-known
# default in place, which the docs table does not say. Neither variable
# rotates anything later: once a user exists the bootstrap is skipped, so an
# instance that has already booted must have its password changed in the UI.
# @sensitive
UNLEASH_DEFAULT_ADMIN_USERNAME=
# @sensitive
# @docs("Initial admin setup", https://docs.getunleash.io/deploy/configuring-unleash#initial-setup)
UNLEASH_DEFAULT_ADMIN_PASSWORD=

# How sign-in works. Values are matched case-insensitively against the enum
# KEYS in create-config.ts, so `open_source`, `demo`, `enterprise`, `hosted`,
# `custom` and `none` are the real accepted spellings; the documented
# `open-source` is NOT one of them, it just falls through to the same
# default. `none` DISABLES AUTHENTICATION ENTIRELY: every request is treated
# as an admin and API tokens stop being required (app.ts installs
# noAuthentication + noApiToken). `demo` lets anyone sign in with any email
# address. Neither belongs on anything reachable from the internet.
# @type=enum(open_source, demo, enterprise, hosted, custom, none)
# @docs("Authentication and authorization", https://docs.getunleash.io/deploy/configuring-unleash#authentication-and-authorization)
AUTH_TYPE=

# Whether client/frontend/admin API endpoints require a token at all. Setting
# it to false opens the whole API to unauthenticated callers; the upstream
# docs call this "highly discouraged" and they are right.
# @type=boolean
AUTH_ENABLE_API_TOKEN=true

# Only meaningful with AUTH_TYPE=demo: allows signing in as the admin user by
# typing `admin` in the email field.
# @type=boolean
AUTH_DEMO_ALLOW_ADMIN_LOGIN=false

# SECURITY. Comma-separated tokens minted on first boot, only while the token
# table is still empty (api-token-service.ts). Format is
# `<project>:<environment>.<secret>`, e.g. `*:*.some-long-random-string`.
# INIT_ADMIN_API_TOKENS creates full ADMIN tokens: anyone holding one can do
# anything in the instance, including creating users, and no further
# authentication is involved; it is undocumented upstream. INIT_FRONTEND and
# INIT_BACKEND tokens are read-only for flag evaluation but are still
# credentials, and the ones in Unleash's own demo compose
# (`unleash-insecure-api-token`) are published in every copy of that file, so
# never reuse them. Leave all of these empty and create tokens in the UI
# unless you are seeding an instance from configuration.
# @sensitive
# @docs("API tokens and client keys", https://docs.getunleash.io/concepts/api-tokens-and-client-keys)
INIT_ADMIN_API_TOKENS=
# @sensitive
INIT_BACKEND_API_TOKENS=
# @sensitive
INIT_FRONTEND_API_TOKENS=
# Deprecated alias for INIT_BACKEND_API_TOKENS; read only when that is unset.
# @sensitive
INIT_CLIENT_API_TOKENS=

# Secret the session cookie is signed with (express-session, via
# middleware/session-db.ts). Upstream defaults it to the literal string
# `super-secret`, which is published in the source, so a default install can
# have session cookies forged against it; the compose therefore prompts for a
# generated value instead (`openssl rand -hex 32`; hex, not base64, so the
# value stays free of characters that need escaping wherever it is carried).
# Changing it invalidates every existing session.
# @required
# @sensitive
UNLEASH_SECRET=

# Session lifetime in hours, whether logout sends `Clear-Site-Data`, and how
# many concurrent password sessions one user may hold (5 on open source; the
# code clamps to at least 1).
# @type=number
SESSION_TTL_HOURS=48
# @type=boolean
SESSION_CLEAR_SITE_DATA_ON_LOGOUT=true
# @type=number
MAX_PARALLEL_SESSIONS=5

# Send HSTS, CSP and related headers, and mark the session cookie `secure`.
# Turn this on once TLS terminates in front of Unleash. With it off the
# session cookie has no `secure` flag. Do NOT turn it on while serving plain
# HTTP: browsers then drop the cookie and login silently fails. The
# CSP_ALLOWED_* variables (SCRIPT, STYLE, IMG, FONT, CONNECT, MEDIA, OBJECT,
# FRAME, DEFAULT) take comma-separated origins to widen the policy.
# @type=boolean
# @docs("Security and sessions", https://docs.getunleash.io/deploy/configuring-unleash#security-and-sessions)
SECURE_HEADERS=false

# CORS allow-list for the Frontend API (`/api/frontend`), which browsers call
# directly with a frontend token. Defaults to `*` (any origin), so set the
# origins of your own apps if the token could leak from someone else's page.
UNLEASH_FRONTEND_API_ORIGINS=

# Per-IP, per-minute limits on the credential endpoints: password login
# (`POST /auth/simple`), password-reset requests, and user creation. These
# are the brute-force brakes; lower rather than raise them.
# @type=number
SIMPLE_LOGIN_LIMIT_PER_MINUTE=10
# @type=number
PASSWORD_RESET_LIMIT_PER_MINUTE=1
# @type=number
CREATE_USER_RATE_LIMIT_PER_MINUTE=20

# AES-256-CBC key and IV (both hex) used to encrypt e-mail addresses when the
# anonymisation path is active. Undocumented; both must be set or the value
# is passed through unencrypted.
# @sensitive
UNLEASH_ENCRYPTION_KEY=
# @sensitive
UNLEASH_ENCRYPTION_IV=

# ─── Email ───────────────────────────────────────────────────────────────

# SMTP host. This one variable is the on/off switch: with it empty no mailer
# is constructed, and password-reset links, user invites and any other mail
# are silently skipped ("No mailer is configured" in the log). New users then
# have to be given their reset link by hand from the UI. The literal value
# `test` is a code-only escape hatch that swallows mail into a JSON transport.
# @docs("Configure an email server", https://docs.getunleash.io/deploy/configuring-unleash#configure-an-email-server)
EMAIL_HOST=

# Port and whether to open the connection with implicit TLS. `secure=true`
# goes with port 465; 587 with STARTTLS keeps EMAIL_SECURE false.
# @type=port
EMAIL_PORT=587
# @type=boolean
EMAIL_SECURE=false

# From-address on everything Unleash sends. The default points at
# getunleash.io and will be rejected or spam-filed by most relays, so set your
# own sender.
EMAIL_SENDER=Unleash <noreply@getunleash.io>

# SMTP credentials. Both are passed straight to nodemailer; leave them empty
# for a relay that authenticates by network location.
EMAIL_USER=
# @sensitive
EMAIL_PASSWORD=

# Extra SMTP headers as a JSON object, e.g. {"X-SES-CONFIGURATION-SET":"..."}.
# Invalid JSON falls back to no headers.
EMAIL_OPTIONAL_HEADERS=

# ─── Logging and monitoring ──────────────────────────────────────────────

# Minimum level for the console logger. The default is `error`, not `info` as
# the docs table says, so a quiet instance is normal; `info` is what you want
# while debugging startup, and `debug` is very loud. An unrecognised value
# also lands on `error`. Note that at `info` the first-boot admin password is
# printed to the logs.
# @type=enum(debug, info, warn, error, fatal)
# @docs("Logging and monitoring", https://docs.getunleash.io/deploy/configuring-unleash#logging-and-monitoring)
LOG_LEVEL=error

# Log one line per incoming request (URL + status). Useful for tracing SDK
# traffic, expensive to leave on.
# @type=boolean
REQUEST_LOGGER_ENABLE=false

# Base URL of a Prometheus-compatible query API, used to populate the Network
# view. Unleash's own metrics are always exposed at
# /internal-backstage/prometheus regardless of this.
# @type=url
PROMETHEUS_API=

# How many days of aggregated daily flag metrics to keep before pruning.
# @type=number
DAILY_METRICS_STORAGE_DAYS=91

# ─── Feature and API behaviour ───────────────────────────────────────────

# Comma-separated environment names to force-enable at startup, overriding
# what is stored in the database (`development,production`). It only enables:
# environments not listed are left as they are.
# @docs("Environments", https://docs.getunleash.io/concepts/environments)
ENABLED_ENVIRONMENTS=

# Server-side memoisation of `GET /api/client/features`, the endpoint every
# backend SDK polls. Max-age is in milliseconds; leaving it unset uses one
# hour, while setting it to a bad value falls back to 600ms (the "default"
# the docs quote). Higher means less database load and staler flags for
# clients.
# @type=boolean
CLIENT_FEATURE_CACHING_ENABLED=true
# @type=number
CLIENT_FEATURE_CACHING_MAXAGE=3600000

# How often (milliseconds) frontend SDKs are told to refresh from the cache.
# @type=number
FRONTEND_API_REFRESH_INTERVAL_MS=2700000

# Seconds browsers may cache the CORS preflight for the frontend API.
# @type=number
ACCESS_CONTROL_MAX_AGE=86400

# Per-IP, per-minute ceilings on the high-volume SDK endpoints. Note the
# crossed wiring described in the header: the REGISTER_CLIENT_* value is
# applied to metrics and the CLIENT_METRICS_* value to register.
# @type=number
REGISTER_CLIENT_RATE_LIMIT_PER_MINUTE=6000
# @type=number
CLIENT_METRICS_RATE_LIMIT_PER_MINUTE=6000
# @type=number
REGISTER_FRONTEND_RATE_LIMIT_PER_MINUTE=6000
# @type=number
FRONTEND_METRICS_RATE_LIMIT_PER_MINUTE=6000

# ─── Container runtime ───────────────────────────────────────────────────

# Both are baked into the image (NODE_ENV=production, TZ=UTC) and neither
# normally needs setting. Timestamped jobs (token-expiry warnings in
# particular) assume UTC, so changing TZ shifts when they fire; NODE_ENV
# away from `production` turns on development-only surfaces such as the UI
# stories page.
NODE_ENV=production
TZ=UTC
