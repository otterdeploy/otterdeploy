# Kestra 1.3.37 (image kestra/kestra:v1.3.37) environment schema
# (@env-spec / varlock format).
#
# Read this first: Kestra is a Java/Micronaut server and its configuration
# surface is a YAML document (`application.yml`), NOT a list of environment
# variables. There is no upstream `.env.example` and no env-var reference
# table for the bulk of the settings, because there is nothing to reference:
# every knob is a YAML path.
#
# Two things turn that YAML into environment:
#
#   1. `KESTRA_CONFIGURATION`. The launcher stub prepended to the runnable jar
#      (gradle/jar/selfrun.sh at v1.3.37,
#      https://github.com/kestra-io/kestra/blob/v1.3.37/gradle/jar/selfrun.sh)
#      writes the variable's contents verbatim to
#      `${KESTRA_CONFIGURATION_PATH}/application.yml` and exports
#      `MICRONAUT_CONFIG_FILES` at it. That is the whole mechanism: one env var
#      carrying a whole YAML file. This template uses it, which is why the
#      stack needs no bind mount. The same file is the only other place the
#      image reads env directly: KESTRA_PLUGINS_PATH, KESTRA_CONFIGURATION_PATH,
#      KESTRA_CONFIGURATION, JAVA_OPTS, LD_PRELOAD_ENABLED, LD_PRELOAD.
#   2. Micronaut's env-var conversion. Any YAML path can also be set as an env
#      var by uppercasing it and turning `.` and `-` into `_`
#      (`kestra.server.basic-auth.username` → `KESTRA_SERVER_BASIC_AUTH_USERNAME`),
#      and env vars win over the file. Kestra documents this conversion at
#      https://kestra.io/docs/configuration/configuration-basics, including
#      the trap that a single underscore between the last two segments of a
#      multi-word property can be read as a nested path, for which the fix is a
#      double underscore (`..._ACCESS__KEY`).
#
# So this file is deliberately short. It declares what the compose sets, what
# the image's own launcher reads, and the handful of Micronaut overrides that
# an operator of THIS stack actually reaches for (auth, encryption, public
# URL, telemetry). Padding it with a hundred synthesised `KESTRA_*` names
# (every storage backend, every secret backend, every liveness timer) would be
# inventing an API that upstream does not publish. Those live in the YAML;
# edit the template's `KESTRA_CONFIGURATION` block instead.
#
# Source: the v1.3.37 tag, specifically cli/src/main/resources/application.yml
# (the shipped defaults), gradle/jar/selfrun.sh (the launcher), and the classes
# that read each property: webserver BasicAuthService/AuthenticationFilter,
# webserver MiscController (kestra.url, kestra.environment.*, the two
# anonymous-usage-report flags), core DefaultRunContext
# (kestra.encryption.secret-key), core RunContextCache
# (kestra.variables.env-vars-prefix) and core SecretService (the `SECRET_`
# prefix). Cross-checked against upstream's own docker-compose.yml at the same
# tag and the published configuration reference.
#
# SECURITY, the important part. Kestra runs arbitrary code by design: a flow
# is a script, and whoever can log in can execute shell, Python or Docker
# workloads inside the container, reach anything the container can reach, and
# read the internal storage volume. An exposed Kestra is remote code execution
# on the host, not "a dashboard someone might scribble on".
#
# Basic auth is MANDATORY in OSS since 0.24 and this version is well past
# that: at v1.3.37 `AuthenticationFilter` is registered unconditionally and the
# old `kestra.server.basic-auth.enabled` flag no longer exists; the class has
# only `username`, `password` and `realm`. It is NOT, however, self-securing.
# With no credentials configured the instance boots with `/ui/main/setup` and
# `/api/v1/*/basicAuth` open, and the first visitor to reach it becomes the
# administrator and locks everyone else out. Set the two
# KESTRA_SERVER_BASIC_AUTH_* values below before the stack is reachable.
#
# Two further exposures the compose does not create but an operator can:
# Kestra's management port (`endpoints.all.port`, default 8081, serving health,
# `/metrics`, `/loggers`, and `/env`, which prints configuration) is
# unauthenticated and this compose deliberately does not publish it; and the
# default `basic-auth.open-urls` leave the webhook trigger endpoints
# (`/api/v1/*/executions/webhook/`) unauthenticated by design, guarded only by
# the per-flow webhook key.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Kestra configuration reference", https://kestra.io/docs/configuration)
# ---

# ─── How the configuration is supplied ──────────────────────────────────────

# The entire `application.yml`, inlined. The compose sets this to a multi-line
# YAML document that wires the datasource at the bundled Postgres, selects the
# postgres repository and queue, puts internal storage on the `kestra-storage`
# volume at /app/storage, and points the task working directory at
# `kestra-wd`. It is declared empty here only because a schema value must be a
# single line and this one is a whole file. The compose is the source of
# truth for it, and anything you set here replaces that document wholesale
# (which will take the database connection with it). To change one setting,
# edit the compose block or override just that path with its `KESTRA_*` /
# `DATASOURCES_*` twin, which Micronaut applies on top.
# @docs("Configuration basics: YAML and env overrides", https://kestra.io/docs/configuration/configuration-basics)
KESTRA_CONFIGURATION=

# Directory the launcher writes that YAML into before starting the JVM. Must
# be writable by the image's non-root `kestra` user; /app/confs ships in the
# image for exactly this. Only worth changing if you mount your own config
# directory.
KESTRA_CONFIGURATION_PATH=/app/confs

# Where Kestra loads plugin jars from at boot. The default directory is baked
# into the image with the bundled plugin set; repoint it at a mounted volume
# if you install plugins yourself rather than rebuilding the image.
# @docs("Plugins and execution configuration", https://kestra.io/docs/configuration/plugins-and-execution)
KESTRA_PLUGINS_PATH=/app/plugins

# Port the webserver binds. The compose exposes container port 8080 without
# overriding this, so the two are a pair: change it and routing breaks. Note
# this is only the API/UI port. The management port is separate
# (`endpoints.all.port`, 8081), unauthenticated, and intentionally not
# published by this compose.
# @type=port
MICRONAUT_SERVER_PORT=8080

# JVM flags, appended after Kestra's own (`-XX:MaxRAMPercentage=50.0`) so they
# override them. The two that matter in practice are `-Duser.timezone=...`,
# which decides how schedules and log timestamps are interpreted, and `-Xmx`
# when the percentage-based heap is wrong for the host.
JAVA_OPTS=

# Preloads the system libstdc++ so DuckDB and RocksDB can coexist in one JVM.
# The launcher only does this on x86_64 (the path it probes is
# /lib/x86_64-linux-gnu/libstdc++.so.6), so on arm64 it is already a no-op.
# Set to `false` only if the preload itself is what is breaking a plugin.
# @type=boolean
LD_PRELOAD_ENABLED=true

# ─── Authentication ─────────────────────────────────────────────────────────

# Administrator login, and the reason this instance is not free for the taking.
# Must be a valid e-mail address: `BasicAuthService.save` rejects anything
# else and records the validation error instead of creating the account.
# Leaving it empty does not disable authentication (there is no such switch at
# this version); it leaves the setup page open until someone claims it.
# Seeded into the database at startup, so changing it later re-seeds it.
# @required
# @type=email
# @docs("Basic authentication is mandatory on OSS", https://kestra.io/docs/migration-guide/v0.24.0/basic-authentication)
KESTRA_SERVER_BASIC_AUTH_USERNAME=

# Password for that account. Enforced shape at v1.3.37: at least 8 characters
# with a lowercase letter, an uppercase letter and a digit; 256 characters max
# for the pair. Stored bcrypt-hashed. This single credential is the only thing
# between the public internet and arbitrary code execution on this host, so
# treat it as a root password, not a login.
# @required
# @sensitive
# @type=string(minLength=8)
# @docs("Security hardening: configure basic auth before first start", https://kestra.io/docs/administrator-guide/security-hardening)
KESTRA_SERVER_BASIC_AUTH_PASSWORD=

# ─── Secrets and encryption ─────────────────────────────────────────────────

# Base64 key (32 bytes: `openssl rand -base64 32`) used for AES/GCM encryption
# of `SECRET` flow inputs and outputs at rest. Unset, those inputs and outputs
# fail at runtime; everything else works, which is why this is not @required.
# Set it before you start using SECRET types and never rotate it casually,
# since values already written are unreadable without the original key.
# @sensitive
# @docs("Encryption and secret backends", https://kestra.io/docs/configuration/security-and-secrets)
KESTRA_ENCRYPTION_SECRET_KEY=

# Prefix that exposes host environment variables to flows. With the default,
# `ENV_MY_VARIABLE` becomes `{{ envs.my_variable }}`. Worth knowing before you
# put anything sensitive in this stack's environment: every variable with this
# prefix is readable from any flow. (Separately, and not configurable here,
# OSS has no secret store. `{{ secret('X') }}` reads a base64-encoded
# `SECRET_X` environment variable, so those are readable from flows too.)
# @docs("Environment variables as secrets (OSS)", https://kestra.io/docs/concepts/secret)
KESTRA_VARIABLES_ENV_VARS_PREFIX=ENV_

# ─── Instance identity and telemetry ────────────────────────────────────────

# Public base URL of this instance, without `/ui` or `/api`. Purely cosmetic
# for browsing, but notification tasks and generated links embed it, so
# unset means alerts arrive pointing at nothing. Set it to the URL the stack
# is actually served on.
# @type=url
# @docs("Optional runtime features: kestra.url", https://kestra.io/docs/configuration/runtime-and-storage)
KESTRA_URL=

# Label and accent colour shown in the UI header, for telling a production
# instance apart from a staging one at a glance. Colour is a CSS hex string,
# e.g. `#FCB37C`. Both are read as nullable, with no default and no banner.
KESTRA_ENVIRONMENT_NAME=
KESTRA_ENVIRONMENT_COLOR=

# Loads Kestra's tutorial flows into the instance on every startup. Harmless,
# but it means a brand-new install is not empty; turn it off if you want the
# namespace list to contain only your own flows.
# @type=boolean
KESTRA_TUTORIAL_FLOWS_ENABLED=true

# Anonymous usage reporting. On by default at this version: the server posts
# instance and plugin usage to https://api.kestra.io hourly, and the UI
# reports separately. Set both to `false` for an instance that must not make
# outbound calls to the vendor.
# @type=boolean
KESTRA_ANONYMOUS_USAGE_REPORT_ENABLED=true
# @type=boolean
KESTRA_UI_ANONYMOUS_USAGE_REPORT_ENABLED=true

# ─── Bundled Postgres ───────────────────────────────────────────────────────

# The stack runs its own postgres:16-alpine, which Kestra uses for BOTH the
# repository (flows, executions, logs, the basic-auth credentials themselves)
# and the queue. Flyway migrates the schema on boot. Role created by the
# Postgres image on first boot; it is written into the JDBC URL inside
# KESTRA_CONFIGURATION, so changing it here alone only breaks the pair.
POSTGRES_USER=kestra

# Password for that role, used by the database container and by Kestra's
# datasource. Reachable only on the stack's private network, but it is a
# read/write path to every flow definition, every execution log and the
# administrator's stored credential, so it deserves a generated value.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot, matching the JDBC URL in
# KESTRA_CONFIGURATION.
POSTGRES_DB=kestra
