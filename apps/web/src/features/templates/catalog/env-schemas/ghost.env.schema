# Ghost 6.62.0 (image ghost:6.62.0-alpine) environment schema
# (@env-spec / varlock format).
#
# Ghost has no GHOST_* variables. It is configured by nconf, which is loaded in
# core/shared/config/loader.ts with `nconf.env({separator: '__', parseValues:
# true})`: every environment variable name is split on `__` into a path in
# Ghost's config tree, so `database__connection__password` sets
# `database.connection.password`, and values are JSON-parsed (so `false` is a
# boolean and `2368` a number, not strings).
#
# Source: the config tree of TryGhost/Ghost v6.62.0:
# ghost/core/core/shared/config/defaults.json (defaults recorded below),
# overrides.json (values no env var can change, deliberately omitted here),
# env/config.production.json, and every `config.get('...')` read across
# ghost/core/core (177 distinct paths). Cross-checked against the official
# image's own build (docker-library/ghost, 6/alpine3.23) and the Docker Hub
# reference. A plain `process.env` grep would have found almost nothing: the
# only reads in the app are NODE_ENV and a handful of dev/CI flags.
#
# What the image bakes in, which is what these defaults describe: NODE_ENV=
# production, GHOST_CONTENT=/var/lib/ghost/content, and a config.production.json
# generated at build time by Ghost-CLI 1.32.2 with `--ip '::' --port 2368`, a
# `url` of localhost:2368, and `paths.contentPath=/var/lib/ghost/content`. That
# CLI-generated file also sets `logging.transports` to ["file","stdout"], which
# is why `docker logs` works even though Ghost's own production defaults say
# ["file"] only.
#
# Two details the config reference does not spell out:
#   * `database__client: mysql` is rewritten to `mysql2` at config load
#     (sanitizeDatabaseProperties in core/shared/config/utils.ts). Ghost 6
#     ships only the mysql2 driver, and the same function DELETES
#     database.connection.filename whenever the client is MySQL, so a stray
#     SQLite path cannot shadow the compose's connection.
#   * any nested key (one containing at least one `__`) also accepts a `_FILE`
#     twin that is read from a file path instead (see the Docker secrets
#     section below). Setting a key AND its `_FILE` twin is a hard boot error.
#
# The compose prompts for GHOST_URL and MYSQL_PASSWORD and threads them,
# unchanged, into `url` and into both `database__connection__password` and the
# bundled MySQL's own `MYSQL_PASSWORD`.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Ghost configuration reference", https://ghost.org/docs/config/)
# ---

# ─── Core ────────────────────────────────────────────────────────────────────

# Platform prompt key for the site's public URL; threaded unchanged into `url`
# below. Include the scheme, and the full path if Ghost is served from a
# subdirectory, e.g. example.com/blog/ served over https.
# @required
# @type=url
# @docs("Running Ghost with config env variables", https://ghost.org/docs/config/#running-ghost-with-config-env-variables)
GHOST_URL=

# The canonical public URL of the publication. Every link, RSS entry, sitemap
# entry, member magic link and email Ghost generates is built from it, so a
# wrong value produces a site that renders but whose links all point elsewhere.
# Set by the compose from GHOST_URL above. Required in production; the image's
# baked default is http://localhost:2368.
# @required
# @type=url
# @docs("URL", https://ghost.org/docs/config/#url)
url=${GHOST_URL}

# Serves the admin panel (/ghost/) from a different scheme or hostname than the
# public site. It cannot change the path, which is always /ghost/. Empty means
# admin lives on `url`.
# @type=url
# @docs("Admin URL", https://ghost.org/docs/config/#admin-url)
admin__url=

# Which config.<env>.json file nconf loads and how Ghost behaves. The image sets
# `production`. `development` switches Ghost to the SQLite dev config, turns off
# asset minification and staff device verification, and is not a deployment
# mode.
# @type=enum(production, development)
# @docs("Ghost image reference", https://hub.docker.com/_/ghost)
NODE_ENV=production

# Address Ghost's HTTP server binds inside the container. The image's baked
# config uses `::` (all addresses, dual-stack); narrowing it makes Ghost
# unreachable from the container network.
# @docs("Server", https://ghost.org/docs/config/#server)
server__host=::

# Port Ghost listens on. This is the port the compose exposes; changing it here
# without changing the exposed port breaks routing.
# @type=port
server__port=2368

# Milliseconds to let in-flight jobs finish after SIGTERM before the process
# exits.
# @type=number
server__shutdownTimeout=60000

# Where themes, images, media, files, logs, and adapters live. The image sets
# this to /var/lib/ghost/content, which is exactly where the compose mounts the
# `ghost-content` volume. Point it elsewhere and the volume stops covering your
# content.
# @docs("Paths", https://ghost.org/docs/config/#paths)
paths__contentPath=/var/lib/ghost/content

# ─── Bundled database (MySQL) ────────────────────────────────────────────────
# Set on the `db` service by the compose. These are the official MySQL image's
# own bootstrap variables, read once when the data directory is initialised,
# not Ghost config. Ghost's own app code never reads a MYSQL_* variable.

# Database created at first init, and the account Ghost connects as.
# @docs("MySQL image reference", https://hub.docker.com/_/mysql)
MYSQL_DATABASE=ghost
MYSQL_USER=ghost

# Platform prompt key for the database password. Used twice: it initialises the
# bundled MySQL user, and the compose threads the same value into
# `database__connection__password` below. Changing it after first boot does not
# change the password already stored in the MySQL data volume.
# @required
# @sensitive
MYSQL_PASSWORD=

# "1" makes MySQL generate and discard a random root password at init instead of
# leaving root open, since Ghost only ever connects as MYSQL_USER.
MYSQL_RANDOM_ROOT_PASSWORD=1

# ─── Database connection ─────────────────────────────────────────────────────
# Read by Ghost itself (knex) to reach the `db` service above. Required in
# production: Ghost 6 will not run on SQLite outside development.

# `mysql` is accepted and silently rewritten to `mysql2` at config load; Ghost 6
# bundles only the mysql2 driver. `sqlite3`/`better-sqlite3` are development-only
# and are rejected by the production config.
# @required
# @type=enum(mysql, mysql2, sqlite3, better-sqlite3)
# @docs("Database", https://ghost.org/docs/config/#database)
database__client=mysql

# Hostname of the database server. Derived by the platform from the bundled `db`
# service and never typed by the operator.
# @required
database__connection__host=${{stack.db.HOST}}

# @type=port
database__connection__port=3306

# @required
database__connection__user=ghost

# @required
# @sensitive
database__connection__password=${MYSQL_PASSWORD}

# @required
database__connection__database=ghost

# TLS to the database. Empty for the bundled MySQL, which is reached over the
# stack's private network. For a managed database this is a JSON object, e.g.
# {"rejectUnauthorized":true}, or the literal string "Amazon RDS"; nconf
# JSON-parses the value, so the object form works from an env var.
# @docs("Database SSL", https://ghost.org/docs/config/#ssl-2)
database__connection__ssl=

# Simultaneous knex connections held open. Defaults are 2/10; setting min to 0
# stops Ghost from keeping idle connections against the database.
# @type=number
# @docs("Number of connections", https://ghost.org/docs/config/#number-of-connections)
database__pool__min=2

# @type=number
database__pool__max=10

# Logs every SQL statement knex executes. Very noisy; debugging only.
# @type=boolean
database__debug=false

# ─── Transactional mail ──────────────────────────────────────────────────────
# Required in production for anything that emails a human: staff invitations,
# password resets, member signup and member sign-in (magic link) emails. With no
# mail config Ghost falls back to nodemailer's `direct` transport, which delivers
# straight from the container and is rejected by most receiving mail servers, so
# members silently never get their login links.

# The From: address on transactional email. Empty falls back to
# noreply@<your domain>, which many providers refuse to relay.
# @type=email
# @docs("Mail", https://ghost.org/docs/config/#mail)
mail__from=

# Nodemailer transport name; matched case-insensitively (core/server/services/
# mail/ghost-mailer.js lowercases it). "SMTP" for a normal mail provider,
# "sendmail" for a local MTA, "mailgun" for the Mailgun API, "direct" (the
# fallback) to attempt delivery from the container itself.
mail__transport=

# Everything under mail__options__ is handed to nodemailer's createTransport
# untouched, so any option that transport accepts can be set here with `__`.
mail__options__host=

# @type=port
mail__options__port=

# true for implicit TLS (usually port 465); false lets nodemailer upgrade with
# STARTTLS on 587. Note that some hosts block outbound 25/465/587 entirely.
# @type=boolean
mail__options__secure=

# Shorthand for a known provider's host/port (e.g. "Mailgun", "SendGrid",
# "Gmail") instead of setting host/port yourself.
mail__options__service=

mail__options__auth__user=

# @sensitive
mail__options__auth__pass=

# ─── Bulk email / newsletters ────────────────────────────────────────────────
# Sending newsletters to members is a separate path from transactional mail and
# only supports Mailgun. Configuring it here overrides whatever is set in
# Settings → Email newsletters; leave these empty to manage Mailgun from the
# admin UI instead (core/server/services/lib/mailgun-client.js prefers config
# over settings whenever `bulkEmail.mailgun` exists at all).

# @sensitive
# @docs("Configuring with Mailgun", https://ghost.org/docs/config/#configuring-with-mailgun)
bulkEmail__mailgun__apiKey=

# The sending domain configured in Mailgun.
# @docs("Using Mailgun for newsletters", https://ghost.org/docs/faq/mailgun-newsletters/)
bulkEmail__mailgun__domain=

# Mailgun API base URL: must include the version path, and must be the EU host
# (https://api.eu.mailgun.net/v3) for an EU-region Mailgun account.
# @type=url
bulkEmail__mailgun__baseUrl=

# Extra Mailgun tag added alongside Ghost's own "ghost-email" tag, for splitting
# analytics per site.
bulkEmail__mailgun__tag=

# Sends through Mailgun in test mode: accepted by the API, never delivered.
# @type=boolean
bulkEmail__mailgun__testmode=false

# Recipients per Mailgun API call. Mailgun's own ceiling is 1000; lowering it
# makes more, smaller calls.
# @type=number
bulkEmail__batchSize=1000

# Pulls delivery/open/click events back from Mailgun to populate email
# analytics. Turning it off leaves newsletters sending but unreported.
# @type=boolean
emailAnalytics__enabled=true

# Runs the email-analytics fetch as a background job inside Ghost.
# @type=boolean
backgroundJobs__emailAnalytics=true

# Sends the "welcome to Ghost" email after setup completes.
# @type=boolean
sendWelcomeEmail=true

# ─── Storage ─────────────────────────────────────────────────────────────────
# Which adapter stores uploaded images, media and files. The defaults write into
# paths__contentPath, i.e. the `ghost-content` volume.

# Ghost 6 ships a built-in S3Storage adapter
# (core/server/adapters/storage/S3Storage.ts). Set storage__active=S3Storage
# and fill the block below to offload to S3 or any S3-compatible bucket. Any
# other name must be a custom adapter dropped into
# <contentPath>/adapters/storage/.
# @docs("Storage adapters", https://ghost.org/docs/config/#storage-adapters)
storage__active=LocalImagesStorage

# Per-feature overrides: media (video/audio) and file uploads can use a
# different adapter than images.
storage__media=LocalMediaStorage
storage__files=LocalFilesStorage

# S3Storage settings. bucket, staticFileURLPrefix, cdnUrl,
# multipartUploadThresholdBytes and multipartChunkSizeBytes are all required
# together, since the adapter validates its config with zod at boot and refuses
# to start on a partial block.
storage__S3Storage__bucket=

# Path prefix objects are written under, e.g. "content/images".
storage__S3Storage__staticFileURLPrefix=

# Public base URL files are served from (the CDN or bucket website endpoint).
# @type=url
storage__S3Storage__cdnUrl=

# Extra key prefix inside the bucket, for sharing one bucket across sites.
storage__S3Storage__tenantPrefix=

storage__S3Storage__region=

# Custom S3 API endpoint, for MinIO/R2/Spaces and other S3-compatible stores.
storage__S3Storage__endpoint=

# Required by most S3-compatible stores that do not support virtual-host style
# bucket addressing.
# @type=boolean
storage__S3Storage__forcePathStyle=

# accessKeyId and secretAccessKey must be supplied as a pair. A half pair is
# rejected at boot rather than silently falling back to ambient AWS credentials.
# Omit both to use an instance role.
# @sensitive
storage__S3Storage__accessKeyId=

# @sensitive
storage__S3Storage__secretAccessKey=

# @sensitive
storage__S3Storage__sessionToken=

# Upload size above which the adapter switches to a multipart upload, and the
# size of each part. Both are byte counts and must be integers.
# @type=number
storage__S3Storage__multipartUploadThresholdBytes=

# @type=number
storage__S3Storage__multipartChunkSizeBytes=

# Base URLs Ghost rewrites content links to when assets are served from a CDN
# rather than from Ghost itself. Empty means serve everything from `url`.
urls__image=
urls__media=
urls__files=
urls__assets=

# ─── Adapters (cache, jobs, scheduling) ──────────────────────────────────────
# Swappable layers. The defaults are all in-process, which is what a single-
# container Ghost wants; anything else must be an adapter present in
# <contentPath>/adapters/.

# In-process LRU cache. A Redis-backed cache adapter would be configured here
# plus an `adapters__Redis__host`/`__port` block.
# @docs("Adapters", https://ghost.org/docs/config/#adapters)
adapters__cache__active=MemoryCache

# Background job backend. In-memory means jobs die with the container.
adapters__jobs__active=InMemoryJobsBackend

# How many background jobs run at once in-process.
# @type=number
adapters__jobs__InMemoryJobsBackend__concurrency=3

# Where custom URL redirects and route settings are persisted.
adapters__redirects__active=FileStore
adapters__sso__active=DefaultSSOAdapter

# Publishes scheduled posts. The default in-process scheduler is fine for a
# single container.
scheduling__active=scheduling-default

# ─── Logging ─────────────────────────────────────────────────────────────────

# info prints info, warn and error; error prints only errors.
# @docs("Logging", https://ghost.org/docs/config/#logging)
logging__level=info

# Where log lines go. JSON array, because nconf parses the value: ["stdout"]
# alone keeps everything in `docker logs`, ["file"] alone writes only to disk.
# The image's baked config uses ["file","stdout"].
# @docs("transports", https://ghost.org/docs/config/#transports)
logging__transports=["file","stdout"]

# Directory for the file transport. Empty resolves to <contentPath>/logs
# (loggingrc.js), i.e. inside the mounted content volume.
logging__path=

# Timestamp log lines in the container's local timezone instead of UTC.
# @type=boolean
logging__useLocalTime=false

# Log rotation for the file transport, on by default in production, keeping 10
# files rotated daily.
# @type=boolean
# @docs("rotation", https://ghost.org/docs/config/#rotation)
logging__rotation__enabled=true

logging__rotation__period=1d

# @type=number
logging__rotation__count=10

# Switches to the rotating-file-stream backend. Implied by any of threshold,
# totalSize, gzip or rotateExisting below.
# @type=boolean
logging__rotation__useLibrary=

# Size at which a log file rotates, e.g. "10m" or "500k".
logging__rotation__threshold=

# Total size cap across rotated files, e.g. "100m" or "1g".
logging__rotation__totalSize=

# @type=boolean
logging__rotation__gzip=

# Rotate an existing log file on startup if it is already past its period.
# @type=boolean
logging__rotation__rotateExisting=

# Records browser-side errors reported by the admin client at error level
# instead of warn.
# @type=boolean
logging__logClientErrorsAsError=true

# ─── Security ────────────────────────────────────────────────────────────────

# Emails a one-time auth code when a staff member signs in from a new device.
# Turning it off removes that check entirely (full 2FA is a separate setting in
# Settings → Staff).
# @type=boolean
# @docs("Security", https://ghost.org/docs/config/#security)
security__staffDeviceVerification=true

# Allows outgoing webhooks to target private/internal IP ranges. Off by default
# because it is an SSRF pivot from anyone who can create a webhook; only enable
# on a trusted internal network.
# @type=boolean
security__allowWebhookInternalIPs=false

# Sends X-Frame-Options on admin responses so /ghost/ cannot be framed by
# another origin.
# @type=boolean
adminFrameProtection=true

# Redirects /ghost -> /ghost/ and http -> https for admin routes.
# @type=boolean
admin__redirects=true

# Lifetime of a staff session in milliseconds; the default is 180 days.
# @type=number
admin__sessionMaxAgeMs=15552000000

# Value of the <meta name="referrer"> tag Ghost renders in {{ghost_head}}.
# Empty renders Ghost's own default, origin-when-crossorigin.
# @docs("Referrer Policy", https://ghost.org/docs/config/#referrer-policy)
referrerPolicy=

# Signs and verifies the integrity of internal requests between Ghost's own
# services. Leave on.
# @type=boolean
verifyRequestIntegrity=true

# Tells Ghost it sits behind a proxy on the loopback interface, so it trusts
# X-Forwarded-* headers from it when deriving the client IP and scheme.
# @type=boolean
usingLoopbackReverseProxy=false

# ─── Privacy ─────────────────────────────────────────────────────────────────
# Features that reach out to third parties. All are on unless set to false;
# `useTinfoil=true` turns every one of them off at once, and then an individual
# flag set to true opts that one back in (core/shared/config/helpers.ts).

# Look up member/staff avatars on Gravatar by email hash.
# @type=boolean
# @docs("Privacy", https://ghost.org/docs/config/#privacy)
privacy__useGravatar=true

# Emit Schema.org / Open Graph / Twitter Card tags in {{ghost_head}}.
# @type=boolean
privacy__useStructuredData=true

# Ping the IndexNow API on publish so Bing and Yandex reindex sooner.
# @type=boolean
privacy__useIndexNow=true

# Master switch: true disables all of the above in one go.
# @type=boolean
privacy__useTinfoil=false

# Where Ghost checks for new releases, and whether the check is forced. The
# check reports anonymous instance statistics to Ghost.org.
# @type=url
updateCheck__url=https://updates.ghost.org

# @type=boolean
updateCheck__forceUpdate=false

# ─── Content, themes & performance ───────────────────────────────────────────

# gzip/deflate compression of Ghost's own HTTP responses. Turn off only if a
# reverse proxy already compresses.
# @type=boolean
# @docs("Compress", https://ghost.org/docs/config/#compress)
compress=true

# Serve minified admin/frontend assets. The image builds them; false is a
# development-only setting.
# @type=boolean
useMinFiles=true

# Resize and recompress uploaded images (max width 2000px, JPEG quality 80,
# metadata stripped; the original is kept with an _o suffix). Turning resize off
# stores originals untouched.
# @type=boolean
# @docs("Image optimization", https://ghost.org/docs/config/#image-optimization)
imageOptimization__resize=true

# Generate responsive srcset variants for content images.
# @type=boolean
imageOptimization__srcsets=true

# @type=number
imageOptimization__defaultMaxWidth=2000

# max-age, in seconds, of the Cache-Control header on public responses. The
# frontend and Content API default to 0 (revalidate every request); raise them
# only if a CDN in front is doing the caching and you can purge it.
# @type=number
# @docs("Caching", https://ghost.org/docs/config/#caching)
caching__frontend__maxAge=0

# @type=number
caching__contentAPI__maxAge=0

# @type=number
caching__theme__maxAge=31536000

# @type=number
caching__publicAssets__maxAge=31536000

# Largest `limit` an API request may ask for, and whether `limit=all` is
# permitted at all. Raising these lets one request pull the whole content table.
# @type=number
optimization__maxLimit=100

# @type=boolean
optimization__allowLimitAll=false

# Ceilings, in bytes, on an uploaded theme zip: compressed size, any single
# entry uncompressed, and total uncompressed. They exist to stop a zip bomb.
# @type=number
theme__uploadLimits__compressedBytes=1073741824

# @type=number
theme__uploadLimits__entryUncompressedBytes=536870912

# @type=number
theme__uploadLimits__totalUncompressedBytes=4294967296

# ─── Members & payments ──────────────────────────────────────────────────────

# Talk to Stripe directly with your own keys instead of through Ghost's Stripe
# Connect flow. Only relevant if you entered a secret key rather than connecting
# an account.
# @type=boolean
stripeDirect=false

# Accept Stripe promotion codes at checkout.
# @type=boolean
enableStripePromoCodes=false

# Show the one-off tips/donations option to members.
# @type=boolean
enableTipsAndDonations=true

# Maximum number of custom member fields that can be defined.
# @type=number
members__customFields__maxDefinitions=100

# ─── Docker secrets (_FILE) ──────────────────────────────────────────────────
# Any variable whose name contains at least one `__` also accepts a `_FILE`
# twin: Ghost reads the value out of the file at that path instead
# (core/shared/config/secrets.ts), which is how Docker/Swarm secrets and
# Kubernetes projected volumes are meant to be used. Top-level names like `url`
# are deliberately excluded.

# Setting BOTH a key and its `_FILE` twin throws at boot. This compose already
# sets database__connection__password from the MYSQL_PASSWORD prompt, so use
# this twin only after clearing that.
# @sensitive
# @docs("Docker secrets", https://hub.docker.com/_/ghost)
database__connection__password_FILE=

# @sensitive
mail__options__auth__pass_FILE=

# @sensitive
bulkEmail__mailgun__apiKey_FILE=

# ─── Diagnostics ─────────────────────────────────────────────────────────────

# Error reporting to Sentry. Only `dsn` is needed; the release and environment
# are filled in from Ghost's version and NODE_ENV.
# @sensitive
sentry__dsn=

# true short-circuits the whole Sentry integration even when a DSN is present.
# @type=boolean
sentry__disabled=

# @type=boolean
sentry__tracing__enabled=false

# Fraction of transactions traced, 0 to 1.
sentry__tracing__sampleRate=0.0

# Prometheus metrics. When enabled, the `prometheus__pushgateway__*` block below
# configures pushing to a Pushgateway.
# @type=boolean
prometheus__enabled=false

# @type=boolean
prometheus__pushgateway__enabled=false

# @type=url
prometheus__pushgateway__url=

# @type=number
prometheus__pushgateway__interval=

# Exposes unfinished, unsupported admin features. Not for a production site.
# @type=boolean
enableDeveloperExperiments=false

# Namespaced debug logging for the node process, e.g. "ghost:*" or
# "ghost:*,ghost-config" to dump the resolved config tree at boot.
DEBUG=
