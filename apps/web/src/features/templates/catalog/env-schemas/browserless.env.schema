# Browserless 2.56.2 environment schema (@env-spec / varlock format).
#
# The compose pins ghcr.io/browserless/chromium:v2.56.2, the newest stable
# release (2026-09-02). Source: `src/config.ts` at tag v2.56.2, the one file
# that reads configuration, either as `process.env.NAME` or through its
# `parseEnvVars(default, ...names)` helper (which is why ALLOW_GET, CORS,
# HEALTH and friends do not show up in a naive `process.env.` grep). Nothing
# else under `src/` reads the environment; `scripts/` reads FORCE_ADBLOCK,
# FORCE_DEVTOOLS and WATCH_SCHEMAS at BUILD time only, and SCRATCH_SPEC_SECRET
# exists solely in a `.spec.ts`, so none of the four are declared here.
#
# Three things the docs get wrong for this image:
#   1. The configuration reference is written for the ENTERPRISE image and
#      lists KEY, MAX_RECONNECT_TIME, LOG_LEVEL, LOG_FORMAT,
#      HEARTBEAT_INTERVAL, OTEL_ENABLED and DISABLE_BLOCKLIST. None of those
#      names appear anywhere in the open-source tree at v2.56.2; setting them
#      on this container does nothing.
#   2. It says TZ defaults to UTC. The published image config actually bakes
#      TZ=America/Los_Angeles (docker/base/Dockerfile `ARG TZ`), so log
#      timestamps are US Pacific until you set TZ yourself.
#   3. It omits the CPU-sampling knobs (MACHINE_STATS_SOURCE,
#      CPU_SAMPLE_INTERVAL_MS, CPU_EMA_ALPHA, CPU_OVERLOAD_HYSTERESIS) and the
#      CORS_ALLOW_HEADERS / CORS_ALLOW_CREDENTIALS / CORS_EXPOSE_HEADERS
#      trio, all of which the code reads.
#
# v1 names (CONNECTION_TIMEOUT, MAX_CONCURRENT_SESSIONS, QUEUE_LENGTH,
# ENABLE_API_GET, ENABLE_CORS, PRE_REQUEST_HEALTH_CHECK, PROXY_URL,
# DEFAULT_USER_DATA_DIR) are still read as fallbacks but log a "please use
# <new name>" line on boot; the DEFAULT_* / PREBOOT_CHROME family is read only
# to print a deprecation warning and is otherwise ignored. Neither group is
# declared here. Use the v2 name.
# https://docs.browserless.io/enterprise/migrate-from-v1
#
# The compose sets TOKEN, CONCURRENT and TIMEOUT from BROWSERLESS_* operator
# inputs, so both halves of each pair are declared: the BROWSERLESS_* key is
# what an operator types, the bare key is what the container sees.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Docker configuration reference", https://docs.browserless.io/enterprise/docker/config)
# ---

# ─── Authentication ───────────────────────────────────────────────────────

# The API token every client must present (`?token=…` on the WebSocket URL or
# an Authorization header). Browserless does NOT generate one: if this is
# empty, `token` is null and every endpoint is unauthenticated, including
# `/function`, which executes arbitrary Puppeteer code from the request body.
# Treat an empty token as "anyone who can reach the port owns the host".
# @required @sensitive
# @docs("Open source Docker deployment", https://docs.browserless.io/enterprise/open-source)
BROWSERLESS_TOKEN=

# What the compose passes to the container as TOKEN. Derived from
# BROWSERLESS_TOKEN above; set that one, not this.
# @required @sensitive
TOKEN=${BROWSERLESS_TOKEN}

# ─── Capacity ─────────────────────────────────────────────────────────────

# How many browser sessions may run at once. Each is a real Chromium process,
# so this is a RAM/CPU budget, not a throughput dial: start low and raise it
# while watching /pressure. Upstream's own default is 10; this template
# chooses 5 to fit a small box.
# @type=number
BROWSERLESS_CONCURRENT=5

# What the compose passes to the container as CONCURRENT.
# @type=number
CONCURRENT=${BROWSERLESS_CONCURRENT:-5}

# How many requests may WAIT once CONCURRENT is saturated. Beyond
# CONCURRENT + QUEUED, new requests get 429 immediately rather than hanging.
# @type=number
# @docs("Built-in queueing system", https://docs.browserless.io/enterprise/long-queues)
QUEUED=10

# Milliseconds a session may live before Browserless kills it. `-1` disables
# the timer entirely, which leaks browsers unless your client always
# disconnects. Upstream's default is 30000; this template chooses 60000
# because screenshot/PDF work on slow pages routinely exceeds 30s.
# @type=number
BROWSERLESS_TIMEOUT=60000

# What the compose passes to the container as TIMEOUT.
# @type=number
TIMEOUT=${BROWSERLESS_TIMEOUT:-60000}

# Largest request body accepted, in bytes (10MB). Anything larger is refused
# before schema validation. Raise it if you POST big HTML blobs to /pdf or
# /content.
# @type=number
MAX_PAYLOAD_SIZE=10485760

# Read into the config object and reported by the `/config` endpoint. The
# open-source runtime at this version does not otherwise act on it; it exists
# for SDK/enterprise consumers that read `/config`.
# @type=number
RETRIES=5

# ─── Network ──────────────────────────────────────────────────────────────

# Address the HTTP/WebSocket server binds to. The image bakes 0.0.0.0 (the
# library's own default is `localhost`, which would make the container
# unreachable). Leave it alone unless you know why.
HOST=0.0.0.0

# Port inside the container. The compose exposes 3000; changing this without
# changing the exposed port leaves nothing listening where the platform
# routes.
# @type=port
PORT=3000

# Fully-qualified public URL of this instance. Used only to rewrite the
# addresses Browserless reports about ITSELF: `/sessions`,
# `devtoolsFrontendUrl`, `webSocketDebuggerUrl`. Without it those come back
# as the in-container host:port and a debugger link from outside is dead.
# The v1 name PROXY_URL still works but warns.
# @type=url
# @docs("NGINX load balancing", https://docs.browserless.io/enterprise/docker/nginx-load-balancing)
EXTERNAL=

# ─── Storage & paths ──────────────────────────────────────────────────────
# All four default to per-boot directories under the container's temp dir,
# which means nothing survives a restart. Point one at a mounted volume only
# if you want that data to persist; the compose mounts no volumes.

# Chromium user-data directory: cookies, cache, localStorage. Setting it
# forces EVERY session to share one profile (and therefore one login state)
# unless a request overrides it per-session. `~` is expanded.
# @docs("User data directory", https://docs.browserless.io/enterprise/user-data-directory)
DATA_DIR=

# Where files a page downloads are written, and where the /download API reads
# them back from.
DOWNLOAD_DIR=

# Per-session scratch space for browser temp files (each session gets its own
# subdirectory under this, since 2.55.3).
SCRATCH_DIR=

# File the running metrics are persisted to, read on startup and rewritten
# periodically. Empty means metrics live in the container's temp dir and are
# lost on restart.
# @docs("Metrics endpoint", https://docs.browserless.io/enterprise/utility-functions/metrics)
METRICS_JSON_PATH=

# Directory of compiled route modules to load INSTEAD of the image's own
# `build/routes`. Only for a custom image that adds routes; an empty or wrong
# path yields a server with no endpoints.
# @docs("Adding custom routes", https://docs.browserless.io/enterprise/docker/custom-routes)
ROUTES=

# Directory served as static assets (the debugger UI and its siblings).
# Defaults to the image's bundled `static/`.
STATIC=

# ─── Security ─────────────────────────────────────────────────────────────
# These four are parsed by `parseEnvVars`, which treats the literal string
# "false" as off and ANY other non-empty value as on. `ALLOW_GET=0` is
# therefore ON. Write "true"/"false" and nothing else.

# Allows `file://` URLs in navigations, i.e. lets any client with the token
# read files out of the container's filesystem. Off for good reason.
# @type=boolean
ALLOW_FILE_PROTOCOL=false

# Accepts GET requests carrying the JSON payload in a `?body=` query string,
# instead of POST only. Convenient for a browser address bar, and it puts the
# whole payload into every access log along the way.
# @type=boolean
ALLOW_GET=false

# Master switch for CORS response headers. The five CORS_* values below are
# only emitted when this is on. The v1 name ENABLE_CORS still works but warns.
# @type=boolean
CORS=false

# Origin allowed when CORS is on: a domain or glob. `*` means any site can
# drive this instance from a user's browser, so narrow it if you turn CORS on.
CORS_ALLOW_ORIGIN=*

# Methods advertised in Access-Control-Allow-Methods.
CORS_ALLOW_METHODS=OPTIONS, POST, GET

# Request headers advertised in Access-Control-Allow-Headers.
CORS_ALLOW_HEADERS=*

# Value of Access-Control-Allow-Credentials. Upstream defaults this to "true",
# which combined with CORS_ALLOW_ORIGIN=* is a combination browsers reject.
# Set a concrete origin if you need credentialed cross-origin calls.
# @type=boolean
CORS_ALLOW_CREDENTIALS=true

# Response headers exposed to the calling page.
CORS_EXPOSE_HEADERS=*

# Seconds a browser may cache the preflight response (30 days).
# @type=number
CORS_MAX_AGE=2592000

# ─── Health & pressure ────────────────────────────────────────────────────

# Turns on the pre-session health check: when CPU or memory is over the
# thresholds below, Browserless answers 503 instead of launching a browser.
# The thresholds are inert while this is off. Same "anything but the string
# false is true" parsing as the security flags. The v1 name
# PRE_REQUEST_HEALTH_CHECK still works but warns.
# @type=boolean
# @docs("Pressure endpoint", https://docs.browserless.io/enterprise/utility-functions/pressure)
HEALTH=false

# CPU percentage at which a healthy instance starts refusing work. 99 is
# effectively "never"; 80-90 is the useful range behind a load balancer.
# @type=number
MAX_CPU_PERCENT=99

# Memory percentage at which a healthy instance starts refusing work.
# @type=number
MAX_MEMORY_PERCENT=99

# Where CPU/memory numbers come from. "cgroup" reads the container's own
# limits (what you want when the container is capped), "host" reads the whole
# machine, "auto" prefers cgroup and falls back to host when the cgroup stat
# files are missing. An unrecognised value is rejected at boot.
# @type=enum(auto, host, cgroup)
MACHINE_STATS_SOURCE=auto

# Milliseconds between CPU samples feeding the pressure calculation.
# @type=number
CPU_SAMPLE_INTERVAL_MS=1000

# Smoothing factor (0-1) of the exponential moving average over those
# samples. Lower reacts slower and ignores spikes; higher tracks the
# instantaneous value.
# @type=number
CPU_EMA_ALPHA=0.3

# Percentage points the smoothed CPU must fall below MAX_CPU_PERCENT before
# the instance calls itself healthy again (the anti-flap band).
# @type=number
CPU_OVERLOAD_HYSTERESIS=10

# ─── Webhook alerts ───────────────────────────────────────────────────────
# Each is a URL Browserless POSTs to when the named thing happens. Empty
# disables that alert. They are fire-and-forget: a slow endpoint here slows
# nothing down, and a failing one is not retried.
# @docs("Docker webhooks", https://docs.browserless.io/enterprise/docker/webhooks)

# Fired when the health check (HEALTH=true) trips on CPU or memory.
# @type=url
FAILED_HEALTH_URL=

# Fired the moment requests start queueing behind CONCURRENT.
# @type=url
QUEUE_ALERT_URL=

# Fired when a request is rejected with 429 because the queue is full.
# @type=url
REJECT_ALERT_URL=

# Fired when a session is killed for exceeding TIMEOUT.
# @type=url
TIMEOUT_ALERT_URL=

# Fired on an unhandled error inside a session.
# @type=url
ERROR_ALERT_URL=

# ─── Debugger & logging ───────────────────────────────────────────────────

# Serves the built-in debugger UI at `/debugger`. It is protected by TOKEN
# like everything else, but it is also a full interactive browser console,
# so turn it off ("false") on an instance whose token is widely shared.
# @type=boolean
# @docs("Live debugger", https://docs.browserless.io/enterprise/live-debugger)
ENABLE_DEBUGGER=true

# Log namespaces, in `debug` module syntax. The default keeps Browserless's
# own lines and drops the `:verbose` ones. `-*` silences everything; `*` logs
# every npm package too and will flood your disk.
# @docs("debug module syntax", https://www.npmjs.com/package/debug)
DEBUG=browserless*,-**:verbose

# Timezone used for log timestamps and for anything the page reads from the
# system clock. The image bakes America/Los_Angeles; set UTC (or your own)
# unless US Pacific timestamps are what you want.
TZ=America/Los_Angeles
