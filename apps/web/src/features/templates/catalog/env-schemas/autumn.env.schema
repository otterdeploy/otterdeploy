# Autumn (commit 7ed106c, dev branch, 2026-08-17) environment schema
# (@env-spec / varlock format).
#
# Upstream (github.com/useautumn/autumn) ships no container image and cuts no
# GitHub releases for the app itself. Only its `autumn-js` client SDK is
# tagged (autumn-js-v1.2.x). The stack's image is our own build (see
# infra/autumn/Dockerfile) pinned to a upstream commit on `dev`, its default
# branch; that pin is this schema's source, not a tag or a docs page.
#
# Source: grep of process.env across server/src and shared at 7ed106c32f90.
# Cross-checked against server/.env.example on the same commit, which is
# mostly accurate with one exception: it lists REDIS_URL under "OPTIONAL ENV
# VARIABLES" as a generic cache, yet at this commit nothing in server/src
# actually reads bare REDIS_URL outside a one-off dev cleanup script
# (server/tests/clearMasterOrg.ts).
# The app's real cache/queue path runs through MISC_CACHE_DRAGONFLY_PUBLIC_URL
# and CACHE_V2_DRAGONFLY_URL, both pointed at the stack's "dragonfly" service.
# The compose still provisions a plain Redis/Valkey service and sets REDIS_URL
# on it (matching upstream's own docker-compose shape), so it's declared below
# even though it's presently unused by the pinned commit's code.
#
# self-hosting isn't a documented/supported path upstream (README: "contact
# the team on Discord" for self-host help). There is no self-host reference
# page, so @docs below points at the repo itself and the pinned commit's own
# .env.example.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Autumn (GitHub)", https://github.com/useautumn/autumn#readme)
# @docs("server/.env.example at this pin", https://github.com/useautumn/autumn/blob/dev/server/.env.example)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Origin the API server answers on. Validated by @autumn/env at boot: must be
# a bare http(s) origin (no path, query, hash or embedded credentials) or the
# process throws immediately. The dashboard's prebuilt JS is rewritten to this
# address at container start.
# @required @type=url
AUTUMN_API_URL=

# Origin the dashboard/frontend is served at. Used to build OAuth callback,
# invite, password-reset and SSO redirect links (server/src/utils/auth.ts),
# and is the only allowed dashboard CORS origin besides the upstream-hosted
# ones baked into server/src/utils/constants.ts.
# @required @type=url
CLIENT_URL=

# ─── Auth & encryption ───────────────────────────────────────────────────

# Better Auth's session-signing secret. The server refuses to boot without it
# (server/src/utils/initUtils.ts). Rotating it signs every session out.
# @required @sensitive
BETTER_AUTH_SECRET=

# Checked present at boot alongside ENCRYPTION_PASSWORD (initUtils.ts logs
# "used for Stripe key encryption" and exits if either is missing), but at
# this commit only ENCRYPTION_PASSWORD is actually read by the AES cipher
# (server/src/utils/encryptUtils.ts): the IV there is generated fresh per
# encryption call, not sourced from this var. Keep it set; the boot check
# doesn't care that the value itself goes unused.
# @required @sensitive
ENCRYPTION_IV=

# Hashed (SHA-512, truncated) to derive the AES-256-CBC key that encrypts
# stored Stripe API keys (server/src/utils/encryptUtils.ts). Losing this after
# customers have connected Stripe makes their stored keys undecryptable.
# @required @sensitive
ENCRYPTION_PASSWORD=

# ─── Database ────────────────────────────────────────────────────────────

# PLATFORM-OWNED: sibling Postgres service + this stack's own password.
# @required @sensitive
DATABASE_URL=postgres://autumn:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/autumn

# Password for the bundled Postgres. Generated at install.
# @required @sensitive
POSTGRES_PASSWORD=

# Hardcoded by the compose on the db service itself (not read from this env
# var). Informational: the database Autumn connects to is named "autumn",
# owned by role "autumn".
POSTGRES_USER=autumn
POSTGRES_DB=autumn

# ─── Cache ───────────────────────────────────────────────────────────────

# PLATFORM-OWNED: the stack's plain Redis/Valkey service. Provisioned to
# mirror upstream's own compose shape and upstream's .env.example; not
# currently read by any production code path at this pin (see header).
# @required
REDIS_URL=redis://${{stack.redis.HOST}}:6379

# PLATFORM-OWNED: this stack's Dragonfly service, used as Autumn's "misc"
# cache. Required at boot, because server/src/utils/initUtils.ts exits with
# "Misc Redis cache is not configured" if neither this nor the private-endpoint
# variant (MISC_CACHE_DRAGONFLY_PRIVATE_URL, an ECS-only option left unset
# here) resolves.
# @required
MISC_CACHE_DRAGONFLY_PUBLIC_URL=redis://${{stack.dragonfly.HOST}}:6379

# PLATFORM-OWNED: same Dragonfly service, used for Autumn's second-generation
# ("v2") cache layer (server/src/external/redis/initRedisV2.ts). Distinct
# subsystem from MISC_CACHE_DRAGONFLY_PUBLIC_URL above; both point at the
# same instance in this stack.
# @required
CACHE_V2_DRAGONFLY_URL=redis://${{stack.dragonfly.HOST}}:6379

# ─── DynamoDB (local emulator) ───────────────────────────────────────────
# The stack runs amazon/dynamodb-local as an in-memory emulator for Autumn's
# idempotency-key table (server/src/external/aws/dynamodb/). Overriding this
# endpoint to a real AWS region also needs real AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, which the compose does not set that way.

# PLATFORM-OWNED: the stack's DynamoDB-local service.
# @required @type=url
DYNAMODB_ENDPOINT=http://${{stack.dynamodb.HOST}}:8000

# Dummy credentials the AWS SDK still requires even against the local
# emulator; DynamoDB-local does not check them.
# @required
AWS_ACCESS_KEY_ID=local
# @required @sensitive
AWS_SECRET_ACCESS_KEY=local

# ─── Server tuning ───────────────────────────────────────────────────────

# Cluster worker count for the server process (server/src/utils/memory/
# forkRecycling/recyclePolicy.ts). Upstream defaults to 4 (capped at 6) when
# unset or non-numeric; each fork is a full app instance, and 4 OOM'd a
# 2 vCPU / 4 GB host in testing. Raise it on bigger machines.
# @type=number
SERVER_FORK_COUNT=1
