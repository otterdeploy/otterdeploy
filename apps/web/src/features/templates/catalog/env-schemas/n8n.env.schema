# n8n 2.37.9 environment schema (@env-spec / varlock format).
#
# The compose pins docker.n8n.io/n8nio/n8n:2.37.9 (docker.n8n.io is n8n's
# mirror of Docker Hub's n8nio/n8n, with the same manifests and the same auth
# realm). On 2026-09-04 (research date) `latest` and `stable` both point at
# 2.37.10 (sha256:307d6065…), published that morning; 2.37.9 is
# sha256:ed6bbab565eddbb688f394594cb2932d2b3b24f02240299a8fcce78bfe4201db.
# n8n also publishes `next`/`beta` (2.38.x) and `nightly`; neither is stable.
#
# Why 2.37.9 and not an older, more matured release: on 2026-09-02 n8n
# published ~19 advisories at once whose stable fix line is 2.37.7, including
# three highs that are remote code execution from a workflow expression
# (GHSA-6xcw-7xm6-48c6 and GHSA-hw8v-xxg5-vvvx, expression-sandbox escapes,
# and GHSA-hh89-3r9w-qj3j, unauthenticated storage exhaustion via OAuth
# dynamic client registration). Anything below 2.37.7 (including the otherwise
# more matured 2.36.9) is vulnerable. 2.37.9 adds the fix for the regression
# that hardening caused (mutating array methods on $json in expressions);
# 2.37.10, hours old at research time, only adds community-node API-version
# gating.
#
# Source: the `@Env('…')` decorators that build GlobalConfig, 470 distinct
# names under packages/@n8n/config/src (index.ts + configs/*.config.ts) at tag
# n8n@2.37.9, plus the module-local configs the same decorator feeds:
# packages/cli/src/push/push.config.ts,
# packages/cli/src/modules/community-packages/community-packages.config.ts,
# packages/@n8n/task-runner/src/config/js-runner-config.ts,
# packages/core/src/binary-data/binary-data.config.ts and
# packages/core/src/storage.config.ts. Those classes, not a raw process.env
# grep, are authoritative: almost nothing outside them reads the environment
# directly any more, and the legacy packages/cli/src/config/schema.ts is down
# to four internal settings that read no environment of their own.
#
# This file is the compose-set keys plus the groups an operator actually
# touches (URL/webhook, database, auth and user management, encryption,
# executions and queue mode, code execution, security hardening, logging).
# The remaining ~350 names (AI assistant/builder, MCP, insights, evaluation,
# source control, data tables, multi-main, per-metric Prometheus toggles) are
# documented upstream at the environment-variable reference linked below.
#
# Four things the docs do not make obvious at this version:
#   1. EVERY `@Env` key also accepts a `<NAME>_FILE` twin: decorators.ts reads
#      the value from the file at that path (docker secrets). Only
#      N8N_ENCRYPTION_KEY_FILE is declared here, as the example.
#   2. WEBHOOK_URL, the key this compose sets, is deprecated in 2.x in favour
#      of N8N_WEBHOOK_URL. It still works: url.service.ts resolves
#      `globalConfig.webhookUrl || process.env.WEBHOOK_URL || baseUrl`, so the
#      compose value is honored, and the deprecation service logs one warning
#      at boot. Set N8N_WEBHOOK_URL instead when you want the warning gone.
#   3. N8N_BASIC_AUTH_* is gone. A grep at this tag returns zero hits: 2.x has
#      no basic-auth mode at all, and user management (owner account, invites,
#      MFA) is the only authentication. Guides that still show
#      N8N_BASIC_AUTH_ACTIVE are describing 0.x.
#   4. N8N_RUNNERS_ENABLED is deprecated and ignored. Task runners are always
#      on in 2.x, in `internal` mode by default.

# @defaultSensitive=false @defaultRequired=infer
# @docs("n8n environment variables reference", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables)
# ---

# ─── Encryption & instance identity ───────────────────────────────────────

# The key n8n encrypts EVERY stored credential with (AES, via the settings
# file's `encryptionKey`). Treat it as the master secret of this instance: an
# attacker with the volume plus a weak or guessable key can decrypt every
# third-party credential your workflows hold: Google, AWS, Slack, database
# passwords, API tokens. Leave it empty and n8n generates a random key into
# ~/.n8n/config on first boot, which is safe but lives only in the volume.
# Once set, DO NOT CHANGE IT: n8n refuses to start when this disagrees with
# the key in the settings file, and credentials encrypted with the old key are
# unrecoverable. Generate with `openssl rand -base64 32`.
# @required @sensitive
# @docs("Encryption key", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration)
N8N_ENCRYPTION_KEY=

# Docker-secrets form: path to a file whose contents become the encryption
# key. Every other N8N_*/DB_*/QUEUE_* key has the same `_FILE` twin; setting
# both a key and its `_FILE` twin makes the file win.
N8N_ENCRYPTION_KEY_FILE=

# n8n refuses to start if ~/.n8n/config is world- or group-readable, and tries
# to chmod it to 0600 first. Only turn this off if a bind-mounted volume makes
# the permission unfixable; the file holds the encryption key.
# @type=boolean
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Directory that holds the `.n8n` folder (settings, encryption key, SQLite
# database, local binary data). The compose mounts its volume at
# /home/node/.n8n, matching the image's default home; change this and the
# volume stops covering the data.
N8N_USER_FOLDER=

# ─── Public URL & webhooks (set by the compose) ────────────────────────────

# Public base URL that production and test webhook URLs are built from, and
# what n8n shows you to paste into Stripe, GitHub, Slack. Wrong value means
# providers call an address that does not resolve and triggers never fire.
# Include the scheme and any subpath, e.g. https://n8n.example.com/. This is
# the deprecated spelling (see header); it is still read as a fallback.
# @required @type=url
# @docs("Webhook URL configuration", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/deployment)
WEBHOOK_URL=

# Successor to WEBHOOK_URL, same meaning, checked first. Set this one on a new
# install; leave it empty to keep using WEBHOOK_URL above.
# @type=url
N8N_WEBHOOK_URL=

# Public URL of the editor UI. Used for links in invitation and
# password-reset emails and for OAuth callback URLs, so an unset value sends
# users to http://localhost:5678. Usually the same origin as the webhook URL.
# @type=url
N8N_EDITOR_BASE_URL=

# Hostname n8n believes it is reachable at. Only used to construct URLs when
# the two above are empty; behind a proxy set the URLs instead.
N8N_HOST=localhost

# HTTP port inside the container. The compose exposes 5678 with no override,
# so changing this without changing the exposed port breaks routing.
# @type=port
N8N_PORT=5678

# Scheme used when n8n builds its own URLs. Set `https` only if n8n itself
# terminates TLS (N8N_SSL_* below); a TLS-terminating proxy in front keeps
# this at `http` and gets the public scheme from the URLs above.
# @type=enum(http, https)
N8N_PROTOCOL=http

# IP address the server binds to inside the container. `::` is dual-stack
# any-address, which is what a container network needs.
N8N_LISTEN_ADDRESS=::

# Path prefix n8n is served under, when it is not at the root of a domain
# (e.g. `/n8n/`). Must have a trailing slash.
N8N_PATH=/

# Number of reverse proxies in front of n8n. This is what makes
# X-Forwarded-For trustworthy for rate limiting and audit logs. `0` means n8n
# reads the direct socket peer, which behind a proxy is the proxy itself.
# @type=number
N8N_PROXY_HOPS=0

# TLS key and certificate paths INSIDE the container, for terminating HTTPS in
# n8n itself instead of at a proxy. Both are required together, and
# N8N_PROTOCOL must be `https`.
# @docs("Set up SSL", https://docs.n8n.io/deploy/host-n8n/configure-n8n/security/set-up-ssl)
N8N_SSL_KEY=
N8N_SSL_CERT=

# Transport the editor uses for live execution updates. `websocket` is the
# default in 2.x; switch to `sse` only if a proxy in front cannot carry
# WebSocket upgrades.
# @type=enum(websocket, sse)
N8N_PUSH_BACKEND=websocket

# Path segments the HTTP server mounts. Changing the webhook segment changes
# every webhook URL your providers already point at, so treat these as
# install-time decisions.
# @docs("Endpoint environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/endpoints)
N8N_ENDPOINT_REST=rest
N8N_ENDPOINT_WEBHOOK=webhook
N8N_ENDPOINT_WEBHOOK_TEST=webhook-test
N8N_ENDPOINT_WEBHOOK_WAIT=webhook-waiting
N8N_ENDPOINT_FORM=form

# Maximum request body in MiB for the API and webhooks. Raise it if webhook
# payloads or file uploads are being rejected as too large.
# @type=number
N8N_PAYLOAD_SIZE_MAX=16

# Maximum size in MiB of a single file in a multipart/form-data webhook.
# @type=number
N8N_FORMDATA_FILE_SIZE_MAX=200

# Serves the API and webhooks with no editor UI at all. Useful for a
# webhook-only instance; there is then no way to log in and edit workflows.
# @type=boolean
N8N_DISABLE_UI=false

# ─── Timezone & locale (set by the compose) ────────────────────────────────

# Default timezone for Cron/Schedule triggers and for date expressions that do
# not carry one. This is what the compose passes to the container, derived
# from the stack's TZ; n8n's own default would be America/New_York, which
# silently shifts every schedule. Individual workflows can override it in
# their settings.
# @docs("Timezone and localization", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/timezone-and-localization)
GENERIC_TIMEZONE=${TZ:-UTC}

# The stack-level timezone the compose reads for GENERIC_TIMEZONE. An IANA
# name, e.g. Europe/Berlin; empty means UTC.
TZ=UTC

# UI language. Non-English locales need the matching translation to be present
# in the image.
N8N_DEFAULT_LOCALE=en

# ─── Database ─────────────────────────────────────────────────────────────
# This template runs n8n on its bundled SQLite inside the data volume, which
# is fine for one instance. Point these at Postgres before you add a second
# instance or queue mode, since SQLite cannot be shared.

# `sqlite` (default, file in the data volume) or `postgresdb`. Switching this
# does NOT migrate existing workflows; export them first.
# @type=enum(sqlite, postgresdb)
# @docs("Choose n8n's database", https://docs.n8n.io/deploy/host-n8n/configure-n8n/choose-n8ns-database)
DB_TYPE=sqlite

# Prefix applied to every table name, for sharing one database with other
# applications. Changing it after first boot hides all existing data.
DB_TABLE_PREFIX=

DB_POSTGRESDB_HOST=localhost
# @type=port
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=postgres
# @sensitive
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=public
# Connections per instance. n8n's default of 2 is deliberately small; raise it
# for busy instances, and remember every worker opens its own pool.
# @type=number
DB_POSTGRESDB_POOL_SIZE=2
# Milliseconds to wait for a connection before failing.
# @type=number
DB_POSTGRESDB_CONNECTION_TIMEOUT=20000

# TLS to Postgres. `DB_POSTGRESDB_SSL_ENABLED=true` with
# REJECT_UNAUTHORIZED=false accepts any certificate. That is only for a
# private network you already trust; prefer supplying the CA.
# @type=boolean
DB_POSTGRESDB_SSL_ENABLED=false
# PEM contents of the CA that signed the server certificate.
DB_POSTGRESDB_SSL_CA=
# @type=boolean
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true

# SQLite file name, relative to the .n8n folder in the data volume.
DB_SQLITE_DATABASE=database.sqlite
# @type=number
DB_SQLITE_POOL_SIZE=3
# Runs VACUUM at boot: reclaims space after heavy execution pruning, at the
# cost of a slow, blocking startup on a large database.
# @type=boolean
DB_SQLITE_VACUUM_ON_STARTUP=false

# Logs every SQL statement. Debugging only: it is loud and prints query
# parameters.
# @type=boolean
DB_LOGGING_ENABLED=false

# ─── Auth, sessions & user management ─────────────────────────────────────

# Sets the `Secure` flag on the auth cookie, so browsers only send it over
# HTTPS. Default is on and should stay on for any instance reachable from the
# internet; turning it off is only for a plain-HTTP LAN install, and means the
# session cookie travels in clear text on every request.
# @type=boolean
# @docs("Configure user management", https://docs.n8n.io/deploy/host-n8n/configure-n8n/user-management)
N8N_SECURE_COOKIE=true

# `SameSite` attribute on that cookie. `none` (needed only if you embed the
# editor cross-origin) removes CSRF protection from the browser side and
# requires Secure.
# @type=enum(strict, lax, none)
N8N_SAMESITE_COOKIE=lax

# Secret used to sign session JWTs. Empty means n8n generates one and stores
# it in the settings file, which is fine for a single instance, but every
# instance behind the same load balancer must share the SAME value or sessions
# break on every hop. Changing it logs everyone out.
# @sensitive
N8N_USER_MANAGEMENT_JWT_SECRET=

# Session lifetime in hours (default 168 = 7 days).
# @type=number
N8N_USER_MANAGEMENT_JWT_DURATION_HOURS=168

# Hours before expiry at which a session silently refreshes. `0` means 25% of
# the duration above; `-1` disables refresh, forcing a real re-login.
# @type=number
N8N_USER_MANAGEMENT_JWT_REFRESH_TIMEOUT_HOURS=0

# TOTP two-factor authentication for accounts. On by default in 2.x; leave it
# on for any internet-facing instance, since an n8n login can read every
# stored credential.
# @type=boolean
N8N_MFA_ENABLED=true

# Keeps invite links out of API responses, so an admin account compromise
# cannot harvest pending invite URLs. Requires working SMTP below, otherwise
# invites cannot be delivered at all.
# @type=boolean
N8N_INVITE_LINKS_EMAIL_ONLY=false

# Binds an OAuth credential callback to the browser that started the flow, via
# a session cookie. Defeats the phishing trick where an attacker gets a victim
# to complete an OAuth flow that lands tokens on the attacker's credential.
# Off by default at this version; turn it on.
# @type=boolean
N8N_OAUTH_BROWSER_BINDING=false

# The public REST API (/api/v1, API-key authenticated) is ENABLED by default.
# Disable it unless you use it: an API key is a full-instance credential.
# @type=boolean
N8N_PUBLIC_API_DISABLED=false
N8N_PUBLIC_API_ENDPOINT=api
# Hides the Swagger UI while keeping the API itself.
# @type=boolean
N8N_PUBLIC_API_SWAGGERUI_DISABLED=false

# ─── SMTP (invites, password resets) ──────────────────────────────────────
# Without these, n8n cannot email anyone: invitations must be copied by hand
# and a forgotten password can only be reset from the CLI.

# `smtp` enables mail; the empty string disables it (those are the only two
# accepted values). The mode alone does nothing without a host.
# @docs("Deployment environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/deployment)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=
# @type=port
N8N_SMTP_PORT=465
N8N_SMTP_USER=
# @sensitive
N8N_SMTP_PASS=
# From-address on every message n8n sends. Many providers reject mail whose
# sender is not a verified domain.
N8N_SMTP_SENDER=
# Implicit TLS (port 465). Set false with STARTTLS true for port 587.
# @type=boolean
N8N_SMTP_SSL=true
# @type=boolean
N8N_SMTP_STARTTLS=true

# ─── Executions & retention ───────────────────────────────────────────────

# `regular` runs workflows in the main process. `queue` moves them to separate
# worker containers via Redis. This compose runs one container, so queue mode
# needs the extra services first.
# @type=enum(regular, queue)
# @docs("Execution environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/executions)
EXECUTIONS_MODE=regular

# Seconds after which a running workflow is cancelled. `-1` disables the
# timeout, which is the default and lets one stuck HTTP call hold a slot
# forever.
# @type=number
EXECUTIONS_TIMEOUT=-1
# Upper bound a workflow's own timeout setting cannot exceed (seconds).
# @type=number
EXECUTIONS_TIMEOUT_MAX=3600

# Whether old executions are deleted at all. Turning pruning off on the
# bundled SQLite grows the volume until the disk fills.
# @type=boolean
EXECUTIONS_DATA_PRUNE=true
# Maximum age of a saved execution, in hours (336 = 14 days).
# @type=number
EXECUTIONS_DATA_MAX_AGE=336
# Hard cap on saved executions; `0` disables the count-based prune.
# @type=number
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# What gets persisted. Execution data contains the actual payloads that moved
# through the workflow (including anything a credential fetched), so `none`
# is both a storage and a data-exposure control.
# @type=enum(all, none)
EXECUTIONS_DATA_SAVE_ON_ERROR=all
# @type=enum(all, none)
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
# @type=boolean
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
# Writes progress after every node. Costly on a busy instance.
# @type=boolean
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
# Bytes of execution data the editor will render before truncating (100 MiB).
# @type=number
EXECUTIONS_DATA_MAX_DISPLAY_SIZE=104857600

# Concurrent production executions per instance; `-1` is unlimited, which lets
# a burst of webhooks exhaust memory.
# @type=number
N8N_CONCURRENCY_PRODUCTION_LIMIT=-1

# Seconds n8n waits for running executions to finish before exiting on
# SIGTERM. Raise it if long workflows are being killed on redeploy.
# @type=number
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=30

# ─── Queue mode (Redis / BullMQ) ──────────────────────────────────────────
# Only read when EXECUTIONS_MODE=queue. This template ships no Redis, so
# these describe the external one you would point it at.

# Hostname of the Redis that carries the job queue. Every main and worker must
# agree on host, port, db and prefix, or jobs silently go nowhere.
# @docs("Queue mode environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/queue-mode)
QUEUE_BULL_REDIS_HOST=localhost
# @type=port
QUEUE_BULL_REDIS_PORT=6379
# @type=number
QUEUE_BULL_REDIS_DB=0
QUEUE_BULL_REDIS_USERNAME=
# @sensitive
QUEUE_BULL_REDIS_PASSWORD=
# @type=boolean
QUEUE_BULL_REDIS_TLS=false
# Set false to accept a self-signed Redis certificate, and do that only inside
# a private network.
# @type=boolean
QUEUE_BULL_REDIS_TLS_VALIDATE_CERTIFICATE=true
# Key namespace in Redis. Change it to run two n8n clusters on one Redis.
QUEUE_BULL_PREFIX=
# Exposes /healthz on a worker so an orchestrator can restart it.
# @type=boolean
QUEUE_HEALTH_CHECK_ACTIVE=false
# @type=port
QUEUE_HEALTH_CHECK_PORT=5678

# Sends manual (editor) executions to workers instead of running them in the
# main process. n8n warns at boot in queue mode when this is not `true`,
# because it becomes the default in a future version.
# @type=boolean
# @docs("Queue mode", https://docs.n8n.io/deploy/host-n8n/configure-n8n/scaling/enable-queue-mode)
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=false

# ─── Code execution: task runners & expressions ───────────────────────────
# This is where arbitrary JavaScript from a Code node or an expression runs.
# The 2026-09-02 advisories this pin exists for were escapes from exactly
# this sandbox, so treat every knob below as a security control.

# `internal` (default) launches the runner as a child process of n8n;
# `external` expects a separately-launched runner container to connect to the
# broker. Anyone who can edit a workflow can run code inside the runner, so
# whatever the runner can reach on the network, they can reach.
# @type=enum(internal, external)
# @docs("Task runners", https://docs.n8n.io/deploy/host-n8n/configure-n8n/set-up-task-runners)
N8N_RUNNERS_MODE=internal

# Shared secret an external runner presents to the broker. REQUIRED in
# external mode, because the broker port is an unauthenticated code-execution
# endpoint without it. Unused in internal mode.
# @sensitive
N8N_RUNNERS_AUTH_TOKEN=

# Address and port the task broker listens on. The default 127.0.0.1 keeps it
# inside the container; binding it to 0.0.0.0 to reach an external runner
# exposes the broker, so pair that with the auth token and a private network.
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=127.0.0.1
# @type=port
N8N_RUNNERS_BROKER_PORT=5679

# Seconds a single task may run before it is aborted (and, in internal mode,
# the runner restarted). n8n warns that this default drops to 60 in v3.
# @type=number
N8N_RUNNERS_TASK_TIMEOUT=300
# Concurrent tasks one runner accepts.
# @type=number
N8N_RUNNERS_MAX_CONCURRENCY=10

# DISABLES EVERY SANDBOX MEASURE IN THE TASK RUNNER. Upstream calls it
# "discouraged for production"; with it on, a workflow's Code node is
# effectively a shell on the runner process. Only for debugging a module that
# needs insecure JS features, never on an instance other people can edit.
# @type=boolean
N8N_RUNNERS_INSECURE_MODE=false

# Node.js built-in modules a Code node may require, comma separated; `*`
# allows all, which includes `child_process` and `fs`, i.e. arbitrary command
# execution and full filesystem access from any workflow. Empty (default)
# allows none. Same shape for npm packages present in the image.
# @docs("Nodes environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/nodes)
NODE_FUNCTION_ALLOW_BUILTIN=
NODE_FUNCTION_ALLOW_EXTERNAL=

# Expression evaluator. `vm` is the isolated default; `legacy` runs
# expressions with no isolation, is explicitly "no longer considered secure"
# in the deprecation list at this version, and will be removed. Do not set it.
# @type=enum(vm, legacy)
N8N_EXPRESSION_ENGINE=vm

# Allows the Python variant of the Code node (Pyodide). Same trust model as
# the JavaScript one: whoever can edit a workflow can run code.
# @type=boolean
N8N_PYTHON_ENABLED=true

# Node types to refuse to load, as a JSON array. n8n's default already blocks
# the two that shell out or watch the filesystem
# (["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger"]).
# Setting this REPLACES that list, so re-list them or you have re-enabled
# running arbitrary commands on the container.
NODES_EXCLUDE=
# Inverse allow-list: when non-empty, ONLY these node types load.
NODES_INCLUDE=

# ─── Security hardening ───────────────────────────────────────────────────

# Directories a workflow's filesystem nodes may read, colon separated. The
# default confines them to ~/.n8n-files; widening it to `/` lets any workflow
# read anything the container can, including the encryption key.
# @docs("Security environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/security)
N8N_RESTRICT_FILE_ACCESS_TO=~/.n8n-files

# Keeps workflows out of the .n8n folder itself (settings file, encryption
# key, SQLite database). Leave this on.
# @type=boolean
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true

# Regex of paths the Git node refuses to touch. The default below blocks
# `.git` directories anywhere in the tree; a permissive value here reopens the
# Git-node sandbox escapes fixed in 2.37.7.
N8N_BLOCK_FILE_PATTERNS=^(?:[^/]*/)*\.git(?:/.*)?$

# Bare-repository handling and hook execution for the Git node. Enabling hooks
# means a cloned repository can execute code on your instance; enabling all
# config keys reopens the `branch.<name>.remote` path-restriction bypass.
# @type=boolean
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
# @type=boolean
N8N_GIT_NODE_ENABLE_HOOKS=false
# @type=boolean
N8N_GIT_NODE_ENABLE_ALL_CONFIG_KEYS=false

# Webhook and form responses that return HTML are rendered in a sandboxed
# iframe. Disabling either lets a workflow author serve scripts on your
# instance's origin, which is session theft for anyone who visits.
# @type=boolean
N8N_INSECURE_DISABLE_WEBHOOK_IFRAME_SANDBOX=false
# @type=boolean
N8N_INSECURE_DISABLE_FORM_HTML_SANDBOX=false

# Extra Content-Security-Policy directives as a JSON object, merged into the
# response headers. `{}` (default) adds none.
N8N_CONTENT_SECURITY_POLICY={}
# Sends the policy as report-only, for testing it without breaking the UI.
# @type=boolean
N8N_CONTENT_SECURITY_POLICY_REPORT_ONLY=false

# Origins allowed to postMessage into the editor iframe, comma separated.
# Empty means none. Only widen it for an embed you control.
N8N_POSTMESSAGE_ALLOWED_ORIGINS=

# Lets AWS nodes fall back to the container's ambient credentials (instance
# role, ~/.aws, environment). Off by default: with it on, any workflow author
# inherits the deployment's own AWS identity without holding a credential.
# @type=boolean
N8N_AWS_SYSTEM_CREDENTIALS_ACCESS_ENABLED=false

# Blocks outbound requests from HTTP Request/webhook nodes to private and
# link-local ranges, i.e. server-side request forgery at your other
# containers, the Docker host and cloud metadata endpoints. OFF by default at
# this version. Turn it on unless a workflow must reach a sibling service,
# and then list that host explicitly rather than disabling the whole check.
# @type=boolean
N8N_SSRF_PROTECTION_ENABLED=false
# Hostnames exempted from the check, comma separated.
N8N_SSRF_ALLOWED_HOSTNAMES=
# CIDR ranges exempted from the check, comma separated.
N8N_SSRF_ALLOWED_IP_RANGES=

# Who may call a sub-workflow. The default limits it to workflows owned by the
# same user; `any` lets any workflow on the instance invoke any other, which
# in a multi-tenant instance crosses project boundaries.
# @type=enum(none, workflowsFromAList, workflowsFromSameOwner, any)
# @docs("Workflow environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/workflows)
N8N_WORKFLOW_CALLER_POLICY_DEFAULT_OPTION=workflowsFromSameOwner

# ─── Community packages ───────────────────────────────────────────────────

# Installing a community node runs third-party npm code inside n8n with full
# access to the instance. Enabled by default, and unverified (not reviewed by
# n8n) packages are allowed too; n8n warns that this default flips to false
# in a future version. Turn both off on any instance with untrusted editors.
# @type=boolean
# @docs("Community node risks", https://docs.n8n.io/integrations/community-nodes/risks)
N8N_COMMUNITY_PACKAGES_ENABLED=true
# @type=boolean
N8N_UNVERIFIED_PACKAGES_ENABLED=true
# @type=url
N8N_COMMUNITY_PACKAGES_REGISTRY=https://registry.npmjs.org
# Token for a private npm registry.
# @sensitive
N8N_COMMUNITY_PACKAGES_AUTH_TOKEN=
# Keeps already-installed community packages from being LOADED at boot, while
# leaving them installed, the fast way to neutralise one that misbehaves.
# @type=boolean
N8N_COMMUNITY_PACKAGES_PREVENT_LOADING=false

# ─── Credential overwrites ────────────────────────────────────────────────

# Pre-fills credential fields (typically OAuth client id/secret) for every
# user of the instance, as a JSON object keyed by credential type. The values
# are real secrets and are never shown in the UI.
# @sensitive
# @docs("Credential environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/credentials)
CREDENTIALS_OVERWRITE_DATA={}
# Endpoint n8n POSTs to, once, to receive that same JSON at runtime instead of
# holding it in the environment.
CREDENTIALS_OVERWRITE_ENDPOINT=
# Bearer token required on that endpoint. Without it anyone who can reach the
# instance can push credential overwrites into it.
# @sensitive
CREDENTIALS_OVERWRITE_ENDPOINT_AUTH_TOKEN=

# ─── Binary data & storage ────────────────────────────────────────────────

# Where files that pass through workflows are kept. `default` holds them in
# memory, which is deprecated at this version and the reason big attachments
# OOM the container. `filesystem` puts them in the data volume, `s3`/`azure`
# offload them, `database` inlines them (capped below). There is no single
# upstream default: the code picks `filesystem` in regular mode and `database`
# in queue mode, so this is declared as what this single-container template
# runs.
# @type=enum(default, filesystem, s3, azure, database)
# @docs("Binary data environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/binary-data)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Directory for filesystem mode. Empty falls back to N8N_STORAGE_PATH and then
# ~/.n8n/storage, inside the compose's volume. Note the default moved: it is
# no longer ~/.n8n/binaryData.
N8N_BINARY_DATA_STORAGE_PATH=
N8N_STORAGE_PATH=

# Where execution data itself is stored, independently of binary data.
# @type=enum(database, filesystem, s3, azure)
# @docs("External data storage", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/external-data-storage)
N8N_EXECUTION_DATA_STORAGE_MODE=database

# Signs the public URLs handed out for binary data. Empty derives it from the
# encryption key, which is the right default; set it only when several
# instances must validate each other's links.
# @sensitive
N8N_BINARY_DATA_SIGNING_SECRET=

# Largest single file, in MiB, that `database` mode will store (hard ceiling
# 1024, from the Postgres BYTEA limit).
# @type=number
N8N_BINARY_DATA_DATABASE_MAX_FILE_SIZE=512

# ─── Logging, metrics & telemetry ─────────────────────────────────────────

# Log verbosity. `debug` prints a great deal, including request details.
# @type=enum(error, warn, info, debug, silent)
# @docs("Logging environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/logs)
N8N_LOG_LEVEL=info

# `console` (what docker logs shows), `file`, or both comma separated.
N8N_LOG_OUTPUT=console
# `json` makes every line structured, for a log shipper.
# @type=enum(text, json)
N8N_LOG_FORMAT=text
# File-mode destination, relative to the .n8n folder, plus rotation limits
# (MiB per file, number of files).
N8N_LOG_FILE_LOCATION=logs/n8n.log
# @type=number
N8N_LOG_FILE_SIZE_MAX=16
# @type=number
N8N_LOG_FILE_COUNT_MAX=100
# Comma-separated subsystems to log in detail, e.g. `scaling,task-runner`.
# Requires N8N_LOG_LEVEL=debug to show anything.
N8N_LOG_SCOPES=

# Exposes Prometheus metrics on /metrics. The endpoint is unauthenticated, so
# keep it off the public internet.
# @type=boolean
# @docs("Endpoint environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/endpoints)
N8N_METRICS=false
N8N_METRICS_PREFIX=n8n_

# Anonymous usage telemetry to n8n's PostHog. On by default; set false to stop
# it entirely.
# @type=boolean
# @docs("Deployment environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/deployment)
N8N_DIAGNOSTICS_ENABLED=true

# Outbound calls to api.n8n.io for update checks, the template gallery, the
# personalisation survey and the hiring banner. All default to on; each is an
# egress you may not want.
# @type=boolean
N8N_VERSION_NOTIFICATIONS_ENABLED=true
# @type=boolean
N8N_TEMPLATES_ENABLED=true
# @type=boolean
N8N_PERSONALIZATION_ENABLED=true
# @type=boolean
N8N_HIRING_BANNER_ENABLED=true

# ─── Enterprise license ───────────────────────────────────────────────────

# Activation key for n8n's paid features (SSO, log streaming, external
# secrets, more). Empty runs the community edition, which is what this
# template assumes.
# @sensitive
# @docs("Deployment environment variables", https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/deployment)
N8N_LICENSE_ACTIVATION_KEY=
