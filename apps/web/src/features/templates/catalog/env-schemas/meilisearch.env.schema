# Meilisearch v1.53.1 environment schema (@env-spec / varlock format).
#
# The compose pins getmeili/meilisearch:v1.53.1, the newest stable release
# (published 2026-08-13; on the research date, 2026-09-04, docker.io's
# `latest` resolves to the same index digest
# sha256:8d6643d86d71fad6ad3cba92cde7ccfce9e4d6c384bda67598eb553571c32431,
# image built 2026-08-13, so the repo is still being rebuilt per release).
#
# Source: Meilisearch is a Rust binary configured through clap, so every CLI
# option has exactly one env twin declared as
# `#[clap(long, env = MEILI_*)]` in crates/meilisearch/src/option.rs at tag
# v1.53.1. That file is the authoritative key list and is where every key
# and default below comes from. The handful of knobs that exist ONLY as an
# env var (no CLI flag) were found by grepping `env::var("…")` across
# crates/ at the same tag: MEILI_SERVER_PROVIDER, MEILI_CONFIG_FILE_PATH,
# the two LMDB max-readers knobs, the embedder/remote-search timeouts, the
# OpenAI/Ollama embedder credentials and the dynamic-search-rules fuel
# limits. Test-only variables (MEILI_TEST_*, MILLI_TEST_*, MEILI_NO_VERGEN)
# are deliberately omitted.
#
# Two things the configuration reference page does not spell out:
#   * The const named MEILI_EXPERIMENTAL_LEGACY_SEARCH_DEFAULT in the source
#     holds the string "MEILI_EXPERIMENTAL_LEGACY_SEARCH"; the variable an
#     operator actually sets has no `_DEFAULT` suffix.
#   * The image (Dockerfile, alpine:3.22) bakes in
#     MEILI_HTTP_ADDR=0.0.0.0:7700 and MEILI_SERVER_PROVIDER=docker, and its
#     WORKDIR is /meili_data, which is why the default relative MEILI_DB_PATH
#     of ./data.ms lands inside the mounted volume.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Configuration reference", https://www.meilisearch.com/docs/resources/self_hosting/configuration/reference)
# ---

# ─── Security ─────────────────────────────────────────────────────────────

# The one secret this template needs. It protects every route except
# `GET /health`: with no master key set, ANY client that can reach port 7700
# can read every index AND create, modify and delete documents, indexes and
# settings. There is no separate "read-only by default" mode.
#
# With MEILI_ENV=production (the compose default) Meilisearch REFUSES TO
# BOOT unless this is set, and also refuses if it is shorter than 16 bytes
# (MASTER_KEY_MIN_SIZE); both cases are a hard `anyhow::bail!` in
# crates/meilisearch/src/main.rs, not a warning. In development mode it only
# prints a warning and starts wide open.
#
# The master key is not just a password: every API key is derived from it as
# HMAC-SHA256(master_key, key-uuid) (crates/meilisearch-auth/src/store.rs).
# Rotating this value therefore silently changes the value of every existing
# API key: the key records survive, but every previously distributed key
# string stops authenticating and must be re-fetched from `GET /keys`.
# @required @sensitive
# @type=string(minLength=16)
# @docs("Master key and API keys", https://www.meilisearch.com/docs/resources/self_hosting/security/master_api_keys)
MEILI_MASTER_KEY=

# `production` or `development`, and it is a security switch, not a logging
# switch. `development` (a) drops the master-key requirement above, so the
# instance boots unauthenticated, and (b) mounts the bundled mini-dashboard
# search-preview UI at `/` (`let enable_dashboard = &opt.env == "development"`
# in main.rs), an unauthenticated browser UI over your data. The compose
# defaults this to `production`; only override it on a throwaway instance.
# @type=enum(production, development)
# @docs("Self-hosted quick start", https://www.meilisearch.com/docs/resources/self_hosting/getting_started/quick_start)
MEILI_ENV=production

# Meilisearch phones home to Segment by default, sending instance and usage
# statistics on a timer. Set to `true` to turn telemetry off entirely.
# @type=boolean
# @docs("Telemetry", https://www.meilisearch.com/docs/resources/help/telemetry)
MEILI_NO_ANALYTICS=false

# Reported to telemetry as the `server_provider` field and used to pick the
# telemetry flush interval. The image bakes in `docker`; leave it alone.
MEILI_SERVER_PROVIDER=docker

# By default Meilisearch refuses to let embedders, webhooks and remote
# federated search dial private/loopback address ranges (SSRF guard). A
# comma-separated CIDR list re-allows specific ranges; the literal value
# `any` disables the guard completely, which is how you would reach a sibling
# container such as an Ollama service on the same network.
# @docs("Configuration reference", https://www.meilisearch.com/docs/resources/self_hosting/configuration/reference)
MEILI_EXPERIMENTAL_ALLOWED_IP_NETWORKS=

# ─── Server ───────────────────────────────────────────────────────────────

# Address:port the HTTP server binds. The option's own default is
# `localhost:7700`, which would be unreachable from outside the container.
# The image overrides it to 0.0.0.0:7700 and the compose exposes container
# port 7700, so change the port here only if you change the exposed port too.
MEILI_HTTP_ADDR=0.0.0.0:7700

# Where the LMDB database lives. Relative paths resolve against the image's
# WORKDIR, /meili_data, which is the compose's mounted volume. An absolute
# path outside /meili_data puts your indexes on the container filesystem and
# loses them on redeploy.
MEILI_DB_PATH=./data.ms

# Maximum accepted request body. Accepts bytes or a unit ("100 MB",
# "1 GiB"). Raise it if you push large document batches in one request.
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=100 MB

# Optional path to a TOML config file, read before env vars are applied.
# The compose mounts no config file, so leave empty and configure here.
# @docs("Configuration overview", https://www.meilisearch.com/docs/resources/self_hosting/configuration/overview)
MEILI_CONFIG_FILE_PATH=

# ─── TLS (in-process) ─────────────────────────────────────────────────────

# Meilisearch can terminate TLS itself instead of sitting behind a proxy.
# Cert and key are required together and the paths must exist INSIDE the
# container. Behind otterdeploy's own ingress you normally want none of this.
# @docs("Configuration reference", https://www.meilisearch.com/docs/resources/self_hosting/configuration/reference)
MEILI_SSL_CERT_PATH=
MEILI_SSL_KEY_PATH=
# Enables mutual TLS: path to a file of client CA certificates to trust.
MEILI_SSL_AUTH_PATH=
# DER-encoded OCSP response to staple to the served certificate.
MEILI_SSL_OCSP_PATH=
# Makes client-certificate authentication mandatory rather than optional;
# only meaningful together with MEILI_SSL_AUTH_PATH.
# @type=boolean
MEILI_SSL_REQUIRE_AUTH=false
# @type=boolean
MEILI_SSL_RESUMPTION=false
# @type=boolean
MEILI_SSL_TICKETS=false

# ─── Task webhook ─────────────────────────────────────────────────────────

# Legacy single-webhook configuration: this URL receives an ndjson POST every
# time a task finishes. v1.53 also has a managed `/webhooks` API that does the
# same thing without a restart; this variable stays as the static fallback.
# @type=url
# @docs("Webhooks API", https://www.meilisearch.com/docs/reference/api/webhooks/list-webhooks)
MEILI_TASK_WEBHOOK_URL=

# Verbatim value of the `Authorization` header sent with that webhook, e.g.
# "Bearer <token>". Only read when MEILI_TASK_WEBHOOK_URL is set.
# @sensitive
MEILI_TASK_WEBHOOK_AUTHORIZATION_HEADER=

# ─── Snapshots & dumps ────────────────────────────────────────────────────

# Snapshots are a binary copy of the database; dumps are a portable export.
# Both directories are relative to /meili_data, so both land in the compose
# volume by default. Snapshots are DISABLED unless MEILI_SCHEDULE_SNAPSHOT is
# given a value.
# @docs("Snapshots", https://www.meilisearch.com/docs/resources/self_hosting/data_backup/snapshots)
MEILI_SNAPSHOT_DIR=snapshots/

# Interval between automatic snapshots, in seconds. Empty means no scheduled
# snapshots at all; the flag's "present but valueless" default is 86400 (24h).
# @type=number
MEILI_SCHEDULE_SNAPSHOT=

# One-shot restore: path to a .snapshot file to load at launch. Meilisearch
# aborts if the file is missing, or if a database already exists, unless the
# two IGNORE flags below are set.
MEILI_IMPORT_SNAPSHOT=
# @type=boolean
MEILI_IGNORE_MISSING_SNAPSHOT=false
# @type=boolean
MEILI_IGNORE_SNAPSHOT_IF_DB_EXISTS=false

# Where `POST /dumps` writes .dump files.
# @docs("Dumps", https://www.meilisearch.com/docs/resources/self_hosting/data_backup/dumps)
MEILI_DUMP_DIR=dumps/

# One-shot import of a .dump at launch; mutually exclusive with
# MEILI_IMPORT_SNAPSHOT. Same abort rules, same two escape hatches.
MEILI_IMPORT_DUMP=
# @type=boolean
MEILI_IGNORE_MISSING_DUMP=false
# @type=boolean
MEILI_IGNORE_DUMP_IF_DB_EXISTS=false

# Migrates an on-disk database written by an older Meilisearch in place, so a
# version bump does not need a dump/restore cycle. Set it for one boot after
# raising the pinned tag, then unset it.
# @type=boolean
# @docs("Database upgrade discussion", https://github.com/orgs/meilisearch/discussions/804)
MEILI_UPGRADE_DB=false

# ─── S3 snapshot upload ───────────────────────────────────────────────────

# Ships snapshots straight to object storage instead of the local volume.
# The five non-credential fields plus one auth method are all-or-nothing:
# supply the whole group or none of it. Authenticate EITHER with
# access key + secret key OR with role ARN + web identity token file; the
# two are mutually exclusive.
# @type=url
# @docs("S3 snapshots discussion", https://github.com/orgs/meilisearch/discussions/869)
MEILI_S3_BUCKET_URL=
MEILI_S3_BUCKET_REGION=
MEILI_S3_BUCKET_NAME=
# Key prefix inside the bucket, written with normal forward slashes.
MEILI_S3_SNAPSHOT_PREFIX=
# @sensitive
MEILI_S3_ACCESS_KEY=
# @sensitive
MEILI_S3_SECRET_KEY=
# Web-identity federation instead of static keys.
MEILI_EXPERIMENTAL_S3_ROLE_ARN=
MEILI_EXPERIMENTAL_S3_WEB_IDENTITY_TOKEN_FILE=
# Lifetime requested for the federated session, in seconds.
# @type=number
MEILI_EXPERIMENTAL_S3_WEB_IDENTITY_TOKEN_DURATION_SECONDS=3600
# Multipart parts uploaded concurrently.
# @type=number
MEILI_EXPERIMENTAL_S3_MAX_IN_FLIGHT_PARTS=10
# zstd level; 0 means upload uncompressed.
# @type=number
MEILI_EXPERIMENTAL_S3_COMPRESSION_LEVEL=0
# Validity of each presigned part URL, in seconds (default 8 hours).
# @type=number
MEILI_EXPERIMENTAL_S3_SIGNATURE_DURATION_SECONDS=28800
# Size of each multipart part in bytes; must be between 10 MiB and 8 GiB.
# The default is 375 MiB.
# @type=number
MEILI_EXPERIMENTAL_S3_MULTIPART_PART_SIZE=393216000

# ─── Indexing resources ───────────────────────────────────────────────────

# Ceiling on RAM used while indexing. Empty lets Meilisearch take up to two
# thirds of the machine's memory, which on a shared host is usually more than
# you want; a unit string ("2 GiB") is accepted.
MEILI_MAX_INDEXING_MEMORY=

# Ceiling on indexing threads. Empty means half the available cores, which is
# what keeps search responsive during a large import.
# @type=number
MEILI_MAX_INDEXING_THREADS=

# Trades indexing speed for a smaller RAM footprint. Upstream marks it
# "do not use in production" and it is rejected outright on Windows.
# @type=boolean
MEILI_EXPERIMENTAL_REDUCE_INDEXING_MEMORY_USAGE=false

# Caps how many tasks are auto-batched together. The built-in default is
# effectively unlimited (usize::MAX); lower it to make progress reporting
# finer-grained at the cost of throughput.
# @type=number
# @docs("Batched tasks discussion", https://github.com/orgs/meilisearch/discussions/713)
MEILI_EXPERIMENTAL_MAX_NUMBER_OF_BATCHED_TASKS=

# Total byte size of one batch. Empty means half of the indexing memory
# budget, clamped to 10 GiB.
MEILI_EXPERIMENTAL_LIMIT_BATCHED_TASKS_TOTAL_SIZE=

# Maximum simultaneous LMDB read transactions, for the task queue and for
# each index respectively. Both default to 1024; raise only if you see
# "reached the maximum number of readers" under heavy concurrency. The task
# queue one is new in v1.53.1 and has no CLI flag (env var only).
# @type=number
# @docs("LMDB max readers discussion", https://github.com/orgs/meilisearch/discussions/806)
MEILI_EXPERIMENTAL_TASK_QUEUE_MAX_READERS=1024
# @type=number
MEILI_EXPERIMENTAL_INDEX_MAX_READERS=1024

# ─── Search tuning ────────────────────────────────────────────────────────

# How many search requests may wait in line. Once the queue is full
# Meilisearch answers 503 Service Unavailable rather than queueing forever.
# @type=number
# @docs("Search queue discussion", https://github.com/orgs/meilisearch/discussions/729)
MEILI_EXPERIMENTAL_SEARCH_QUEUE_SIZE=1000

# Seconds after which a queued search is considered stale and dropped.
# @type=number
MEILI_EXPERIMENTAL_DROP_SEARCH_AFTER=60

# Concurrent searches allowed per CPU core.
# @type=number
MEILI_EXPERIMENTAL_NB_SEARCHES_PER_CORE=4

# Timeout for the remote leg of a federated multi-search across a network of
# instances, in seconds.
# @type=number
MEILI_EXPERIMENTAL_REMOTE_SEARCH_TIMEOUT_SECONDS=25

# Restores the pre-v1.5x search pipeline as the default for every index.
# A compatibility escape hatch for a ranking regression, not a tuning knob.
# The source constant is named …_LEGACY_SEARCH_DEFAULT but the variable it
# holds is MEILI_EXPERIMENTAL_LEGACY_SEARCH, spelled exactly as here.
# @type=boolean
MEILI_EXPERIMENTAL_LEGACY_SEARCH=false

# ─── Dynamic search rules fuel ────────────────────────────────────────────

# Evaluation budgets that stop a pathological dynamic-search-rule set from
# burning CPU on every query. None of these have CLI flags; all are read
# straight from the environment in crates/meilisearch/src/lib.rs and a
# non-numeric value aborts startup. Leave them alone unless a rule set is
# hitting a limit.
# @type=number
# @docs("Configuration reference", https://www.meilisearch.com/docs/resources/self_hosting/configuration/reference)
MEILI_EXPERIMENTAL_DSR_FUEL_MAX_COUNTED_WORDS=10
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_MAX_ACTIVE_RULES=1000
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_MAX_PIN_ACTIONS=100
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_WORD_FUEL=4096
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_FILTER_FUEL=4096
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_FILTER_OR_FUEL=100
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_FILTER_AND_FUEL=100
# @type=number
MEILI_EXPERIMENTAL_DSR_FUEL_FILTER_DEPTH_FUEL=25

# ─── AI / embedders ───────────────────────────────────────────────────────

# Fallback API key for an `openAi` embedder that does not carry its own
# `apiKey` in the index settings. MEILI_OPENAI_API_KEY is checked first,
# plain OPENAI_API_KEY second.
# @sensitive
# @docs("Configure an OpenAI embedder", https://www.meilisearch.com/docs/capabilities/hybrid_search/how_to/configure_openai_embedder)
MEILI_OPENAI_API_KEY=
# @sensitive
OPENAI_API_KEY=

# Full URL of the Ollama EMBEDDINGS endpoint, not just the host. The default
# is http://localhost:11434/api/embeddings, which points at the Meilisearch
# container itself. Point it at your Ollama service and expect to widen
# MEILI_EXPERIMENTAL_ALLOWED_IP_NETWORKS if that address is private.
# @type=url
# @docs("Hybrid search getting started", https://www.meilisearch.com/docs/capabilities/hybrid_search/getting_started)
MEILI_OLLAMA_URL=

# Per-request timeout and total retry window, in seconds, for any REST-based
# embedder (including OpenAI and Ollama).
# @type=number
MEILI_EXPERIMENTAL_REST_EMBEDDER_TIMEOUT_SECONDS=30
# @type=number
MEILI_EXPERIMENTAL_REST_EMBEDDER_MAX_RETRY_DURATION_SECONDS=60

# Fault-injection switch used to keep indexing going when an embedder
# misbehaves; accepts a comma-separated list of failure modes. Debugging
# only.
MEILI_EXPERIMENTAL_CONFIG_EMBEDDER_FAILURE_MODES=

# Server-side key for the hosted personalization service. Without it the
# personalization feature is simply off.
# @sensitive
MEILI_EXPERIMENTAL_PERSONALIZATION_API_KEY=

# ─── Logging & observability ──────────────────────────────────────────────

# Console verbosity. Case-insensitive on input; INFO is the default.
# @type=enum(OFF, ERROR, WARN, INFO, DEBUG, TRACE)
# @docs("Configuration reference", https://www.meilisearch.com/docs/resources/self_hosting/configuration/reference)
MEILI_LOG_LEVEL=INFO

# HUMAN prints readable lines, JSON emits one structured object per line for
# a log shipper.
# @type=enum(HUMAN, JSON)
MEILI_EXPERIMENTAL_LOGS_MODE=HUMAN

# Enables `POST /logs/stream`, `POST /logs/stderr` and `DELETE /logs/stream`,
# which let an authenticated caller change log level and tail logs at
# runtime. Master-key protected like any other route.
# @type=boolean
# @docs("Logs API", https://www.meilisearch.com/docs/reference/api/logs/retrieve-logs)
MEILI_EXPERIMENTAL_ENABLE_LOGS_ROUTE=false

# Exposes Prometheus metrics on `GET /metrics`. The route needs the
# `metrics.get` permission, so scrape it with a scoped API key rather than
# the master key.
# @type=boolean
# @docs("Prometheus metrics endpoint", https://www.meilisearch.com/docs/reference/api/stats/get-prometheus-metrics)
MEILI_EXPERIMENTAL_ENABLE_METRICS=false

# Enables the server-sent-event task feeds `GET /tasks/stream` and
# `GET /batches/stream`, so a client can watch task progress without polling.
# @type=boolean
# @docs("Task streaming discussion", https://github.com/orgs/meilisearch/discussions/889)
MEILI_EXPERIMENTAL_ENABLE_TASKS_STREAMING_ROUTE=false

# ─── Other experimental toggles ───────────────────────────────────────────

# Enables the `CONTAINS` filter operator, which cannot use the index and so
# costs a scan on large datasets.
# @type=boolean
# @docs("Experimental features overview", https://www.meilisearch.com/docs/resources/help/experimental_features_overview)
MEILI_EXPERIMENTAL_CONTAINS_FILTER=false

# Reverts settings indexing to the pre-edition-2024 code path. A rollback
# switch for a settings-update regression.
# @type=boolean
MEILI_EXPERIMENTAL_NO_EDITION_2024_FOR_SETTINGS=false

# Skips the one-time cleanup of field-id-based databases performed by the
# v1.32 upgrade step. Anything other than "false" or "0" counts as on.
# @type=boolean
MEILI_EXPERIMENTAL_DISABLE_FID_BASED_DATABASES_CLEANUP=false
