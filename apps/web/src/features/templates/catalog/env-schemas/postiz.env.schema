# Postiz v2.23.0 environment schema (@env-spec / varlock format).
#
# Built from what the code READS, not from upstream's .env.example: that file
# omits TELEGRAM_TOKEN, TWITCH_*, KICK_*, INSTAGRAM_APP_*, NEYNAR_*, VK_ID,
# WHOP_CLIENT_ID, GOOGLE_GMB_* and MEWE_*, all of which providers reference.
# Regenerate by grepping process.env across
# libraries/nestjs-libraries/src/integrations/social/*.provider.ts.
#
# Every credential below is OPTIONAL. Postiz boots without them: it renders
# the channel button anyway and only fails when you click Connect, which is
# why an unconfigured install looks healthy and isn't.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Postiz configuration reference", https://docs.postiz.com/configuration/reference)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Password for the bundled Postgres, generated at install. Also carries the
# two databases Temporal creates for itself.
# @required @sensitive
POSTGRES_PASSWORD=

# PLATFORM-OWNED: derived from the sibling db service, never written out.
# @required @sensitive
DATABASE_URL=postgresql://postiz:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/postiz

# PLATFORM-OWNED.
# @required
REDIS_URL=redis://${{stack.redis.HOST}}:6379

# Signs session tokens. Rotating it signs every user out.
# @required @sensitive @type=string(minLength=32)
JWT_SECRET=

# The public URL you open Postiz at. OAuth callbacks and uploaded-media URLs
# are built from it, so it must match the address you actually browse to.
# PLATFORM-OWNED, and the reason this schema exists. Written as a literal it
# freezes at install: rename the domain and the route moves while the app goes
# on advertising the host it was born with, which surfaces as CORS errors in
# the browser rather than as anything pointing at a stale string. As a ref it
# re-resolves every deploy, and a domain change fans a redeploy out to
# everything that reads it.
# @required @type=url
MAIN_URL=${{stack.postiz.PUBLIC_URL}}

# PLATFORM-OWNED.
# @required @type=url
FRONTEND_URL=${{stack.postiz.PUBLIC_URL}}

# Public URL of the API. One origin serves both, so this is MAIN_URL + /api.
# PLATFORM-OWNED. One origin serves both, so this is MAIN_URL + /api.
# @required @type=url
NEXT_PUBLIC_BACKEND_URL=${{stack.postiz.PUBLIC_URL}}/api

# In-container address of the backend. Not public; leave as localhost:3000.
# @required @type=url
BACKEND_INTERNAL_URL=http://localhost:3000

# Temporal frontend. Every scheduled post goes through it. PLATFORM-OWNED.
# @required
TEMPORAL_ADDRESS=${{stack.temporal.HOST}}:7233

# @required @type=boolean
IS_GENERAL=true

# @type=boolean
DISABLE_REGISTRATION=false

# Registers the recurring "missing post" sweep at boot. Enable on exactly one
# instance, because two instances register it twice.
# @type=boolean
RUN_CRON=true

# Public API requests allowed per hour.
# @type=number
API_LIMIT=30

# ─── Bundled services ────────────────────────────────────────────────────
# Config for the stack's own Postgres, Redis and Temporal. Not Postiz's
# application settings, but env all the same: POSTGRES_SEEDS below is
# platform-owned for exactly the same reason MAIN_URL is.

POSTGRES_USER=postiz
POSTGRES_DB=postiz

# Temporal's storage driver. It shares the bundled Postgres, and auto-setup
# creates `temporal` and `temporal_visibility` beside Postiz's own schema.
DB=postgres12
# @type=port
DB_PORT=5432
# PLATFORM-OWNED.
POSTGRES_SEEDS=${{stack.db.HOST}}
# @sensitive
POSTGRES_PWD=${POSTGRES_PASSWORD}
TEMPORAL_NAMESPACE=default

# Elasticsearch buys advanced visibility Postiz never queries, so visibility
# lands in SQL, which caps custom search attributes at three columns per type.
# @type=boolean
ENABLE_ES=false

# auto-setup registers CustomStringField and CustomTextField (both Text) as
# tutorial scaffolding, spending two of those three columns. Postiz registers
# two of its own at every boot, so leaving this false makes four into three and
# the backend dies at startup with nginx returning 502 on every /api call.
# @type=boolean
SKIP_ADD_CUSTOM_SEARCH_ATTRIBUTES=true

# Mounted from the shipped dynamicconfig.yaml.
DYNAMIC_CONFIG_FILE_PATH=config/dynamicconfig/development-sql.yaml

# ─── Storage ─────────────────────────────────────────────────────────────

# @type=enum(local, cloudflare)
STORAGE_PROVIDER=local

# Where local uploads are written inside the container.
UPLOAD_DIRECTORY=/uploads

# Path segment used to build public media URLs. NO leading slash: Postiz
# concatenates FRONTEND_URL + "/" + this, so a slash yields a doubled one.
# @type=string(matches=/^[^\/]/)
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=uploads

# Only needed when STORAGE_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
# @sensitive
CLOUDFLARE_ACCESS_KEY=
# @sensitive
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
# @type=url
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# ─── Email ───────────────────────────────────────────────────────────────

# Setting this turns ON email activation for new users. Leaving it empty
# auto-activates them, which is what you want on a private instance.
# @sensitive @type=string(startsWith=re_)
RESEND_API_KEY=
# @type=email
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ─── Channels ────────────────────────────────────────────────────────────
# Each block is one channel in "Add Channel". Without its vars that button
# builds an OAuth URL containing "undefined" and the provider rejects it.

# @docs("X provider setup", https://docs.postiz.com/providers/x-twitter)
# @sensitive
X_API_KEY=
# @sensitive
X_API_SECRET=
# Only for a self-hosted/alternate API host. Leave empty for x.com.
# @type=url
X_URL=

# @docs("LinkedIn provider setup", https://docs.postiz.com/providers/linkedin)
LINKEDIN_CLIENT_ID=
# @sensitive
LINKEDIN_CLIENT_SECRET=

# @docs("Reddit provider setup", https://docs.postiz.com/providers/reddit)
REDDIT_CLIENT_ID=
# @sensitive
REDDIT_CLIENT_SECRET=

# Facebook AND the linked-account Instagram provider both read these.
# @docs("Facebook provider setup", https://docs.postiz.com/providers/facebook)
FACEBOOK_APP_ID=
# @sensitive
FACEBOOK_APP_SECRET=

# Standalone Instagram (not via a Facebook page).
# @docs("Instagram provider setup", https://docs.postiz.com/providers/instagram)
INSTAGRAM_APP_ID=
# @sensitive
INSTAGRAM_APP_SECRET=

# @docs("Threads provider setup", https://docs.postiz.com/providers/threads)
THREADS_APP_ID=
# @sensitive
THREADS_APP_SECRET=

# @docs("YouTube provider setup", https://docs.postiz.com/providers/youtube)
YOUTUBE_CLIENT_ID=
# @sensitive
YOUTUBE_CLIENT_SECRET=

# Google Business Profile. Falls back to the YOUTUBE_* pair when unset.
# @docs("Google My Business setup", https://docs.postiz.com/providers/google-my-business)
GOOGLE_GMB_CLIENT_ID=
# @sensitive
GOOGLE_GMB_CLIENT_SECRET=

# @docs("TikTok provider setup", https://docs.postiz.com/providers/tiktok)
TIKTOK_CLIENT_ID=
# @sensitive
TIKTOK_CLIENT_SECRET=

# @docs("Pinterest provider setup", https://docs.postiz.com/providers/pinterest)
PINTEREST_CLIENT_ID=
# @sensitive
PINTEREST_CLIENT_SECRET=

# @docs("Dribbble provider setup", https://docs.postiz.com/providers/dribbble)
DRIBBBLE_CLIENT_ID=
# @sensitive
DRIBBBLE_CLIENT_SECRET=

# @docs("Tumblr provider setup", https://docs.postiz.com/providers/tumblr)
TUMBLR_CLIENT_ID=
# @sensitive
TUMBLR_CLIENT_SECRET=

# @docs("Discord provider setup", https://docs.postiz.com/providers/discord)
DISCORD_CLIENT_ID=
# @sensitive
DISCORD_CLIENT_SECRET=
# @sensitive
DISCORD_BOT_TOKEN_ID=

# @docs("Slack provider setup", https://docs.postiz.com/providers/slack)
SLACK_ID=
# @sensitive
SLACK_SECRET=
# @sensitive
SLACK_SIGNING_SECRET=

# Mastodon. MASTODON_URL alone is enough for the custom-instance provider.
# @docs("Mastodon provider setup", https://docs.postiz.com/providers/mastodon)
# @type=url
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
# @sensitive
MASTODON_CLIENT_SECRET=

# @docs("Telegram provider setup", https://docs.postiz.com/providers/telegram)
# @sensitive
TELEGRAM_TOKEN=

# @docs("Whop provider setup", https://docs.postiz.com/providers/whop)
WHOP_CLIENT_ID=

# @docs("MeWe provider setup", https://docs.postiz.com/providers/mewe)
MEWE_APP_ID=
# @sensitive
MEWE_API_KEY=
# @type=url
MEWE_HOST=

# Farcaster, via Neynar.
# @docs("Farcaster provider setup", https://docs.postiz.com/providers/farcaster)
NEYNAR_CLIENT_ID=
# @sensitive
NEYNAR_SECRET_KEY=

# Skool posts through the browser extension rather than an API.
# @docs("Skool provider setup", https://docs.postiz.com/providers/skool)
EXTENSION_ID=

# Twitch, Kick and VK have no provider doc page upstream.
TWITCH_CLIENT_ID=
# @sensitive
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
# @sensitive
KICK_SECRET=
VK_ID=

GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# @sensitive
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=

# @type=url
LISTMONK_DOMAIN=
LISTMONK_USER=
# @sensitive
LISTMONK_API_KEY=
LISTMONK_LIST_ID=

# ─── Single sign-on ──────────────────────────────────────────────────────

# @type=boolean
POSTIZ_GENERIC_OAUTH=false
# @type=url
POSTIZ_OAUTH_URL=
# @type=url
POSTIZ_OAUTH_AUTH_URL=
# @type=url
POSTIZ_OAUTH_TOKEN_URL=
# @type=url
POSTIZ_OAUTH_USERINFO_URL=
POSTIZ_OAUTH_CLIENT_ID=
# @sensitive
POSTIZ_OAUTH_CLIENT_SECRET=
POSTIZ_OAUTH_SCOPE=openid profile email
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=
# @type=url
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=

# ─── Misc ────────────────────────────────────────────────────────────────

# Powers the AI-assisted editor. Without it those controls do nothing.
# @sensitive @type=string(startsWith=sk-)
OPENAI_API_KEY=

# Postiz fetches operator-supplied URLs (Mastodon, WordPress, Lemmy, a
# Bluesky PDS) server-side and blocks private/loopback targets. Only disable
# it if those services live on a trusted private network with this instance.
# @type=boolean
DISABLE_SSRF_PROTECTION=false

# @type=boolean
DISABLE_X_ANALYTICS=false
# @type=boolean
STRIP_LINKS_FROM_X_POSTS=false

# @type=url
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=

# ─── Short links ─────────────────────────────────────────────────────────

# @sensitive
DUB_TOKEN=
# @type=url
DUB_API_ENDPOINT=https://api.dub.co
DUB_SHORT_LINK_DOMAIN=dub.sh
# @sensitive
SHORT_IO_SECRET_KEY=
# @sensitive
KUTT_API_KEY=
# @type=url
KUTT_API_ENDPOINT=https://kutt.it/api/v2
KUTT_SHORT_LINK_DOMAIN=kutt.it
# @sensitive
LINK_DRIP_API_KEY=
# @type=url
LINK_DRIP_API_ENDPOINT=https://api.linkdrip.com/v1/
LINK_DRIP_SHORT_LINK_DOMAIN=dripl.ink

# ─── Payments ────────────────────────────────────────────────────────────
# Only for running Postiz as a paid multi-tenant service.

# @type=number
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=
# @sensitive @type=string(startsWith=sk_)
STRIPE_SECRET_KEY=
# @sensitive
STRIPE_SIGNING_KEY=
# @sensitive
STRIPE_SIGNING_KEY_CONNECT=
