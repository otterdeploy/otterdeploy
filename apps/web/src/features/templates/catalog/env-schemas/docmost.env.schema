# Docmost 0.95.0 (image docmost/docmost:0.95.0) environment schema
# (@env-spec / varlock format).
#
# Source: the v0.95.0 source tree. Docmost is a NestJS monorepo and reads its
# configuration in exactly two places: `@nestjs/config` lookups funnelled
# through `apps/server/src/integrations/environment/environment.service.ts`
# (every `configService.get<string>('KEY', 'default')` there is a key and its
# real default), and a short list of raw `process.env` reads outside the Nest
# container: HOST, PORT, COLLAB_PORT, COLLAB_SHOW_STATS, DEBUG_DB,
# DEBUG_MODE, LOG_HTTP, NODE_ENV. Boot-time validation of a subset lives in
# `environment.validation.ts` (class-validator); when it fails the process
# prints the constraint and calls `process.exit(1)`, so a bad value here is a
# container that never comes up, not a degraded one.
#
# Cross-checked against the published Environment Variables reference and
# upstream's own docker-compose.yml. Where they disagree the code wins:
#
#   * JWT_TOKEN_EXPIRES_IN: the docs and .env.example say the default is
#     `30d`. The code default is `90d` (environment.service.ts). `30d` is only
#     a default because upstream's .env.example writes it out.
#   * SEARCH_DRIVER: the docs say the default is `postgres`. The code default
#     is `database`, and `postgres` is not an accepted value: the validator
#     only allows `database` or `typesense`, so copying the docs verbatim
#     stops the container from booting.
#   * MAIL_DRIVER: the docs and .env.example show `smtp`. The code default is
#     `log` (mail is written to the container log and never sent). Set it to
#     `smtp` or `postmark` to actually deliver invites and password resets.
#   * FILE_IMPORT_SIZE_LIMIT: the docs table's example column says `100mb`,
#     its own prose and the code say `200mb`.
#   * The reference documents none of the collaboration server knobs
#     (COLLAB_URL, COLLAB_PORT, COLLAB_DISABLE_REDIS, COLLAB_SHOW_STATS), the
#     connection-pool size, the S3/Azure public base-URL overrides, the
#     Gotenberg PDF exporter, the ClickHouse event store, the mail blocklist,
#     SMTP_IGNORETLS, or the debug flags. They are all read by this version.
#
# The compose prompts for APP_URL, APP_SECRET and POSTGRES_PASSWORD, and
# threads POSTGRES_PASSWORD into both DATABASE_URL and the bundled Postgres.
# Nothing else is needed for a working instance: the first visit to APP_URL
# runs the setup form that creates the workspace and its first admin.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Docmost environment variables", https://docmost.com/docs/self-hosting/environment-variables)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Public base URL of this instance, origin only (scheme + host + optional
# port); Docmost parses it and keeps just the origin. It is what every link in
# an outbound email, every share link and the collaboration WebSocket URL are
# built from, and an https:// value is what makes session cookies Secure. Get
# it wrong and the app still loads, but invite/reset emails point somewhere
# else. Must be a valid http/https URL or boot validation fails.
# @required
# @type=url
# @docs("Application configuration", https://docmost.com/docs/self-hosting/environment-variables)
APP_URL=

# The single signing key for the whole instance. It signs and verifies every
# JWT: session/access tokens (token.module.ts, jwt.strategy.ts), the
# email-verification and PDF-export download tokens, and it salts the
# anonymous telemetry instance id. Minimum 32 characters, enforced at boot,
# and the literal `REPLACE_WITH_LONG_SECRET` from upstream's compose is
# explicitly rejected, but nothing stops a short-ish 32-char guessable
# string, and Docmost cannot tell one from a good one.
#
# What is at risk if it is weak, reused or copied from a tutorial: anyone who
# can guess or obtain it can forge a JWT for any user id in any workspace,
# including an owner, and sign in without a password. MFA, SSO and the
# password hash are all bypassed, because the token is trusted on its
# signature alone. Reusing the same value across two deployments means a
# token minted by one is accepted by the other. Generate it once with
# `openssl rand -hex 32`, store it nowhere else, and treat rotating it as a
# forced global sign-out: every existing session and pending email link dies
# the moment it changes.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("Application configuration", https://docmost.com/docs/self-hosting/environment-variables)
APP_SECRET=

# TCP port the HTTP server binds inside the container. The compose exposes
# container port 3000 and does not override this, so the two are twins:
# change one without the other and routing breaks.
# @type=port
PORT=3000

# Bind address inside the container (main.ts / collab-main.ts read this
# directly). `0.0.0.0` is what the container network needs; narrowing it makes
# the service unreachable from the proxy.
HOST=0.0.0.0

# Lifetime of the session JWT and of the cookie that carries it, as an `ms`
# duration string (`30d`, `12h`). The code default is 90d; an unparseable
# value silently falls back to 90d rather than failing. Shorter means users
# sign in more often; there is no refresh-token flow to soften it.
JWT_TOKEN_EXPIRES_IN=90d

# The image's own start script runs `cross-env NODE_ENV=production node
# dist/main`, so this is already production inside the container and setting
# it from the compose has no effect. Listed because the code reads it (it
# gates pretty-printed logs and dev-only CORS).
# @type=enum(production, development)
NODE_ENV=production

# ─── Bundled Postgres ──────────────────────────────────────────────────────
# The stack runs its own postgres:17-alpine. Docmost creates and migrates its
# schema on every boot; there is no separate migration step.

# Connection string, assembled by the compose from the prompted
# POSTGRES_PASSWORD and the database service's hostname. Must be a
# postgres:/postgresql: URL or boot validation fails. Point it elsewhere only
# if you are moving to an external Postgres (the bundled one is then unused).
# @required
# @sensitive
DATABASE_URL=postgresql://docmost:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/docmost?schema=public

# Max connections in the app's pool. The bundled Postgres allows 100 total by
# default, so raising this past ~90 (or running several replicas) starts
# handing out "too many clients" errors instead of pages.
# @type=number
DATABASE_MAX_POOL=10

# Role Docmost connects as, created by the Postgres image on first boot. It is
# baked into DATABASE_URL above; changing it here alone only breaks the pair.
POSTGRES_USER=docmost

# Password for that role, used by both the database container and
# DATABASE_URL. Only ever reachable on the stack's private network, but a weak
# value is still a full read/write path to every page, attachment record and
# password hash for anything else that lands on that network.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot. Baked into DATABASE_URL above.
POSTGRES_DB=docmost

# ─── Bundled Redis and the collaboration server ────────────────────────────
# The stack runs its own redis:7-alpine. Redis carries the BullMQ job queues
# (email, exports, search indexing, attachment cleanup) and the pub/sub that
# lets more than one Docmost process share a live editing session.

# Redis connection string, pointed at the bundled service by the compose.
# Must be a redis:/rediss: URL or boot validation fails. Docmost will not
# start without a reachable Redis.
# @required
# @sensitive
REDIS_URL=redis://${{stack.redis.HOST}}:6379

# Absolute base URL the browser should open the collaboration WebSocket
# against, when the Hocuspocus collab server runs somewhere other than this
# instance. Empty means "same origin as the app", which is what the single
# container in this stack serves (`/collab` on PORT). Set it only if you split
# the collab process out.
# @type=url
COLLAB_URL=

# Port for the standalone collaboration entrypoint (`pnpm collab`,
# dist/collaboration/server/collab-main). The image in this stack runs the
# combined server, which serves collaboration on PORT instead, so this is
# read only by that separate process.
# @type=port
COLLAB_PORT=3001

# "true" runs the collaboration server without Redis pub/sub. That is correct
# only for a single process, and it silently desynchronises editors as soon
# as there are two.
# @type=boolean
COLLAB_DISABLE_REDIS=false

# "true" exposes the Hocuspocus connection/document statistics endpoint on the
# collaboration server. Diagnostic; leave off in production.
# @type=boolean
COLLAB_SHOW_STATS=false

# ─── File storage ──────────────────────────────────────────────────────────
# @docs("Storage configuration", https://docmost.com/docs/self-hosting/environment-variables)

# Where attachments and avatars are written. `local` uses the container path
# backed by this stack's docmost-data volume (/app/data/storage). Switching
# to `s3` or `azure` does NOT migrate what is already on that volume, and old
# attachments 404 until you copy them across. Any value other than these three
# fails boot validation.
# @type=enum(local, s3, azure)
STORAGE_DRIVER=local

# Largest single upload accepted, as a byte string (`50mb`, `1gb`). Also
# bounds pasted images. Raise it and the reverse proxy in front of Docmost
# usually needs its own body-size limit raised to match.
FILE_UPLOAD_SIZE_LIMIT=50mb

# Largest file accepted by the import flows (Confluence/Notion/Markdown
# archives), separate from the upload limit above.
FILE_IMPORT_SIZE_LIMIT=200mb

# S3-compatible storage (STORAGE_DRIVER=s3). Region and bucket are required
# in that mode; endpoint is for non-AWS providers (MinIO, R2, B2, Wasabi) and
# path style is what most of them need.
# @sensitive
AWS_S3_ACCESS_KEY_ID=
# @sensitive
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
# @type=url
AWS_S3_ENDPOINT=
# @type=boolean
AWS_S3_FORCE_PATH_STYLE=false
# Public base URL objects are served from (a CDN or custom domain in front of
# the bucket), used when building attachment links instead of the endpoint.
# Undocumented; read by storage.provider.ts.
# @type=url
AWS_S3_URL=

# Azure Blob Storage (STORAGE_DRIVER=azure).
AZURE_STORAGE_ACCOUNT_NAME=
# @sensitive
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=
# Custom blob service endpoint, for Azurite or a sovereign cloud. Undocumented.
# @type=url
AZURE_STORAGE_ENDPOINT=
# Public base URL blobs are served from. Undocumented.
# @type=url
AZURE_STORAGE_URL=

# ─── Email ─────────────────────────────────────────────────────────────────
# Without a working mail driver Docmost still runs, but invitations, password
# resets and email verification are only written to the container log; the
# recipient never gets them, so a self-service password reset is impossible.
# @docs("Email configuration", https://docmost.com/docs/self-hosting/environment-variables)

# Empty means the code default `log`: compose the message, print it, send
# nothing. Only `smtp` and `postmark` are accepted values; anything else fails
# boot validation.
# @type=enum(smtp, postmark)
MAIL_DRIVER=

# Envelope From address. Must be one your provider is allowed to send as, or
# everything Docmost sends lands in spam or is rejected outright.
# @type=email
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Docmost

# Comma-separated recipient domains Docmost refuses to send to. Undocumented;
# useful for keeping a staging copy from mailing real users.
MAIL_BLOCKED_RECIPIENT_DOMAINS=

# SMTP driver (MAIL_DRIVER=smtp).
# @docs("Nodemailer SMTP options", https://nodemailer.com/smtp)
SMTP_HOST=
# @type=port
SMTP_PORT=587
# "true" opens the connection in TLS from the first byte, which is correct
# for port 465. Leave false for 587, which upgrades with STARTTLS.
# @type=boolean
SMTP_SECURE=false
# "true" skips STARTTLS entirely, sending credentials and message bodies in
# the clear. Only for a relay on the same private network.
# @type=boolean
SMTP_IGNORETLS=false
SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=

# Postmark driver (MAIL_DRIVER=postmark): the server token, not the account
# token.
# @sensitive
# @docs("Postmark API overview", https://postmarkapp.com/developer/api/overview)
POSTMARK_TOKEN=

# ─── Diagrams and export ───────────────────────────────────────────────────

# Base URL of the draw.io editor the diagram block embeds. Empty uses
# https://embed.diagrams.net, which means the browser of every editor loads
# third-party JavaScript; point this at your own draw.io deployment to keep
# diagram editing inside your network.
# @type=url
# @docs("Diagrams", https://docmost.com/docs/user-guide/diagrams)
DRAWIO_URL=

# Base URL of a Gotenberg instance used for server-side PDF export. Empty
# disables PDF export of pages/spaces; the option simply fails. Undocumented
# in the environment reference.
# @type=url
# @docs("Gotenberg", https://gotenberg.dev/docs/getting-started/introduction)
GOTENBERG_URL=

# ─── Search ────────────────────────────────────────────────────────────────
# @docs("Search", https://docmost.com/docs/user-guide/search)

# `database` uses Postgres full-text search, which is what this stack has and
# needs no extra service. `typesense` is a commercial-edition feature and
# requires a separate Typesense server. The docs' `postgres` is not a valid
# value, so the validator rejects it and the container exits.
# @type=enum(database, typesense)
SEARCH_DRIVER=database

# Required when SEARCH_DRIVER=typesense; must be a valid http/https URL or
# boot validation fails. The code falls back to http://localhost:8108, which
# is not reachable from this container.
# @type=url
TYPESENSE_URL=
# Typesense API key with read/write permission. Required when
# SEARCH_DRIVER=typesense.
# @sensitive
TYPESENSE_API_KEY=
# ISO 639-1 language code used for tokenisation; validated as such.
# @docs("Typesense supported languages", https://typesense.org/docs/latest/api/search.html#supported-languages)
TYPESENSE_LOCALE=en

# ─── AI (commercial editions) ──────────────────────────────────────────────
# Setting AI_DRIVER turns on AI search and chat and makes the rest of this
# block conditionally required: the completion model always, plus the provider
# key or URL for the driver chosen. Every prompt sends page content to that
# provider.
# @docs("AI search", https://docmost.com/docs/self-hosting/ai/ai-search)

# @type=enum(openai, openai-compatible, gemini, ollama)
AI_DRIVER=
# Embedding model used to index pages for semantic search.
AI_EMBEDDING_MODEL=
# Vector dimension. Auto-detected for known models; only these five values are
# accepted. Changing it after indexing invalidates the stored vectors.
# @type=enum(768, 1024, 1536, 2000, 3072)
AI_EMBEDDING_DIMENSION=
# "false" stops Docmost sending a `dimensions` parameter to the embedding API,
# for models that reject it (Matryoshka support).
# @type=boolean
AI_EMBEDDING_SUPPORTS_MRL=
# Model used to answer questions. Required whenever AI_DRIVER is set.
AI_COMPLETION_MODEL=
# Model used for the chat surface; falls back to AI_COMPLETION_MODEL when
# empty. Undocumented.
AI_CHAT_MODEL=
# Required for AI_DRIVER=openai or openai-compatible.
# @sensitive
OPENAI_API_KEY=
# Custom OpenAI-compatible base URL (Azure OpenAI, vLLM, OpenRouter).
# Required for openai-compatible.
# @type=url
OPENAI_API_URL=
# Required for AI_DRIVER=gemini.
# @sensitive
# @docs("Gemini API keys", https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Required for AI_DRIVER=ollama; the code falls back to
# http://localhost:11434, which is not reachable from this container.
# @type=url
OLLAMA_API_URL=

# ─── Audit event store ─────────────────────────────────────────────────────

# Where audit events are written. `postgres` keeps them in the bundled
# database and needs nothing extra. `clickhouse` is for high-volume
# deployments and makes CLICKHOUSE_URL required. Undocumented in the
# environment reference.
# @type=enum(postgres, clickhouse)
EVENT_STORE_DRIVER=postgres

# ClickHouse HTTP URL including credentials and database, e.g.
# http://user:password@clickhouse:8123/docmost. Required (and validated as a
# URL) when EVENT_STORE_DRIVER=clickhouse.
# @sensitive
# @type=url
# @docs("ClickHouse HTTP interface", https://clickhouse.com/docs/en/interfaces/http)
CLICKHOUSE_URL=

# ─── Authentication ────────────────────────────────────────────────────────
# SAML, OIDC and MFA are configured in the app under Settings → Security & SSO.
# This is the one auth setting that has to be an environment variable.

# "true" drops the RequestedAuthnContext element (which asks for
# PasswordProtectedTransport) from SAML AuthnRequests, so an IdP such as AD FS
# can use its own default method. Instance-wide, all SAML providers.
# @type=boolean
# @docs("Authentication", https://docmost.com/docs/user-guide/authentication)
SAML_DISABLE_REQUESTED_AUTHN_CONTEXT=false

# ─── Security headers ──────────────────────────────────────────────────────

# Docmost answers with `X-Frame-Options: SAMEORIGIN` by default, so no other
# site can frame it. That is the clickjacking defence that stops a malicious
# page loading your instance invisibly and steering a signed-in user's clicks
# into destructive actions. "true" removes that header. Public /share/ pages
# are always embeddable and are unaffected either way.
# @type=boolean
IFRAME_EMBED_ALLOWED=false

# Comma-separated origins allowed to frame Docmost. Only consulted when
# IFRAME_EMBED_ALLOWED=true, where it emits
# `Content-Security-Policy: frame-ancestors 'self' <origins>` instead. Leaving
# it empty while embedding is enabled allows ANY origin, so set it.
IFRAME_ALLOWED_ORIGINS=

# ─── Telemetry and logging ─────────────────────────────────────────────────

# Docmost reports version, user/page/space/workspace counts and an instance id
# derived from APP_SECRET. "true" turns that off.
# @type=boolean
DISABLE_TELEMETRY=false

# "true" raises the log level to debug in production. Verbose; log volume
# grows a lot and request payloads become more visible in the logs.
# @type=boolean
DEBUG_MODE=false

# "true" logs every SQL statement Kysely runs. Diagnostic only.
# @type=boolean
DEBUG_DB=false

# "true" logs one line per HTTP request (pino-http). Off by default.
# @type=boolean
LOG_HTTP=false

# ─── Hosted (multi-tenant) mode ────────────────────────────────────────────
# Read by the code but only meaningful for Docmost's own hosted service, which
# runs one instance serving many workspaces on subdomains. For a self-hosted
# stack leave CLOUD off and the rest empty; setting CLOUD=true here switches
# the app to subdomain routing and paid-plan gating and is not a supported
# self-host configuration.

# @type=boolean
CLOUD=false
# Apex domain workspaces get subdomains under. Validated as a bare FQDN (no
# scheme) and required when CLOUD=true.
SUBDOMAIN_HOST=
# @sensitive
STRIPE_PUBLISHABLE_KEY=
# @sensitive
STRIPE_SECRET_KEY=
# @sensitive
STRIPE_WEBHOOK_SECRET=
# @type=number
BILLING_TRIAL_DAYS=14
POSTHOG_HOST=
# @sensitive
POSTHOG_KEY=
