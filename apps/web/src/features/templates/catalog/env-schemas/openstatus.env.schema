# openstatus (main, `latest` images) — environment schema (@env-spec / varlock format).
#
# openstatus publishes no versioned tags: every `ghcr.io/openstatushq/*` tag is
# either `latest`/`main` or the commit SHA that built it, and the SHAs do not
# line up across images. Researched against `main` at 99b5989 (2026-09-05),
# which is what `latest` was built from.
#
# Source: `createEnv`/zod schemas in apps/server/src/env.ts,
# apps/workflows/src/env.ts, packages/api/src/env.ts, apps/web/src/env.ts; a
# grep of `process.env.*` across apps/dashboard/src and apps/status-page/src;
# and `os.Getenv`/`os.LookupEnv` across apps/private-location for the Go ingest
# server. libsql's keys come from the image's own docker-entrypoint.sh and
# libsql-server/src/main.rs.
#
# Where .env.docker.example and the code disagree, the code wins:
#   * NEXT_PUBLIC_URL is marked [REQUIRED] there and is read by ONE app —
#     apps/web, the marketing site, which this stack does not run. No service
#     here reads it, so it is not declared. The dashboard and status page
#     derive their own origin from the request, which is what AUTH_TRUST_HOST
#     is for.
#   * RESEND_API_KEY is documented as the magic-link mailer. It is not: the
#     self-host provider (apps/dashboard/src/lib/auth/providers.ts) passes
#     `apiKey: undefined` and its sendVerificationRequest console.logs the
#     link. The key is still REQUIRED because packages/api/src/env.ts types it
#     `z.string()` with validation on, so the dashboard refuses to boot without
#     one. It is used for alert email.
#   * WORKSPACES_HIDE_URL and QSTASH_* appear in the example file; nothing in
#     this stack reads WORKSPACES_HIDE_URL, so it is omitted.
#   * FLY_REGION is typed `z.enum(monitorRegions)` and "self-hosted" is NOT a
#     member (packages/regions/index.ts). It passes only because apps/server
#     sets `skipValidation: true`. The value is upstream's own; it is recorded
#     here rather than corrected, because there is no correct member for a
#     self-hosted node.
#
# Cloud-only surfaces the images carry but a self-hosted install never uses —
# Stripe, Vercel domains and Blob, Unkey, GCP Cloud Tasks, QStash, Axiom,
# OpenPanel — are deliberately absent.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Self-hosting openstatus", https://www.openstatus.dev/docs/guides/self-hosting-openstatus)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Turns on the self-hosted code paths: it makes Stripe, Vercel, Unkey and
# Tinybird credentials optional in packages/api/src/env.ts, and it is what
# enables the email provider on the login screen. Parsed with `z.stringbool()`,
# so "true"/"false" (not 1/0 in the dashboard's own `SELF_HOST === "true"`
# check, which is a strict string compare).
# @required
# @type=enum(true, false)
SELF_HOST=true

# Auth.js secret, shared by the dashboard and the status page so a session
# minted by one is readable by the other. Rotating it logs everyone out.
# @required
# @sensitive
# @docs("Auth.js AUTH_SECRET", https://authjs.dev/getting-started/installation)
AUTH_SECRET=

# Tells Auth.js to build callback URLs from the incoming X-Forwarded-* headers
# rather than a configured origin. Required behind a reverse proxy, which is
# how this stack is always reached.
# @required
# @type=enum(true, false)
AUTH_TRUST_HOST=true

# Shared secret with two jobs: it authorises calls to the workflows app's
# /cron/* endpoints, and the Go ingest server sends it as the Authorization
# header when forwarding a status change to workflows. A mismatch shows up as
# `failed to forward status update to workflows ... 401`. Typed `z.string()`
# with validation ON in packages/api, so an unset value stops the dashboard
# from booting.
# @required
# @sensitive
CRON_SECRET=

# Resend key for alert email. See the header: it is NOT what sends the login
# magic link, but it must be present or the dashboard fails env validation at
# boot.
# @required
# @sensitive
# @docs("Resend API keys", https://resend.com/api-keys)
RESEND_API_KEY=

# Node's own mode. The images are production builds; anything else re-enables
# development behaviour, including the email login provider being switched on
# by NODE_ENV rather than by SELF_HOST.
# @type=enum(production, development, test)
NODE_ENV=production

# Port each Node service listens on inside its container, and the port the Go
# ingest server binds. The compose sets 3000 for workflows, server, dashboard
# and status-page, and 8080 for private-location.
# @type=port
PORT=3000

# Next.js standalone server bind address. Without 0.0.0.0 it listens on
# loopback and nothing on the stack network can reach the dashboard or the
# status page.
HOSTNAME=0.0.0.0

# Region code stamped on checks this node performs. See the header: upstream's
# own value, and not a member of the enum it is typed against.
FLY_REGION=self-hosted

# ─── Database (bundled libSQL) ─────────────────────────────────────────────

# libSQL HTTP endpoint. Read by the migration runner and by every Node app
# through packages/db.
# @required
DATABASE_URL=http://${{stack.libsql.HOST}}:8080

# The same endpoint under the name the Go ingest server reads
# (apps/private-location/internal/database/database.go).
# @required
DB_URL=http://${{stack.libsql.HOST}}:8080

# Auth token for libSQL. The bundled sqld runs with no JWT key, so both of
# these stay empty; they exist for pointing the stack at Turso instead.
# @sensitive
DATABASE_AUTH_TOKEN=
# @sensitive
DB_AUTH_TOKEN=

# sqld's role. `primary` serves HTTP on 8080 and gRPC on 5001; the image's
# docker-entrypoint.sh reads this and nothing else selects the mode.
# @type=enum(primary, replica, standalone)
SQLD_NODE=primary

# sqld connection/request ceilings, both 128 by default
# (libsql-server/src/main.rs). Raised because seven services share one
# database with no connection pooling in front of it.
# @type=number
SQLD_MAX_CONCURRENT_CONNECTIONS=512
# @type=number
SQLD_MAX_CONCURRENT_REQUESTS=1024

# ─── Analytics (bundled Tinybird) ──────────────────────────────────────────

# Every check result is stored in Tinybird, not in libSQL, so the dashboard's
# charts are empty until this is working. Points at the bundled container;
# leave it unset and the apps query api.tinybird.co and fail with "the pipe
# ... does not exist".
# @required
# @docs("Tinybird CLI", https://www.tinybird.co/docs/cli)
TINYBIRD_URL=http://${{stack.tinybird.HOST}}:7181

# The Tinybird token, under the two different names that read it: the Node
# apps read TINY_BIRD_API_KEY, the Go ingest server reads TINYBIRD_TOKEN.
# Setting only the first is the most common self-hosting mistake — the ingest
# server then has no token and Tinybird rejects every check with a 403.
#
# Both are empty here because the token does not exist at install time: it is
# minted when you run `tb --local deploy` against the bundled container and
# read it back with `tb --local info`. Fill both in afterwards. (Do not use
# `curl :7181/tokens` — it returns a different workspace's token, which ingests
# fine and then 404s every dashboard query.)
# @sensitive
TINY_BIRD_API_KEY=
# @sensitive
TINYBIRD_TOKEN=

# Resolves every Tinybird pipe and ingest call to empty instead of calling the
# instance above. An escape hatch for running the stack with the charts
# knowingly dead rather than with a misconfigured Tinybird; it does NOT reach
# the Go ingest server, which has no noop path.
# @type=enum(true, false)
TINYBIRD_NOOP=

# Sets tinybird-local's compatibility behaviour. Taken from openstatus's own
# docker-compose.github-packages.yaml; the image is closed, so this is not
# verified against source the way every other item here is.
COMPATIBILITY_MODE=1

# ─── Service wiring ────────────────────────────────────────────────────────

# Where the Go ingest server forwards monitor status changes. Unset, it
# defaults to openstatus Cloud's fly.dev host, which will reject your
# CRON_SECRET (apps/private-location/internal/workflows/client.go).
# @required
WORKFLOWS_URL=http://${{stack.workflows.HOST}}:3000

# API base the status page's embeddable widget calls. Defaults to
# api.openstatus.dev in packages/react, so a self-hosted page has to be told
# about its own API server.
OPENSTATUS_API_URL=http://${{stack.server.HOST}}:3000

# Gin's mode for the ingest server. `release` silences the framework's
# debug-route dump and startup warning.
# @type=enum(release, debug, test)
GIN_MODE=release

# ─── Login providers (optional) ────────────────────────────────────────────

# GitHub OAuth app. Callback URL is <dashboard-url>/api/auth/callback/github.
# @sensitive
# @docs("GitHub OAuth apps", https://github.com/settings/developers)
AUTH_GITHUB_ID=
# @sensitive
AUTH_GITHUB_SECRET=

# Google OAuth client. Callback URL is <dashboard-url>/api/auth/callback/google.
# @sensitive
# @docs("Google Cloud credentials", https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
# @sensitive
AUTH_GOOGLE_SECRET=

# Generic OIDC (Okta, Auth0, Entra ID, Keycloak, Pocket ID …). Setting the
# issuer is what adds the button; the name only relabels it, defaulting to
# "SSO".
# @type=url
AUTH_OIDC_ISSUER=
# @sensitive
AUTH_OIDC_ID=
# @sensitive
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=

# ─── AI assistant (optional) ───────────────────────────────────────────────

# The in-dashboard assistant is off by default and answers 503 until one of
# the two options below is configured (packages/ai/src/resolve-model.ts).
#
# Option 1, and the one to prefer when self-hosting: any OpenAI-compatible
# endpoint. Setting AI_BASE_URL selects this path and it wins over the gateway.
# The model MUST support tool calling — the assistant edits monitors and status
# pages through tools. AI_API_KEY may stay empty for a keyless local gateway
# such as Ollama.
# @type=url
AI_BASE_URL=
# @sensitive
AI_API_KEY=
AI_MODEL=

# Option 2: Vercel AI Gateway, which picks the model from the workspace plan.
# @sensitive
AI_GATEWAY_API_KEY=

# Docs site the assistant's search_docs / get_doc_page tools query. Defaults to
# the public openstatus.dev docs; point it at your own mirror if you run one.
# @type=url
OPENSTATUS_WEB_BASE_URL=

# ─── Integrations and misc (optional) ──────────────────────────────────────

# Bearer token for the server's privileged admin routes. No default, so leaving
# it empty leaves those routes unusable rather than open.
# @sensitive
SUPER_ADMIN_TOKEN=

# Telegram bot token, for the Telegram notification channel.
# @sensitive
TELEGRAM_BOT_TOKEN=

# Screenshot service the workflows app calls when a check fails, to attach an
# image to the incident. There is none in this stack; unset means no
# screenshots.
# @type=url
SCREENSHOT_SERVICE_URL=

# Salt for the hashed identifiers on externally shared reports.
# @sensitive
EXTERNAL_REPORT_SALT=

# Slack incoming webhook the in-app feedback form posts to.
# @sensitive
SLACK_FEEDBACK_WEBHOOK_URL=

# Sentry DSN for the Node apps' server-side error reporting.
# @sensitive
SENTRY_DSN=

# ─── Workflow tuning (optional) ────────────────────────────────────────────

# How long a check may go unreported before the workflows app treats the
# monitor as stale, in milliseconds. Default 600000 (10 minutes).
# @type=number
STALE_CHECK_MS=600000

# Deadline for a queued outbox notification, in milliseconds. Default 300000.
# @type=number
OUTBOX_DEADLINE_MS=300000

# Per-notification send timeout, in milliseconds. Default 10000.
# @type=number
NOTIFICATION_TIMEOUT_MS=10000

# Percentage of notifications routed through the outbox path rather than the
# direct one. Default 0, i.e. the outbox is off.
# @type=number
OUTBOX_ROLLOUT_PCT=0
