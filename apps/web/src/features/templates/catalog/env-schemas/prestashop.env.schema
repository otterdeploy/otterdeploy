# PrestaShop 9.1.5 environment schema (@env-spec / varlock format).
#
# The compose pins prestashop/prestashop:9.1.5-apache. It previously pinned
# the floating 9.1-apache, which on 2026-09-04 (research date) resolved to
# the same digest, sha256:8e1d3596c5b2b8c4385ac1506a3978f7ae6ff15bf736497134
# 58691308bd2fcc, pushed 2026-08-19, the day after the 9.1.5 release, so
# the float was healthy, not stale; the pin is now exact so it cannot drift.
# A bare `-apache` suffix means the image's DEFAULT PHP, currently 8.5:
# `9.1.5-apache`, `9.1.5-8.5` and `latest` are one digest. There is no
# `9.1.5-8.5-apache` tag (404); the explicit-PHP apache tags only exist in
# the long theme-qualified form, `9.1.5-5.0-classic-8.5-apache`.
#
# 9.1.5 (2026-08-18) is a SECURITY release: GHSA-xrwj-pq6w-f8m4 (SSRF via
# image URLs in CSV import, high), GHSA-w6j9-q9rq-wrqg (formula injection in
# CSV exports, high), GHSA-2cr4-vw9p-pjvf (client IP spoofing via
# X-Forwarded-For, high), GHSA-whxq-pxj5-qq7v (SQL injection in legacy
# back-office list filters), GHSA-jf3w-9rmr-5rcr (unauthorised access to the
# back-office notifications endpoint). 9.1.x is the current stable branch and
# is receiving fixes; 8.2.x is still backported (8.2.8 shipped the same day);
# 1.7.x is end of life and gets nothing. 9.2 exists only as 9.2.0-beta.1.
#
# Source: the image's own ENV defaults and entrypoint at this tag, namely
# base/Dockerfile.model, base/config_files/docker_run.sh and
# base/config_files/defines_custom.inc.php in github.com/PrestaShop/docker,
# the repo that builds these tags. PrestaShop itself is not env-configured:
# the installer writes app/config/parameters.php and everything after that
# lives in the database, so this whole family is a BOOTSTRAP, not runtime
# config. The repo README's table is wrong in two places: it gives
# DB_SERVER's default as `localhost` (the Dockerfile sets the literal string
# `<to be defined>`, which the entrypoint hard-fails on), and it omits
# DB_PORT, which the entrypoint passes to both the readiness probe and the
# installer.
#
# ONE-SHOT vs EVERY BOOT. docker_run.sh enters its install branch only when
# neither config/settings.inc.php nor app/config/parameters.php exists on the
# volume. After the first successful install, every key below except
# PS_DEV_MODE, PS_HOST_MODE and PS_DEMO_MODE is inert: DB_*, ADMIN_*,
# PS_DOMAIN, PS_LANGUAGE, PS_COUNTRY, PS_ALL_LANGUAGES, PS_FOLDER_*,
# PS_ENABLE_SSL, PS_ERASE_DB and PS_INSTALL_DB are read once and changing
# them later does nothing. Moving the shop to a new domain or rotating the
# database password is a back-office / parameters.php change, not an env one.
#
# SECURITY, because this compose sets PS_INSTALL_AUTO=1:
#  * ADMIN_PASSWD is the real back-office password and it lives in the
#    container's environment forever, readable by anything that can see
#    /proc/1/environ or run `docker inspect`. Change it from the back office
#    after first login and treat the env value as burned.
#  * The image ships stock credentials: ADMIN_MAIL=demo@prestashop.com,
#    ADMIN_PASSWD=prestashop_demo, DB_USER=root, DB_PASSWD=admin. The compose
#    overrides all four; never let one fall back to its default.
#  * The install directory is removed by the entrypoint ONLY when the CLI
#    installer exits 0. A failed install leaves /var/www/html/install in place
#    and reachable over HTTP. Verify it is gone, and delete it by hand if it
#    is not.
#  * The image does NOT randomise the admin folder. It renames `admin` to
#    exactly the literal PS_FOLDER_ADMIN, and only when that differs from
#    "admin". This compose leaves it unset, so the back office sits at the
#    guessable /admin/. Set PS_FOLDER_ADMIN to a private value BEFORE first
#    boot and record it: it is ignored afterwards and the UI never shows it.
#  * PS_DEV_MODE, PS_DEMO_MODE and PS_HOST_MODE each weaken a live shop; see
#    the notes on each. The compose pins PS_DEV_MODE=0.

# @defaultSensitive=false @defaultRequired=infer
# @docs("PrestaShop Docker image environment variables", https://github.com/PrestaShop/docker)
# ---

# ─── Storefront identity ──────────────────────────────────────────────────

# Host (and optional :port) the shop will be reached on, written into the
# `ps_shop_url` table by the installer. Read ONLY during auto-install; after
# that the domain is changed in Shop Parameters > Traffic & SEO, never here.
# The image default is the literal `<to be defined>`; when PS_INSTALL_AUTO=1
# and it is still that, the entrypoint substitutes the container's own IP,
# which produces a shop that only works from inside the network.
# @required
# @docs("Install PrestaShop with Docker", https://devdocs.prestashop-project.org/9/basics/installation/environments/docker/)
PS_DOMAIN=${PRESTASHOP_DOMAIN}

# The hostname the storefront is served on, prompted by this template and
# interpolated into PS_DOMAIN above. Bare host or host:port, no scheme and no
# trailing slash.
# @required
PRESTASHOP_DOMAIN=

# Rewrites the shop's recorded domain to whatever Host header the request
# arrived with, by putting docker_updt_ps_domains.php ahead of index.php in
# the Apache DirectoryIndex. Convenience for throwaway/local instances; on a
# public shop it lets any Host header rewrite your canonical domain, so leave
# it off. Applied at install time only.
# @type=boolean
PS_HANDLE_DYNAMIC_DOMAIN=0

# Installs the shop with SSL enabled (`--ssl=1`), i.e. PS_SSL_ENABLED on and
# https:// canonical URLs. Leave 0 when a reverse proxy terminates TLS and
# forwards plain HTTP unless the proxy also sets the forwarded-proto headers
# PrestaShop trusts; otherwise the front office redirect-loops. Switch it on
# from Shop Parameters > General afterwards instead; this is install-only.
# @type=boolean
PS_ENABLE_SSL=0

# ─── Installation ─────────────────────────────────────────────────────────

# Runs install/index_cli.php on first boot instead of leaving the web
# installer for a human. The image default is 0; this compose sets 1, which
# is what makes every ADMIN_*/PS_LANGUAGE/PS_COUNTRY key below matter. With
# it on, a missing or unreachable DB_SERVER aborts the container.
# @type=boolean
# @docs("Install PrestaShop from the command line", https://devdocs.prestashop-project.org/9/basics/installation/advanced/install-from-cli/)
PS_INSTALL_AUTO=1

# DROPS the database named by DB_NAME before installing. Destructive and
# irreversible; only ever useful for a disposable dev shop. Pinned to 0 here.
# Like every install key, it is read only while parameters.php is absent.
# @type=boolean
PS_ERASE_DB=0

# CREATES the database named by DB_NAME with `mysqladmin create`. Not set by
# this compose (default 0) because the bundled MySQL already creates
# `prestashop` from MYSQL_DATABASE on its own first boot. Turning it on would
# need DB_USER to hold CREATE DATABASE rights, which the `prestashop` user
# does not.
# @type=boolean
PS_INSTALL_DB=0

# Directory name the shipped `install` folder is renamed to before the
# installer runs; the entrypoint deletes that folder afterwards, but only on
# a successful install. Renaming it buys nothing once deletion succeeds and
# breaks nothing if you leave it. The real protection is confirming the
# folder is gone.
PS_FOLDER_INSTALL=install

# Directory name the shipped `admin` folder is renamed to, so the back office
# URL becomes https://<PS_DOMAIN>/<this>/. NOT randomised: the entrypoint
# renames to this literal string and skips the rename entirely when it is
# still "admin", which is the case with this compose. Set it to something
# unguessable before the FIRST boot; it is ignored on every later boot, and
# once renamed nothing in the UI tells you the name again.
PS_FOLDER_ADMIN=admin

# Back-office account created by the installer. ADMIN_PASSWD is the account's
# real password, not a seed, and it must satisfy PrestaShop's policy (8+
# chars) or the install fails. The image defaults are the public demo
# credentials demo@prestashop.com / prestashop_demo; this compose overrides
# both. The installer hard-codes the employee name as "John Doe"; rename it
# in the back office.
# @required
# @type=email
ADMIN_MAIL=${ADMIN_EMAIL}
# @required @sensitive
# @type=string(minLength=8)
ADMIN_PASSWD=${ADMIN_PASSWORD}

# The two values prompted by this template and interpolated into ADMIN_MAIL /
# ADMIN_PASSWD above. The password stays visible in the container's
# environment after install, so rotate it in the back office once you are in.
# @required
# @type=email
ADMIN_EMAIL=
# @required @sensitive
# @type=string(minLength=8)
ADMIN_PASSWORD=

# Default language installed and made the shop's default, as a two-letter ISO
# 639-1 code; the matching localisation pack is downloaded from
# prestashop.com at install time, so an unreachable network here silently
# leaves you with the built-in English pack.
PS_LANGUAGE=en

# Default country, ISO 3166-1 alpha-2. Drives the tax rules, currency and
# address format the shop starts with. Getting it wrong is a back-office
# clean-up, not a reinstall, but it is a tedious one.
PS_COUNTRY=GB

# Installs every language pack the version ships with rather than just
# PS_LANGUAGE. Adds several minutes to the first boot.
# @type=boolean
PS_ALL_LANGUAGES=0

# ─── Database ─────────────────────────────────────────────────────────────

# Host of the MySQL server, resolved by otterdeploy to the bundled `db`
# service. The image default is the literal `<to be defined>`, and the
# entrypoint refuses to start on it when PS_INSTALL_AUTO=1. The entrypoint
# blocks in a `mysql ... -e status` loop until this host answers, so a slow
# database delays rather than fails the first boot.
# @required
DB_SERVER=${{stack.db.HOST}}

# Port on DB_SERVER. Not set by this compose; the image default matches the
# bundled MySQL. Used both for the readiness loop and for the installer's
# `--db_server=host:port` argument.
# @type=port
DB_PORT=3306

# Schema the shop's tables live in. Must match the bundled MySQL's
# MYSQL_DATABASE, which is what actually creates it.
# @required
DB_NAME=prestashop

# MySQL account the shop connects as. Must match the bundled MySQL's
# MYSQL_USER/MYSQL_PASSWORD pair. The image default is `root`/`admin`. Never
# let either fall back.
# @required
DB_USER=prestashop
# @required @sensitive
DB_PASSWD=${MYSQL_PASSWORD}

# Table-name prefix chosen at install and then baked into parameters.php.
# Changing it after install points the shop at tables that do not exist.
DB_PREFIX=ps_

# ─── Bundled MySQL 8.4 ────────────────────────────────────────────────────

# Database and user the bundled MySQL creates on its FIRST boot from an empty
# data directory only; changing them later does nothing to an existing
# volume. They are the twins of DB_NAME / DB_USER / DB_PASSWD above and must
# stay in step with them. MYSQL_PASSWORD is prompted by this template and
# feeds both sides.
# @docs("MySQL image environment variables", https://hub.docker.com/_/mysql)
MYSQL_DATABASE=prestashop
MYSQL_USER=prestashop
# @required @sensitive
MYSQL_PASSWORD=

# Generates a random root password at initialisation and prints it once to
# the container log. PrestaShop never uses root; there is deliberately no
# stored root credential.
MYSQL_RANDOM_ROOT_PASSWORD=1

# ─── Runtime modes ────────────────────────────────────────────────────────
# Unlike everything above, these three are evaluated on EVERY boot.

# Defines _PS_MODE_DEV_ (via /tmp/defines_custom.inc.php), which turns on
# Symfony's profiler and prints full stack traces, SQL and file paths to
# anonymous visitors. Never 1 on a public shop. Pinned to 0 here. Note the
# check is PHP truthiness: any non-empty value other than "0" (including the
# string "false") switches it ON.
# @type=boolean
# @docs("prestashop:debug console command", https://devdocs.prestashop-project.org/9/development/components/console/prestashop-debug/)
PS_DEV_MODE=0

# Defines _PS_HOST_MODE_, the flag PrestaShop's own hosted offering used to
# set. It hides parts of the back office (performance settings, some module
# management) and changes update behaviour. Not something a self-hosted shop
# wants. Same truthiness rule as PS_DEV_MODE.
# @type=boolean
PS_HOST_MODE=0

# Rewrites config/defines.inc.php on every boot to set _PS_MODE_DEMO_, which
# blocks saving most settings and hides real customer data, making the shop a
# read-only showcase. This one is a strict numeric comparison, so only a
# non-zero number enables it. For demos only; it will look like the back
# office is broken otherwise.
# @type=boolean
PS_DEMO_MODE=0
