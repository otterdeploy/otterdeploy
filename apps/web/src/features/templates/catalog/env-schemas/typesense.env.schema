# Typesense 28.0 — environment schema (@env-spec / varlock format).
#
# Source: Config::load_config_env() in src/tsconfig.cpp at v28.0, the one
# place the server calls getenv. Every server flag has a TYPESENSE_<FLAG>
# twin there; precedence is env < --config file < command-line flag
# (typesense_server.cpp:173-175). This template passes --data-dir, --api-key
# and --enable-cors on the command line, so TYPESENSE_DATA_DIR,
# TYPESENSE_ENABLE_CORS and a TYPESENSE_API_KEY set as container env would be
# overridden; TYPESENSE_API_KEY below is the value the compose substitutes
# into --api-key, which is why it is required.
#
# The docs' server-configuration page lists flags, not env names, and omits
# TYPESENSE_HEALTH_RUSAGE_API_KEY, TYPESENSE_LISTEN_ADDRESS/PORT (aliases of
# API_ADDRESS/PORT) and TYPESENSE_MASTER (legacy, pre-Raft), all of which the
# code still reads. Booleans are compared against the literal string TRUE.
# Only single-node-relevant keys are declared; peering/cluster (NODES,
# PEERING_*) and SSL (the platform terminates TLS) are left out.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Typesense server configuration", https://typesense.org/docs/28.0/api/server-configuration.html)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The bootstrap admin key: every request needs it in X-TYPESENSE-API-KEY,
# and it is the only key that can mint scoped keys. Typesense refuses to
# start without one. Generated at install; wired into --api-key.
# @docs("Typesense API keys", https://typesense.org/docs/28.0/api/api-keys.html)
# @required @sensitive @type=string(minLength=32)
TYPESENSE_API_KEY=

# A key limited to search endpoints, for exposing directly to browsers.
# Empty = none; prefer a scoped key minted from the admin key.
# @sensitive
TYPESENSE_SEARCH_ONLY_API_KEY=

# Key that unlocks the resource-usage detail on /health. Empty = none.
# @sensitive
TYPESENSE_HEALTH_RUSAGE_API_KEY=

# ─── Network ─────────────────────────────────────────────────────────────
# The compose exposes 8108; changing the port here leaves nothing listening
# where the platform routes.

TYPESENSE_API_ADDRESS=0.0.0.0
# @type=port
TYPESENSE_API_PORT=8108

# Comma-separated origins allowed when CORS is on (--enable-cors is set by
# the compose). Empty = any origin.
TYPESENSE_CORS_DOMAINS=

# ─── Limits ──────────────────────────────────────────────────────────────

# Fraction of RAM Typesense may use before it starts rejecting writes.
# @type=number
TYPESENSE_MAX_MEMORY_RATIO=1.0
# Percent of disk used at which writes are refused.
# @type=number
TYPESENSE_DISK_USED_MAX_PERCENTAGE=100
# Percent of memory used at which writes are refused.
# @type=number
TYPESENSE_MEMORY_USED_MAX_PERCENTAGE=100
# Largest `per_page` a search may ask for.
# @type=number
TYPESENSE_MAX_PER_PAGE=250
# Cap on filter_by operations per query (0 = unlimited).
# @type=number
TYPESENSE_FILTER_BY_MAX_OPS=
# Worker threads; default is 4x CPU count.
# @type=number
TYPESENSE_THREAD_POOL_SIZE=

# ─── Logging ─────────────────────────────────────────────────────────────

# Directory for log files. Empty = stdout only, which is what the platform
# collects.
TYPESENSE_LOG_DIR=
# Log requests slower than this many ms (-1 = off).
# @type=number
TYPESENSE_LOG_SLOW_REQUESTS_TIME_MS=-1
# Log searches slower than this many ms (-1 = off).
# @type=number
TYPESENSE_LOG_SLOW_SEARCHES_TIME_MS=30000
# Literal TRUE enables access logging.
# @type=enum(TRUE, FALSE)
TYPESENSE_ENABLE_ACCESS_LOGGING=FALSE
# Literal TRUE enables search-query logging.
# @type=enum(TRUE, FALSE)
TYPESENSE_ENABLE_SEARCH_LOGGING=FALSE

# ─── Durability ──────────────────────────────────────────────────────────

# Seconds between Raft snapshots of the data dir.
# @type=number
TYPESENSE_SNAPSHOT_INTERVAL_SECONDS=3600
# Seconds between RocksDB compactions.
# @type=number
TYPESENSE_DB_COMPACTION_INTERVAL=604800
# Seconds between housekeeping sweeps.
# @type=number
TYPESENSE_HOUSEKEEPING_INTERVAL=1800
# Reject all writes; use to put a node into read-only mode.
# @type=enum(TRUE, FALSE)
TYPESENSE_SKIP_WRITES=FALSE

# ─── Search analytics ────────────────────────────────────────────────────

# Literal TRUE turns on popular-query / no-hit analytics collection.
# @type=enum(TRUE, FALSE)
TYPESENSE_ENABLE_SEARCH_ANALYTICS=FALSE
# Directory for the analytics DB. Empty = under the data dir.
TYPESENSE_ANALYTICS_DIR=
# Seconds between analytics flushes to their collections.
# @type=number
TYPESENSE_ANALYTICS_FLUSH_INTERVAL=3600
# Seconds analytics events are kept before expiry.
# @type=number
TYPESENSE_ANALYTICS_DB_TTL=2419200
# Max analytics events accepted per minute.
# @type=number
TYPESENSE_ANALYTICS_MINUTE_RATE_LIMIT=5
