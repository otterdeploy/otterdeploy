# Open WebUI 0.11.3 environment schema (@env-spec / varlock format).
#
# The compose pins ghcr.io/open-webui/open-webui:v0.11.3 (was the floating
# `main` tag; on 2026-09-04 `main` and `latest` both resolve to build
# revision 2a960a59, the same revision as v0.11.3, pushed 2026-08-31).
# This is the plain CPU variant. The `-cuda` / `-ollama` image variants are
# separate tags and are NOT what this template runs.
#
# Source: `os.getenv` reads across the app's own code at v0.11.3, in
# backend/open_webui/env.py and backend/open_webui/config.py (the two
# authoritative files), plus backend/start.sh (the container's CMD, which
# owns PORT/HOST and the secret-key bootstrap) and the Dockerfile ENV block
# (which bakes ENV=prod, PORT=8080, RAG_EMBEDDING_MODEL and the cache paths
# into the image). Cross-checked against the published configuration
# reference; the reference lags the code in places, e.g. it is
# `ENABLE_API_KEYS` (plural, default False) in 0.11, not the older
# singular `ENABLE_API_KEY`.
#
# ────────────────────────────────────────────────────────────────────────
# THE BIG ONE: most of these variables only SEED THE DATABASE ON FIRST BOOT.
#
# 0.11 stores configuration in a `config` table, one row per dotted key.
# config.py builds a DEFAULT_CONFIG mapping of ~400 dotted keys to values
# derived from the environment, and `Config.seed_defaults` inserts a row for
# every key that does not exist yet ("Existing DB values take precedence over
# defaults"). Afterwards `Config.get` reads the DB row, not the environment.
# So for those keys the env var is a first-boot seed only: changing it later
# and restarting has NO effect, and the admin UI is the place to change it.
# Every such key below is marked "SEEDS ONLY".
#
# The escape hatch is ENABLE_PERSISTENT_CONFIG=false, which makes
# `Config.get` return the environment-derived default and ignore the DB
# entirely. The whole config surface becomes env-driven again, and the
# admin settings screens stop being able to change it. OAuth keys are a
# special case: `oauth.*` is already non-persistent unless
# ENABLE_OAUTH_PERSISTENT_CONFIG=true.
#
# Keys read straight out of the process environment on every boot (secret
# key, cookies, database URL, storage provider, vector backend, ports,
# telemetry) are NOT persistent and behave the way an operator expects.
# ────────────────────────────────────────────────────────────────────────

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variable Configuration", https://docs.openwebui.com/reference/env-configuration)
# @docs("Quick Start", https://docs.openwebui.com/getting-started/quick-start/)
# ---

# ─── Core (set by this compose) ───────────────────────────────────────────

# Signs and verifies every session JWT (backend/open_webui/env.py). Read
# from the process environment on every boot, never persisted and never
# seeded into the database.
#
# If it is empty AND WEBUI_AUTH is on, the app used to exit with
# "WEBUI_SECRET_KEY is not set", but the container's CMD is start.sh, which
# first falls back to the file `.webui_secret_key` in the working directory
# and GENERATES one there if it is missing. That path is
# /app/backend/.webui_secret_key, which is NOT inside the persisted
# /app/backend/data volume: rebuild or recreate the container without this
# variable set and a brand-new key is minted, silently invalidating every
# existing session and logging everybody out. Set it here and that never
# happens.
#
# Treat it like a signing key, because it is one: anyone who learns it can
# forge a session token for any user id, including the admin, without a
# password. Use a long random value, do not reuse it across deployments,
# and rotating it logs everyone out by design.
# @required @sensitive
# @docs("WEBUI_SECRET_KEY", https://docs.openwebui.com/reference/env-configuration)
WEBUI_SECRET_KEY=${WEBUI_SECRET_KEY}

# PLATFORM-OWNED: the bundled Ollama sibling, never typed. The raw value is
# read fresh each boot (config.py normalizes the trailing slash), but it is
# then folded into OLLAMA_BASE_URLS, and THAT is what seeds the persistent
# `ollama.base_urls` row. So this URL only takes effect on first boot;
# afterwards the connection lives in Admin > Settings > Connections.
# @required @type=url
# @docs("Starting With Ollama", https://docs.openwebui.com/getting-started/quick-start/connect-a-provider/starting-with-ollama)
OLLAMA_BASE_URL=http://${{stack.ollama.HOST}}:11434

# Master authentication switch, read from the environment on every boot
# (env.py). The compose hardcodes it on and it should stay on.
#
# WEBUI_AUTH=False disables authentication ENTIRELY: there is no login
# screen, every request is treated as the single local admin, and anyone who
# can reach the published port has full admin over the instance, its chats,
# its API keys and its model connections. It also force-disables signup
# (config.py: `ENABLE_SIGNUP = False if not WEBUI_AUTH else ...`) and cannot
# be flipped back on for an instance that already has data without a
# reinstall. Only ever consider it on a network nobody else can reach.
# @required @type=boolean
# @docs("Security Hardening", https://docs.openwebui.com/getting-started/advanced-topics/hardening)
WEBUI_AUTH=True

# ─── Persistent-config behaviour ──────────────────────────────────────────

# Whether the `config` table is authoritative. True (the default) is the
# seed-once behaviour described in the header: the environment fills empty
# rows on first boot and is ignored from then on. Set to `false` to make
# every "SEEDS ONLY" variable below live again on each restart; the price
# is that the matching admin settings screens stop taking effect.
# @type=boolean
# @docs("Environment Variable Configuration", https://docs.openwebui.com/reference/env-configuration)
ENABLE_PERSISTENT_CONFIG=True

# `oauth.*` keys are exempt from persistence by default, so the OAuth block
# further down IS read from the environment on every boot. Set this to true
# only if you want identity-provider settings stored in and served from the
# database instead.
# @type=boolean
ENABLE_OAUTH_PERSISTENT_CONFIG=False

# Wipes the `config` table at startup, so the next boot re-seeds every key
# from the environment. Destructive: every setting an admin changed in the
# UI is lost. Useful exactly once, when moving an instance back to
# env-driven configuration.
# @type=boolean
RESET_CONFIG_ON_START=False

# ─── Server runtime ───────────────────────────────────────────────────────

# Port uvicorn binds inside the container, read by backend/start.sh and by
# the image's HEALTHCHECK. The image bakes 8080 and the compose exposes
# container port 8080 with no override: change this without changing the
# exposed port and both routing and the healthcheck break.
# @type=port
PORT=8080

# Bind address for uvicorn (backend/start.sh). 0.0.0.0 is what the container
# network needs; narrowing it makes the service unreachable from the proxy.
HOST=0.0.0.0

# The image bakes `prod`. In `dev` the FastAPI docs at /docs are exposed and
# CORS/reload behaviour changes; it also disables the production Ollama URL
# rewriting in config.py. Leave it as prod.
# @type=enum(dev, prod)
ENV=prod

# Root of everything on disk: SQLite database, uploads, vector store,
# embedding-model cache. The compose mounts the `open-webui-data` volume at
# /app/backend/data, which is this default resolved against the image's
# /app/backend workdir. Change it and the volume stops covering the data.
DATA_DIR=/app/backend/data

# Product name in the browser title, PWA manifest and the sign-in page.
WEBUI_NAME=Open WebUI

# SEEDS ONLY (`webui.url`). The instance's own external URL, used to build
# absolute links in webhooks, share links and OAuth redirects. Leave empty
# and Open WebUI infers it from the request, which is right behind a normal
# reverse proxy and wrong behind one that rewrites Host.
# @type=url
WEBUI_URL=

# Semicolon-separated list of origins allowed to call the API from a
# browser (config.py splits on `;`). The default `*` is permissive; if you
# embed Open WebUI or drive its API from another site, list those origins
# instead.
CORS_ALLOW_ORIGIN=*

# Number of uvicorn worker processes (backend/start.sh). More than one
# requires REDIS_URL and WEBSOCKET_MANAGER=redis, otherwise sessions,
# websocket delivery and the model-list cache are per-worker and users see
# replies stall or vanish.
# @type=number
# @docs("Scaling Open WebUI", https://docs.openwebui.com/getting-started/advanced-topics/scaling)
UVICORN_WORKERS=1

# Log level for the app's own loggers. Empty leaves Python's default (INFO).
# @type=enum(, DEBUG, INFO, WARNING, ERROR, CRITICAL)
# @docs("Logging", https://docs.openwebui.com/getting-started/advanced-topics/logging)
GLOBAL_LOG_LEVEL=

# Calls out to GitHub on boot and in the UI to compare the running version
# against the latest release. Turn off for an instance with no egress.
# @type=boolean
ENABLE_VERSION_UPDATE_CHECK=true

# Blocks every outbound fetch the app makes for its own assets: embedding
# and reranking model downloads from Hugging Face, the update check. The
# embedding model must already be in the image or the data volume, or RAG
# fails at first use.
# @type=boolean
# @docs("Offline Mode", https://docs.openwebui.com/tutorials/maintenance/offline-mode)
OFFLINE_MODE=false

# Disables all user-supplied Python (tools, functions, pipelines) at import
# time. A blunt but effective mitigation if you let untrusted admins
# install community tools.
# @type=boolean
SAFE_MODE=False

# Size of the thread pool that serves blocking work (vector search, file
# parsing). Empty uses Python's default (CPU count based).
# @type=number
THREAD_POOL_SIZE=

# gzip/brotli responses in-process. Turn off if your reverse proxy already
# compresses, to avoid doing the work twice.
# @type=boolean
ENABLE_COMPRESSION_MIDDLEWARE=True

# ─── Database, cache and websockets ───────────────────────────────────────

# SQLAlchemy URL. Empty means SQLite at DATA_DIR/webui.db, which is what
# this template runs. Point it at Postgres
# (`postgresql://user:pass@host:5432/db`) before you add a second worker or
# replica, which SQLite cannot serve. Migrating an existing instance means
# moving the data, not just changing this string.
# @sensitive
# @docs("Database", https://docs.openwebui.com/tutorials/maintenance/database)
DATABASE_URL=

# Connection pool size for a non-SQLite DATABASE_URL. Empty leaves
# SQLAlchemy's default.
# @type=number
DATABASE_POOL_SIZE=

# Runs Alembic migrations at startup. Leave on. 0.11.3 specifically fixed a
# bug where a failed migration let the app start half-upgraded and then
# report a missing column; it now stops at the migration error instead.
# @type=boolean
ENABLE_DB_MIGRATIONS=True

# Redis/Valkey URL. Optional for a single container; required the moment
# you run more than one worker or replica, for session state, the
# stop-generation signal and the shared model-list cache.
# @sensitive
# @docs("Redis Integration", https://docs.openwebui.com/tutorials/integrations/redis)
REDIS_URL=

# Set to `redis` to fan websocket events out through Redis instead of
# keeping them in one process. Mandatory for multi-worker or multi-replica;
# without it a reply streams only to whichever worker holds the socket.
# @type=enum(, redis)
# @docs("Multi-Replica Deployments", https://docs.openwebui.com/troubleshooting/multi-replica)
WEBSOCKET_MANAGER=

# Redis URL for the websocket manager specifically. Empty falls back to
# REDIS_URL.
# @sensitive
WEBSOCKET_REDIS_URL=

# Turning this off drops the app to polling; streaming replies, channels
# and live status updates stop working properly.
# @type=boolean
ENABLE_WEBSOCKET_SUPPORT=True

# ─── Accounts and sessions ────────────────────────────────────────────────

# SEEDS ONLY (`ui.enable_signup`). Whether the sign-up form is offered at
# all. Left on, ANYONE who can reach the URL can create an account, and with
# a public deployment that is how you end up hosting strangers' chats on your
# GPU. Turn it off once your own accounts exist, or leave DEFAULT_USER_ROLE
# at `pending` so new accounts cannot do anything until an admin approves
# them. Force-disabled whenever WEBUI_AUTH is off.
# @type=boolean
# @docs("Security Hardening", https://docs.openwebui.com/getting-started/advanced-topics/hardening)
ENABLE_SIGNUP=True

# Allows exactly the first account to be created even when signup is off,
# so you can close registration up front and still claim the admin account.
# @type=boolean
ENABLE_INITIAL_ADMIN_SIGNUP=False

# SEEDS ONLY (`ui.default_user_role`). Role assigned to a newly registered
# account. `pending` (the default) means the account can sign in but sees
# nothing until an admin promotes it, which is the safe setting. `user` grants
# immediate access to models; `admin` grants everything.
# @type=enum(pending, user, admin)
DEFAULT_USER_ROLE=pending

# SEEDS ONLY (`ui.enable_login_form`). Hides the email/password form so only
# OAuth/LDAP remain. Turning this off before your identity provider works
# locks everyone, including you, out of the instance.
# @type=boolean
ENABLE_LOGIN_FORM=True

# Asks for the password twice on the sign-up form.
# @type=boolean
ENABLE_SIGNUP_PASSWORD_CONFIRMATION=False

# SEEDS ONLY (`auth.jwt_expiry`). Session token lifetime, as a duration
# string (`4w`, `12h`, `30m`). `-1` means never expires. The app prints a
# security warning for that value, and it means a leaked token is valid
# forever.
JWT_EXPIRES_IN=4w

# Marks the session cookie `Secure` so browsers only send it over HTTPS.
# Turn on for any instance served over TLS. WEBUI_AUTH_COOKIE_SECURE covers
# the auth cookie specifically and falls back to this value.
# @type=boolean
WEBUI_SESSION_COOKIE_SECURE=false
# @type=boolean
WEBUI_AUTH_COOKIE_SECURE=false

# SameSite policy for the session cookie. `lax` is right for a normal
# deployment; `none` (which requires Secure) is only for embedding Open
# WebUI cross-origin.
# @type=enum(lax, strict, none)
WEBUI_SESSION_COOKIE_SAME_SITE=lax
# @type=enum(lax, strict, none)
WEBUI_AUTH_COOKIE_SAME_SITE=lax

# SEEDS ONLY (`auth.enable_api_keys`). Lets users mint long-lived API keys
# for the OpenAI-compatible endpoint. Default off in 0.11. Note the name
# is plural here, the older singular ENABLE_API_KEY is not read.
# @type=boolean
ENABLE_API_KEYS=False

# SEEDS ONLY. Restricts API keys to an allow-list of endpoints rather than
# the whole API. Worth turning on with the above.
# @type=boolean
ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS=False

# Creates an admin account on first boot without anyone visiting the UI, for
# headless provisioning. The password is used once, at creation; change it in
# the UI afterwards and clear these.
# @type=email
WEBUI_ADMIN_EMAIL=
# @sensitive
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Admin

# Trusts an upstream proxy to have authenticated the user and to pass the
# identity in these headers. ONLY set these if the proxy strips
# client-supplied copies of the same headers. Otherwise anyone can send
# the header themselves and become any user.
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=
WEBUI_AUTH_TRUSTED_NAME_HEADER=

# Enforces a minimum password policy on sign-up and password change.
# @type=boolean
ENABLE_PASSWORD_VALIDATION=False

# Password hashing algorithm for local accounts.
# @type=enum(bcrypt, argon2)
PASSWORD_HASH_ALGORITHM=bcrypt

# Encrypts tool/function "valve" values (which often hold third-party API
# keys) at rest using WEBUI_SECRET_KEY. Off by default for backwards
# compatibility; turning it on is a straight improvement.
# @type=boolean
ENABLE_VALVE_ENCRYPTION=False

# Admin visibility over other users' chats, and the admin export button.
# Both default on; turn them off where chats are considered private.
# @type=boolean
ENABLE_ADMIN_CHAT_ACCESS=True
# @type=boolean
ENABLE_ADMIN_EXPORT=True

# Lets every user address every model regardless of the per-model access
# groups. Convenient on a single-tenant box, a silent privilege escalation
# on a shared one.
# @type=boolean
BYPASS_MODEL_ACCESS_CONTROL=False

# Adds X-OpenWebUI-User-* headers to outbound model requests so an upstream
# gateway can attribute usage. It forwards the signed-in user's name and
# email to whatever endpoint you configured, so only enable it towards
# endpoints you trust.
# @type=boolean
ENABLE_FORWARD_USER_INFO_HEADERS=False

# ─── OAuth / OIDC / LDAP ──────────────────────────────────────────────────
# These `oauth.*` keys are read from the environment on EVERY boot unless
# ENABLE_OAUTH_PERSISTENT_CONFIG is turned on above.

# Creates an account the first time someone signs in through the identity
# provider. Without it, only pre-existing accounts can use SSO.
# @type=boolean
# @docs("SSO Tutorials", https://docs.openwebui.com/tutorials/auth-sso/)
ENABLE_OAUTH_SIGNUP=False

# Links an SSO login to an existing local account with the same email
# address. Only safe when the provider verifies email ownership; otherwise
# it is an account-takeover primitive.
# @type=boolean
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=False

# Generic OIDC provider. PROVIDER_URL is the discovery document
# (.well-known/openid-configuration); REDIRECT_URI must match what you
# registered with the provider.
OAUTH_CLIENT_ID=
# @sensitive
OAUTH_CLIENT_SECRET=
# @type=url
OPENID_PROVIDER_URL=
# @type=url
OPENID_REDIRECT_URI=
OAUTH_PROVIDER_NAME=SSO
OAUTH_SCOPES=openid email profile

# Comma-separated list of email domains allowed to sign in through OAuth.
# The default `*` accepts every domain the provider will authenticate,
# which for a public provider such as Google means the whole internet.
OAUTH_ALLOWED_DOMAINS=*

# Which claims Open WebUI reads off the ID token for the user's display
# name and email address.
OAUTH_USERNAME_CLAIM=name
OAUTH_EMAIL_CLAIM=email

# Maps provider roles/groups onto Open WebUI roles and groups. Enabling role
# management means the provider, not the admin screen, decides who is an
# admin.
# @type=boolean
ENABLE_OAUTH_ROLE_MANAGEMENT=False
# @type=boolean
ENABLE_OAUTH_GROUP_MANAGEMENT=False
OAUTH_ROLES_CLAIM=roles

# Google sign-in.
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPE=openid email profile

# Microsoft Entra ID sign-in. TENANT_ID is your directory id, or `common`
# for multi-tenant.
MICROSOFT_CLIENT_ID=
# @sensitive
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=

# GitHub sign-in.
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# SEEDS ONLY (`ldap.*`). Direct LDAP/AD bind as an alternative to OIDC. The
# app account below needs read access to the search base only.
# @type=boolean
ENABLE_LDAP=false
LDAP_SERVER_HOST=localhost
# @type=port
LDAP_SERVER_PORT=389
LDAP_APP_DN=
# @sensitive
LDAP_APP_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTERS=
# @type=boolean
LDAP_USE_TLS=True

# ─── Model providers ──────────────────────────────────────────────────────

# SEEDS ONLY (`ollama.enable`). Turns the whole Ollama integration off; the
# bundled sibling then just sits there.
# @type=boolean
# @docs("Starting With Ollama", https://docs.openwebui.com/getting-started/quick-start/connect-a-provider/starting-with-ollama)
ENABLE_OLLAMA_API=True

# SEEDS ONLY (`ollama.base_urls`). Semicolon-separated list, for talking to
# several Ollama hosts. Empty means "just OLLAMA_BASE_URL above".
OLLAMA_BASE_URLS=

# SEEDS ONLY (`openai.enable`). Whether the OpenAI-compatible client is
# active at all.
# @type=boolean
# @docs("Starting With OpenAI", https://docs.openwebui.com/getting-started/quick-start/connect-a-provider/starting-with-openai)
ENABLE_OPENAI_API=True

# Single OpenAI-compatible endpoint. The image bakes both as empty; an
# empty base URL resolves to https://api.openai.com/v1. Both are folded
# into the plural forms below, which are what seed the persistent
# `openai.api_keys` / `openai.api_base_urls` rows. Like the Ollama URL, these
# matter on first boot and are edited in Admin > Connections after.
# @sensitive
OPENAI_API_KEY=
# @type=url
OPENAI_API_BASE_URL=

# Semicolon-separated lists, for several OpenAI-compatible providers at
# once. Position N of the keys list pairs with position N of the URLs list.
# @sensitive
OPENAI_API_KEYS=
OPENAI_API_BASE_URLS=

# Google Gemini, read from the environment on every boot.
# @sensitive
GEMINI_API_KEY=
# @type=url
GEMINI_API_BASE_URL=

# SEEDS ONLY. Lets individual users attach their own model endpoints and
# API keys from their settings page. That means user-controlled outbound
# requests from the server; leave off on a shared instance.
# @type=boolean
ENABLE_DIRECT_CONNECTIONS=False

# SEEDS ONLY. Which model handles the background jobs (chat titles, tags,
# search-query rewriting). Pick a small cheap one. TASK_MODEL applies to
# Ollama models, TASK_MODEL_EXTERNAL to OpenAI-compatible ones. Empty uses
# the model of the current chat.
TASK_MODEL=
TASK_MODEL_EXTERNAL=

# SEEDS ONLY. The background jobs themselves. Each costs an extra model call
# per message; turn them off on constrained hardware.
# @type=boolean
ENABLE_TITLE_GENERATION=True
# @type=boolean
ENABLE_TAGS_GENERATION=True
# @type=boolean
ENABLE_AUTOCOMPLETE_GENERATION=False

# ─── RAG, embeddings and the vector store ─────────────────────────────────

# Which vector backend stores document embeddings. Read from the
# environment on every boot (not persisted), because the client is built at
# import time. `chroma` keeps everything on disk under DATA_DIR/vector_db,
# which is what this template's volume covers. Switching backends does not
# migrate existing embeddings; knowledge bases must be re-indexed.
# @type=enum(chroma, milvus, qdrant, pinecone, elasticsearch, opensearch, pgvector, mariadb-vector, oracle23ai, s3vector, weaviate, opengauss, valkey)
# @docs("Retrieval Augmented Generation", https://docs.openwebui.com/features/chat-conversations/rag/)
VECTOR_DB=chroma

# Remote Chroma, when VECTOR_DB=chroma and you do not want the embedded
# one. Empty host keeps it embedded on disk.
CHROMA_HTTP_HOST=
# @type=port
CHROMA_HTTP_PORT=8000
# @type=boolean
CHROMA_HTTP_SSL=false

# Common members of the other vector-backend families, for when VECTOR_DB
# points at one of them. Each backend has a longer set of tuning knobs in
# config.py; these are the ones you cannot start without.
# @type=url
QDRANT_URI=
# @sensitive
QDRANT_API_KEY=
# Empty reuses DATABASE_URL, so pgvector on the same Postgres needs nothing.
# @sensitive
PGVECTOR_DB_URL=
MILVUS_URI=
# @sensitive
MILVUS_TOKEN=
# @type=url
ELASTICSEARCH_URL=https://localhost:9200
# @sensitive
ELASTICSEARCH_API_KEY=
# @sensitive
PINECONE_API_KEY=
PINECONE_INDEX_NAME=open-webui-index

# SEEDS ONLY (`rag.embedding_engine`). Empty means the in-process
# sentence-transformers model: no external calls, but it downloads model
# weights on first use and does the work on the container's CPU. `ollama`
# sends embedding to the bundled sibling; `openai` / `azure_openai` send it
# to a hosted API.
# @type=enum(, ollama, openai, azure_openai)
RAG_EMBEDDING_ENGINE=

# SEEDS ONLY. The embedding model itself. The image bakes
# sentence-transformers/all-MiniLM-L6-v2 and pre-downloads it. Changing it
# invalidates every existing embedding: documents already in a knowledge
# base must be re-uploaded or re-indexed before RAG works again.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# SEEDS ONLY. How many chunks are embedded per request. Raise it for a
# hosted embedding API; the local model ignores the benefit.
# @type=number
RAG_EMBEDDING_BATCH_SIZE=1

# SEEDS ONLY. Credentials for the embedding engine when it is not the local
# one. Empty inherits OPENAI_API_KEY / OPENAI_API_BASE_URL / OLLAMA_BASE_URL.
# @sensitive
RAG_OPENAI_API_KEY=
# @type=url
RAG_OPENAI_API_BASE_URL=
# @type=url
RAG_OLLAMA_BASE_URL=
# @sensitive
RAG_OLLAMA_API_KEY=

# SEEDS ONLY. Retrieval shape: how many chunks are pulled into context, how
# they are cut, and the minimum similarity a chunk needs to be used at all
# (0.0 = no floor).
# @type=number
RAG_TOP_K=3
# @type=number
CHUNK_SIZE=1000
# @type=number
CHUNK_OVERLAP=100
# @type=number
RAG_RELEVANCE_THRESHOLD=0.0

# SEEDS ONLY. Hybrid BM25 + vector retrieval with a reranking pass. It is
# noticeably better and noticeably slower, and the reranker is another
# model to download and run.
# @type=boolean
ENABLE_RAG_HYBRID_SEARCH=false
# @type=enum(, external)
RAG_RERANKING_ENGINE=
RAG_RERANKING_MODEL=
# @type=number
RAG_TOP_K_RERANKER=3

# SEEDS ONLY. Skips retrieval entirely and pastes whole documents into the
# prompt. Only sane with a very large context window.
# @type=boolean
BYPASS_EMBEDDING_AND_RETRIEVAL=False

# SEEDS ONLY. Per-upload limits. Empty means no limit, which on a public
# instance means someone can fill the volume.
# @type=number
RAG_FILE_MAX_SIZE=
# @type=number
RAG_FILE_MAX_COUNT=

# SEEDS ONLY (`content_extraction.engine`). How text is pulled out of
# uploaded files. Empty uses the built-in Python extractors; the others
# hand the file to an external service, which must be reachable and which
# then sees the document contents.
# @type=enum(, tika, docling, document_intelligence, mistral_ocr, external, datalab_marker, mineru, paddleocr_vl)
# @docs("Document Extraction", https://docs.openwebui.com/features/chat-conversations/rag/document-extraction/)
CONTENT_EXTRACTION_ENGINE=

# SEEDS ONLY. Where those services live. The defaults are upstream's own
# compose hostnames and resolve to nothing in this stack, so set them to real
# addresses if you select the matching engine.
# @type=url
TIKA_SERVER_URL=http://tika:9998
# @type=url
DOCLING_SERVER_URL=http://docling:5001

# SEEDS ONLY. Runs OCR over images embedded in PDFs. Slow, occasionally
# worth it.
# @type=boolean
PDF_EXTRACT_IMAGES=False

# ─── Web search ───────────────────────────────────────────────────────────

# SEEDS ONLY (`web.search.enable`). Lets a chat fetch and read live web
# pages. This makes the SERVER issue outbound HTTP to addresses influenced
# by chat input, the class of bug that produced several SSRF advisories
# fixed in 0.11.1. Keep the instance patched if you turn this on.
# @type=boolean
# @docs("Web Search", https://docs.openwebui.com/features/chat-conversations/web-search)
ENABLE_WEB_SEARCH=False

# SEEDS ONLY. Which search backend. Empty means none is configured and web
# search stays off however the flag above is set. Each engine needs its own
# key below; the full list in routers/retrieval.py is longer than this and
# includes bing, exa, jina, kagi, linkup, mojeek, perplexity, yacy, yandex
# and youcom.
# @type=enum(, searxng, google_pse, brave, duckduckgo, tavily, serper, serpapi, serpstack, serply, serphouse, searchapi, firecrawl, exa, jina, kagi, mojeek, bing, perplexity, linkup, yacy, yandex, youcom, external)
WEB_SEARCH_ENGINE=

# SEEDS ONLY. How many results are fetched and read per query, and how many
# are fetched at once (0 = the engine's own default).
# @type=number
WEB_SEARCH_RESULT_COUNT=3
# @type=number
WEB_SEARCH_CONCURRENT_REQUESTS=0

# SEEDS ONLY. Self-hosted SearXNG; the URL must include the `<query>`
# placeholder, e.g. http://searxng:8080/search?q=<query>&format=json
# @docs("SearXNG", https://docs.openwebui.com/features/chat-conversations/web-search/providers/searxng)
SEARXNG_QUERY_URL=

# SEEDS ONLY. Hosted search providers: supply the key for whichever engine
# you selected above.
# @sensitive
# @docs("Tavily", https://docs.openwebui.com/features/chat-conversations/web-search/providers/tavily)
TAVILY_API_KEY=
# @sensitive
# @docs("Brave Search", https://docs.openwebui.com/features/chat-conversations/web-search/providers/brave)
BRAVE_SEARCH_API_KEY=
# Google Programmable Search needs both the API key and the engine id.
# @sensitive
# @docs("Google PSE", https://docs.openwebui.com/features/chat-conversations/web-search/providers/google-pse)
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_ENGINE_ID=
# @sensitive
# @docs("Serper", https://docs.openwebui.com/features/chat-conversations/web-search/providers/serper)
SERPER_API_KEY=
# @sensitive
SERPAPI_API_KEY=
# @sensitive
FIRECRAWL_API_KEY=

# SEEDS ONLY. How the pages found are then fetched and rendered. Empty uses
# a plain HTTP fetch; `playwright` drives a real browser, which handles
# JavaScript pages and needs PLAYWRIGHT_WS_URL pointing at a browser
# service. The Playwright loader was the subject of a DNS-rebinding SSRF
# advisory fixed in 0.11.1.
# @type=enum(, safe_web, playwright, firecrawl, tavily, external, microsoft_web_iq)
WEB_LOADER_ENGINE=
PLAYWRIGHT_WS_URL=

# SEEDS ONLY. Verifies TLS certificates when fetching pages. Turning it off
# to scrape one broken site turns it off for every fetch.
# @type=boolean
ENABLE_WEB_LOADER_SSL_VERIFICATION=True

# SEEDS ONLY. Has the model rewrite the user's message into a search query
# before searching. Costs one extra model call per search.
# @type=boolean
ENABLE_SEARCH_QUERY_GENERATION=True

# ─── Code execution ───────────────────────────────────────────────────────

# SEEDS ONLY (`code_execution.*` / `code_interpreter.*`). Two related
# features: the "run" button on a code block, and the code interpreter the
# model can call on its own.
#
# With the default engine `pyodide` the code runs as WebAssembly in the
# USER'S BROWSER, not on your server. That is the safe configuration and
# why these default on. Switching either to `jupyter` sends model-authored
# code to a Jupyter server to execute for real; anything that server can
# reach on your network, the model can now reach, and prompt injection in a
# pasted document is enough to steer it. Only point it at a sandboxed,
# network-isolated kernel.
# @type=boolean
# @docs("Python Code Execution", https://docs.openwebui.com/features/chat-conversations/chat-features/code-execution/python)
ENABLE_CODE_EXECUTION=True
# @type=enum(pyodide, jupyter)
CODE_EXECUTION_ENGINE=pyodide
# @type=boolean
ENABLE_CODE_INTERPRETER=True
# @type=enum(pyodide, jupyter)
CODE_INTERPRETER_ENGINE=pyodide

# SEEDS ONLY. The Jupyter server, used only when an engine above is
# `jupyter`. AUTH selects the scheme; supply the matching token or password.
# CODE_INTERPRETER_JUPYTER_URL falls back to CODE_EXECUTION_JUPYTER_URL.
# @type=url
CODE_EXECUTION_JUPYTER_URL=
# @type=enum(, token, password)
CODE_EXECUTION_JUPYTER_AUTH=
# @sensitive
CODE_EXECUTION_JUPYTER_AUTH_TOKEN=
# @sensitive
CODE_EXECUTION_JUPYTER_AUTH_PASSWORD=
# @type=number
CODE_EXECUTION_JUPYTER_TIMEOUT=60
# @type=url
CODE_INTERPRETER_JUPYTER_URL=

# ─── File storage ─────────────────────────────────────────────────────────

# Where uploaded files are kept. Read from the environment on every boot;
# the provider object is built at import time, so this is never persisted.
# `local` writes into the data volume, which is what this template's
# open-webui-data volume covers. Switching to object storage does not move
# files that are already local.
# @type=enum(local, s3, gcs, azure)
# @docs("S3 Storage", https://docs.openwebui.com/tutorials/maintenance/s3-storage)
STORAGE_PROVIDER=local

# Keeps a local copy of remote objects to avoid re-downloading on every
# read. Costs disk in exchange for latency.
# @type=boolean
STORAGE_LOCAL_CACHE=true

# S3 or any S3-compatible endpoint (MinIO, R2, Spaces), when
# STORAGE_PROVIDER=s3. Leave the endpoint empty for real AWS. Leave the
# access keys empty to use an instance role instead.
S3_BUCKET_NAME=
S3_REGION_NAME=
# @sensitive
S3_ACCESS_KEY_ID=
# @sensitive
S3_SECRET_ACCESS_KEY=
# @type=url
S3_ENDPOINT_URL=
S3_KEY_PREFIX=
# Non-AWS S3 implementations usually need `path` rather than virtual-host
# addressing.
# @type=enum(, path, virtual)
S3_ADDRESSING_STYLE=

# Google Cloud Storage, when STORAGE_PROVIDER=gcs. The credentials variable
# takes the service-account JSON inline, on one line.
GCS_BUCKET_NAME=
# @sensitive
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Azure Blob Storage, when STORAGE_PROVIDER=azure. Leave the key empty to
# authenticate with a managed identity instead.
# @type=url
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONTAINER_NAME=
# @sensitive
AZURE_STORAGE_KEY=

# ─── Audio and images ─────────────────────────────────────────────────────

# SEEDS ONLY (`audio.stt.*`). Speech to text. Empty runs faster-whisper
# locally on the CPU, which is slow but private; `openai` sends the audio
# to a hosted API. WHISPER_MODEL selects the local model size and the image
# caches it under the data volume.
# @type=enum(, openai, azure, deepgram, mistral)
# @docs("Speech to Text", https://docs.openwebui.com/features/chat-conversations/audio)
AUDIO_STT_ENGINE=
WHISPER_MODEL=base
# @sensitive
AUDIO_STT_OPENAI_API_KEY=

# SEEDS ONLY (`audio.tts.*`). Text to speech. Empty uses the browser's own
# voices, with no server-side work and no data leaving the browser.
# @type=enum(, openai, azure, elevenlabs, transformers, mistral)
AUDIO_TTS_ENGINE=
# @sensitive
AUDIO_TTS_OPENAI_API_KEY=

# SEEDS ONLY (`image_generation.*`). Image generation from chat. Off by
# default; the engine decides where the prompt goes, and both ComfyUI and
# AUTOMATIC1111 are self-hosted services you point at by URL.
# @type=boolean
# @docs("Image Generation", https://docs.openwebui.com/features/chat-conversations/image-generation-and-editing)
ENABLE_IMAGE_GENERATION=
# @type=enum(openai, comfyui, automatic1111, gemini)
IMAGE_GENERATION_ENGINE=openai
# @sensitive
IMAGES_OPENAI_API_KEY=
# @type=url
COMFYUI_BASE_URL=
# @type=url
AUTOMATIC1111_BASE_URL=

# ─── Features, webhooks and telemetry ─────────────────────────────────────

# SEEDS ONLY. Channels (the Slack-like side of Open WebUI) and Notes. Both
# add API surface; channels in particular carry per-member permissions that
# have been the subject of access-control advisories.
# @type=boolean
ENABLE_CHANNELS=False
# @type=boolean
ENABLE_NOTES=True

# SEEDS ONLY. Thumbs up/down on replies, and the arena comparison models.
# @type=boolean
ENABLE_MESSAGE_RATING=True
# @type=boolean
ENABLE_EVALUATION_ARENA_MODELS=True

# SEEDS ONLY. Global webhook posted on events such as a new user signing
# up. ENABLE_USER_WEBHOOKS lets individual users register their own, which
# means user-controlled outbound requests from the server.
# @type=url
WEBHOOK_URL=
# @type=boolean
ENABLE_USER_WEBHOOKS=False

# OpenTelemetry traces and metrics. The endpoint default points at a
# collector on localhost, which does not exist in this stack. Set it to a
# real collector before enabling.
# @type=boolean
# @docs("OpenTelemetry", https://docs.openwebui.com/reference/monitoring/otel)
ENABLE_OTEL=False
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Enterprise licence key. Empty runs the normal open-source build.
# @sensitive
LICENSE_KEY=

# User-Agent Open WebUI sends on its own outbound fetches (web search, model
# APIs). Empty uses the library default.
USER_AGENT=
