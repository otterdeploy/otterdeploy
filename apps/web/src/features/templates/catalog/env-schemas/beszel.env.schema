# Beszel v0.18.8 (hub) — environment schema (@env-spec / varlock format).
#
# Source: grep of utils.GetEnv / os.LookupEnv across internal/ (the hub
# binary) at v0.18.8. Every hub variable may also be written with a
# BESZEL_HUB_ prefix; the prefixed form wins when both are set. The agent's
# own variables (HUB_URL, TOKEN, KEY, ...) live in a separate binary that
# this template does not run.
#
# Docs and code agree on the hub's list. Two things worth knowing that the
# docs table does not say: USER_EMAIL / USER_PASSWORD are read ONLY by the
# initial-settings migration, so they do nothing once the data volume
# exists; and CONTAINER_DETAILS is on unless it is the literal string
# "false" (any other value, including "0", keeps it enabled).

# @defaultSensitive=false @defaultRequired=infer
# @docs("Beszel environment variables", https://beszel.dev/guide/environment-variables)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The public URL you open Beszel at. Written into PocketBase's Meta.AppURL at
# every boot, so links in alert emails and notifications are built from it.
# Also required if you serve the hub at a subpath. Not platform-derived in
# this compose: it is prompted at install and rendered from ${APP_URL}.
# @required @type=url
# @docs("Serving behind a reverse proxy", https://beszel.dev/guide/reverse-proxy)
APP_URL=

# Creates the superuser AND a regular user with these credentials on first
# boot only. Leave both empty and Beszel prints a one-time setup link in the
# container logs instead. Setting just one of the two creates nothing usable.
# @type=email
USER_EMAIL=
# @sensitive
USER_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────────────────

# Email address of a user to authenticate every request as. This bypasses
# login entirely; only for a single-user hub that is already protected upstream.
# @type=email
# @docs("User accounts", https://beszel.dev/guide/user-accounts)
AUTO_LOGIN=

# Name of a request header your proxy sets to the authenticated user's email
# (e.g. Cf-Access-Authenticated-User-Email). Same warning as AUTO_LOGIN.
TRUSTED_AUTH_HEADER=

# "true" turns off email + password login on the users collection so only
# OAuth/OIDC providers remain. Does not touch the PocketBase superuser login.
# @type=boolean
# @docs("OAuth / OIDC", https://beszel.dev/guide/oauth)
DISABLE_PASSWORD_AUTH=false

# "true" lets an OAuth/OIDC sign-in create a new user record on the fly.
# @type=boolean
USER_CREATION=false

# Email one-time-password MFA. "true" enables it for users and superusers,
# "superusers" only for the PocketBase admin login. Needs SMTP configured in
# the PocketBase settings first, or nobody can log in.
# @type=enum(false, true, superusers)
MFA_OTP=false

# "true" runs the OAuth flow in the same window instead of a popup; needs the
# hub's base URL registered as an extra redirect URI at the provider.
# @type=boolean
OAUTH_DISABLE_POPUP=false

# "true" makes every system readable by every authenticated user (non-readonly
# users can also edit or delete them). Default scopes systems to their members.
# @type=boolean
SHARE_ALL_SYSTEMS=false

# ─── Heartbeat ───────────────────────────────────────────────────────────

# Outbound dead-man's-switch ping (Healthchecks, Uptime Kuma, ...). Empty
# disables the feature. When set, the heartbeat settings page goes read-only.
# @type=url
# @docs("Heartbeat monitoring", https://beszel.dev/guide/heartbeat)
HEARTBEAT_URL=
# Seconds between pings. Non-numeric or <= 0 silently falls back to 60.
# @type=number
HEARTBEAT_INTERVAL=60
# GET and HEAD send a bare request; POST sends the JSON status summary.
# @type=enum(POST, GET, HEAD)
HEARTBEAT_METHOD=POST

# ─── Misc ────────────────────────────────────────────────────────────────

# "true" lets the hub poll GitHub for a newer release and show a badge.
# @type=boolean
CHECK_UPDATES=false

# Container inspect + logs endpoints in the web UI. Only the literal "false"
# disables them.
# @type=boolean
CONTAINER_DETAILS=true

# If set, sent verbatim as a Content-Security-Policy header on the SPA and
# X-Frame-Options is dropped, which is how you embed Beszel in an iframe.
CSP=
