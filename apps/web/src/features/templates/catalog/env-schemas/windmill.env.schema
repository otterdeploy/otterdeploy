# Windmill 1.798.1 environment schema (@env-spec / varlock format).
#
# The compose previously ran ghcr.io/windmill-labs/windmill:main, the
# development branch, rebuilt daily and never a release. It now pins
# 1.798.1 (released 2026-08-27) on BOTH the server and the worker; the
# image is the same binary in both places and MODE picks the role.
#
# Source: grep of `std::env::var("…")` across backend/ at tag v1.798.1
# (windmill-common, windmill-worker, windmill-api*, windmill-queue,
# windmill-object-store, src/main.rs, src/monitor.rs), cross-checked against
# `print_help()` in backend/src/main.rs (the only in-tree reference list) and
# against upstream's own docker-compose.yml at the same tag.
#
# ── READ THIS BEFORE EXPOSING THE SERVER ───────────────────────────────────
# Windmill exists to run arbitrary user-supplied Python / TypeScript / Go /
# Bash / SQL. Anyone who can log in can execute code as the worker process.
# In this OSS image job sandboxing is OFF by default (DISABLE_NSJAIL defaults
# to TRUE in windmill-worker/src/worker.rs, and neither unshare flag is on),
# so a script runs unconfined inside the worker container with that
# container's filesystem, network and credentials, including DATABASE_URL.
# An internet-reachable instance with a weak or default login is remote code
# execution on this host. Consequences of that:
#   * Change the seeded admin password on the very first visit. Migration
#     20220123221903_first seeds `admin@windmill.dev`, and the API still
#     checks for its stock argon2 hash of `changeme`
#     (windmill-api-users/src/users.rs) to warn you it was never rotated.
#   * NO_AUTH and SUPERADMIN_SECRET below both hand out superadmin. They are
#     left empty on purpose and are NOT marked @required. An empty value is
#     the safe state and the only one this template ships.
#   * Put the server behind TLS and, ideally, an authenticating proxy. The
#     worker publishes no port and should never be exposed.
#
# Two more honesty notes. (1) Most of Windmill's configuration lives in the
# database (Superadmin settings → Instance settings), not here; the ~90 names
# in `ENV_SETTINGS` (windmill-common/src/global_settings.rs) are the subset an
# env var can override, and env wins over the DB row for those. (2) A large
# share of what upstream documents (SSO/SAML, instance object storage, the
# indexer, agent workers, multiplayer) is Enterprise-only and inert in this
# image; where that is true it is said on the key.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Self-host Windmill", https://www.windmill.dev/docs/advanced/self_host)
# ---

# ─── Role & process ────────────────────────────────────────────────────────

# Which role this container plays; the single most important variable in the
# stack, since server and worker run the SAME image. The compose sets
# `server` on the server service and `worker` on the worker service. Only
# `standalone`, `server`, `worker` and `mcp` work in this OSS image: `agent`
# and `indexer` panic at startup because they need the EE build (agent) or a
# tantivy-enabled build (indexer). Anything unrecognised silently falls back
# to `standalone`. Do not change this per-service value; the stack's routing
# and volumes assume it.
# @required
# @type=enum(standalone, server, worker, agent, indexer, mcp)
# @docs("Instance settings", https://www.windmill.dev/docs/advanced/instance_settings)
MODE=server

# Log filter for the Rust `tracing` subscriber, set to `info` by the compose
# on both services. The bare words `debug` and `info` are rewritten to
# `windmill=<level>` so they do not drown you in dependency logs; `sqlxdebug`
# expands to `windmill=debug,sqlx=debug`. Anything else is passed through as a
# raw EnvFilter directive. Unset, main.rs forces `info`.
RUST_LOG=info

# Emit logs as JSON objects instead of logfmt. Useful in front of a log
# shipper, noisy in a terminal.
# @type=boolean
JSON_FMT=false

# ─── Public URL ────────────────────────────────────────────────────────────

# The instance's public base URL, prompted for by this template and threaded
# into BASE_URL below. Windmill builds webhook URLs, e-mail links and OAuth
# redirect URIs from it, so a wrong value produces an instance that looks
# healthy and hands out links nobody can reach. Include the scheme and no
# trailing slash, e.g. https://windmill.example.com.
# @required
# @type=url
WINDMILL_BASE_URL=

# What the server actually reads. Present in `ENV_SETTINGS`, so this env var
# overrides the `base_url` row in the database; leaving it unset falls back to
# http://localhost:8000, which breaks every generated link. The worker does
# not need it: since 1.7xx BASE_INTERNAL_URL is ignored outside agent mode and
# workers reach the server over the stack network.
# @type=url
BASE_URL=${WINDMILL_BASE_URL}

# Domain written on the session cookie. Set it only when several hostnames
# must share one session (e.g. an apex plus a subdomain); leaving it empty
# scopes the cookie to the exact host, which is the safer default.
COOKIE_DOMAIN=

# Extra `Content-Security-Policy` header value served by the API. Empty means
# Windmill sends none and you rely on your reverse proxy.
CSP_POLICY=

# ─── Ports & binding ───────────────────────────────────────────────────────

# HTTP port for server / indexer / mcp modes. The compose exposes container
# port 8000 with no override, so this is that port's twin. Change one without
# the other and routing breaks. `BACKEND_PORT` is read as a fallback. In
# worker mode the port defaults to 0 (no listener).
# @type=port
PORT=8000
# @type=port
BACKEND_PORT=

# Address the HTTP listener binds to. Defaults to 0.0.0.0 in server mode and
# 127.0.0.1 in worker mode, which is what the container network needs; only
# set this if you know why.
SERVER_BIND_ADDR=

# Runs the API off in an otherwise server/standalone container, the escape
# hatch for a "standalone" process that should only drain the queue. Keep
# false here; MODE already separates the two services.
# @type=boolean
DISABLE_SERVER=false

# ─── Database ──────────────────────────────────────────────────────────────

# Connection string for the bundled Postgres, assembled by the platform from
# POSTGRES_PASSWORD and the db service's hostname. Both the server and the
# worker connect directly to Postgres: Windmill's queue IS the database, and
# there is no broker in between. Anything holding this string can read every
# secret, token and job result in the instance.
# @required
# @sensitive
DATABASE_URL=postgres://windmill:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/windmill?sslmode=disable

# Read the connection string from a file instead (a mounted docker/k8s
# secret). Takes precedence over DATABASE_URL when the file exists.
DATABASE_URL_FILE=

# Max size of the sqlx connection pool. Unset, the server takes 50 and a
# worker takes 5 + (NUM_WORKERS - 1). Raise both this and Postgres'
# max_connections together, or the second service to start is refused.
# @type=number
DATABASE_CONNECTIONS=

# Non-default Postgres `search_path` schema to install Windmill's tables in.
# Only for sharing a database with something else; leave empty for `public`.
PG_SCHEMA=

# "true" skips running the sqlx migrations at startup. Only correct when
# another replica has already migrated the same database and you are avoiding
# the advisory-lock wait; a stale schema otherwise fails at query time.
# @type=boolean
SKIP_MIGRATION=false

# ─── Bundled Postgres ──────────────────────────────────────────────────────

# Role Windmill connects as, created by the postgres:16-alpine image on first
# boot. It is baked into DATABASE_URL above; changing it here alone only
# breaks the pair. Upstream's own compose has moved to postgres:18, but 16 is
# supported until Nov 2028 and an in-place major upgrade requires a full
# pg_dumpall, so do not bump the image under a live volume.
POSTGRES_USER=windmill

# Password for that role, used by both the database container and
# DATABASE_URL, and prompted for by this template
# (`openssl rand -base64 24`). Reachable only on the stack's private network,
# but it is nonetheless the master key to every Windmill secret.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot; the name in DATABASE_URL must match.
POSTGRES_DB=windmill

# ─── Secrets & crypto ──────────────────────────────────────────────────────

# Extra salt mixed into the per-workspace MagicCrypt key that encrypts
# Windmill secrets (windmill-common/src/variables.rs). Optional, and it is a
# one-way door: set it after secrets exist and every stored secret becomes
# undecryptable, remove it later and the same happens. Choose it before first
# boot or never.
# @sensitive
SECRET_SALT=

# ─── Authentication & access control ───────────────────────────────────────
# Windmill's own login is username/password against the `password` table;
# OAuth and SSO providers are configured from the UI (Superadmin settings →
# SSO), not from environment variables, and SAML/OIDC are Enterprise-only.

# DANGER. "true"/"1" disables authentication entirely: every API request is
# answered as the `admin@windmill.dev` superadmin and no login is ever asked
# for (windmill-api-auth/src/auth.rs `is_no_auth`). Since Windmill runs
# arbitrary code, an instance with this on and any network path to it is an
# unauthenticated remote shell on this host. It exists for deployments that
# put a real authenticating gateway in front and never expose port 8000
# directly. Leave it empty.
# @type=boolean
# @docs("Authentication", https://www.windmill.dev/docs/core_concepts/authentication)
NO_AUTH=

# A bearer token that, when presented, authenticates as a virtual superadmin
# (`superadmin_secret@windmill.dev`) with no user record and no password
# check. Intended for machine bootstrap; it is a permanent, non-rotating,
# non-revocable master credential, and GHSA-24fr-44f8-fqwg (fixed in 1.603.3,
# long before this pin) was about it being readable through an RCE. Leave it
# empty unless you have a specific automation that needs it, and treat it as
# equal in value to DATABASE_URL if you do.
# @sensitive
SUPERADMIN_SECRET=

# Restricts which providers can be wired up from the UI and how a login e-mail
# is matched; empty means no domain restriction.
# @docs("Setup OAuth and SSO", https://www.windmill.dev/docs/advanced/setup_oauth)
LOGIN_DOMAIN=

# "true" refuses to auto-create an account for an OAuth/SSO identity that has
# no pre-existing Windmill user. On a public SSO tenant this is the difference
# between inviting people and letting anyone with a provider account in.
# @type=boolean
REQUIRE_PREEXISTING_USER_FOR_OAUTH=false

# Whether creating a workspace needs superadmin. Note the default is TRUE
# (windmill-api-workspaces: `Err(_) => true`). Only an explicit "false" opens
# workspace creation to ordinary users.
# @type=boolean
CREATE_WORKSPACE_REQUIRE_SUPERADMIN=true

# Lifetime of a login session in seconds; default 3 days.
# @type=number
MAX_SESSION_VALIDITY_SECONDS=259200

# "true" invalidates a user's older sessions when they log in again.
# @type=boolean
INVALIDATE_OLD_SESSIONS=false

# Login attempts allowed per minute, per client IP. The IP comes from
# `x-real-ip` / `x-forwarded-for`, so it only means anything behind a proxy
# you trust to set those.
# @type=number
LOGIN_RATE_LIMIT_PER_IP=120
# Login attempts allowed per minute for one account, regardless of source.
# @type=number
LOGIN_RATE_LIMIT_PER_ACCOUNT=30
# Instance-wide ceiling on login attempts per minute.
# @type=number
LOGIN_RATE_LIMIT_GLOBAL=10000

# Hides the workers list from non-superadmins. Worker names leak hostnames and
# worker-group topology.
# @type=boolean
HIDE_WORKERS_FOR_NON_ADMINS=false

# ─── Workers & queues ──────────────────────────────────────────────────────

# Which worker group this container joins; the compose sets `default` on the
# worker service. The group is what a worker's tags and its per-group config
# (Superadmin settings → Workers) are keyed on, and `default` is the group
# that picks up the built-in tags. Scale the worker service to add capacity;
# give a second worker service a different group only if you also give it
# tags.
# @docs("Workers and worker groups", https://www.windmill.dev/docs/core_concepts/worker_groups)
WORKER_GROUP=default

# Comma-separated queue tags this worker pulls. Empty means the built-in
# default set (python3, deno, go, bash, ...). Tags are how you route heavy or
# privileged jobs to specific workers.
WORKER_TAGS=

# Same, but ignores the group's tags configured in the database instead of
# merging with them. The blunt instrument; use WORKER_TAGS first.
FORCE_WORKER_TAGS=

# Extra tag names the server offers in script/flow editors, comma-separated.
# Declaring a tag no worker pulls parks those jobs in the queue forever.
CUSTOM_TAGS=

# Worker threads inside one container. Anything above 1 is refused and reset
# to 1 unless NATIVE_MODE is on, because non-native jobs share one filesystem
# and cache; scale the service's replicas instead. Native mode forces 8.
# @type=number
NUM_WORKERS=1

# Turns this worker into a native-only worker: in-process jobs (HTTP steps,
# NativeTS, SQL) with no subprocess and no dependency install. Much lighter,
# but it cannot run ordinary scripts.
# @type=boolean
NATIVE_MODE=false

# Milliseconds a worker sleeps when it finds the queue empty. Defaults to
# 50 * NUM_WORKERS / 2. Lower means snappier pickup and more Postgres load.
# @type=number
SLEEP_QUEUE=

# Pins this worker to one script as a hot dedicated worker, as
# `<workspace>:<script/path>`. High-throughput setups only, and the worker
# then serves nothing else.
# @docs("Dedicated workers / High throughput", https://www.windmill.dev/docs/core_concepts/dedicated_workers)
DEDICATED_WORKER=

# Replaces the random suffix in the worker's name, which is what lets a
# restarted process reclaim its `worker_ping` row instead of registering as a
# new worker. Two worker processes must never share one.
WORKER_SUFFIX=

# Keeps the per-job working directory under /tmp/windmill after the job ends.
# For debugging one job; it will fill the volume.
# @type=boolean
KEEP_JOB_DIR=false

# Hard ceiling on a job's runtime in seconds. Self-hosted default is 604800
# (7 days), i.e. effectively none: a runaway script holds a worker until
# someone notices.
# @type=number
TIMEOUT=604800

# Seconds without a ping before a running job is declared a zombie.
# @type=number
ZOMBIE_JOB_TIMEOUT=60

# Whether zombie jobs are re-queued (true) rather than failed. Default true.
# @type=boolean
RESTART_ZOMBIE_JOBS=true

# Seconds a synchronous `/run_wait_result` request will block before giving
# up. Keep it under your reverse proxy's own read timeout.
# @type=number
TIMEOUT_WAIT_RESULT=

# Largest job result Windmill will store, in MB. Bigger results are rejected
# rather than silently truncated.
# @type=number
MAX_RESULT_SIZE_MB=500

# Exits the worker process after this many jobs so the supervisor restarts it
# on a clean container. The poor man's isolation for deployments that cannot
# run nsjail. Pair it with `restart: always` and NUM_WORKERS=1. 0/unset
# disables it, and an unparseable value is rejected at startup rather than
# read as "off".
# @type=number
EXIT_AFTER_N_JOBS=

# Comma-separated names of the worker's own environment variables that jobs
# are allowed to read. Empty means jobs see none of them, which is what keeps
# DATABASE_URL out of user scripts; every name you add here is handed to
# arbitrary code.
WHITELIST_ENVS=

# A bash script run once when the worker starts, before it takes any job.
# The place to install system packages a worker group needs. It runs as the
# container's user with no sandbox.
INIT_SCRIPT=

# ─── Job isolation ─────────────────────────────────────────────────────────
# The security boundary between a user script and this container. Read the
# defaults carefully: in this image there is effectively none out of the box.

# Whether nsjail sandboxing is off. Note the default is TRUE
# (windmill-worker/src/worker.rs). Jobs run unsandboxed unless you set this
# to "false" AND the nsjail binary is present, which it is not in the plain
# OSS image. Treat every Windmill user as having shell in the worker.
# @type=boolean
# @docs("Security and process isolation", https://www.windmill.dev/docs/advanced/security_isolation)
DISABLE_NSJAIL=true

# Disables the per-job unprivileged user mapping used by nsjail. Only
# meaningful when nsjail is actually enabled.
# @type=boolean
DISABLE_NUSER=false

# Uses `unshare --pid --mount-proc` to give each job its own PID namespace,
# lighter than nsjail and the isolation upstream's compose recommends. It
# needs `privileged: true` on the worker service, which this template does not
# set, so turning it on alone will not work.
# @type=boolean
ENABLE_UNSHARE_PID=false

# Prefers unshare-based isolation when the database-level isolation setting is
# undefined. Same privileged-mode caveat as above.
# @type=boolean
FAVOR_UNSHARE_PID=false

# ─── Object storage (S3) ───────────────────────────────────────────────────
# Windmill's per-workspace S3 storage is configured from the UI. These env
# vars cover the separate *shared dependency cache* bucket, plus the ambient
# AWS settings the object-store client falls back to.

# Bucket used to share resolved dependency caches between workers, so a new
# worker does not rebuild every virtualenv from scratch. Setting it is what
# switches the feature on; it is refused on the EE Pro plan and does nothing
# without S3 credentials the container can resolve.
# @docs("Object storage in Windmill (S3)", https://www.windmill.dev/docs/core_concepts/object_storage_in_windmill)
S3_CACHE_BUCKET=

# Endpoint host for a non-AWS S3 (MinIO, R2, Ceph). Defaults to
# s3.<AWS_REGION>.amazonaws.com. Host only, no scheme.
S3_ENDPOINT=

# Region for the cache bucket and the fallback endpoint. Defaults to
# us-east-1.
AWS_REGION=us-east-1

# Standard AWS credentials. Windmill's own code never reads these; the
# object_store / aws-sdk default credential chain does, which is how the cache
# bucket authenticates when no explicit keys are configured in the UI. Leave
# empty on an instance role.
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=

# "true" turns the whole S3/parquet store off, including anything configured
# in the database.
# @type=boolean
DISABLE_S3_STORE=false

# Seconds between pulls/pushes of the shared dependency cache. Default 600.
# @type=number
GLOBAL_CACHE_INTERVAL=600

# ─── SMTP ──────────────────────────────────────────────────────────────────
# Used for user invites, password resets and critical alerts. Read only when
# no SMTP block is configured in the database, and SMTP_HOST is what switches
# the env path on. Without it Windmill logs "SMTP not configured" and every
# invite has to be delivered by hand.

# Mail server hostname; its presence enables the whole block.
# @docs("Instance settings", https://www.windmill.dev/docs/advanced/instance_settings)
SMTP_HOST=
# @type=port
SMTP_PORT=587
SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=
# Envelope sender. Defaults to noreply@getwindmill.com, which will be rejected
# or spam-filed by most receivers, so set your own.
# @type=email
SMTP_FROM=
# "true" for implicit TLS (SMTPS, usually port 465) instead of STARTTLS.
# @type=boolean
SMTP_TLS_IMPLICIT=false
# "true" sends mail in the clear. Only for a mail relay on the same private
# network.
# @type=boolean
SMTP_DISABLE_TLS=false

# ─── Enterprise ────────────────────────────────────────────────────────────

# Enterprise licence key. This template runs the OSS image, where it does
# nothing; the EE features (SSO/SAML, instance object storage, the indexer,
# agent workers, multiplayer) also need ghcr.io/windmill-labs/windmill-ee.
# @sensitive
# @docs("Plans details", https://www.windmill.dev/docs/misc/plans_details)
LICENSE_KEY=

# ─── Webhooks & error handling ─────────────────────────────────────────────

# URL POSTed on instance-level events (user created, workspace created, ...).
INSTANCE_EVENTS_WEBHOOK=
# URL POSTed when a new user is created; the hook used to provision accounts
# in an external system.
NEW_USER_WEBHOOK=
# Path of a script in the `admins` workspace run whenever any job fails
# anywhere on the instance, as `u/user/script` or `f/folder/script`.
GLOBAL_ERROR_HANDLER_PATH_IN_ADMINS_WORKSPACE=

# ─── Metrics ───────────────────────────────────────────────────────────────

# Address to serve Prometheus metrics on at /metrics; "true" means :8001.
# Enterprise-only: on this OSS image the endpoint is not served. `METRICS_PORT`
# is also read, only to decide whether metrics are considered enabled.
# @docs("Instance settings", https://www.windmill.dev/docs/advanced/instance_settings)
METRICS_ADDR=
# @type=port
METRICS_PORT=

# ─── Outbound network & TLS ────────────────────────────────────────────────

# Standard proxy variables, honoured for Windmill's own outbound HTTP
# (hub fetches, webhooks, OAuth). The lowercase spellings are checked first.
# @type=url
HTTP_PROXY=
# @type=url
HTTPS_PROXY=
# Comma-separated hosts to reach directly; include the stack's own service
# names so worker→server traffic never leaves the network.
NO_PROXY=

# "true" runs update-ca-certificates at startup, so a CA mounted into
# /usr/local/share/ca-certificates is trusted by jobs. The supported way to
# handle a TLS-intercepting corporate proxy.
# @type=boolean
RUN_UPDATE_CA_CERTIFICATE_AT_START=false

# Disables TLS verification for the permissive HTTP client. A blunt override
# that affects outbound calls instance-wide; prefer the CA mount above.
# @type=boolean
ACCEPT_INVALID_CERTS=false

# ─── Timezone ──────────────────────────────────────────────────────────────

# Container timezone. Windmill stores and schedules in UTC; this only changes
# how timestamps are rendered inside a job's own runtime.
TZ=UTC
