# Listmonk v6.2.0 environment schema (@env-spec / varlock format).
#
# The compose now pins listmonk/listmonk:v6.2.0 (was the floating `latest`,
# which on 2026-09-04 resolved to the same digest,
# sha256:f535d59e14991337a9f2d570273685378ae86b0d7698c3e00da444e3bc205286).
# v6.2.0 (2026-06-26) is the newest stable release and is taken over the
# older v6.1.0 because it is a SECURITY release: it fixes multiple
# campaign/list permission-validation flaws in multi-user setups and a ZIP
# Slip path traversal in CSV import.
#
# Source: cmd/main.go at v6.2.0 (the koanf env provider), plus a grep of
# os.Getenv across the Go tree and the koanf keys the code actually reads.
#
# HOW CONFIG IS LOADED: this matters more than any variable list. main.go
# loads, in order: CLI flags -> config.toml (skipped here; the compose runs
# with `--config ''`) -> environment -> **the Postgres `settings` table**.
# The env provider strips the `LISTMONK_` prefix, lowercases, and turns a
# DOUBLE underscore into a dot: `LISTMONK_db__ssl_mode` -> `db.ssl_mode`.
# A key with no dot additionally has single underscores turned into hyphens,
# so `LISTMONK_static_dir` -> the `static-dir` CLI flag.
#
# Because the DB `settings` table is loaded LAST, it OVERWRITES environment
# values for every key it contains. That is almost the whole product:
# app.root_url, app.site_name, app.from_email, app.batch_size,
# app.concurrency, app.message_rate, smtp, bounce.*, privacy.*,
# security.oidc, security.captcha, upload.*, appearance.*, maintenance.db.*
# are all rows in `settings` (schema.sql) and are edited in
# Admin -> Settings. Setting them as env vars here does nothing after the
# first boot. They are deliberately NOT declared below.
#
# What environment genuinely owns, and all this file declares: `app.address`,
# the whole `db` block, the legacy `app.admin_username`/`app.admin_password`
# API shim, the three install-time LISTMONK_ADMIN_* variables read straight
# through os.Getenv, a few CLI-flag keys, and the container's own
# PUID/PGID/TZ.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Listmonk configuration reference", https://listmonk.app/docs/configuration/)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# Interface and port the built-in webserver binds to, `host:port`. The
# shipped config.toml.sample defaults to `localhost:9000`, which inside a
# container binds the loopback interface only and makes the service
# unreachable from the platform's network, hence the explicit 0.0.0.0 here.
# The port half is the twin of the compose's exposed port 9000: change one
# without the other and routing breaks. This is one of the few `app.*` keys
# NOT overridden by the DB settings table.
# @required
# @docs("Configuration", https://listmonk.app/docs/configuration/)
LISTMONK_app__address=0.0.0.0:9000

# ─── First-run superadmin ─────────────────────────────────────────────────

# Username of the superadmin created by `./listmonk --install` (the first
# half of the compose's command). Read with os.Getenv in cmd/install.go, so
# it is a plain variable, NOT a `LISTMONK_app__*` config key. Minimum 3
# characters; the install aborts if it is set but shorter.
#
# SECURITY: leave this empty and listmonk creates NO user at all. It then
# boots with `needsUserSetup` true and cmd/auth.go serves an UNAUTHENTICATED
# "first time setup" page at /admin/login to anyone who reaches the URL:
# whoever loads the page first claims superadmin over the whole instance.
# Set this and the password BEFORE the first boot, or keep the service
# unreachable from the internet until you have completed that page yourself.
# Both are read only during `--install` on an empty database; changing them
# later does nothing (manage users in Admin -> Settings -> Users).
# @required @sensitive
# @docs("Roles and permissions", https://listmonk.app/docs/roles-and-permissions/)
LISTMONK_ADMIN_USER=

# Password for the superadmin above. Minimum 8 characters; the install
# aborts if set but shorter. Both this and LISTMONK_ADMIN_USER must be set
# together; one alone is ignored and no user is created, which lands you in
# the open-setup-page state described above.
# @required @sensitive
# @type=string(minLength=8)
LISTMONK_ADMIN_PASSWORD=

# Optional: also create a superadmin API user with this name during
# `--install`. Requires LISTMONK_ADMIN_USER and LISTMONK_ADMIN_PASSWORD to
# be set (the install hard-fails otherwise) and must be at least 3 chars.
# The generated token is NOT read from the environment. The installer
# PRINTS it once to stderr as `export LISTMONK_ADMIN_API_TOKEN=...`, so
# capture it from the container's first-boot logs or it is unrecoverable.
# @sensitive
# @docs("API authentication", https://listmonk.app/docs/apis/apis/)
LISTMONK_ADMIN_API_USER=

# ─── Bundled Postgres (db service) ────────────────────────────────────────

# Role the bundled Postgres creates on first boot; must match
# LISTMONK_db__user or listmonk cannot connect.
# @required
# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=listmonk
# Password for that role. Supplied at install; the same value is handed to
# listmonk as LISTMONK_db__password.
# @required @sensitive
POSTGRES_PASSWORD=
# Database created on first boot; must match LISTMONK_db__database.
# @required
POSTGRES_DB=listmonk

# ─── Database connection (db.* config block) ──────────────────────────────

# Hostname of the bundled Postgres, resolved by the platform. listmonk
# connects with lib/pq and refuses to start if the DSN does not connect.
# @required
# @docs("Configuration", https://listmonk.app/docs/configuration/)
LISTMONK_db__host=${{stack.db.HOST}}
# @required
# @type=port
LISTMONK_db__port=5432
# @required
LISTMONK_db__user=listmonk
# @required @sensitive
LISTMONK_db__password=${POSTGRES_PASSWORD}
# @required
LISTMONK_db__database=listmonk

# TLS mode for the Postgres connection, passed through to lib/pq v1.10.9,
# which accepts only these four values and errors on anything else
# (including libpq's `prefer`). `disable` is correct for the bundled
# Postgres on the private stack network; use verify-full only against an
# external database with a trusted CA.
# @type=enum(disable, require, verify-ca, verify-full)
# @docs("libpq SSL support", https://www.postgresql.org/docs/17/libpq-ssl.html)
LISTMONK_db__ssl_mode=disable

# Connection pool ceilings and the maximum lifetime of a pooled connection
# (a Go duration string, e.g. "300s"). These are the config.toml.sample
# defaults; raising max_open past the Postgres `max_connections` setting
# just moves the failure into the database.
# @type=number
LISTMONK_db__max_open=25
# @type=number
LISTMONK_db__max_idle=25
LISTMONK_db__max_lifetime=300s

# Optional space-separated extra Postgres DSN parameters appended to the
# connection string, e.g. "application_name=listmonk gssencmode=disable".
# @docs("libpq connection parameters", https://www.postgresql.org/docs/17/libpq-connect.html#LIBPQ-PARAMKEYWORDS)
LISTMONK_db__params=

# ─── Legacy API credentials (deprecated) ──────────────────────────────────

# Pre-v4 single-admin credentials. Still read at boot (cmd/init.go): if the
# username is >2 chars and the password >6, listmonk registers them as a
# cached SUPERADMIN API user for HTTP Basic auth, purely so old API
# integrations keep working, and shows a red banner in the admin UI asking
# you to remove them. Leave both empty on a new deployment, since they are
# a full-privilege, never-rotated credential pair. Create real API users in
# Admin -> Settings -> Users instead.
# @docs("API authentication", https://listmonk.app/docs/apis/apis/)
LISTMONK_app__admin_username=
# @sensitive
LISTMONK_app__admin_password=

# ─── Runtime flags (CLI flags reachable via env) ──────────────────────────
# Top-level keys have single underscores rewritten to hyphens, so
# `LISTMONK_static_dir` sets the `--static-dir` flag. The lifecycle flags
# (--install, --idempotent, --upgrade, --yes, --config) are already passed
# on the compose's command line and are not restated here.

# Run in passive mode: the app serves the admin UI and APIs but does not
# process or send campaigns. Useful for a read-only or standby replica
# pointed at the same database.
# @type=boolean
# @docs("Configuration", https://listmonk.app/docs/configuration/)
LISTMONK_passive=false

# Optional path inside the container to a directory of static files
# (public pages, email templates) that overrides the ones compiled into the
# binary. Empty uses the embedded assets.
LISTMONK_static_dir=
# Optional path inside the container to a directory of i18n language JSON
# files that overrides the embedded ones.
LISTMONK_i18n_dir=

# ─── Docker secrets ───────────────────────────────────────────────────────
# The image's entrypoint expands ANY variable matching `LISTMONK_*_FILE` by
# reading the file at that path and exporting the same name without the
# `_FILE` suffix. The two below are the ones worth using; the same pattern
# works for every LISTMONK_ variable in this file. Set the file variant OR
# the plain one, not both.

# Path to a file containing the superadmin password.
# @docs("docker-entrypoint.sh (v6.2.0)", https://github.com/knadh/listmonk/blob/v6.2.0/docker-entrypoint.sh)
LISTMONK_ADMIN_PASSWORD_FILE=
# Path to a file containing the Postgres password.
LISTMONK_db__password_FILE=

# ─── Container runtime ────────────────────────────────────────────────────

# UID/GID the entrypoint runs the listmonk process as. Default 0 (root); set
# a non-zero PUID and the entrypoint creates the user, chowns /listmonk, and
# drops privileges with su-exec. If you change these, the uploads volume
# must be writable by that UID or media uploads fail.
# @type=number
# @docs("docker-entrypoint.sh (v6.2.0)", https://github.com/knadh/listmonk/blob/v6.2.0/docker-entrypoint.sh)
PUID=0
# @type=number
PGID=0

# System timezone for the container, honoured by Go's time package (the
# image installs tzdata). Affects log timestamps and the times campaign
# schedules are interpreted in.
TZ=UTC
