# Appsmith 2.3 (Community Edition) environment schema (@env-spec / varlock format).
#
# The compose pins appsmith/appsmith-ce:v2.3. That is an EXACT release, not a
# floating alias: Appsmith ships `vMAJOR.MINOR` tags (v2.1, v2.2, v2.3) with an
# occasional `vX.Y.Z` hotfix published as its OWN tag (v1.98.1 did not
# re-push v1.98). On 2026-09-03 (research date) v2.3, released 2026-08-13, is
# the newest stable release and shares its digest with `latest`
# (sha256:6e6ff29d…).
#
# Source: at v2.3, `System.getenv(` and `@Value("${…}")` across app/server
# plus application-ce.properties; `process.env.` across
# app/client/packages/rts/src and the `{{env "APPSMITH_*"}}` placeholders in
# app/client/public/{index,404}.html; `$APPSMITH_*` across
# deploy/docker/fs (entrypoint.sh, run-java.sh, run-caddy.sh,
# caddy-reconfigure.mjs, templates/docker.env.sh).
#
# What the docs reference gets wrong for THIS image: it documents
# APPSMITH_EMAIL_ENABLED, APPSMITH_EMAIL_SERVER_HOST/PORT/USERNAME/PASSWORD,
# APPSMITH_EMAIL_FROM_ADDRESS, APPSMITH_EMAIL_REPLY_TO_ADDRESS and
# APPSMITH_SMTP_AUTH_ENABLED. Those names exist only in the Helm chart; the
# Docker image reads APPSMITH_MAIL_* and nothing else (grep for
# APPSMITH_EMAIL_SERVER_HOST in the v2.3 tree returns zero hits). It also
# lists APPSMITH_BACKUP_S3_*, APPSMITH_BACKUP_CRON_EXPRESSION,
# APPSMITH_SERVER_TIMEOUT, APPSMITH_KEYCLOAK_* and the APPSMITH_OAUTH2_OIDC_*
# family, none of which v2.3 CE reads (OIDC/SAML/Keycloak are Business
# edition). Those are all omitted here. Conversely the docs omit
# APPSMITH_TRUSTED_PROXIES, APPSMITH_DISABLE_SSRF_FILTER,
# APPSMITH_MAIL_ALLOWED_PORTS, APPSMITH_ALLOW_INSECURE_ORIGIN_BASED_LINKS and
# APPSMITH_INTERNAL_PASSWORD, which the code does read.
#
# How configuration actually resolves in this image: on first boot
# entrypoint.sh writes /appsmith-stacks/configuration/docker.env (from
# templates/docker.env.sh) with a randomly generated MongoDB password, Redis
# password, encryption password and encryption salt. It then snapshots every
# APPSMITH_*/MONGO_* variable already in the container's environment to
# $TMP/pre-define.env, sources docker.env, and sources pre-define.env AFTER
# it. So anything set here wins over both the persisted docker.env and
# anything an admin later types into the Admin Settings UI. Setting a key
# here to the empty string is not the same as leaving it out of the compose,
# because the empty value is snapshotted and overrides the generated one.
# That is exactly why APPSMITH_ENCRYPTION_PASSWORD/SALT are @required:
# EncryptionHelper calls requireEnv() on both at class-init and throws
# "Environment variable '…' is required" on a blank value, taking the server
# down before it serves a request.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variables", https://docs.appsmith.com/getting-started/setup/environment-variables)
# ---

# ─── Core ────────────────────────────────────────────────────────────────
# @docs("Configure using environment variables", https://docs.appsmith.com/getting-started/setup/instance-configuration/configure-using-environment-variables)

# Secret used to encrypt every datasource credential, OAuth token and
# integration key Appsmith stores. Supplied by the compose, so it survives a
# container rebuild instead of living only in the volume's docker.env.
# CHANGING IT AFTER FIRST BOOT makes every already-stored credential
# undecryptable; there is no re-key path. Blank crashes the server at
# startup (EncryptionHelper.requireEnv).
# @required @sensitive
APPSMITH_ENCRYPTION_PASSWORD=

# Salt paired with the password above; hex-encoded and handed to Spring's
# Encryptors.delux. Same rules: never rotate it on a live install, never
# leave it blank.
# @required @sensitive
APPSMITH_ENCRYPTION_SALT=

# Canonical, externally reachable URL of this instance, e.g.
# https://appsmith.example.com. New in the 2.x hardening: without it,
# token-bearing emails (forgot-password, email verification, workspace
# invites) are DISABLED rather than built from a request's Origin header,
# and instance admins see a warning banner
# (SecureBaseUrlResolverCEImpl). Set it before you turn on SMTP.
# @type=url
APPSMITH_BASE_URL=

# Deprecated escape hatch that restores the pre-2.x behaviour of deriving
# email links from the incoming Origin header when APPSMITH_BASE_URL is
# unset. A forged Origin then forges the link, so treat this as a temporary
# migration aid only; the admin warning banner stays up either way.
# @type=boolean
APPSMITH_ALLOW_INSECURE_ORIGIN_BASED_LINKS=false

# Domain Appsmith's bundled Caddy should serve and obtain a Let's Encrypt
# certificate for. A value with a protocol prefix is discarded entirely
# (caddy-reconfigure.mjs strips anything matching ^https?://.+$), so give the
# bare hostname. Leave empty when otterdeploy's own proxy terminates TLS.
# @docs("Custom Domain and SSL", https://docs.appsmith.com/getting-started/setup/instance-configuration/custom-domain)
APPSMITH_CUSTOM_DOMAIN=

# Display name for this instance, shown in the UI and in the mails
# appsmithctl sends. Read once, by the Migration003 bootstrap, into the
# organization configuration; after that it is an Admin Settings field.
APPSMITH_INSTANCE_NAME=

# Comma-separated emails granted the Instance Administrator role. Read at
# first boot (Migration10000_UpdateSuperUser) and honoured on every restart
# via commonConfig; these accounts still have to sign up normally.
# @docs("Instance settings", https://docs.appsmith.com/getting-started/setup/instance-configuration/instance-settings)
APPSMITH_ADMIN_EMAILS=

# Value written into the served index.html's <html lang="…"> attribute.
# Added in 2.3.
APPSMITH_DEFAULT_HTML_LANG=en

# Port the container's Caddy listens on. The compose exposes container port
# 80 with no override, so this is that port's twin: change it here without
# changing the exposed port and routing breaks. It does NOT move the Java
# server, which run-java.sh pins to 8080 with -Dserver.port.
# @type=port
PORT=80

# ─── Bundled databases ───────────────────────────────────────────────────
# This image is a whole stack in one container: MongoDB (the application
# database), Redis, an embedded Postgres for mock datasources, the Java
# server, the Node RTS process and Caddy, all under /appsmith-stacks. Leave
# every key below empty to use the bundled ones; entrypoint.sh generates the
# credentials into the volume's docker.env on first boot. Fill them in only
# to point at external servers.
# @docs("Custom MongoDB and Redis", https://docs.appsmith.com/getting-started/setup/instance-configuration/custom-mongodb-redis)

# Application database connection string. Its scheme picks the backend:
# `mongodb://` / `mongodb+srv://` runs the server in Mongo mode (the
# default; generated as mongodb://appsmith:<random>@localhost:27017/appsmith)
# and `postgresql://` runs it in Postgres mode (run-java.sh chooses
# /opt/appsmith/server/{mongo,pg}). An external Mongo MUST be a replica set;
# entrypoint.sh refuses to start otherwise. The generated docker.env also
# carries a commented-in-waiting APPSMITH_POSTGRES_DB_URL line, which nothing
# reads: to move to Postgres you rename it to APPSMITH_DB_URL.
# @sensitive
APPSMITH_DB_URL=

# Legacy alias for the above. If set, entrypoint.sh (and ctl/index.ts) copy
# it into APPSMITH_DB_URL and unset it. Prefer APPSMITH_DB_URL.
# @sensitive
APPSMITH_MONGODB_URI=

# Credentials the embedded MongoDB user is CREATED with on first boot, and
# what `appsmithctl restore` rewrites the connection string with. Ignored
# once the data directory exists; for an external Mongo put the credentials
# in APPSMITH_DB_URL instead.
APPSMITH_MONGODB_USER=
# @sensitive
APPSMITH_MONGODB_PASSWORD=

# Runs the in-container Postgres that backs Appsmith's sample/mock
# datasources. Any value whose last character is "0" turns it off. It cannot
# run at all when the container is started as a non-root user (entrypoint.sh
# exits with an error), so set this to 0 for rootless deployments.
# @type=enum(0, 1)
# @docs("External PostgreSQL", https://docs.appsmith.com/getting-started/setup/instance-configuration/external-postgresql-rds)
APPSMITH_ENABLE_EMBEDDED_DB=1

# Redis used for sessions, rate limiting and Git coordination. Generated as
# redis://:<random>@127.0.0.1:6379. Point it elsewhere for a shared/external
# Redis; auth is part of the URL.
# @sensitive
# @docs("External Redis", https://docs.appsmith.com/getting-started/setup/instance-configuration/external-redis)
APPSMITH_REDIS_URL=

# The password half of the URL above, kept separately because appsmithctl's
# backup/restore rewrites it. Backfilled with a generated value on upgrade
# for installs predating Redis auth.
# @sensitive
APPSMITH_REDIS_PASSWORD=

# Optional second Redis dedicated to Git operations (in-memory Git file
# store). Falls back to APPSMITH_REDIS_URL when empty.
# @sensitive
# @docs("In-memory Git", https://docs.appsmith.com/getting-started/setup/instance-configuration/in-memory-git)
APPSMITH_REDIS_GIT_URL=

# ─── Email (SMTP) ────────────────────────────────────────────────────────
# @docs("Email setup", https://docs.appsmith.com/getting-started/setup/instance-configuration/email)

# Master switch. Left false because Spring would otherwise try localhost:25
# and error on every send. With it false, invites, password resets and email
# verification silently do nothing.
# @type=boolean
APPSMITH_MAIL_ENABLED=false

APPSMITH_MAIL_HOST=

# Only 25, 465, 587 and 2525 are accepted; anything else is rejected by the
# server's SMTP port allow-list (see APPSMITH_MAIL_ALLOWED_PORTS).
# @type=port
APPSMITH_MAIL_PORT=

APPSMITH_MAIL_USERNAME=
# @sensitive
APPSMITH_MAIL_PASSWORD=

# From address on outgoing mail. Must be one your SMTP provider will let you
# send as, or the provider rejects the message.
# @type=email
APPSMITH_MAIL_FROM=

# Reply-To header. The upstream default is a non-deliverable placeholder;
# replace it if you want replies to reach anyone.
# @type=email
APPSMITH_REPLY_TO=appsmith@localhost

# Support address surfaced in product emails and error screens. Defaults to
# Appsmith's own address, which is rarely what a self-host wants.
# @type=email
APPSMITH_MAIL_SUPPORT=support@appsmith.com

# SMTP AUTH and STARTTLS toggles, passed straight through to JavaMail. Both
# empty means "let JavaMail decide"; set both true for the usual
# submission-port setup.
# @type=boolean
APPSMITH_MAIL_SMTP_AUTH=
# @type=boolean
APPSMITH_MAIL_SMTP_TLS_ENABLED=

# Comma-separated EXTRA ports added to the built-in SMTP allow-list
# {25, 465, 587, 2525}. Read once, statically, at class load, so a value added
# here needs a container restart. Only needed for a relay on a nonstandard
# port.
APPSMITH_MAIL_ALLOWED_PORTS=

# ─── Authentication & signup ─────────────────────────────────────────────

# Google OAuth app. Both halves are required together: entrypoint.sh unsets
# BOTH if either is empty, because a half-configured registration crashes
# Spring Security at startup. Callback is <base URL>/login/oauth2/code/google.
# @docs("Google login", https://docs.appsmith.com/getting-started/setup/instance-configuration/authentication/google-login)
APPSMITH_OAUTH2_GOOGLE_CLIENT_ID=
# @sensitive
APPSMITH_OAUTH2_GOOGLE_CLIENT_SECRET=

# Overrides the Google callback URL. Only for the multi-org (Business)
# centralised-OAuth layout; leave empty and Spring uses
# {baseUrl}/login/oauth2/code/google.
# @type=url
APPSMITH_OAUTH2_GOOGLE_REDIRECT_URI=

# GitHub OAuth app. Same all-or-nothing rule as Google above. Callback is
# <base URL>/login/oauth2/code/github.
# @docs("GitHub login", https://docs.appsmith.com/getting-started/setup/instance-configuration/authentication/github-login)
APPSMITH_OAUTH2_GITHUB_CLIENT_ID=
# @sensitive
APPSMITH_OAUTH2_GITHUB_CLIENT_SECRET=

# Deprecated in favour of APPSMITH_SIGNUP_ALLOWED_DOMAINS; still read
# (oauth2.allowed-domains) and still applied to OAuth logins.
APPSMITH_OAUTH2_ALLOWED_DOMAINS=

# Comma-separated email domains allowed to create accounts. Empty means any
# domain, which on a public instance means anyone.
APPSMITH_SIGNUP_ALLOWED_DOMAINS=

# Blocks all new self-service signups. The instance administrator accounts
# from APPSMITH_ADMIN_EMAILS and invited users are unaffected.
# @type=boolean
# @docs("Disable signup", https://docs.appsmith.com/getting-started/setup/environment-variables#appsmith_signup_disabled)
APPSMITH_SIGNUP_DISABLED=false

# Turns off email+password login, leaving only the configured SSO providers.
# Read ONCE, by the Migration071 bootstrap, which then comments the line out
# of docker.env. After first boot it is an Admin Settings field, and a value
# set here will keep overriding that UI on every restart.
# @type=boolean
APPSMITH_FORM_LOGIN_DISABLED=

# Google reCAPTCHA on the signup/login forms. All three are unset together by
# entrypoint.sh if any one of them is empty, so configure all three or none.
# @type=boolean
APPSMITH_RECAPTCHA_ENABLED=
APPSMITH_RECAPTCHA_SITE_KEY=
# @sensitive
APPSMITH_RECAPTCHA_SECRET_KEY=

# Password guarding the Spring Actuator endpoints. Blank (the default) does
# not expose them with a guessable credential, since 2.3 refuses to enable
# actuator basic auth at all when this is unset.
# @sensitive
APPSMITH_INTERNAL_PASSWORD=

# ─── Network, proxying & embedding ───────────────────────────────────────

# Space-separated origins allowed to put Appsmith in an <iframe>, written
# straight into the Content-Security-Policy frame-ancestors directive.
# Everything after a ";" is discarded. Left empty the container uses "'self'"
# (same-origin only). 2.3 removed the old wildcard default. Use "'none'" to
# forbid framing outright; "*" exposes published apps to clickjacking.
# @docs("Embed Appsmith", https://docs.appsmith.com/getting-started/setup/environment-variables#embed-appsmith)
APPSMITH_ALLOWED_FRAME_ANCESTORS=

# Drops the browser sandbox on the Iframe widget, letting embedded pages run
# with the app's own privileges. docker.env ships it false; note the
# backwards-compatibility quirk in run-caddy.sh: if the variable is absent
# ENTIRELY (not merely false) the container exports "true".
# @type=boolean
APPSMITH_DISABLE_IFRAME_WIDGET_SANDBOX=false

# CIDRs/keywords whose X-Forwarded-For Caddy will believe. Default covers
# same-VPC and in-cluster load balancers. Behind a public edge proxy
# (Cloudflare, an ALB) set this to that proxy's egress ranges. Never
# 0.0.0.0/0: trusting every source lets any client spoof its address and
# bypass rate limiting (GHSA-qrgm-h8c4-jjf7).
APPSMITH_TRUSTED_PROXIES=private_ranges

# Requests per unit allowed by Caddy before throttling. The literal string
# "disabled" turns rate limiting off entirely; any other value is parsed as
# an integer.
APPSMITH_RATE_LIMIT=100

# Maximum in-memory request/response size in MB for the Java server, and the
# ceiling on multipart uploads. Raise it for large file uploads; it is held
# in heap, so raise APPSMITH_JAVA_HEAP_ARG with it.
# @type=number
# @docs("Upload file size limit", https://docs.appsmith.com/getting-started/setup/instance-configuration/file-size-limit)
APPSMITH_CODEC_SIZE=150

# Maximum size in MB of a single plugin/datasource response Appsmith will
# hand back to an app.
# @type=number
APPSMITH_PLUGIN_MAX_RESPONSE_SIZE_MB=5

# "true" disables the filter that blocks datasources from resolving to
# loopback, link-local and other restricted hosts. In 2.3 that filter is
# unconditional and this is the only opt-out. Turning it off lets anyone who
# can create a datasource reach services on the container's own network.
# @type=boolean
APPSMITH_DISABLE_SSRF_FILTER=false

# Outbound proxy for everything the container initiates: datasource calls,
# plugin traffic, telemetry, Let's Encrypt. entrypoint.sh mirrors each into
# its lowercase twin and run-java.sh translates them into -Dhttp(s).proxy*
# JVM flags; only http:// proxy URLs (optionally with user:pass) are parsed.
# @docs("HTTP proxy", https://docs.appsmith.com/getting-started/setup/instance-configuration/http-proxy)
HTTP_PROXY=
HTTPS_PROXY=
# Comma-separated hosts that bypass the proxy. localhost and 127.0.0.1 are
# force-added whatever you put here, because the container's own processes
# talk to each other over loopback.
NO_PROXY=localhost,127.0.0.1

# ─── Internal processes ──────────────────────────────────────────────────
# These wire the container's own processes to each other. The defaults are
# what the supervisord layout expects; change them only alongside a matching
# change elsewhere in the container.

# Address the Java server binds to. Loopback-only by design; Caddy is the
# only thing that should reach it.
APPSMITH_SERVER_ADDRESS=127.0.0.1

# Host and port of the RTS (real-time collaboration) Node process, and the
# API base it calls back into. run-java.sh blocks startup until RTS answers
# /rts-api/v1/health-check on APPSMITH_RTS_PORT.
APPSMITH_RTS_HOST=127.0.0.1
# @type=port
APPSMITH_RTS_PORT=8091
# @type=url
APPSMITH_API_BASE_URL=http://localhost:8080/api/v1

# Extra JVM flags, space-delimited, e.g. "-Xms800M -Xmx800M".
APPSMITH_JAVA_ARGS=
# Heap flag alone, e.g. "-Xmx2g". The container sets it itself only on
# constrained hosts (ulimit -u <= 512).
APPSMITH_JAVA_HEAP_ARG=

# Spring profile. "production" is the only supported value for a deployed
# instance; anything else selects test/dev bean overrides.
# @type=enum(production)
ACTIVE_PROFILE=production

# ─── Storage, Git & backups ──────────────────────────────────────────────

# Directory holding the local clones behind Git-connected apps. Empty uses
# the built-in path under /appsmith-stacks; the volume must cover whatever
# you set or every Git app loses its working copy on restart.
APPSMITH_GIT_ROOT=

# Seconds after which a stale index.lock left by an interrupted Git
# operation is considered abandoned and removed.
# @type=number
APPSMITH_INDEX_LOCK_FILE_TIME=300

# How many `appsmithctl backup` archives to keep under
# /appsmith-stacks/data/backup before the oldest are deleted.
# @type=number
# @docs("Backup instance", https://docs.appsmith.com/getting-started/setup/instance-management/backup-and-restore/backup-instance)
APPSMITH_BACKUP_ARCHIVE_LIMIT=4

# The file Admin Settings writes to when an admin changes a setting in the
# UI. It lives on the volume; keys set on the container override it on every
# boot regardless.
APPSMITH_ENVFILE_PATH=/appsmith-stacks/configuration/docker.env

# Root for per-process log directories (supervisor, backend, rts, mongodb,
# redis, postgres, cron, appsmithctl), created at boot and pruned by the
# CleanUpOldLogs cron. Must be inside the mounted volume to survive restarts.
# @docs("Container logs", https://docs.appsmith.com/getting-started/setup/instance-management/how-to-get-container-logs)
APPSMITH_LOG_DIR=/appsmith-stacks/logs

# ─── Logging & self-healing ──────────────────────────────────────────────

# Adds verbose request/response logging on the Java server. Useful for
# debugging a datasource; it will log payload contents, so do not leave it on.
# @type=boolean
APPSMITH_VERBOSE_LOGGING_ENABLED=false

# Console log level of the browser client. Empty keeps the built-in level.
# @type=enum(debug, error)
APPSMITH_CLIENT_LOG_LEVEL=

# Log level of the RTS Node process. Defaults to the very chatty "debug";
# "info" or "warn" is the sane choice for a deployed instance.
# @type=enum(trace, debug, info, warn, error, silent)
APPSMITH_LOG_LEVEL=debug

# "1" starts a background loop that curls the instance and restarts stuck
# processes, logging to $APPSMITH_LOG_DIR/cron/auto_heal.log. Off by default;
# it masks crashes rather than reporting them, so prefer the platform's own
# restart policy.
# @type=enum(0, 1)
APPSMITH_AUTO_HEAL=0
# Seconds the auto-heal probe waits for a response before deciding the
# instance is stuck. Only read when APPSMITH_AUTO_HEAL=1.
# @type=number
APPSMITH_AUTO_HEAL_CURL_TIMEOUT=5

# "1" runs a rolling 24-hour Java Flight Recorder recording into
# $APPSMITH_LOG_DIR. Diagnostics only (it costs CPU and disk).
# @type=enum(0, 1)
APPSMITH_MONITORING=0

# ─── Telemetry & analytics ───────────────────────────────────────────────
# @docs("Telemetry", https://docs.appsmith.com/product/telemetry)

# Turns off anonymised usage collection. The compose sets it to "true". Note
# the two upstream defaults disagree: the Java server defaults it true when
# unset, while the generated docker.env writes false, which is why setting
# it explicitly, as the compose does, is the only way to be sure.
# @type=boolean
APPSMITH_DISABLE_TELEMETRY=true

# Segment write keys: one for the browser client, one used by entrypoint.sh
# to post an "Instance Start" event to api.segment.io. Empty on a self-host;
# they exist for Appsmith's own hosted builds.
# @sensitive
APPSMITH_SEGMENT_KEY=
# @sensitive
APPSMITH_SEGMENT_CE_KEY=

# Sentry for the browser client: DSN plus the environment/release tags
# attached to each event.
# @sensitive
APPSMITH_SENTRY_DSN=
APPSMITH_SENTRY_ENVIRONMENT=
APPSMITH_SENTRY_RELEASE=

# Sentry for the Java server. Separate DSN from the client one above; note
# the server sends default PII with events.
# @sensitive
APPSMITH_SERVER_SENTRY_DSN=
APPSMITH_SERVER_SENTRY_ENVIRONMENT=

# Smartlook session-recording ID, injected into the served index.html.
APPSMITH_SMART_LOOK_ID=
# Mixpanel and Reo product-analytics keys, likewise browser-side. Reo is only
# loaded when APPSMITH_CLOUD_HOSTING is also true.
# @sensitive
APPSMITH_MIXPANEL_KEY=
APPSMITH_REO_CLIENT_ID=

# ─── Appsmith Cloud Services ─────────────────────────────────────────────
# The hosted side-services (app templates, datasource authorization
# handshakes). The image is built with a base URL already baked in; a
# self-host normally leaves all of these empty, and an air-gapped one must.

# Marks this instance as Appsmith's own hosted deployment. Changes plugin
# behaviour (e.g. AWS Lambda credential handling) and unlocks cloud-only UI.
# Leave false on a self-host.
# @type=boolean
APPSMITH_CLOUD_HOSTING=false

# @type=url
APPSMITH_CLOUD_SERVICES_BASE_URL=
# @type=url
APPSMITH_CLOUD_SERVICES_SIGNATURE_BASE_URL=
# @sensitive
APPSMITH_CLOUD_SERVICES_TEMPLATE_UPLOAD_AUTH=

# Repository slug used to build "report an issue" / release links in the UI.
APPSMITH_GITHUB_REPO=

# ─── Third-party widget keys & in-product help ───────────────────────────
# Substituted into the served index.html at container start, so they take
# effect on restart with no rebuild. All optional; most are Appsmith-hosted
# or Business-edition wiring that a CE self-host leaves empty.

# Google Maps JavaScript API key, without which the Map widget renders a
# "development purposes only" watermark. Read once by the Migration021
# bootstrap, which then comments the line out of docker.env and moves the
# value into Admin Settings.
# @sensitive
# @docs("Google Maps", https://docs.appsmith.com/getting-started/setup/instance-configuration/google-maps)
APPSMITH_GOOGLE_MAPS_API_KEY=

# FusionCharts licence key for the Chart widget's FusionCharts mode; without
# it those charts carry a vendor watermark.
# @sensitive
APPSMITH_FUSIONCHARTS_LICENSE_KEY=

# In-product support widgets. Each pair is a "don't load it" switch plus the
# vendor's app/API key. Setting the disable flags keeps the editor from
# talking to Intercom / Pylon / BetterBugs at all.
# @type=boolean
APPSMITH_DISABLE_INTERCOM=
APPSMITH_INTERCOM_APP_ID=
# @type=boolean
APPSMITH_DISABLE_PYLON=
APPSMITH_PYLON_APP_ID=
# @type=boolean
APPSMITH_DISABLE_BETTERBUGS=
# @sensitive
APPSMITH_BETTERBUGS_API_KEY=

# OpenTelemetry-style collector endpoint for browser-side traces, and the
# deployment name they are tagged with.
# @type=url
APPSMITH_FRONTEND_TRACING_URL=
APPSMITH_DEPLOYMENT_NAME=

# Where the "Manage plan" / "Pricing" links in the UI point. Defaults are
# Appsmith's own hosted pages; override them if you front billing yourself.
# @type=url
APPSMITH_CUSTOMER_PORTAL_URL=https://customer.appsmith.com
# @type=url
APPSMITH_PRICING_URL=https://www.appsmith.com/pricing

# ─── Commercial-edition flags ────────────────────────────────────────────
# Read by this CE image's index.html but only meaningful with a Business
# licence; on appsmith-ce they change nothing you can use.

# Suppresses the outbound calls the editor makes for templates, telemetry
# and vendor widgets.
# @type=boolean
# @docs("Air-gapped installation", https://docs.appsmith.com/getting-started/setup/installation-guides/air-gapped)
APPSMITH_AIRGAP_ENABLED=

# Removes the "Built on Appsmith" watermark from published apps.
# @type=boolean
APPSMITH_HIDE_WATERMARK=
