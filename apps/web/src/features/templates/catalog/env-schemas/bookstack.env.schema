# BookStack v26.05.4 (image lscr.io/linuxserver/bookstack:26.05.4) environment
# schema (@env-spec / varlock format).
#
# Source: grep of env( across app/Config/*.php at BookStackApp/BookStack v26.05.4
# (the linuxserver.io image is a packaging wrapper; the application config reads
# are unmodified upstream BookStack, and only PUID/PGID/TZ come from the
# linuxserver base image's s6-overlay init, never from BookStack's own code).
# No env( / getenv() / $_ENV reads exist outside app/Config/*.php.
#
# Cross-checked against the shipped .env.example.complete, which is accurate
# except: it omits DEBUGBAR_ENABLED, CLOCKWORK_ENABLE, LOG_CHANNEL,
# BCRYPT_ROUNDS, SESSION_DOMAIN, DB_SOCKET, DB_TABLE_PREFIX, DATABASE_URL,
# MYSQL_ATTR_SSL_CA, and REDIS_QUEUE entirely, and it documents
# APP_VIEWS_BOOKS's default as "list" when app/Config/setting-defaults.php
# actually defaults it to "grid" (code is truth; used below).
#
# The compose prompts for BOOKSTACK_URL, APP_KEY, and MYSQL_PASSWORD (platform
# prompt keys) and threads them, unchanged, into APP_URL, APP_KEY, and
# DB_PASSWORD / the bundled MariaDB's MARIADB_PASSWORD below.
#
# APP_KEY is Laravel's encryption key and must carry the `base64:` prefix;
# BookStack encrypts stored third-party credentials with it, so replacing it
# after first boot leaves those unreadable.

# @defaultSensitive=false @defaultRequired=infer
# @docs("BookStack Docker installation", https://www.bookstackapp.com/docs/admin/installation/#docker)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Platform prompt key for the instance's public URL; threaded unchanged into
# APP_URL below. All links BookStack generates are built from this value.
# @required
# @type=url
BOOKSTACK_URL=

# Root application URL that every generated link, redirect, and OAuth
# callback is built from. Set by the compose from BOOKSTACK_URL above.
# @required
# @type=url
APP_URL=${BOOKSTACK_URL}

# Laravel's encryption key. Platform prompt key, generated once and threaded
# unchanged into the container's own APP_KEY. Losing or rotating it after
# first boot makes previously-encrypted third-party credentials unreadable.
# @required
# @sensitive
# @type=string(startsWith=base64:)
APP_KEY=${APP_KEY}

# Options: production, development, demo, testing.
# @type=enum(production, development, demo, testing)
APP_ENV=production

# Verbose error output; can expose configuration values in responses. Leave
# disabled outside of local debugging.
# @type=boolean
APP_DEBUG=false

# Default UI language; overridden by user preference or, if
# APP_AUTO_LANG_PUBLIC is on, by the visitor's browser headers.
APP_LANG=en

# Auto-detect a public visitor's language from browser headers, falling back
# to APP_LANG when absent.
# @type=boolean
APP_AUTO_LANG_PUBLIC=true

# Timezone used for stored date/time values. Leaving UTC is advised;
# changing it after data exists does not retroactively convert stored dates.
APP_TIMEZONE=UTC

# Timezone used for displaying dates in the UI. Defaults to APP_TIMEZONE.
APP_DISPLAY_TIMEZONE=

# Name of a `themes/<name>` folder holding UI override files. Disabled
# (false) unless a custom theme has been installed into the container.
APP_THEME=false

# Trusted proxy IP(s), comma separated, or "*" to trust all. Needed for
# X-Forwarded-* headers (client IP, scheme) to be honored behind a reverse
# proxy or load balancer.
APP_PROXIES=

# ─── Container (linuxserver base image) ─────────────────────────────────────
# @docs("Understanding PUID and PGID", https://docs.linuxserver.io/general/understanding-puid-and-pgid)
# @docs("linuxserver/bookstack image", https://docs.linuxserver.io/images/docker-bookstack/)

# User/group ID the s6-overlay init runs the app as, so files written under
# /config are owned by a real host user rather than root.
PUID=1000
PGID=1000

# System timezone for the container (affects log timestamps and PHP's
# default timezone); independent of APP_TIMEZONE, which governs BookStack's
# own stored/displayed dates.
TZ=UTC

# ─── Bundled database (MariaDB) ─────────────────────────────────────────────
# Set on the `db` service by the compose. Not part of BookStack's own code:
# these are the official MariaDB image's own bootstrap variables.
# @docs("MariaDB Docker environment variables", https://mariadb.com/kb/en/mariadb-docker-environment-variables/)

MARIADB_DATABASE=bookstack
MARIADB_USER=bookstack
# @sensitive
MARIADB_PASSWORD=${MYSQL_PASSWORD}
# "1" generates and discards a random root password at init instead of
# leaving it blank, since BookStack only ever connects as MARIADB_USER.
MARIADB_RANDOM_ROOT_PASSWORD=1

# ─── Database connection ─────────────────────────────────────────────────────
# Read by BookStack itself to reach the MariaDB service above.

# Platform prompt key for the database password; threaded unchanged into
# DB_PASSWORD below and into MARIADB_PASSWORD above.
# @required
# @sensitive
MYSQL_PASSWORD=

# Hostname of the database server; can embed "host:port". Derived by the
# platform from the bundled `db` service, never typed by the operator.
DB_HOST=${{stack.db.HOST}}
# @type=port
DB_PORT=3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack
# @sensitive
DB_PASSWORD=${MYSQL_PASSWORD}

# Unix socket path; when set, DB_HOST/DB_PORT are ignored. Not applicable to
# the bundled MariaDB service, which is reached over TCP.
DB_SOCKET=

# Table name prefix. Only semi-supported by BookStack. Set once at first
# install and never change it afterwards, or queries will start failing.
DB_TABLE_PREFIX=

# Path to a CA certificate file (inside the container) for verifying the
# database server's TLS certificate.
MYSQL_ATTR_SSL_CA=

# Full DSN that, if set, overrides the discrete DB_HOST/DB_PORT/DB_DATABASE/
# DB_USERNAME/DB_PASSWORD values above entirely.
# @sensitive
DATABASE_URL=

# ─── Mail ─────────────────────────────────────────────────────────────────
# @docs("Email configuration", https://www.bookstackapp.com/docs/admin/email-webhooks/#email-configuration)

# Options: smtp, sendmail, log, array.
# @type=enum(smtp, sendmail, log, array)
MAIL_DRIVER=smtp
MAIL_FROM=bookstack@example.com
MAIL_FROM_NAME=BookStack
MAIL_HOST=smtp.mailgun.org
# @type=port
MAIL_PORT=587
MAIL_USERNAME=
# @sensitive
MAIL_PASSWORD=
# Encryption forced for the SMTP transport, beyond opportunistic STARTTLS.
MAIL_ENCRYPTION=
# @type=boolean
MAIL_VERIFY_SSL=true
# Command used by the "sendmail" driver.
MAIL_SENDMAIL_COMMAND=/usr/sbin/sendmail -bs
# Log channel the "log" mail driver writes to; defaults to LOG_CHANNEL below.
MAIL_LOG_CHANNEL=

# ─── Caching, session & queue ────────────────────────────────────────────────
# @docs("Cache and session config", https://www.bookstackapp.com/docs/admin/cache-session-config/)

# Options: file, database, memcached, redis.
# @type=enum(file, database, memcached, redis)
CACHE_DRIVER=file
CACHE_PREFIX=bookstack_cache_
# @type=enum(file, database, memcached, redis)
SESSION_DRIVER=file
# @type=number
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=bookstack_session
# Restricts the session cookie to this domain; empty applies to the host
# APP_URL is served from only.
SESSION_DOMAIN=
# Marks the session cookie Secure (HTTPS-only). Empty auto-infers true when
# APP_URL starts with https:.
SESSION_SECURE_COOKIE=
# Options: sync, database, redis.
# @type=enum(sync, database, redis)
QUEUE_CONNECTION=sync
# Redis queue name used when QUEUE_CONNECTION=redis.
REDIS_QUEUE=default
# Format: HOST:PORT:DATABASE[:PASSWORD], comma-separated for a cluster. Read
# whenever CACHE_DRIVER, SESSION_DRIVER, or QUEUE_CONNECTION is set to redis.
REDIS_SERVERS=
# Format: HOST:PORT:WEIGHT, comma-separated. Use PORT 0 for a UNIX socket
# path as HOST. Read only when CACHE_DRIVER=memcached.
MEMCACHED_SERVERS=127.0.0.1:11211:100

# ─── File storage ────────────────────────────────────────────────────────────
# @docs("Content / image storage", https://www.bookstackapp.com/docs/admin/content-storage/)

# @type=enum(local, local_secure, s3)
STORAGE_TYPE=local
# Defaults to STORAGE_TYPE if unset.
# @type=enum(local, local_secure, s3)
STORAGE_IMAGE_TYPE=
# Defaults to STORAGE_TYPE if unset; a "local" value is forced to
# "local_secure" so attachments are never served directly by the web server.
# @type=enum(local, local_secure, s3)
STORAGE_ATTACHMENT_TYPE=
# Base URL used to build public asset links when using S3-compatible
# storage; an S3-format URL is generated automatically if unset.
STORAGE_URL=
# @sensitive
STORAGE_S3_KEY=
# @sensitive
STORAGE_S3_SECRET=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
# Only set for a non-Amazon S3-compatible service, e.g. MinIO.
STORAGE_S3_ENDPOINT=

# ─── Authentication method ────────────────────────────────────────────────────

# @type=enum(standard, ldap, saml2, oidc)
AUTH_METHOD=standard
# Skip the login page and jump straight to the external IdP; only takes
# effect with AUTH_METHOD=saml2 or oidc.
# @type=boolean
AUTH_AUTO_INITIATE=false

# ─── Social login (OAuth) ─────────────────────────────────────────────────────
# All disabled unless a CLIENT_ID/APP_ID is set. AUTO_REGISTER creates a new
# BookStack user on first successful login instead of requiring one to
# already exist; AUTO_CONFIRM_EMAIL skips the email-confirmation step.
# @docs("Third-party (social) authentication", https://www.bookstackapp.com/docs/admin/third-party-auth/)

AZURE_APP_ID=
# @sensitive
AZURE_APP_SECRET=
AZURE_TENANT=
# @type=boolean
AZURE_AUTO_REGISTER=false
# @type=boolean
AZURE_AUTO_CONFIRM_EMAIL=false

DISCORD_APP_ID=
# @sensitive
DISCORD_APP_SECRET=
# @type=boolean
DISCORD_AUTO_REGISTER=false
# @type=boolean
DISCORD_AUTO_CONFIRM_EMAIL=false

FACEBOOK_APP_ID=
# @sensitive
FACEBOOK_APP_SECRET=
# @type=boolean
FACEBOOK_AUTO_REGISTER=false
# @type=boolean
FACEBOOK_AUTO_CONFIRM_EMAIL=false

GITHUB_APP_ID=
# @sensitive
GITHUB_APP_SECRET=
# @type=boolean
GITHUB_AUTO_REGISTER=false
# @type=boolean
GITHUB_AUTO_CONFIRM_EMAIL=false

GITLAB_APP_ID=
# @sensitive
GITLAB_APP_SECRET=
# Only needed for a self-hosted GitLab instance.
GITLAB_BASE_URI=
# @type=boolean
GITLAB_AUTO_REGISTER=false
# @type=boolean
GITLAB_AUTO_CONFIRM_EMAIL=false

GOOGLE_APP_ID=
# @sensitive
GOOGLE_APP_SECRET=
# Forces the Google account chooser to show on every login.
# @type=boolean
GOOGLE_SELECT_ACCOUNT=false
# @type=boolean
GOOGLE_AUTO_REGISTER=false
# @type=boolean
GOOGLE_AUTO_CONFIRM_EMAIL=false

OKTA_APP_ID=
# @sensitive
OKTA_APP_SECRET=
OKTA_BASE_URL=
# @type=boolean
OKTA_AUTO_REGISTER=false
# @type=boolean
OKTA_AUTO_CONFIRM_EMAIL=false

SLACK_APP_ID=
# @sensitive
SLACK_APP_SECRET=
# @type=boolean
SLACK_AUTO_REGISTER=false
# @type=boolean
SLACK_AUTO_CONFIRM_EMAIL=false

TWITCH_APP_ID=
# @sensitive
TWITCH_APP_SECRET=
# @type=boolean
TWITCH_AUTO_REGISTER=false
# @type=boolean
TWITCH_AUTO_CONFIRM_EMAIL=false

TWITTER_APP_ID=
# @sensitive
TWITTER_APP_SECRET=
# @type=boolean
TWITTER_AUTO_REGISTER=false
# @type=boolean
TWITTER_AUTO_CONFIRM_EMAIL=false

# ─── LDAP authentication ───────────────────────────────────────────────────
# Only read when AUTH_METHOD=ldap.
# @docs("LDAP authentication", https://www.bookstackapp.com/docs/admin/ldap-auth/)

# e.g. ldaps://ldap.example.com or ldap://ldap.example.com:389
LDAP_SERVER=
LDAP_BASE_DN=
# Bind DN used to search LDAP; empty attempts an anonymous bind.
LDAP_DN=
# @sensitive
LDAP_PASS=
LDAP_USER_FILTER=(&(uid={user}))
LDAP_VERSION=
# @type=boolean
LDAP_START_TLS=false
# @type=boolean
LDAP_TLS_INSECURE=false
LDAP_TLS_CA_CERT=
LDAP_ID_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_DISPLAY_NAME_ATTRIBUTE=cn
LDAP_THUMBNAIL_ATTRIBUTE=
# @type=boolean
LDAP_FOLLOW_REFERRALS=false
# Logs full user detail after a login attempt, for debugging bind/attribute
# issues. Not for normal operation.
# @type=boolean
LDAP_DUMP_USER_DETAILS=false
# Sync LDAP group membership to BookStack roles on every login.
# @type=boolean
LDAP_USER_TO_GROUPS=false
LDAP_GROUP_ATTRIBUTE=memberOf
# @type=boolean
LDAP_REMOVE_FROM_GROUPS=false
# @type=boolean
LDAP_DUMP_USER_GROUPS=false

# ─── SAML2 authentication ────────────────────────────────────────────────────
# Only read when AUTH_METHOD=saml2.
# @docs("SAML2 authentication", https://www.bookstackapp.com/docs/admin/saml2-auth/)

SAML2_NAME=SSO
SAML2_EMAIL_ATTRIBUTE=email
SAML2_DISPLAY_NAME_ATTRIBUTES=username
SAML2_EXTERNAL_ID_ATTRIBUTE=
SAML2_IDP_ENTITYID=
SAML2_IDP_SSO=
SAML2_IDP_SLO=
# Public x509 certificate of the identity provider.
SAML2_IDP_x509=
# JSON overrides merged into the underlying onelogin/php-saml config.
SAML2_ONELOGIN_OVERRIDES=
# @type=boolean
SAML2_DUMP_USER_DETAILS=false
# Fetch IdP details from its metadata endpoint instead of the discrete
# SAML2_IDP_* values above.
# @type=boolean
SAML2_AUTOLOAD_METADATA=false
# true sends the default PasswordProtectedTransport context; space-separate
# multiple values to force specific contexts; false omits it entirely.
SAML2_IDP_AUTHNCONTEXT=true
# This service provider's own x509 certificate, for signing requests.
SAML2_SP_x509=
# @sensitive
SAML2_SP_x509_KEY=
# @type=boolean
SAML2_USER_TO_GROUPS=false
SAML2_GROUP_ATTRIBUTE=group
# @type=boolean
SAML2_REMOVE_FROM_GROUPS=false

# ─── OIDC authentication ─────────────────────────────────────────────────────
# Only read when AUTH_METHOD=oidc.
# @docs("OIDC authentication", https://www.bookstackapp.com/docs/admin/oidc-auth/)

OIDC_NAME=SSO
OIDC_DISPLAY_NAME_CLAIMS=name
OIDC_CLIENT_ID=
# @sensitive
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
# Auto-discover the endpoints below from the issuer; cached 15 minutes.
# @type=boolean
OIDC_ISSUER_DISCOVER=false
# Key used to verify the JWT; a literal key value or a "file://..." path.
OIDC_PUBLIC_KEY=
OIDC_AUTH_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
# false disables RP-Initiated Logout; true resolves it from discovery.
OIDC_END_SESSION_ENDPOINT=
# Comma-separated extra scopes appended to the OIDC auth request.
OIDC_ADDITIONAL_SCOPES=
# @type=boolean
OIDC_DUMP_USER_DETAILS=false
# @type=boolean
OIDC_USER_TO_GROUPS=false
OIDC_GROUPS_CLAIM=groups
# @type=boolean
OIDC_REMOVE_FROM_GROUPS=false
OIDC_EXTERNAL_ID_CLAIM=sub
# Fetches the user's avatar from the OIDC "picture" claim; performs a
# server-side fetch of an operator-supplied URL, so only enable if the
# identity provider is trusted.
# @type=boolean
OIDC_FETCH_AVATAR=false

# ─── Content security ─────────────────────────────────────────────────────────
# @docs("Security", https://www.bookstackapp.com/docs/admin/security/)

# Hosts BookStack itself may be iframed within. Space-separated; own host is
# auto-inferred. Setting this also switches cookies to SameSite=None.
ALLOWED_IFRAME_HOSTS=
# Sources BookStack may load INTO an iframe. Space-separated; "*" allows all
# (not advised).
ALLOWED_IFRAME_SOURCES=https://*.draw.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com
ALLOWED_STYLE_SOURCES=
ALLOWED_IMAGE_SOURCES=
# Hosts reachable by server-side fetches the app itself initiates (e.g.
# webhooks). "*" allows all.
ALLOWED_SSR_HOSTS=*
# String of filter flags: j (scripts), h (HTML), f (forms), a (allowlist).
# Deprecated by ALLOW_CONTENT_SCRIPTS=true, which forces no filtering.
APP_CONTENT_FILTERING=jhfa
# Deprecated: use APP_CONTENT_FILTERING instead. true disables all content
# filtering and CSP-level script control.
# @type=boolean
ALLOW_CONTENT_SCRIPTS=false
# true/false/empty(auto, follows the "app-public" admin setting).
ALLOW_ROBOTS=
# Allows server-side fetches to arbitrary, potentially user-supplied hosts
# (used by exports and OIDC_FETCH_AVATAR). A security-relevant relaxation.
# @type=boolean
ALLOW_UNTRUSTED_SERVER_FETCHING=false

# ─── Exports & PDF rendering ──────────────────────────────────────────────────
# @docs("PDF rendering", https://www.bookstackapp.com/docs/admin/pdf-rendering/)

# @type=enum(a4, letter)
EXPORT_PAGE_SIZE=a4
# Custom command to convert HTML to PDF, using {input_html_path} and
# {output_pdf_path} placeholders; false uses the bundled DomPDF renderer.
EXPORT_PDF_COMMAND=false
# @type=number
EXPORT_PDF_COMMAND_TIMEOUT=15
# Path to a wkhtmltopdf binary. Only consulted when
# ALLOW_UNTRUSTED_SERVER_FETCHING=true.
WKHTMLTOPDF=false

# ─── API ──────────────────────────────────────────────────────────────────────

# @type=number
API_DEFAULT_ITEM_COUNT=100
# @type=number
API_MAX_ITEM_COUNT=500
# @type=number
API_REQUESTS_PER_MIN=180

# ─── Logging & diagnostics ─────────────────────────────────────────────────────
# @docs("Debugging BookStack", https://www.bookstackapp.com/docs/admin/debugging/)

LOG_CHANNEL=single
# Message logged on a failed email+password login; may contain a %u
# placeholder for the attempted username/email. false disables logging.
LOG_FAILED_LOGIN_MESSAGE=false
LOG_FAILED_LOGIN_CHANNEL=errorlog_plain_webserver
# 0 (hidden) to 4 (full IP) precision for stored IP addresses.
# @type=number
IP_ADDRESS_PRECISION=4
# Enables the Laravel Debugbar overlay. Development only; never on a
# public-facing instance.
# @type=boolean
DEBUGBAR_ENABLED=false
# Enables Clockwork request profiling. Development only.
# @type=boolean
CLOCKWORK_ENABLE=false

# ─── Misc ───────────────────────────────────────────────────────────────────

# Revisions kept per page before older ones are pruned; false disables the
# limit entirely.
# @type=number
REVISION_LIMIT=100
# Days content stays in the recycle bin before eligible for auto-removal;
# 0 disables the recycle bin, -1 keeps content forever.
# @type=number
RECYCLE_BIN_LIFETIME=30
# Max upload size, in MB, for images and attachments.
# @type=number
FILE_UPLOAD_SIZE_LIMIT=50
# Enables the draw.io / diagrams.net editor integration; can also be a URL
# to a self-hosted diagrams.net instance.
DRAWIO=true
# Custom avatar fetch URL template (supports ${hash} ${size} ${email}); if
# set, avatars are fetched regardless of DISABLE_EXTERNAL_SERVICES.
AVATAR_URL=
# Disables default third-party services (Gravatar, draw.io) in one switch;
# per-service settings above override it.
# @type=boolean
DISABLE_EXTERNAL_SERVICES=false
# Default listing view for users/visitors without a saved preference.
# @type=enum(list, grid)
APP_VIEWS_BOOKS=grid
# @type=enum(list, grid)
APP_VIEWS_BOOKSHELVES=grid
# @type=enum(list, grid)
APP_VIEWS_BOOKSHELF=grid
# @type=boolean
APP_DEFAULT_DARK_MODE=false
# bcrypt work factor for password hashing; higher is slower but stronger.
# @type=number
BCRYPT_ROUNDS=12
