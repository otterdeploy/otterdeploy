# CloudBeaver CE 26.1.5 environment schema (@env-spec / varlock format).
#
# The compose pins dbeaver/cloudbeaver:26.1.5 (digest
# sha256:bb4968967796856e3b89e3ece33654d69aaed52113b6bf9d2d2d0056956a4722,
# published 2026-08-17). 26.2.0 shipped 2026-08-31, three days before this
# research: it opens a fresh quarterly line with no follow-up fix release yet,
# while 26.1.5 is the matured tail of the 26.1 line (five biweekly fix
# releases deep). Upstream ships a stable quarterly major plus a biweekly
# minor; see "Release cycles".
#
# Source: the conf/cloudbeaver.conf that the 26.1.5 image actually ships
# (`docker run --entrypoint sh dbeaver/cloudbeaver:26.1.5 -c 'cat
# conf/cloudbeaver.conf'`), cross-read against its generator
# (config/template/cloudbeaver-base.conf + apps/config-generator) and against
# System.getenv call sites in server/ at branch release_26_1_5.
#
# How CloudBeaver reads the environment, since it is not the usual pattern:
# it is a Java app configured by conf/cloudbeaver.conf, and every value in
# that file that is written "${NAME:default}" is substituted from the process
# environment at boot. So the CLOUDBEAVER_* keys below are exactly the
# placeholders present in THIS image's conf, with THIS image's defaults, and
# nothing more. A CLOUDBEAVER_* name that has no placeholder in the conf is
# inert on this image no matter what upstream docs list. Seven keys
# (CB_SERVER_NAME, CB_ADMIN_NAME, CB_ADMIN_PASSWORD, CB_LOCAL_HOST_ADDR,
# CLOUDBEAVER_HOME, CLOUDBEAVER_WORKSPACE_LOCATION, NETWORK_MODE) bypass the
# conf and are read by System.getenv directly; they are marked as such.
#
# Where the docs and this image disagree, the image wins and is what is
# recorded here. The "Server configuration" reference documents the
# Enterprise/Team build: it shows a postgres-jdbc internal database, a whole
# `qm` (query manager) block, connectionBruteForce settings and
# CLOUDBEAVER_API_CALL_LOGGING_ENABLED. None of those exist in the CE conf,
# so those variables do nothing here. Its defaults also differ from CE's for
# anonymousAccessEnabled (docs false / CE true), forwardProxy (docs true / CE
# false), bindSessionToIp (docs dbeaverDomains / CE disable) and the theme
# (docs light / CE system). Conversely the docs mark
# anonymousUserRole, contentRoot, driversLocation and serviceURI as "Not
# available" as environment variables; the CE conf does expose all four.
#
# The compose sets only CB_SERVER_NAME. On its own that key does nothing:
# CBApplication.performAutoConfiguration bails unless CB_SERVER_NAME,
# CB_ADMIN_NAME and CB_ADMIN_PASSWORD are ALL non-empty. Leave the admin pair
# blank and CloudBeaver shows its first-run setup wizard on the initial visit,
# which is the out-of-the-box behaviour; fill both in and the wizard is
# skipped and the admin account is created unattended at first boot.
#
# Two more environment reads are deliberately not declared, because nothing an
# operator sets could help: KUBERNETES_SERVICE_HOST (injected by Kubernetes,
# read only to label the deployment type in the system-info report) and the
# baked-in JAVA_HOME / PATH from the base image.

# @defaultSensitive=false @defaultRequired=infer
# @docs("CloudBeaver server configuration", https://dbeaver.com/docs/cloudbeaver/Server-configuration/)
# ---

# ─── First-boot auto configuration ────────────────────────────────────────
# Read by System.getenv, not through conf/cloudbeaver.conf. All three must be
# non-empty or the whole block is ignored and the setup wizard runs instead.
# They are consumed once, on the first boot against an empty workspace;
# changing them later does nothing until the workspace volume is reset.
# @docs("Server configuration", https://dbeaver.com/docs/cloudbeaver/Server-configuration/)

# Display name for this server, shown in the UI title and in the admin
# console. The compose passes it through as ${CB_SERVER_NAME:-CloudBeaver}.
CB_SERVER_NAME=CloudBeaver

# Login for the administrator account created at first boot. Upstream's own
# default elsewhere is "cbadmin". Empty means: no unattended setup, the
# browser wizard asks for it instead.
CB_ADMIN_NAME=

# Password for that administrator account. Must satisfy the password policy
# below (8+ characters, mixed case, at least one digit by default) or first
# boot fails and the wizard runs.
# @sensitive
# @docs("Password policy", https://dbeaver.com/docs/cloudbeaver/Password-policy/)
CB_ADMIN_PASSWORD=

# ─── Web server ───────────────────────────────────────────────────────────

# Port the embedded Jetty server listens on. The compose exposes container
# port 8978 with no override, so this is that port's twin: change it here and
# the exposed port stops matching, which breaks routing.
# @type=port
CLOUDBEAVER_WEB_SERVER_PORT=8978

# URI prefix the whole web application is mounted under. Set it when serving
# CloudBeaver from a sub-path of a shared hostname (e.g. "/db/").
CLOUDBEAVER_ROOT_URI=/

# GraphQL/REST API prefix, relative to CLOUDBEAVER_ROOT_URI. The bundled
# frontend derives its endpoint from this value, so changing it moves both
# sides at once.
CLOUDBEAVER_SERVICE_URI=/api/

# Redirects http:// to https:// and marks the session cookie Secure. Only
# turn on when TLS actually terminates in front of (or inside) the container;
# with plain http in front you get a redirect loop.
# @type=boolean
# @docs("Configuring HTTPS for Jetty server", https://dbeaver.com/docs/cloudbeaver/Configuring-HTTPS-for-Jetty-server/)
CLOUDBEAVER_FORCE_HTTPS=false

# Path to the Jetty SSL configuration XML, for terminating HTTPS in the
# container itself rather than at a proxy. Relative paths resolve against
# /opt/cloudbeaver. The default file does not exist in a fresh image; HTTPS
# stays off until you mount one there.
# @docs("Configuring HTTPS for Jetty server", https://dbeaver.com/docs/cloudbeaver/Configuring-HTTPS-for-Jetty-server/)
CLOUDBEAVER_SSL_CONF_PATH=workspace/.data/ssl-config.xml

# Directory holding the compiled web frontend, relative to /opt/cloudbeaver.
# Only move this if you are serving a custom-built UI bundle.
CLOUDBEAVER_CONTENT_ROOT=web

# Directory the server unpacks and caches JDBC driver jars into. Point it at
# a mounted path for an air-gapped install where drivers are pre-seeded
# instead of downloaded.
# @docs("Drivers Management", https://dbeaver.com/docs/cloudbeaver/Drivers-Management/)
CLOUDBEAVER_DRIVERS_LOCATION=drivers

# Read by System.getenv, outside the conf file. Set it to "host" (the only
# value checked, case-insensitively) when the container runs with
# --network host, so the server binds the resolved local address instead of
# the container address.
# @type=enum(host)
NETWORK_MODE=

# Read by System.getenv, outside the conf file. The address the server treats
# as "this host" when resolving CLOUDBEAVER_ROOT_URI and host-network mode.
# 127.0.0.1 and ::0 are normalised to "localhost"; empty means localhost too.
CB_LOCAL_HOST_ADDR=

# ─── Paths ────────────────────────────────────────────────────────────────
# Both read by System.getenv, outside the conf file.

# Installation root the server resolves relative paths against. Empty falls
# back to the JVM's working directory, which the image sets to
# /opt/cloudbeaver, the correct value here, so leave it alone.
CLOUDBEAVER_HOME=

# Root folder for projects, connections, scripts and the internal H2 database.
# Empty means <CLOUDBEAVER_HOME>/workspace, i.e. /opt/cloudbeaver/workspace,
# which is exactly where the compose mounts the persistent volume. Repointing
# this without moving the volume silently starts a fresh, unbacked-up install.
# @docs("CloudBeaver Workspace Backup", https://dbeaver.com/docs/cloudbeaver/CloudBeaver-Workspace-Backup/)
CLOUDBEAVER_WORKSPACE_LOCATION=

# ─── Sessions and login protection ────────────────────────────────────────

# Milliseconds of inactivity before a user session is closed
# (1800000 = 30 minutes).
# @type=number
# @docs("Session Manager", https://dbeaver.com/docs/cloudbeaver/Session-Manager/)
CLOUDBEAVER_EXPIRE_SESSION_AFTER_PERIOD=1800000

# Pins a session id to the client IP it was issued to, so a stolen cookie is
# useless from another address. CBSessionManager enables binding only when
# this reads "enable" (or "true"); every other value, "disable" included,
# leaves it off. Do not turn it on for clients behind a rotating egress IP.
# @type=enum(enable, disable)
# @docs("Session Manager", https://dbeaver.com/docs/cloudbeaver/Session-Manager/)
CLOUDBEAVER_BIND_SESSION_TO_IP=disable

# Locks out an account after repeated failed logins. Turning it off removes
# the only brute-force defence on the local auth provider.
# @type=boolean
CLOUDBEAVER_BRUTE_FORCE_PROTECTION_ENABLED=true

# Failed logins tolerated before the account is blocked.
# @type=number
CLOUDBEAVER_MAX_FAILED_LOGINS=10

# Minimum seconds enforced between login attempts.
# @type=number
CLOUDBEAVER_MINIMUM_LOGIN_TIMEOUT=1

# Seconds an account stays blocked once CLOUDBEAVER_MAX_FAILED_LOGINS is hit
# (300 = 5 minutes).
# @type=number
CLOUDBEAVER_BLOCK_PERIOD=300

# ─── Password policy ──────────────────────────────────────────────────────
# Applied to local accounts, including the one CB_ADMIN_PASSWORD creates.
# @docs("Password policy", https://dbeaver.com/docs/cloudbeaver/Password-policy/)

# @type=number
CLOUDBEAVER_POLICY_MIN_LENGTH=8
# @type=boolean
CLOUDBEAVER_POLICY_REQUIRE_MIXED_CASE=true
# Minimum digits required.
# @type=number
CLOUDBEAVER_POLICY_MIN_NUMBER_COUNT=1
# Minimum non-alphanumeric characters required; 0 means none.
# @type=number
CLOUDBEAVER_POLICY_MIN_SYMBOL_COUNT=0

# ─── Internal database ────────────────────────────────────────────────────
# Where CloudBeaver keeps its own users, teams, credentials and permissions,
# not the databases you connect to. CE bundles only the embedded H2 driver
# (io.cloudbeaver.resources.drivers.base registers h2:h2_embedded_v2), so the
# external-database drivers the docs list belong to the Enterprise build.
# @docs("Server Database", https://dbeaver.com/docs/cloudbeaver/Server-Database/)

# Driver id for the internal database. h2_embedded_v2 is the only one the CE
# image ships a driver for.
CLOUDBEAVER_DB_DRIVER=h2_embedded_v2

# JDBC URL for the internal database. The default resolves to
# jdbc:h2:${workspace}/.data/cb.h2v2.dat, i.e. a file inside the mounted
# workspace volume. ${workspace} is CloudBeaver's own placeholder, not a
# shell variable. Left empty here so it keeps that in-image default; set it
# only when moving the H2 file elsewhere.
CLOUDBEAVER_DB_URL=

# Schema inside the internal database. Empty means the driver's default,
# which is what embedded H2 wants.
CLOUDBEAVER_DB_SCHEMA=

# Credentials for the internal database. Empty for embedded H2, which needs
# none.
CLOUDBEAVER_DB_USER=
# @sensitive
CLOUDBEAVER_DB_PASSWORD=

# Seed file with the teams and permissions loaded the very first time the
# server starts against an empty database. Point at a mounted file to
# pre-create teams instead of clicking through the admin UI.
# @docs("Initial data configuration", https://dbeaver.com/docs/cloudbeaver/Initial-data-configuration/)
CLOUDBEAVER_DB_INITIAL_DATA=conf/initial-data.conf

# Internal-database connection pool.
# @type=number
CLOUDBEAVER_DB_MIN_IDLE_CONNECTIONS=4
# @type=number
CLOUDBEAVER_DB_MAX_IDLE_CONNECTIONS=10
# @type=number
CLOUDBEAVER_DB_MAX_CONNECTIONS=100
# Liveness query run against a pooled connection before handing it out.
CLOUDBEAVER_DB_VALIDATION_QUERY=SELECT 1

# Takes a copy of the internal database before schema migrations, i.e. before
# every version upgrade. Turning it off makes a failed upgrade unrecoverable.
# @type=boolean
# @docs("CloudBeaver Workspace Backup", https://dbeaver.com/docs/cloudbeaver/CloudBeaver-Workspace-Backup/)
CLOUDBEAVER_DB_BACKUP_ENABLED=true

# ─── Application behaviour ────────────────────────────────────────────────

# CE defaults to anonymous access ON: anyone who can reach the port gets a
# session as the anonymous user, without logging in. Set to false for any
# instance that is reachable beyond your own network.
# @type=boolean
# @docs("Anonymous Access Configuration", https://dbeaver.com/docs/cloudbeaver/Anonymous-Access-Configuration/)
CLOUDBEAVER_APP_ANONYMOUS_ACCESS_ENABLED=true

# Team whose permissions the anonymous user inherits. "user" is the built-in
# team seeded by conf/initial-data.conf.
# @docs("Teams", https://dbeaver.com/docs/cloudbeaver/Teams/)
CLOUDBEAVER_APP_ANONYMOUS_USER_ROLE=user

# Team every newly created account joins.
# @docs("Teams", https://dbeaver.com/docs/cloudbeaver/Teams/)
CLOUDBEAVER_APP_DEFAULT_USER_TEAM=user

# Whether the shared connections defined by the administrator are visible to
# the anonymous team as well.
# @type=boolean
CLOUDBEAVER_APP_GRANT_CONNECTIONS_ACCESS_TO_ANONYMOUS_TEAM=false

# Lets ordinary users define their own connections to arbitrary hosts. Off by
# default: only the administrator can create connections, which is what keeps
# an anonymous-access instance from becoming an open database proxy.
# @type=boolean
CLOUDBEAVER_APP_SUPPORTS_CUSTOM_CONNECTIONS=false

# Shows host/port/credential details of a connection to users who only hold
# read permission on it.
# @type=boolean
CLOUDBEAVER_APP_READ_ONLY_CONNECTION_INFO=false

# Allows ${ENV_VAR} references inside connection settings to be resolved from
# the server's own environment. Off by default because it lets anyone who can
# edit a connection read the container's environment.
# @type=boolean
CLOUDBEAVER_SYSTEM_VARIABLES_RESOLVING_ENABLED=false

# Trusts X-Forwarded-For / X-Forwarded-Proto so logs and IP-based session
# binding see the real client rather than the proxy. Turn on only when a
# proxy you control actually sets those headers.
# @type=boolean
# @docs("Reverse proxy header authentication", https://dbeaver.com/docs/cloudbeaver/Reverse-proxy-header-authentication/)
CLOUDBEAVER_APP_FORWARD_PROXY=false

# Whether users may save database credentials in the server-side cache, and
# whether the administrator may save credentials on shared connections. Both
# off means every connection prompts for a password each session.
# @type=boolean
CLOUDBEAVER_APP_PUBLIC_CREDENTIALS_SAVE_ENABLED=true
# @type=boolean
CLOUDBEAVER_APP_ADMIN_CREDENTIALS_SAVE_ENABLED=true

# Enables the scripts/resources tree (saved SQL scripts stored in the
# workspace). Off hides the whole panel.
# @type=boolean
# @docs("Resource Manager", https://dbeaver.com/docs/cloudbeaver/Resource-Manager/)
CLOUDBEAVER_APP_RESOURCE_MANAGER_ENABLED=true

# ─── Resource quotas ──────────────────────────────────────────────────────
# Server-side ceilings that protect the container from one expensive session.

# Largest saved script, in bytes (500000 ≈ 488 KiB).
# @type=number
CLOUDBEAVER_RESOURCE_QUOTA_RESOURCE_MANAGER_FILE_SIZE_LIMIT=500000
# Concurrent running queries across the whole server.
# @type=number
CLOUDBEAVER_RESOURCE_QUOTA_SQL_MAX_RUNNING_QUERIES=100
# Hard cap on rows a single result set may fetch.
# @type=number
CLOUDBEAVER_RESOURCE_QUOTA_SQL_RESULT_SET_ROWS_LIMIT=100000
# Characters of a text value shown in the grid before truncation.
# @type=number
CLOUDBEAVER_RESOURCE_QUOTA_SQL_TEXT_PREVIEW_MAX_LENGTH=4096
# Bytes of a binary value previewed before truncation (261120 = 255 KiB).
# @type=number
CLOUDBEAVER_RESOURCE_QUOTA_SQL_BINARY_PREVIEW_MAX_LENGTH=261120

# ─── Product settings (UI defaults) ───────────────────────────────────────
# Server-provided defaults for the web UI. Users can still change most of them
# per account unless the administrator pins them.
# @docs("Settings", https://dbeaver.com/docs/cloudbeaver/Settings/)

# "system" follows the browser's prefers-color-scheme.
# @type=enum(light, dark, system)
CLOUDBEAVER_CORE_THEMING_THEME=system

# Interface language. The 26.1.5 bundle ships en, fr, it, ru, vi and zh.
# @type=enum(en, fr, it, ru, vi, zh)
# @docs("CloudBeaver localization", https://dbeaver.com/docs/cloudbeaver/CloudBeaver-localization/)
CLOUDBEAVER_CORE_LOCALIZATION=en

# Autosave SQL editor tabs into the workspace as you type.
# @type=boolean
# @docs("SQL Editor", https://dbeaver.com/docs/cloudbeaver/SQL-Editor/)
CLOUDBEAVER_SQL_EDITOR_AUTOSAVE=true

# Removes the SQL editor entirely, giving a read-only, browse-only deployment.
# @type=boolean
CLOUDBEAVER_SQL_EDITOR_DISABLED=false

# Largest script the SQL editor will open, in kilobytes (10240 = 10 MiB).
# @type=number
CLOUDBEAVER_SQL_EDITOR_MAX_FILE_SIZE=10240

# How autocomplete writes table aliases: NONE inserts no alias, PLAIN writes
# "my_table mt", EXTENDED writes "my_table AS mt".
# @type=enum(NONE, PLAIN, EXTENDED)
CLOUDBEAVER_SQL_PROPOSALS_INSERT_TABLE_ALIAS=PLAIN

# Completion engine for the SQL editor. Anything other than DEFAULT is
# normalised to NEW by the frontend at 26.1.5.
# @type=enum(DEFAULT, NEW, COMBINE)
CLOUDBEAVER_SQL_EDITOR_CONTENT_ASSISTANT_EXPERIMENTAL_MODE=NEW

# Hides the in-app server log viewer.
# @type=boolean
# @docs("Log Viewer", https://dbeaver.com/docs/cloudbeaver/Log-Viewer/)
CLOUDBEAVER_LOG_VIEWER_DISABLED=false

# Log records fetched per request, and the ceiling the viewer keeps in memory.
# @type=number
CLOUDBEAVER_LOG_VIEWER_LOG_BATCH_SIZE=1000
# @type=number
CLOUDBEAVER_LOG_VIEWER_MAX_LOG_RECORDS=2000

# ─── Runtime and container ────────────────────────────────────────────────

# Extra JVM flags, spliced into the java command line by
# run-cloudbeaver-server.sh. The usual reason to set this is heap sizing on a
# small host, e.g. "-Xmx1500m". CloudBeaver ships no memory limit of its own.
JAVA_OPTS=

# Verbose server logging plus the GraphQL console at /api/gql. Development
# only: the console is an unauthenticated view of the schema.
# @type=boolean
# @docs("Command line parameters", https://dbeaver.com/docs/cloudbeaver/Command-line-parameters/)
CLOUDBEAVER_DEVEL_MODE=false

# The entrypoint (launch-product.sh) starts as root, chowns the workspace to
# DBEAVER_UID:DBEAVER_GID and then drops to TARGET_USER. TARGET_* default to
# the dbeaver account baked into the image (uid/gid 8978); DBEAVER_UID and
# DBEAVER_GID are image-level ENV that the same script re-reads, so they are
# overridable but only make sense together with a matching account inside the
# container. Getting these wrong leaves the workspace owned by a user the
# server cannot write as.
TARGET_USER=dbeaver
# @type=number
TARGET_UID=8978
# @type=number
TARGET_GID=8978
# @type=number
DBEAVER_UID=8978
# @type=number
DBEAVER_GID=8978

# Container hostname, read by System.getenv purely to label this node in the
# admin system-information panel. Docker sets it to the container id; there is
# no reason to override it.
HOSTNAME=

# IANA timezone for the JVM (tzdata is installed in the base image). Empty
# means UTC, so server-side log timestamps and any server-evaluated date
# default to UTC.
TZ=

# Locale and charset for the JVM. The image bakes en_US.UTF-8; changing it
# changes how the server decodes non-ASCII values on the way in and out.
LANG=en_US.UTF-8
