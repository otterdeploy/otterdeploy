# soketi 1.6.1 environment schema (@env-spec / varlock format).
#
# Source: the `envVariables` map in src/cli/cli.ts at tag 1.6.1 (the ONLY
# place soketi reads the environment: `overwriteOptionsFromEnv()` walks that
# map and does `process.env["SOKETI_" + name]`), with defaults read off the
# `options` literal at the top of src/server.ts. Nothing else in the codebase
# touches process.env, so a variable that is not in that map is silently
# ignored no matter what any docs page says.
#
# UPSTREAM IS EFFECTIVELY UNMAINTAINED. 1.6.1 was released 2024-03-25 and is
# still the newest release; the default branch (1.x) has had no functional
# commit since October 2023 (the last commit is a README edit); the open
# dependabot PRs from 2025 were closed without merging; the repo is not
# archived but has 140+ open issues and no releases in ~2.5 years. The image
# is Node 16.20.2 on Debian bullseye. Node 16 went end-of-life 2023-09-11 and
# will never receive another security patch, and the locked dependency tree
# (axios 0.27.2, mysql2 3.6.1, pm2 5.3.0) carries known advisories that
# upstream is not going to fix. Treat this as frozen software: keep it on a
# private network, in front of a TLS-terminating proxy, and do not expose the
# metrics port.
#
# Two parsing quirks of `overwriteOptionsFromEnv()` that shape every entry
# below:
#   1. `process.env[...] || null`: an EMPTY value is discarded, so a variable
#      that is present but blank silently falls back to the built-in default.
#      That is how a blank app key/secret becomes the published literals.
#   2. every value is run through `JSON.parse()` and, if that succeeds, the
#      parsed value is used. So "true"/"false"/"0" become booleans/numbers
#      (which is what makes the compose's string flags work), but an
#      all-numeric app secret becomes a NUMBER, and any value with JSON
#      punctuation in it is reinterpreted. Keep secrets alphanumeric.

# @defaultSensitive=false @defaultRequired=infer
# @docs("soketi environment variables", https://docs.soketi.app/getting-started/environment-variables)
# ---

# ─── Default app credentials (set by the compose) ────────────────────────

# The Pusher app id clients and server SDKs authenticate with. The compose
# passes `${SOKETI_APP_ID:-app-id}`, so leaving SOKETI_APP_ID unset ships the
# upstream literal `app-id`. That one is not a secret on its own; the key and
# the secret below are what matter.
# @docs("Array driver (the default app)", https://docs.soketi.app/app-management/array-driver)
SOKETI_DEFAULT_APP_ID=${SOKETI_APP_ID:-app-id}

# SECURITY, the single most important line in this file. soketi's built-in
# defaults for the one array-driver app are the PUBLISHED literals
# `app-id` / `app-key` / `app-secret` (src/server.ts, appManager.array.apps[0]
# at 1.6.1). Because an empty environment value is discarded (quirk 1 above),
# deploying with SOKETI_APP_KEY blank does not fail. It silently restores
# `app-key`, and anyone on the internet who can reach port 6001 can then
# subscribe to every channel on this server, including private- and presence-
# channels, and (with the secret) sign auth responses and publish events as
# your backend. Generate both: `openssl rand -hex 24`.
# @required @sensitive
SOKETI_DEFAULT_APP_KEY=${SOKETI_APP_KEY}

# The app secret. Used as the HMAC key for the Pusher REST API signature and
# for private/presence channel auth signatures: it is the whole authorization
# story, there is no second factor. Same blank-falls-back-to-`app-secret`
# hazard as the key. Never ship it to the browser; only your backend holds it.
# @required @sensitive
SOKETI_DEFAULT_APP_SECRET=${SOKETI_APP_SECRET}

# What the operator actually types. The compose maps these three onto the
# SOKETI_DEFAULT_APP_* variables above. SOKETI_APP_ID is optional and falls
# back to the literal `app-id`; the other two are not optional.
SOKETI_APP_ID=

# The public app key. It ships to the browser, so it is not a password, but
# it is the only thing naming the app, and leaving it blank restores the
# published default `app-key`. Generate: `openssl rand -hex 24`. Keep it
# alphanumeric: values that parse as JSON are converted (quirk 2 above).
# @required @sensitive
# @docs("Client configuration", https://docs.soketi.app/getting-started/client-configuration)
SOKETI_APP_KEY=

# The private app secret, held only by your backend. It signs every REST API
# call and every private/presence channel auth response, so possession of it
# is complete authority over this server. Blank restores the published default
# `app-secret`. Generate: `openssl rand -hex 24`.
# @required @sensitive
# @docs("Backend configuration", https://docs.soketi.app/getting-started/backend-configuration)
SOKETI_APP_SECRET=

# SECURITY. The compose sets this to "true", which is NOT soketi's default
# (upstream default is false). It lets connected browsers publish `client-*`
# events directly to each other on private/presence channels, the Laravel
# Echo "whisper" feature. It is what makes typing indicators and cursors work
# without a backend round-trip, and it also means any client that can join a
# channel can broadcast arbitrary payloads to everyone else on it, with no
# server-side validation. Set it to "false" if you only ever publish from your
# backend.
# @type=boolean
SOKETI_DEFAULT_APP_ENABLE_CLIENT_MESSAGES=true

# Whether the built-in app is served at all. Setting it to "false" with the
# array driver leaves the server with zero apps, so every connection is
# rejected. Only useful when you have switched SOKETI_APP_MANAGER_DRIVER to a
# database.
# @type=boolean
SOKETI_DEFAULT_APP_ENABLED=true

# Maximum simultaneous websocket connections for this app. -1 is unlimited.
# @type=number
SOKETI_DEFAULT_APP_MAX_CONNS=-1

# Require clients to authenticate as a user (Pusher's `signin` flow) before
# they can subscribe. Off by default; turning it on breaks clients that do not
# implement the flow.
# @type=boolean
# @docs("User authentication", https://docs.soketi.app/advanced-usage/user-authentication)
SOKETI_DEFAULT_APP_USER_AUTHENTICATION=false

# Webhooks for this app, as a JSON array (it is JSON.parse'd like every other
# value), e.g. a single-line
# `[{"url":"https://example.com/hook","event_types":["channel_occupied"]}]`.
# Empty means no webhooks. Payloads are signed with the app secret.
# @docs("App webhooks", https://docs.soketi.app/advanced-usage/app-webhooks)
SOKETI_DEFAULT_APP_WEBHOOKS=

# ─── Per-app rate limits ─────────────────────────────────────────────────

# Events per second your BACKEND may publish through the REST API. -1 is
# unlimited, which is the default and is fine on a private network; put a real
# number here if the HTTP API is reachable from anywhere untrusted.
# @type=number
# @docs("Broadcast rate limiting", https://docs.soketi.app/rate-limiting-and-limits/broadcast-rate-limiting)
SOKETI_DEFAULT_APP_MAX_BACKEND_EVENTS_PER_SEC=-1

# Client (`client-*`) events per second per connection. Only meaningful while
# SOKETI_DEFAULT_APP_ENABLE_CLIENT_MESSAGES is true, and if it is true and
# this is -1, one browser tab can flood every other subscriber unthrottled.
# @type=number
SOKETI_DEFAULT_APP_MAX_CLIENT_EVENTS_PER_SEC=-1

# Read requests per second against the REST API (channel listings, presence
# member lists). -1 is unlimited.
# @type=number
SOKETI_DEFAULT_APP_MAX_READ_REQ_PER_SEC=-1

# Which limiter backs the counters above. `local` is per-process memory and is
# correct for a single container; `redis` shares the counters across replicas
# (and then needs SOKETI_DB_REDIS_*); `cluster` uses the built-in
# node-discover mesh.
# @type=enum(local, redis, cluster)
SOKETI_RATE_LIMITER_DRIVER=local

# ─── Server ──────────────────────────────────────────────────────────────

# Address the websocket/HTTP server binds to. 0.0.0.0 is what a container
# needs; narrowing it makes the service unreachable from the proxy.
SOKETI_HOST=0.0.0.0

# Port the server listens on. The compose exposes container port 6001 with no
# override, so changing this without changing the exposed port breaks routing.
# @type=port
SOKETI_PORT=6001

# Which halves of the process run: `full` does both, `server` accepts
# connections only, `worker` only drains the queue. Anything else disables
# both and the container starts but serves nothing.
# @type=enum(full, server, worker)
# @docs("Running modes", https://docs.soketi.app/advanced-usage/horizontal-scaling/running-modes)
SOKETI_MODE=full

# Prefix prepended to every HTTP route (`/apps/...`, `/ready`, `/metrics`),
# for serving soketi under a subpath of a shared hostname. Must start with a
# slash and must match what the proxy strips, or every route 404s.
SOKETI_PATH_PREFIX=

# Verbose per-connection logging on stdout. The compose sets "0", which
# JSON-parses to the number 0 (falsy) and therefore means off. Turning it on
# logs message payloads, so do not leave it on with real traffic.
# @type=boolean
SOKETI_DEBUG=0

# Milliseconds to keep serving after SIGTERM/SIGINT before closing sockets, so
# in-flight events drain and clients reconnect to another replica.
# @type=number
# @docs("Graceful shutdowns", https://docs.soketi.app/advanced-usage/graceful-shutdowns)
SOKETI_SHUTDOWN_GRACE_PERIOD=3000

# Milliseconds a client has to complete the `signin` handshake when
# SOKETI_DEFAULT_APP_USER_AUTHENTICATION is on, before it is disconnected.
# @type=number
SOKETI_USER_AUTHENTICATION_TIMEOUT=30000

# Percentage of used memory above which /accept-traffic starts answering
# "no", so a load balancer stops sending this node new connections. Existing
# connections are untouched.
# @type=number
# @docs("New traffic redirection", https://docs.soketi.app/advanced-usage/enhancing-performance/new-traffic-redirection)
SOKETI_HTTP_ACCEPT_TRAFFIC_MEMORY_THRESHOLD=85

# ─── TLS (in-process) ────────────────────────────────────────────────────

# Paths INSIDE the container to a certificate and its key. Setting either one
# flips the server from ws:// to wss:// wholesale. Normally you leave these
# empty and terminate TLS at the reverse proxy in front of the service;
# soketi's own TLS path has had no maintenance since 2023.
# @docs("SSL configuration", https://docs.soketi.app/getting-started/ssl-configuration)
SOKETI_SSL_CERT=
SOKETI_SSL_KEY=
# Passphrase for an encrypted key, and an optional CA bundle path.
# @sensitive
SOKETI_SSL_PASS=
SOKETI_SSL_CA=

# ─── App manager (where apps come from) ──────────────────────────────────

# `array` serves exactly the one app defined by the SOKETI_DEFAULT_APP_*
# variables above and is what this template is built around. `mysql`,
# `postgres` and `dynamodb` read apps from a table instead, and then need the
# matching SOKETI_DB_* / SOKETI_APP_MANAGER_* settings and a schema you create
# yourself.
# @type=enum(array, mysql, postgres, dynamodb)
# @docs("App management", https://docs.soketi.app/app-management/introduction)
SOKETI_APP_MANAGER_DRIVER=array

# Cache app lookups so a database-backed manager is not queried per
# connection. Meaningless with the array driver. TTL is in seconds; -1 caches
# forever, which means credential changes never take effect until restart.
# @type=boolean
SOKETI_APP_MANAGER_CACHE_ENABLED=false
# @type=number
SOKETI_APP_MANAGER_CACHE_TTL=-1

# ─── Adapter (horizontal scaling) ────────────────────────────────────────

# How replicas share channel state. `local` keeps it in one process, correct
# for a single container, and WRONG the moment you run two, because a message
# published to one replica never reaches subscribers on the other. Use `redis`
# (or `nats`) as soon as this scales past one instance.
# @type=enum(local, redis, nats, cluster)
# @docs("Horizontal scaling", https://docs.soketi.app/advanced-usage/horizontal-scaling)
SOKETI_ADAPTER_DRIVER=local

# Key prefix for the adapter's Redis pub/sub channels. Set it if several
# soketi deployments share one Redis, otherwise they will cross-talk.
# @docs("Redis adapter configuration", https://docs.soketi.app/advanced-usage/horizontal-scaling/redis-configuration)
SOKETI_ADAPTER_REDIS_PREFIX=

# Milliseconds a cross-node request (presence member lists, channel counts)
# waits before giving up, and whether the Redis endpoint is a cluster.
# @type=number
SOKETI_ADAPTER_REDIS_REQUESTS_TIMEOUT=5000
# @type=boolean
SOKETI_ADAPTER_REDIS_CLUSTER_MODE=false

# ─── Redis connection ────────────────────────────────────────────────────

# One connection block shared by every Redis-backed driver: adapter, cache,
# queue and rate limiter all spread `options.database.redis` (verified in
# src/adapters/redis-adapter.ts, redis-cache-manager.ts, redis-queue-driver.ts
# and redis-rate-limiter.ts). Point the host at a Redis resource on the same
# network; the defaults 127.0.0.1:6379 refer to the container itself and will
# just fail to connect.
# @docs("Redis configuration", https://docs.soketi.app/getting-started/redis-configuration)
SOKETI_DB_REDIS_HOST=127.0.0.1
# @type=port
SOKETI_DB_REDIS_PORT=6379
# @type=number
SOKETI_DB_REDIS_DB=0
SOKETI_DB_REDIS_USERNAME=
# @sensitive
SOKETI_DB_REDIS_PASSWORD=
# Prefix for every key soketi writes, so it can share a Redis with other
# tenants without colliding.
SOKETI_DB_REDIS_KEY_PREFIX=

# ─── Cache and queue ─────────────────────────────────────────────────────

# Where channel/app cache entries live. `memory` is per-process; `redis` lets
# replicas share (and uses the connection above).
# @type=enum(memory, redis)
# @docs("Caching", https://docs.soketi.app/advanced-usage/caching)
SOKETI_CACHE_DRIVER=memory

# How webhook deliveries are dispatched. `sync` sends them inline on the
# request that triggered them (fine until a slow endpoint starts blocking
# broadcasts); `redis` hands them to a BullMQ queue; `sqs` to AWS SQS.
# @type=enum(sync, redis, sqs)
# @docs("Queues", https://docs.soketi.app/advanced-usage/queues)
SOKETI_QUEUE_DRIVER=sync

# Jobs the Redis queue worker processes in parallel.
# @type=number
SOKETI_QUEUE_REDIS_CONCURRENCY=1

# Batch webhook deliveries instead of sending one HTTP request per event, and
# the window in milliseconds to collect them over.
# @type=boolean
SOKETI_WEBHOOKS_BATCHING=false
# @type=number
SOKETI_WEBHOOKS_BATCHING_DURATION=50

# ─── Metrics ─────────────────────────────────────────────────────────────

# Exposes Prometheus metrics at /metrics on the metrics port below. SECURITY:
# there is NO authentication on that server. The /usage and /ready endpoints
# are served on it unconditionally, and /metrics joins them when this is on.
# The series are labelled per app and include connection and message counts.
# This template does not publish port 9601, which is the only thing keeping it
# private; if you expose it, put an authenticating proxy in front.
# @type=boolean
# @docs("Scraping Prometheus metrics", https://docs.soketi.app/advanced-usage/scraping-prometheus-metrics)
SOKETI_METRICS_ENABLED=false

# Only `prometheus` exists at 1.6.1; any other value leaves the server without
# a metrics driver.
# @type=enum(prometheus)
SOKETI_METRICS_DRIVER=prometheus

# Bind address and port for the separate metrics/health server. It listens
# whether or not metrics are enabled, because /usage and /ready live there.
SOKETI_METRICS_HOST=0.0.0.0
# @type=port
SOKETI_METRICS_SERVER_PORT=9601

# Prefix on every exported metric name (`soketi_connected`, …). Change it only
# if it collides with something else in your Prometheus.
SOKETI_METRICS_PROMETHEUS_PREFIX=soketi_

# ─── Event, channel and presence limits ──────────────────────────────────

# Largest single event payload, in KB. Pusher-compatible clients assume 100;
# raising it lets one client pin memory across every subscriber.
# @type=number
# @docs("Events and channels limits", https://docs.soketi.app/rate-limiting-and-limits/events-and-channels-limits)
SOKETI_EVENT_MAX_SIZE_IN_KB=100

# Channels one publish may fan out to, event name length, and events per
# batched publish call.
# @type=number
SOKETI_EVENT_MAX_CHANNELS_AT_ONCE=100
# @type=number
SOKETI_EVENT_MAX_NAME_LENGTH=200
# @type=number
SOKETI_EVENT_MAX_BATCH_SIZE=10

# Maximum channel name length, and how long (seconds) cache-channel contents
# are retained.
# @type=number
SOKETI_CHANNEL_LIMITS_MAX_NAME_LENGTH=200
# @type=number
SOKETI_CHANNEL_CACHE_TTL=3600

# Presence channel ceilings: members per channel, and KB of member info each.
# Both are enforced at subscribe time, and a client over the limit is
# refused, not truncated.
# @type=number
SOKETI_PRESENCE_MAX_MEMBERS=100
# @type=number
SOKETI_PRESENCE_MAX_MEMBER_SIZE=2
