# LiteLLM 1.99.1 environment schema (@env-spec / varlock format).
#
# The compose pins ghcr.io/berriai/litellm:v1.99.1. It previously floated on
# `main-stable`; on 2026-09-04 (research date) that rolling tag resolves to the
# same digest as v1.99.1 (sha256:a53a7d3f…), so the pin freezes what was already
# being run. LiteLLM's older `vX.Y.Z-stable` release line stopped at
# v1.83.14-stable.patch.3 (2026-05-07); since then a plain `vX.Y.Z` tag IS the
# stable line and `-rc.N` / `-dev.N` are the pre-releases.
#
# Source: grep of `os.environ` / `os.getenv` / `get_secret_str` /
# `get_secret_bool` across litellm/proxy, litellm-proxy-extras/, enterprise/
# and litellm/llms at tag v1.99.1 (~330 distinct names in the proxy alone),
# cross-checked against the "All settings" reference page.
#
# HONEST SCOPE: env vars are NOT how this app is mainly configured. The proxy
# is driven by a config.yaml (model_list, router_settings, general_settings,
# litellm_settings, callbacks, guardrails) passed as `--config`. Environment
# only covers three things: (1) bootstrap state that must exist before the YAML
# is read (master key, database, log level, SSO, admin UI), (2) provider
# credentials, which the YAML references indirectly as
# `api_key: os.environ/OPENAI_API_KEY`, and (3) the feature flags below.
# Anything that looks like routing, rate limits, budgets, model aliases,
# fallbacks or guardrail config is a YAML/UI setting and is deliberately absent
# here. This compose mounts NO config.yaml and passes no `--config`, so the
# proxy boots with an empty model list and models are added through the admin
# UI, which is exactly what STORE_MODEL_IN_DB="True" turns on.
#
# The provider-credential family is ~200 names wide (one to four per provider,
# `<PROVIDER>_API_KEY` / `_API_BASE`). Listing all of them would be padding, so
# the common ones are below; any other name LiteLLM knows works whether or not
# it appears in this file. See the provider docs for the exact spelling.
#
# The compose prompts for LITELLM_MASTER_KEY and POSTGRES_PASSWORD and threads
# POSTGRES_PASSWORD into both DATABASE_URL and the bundled Postgres.

# @defaultSensitive=false @defaultRequired=infer
# @docs("All settings (config.yaml + environment)", https://docs.litellm.ai/docs/proxy/config_settings)
# ---

# ─── Core / admin credential ──────────────────────────────────────────────

# The proxy's root credential. It is simultaneously: the admin API key, the
# default admin UI password (see UI_PASSWORD), and, unless LITELLM_SALT_KEY is
# set, the encryption key for every provider API key stored in the database.
# Anyone holding it can read and spend against every provider credential the
# proxy manages, create unlimited virtual keys, and change any setting.
# Upstream docs and examples use `sk-1234`; shipping that (or any guessable
# value) hands your OpenAI/Anthropic/Bedrock spend to whoever finds port 4000.
# Generate a long random value, `sk-` prefixed by convention. If it is unset
# the proxy logs a CRITICAL line and treats EVERY caller as an internal user
# with no admin access, so the API is then effectively unauthenticated.
# @required @sensitive @type=string(minLength=32)
# @docs("Virtual Keys / master key", https://docs.litellm.ai/docs/proxy/virtual_keys)
LITELLM_MASTER_KEY=

# Key used to encrypt provider credentials at rest in the database (the values
# behind models added through the UI). Falls back to LITELLM_MASTER_KEY when
# unset. Setting it decouples the two, so the master key can be rotated without
# re-entering every provider key, but the salt key itself is then permanent:
# change it (or lose it) and every stored credential becomes undecryptable and
# must be re-entered by hand. Decide before first boot, not after.
# @sensitive @type=string(minLength=32)
# @docs("Production best practices (salt key)", https://docs.litellm.ai/docs/proxy/prod)
LITELLM_SALT_KEY=

# Lets models, credentials and proxy settings be created from the admin UI and
# persisted to Postgres instead of living only in a config.yaml. The compose
# sets it because it mounts no config file. Without it the UI's "Add model"
# path returns an error and the proxy serves no models at all. The trade-off is
# that provider API keys then live in the database, encrypted with
# LITELLM_SALT_KEY / LITELLM_MASTER_KEY.
# @type=boolean
# @docs("Model management (STORE_MODEL_IN_DB)", https://docs.litellm.ai/docs/proxy/model_management)
STORE_MODEL_IN_DB=True

# Path INSIDE the container to a config.yaml, an alternative to the `--config`
# CLI flag. This compose mounts no such file, so leave empty unless you add a
# volume for one.
CONFIG_FILE_PATH=

# Fetch config.yaml from object storage at boot instead of from disk, the only
# way to give this container a config file without adding a volume. TYPE is
# "s3" or "gcs"; all three are needed together, plus the matching cloud
# credentials (AWS_* / GOOGLE_APPLICATION_CREDENTIALS).
# @type=enum(s3, gcs)
LITELLM_CONFIG_BUCKET_TYPE=
LITELLM_CONFIG_BUCKET_NAME=
LITELLM_CONFIG_BUCKET_OBJECT_KEY=

# "PRODUCTION" skips the model-cost-map network fetch and other dev-only
# startup work. Defaults to "DEV" inside litellm/__init__.py.
# @type=enum(DEV, PRODUCTION)
LITELLM_MODE=PRODUCTION

# Serve the whole proxy under a URL prefix (e.g. "/litellm") when it sits
# behind a path-routing reverse proxy. Empty means mounted at the root, which
# is what otterdeploy's routing gives it.
SERVER_ROOT_PATH=

# The proxy's own externally reachable base URL. Required for SSO: it is what
# the OAuth callback and the UI's post-login redirect are built from. Set it to
# this service's public URL when you enable any of the SSO blocks below.
# @type=url
PROXY_BASE_URL=

# Enterprise licence key. Without it the proxy runs fully as OSS; a handful of
# features (SSO beyond a small user count, allowed_ips, custom docs title,
# audit logs) refuse to start and say so.
# @sensitive
# @docs("Enterprise features", https://docs.litellm.ai/docs/enterprise)
LITELLM_LICENSE=

# Comma-separated list of browser origins allowed to call the proxy. Empty
# leaves LiteLLM's permissive default in place; set it if browsers on other
# origins will call this proxy directly with a virtual key.
LITELLM_CORS_ORIGINS=

# Sends a Strict-Transport-Security header. Only meaningful when the proxy is
# reached over HTTPS; otterdeploy terminates TLS in front of it.
# @type=boolean
LITELLM_ENABLE_HSTS=false

# Hide the auto-generated OpenAPI surface: NO_DOCS removes /docs and /redoc,
# NO_OPENAPI removes /openapi.json, NO_REDOC removes only /redoc. Worth turning
# on for an internet-exposed proxy so the full admin API is not self-describing.
# @type=boolean
NO_DOCS=false
# @type=boolean
NO_OPENAPI=false
# @type=boolean
NO_REDOC=false

# ─── Database (bundled Postgres) ──────────────────────────────────────────

# Postgres connection string, assembled by the compose from POSTGRES_PASSWORD
# and the bundled db service's hostname. This is what turns on every stateful
# feature: virtual keys, teams, budgets, spend logs, the admin UI's model
# store. The container runs Prisma migrations against it at startup, so the
# role needs DDL rights (the bundled `litellm` role owns the database).
# @required @sensitive
# @docs("What the database stores", https://docs.litellm.ai/docs/proxy/db_info)
DATABASE_URL=postgresql://litellm:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/litellm

# Optional read-only endpoint (e.g. an Aurora reader). Read queries go here,
# writes stay on DATABASE_URL. Pointless with the single bundled Postgres.
# @sensitive
DATABASE_URL_READ_REPLICA=

# Non-pooled connection used only by Prisma migrations, for deployments whose
# DATABASE_URL points at a transaction pooler (PgBouncer, Supabase pooler).
# Irrelevant with the bundled Postgres.
# @sensitive
DIRECT_URL=

# Postgres schema to put LiteLLM's tables in. Empty means `public`. Set it to
# share one database with another application.
DATABASE_SCHEMA=

# "true" skips the Prisma schema push/migrate at startup. Use it when the
# database user is intentionally read-only on DDL and migrations are applied
# out of band; the proxy will then fail at runtime if the schema is behind.
# @type=boolean
DISABLE_SCHEMA_UPDATE=false

# When migrations fail at startup, the entrypoint aborts (default). Set to
# "false" for log-only behaviour. The container then starts with a possibly
# stale schema, which is how you get half-working endpoints instead of a clear
# crash. Only for deliberate recovery.
# @type=boolean
ENFORCE_PRISMA_MIGRATION_CHECK=true

# Push spend logs to a separate service instead of writing them to the proxy's
# own database, for high-volume deployments. Empty keeps them in Postgres.
# @type=url
SPEND_LOGS_URL=

# Truncates prompts before they are written to the spend-log table. Guards
# against a single long request bloating the database; also limits how much
# prompt text is retained at rest.
# @type=number
MAX_STRING_LENGTH_PROMPT_IN_DB=

# Superuser role of the bundled Postgres, created on first boot. It is the same
# user baked into DATABASE_URL above; changing it here alone only breaks the pair.
POSTGRES_USER=litellm

# Password for that role, generated on deploy and threaded into DATABASE_URL.
# It is only reachable on the stack's private network, but anyone who can read
# it can read every stored provider credential's ciphertext, which is only as
# strong as LITELLM_SALT_KEY / LITELLM_MASTER_KEY. Rotating it means updating
# both the database role and DATABASE_URL.
# @required @sensitive
POSTGRES_PASSWORD=

# Database created on first boot. Baked into DATABASE_URL above.
POSTGRES_DB=litellm

# ─── Admin UI ─────────────────────────────────────────────────────────────

# Username for the UI's built-in username/password login. Defaults to "admin"
# in the code when unset.
# @docs("Admin UI", https://docs.litellm.ai/docs/proxy/ui)
UI_USERNAME=

# Password for that login. When empty, the UI accepts LITELLM_MASTER_KEY as the
# password instead, so leaving this blank means the browser login form and the
# API admin credential are the same secret, and typing it into a shared browser
# is equivalent to handing over full API admin. Set a distinct value here (and
# treat losing it as a config change, not an account recovery) if more than one
# person opens the UI.
# @sensitive
UI_PASSWORD=

# "true" removes the admin UI entirely; the REST API still works. The right
# setting for a proxy that is only ever driven by config.yaml and API calls,
# except that this deployment has no config.yaml, so disabling the UI leaves no
# way to add a model.
# @type=boolean
DISABLE_ADMIN_UI=false

# User id treated as the proxy admin on login. Defaults to LiteLLM's internal
# "default_user_id"; set it only when matching an existing SSO identity to the
# admin role.
PROXY_ADMIN_ID=

# Comma-separated email domains allowed to sign in (SSO and invitations). Empty
# means any authenticated identity the SSO provider returns is accepted. With
# a public OAuth app that is the whole internet.
# @docs("Self-serve / user invitations", https://docs.litellm.ai/docs/proxy/self_serve)
ALLOWED_EMAIL_DOMAINS=

# Cosmetic UI overrides: logo images (URL or path inside the container), the
# browser favicon, and the OpenAPI docs title (enterprise-gated).
UI_LOGO_PATH=
UI_LOGO_PATH_DARK=
LITELLM_FAVICON_URL=
DOCS_TITLE=

# ─── SSO (optional, replaces the username/password login) ─────────────────

# Google Workspace OAuth app. Its authorised redirect URI must be
# PROXY_BASE_URL + "/sso/callback".
# @docs("Admin UI SSO", https://docs.litellm.ai/docs/proxy/admin_ui_sso)
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID app registration. MICROSOFT_TENANT is the directory
# (tenant) id; "common" allows any Microsoft account, which is rarely what you
# want for an admin console.
MICROSOFT_CLIENT_ID=
# @sensitive
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# Any other OIDC/OAuth2 provider (Keycloak, Authentik, Okta). The three
# endpoints come from the provider's discovery document; SCOPE defaults to
# "openid email profile" and USE_PKCE turns on the PKCE flow for providers that
# require it.
GENERIC_CLIENT_ID=
# @sensitive
GENERIC_CLIENT_SECRET=
# @type=url
GENERIC_AUTHORIZATION_ENDPOINT=
# @type=url
GENERIC_TOKEN_ENDPOINT=
# @type=url
GENERIC_USERINFO_ENDPOINT=
GENERIC_SCOPE=
# @type=boolean
GENERIC_CLIENT_USE_PKCE=false
# Claim on the userinfo response that carries the LiteLLM role, for mapping
# groups to proxy_admin / internal_user.
GENERIC_USER_ROLE_ATTRIBUTE=

# Where the UI sends the browser after logout. Empty returns to the login page.
# @type=url
PROXY_LOGOUT_URL=

# ─── Logging & observability ──────────────────────────────────────────────

# Log verbosity for the proxy's own logger. DEBUG prints request/response
# bodies and, in older paths, credential-shaped values. Keep it at INFO or
# above in production.
# @type=enum(DEBUG, INFO, WARNING, ERROR, CRITICAL)
# @docs("Debugging / log levels", https://docs.litellm.ai/docs/proxy/debugging)
LITELLM_LOG=INFO

# "true" emits one JSON object per log line instead of human-readable text.
# @type=boolean
JSON_LOGS=false

# Langfuse tracing. Set as a callback in config.yaml (`success_callback:
# ["langfuse"]`); these three are only the credentials it reads. HOST defaults
# to Langfuse cloud. Point it at your own instance to keep prompts in-house.
# @sensitive
# @docs("Langfuse integration", https://docs.litellm.ai/docs/observability/langfuse_integration)
LANGFUSE_PUBLIC_KEY=
# @sensitive
LANGFUSE_SECRET_KEY=
# @type=url
LANGFUSE_HOST=

# OpenTelemetry export, used when "otel" is in the callback list. EXPORTER is
# the transport ("otlp_http", "otlp_grpc", "console"); HEADERS carries the
# collector's auth header, so treat it as a credential.
# @type=url
OTEL_ENDPOINT=
OTEL_EXPORTER=
# @sensitive
OTEL_HEADERS=
OTEL_SERVICE_NAME=
OTEL_ENVIRONMENT_NAME=

# Prometheus scraping. MULTIPROC_DIR is a writable directory inside the
# container that the metrics workers share; it is required when the proxy runs
# more than one uvicorn worker, or the /metrics numbers are per-worker garbage.
# @docs("Prometheus metrics", https://docs.litellm.ai/docs/proxy/prometheus)
PROMETHEUS_MULTIPROC_DIR=
# @type=url
PROMETHEUS_URL=

# Slack incoming webhook for budget/failure alerts, when alerting is enabled in
# general_settings. The URL is itself the credential.
# @sensitive @type=url
SLACK_WEBHOOK_URL=

# Langsmith and Datadog callback credentials, read when those callbacks are
# enabled in config.yaml.
# @sensitive
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# @sensitive
DD_API_KEY=
DD_SITE=

# ─── Redis (optional cache + cross-worker state) ──────────────────────────

# An external Redis for response caching and for sharing rate-limit and key
# state between replicas. Not part of this stack; add a Redis service and point
# these at it if you scale past one container or want prompt caching.
# @docs("Caching", https://docs.litellm.ai/docs/proxy/caching)
REDIS_HOST=
# @type=port
REDIS_PORT=
# @sensitive
REDIS_PASSWORD=

# ─── Email (invitations, key alerts) ──────────────────────────────────────

# SMTP relay for user invitations and key-created/rotated notices. Without one,
# invited users must be given their link out of band.
# @docs("Email notifications", https://docs.litellm.ai/docs/proxy/email)
SMTP_HOST=
# @type=port
SMTP_PORT=
SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=
# @type=email
SMTP_SENDER_EMAIL=
# @type=boolean
SMTP_TLS=
# @type=boolean
SMTP_USE_SSL=

# API-based alternatives to SMTP; whichever key is present is used.
# @sensitive
RESEND_API_KEY=
# @type=email
RESEND_FROM_EMAIL=
# @sensitive
SENDGRID_API_KEY=
# @type=email
SENDGRID_SENDER_EMAIL=

# ─── Provider credentials (common members of a ~200-name family) ──────────

# Upstream LLM credentials. With STORE_MODEL_IN_DB="True" you would normally
# type these into the admin UI instead, where they are encrypted in Postgres;
# setting them here keeps them out of the database and lets a config.yaml
# reference them as `api_key: os.environ/OPENAI_API_KEY`. Every one of these is
# spendable money, and a leaked proxy leaks all of them at once.
# @sensitive
# @docs("Supported providers and their env vars", https://docs.litellm.ai/docs/providers)
OPENAI_API_KEY=
# Override for OpenAI-compatible endpoints (vLLM, LM Studio, a gateway).
# @type=url
OPENAI_API_BASE=
OPENAI_ORGANIZATION=

# @sensitive
ANTHROPIC_API_KEY=
# @sensitive
GEMINI_API_KEY=
# @sensitive
MISTRAL_API_KEY=
# @sensitive
GROQ_API_KEY=
# @sensitive
COHERE_API_KEY=
# @sensitive
OPENROUTER_API_KEY=
# @sensitive
XAI_API_KEY=
# @sensitive
DEEPSEEK_API_KEY=
# @sensitive
TOGETHERAI_API_KEY=
# @sensitive
PERPLEXITY_API_KEY=
# @sensitive
FIREWORKS_AI_API_KEY=
# @sensitive
HUGGINGFACE_API_KEY=

# Azure OpenAI: key, the resource endpoint, and the api-version string that
# every deployment call is pinned to.
# @sensitive
AZURE_API_KEY=
# @type=url
AZURE_API_BASE=
AZURE_API_VERSION=

# AWS Bedrock. REGION_NAME is LiteLLM's own name for the region; AWS_REGION is
# read as a fallback. Prefer an instance/role credential over static keys where
# the host supports it.
# @sensitive
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=

# Google Vertex AI: project and region, plus either a path to a mounted service
# account JSON (GOOGLE_APPLICATION_CREDENTIALS) or the JSON itself
# (VERTEX_CREDENTIALS).
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
# @sensitive
VERTEX_CREDENTIALS=

# Base URL of an Ollama server reachable from this container, for local models.
# @type=url
OLLAMA_API_BASE=
