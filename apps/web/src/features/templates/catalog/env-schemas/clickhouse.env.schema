# ClickHouse 26.8 environment schema (@env-spec / varlock format).
#
# The compose pins clickhouse/clickhouse-server:26.8. On 2026-09-03 (research
# date) that tag resolves to 26.8.2.7, the newest patch of the 26.8 LTS line
# (GitHub tag v26.8.2.7-lts, published 2026-09-01; Docker Hub tag list:
# `26.8` == `26.8.2` == `26.8.2.7` == `latest`).
#
# Source: docker/server/entrypoint.sh at v26.8.2.7-lts (the ONLY place the
# image turns environment variables into configuration), cross-checked
# against docker/server/Dockerfile.ubuntu (baked ENV), docker/server/README.md
# (the Docker Hub image description), and a getenv grep of the server binary
# at the same tag (programs/server/Server.cpp, programs/main.cpp,
# src/Daemon/BaseDaemon.cpp, src/Common/Config/ConfigProcessor.cpp).
#
# ClickHouse is configured by XML/YAML files, not by environment: there is no
# generic `CLICKHOUSE_<SETTING>` mapping. The variables below are the whole
# surface, a fixed list the entrypoint reads plus four watchdog/debug reads
# in the binary. Anything else (listen_host, ports, storage policies, quotas,
# keeper) is a config file under /etc/clickhouse-server/, or a
# `<x from_env="MY_VAR"/>` substitution the operator writes themselves
# (ConfigProcessor.cpp:611). That mechanism can name ANY variable, so no
# such names are enumerable here.
#
# Two things the docs page does not say. (1) The entrypoint only rewrites
# users.xml when CLICKHOUSE_USER is non-`default`, or CLICKHOUSE_PASSWORD is
# non-empty, or CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT is not "0"; with none of
# those it instead pins user `default` to 127.0.0.1, so the container is
# unreachable over the network. (2) Every one of these is read ONCE, on the
# boot that initializes an empty data directory. Changing CLICKHOUSE_USER,
# CLICKHOUSE_PASSWORD or CLICKHOUSE_DB later does nothing to an existing
# volume: the users file the entrypoint writes lives in /tmp and is
# regenerated identically each boot, but the accounts and databases created
# by the init pass persist in /var/lib/clickhouse. Rotate the password with
# `ALTER USER ... IDENTIFIED BY`, not by editing this file.
#
# The image also bakes LANG=en_US.UTF-8 and CLICKHOUSE_CONFIG; both are
# declared below where an operator could plausibly need to move them.

# @defaultSensitive=false @defaultRequired=infer
# @docs("ClickHouse Docker image configuration", https://clickhouse.com/docs/get-started/setup/self-managed/docker)
# ---

# ─── Core account ─────────────────────────────────────────────────────────
# What the entrypoint writes into a users.xml overlay on first boot. Setting
# any one of the three below is what makes ClickHouse listen for remote
# connections at all.

# The account created instead of `default`. The compose uses `clickhouse`;
# `default` is the special name that means "leave the built-in user alone".
# Also the account the entrypoint's own clickhouse-client uses to run the
# init pass, so it must match CLICKHOUSE_PASSWORD.
# @docs("ClickHouse users and roles", https://clickhouse.com/docs/operations/access-rights)
# @required
CLICKHOUSE_USER=clickhouse

# Password for CLICKHOUSE_USER, in cleartext (the entrypoint wraps it in a
# CDATA section of the generated users.xml). Generated at install. Without
# it, and without a non-default user or access management, ClickHouse only
# accepts connections from inside the container.
# @required @sensitive @type=string(minLength=24)
CLICKHOUSE_PASSWORD=

# Read the password from this file instead of the variable (Docker secrets).
# Checked first: a readable file here overrides CLICKHOUSE_PASSWORD entirely.
# Leave empty unless you mount a secret.
CLICKHOUSE_PASSWORD_FILE=

# A database created with `CREATE DATABASE IF NOT EXISTS` during the init
# pass. `default` already exists, so the compose's value is a no-op that
# still forces the init pass to run (and so waits for the server to answer
# /ping before the container is considered up).
# @required
CLICKHOUSE_DB=default

# Writes `<access_management>` for CLICKHOUSE_USER. "1" lets that account run
# CREATE USER / GRANT / CREATE ROLE, i.e. be the admin of its own instance;
# "0" leaves it a plain user who can only query. Compared against the literal
# string "0", so any other value counts as on.
# @docs("Access control and account management", https://clickhouse.com/docs/operations/access-rights)
# @required @type=enum(0, 1)
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# "1" skips the users.xml overlay completely: the built-in `default` account
# stays password-less and network-reachable. That is an open database on ports
# 8123/9000, suitable only for a throwaway instance no one else can reach.
# @type=enum(0, 1)
CLICKHOUSE_SKIP_USER_SETUP=0

# ─── First-boot initialization ────────────────────────────────────────────
# The entrypoint starts the server bound to 127.0.0.1, waits for /ping, runs
# CLICKHOUSE_DB plus every file in /docker-entrypoint-initdb.d (*.sh sourced
# or executed, *.sql and *.sql.gz fed to clickhouse-client), then stops it and
# re-execs the real server. This only happens when /var/lib/clickhouse/data
# does not yet exist.

# Non-empty re-runs the init scripts on EVERY boot, not just the first. Your
# scripts must then be idempotent (IF NOT EXISTS everywhere) or the container
# fails to start. Empty = first boot only.
CLICKHOUSE_ALWAYS_RUN_INITDB_SCRIPTS=

# How many one-second attempts to reach /ping before the init pass gives up
# with "ClickHouse init process timeout." Raise it if a large existing
# dataset makes the first start slow.
# @type=number
CLICKHOUSE_INIT_TIMEOUT=1000

# ─── Container identity and paths ─────────────────────────────────────────

# Config file the server and every `extract-from-config` call read. Baked
# into the image at this value; only change it if you mount a replacement
# tree. Note that since 26.8 an unknown top-level element in the config
# aborts startup with UNKNOWN_ELEMENT_IN_CONFIG instead of being ignored.
# @docs("Configuration files", https://clickhouse.com/docs/operations/configuration-files)
CLICKHOUSE_CONFIG=/etc/clickhouse-server/config.xml

# "1" runs clickhouse-server as root instead of dropping to the `clickhouse`
# user, and skips the recursive chown of the data and log directories. Needed
# only for user-namespace remapping setups; a normal deployment leaves it off.
# @type=enum(0, 1)
CLICKHOUSE_RUN_AS_ROOT=0

# "1" keeps the drop to the `clickhouse` user but skips the chown pass over
# the mounted volumes. Use when the volume's ownership is already correct and
# the recursive chown makes startup slow on a large dataset.
# @type=enum(0, 1)
CLICKHOUSE_DO_NOT_CHOWN=0

# uid/gid to run as, overriding the image's `clickhouse` account. Only read
# when the container starts as root; with `--user` set, the entrypoint uses
# that identity and ignores these. Match them to the owner of the data volume.
# @type=number
CLICKHOUSE_UID=
# @type=number
CLICKHOUSE_GID=

# ─── Runtime and diagnostics ──────────────────────────────────────────────

# The watchdog is the supervisor process that restarts the server after a
# crash and writes the fatal log. The entrypoint sets this to "0" when unset,
# because the watchdog does not forward SIGINT and would leave the container
# unstoppable by ctrl-c; "1" turns it back on (Server.cpp:556). Any other
# value disables it explicitly.
# @type=enum(0, 1)
CLICKHOUSE_WATCHDOG_ENABLE=0

# Only meaningful with the watchdog on. "1" makes it restart the server after
# a crash instead of exiting, which hides the failure from Docker's own
# restart policy, so prefer leaving it off and letting the platform restart
# the container.
# @type=enum(0, 1)
CLICKHOUSE_WATCHDOG_RESTART=

# Only meaningful with the watchdog on. "1" stops the watchdog forwarding
# signals to the server child, so `docker stop` no longer shuts it down
# cleanly. Debugging only.
# @type=enum(0, 1)
CLICKHOUSE_WATCHDOG_NO_FORWARD=

# Presence of this variable at ANY value makes the process abort on any
# exception rather than handling it (programs/main.cpp:349). For reproducing
# a crash under a debugger, never for a deployed instance.
CLICKHOUSE_TERMINATE_ON_ANY_EXCEPTION=

# ─── Locale and timezone ──────────────────────────────────────────────────

# Container timezone, baked into the image as UTC. The server's own
# `<timezone>` config setting wins over it: BaseDaemon setenv()s TZ from the
# config at startup when that element is present. Storage is always UTC
# internally, so this only affects how naive DateTime values are rendered.
# @docs("Server setting: timezone", https://clickhouse.com/docs/operations/server-configuration-parameters/settings)
TZ=UTC

# Baked into the image. Affects character handling in the container's shell
# and clickhouse-client output, not how ClickHouse stores strings.
LANG=en_US.UTF-8
