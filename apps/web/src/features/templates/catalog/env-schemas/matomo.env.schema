# Matomo 5.13.0 environment schema (@env-spec / varlock format).
#
# The compose pins matomo:5.13.0-apache. On 2026-09-04 (research date) the
# official-images manifest maps 5.13.0-apache, 5.13-apache, 5-apache, apache,
# 5.13.0, 5.13, 5 and latest to one build (GitCommit 901bc24 of
# matomo-org/docker, Docker Hub push 2026-08-31), and matomo.org's own
# getLatestVersion API returns 5.13.0, so this is the newest stable line and
# the image repo is still being rebuilt. There is no 6.x image.
#
# Source: matomo-org/docker at 901bc242ec657e11ccdbc038598c77ef5227c45b
# (apache/Dockerfile, apache/docker-entrypoint.sh, apache/php.ini, README.md)
# plus a getenv/$_ENV grep of the Matomo 5.13.0 tarball from builds.matomo.org.
#
# Matomo is PHP and its real configuration surface is config/config.ini.php,
# NOT the environment. The whole env surface at this version is:
#   - MATOMO_DATABASE_*: FIRST RUN ONLY. Read solely by
#     plugins/Installation/FormDatabaseSetup.php, which uses them to PREFILL
#     the web installer's database form. Once the installer writes
#     config/config.ini.php (onto the matomo-html volume), the ini file is the
#     only thing Matomo reads: changing these later has NO effect. The
#     entrypoint's file_env() only expands the _FILE twins; it never writes a
#     config file itself.
#   - MATOMO_PLUGIN_DIRS / MATOMO_PLUGIN_COPY_DIR: core/Plugin/Manager.php,
#     honoured on EVERY boot.
#   - MATOMO_AIPROVIDERS_<PROVIDER>_*: new in 5.13.0
#     (plugins/AIProviders/Model/Configuration.php), honoured on EVERY boot.
#   - PHP_MEMORY_LIMIT: image-level, substituted into php.ini on every boot.
# Anything else you have seen in a community compose (MATOMO_GENERAL_*,
# MATOMO_DATABASE_PORT, MATOMO_TRUSTED_HOSTS, MATOMO_SALT …) is invented:
# 5.13.0 contains no such reads. Those live in config.ini.php only.
#
# Where the docker README is wrong: it lists six MATOMO_DATABASE_* names and
# omits MATOMO_DATABASE_SCHEMA, which the code does read. The code also
# accepts the same names WITHOUT the MATOMO_ prefix as a second-choice
# fallback (DATABASE_HOST, DATABASE_PASSWORD, …); those are deliberately not
# declared here because the generic names collide with anything else in the
# environment. Always use the prefixed form.
#
# SECURITY, read before exposing this stack:
#   1. Matomo ships with `[General] enable_installer = 1` and boots straight
#      into an UNAUTHENTICATED web installer whenever config/config.ini.php
#      has no [database] section. It is first-visitor-wins: whoever loads the
#      URL first creates the super user and owns the instance. Do not put a
#      public hostname in front of a fresh Matomo before you have walked
#      through the installer yourself.
#   2. The installer generates `[General] salt` (Common::generateUniqId(), in
#      plugins/Installation/Controller.php) and writes it into
#      config/config.ini.php. It keys session/auth cookies and token hashing.
#      It lives on the matomo-html volume, is never an env var, and losing or
#      changing it invalidates every session and API token.
#   3. Host-header poisoning: Matomo derives its own base URL from the Host
#      header. After installing, set `[General] trusted_hosts[]` in
#      config.ini.php to the exact hostnames you serve, and behind a reverse
#      proxy set `[General] proxy_client_headers[]` /
#      `proxy_host_headers[]` (and `assume_secure_protocol = 1` if TLS is
#      terminated upstream) so client IPs and generated links are right. All
#      three are ini-only; there is no env var for them.
#      Untrusted-hostname warning: https://matomo.org/faq/troubleshooting/faq_171/
#      Behind a proxy: https://matomo.org/faq/how-to-install/faq_98/

# @defaultSensitive=false @defaultRequired=infer
# @docs("Matomo Docker image README", https://github.com/matomo-org/docker)
# ---

# ─── Platform prompts ───────────────────────────────────────────────────────

# Password for the `matomo` MySQL account. otterdeploy prompts for it and
# threads the same value into MARIADB_PASSWORD on the bundled db service and
# into MATOMO_DATABASE_PASSWORD on the app.
# @docs("How do I create a new database and database user in MySQL?", https://matomo.org/faq/how-to-install/faq_23484/)
# @required
# @sensitive
MYSQL_PASSWORD=

# Root password for the bundled MariaDB. Matomo never uses it; it exists so
# the MariaDB image will initialise, and so an operator can run maintenance
# SQL. Nothing else in this stack reads it.
# @required
# @sensitive
MYSQL_ROOT_PASSWORD=

# ─── Bundled MariaDB (the `db` service) ─────────────────────────────────────

# Bootstrap variables of the official MariaDB image, not of Matomo. They are
# consumed once, when the empty matomo-db volume is initialised; editing them
# against an already-initialised volume does nothing.
# @docs("MariaDB Docker environment variables", https://mariadb.com/kb/en/mariadb-docker-environment-variables/)
# @required
MARIADB_DATABASE=matomo
# @required
MARIADB_USER=matomo
# @required
# @sensitive
MARIADB_PASSWORD=${MYSQL_PASSWORD}
# @required
# @sensitive
MARIADB_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}

# ─── Database connection (FIRST RUN ONLY) ───────────────────────────────────

# Hostname of the bundled MariaDB, resolved by otterdeploy and never typed by
# the operator. Prefills the installer's "Database Server" field. Note there
# is no MATOMO_DATABASE_PORT: the port is not in the installer's environment
# list, so a non-3306 port must be typed into the form (or written into
# config.ini.php) instead.
# @docs("Installing Matomo On-Premise", https://matomo.org/faq/on-premise/installing-matomo/)
# @required
MATOMO_DATABASE_HOST=${{stack.db.HOST}}

# PHP database driver. The installer only offers the values `PDO\MYSQL` and
# `MYSQLI` (core/Db/Adapter.php::getAdapters, uppercased); the compose's
# literal `mysql` matches neither, so the form silently falls back to the
# recommended `PDO\MYSQL`. Harmless, and the value it lands on is the one you
# want, but it means this key is effectively inert as written.
# @type=enum(PDO\MYSQL, MYSQLI, mysql)
MATOMO_DATABASE_ADAPTER=mysql

# MySQL account Matomo connects as, matching MARIADB_USER above.
# @required
MATOMO_DATABASE_USERNAME=matomo

# Password for that account, threaded from the MYSQL_PASSWORD prompt. The
# installer masks it in the form and re-reads it from here on submit, so the
# operator never sees or retypes it.
# @required
# @sensitive
MATOMO_DATABASE_PASSWORD=${MYSQL_PASSWORD}

# Schema/database name, matching MARIADB_DATABASE above.
# @required
MATOMO_DATABASE_DBNAME=matomo

# Prefix for every Matomo table. Matomo's own default is `matomo_`; the
# compose does not set it, so the installer offers that. Fixed at install
# time; changing it afterwards points Matomo at tables that do not exist.
MATOMO_DATABASE_TABLES_PREFIX=matomo_

# Storage schema implementation. `Mysql` is the only one bundled in core;
# alternatives (e.g. Tidb) come from plugins. Read by the installer but
# absent from the docker README.
MATOMO_DATABASE_SCHEMA=Mysql

# Docker-secrets twins, expanded by the image entrypoint's file_env() before
# PHP starts: each holds a path to a file whose contents become the variable
# above. Setting both a variable and its _FILE twin is a hard error at boot.
# Only these four have a _FILE form. ADAPTER, TABLES_PREFIX and SCHEMA do not.
MATOMO_DATABASE_HOST_FILE=
MATOMO_DATABASE_USERNAME_FILE=
# @sensitive
MATOMO_DATABASE_PASSWORD_FILE=
MATOMO_DATABASE_DBNAME_FILE=

# ─── PHP runtime ────────────────────────────────────────────────────────────

# Substituted into /usr/local/etc/php/conf.d/php-matomo.ini as `memory_limit`
# on every boot; the image's own default is 256M. Archiving large sites and
# the log importer are the usual reasons to raise it.
# @docs("Matomo Docker image README", https://github.com/matomo-org/docker)
PHP_MEMORY_LIMIT=256M

# ─── Plugin loading ─────────────────────────────────────────────────────────

# Extra directories to load plugins from, beyond ./plugins. Format is
# `absoluteStorageDir;webrootPathRelativeToMatomo`, multiple entries joined by
# `:` (core/Plugin/Manager.php::initPluginDirectories). Only useful if you
# mount your own plugins into the container; the paths must exist inside it.
# @docs("Matomo plugin loading (core/Plugin/Manager.php)", https://github.com/matomo-org/matomo/blob/5.13.0/core/Plugin/Manager.php)
MATOMO_PLUGIN_DIRS=

# Which of the MATOMO_PLUGIN_DIRS entries the plugin installer/updater writes
# new plugins into. Matomo throws at boot if it is set to a directory that is
# not one of those entries.
MATOMO_PLUGIN_COPY_DIR=

# ─── AI providers (new in 5.13.0) ───────────────────────────────────────────

# The bundled AIProviders plugin (enabled by default in global.ini.php) backs
# Matomo's AI features. Precedence per provider: config.ini.php `[AIProviders]`
# wins, then these variables, then whatever an admin saved in the UI. Setting
# a key here does NOT lock the settings page. Only pinning `defaultProvider`
# or `defaultCapabilityLevel` in config.ini.php does that. Read on every boot,
# so unlike the database keys these still take effect after installation.
# Leave the whole section empty to keep Matomo's AI features switched off.
# @docs("Matomo 5.13.0 changelog: [AIProviders] settings", https://github.com/matomo-org/matomo/blob/5.13.0/CHANGELOG.md)
# @sensitive
MATOMO_AIPROVIDERS_OPENAI_API_KEY=
# @sensitive
MATOMO_AIPROVIDERS_ANTHROPIC_API_KEY=
# @sensitive
MATOMO_AIPROVIDERS_GOOGLE_API_KEY=
# @sensitive
MATOMO_AIPROVIDERS_BEDROCK_API_KEY=
# The `custom-provider` id becomes CUSTOM_PROVIDER in the variable name
# (dashes are replaced with underscores before uppercasing).
# @sensitive
MATOMO_AIPROVIDERS_CUSTOM_PROVIDER_API_KEY=

# Model id to request from each provider. Empty means the provider class's
# own default model.
MATOMO_AIPROVIDERS_OPENAI_MODEL=
MATOMO_AIPROVIDERS_ANTHROPIC_MODEL=
MATOMO_AIPROVIDERS_GOOGLE_MODEL=
MATOMO_AIPROVIDERS_BEDROCK_MODEL=
MATOMO_AIPROVIDERS_CUSTOM_PROVIDER_MODEL=

# Endpoint overrides. The code reads this suffix for every provider, but only
# `bedrock` (an AWS region endpoint) and `custom-provider` (any
# OpenAI-compatible URL) actually surface it; for the hosted three the class
# hard-codes its endpoint.
# @type=url
MATOMO_AIPROVIDERS_BEDROCK_ENDPOINT_URL=
# @type=url
MATOMO_AIPROVIDERS_CUSTOM_PROVIDER_ENDPOINT_URL=

# Use AWS FIPS 140-2 validated Bedrock endpoints. Bedrock only; parsed with
# FILTER_VALIDATE_BOOLEAN, so "1"/"true"/"yes"/"on" all count as true.
# @type=boolean
MATOMO_AIPROVIDERS_BEDROCK_USE_FIPS_ENDPOINT=
