# Outline 1.10.0 (image outlinewiki/outline:1.10.0) environment schema
# (@env-spec / varlock format).
#
# Version. 1.10.0 was tagged 2026-09-02 and is the newest stable release; the
# docker.io tags 1.10.0, 1.10 and latest all resolve to
# sha256:cc9f1f05fd7cd316745b5fc9cfe01e681b1b4cf97705d1d812a5c778d7986cfd,
# pushed 2026-09-01. The repository is alive: releases every 2-6 weeks through
# 2026 and a nightly build every day. The compose previously pinned 1.9.2
# (2026-07-21), which is the settled choice, but Outline maintains no patch
# line behind the newest minor (1.9.2 is terminal on the 1.9 branch), and
# 1.10.0 fixes a run of authorization and credential defects that therefore
# exist in 1.9.2 with no backport: guests enumerating users and groups
# through mention suggestions (#13330), documents.import writing into an
# unauthorized collection when nested (#13331), collaboration tokens issued
# to API clients (#13332), loose credential handling in the OAuth client,
# batch and token-exchange paths (#13414, #13416, #13417), revision export
# authorization out of step with document export (#13603), unsanitized
# user-provided names in export storage keys (#13336), base-domain matching
# that ignored label boundaries when parsing hosts (#13419), and CSRF cookies
# that were neither Secure nor host-bound (#13203, #13426). Security beats
# maturity, so the pin moves to 1.10.0. Release notes and the published
# advisory history:
# https://github.com/outline/outline/releases/tag/v1.10.0
# https://github.com/outline/outline/security/advisories
#
# Source: the class-validator environment class at the pinned tag,
# https://github.com/outline/outline/blob/v1.10.0/server/env.ts
# plus the per-plugin subclasses under plugins/<name>/server/env.ts (oidc,
# google, slack, azure). That class IS the key list: every field reads
# exactly one `environment.<KEY>` and the constructor runs `validate(this)`
# on the next tick, printing the failed constraints and calling
# `process.exit(1)`. A raw `process.env` grep is noisier and misses the
# defaults and the cross-field constraints (`CannotUseWith`,
# `CannotUseWithout`) that decide whether a pair of keys may coexist. The
# key set is byte-identical between v1.9.2 and v1.10.0, so this bump needs no
# compose change beyond the tag. Cross-checked against
# https://github.com/outline/outline/blob/v1.10.0/.env.sample
#
# THIS INSTANCE CANNOT BE USED UNTIL AN AUTHENTICATION PROVIDER IS
# CONFIGURED. Outline has no local username/password login at all. See
# https://docs.getoutline.com/s/hosting/doc/authentication-7ViKRmRY5o
# The server starts, the health check passes, and the sign-in page offers
# nothing to click. At least one provider family must be filled in:
# OIDC (any standards-compliant provider such as Authentik, Keycloak,
# Pocket ID, Authelia, GitLab), Google, Slack, or Microsoft Entra / Azure.
# The compose wires the OIDC family because it is the one that works with
# a self-hosted identity provider; the other three are declared here as the
# common members of their families and are alternatives, not additions. SMTP
# is NOT a substitute: the email sign-in plugin registers when SMTP is set,
# but its route (plugins/email/server/auth/email.ts) only mails a link to a
# user that already exists in an existing team, so it cannot bootstrap the
# first account.
#
# Two upstream details worth knowing. Any key below can be supplied as
# `<KEY>_FILE` pointing at a file path instead (Docker secrets); the direct
# variable wins if both are set. And `.env.sample` ships the literal
# placeholder `generate_a_new_key` for both secrets. See the SECRET_KEY and
# UTILS_SECRET entries.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Hosting Outline: Configuration", https://docs.getoutline.com/s/hosting/doc/configuration-509J4lAzjo)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The fully qualified, publicly reachable origin of this instance, scheme
# included and no trailing slash (Outline strips one if present). The compose
# threads the prompted OUTLINE_URL into it. Everything user-visible is built
# from this value: OAuth/OIDC redirect URIs, the collaboration WebSocket
# origin, share links, email links and the cookie domain. It must be the URL
# the browser actually uses. Pointing it at the container's internal address
# produces an instance that loads and then fails every sign-in round trip.
# @required
# @type=url
# @docs("Docker", https://docs.getoutline.com/s/hosting/doc/docker-7pfeLP5a8t)
URL=${OUTLINE_URL}

# The URL the operator types; the compose passes it through to URL. Use the
# https:// origin you will terminate TLS on, e.g. https://docs.example.com
# @required
# @type=url
OUTLINE_URL=

# Port the server listens on inside the container. The compose exposes 3000,
# which is this value: change one without the other and nothing routes.
# @type=port
PORT=3000

# Encrypts data at rest and signs credentials: the `@Encrypted` model
# decorator (integration tokens, OAuth client secrets and authentication
# provider secrets stored in Postgres), session and email sign-in tokens,
# the CSRF token, OAuth `state`, unsubscribe links, and the signed URLs that
# hand out locally stored attachments. Must be exactly 64 hexadecimal
# characters (`openssl rand -hex 32`). CHANGING IT AFTER FIRST BOOT LOCKS
# EVERY USER OUT and makes already-encrypted rows undecryptable, so treat it
# as permanent. Upstream's `.env.sample` ships `SECRET_KEY=generate_a_new_key`
# as a placeholder; it is not a value, it is a prompt, and any instance
# running a copied example key is trivially forgeable by anyone who has read
# the same file.
# @required
# @sensitive
# @type=string(matches=/^[0-9a-fA-F]{64}$/)
SECRET_KEY=${SECRET_KEY}

# The bearer token for the unauthenticated cron endpoint
# `/api/cron/:period`, which is what drives every scheduled task (cleanup,
# export expiry, notification digests, popularity scoring). The handler in
# server/routes/api/cron/cron.ts compares this with `safeEqual` and 401s
# otherwise, so this string is the ONLY thing standing between the public
# internet and the ability to fire the task queue at will. Any non-empty
# value is accepted (the format is unchecked), so use `openssl rand -hex 32`
# and never the `generate_a_new_key` placeholder that upstream's
# `.env.sample` ships for it. Unlike SECRET_KEY it is safe to rotate.
# @required
# @sensitive
UTILS_SECRET=${UTILS_SECRET}

# Runtime mode. Anything other than "production" relaxes behaviour that
# self-hosted instances depend on: development registers the email auth
# provider with no SMTP configured and loosens the CSP.
# @type=enum(development, production, staging, test)
NODE_ENV=production

# Default interface language for new accounts, as a locale code from
# translate.getoutline.com. An unlisted code fails validation at boot.
DEFAULT_LANGUAGE=en_US

# Which of Outline's four processes this container runs. The default runs
# all of them in one container, which is what this single-service stack
# wants; splitting them (e.g. "web,websockets" here and "worker" elsewhere)
# is only worth it at scale and requires REDIS_COLLABORATION_URL.
SERVICES=collaboration,websockets,worker,web

# How many web processes to fork. Roughly one per 512MB of container memory;
# empty means a single process, which is right for a small instance. Each
# fork is a full copy of the server.
# @type=number
WEB_CONCURRENCY=

# Server log verbosity.
# @type=enum(error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info

# Comma-separated debug namespaces (e.g. "http,cache"). Empty is quiet.
DEBUG=

# Milliseconds a request may take before the server gives up and returns an
# error. Large imports and exports run on the worker, not here.
# @type=number
REQUEST_TIMEOUT=10000

# Sends anonymized install statistics to the maintainers. Set to "false" to
# opt out. `ENABLE_UPDATES` is read as a deprecated alias.
# @type=boolean
TELEMETRY=true

# A release identifier reported alongside errors (usually a commit SHA).
RELEASE=

# ─── TLS, proxying and rate limits ───────────────────────────────────────

# Redirects every plain-HTTP request to https. Leave it ON. Turning it off is
# only correct when TLS is terminated in front of Outline AND that proxy is
# the only path to the container; on a directly reachable instance it means
# session cookies and OIDC codes travel in the clear, and the server logs a
# warning saying so at boot.
# @type=boolean
# @docs("SSL", https://docs.getoutline.com/s/hosting/doc/ssl-pzk7WO8d1n)
FORCE_HTTPS=true

# Whether X-Forwarded-Proto / X-Forwarded-For from an upstream proxy are
# believed. Two ways to get this wrong. Set to "false" behind a TLS-
# terminating proxy and Outline cannot tell the request was https, so the
# CSRF cookie loses its host-bound `__Host-` prefix and a sibling subdomain
# can write it. The server warns about exactly this at boot. Leave it "true"
# with the container directly exposed and any client can forge its own source
# IP, which is what the rate limiter and the audit log key on.
# @type=boolean
PROXY_HEADERS_TRUSTED=true

# Which header carries the client IP when behind a proxy. Empty means
# X-Forwarded-For; "X-Real-IP" and "X-Client-IP" are the other common ones.
PROXY_IP_HEADER=

# Base64-encoded private key and certificate for Outline to terminate TLS
# itself instead of a proxy. Both must be set together or boot fails. Leave
# both empty when a reverse proxy handles TLS, which is the usual shape.
# @sensitive
# @docs("Self-signed certificates", https://docs.getoutline.com/s/hosting/doc/self-signed-certificates-IcLsCLsjje)
SSL_KEY=
SSL_CERT=

# The per-IP rate limiter in front of the API. Disabling it removes the
# throttle that protects the email sign-in code and OAuth token endpoints
# from brute force. A rate-limit bypass on exactly that path was CVE-class
# critical for Outline in early 2026. Keep it on.
# @type=boolean
RATE_LIMITER_ENABLED=true

# Requests allowed per IP per window before throttling.
# @type=number
RATE_LIMITER_REQUESTS=1000

# The window, in seconds, after which the request budget refills.
# @type=number
RATE_LIMITER_DURATION_WINDOW=60

# Realtime/collaboration connections allowed per IP per window.
# @type=number
RATE_LIMITER_COLLABORATION_REQUESTS=50

# Scales every hard-coded per-endpoint limit at once. 1 keeps upstream's
# tuning; values below 1 tighten, above 1 loosen. Raising this weakens the
# per-route protection on the auth endpoints, which are deliberately much
# stricter than the global limit above.
# @type=number
RATE_LIMITER_MULTIPLIER=1

# Comma-separated IPs or CIDR ranges that Outline's SSRF guard will allow
# outbound requests to, despite being private. Needed only when the OIDC
# provider or a webhook target lives on the same private network. Every
# entry here is a hole in the guard that stops a document link from making
# the server fetch an internal address, so list exact hosts, not /8s.
ALLOWED_PRIVATE_IP_ADDRESSES=

# Allows `unsafe-inline` in the script-src CSP directive. Named for
# development because that is the only place it belongs; enabling it in
# production removes the header that contains an injected-script bug.
# @type=boolean
DEVELOPMENT_UNSAFE_INLINE_CSP=false

# ─── Bundled Postgres ────────────────────────────────────────────────────

# Connection string for the bundled Postgres, assembled by the platform from
# the sibling service's hostname and the password below. Outline needs
# Postgres 14 or newer; the stack ships 16. Individual DATABASE_HOST /
# _PORT / _NAME / _USER / _PASSWORD keys exist as an alternative but cannot
# be combined with this one. Setting both fails validation at boot.
# @required
# @sensitive
# @docs("Requirements", https://docs.getoutline.com/s/hosting/doc/requirements-ULdYnwi4wG)
DATABASE_URL=postgres://outline:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/outline

# Password for the bundled Postgres role, used by both the database
# container and the connection string above.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Role and database name created on the bundled Postgres' first boot. They
# are baked into DATABASE_URL above; changing one without the other leaves
# Outline unable to authenticate.
POSTGRES_USER=outline
POSTGRES_DB=outline

# Passed straight through to libpq. "disable" is correct here because the
# database is a sibling container on a private network and the image has no
# certificate; anything stricter fails the handshake. Point DATABASE_URL at
# an external managed Postgres and this must become "require" or stronger.
# @type=enum(disable, allow, prefer, require, verify-ca, verify-full)
# @docs("libpq sslmode", https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNECT-SSLMODE)
PGSSLMODE=disable

# Optional read-replica connection string; read queries are routed to it to
# take load off the primary. `DATABASE_URL_READ_ONLY` is a deprecated alias.
# @sensitive
DATABASE_READ_ONLY_URL=

# Optional separate pooler (PgBouncer and friends) connection string.
# @sensitive
DATABASE_CONNECTION_POOL_URL=

# Sequelize pool bounds. Empty uses the driver defaults, which are right for
# one web process; raise the maximum only in step with WEB_CONCURRENCY and
# your Postgres `max_connections`.
# @type=number
DATABASE_CONNECTION_POOL_MIN=
# @type=number
DATABASE_CONNECTION_POOL_MAX=

# A Postgres schema to confine Outline's tables to. Empty uses `public`.
DATABASE_SCHEMA=

# ─── Bundled Redis ───────────────────────────────────────────────────────

# Connection string for the bundled Redis, resolved by the platform from the
# sibling service's hostname. Redis holds the BullMQ job queues, the
# websocket fan-out and the collaboration presence state, and Outline will
# not start without it. Note there is no database index after the port.
# @required
REDIS_URL=redis://${{stack.redis.HOST}}:6379

# A second Redis dedicated to the collaboration service, needed only when
# collaboration runs as more than one process. Empty keeps it on the Redis
# above, which is correct for this single-container stack.
# @sensitive
REDIS_COLLABORATION_URL=

# Milliseconds between Redis health-check PINGs, and the milliseconds a PING
# may take before the connection is treated as stuck and reconnected.
# @type=number
REDIS_HEALTHCHECK_INTERVAL=30000
# @type=number
REDIS_HEALTHCHECK_TIMEOUT=5000

# ─── Authentication: OIDC (the family this stack wires) ──────────────────

# OAuth client credentials from your identity provider. The OIDC provider
# registers only when BOTH are set together with either OIDC_ISSUER_URL or
# the three URIs below; either one alone fails validation at boot. The
# provider's redirect URI must be exactly <URL>/auth/oidc.callback
# @required
# @docs("OIDC", https://docs.getoutline.com/s/hosting/doc/oidc-8CPBm6uC0I)
OIDC_CLIENT_ID=${OIDC_CLIENT_ID}
# @required
# @sensitive
OIDC_CLIENT_SECRET=${OIDC_CLIENT_SECRET}

# The provider's issuer URL. Set it and Outline reads
# <issuer>/.well-known/openid-configuration at boot and discovers the
# authorize, token, userinfo and logout endpoints itself, which is simpler
# and less to get wrong than the three URIs below. Leave it empty when
# supplying them manually, which is what this compose does.
# @type=url
OIDC_ISSUER_URL=

# The provider's authorization, token and userinfo endpoints, supplied
# manually because this compose does not use discovery. All three are
# required together with the client credentials; miss one and the OIDC
# provider silently does not register and the sign-in page has no button.
# @required
# @type=url
OIDC_AUTH_URI=${OIDC_AUTH_URI}
# @required
# @type=url
OIDC_TOKEN_URI=${OIDC_TOKEN_URI}
# @required
# @type=url
OIDC_USERINFO_URI=${OIDC_USERINFO_URI}

# Label on the sign-in button, at most 50 characters. Upstream's default is
# "OpenID Connect"; the compose sets "SSO".
OIDC_DISPLAY_NAME=SSO

# Which userinfo claim becomes the Outline username.
OIDC_USERNAME_CLAIM=preferred_username

# Space-separated scopes requested at authorization. "openid profile email"
# is the minimum that yields a usable profile; add provider-specific scopes
# (e.g. "groups") only if you need them.
OIDC_SCOPES=openid profile email

# The provider's end-session endpoint. Without it (or a discovered
# equivalent) signing out of Outline leaves the provider session live, so
# the next visit signs straight back in.
# @type=url
OIDC_LOGOUT_URI=

# When OIDC is the only provider, Outline skips its own sign-in page and
# redirects straight to the provider. Set to "true" to keep the Outline page
# visible. The usual reason is to reach the sign-out confirmation when no
# OIDC_LOGOUT_URI is configured.
# @type=boolean
OIDC_DISABLE_REDIRECT=

# ─── Authentication: alternatives to OIDC ────────────────────────────────

# Sign in with Google Workspace. An alternative to the OIDC block above, not
# an addition. Set both halves or neither. Create an OAuth 2.0 Client ID of
# type "Web application" and add <URL>/auth/google.callback as an authorized
# redirect URI.
# @docs("Google Cloud credentials console", https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Sign in with Slack, and the same credentials power the Slack unfurl and
# slash-command integrations. Both halves together; redirect URI
# <URL>/auth/slack.callback. `SLACK_KEY` / `SLACK_SECRET` are read as
# deprecated aliases.
# @docs("Slack apps", https://api.slack.com/apps)
SLACK_CLIENT_ID=
# @sensitive
SLACK_CLIENT_SECRET=

# Sign in with Microsoft Entra ID (formerly Azure AD). Register an
# application, add <URL>/auth/azure.callback as a redirect URI, and set the
# directory (tenant) ID so single-tenant sign-in is scoped correctly.
# @docs("Register an application with Microsoft Entra", https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app)
AZURE_CLIENT_ID=
# @sensitive
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ─── File storage ────────────────────────────────────────────────────────

# Where uploaded attachments live. The compose sets "local", which writes to
# the container volume below. That is self-contained, and the whole instance's
# uploads are then part of the volume you must back up. Upstream's own
# default is "s3".
# @type=enum(local, s3)
# @docs("File storage", https://docs.getoutline.com/s/hosting/doc/file-storage-N4M0T6Ypu7)
FILE_STORAGE=local

# Directory inside the container for local storage. The compose mounts the
# outline-data volume at exactly this path; change it and uploads land on
# the container filesystem and vanish on the next deploy.
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# Largest single attachment, in bytes. The compose raises upstream's 1000000
# (1MB) to 26214400 (25MB). Any reverse proxy in front needs a matching body
# limit or the upload fails before Outline sees it.
# @type=number
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400

# Largest single document import, and largest whole-workspace import, in
# bytes. Empty falls back to FILE_STORAGE_UPLOAD_MAX_SIZE above.
# @type=number
FILE_STORAGE_IMPORT_MAX_SIZE=
# @type=number
FILE_STORAGE_WORKSPACE_IMPORT_MAX_SIZE=

# Milliseconds allowed for fetching a remote file into storage during an
# import before giving up.
# @type=number
FILE_STORAGE_IMPORT_TIMEOUT=60000

# Ceiling on a generated export, in bytes. Empty means the container's total
# memory, which is the honest limit since exports are assembled in memory.
# @type=number
MAXIMUM_EXPORT_SIZE=

# S3 (or S3-compatible) credentials, region and bucket, used only when
# FILE_STORAGE is "s3". The bucket needs CORS allowing your URL origin, or
# uploads fail in the browser with no server-side error.
# @sensitive
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_UPLOAD_BUCKET_NAME=

# Endpoint the bucket is reached at. Set this to the provider's endpoint
# for any non-AWS S3 API (MinIO, R2, Wasabi, Backblaze).
AWS_S3_UPLOAD_BUCKET_URL=

# Path-style bucket URLs (host/bucket/key rather than bucket.host/key).
# Required by most S3-compatible providers; upstream defaults it to true.
# @type=boolean
AWS_S3_FORCE_PATH_STYLE=true

# Canned ACL applied to uploaded objects. "private" is the only safe value
# for a bucket serving attachments: anything public makes every uploaded
# file readable by its URL alone, without Outline's permission check.
AWS_S3_ACL=private

# Presigned upload method. "post" is the traditional multipart form upload;
# "put" is a single presigned PUT and is required by providers that do not
# implement presigned POST, notably Cloudflare R2.
# @type=enum(put, post)
AWS_S3_UPLOAD_METHOD=post

# ─── Email ───────────────────────────────────────────────────────────────

# SMTP server for invitations, document notifications, export-ready mails
# and email sign-in codes. Without it Outline runs, but no invite ever
# arrives and users must be created through the identity provider. Mutually
# exclusive with SMTP_SERVICE.
SMTP_HOST=

# A nodemailer well-known service name (e.g. "SendGrid", "Postmark") instead
# of a host/port pair. Mutually exclusive with SMTP_HOST and SMTP_PORT.
# @docs("Nodemailer SMTP transport", https://nodemailer.com/smtp)
SMTP_SERVICE=

# Port on the SMTP server. 587 for STARTTLS submission, 465 for implicit
# TLS, 25 for a local relay.
# @type=port
SMTP_PORT=

# SMTP credentials. Leave both empty for an unauthenticated internal relay.
SMTP_USERNAME=
# @sensitive
SMTP_PASSWORD=

# The envelope From address, and an optional Reply-To. The From address must
# be one your SMTP provider is allowed to send as, or every message is
# rejected or silently spam-filed.
# @type=email
SMTP_FROM_EMAIL=
# @type=email
SMTP_REPLY_EMAIL=

# Use implicit TLS for the connection (true, the default, suits port 465).
# Setting it false does not mean unencrypted: STARTTLS is still used if the
# server offers it, unless SMTP_DISABLE_STARTTLS below turns that off too.
# Setting both to disable encryption sends credentials in the clear.
# @type=boolean
SMTP_SECURE=true

# Refuse STARTTLS even when the server advertises it.
# @type=boolean
SMTP_DISABLE_STARTTLS=false

# Hostname Outline identifies as in the SMTP EHLO. Empty uses the
# container's hostname, which some strict relays reject.
SMTP_NAME=

# Override the TLS cipher list for the SMTP connection. Only needed for old
# relays that negotiate nothing modern.
SMTP_TLS_CIPHERS=

# ─── Collaboration and workers ───────────────────────────────────────────

# External origin of the collaboration websocket service, if it is somewhere
# other than URL (unusual). Empty derives it from URL with the scheme
# switched to ws/wss.
COLLABORATION_URL=

# How many live clients may be joined to one document at a time.
# @type=number
COLLABORATION_MAX_CLIENTS_PER_DOCUMENT=100

# Concurrent events and concurrent tasks processed per worker process.
# Multiply by the number of workers for total concurrency.
# @type=number
WORKER_CONCURRENCY_EVENTS=10
# @type=number
WORKER_CONCURRENCY_TASKS=10

# Time window in seconds over which webhook failures are counted, and the
# failure percentage within that window that disables the webhook.
# @type=number
WEBHOOK_FAILURE_TIME_WINDOW=86400
# @type=number
WEBHOOK_FAILURE_RATE_THRESHOLD=80

# ─── Outline as an OAuth provider ────────────────────────────────────────

# Lifetimes in seconds for the access tokens, refresh tokens and
# authorization codes Outline issues to third-party apps and MCP clients.
# Longer access tokens mean a stolen one stays usable longer.
# @type=number
# @docs("OAuth provider", https://docs.getoutline.com/s/hosting/doc/oauth-provider-9YJWoe3BJN)
OAUTH_PROVIDER_ACCESS_TOKEN_LIFETIME=3600
# @type=number
OAUTH_PROVIDER_REFRESH_TOKEN_LIFETIME=2592000
# @type=number
OAUTH_PROVIDER_AUTHORIZATION_CODE_LIFETIME=300

# Turns off OAuth Dynamic Client Registration, i.e. makes POST
# /oauth/register unavailable. Left false, any client that can reach the
# instance can register itself an OAuth client without an operator in the
# loop; set it true unless you rely on MCP clients self-registering.
# @type=boolean
OAUTH_DISABLE_DCR=false

# ─── Observability ───────────────────────────────────────────────────────

# Sentry project DSN for server and browser error reporting, and an optional
# same-origin tunnel path that keeps ad blockers from dropping the browser
# half. The DSN is embedded in the client bundle, so treat it as public-ish
# but still not something to paste around.
# @sensitive
# @type=url
# @docs("Sentry projects", https://sentry.io/settings/projects/)
SENTRY_DSN=
# @type=url
SENTRY_TUNNEL=

# Datadog API key for server metrics, and the service name they are tagged
# with.
# @sensitive
DD_API_KEY=
DD_SERVICE=outline

# A Google Analytics measurement ID (v3 or v4). Setting it also adds
# googletagmanager to the CSP; leave empty and that origin stays blocked.
# @docs("Google Analytics", https://developers.google.com/analytics)
GOOGLE_ANALYTICS_ID=

# ─── Misc ────────────────────────────────────────────────────────────────

# Serve JS, CSS and images from a CDN in front of this instance. The CDN's
# origin must be URL; get that wrong and the app loads a stale or empty
# bundle.
# @type=url
CDN_URL=

# Which search backend to use. "postgres" is Postgres full-text search, the
# only provider present in the community edition.
SEARCH_PROVIDER=postgres

# Dropbox app key that enables embedding Dropbox files in documents. Public
# by design: it is shipped to the browser.
DROPBOX_APP_KEY=

# Tuning for the popularity score behind "trending" ordering: the time-decay
# constant (higher decays faster), how many weeks of activity are counted,
# and how often the score is recomputed.
# @type=number
POPULARITY_GRAVITY=0.7
# @type=number
POPULARITY_ACTIVITY_THRESHOLD_WEEKS=2
# @type=number
POPULARITY_UPDATE_INTERVAL_HOURS=12
