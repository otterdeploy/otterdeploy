# Jaeger 1.76.0 (all-in-one, in-memory storage) environment schema
# (@env-spec / varlock format).
#
# The compose pins jaegertracing/all-in-one:1.76.0. That is the newest tag the
# repo has: v1.76.0 (2025-12-03) is the FINAL Jaeger v1 release and `latest`
# on this repo shares its digest
# (sha256:ab6f1a1f0fb49ea08bcd19f6b84f6081d0d44b364b6de148e1798eb5816bacac).
# Everything the project has shipped since is v2, which lives in a DIFFERENT
# image (jaegertracing/jaeger) and is an OpenTelemetry-Collector build
# configured by a YAML config file; none of the variables below exist there.
# v1 reached end-of-life on 2025-12-31: the binary itself prints that banner to
# stderr on every start (cmd/internal/flags/service.go, PrintV1EOL), and there
# will be no further v1 bug fixes or security patches. Treat a v2 move as its
# own migration, not a tag bump.
# Migration guide: https://www.jaegertracing.io/docs/2.20/external-guides/migration/
#
# Source: flag definitions read out of the v1.76.0 source tree
# (cmd/collector/app/flags/flags.go, cmd/query/app/flags.go,
# cmd/internal/flags/{flags.go,admin.go}, internal/storage/v1/memory/options.go,
# internal/sampling/samplingstrategy/file/options.go,
# internal/config/{tlscfg,corscfg}/flags.go, internal/tenancy/flags.go,
# ports/ports.go), plus the direct os.Getenv reads in
# internal/storage/v1/factory/config.go, internal/storage/metricstore/factory_config.go
# and internal/sampling/samplingstrategy/metafactory/factory_config.go.
#
# HOW THE NAMES WORK. Jaeger v1 is Go/cobra+viper. internal/config/config.go
# calls viper.AutomaticEnv() with a key replacer that maps `-` and `.` to `_`,
# and viper upper-cases the key, so EVERY CLI flag has an env twin:
# `--collector.otlp.grpc.host-port` is COLLECTOR_OTLP_GRPC_HOST_PORT,
# `--memory.max-traces` is MEMORY_MAX_TRACES. Four names below are NOT flag
# twins but real os.Getenv reads with no flag: SPAN_STORAGE_TYPE,
# DEPENDENCY_STORAGE_TYPE, SAMPLING_STORAGE_TYPE, METRICS_STORAGE_TYPE,
# SAMPLING_CONFIG_TYPE.
#
# STORAGE BACKEND. This template runs the in-memory store: traces live in the
# container's heap and are LOST on every restart, redeploy or OOM. There is no
# volume and nothing to back up. That makes it a fine local/staging trace
# viewer and a bad system of record. Jaeger v1 also supports Cassandra,
# Elasticsearch/OpenSearch, Kafka and gRPC remote storage, each with its own
# large flag family (`--cassandra.*`, `--es.*`, `--kafka.*`); NONE of those
# variables are listed here because they are inert unless SPAN_STORAGE_TYPE
# names that backend. Switch backends and you must consult the CLI reference
# for that backend's flags.
#
# SECURITY: READ THIS. Jaeger v1 ships NO authentication and NO authorization,
# on the UI, the query API or the collector. Anyone who can reach port 16686
# can read every trace you have collected (URLs, SQL, headers, user IDs and
# whatever else your SDKs put in span attributes); anyone who can reach 4317 or
# 4318 can inject arbitrary spans and poison your data, or fill memory. The
# only things that exist are transport-level: TLS/mTLS on each server
# (`*.tls.enabled` + `*.tls.client-ca`, declared below), CORS origin lists, and
# `query.bearer-token-propagation`, which merely FORWARDS an inbound
# Authorization header to the storage backend and authenticates nothing itself.
# Upstream's own answer is to put an OAuth proxy in front. Do not expose this
# stack publicly without one.
#
# The compose sets two variables: COLLECTOR_OTLP_ENABLED and SPAN_STORAGE_TYPE.
# The image itself sets a third, SAMPLING_STRATEGIES_FILE.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Jaeger 1.76 CLI flags reference", https://www.jaegertracing.io/docs/1.76/deployment/cli/)
# ---

# ─── Storage ──────────────────────────────────────────────────────────────

# Which backend stores spans. Read directly with os.Getenv, not via a flag
# (the old `--span-storage.type` flag is deprecated and only parsed for
# backwards compatibility). all-in-one forces "memory" when this is unset, so
# the compose's value is explicit rather than load-bearing, but note that the
# collector/query binaries default to "cassandra" instead. "memory" keeps
# every trace in the process heap with no persistence. A comma-separated list
# writes to several backends; only the FIRST is read from.
# @required
# @type=enum(memory, cassandra, elasticsearch, opensearch, kafka, grpc, blackhole)
# @docs("Deployment: span storage backends", https://www.jaegertracing.io/docs/1.76/deployment/)
SPAN_STORAGE_TYPE=memory

# Caps how many traces the in-memory store keeps; the oldest are evicted past
# the limit. 0 means UNBOUNDED, which on a busy service means the container
# grows until the host OOM-kills it. Set a number if anything real points at
# this instance. Only read when SPAN_STORAGE_TYPE=memory.
# @type=number
MEMORY_MAX_TRACES=0

# Backend for the service-dependency graph. Empty means "same as the first
# SPAN_STORAGE_TYPE". With memory storage the graph is derived from the
# in-memory spans, so it resets with them.
DEPENDENCY_STORAGE_TYPE=

# Backend that persists adaptive-sampling state. Only needed when
# SAMPLING_CONFIG_TYPE=adaptive; the memory store can serve it for a
# single-process all-in-one, but the data is as volatile as the traces.
SAMPLING_STORAGE_TYPE=

# Metrics store powering the UI's "Monitor" (Service Performance Monitoring)
# tab: a Prometheus-compatible source of RED metrics, entirely separate from
# span storage. Empty leaves the Monitor tab disabled, which is what this
# template does since it bundles no Prometheus.
# @type=enum(prometheus)
# @docs("Service Performance Monitoring (SPM)", https://www.jaegertracing.io/docs/1.76/deployment/spm/)
METRICS_STORAGE_TYPE=

# ─── Collector: span ingestion ────────────────────────────────────────────

# Turns on the OpenTelemetry OTLP receivers (gRPC and HTTP). This is how
# modern SDKs and the OTel Collector send spans, and it is what the compose's
# exposed 4317/4318 exist for. With it off, both ports close and only the
# legacy Jaeger/Zipkin endpoints remain. Defaults to true in 1.76.0 anyway;
# the compose states it so an operator cannot lose it by accident.
# @required
# @type=boolean
# @docs("APIs: OTLP ingestion", https://www.jaegertracing.io/docs/1.76/architecture/apis/)
COLLECTOR_OTLP_ENABLED=true

# host:port for the OTLP/gRPC receiver, the port the compose exposes as 4317.
# A bare ":4317" binds all interfaces. Change it here and the exposed port no
# longer reaches anything.
COLLECTOR_OTLP_GRPC_HOST_PORT=:4317

# host:port for the OTLP/HTTP receiver, the compose's 4318. Traces are POSTed
# to /v1/traces on this port.
COLLECTOR_OTLP_HTTP_HOST_PORT=:4318

# Largest span batch the OTLP/gRPC receiver will accept, in bytes (4 MiB).
# Raise it if exporters report ResourceExhausted on large batches.
# @type=number
COLLECTOR_OTLP_GRPC_MAX_MESSAGE_SIZE=4194304

# Legacy Jaeger gRPC receiver (jaeger.api_v2.CollectorService). Only needed by
# old Jaeger SDKs and jaeger-agent; the compose does not expose this port.
COLLECTOR_GRPC_SERVER_HOST_PORT=:14250

# Legacy Jaeger HTTP receiver (POST /api/traces, Thrift). Same story as above:
# present in the image, not exposed by this compose.
COLLECTOR_HTTP_SERVER_HOST_PORT=:14268

# Zipkin-format receiver, DISABLED unless you give it a host:port such as
# ":9411". Only needed for Zipkin-instrumented clients.
COLLECTOR_ZIPKIN_HOST_PORT=

# Workers draining the in-process span queue into storage, and the queue's
# depth. Once the queue is full the collector DROPS spans rather than blocking
# the receiver, so a sustained ingest spike shows up as silent data loss.
# Raise QUEUE_SIZE (and watch jaeger_collector_spans_dropped_total) before
# blaming the SDK.
# @type=number
COLLECTOR_NUM_WORKERS=50
# @type=number
COLLECTOR_QUEUE_SIZE=2000

# Alternative to a fixed queue depth: size the queue by MEMORY instead, in
# MiB, sampled from observed span sizes. Non-zero overrides COLLECTOR_QUEUE_SIZE.
# @type=number
COLLECTOR_QUEUE_SIZE_MEMORY=0

# Comma-separated key=value tags stamped onto every span this collector
# accepts, e.g. "env=prod,cluster=eu1". A value written as ${VAR} or
# ${VAR:default} is resolved from the environment at start
# (cmd/internal/flags/flags.go).
COLLECTOR_TAGS=

# Emits per-span size metrics. Useful when tuning COLLECTOR_QUEUE_SIZE_MEMORY,
# a little extra cardinality otherwise.
# @type=boolean
COLLECTOR_ENABLE_SPAN_SIZE_METRICS=false

# ─── Query service and UI ─────────────────────────────────────────────────

# host:port of the HTTP server that serves BOTH the Jaeger UI and the query
# API (the port the compose exposes as 16686). This is the surface with no
# authentication in front of it.
# @docs("Deployment: query service", https://www.jaegertracing.io/docs/1.76/deployment/)
QUERY_HTTP_SERVER_HOST_PORT=:16686

# host:port of the query gRPC API (jaeger.api_v2.QueryService), used by other
# Jaeger components and by grpc clients. Not exposed by this compose.
QUERY_GRPC_SERVER_HOST_PORT=:16685

# Path prefix for every HTTP route, for serving the UI under a sub-path of a
# reverse proxy, e.g. "/jaeger". Leave "/" when the service owns its own
# hostname, which is the case here.
QUERY_BASE_PATH=/

# Path INSIDE the container to a JSON file customising the UI: menu links,
# banner text, tracking, dependency-graph options, the "Monitor" tab. Needs a
# mounted file, so it is empty by default.
# @docs("Frontend/UI configuration", https://www.jaegertracing.io/docs/1.76/deployment/frontend-ui/)
QUERY_UI_CONFIG=

# Directory override for the built UI assets. Only for serving a custom
# jaeger-ui build; the image's bundled assets are used when empty.
QUERY_STATIC_FILES=

# Logs every static-asset request. Debugging aid, noisy in normal operation.
# @type=boolean
QUERY_LOG_STATIC_ASSETS_ACCESS=false

# Forwards the caller's Authorization bearer token to the storage backend
# (Elasticsearch/OpenSearch) instead of using the configured credentials.
# This does NOT authenticate anyone against Jaeger itself (the UI stays
# open), and it is inert with memory storage.
# @type=boolean
# @docs("Securing a Jaeger installation", https://www.jaegertracing.io/docs/1.76/deployment/security/)
QUERY_BEARER_TOKEN_PROPAGATION=false

# Extra HTTP response headers on query responses, format "Key: Value". Repeat
# the flag for several; as one env var only a single header can be given.
# Sometimes used to bolt on CSP/HSTS headers when there is no proxy.
QUERY_ADDITIONAL_HEADERS=

# Maximum amount by which the UI shifts span timestamps to compensate for
# clock skew between hosts, as a Go duration (e.g. "30s"). "0s" disables the
# adjustment, which is the 1.76.0 default; spans then render with their raw,
# possibly inconsistent, timestamps.
QUERY_MAX_CLOCK_SKEW_ADJUSTMENT=0s

# Makes the query service emit traces about ITSELF, exported over OTLP to
# OTEL_EXPORTER_OTLP_ENDPOINT. Pointing it at this same instance is a useful
# self-test and an easy way to fill memory storage with noise.
# @type=boolean
QUERY_ENABLE_TRACING=false

# ─── Sampling strategies served to clients ────────────────────────────────

# How remote sampling strategies are sourced: "file" reads the JSON at
# SAMPLING_STRATEGIES_FILE, "adaptive" computes per-operation rates from
# observed traffic and needs SAMPLING_STORAGE_TYPE. Read with os.Getenv;
# empty means "file". An INVALID value is fatal at boot.
# @type=enum(file, adaptive)
# @docs("Sampling", https://www.jaegertracing.io/docs/1.76/architecture/sampling/)
SAMPLING_CONFIG_TYPE=

# Path inside the container to the sampling strategies JSON. The IMAGE sets
# this (cmd/all-in-one/Dockerfile) and ships a file whose default strategy is
# probabilistic with param 1, i.e. tell every client to sample 100%. Fine for
# a dev/staging tracing box, expensive for anything with real traffic; mount
# your own file over this path to change it. Only clients that ask Jaeger for
# their sampling config are affected; SDKs with a hard-coded sampler ignore it.
SAMPLING_STRATEGIES_FILE=/etc/jaeger/sampling_strategies.json

# How often the strategies file is re-read, as a Go duration. "0" (the
# default) means read once at start and never again. Edits to a mounted file
# do nothing until the container restarts.
SAMPLING_STRATEGIES_RELOAD_INTERVAL=0

# Probability handed to a service that the strategies file does not mention.
# 0.001 is one trace in a thousand.
# @type=number
SAMPLING_DEFAULT_SAMPLING_PROBABILITY=0.001

# ─── Admin, logging, metrics ──────────────────────────────────────────────

# host:port of the admin server: "/" is the health check and
# METRICS_HTTP_ROUTE is the Prometheus scrape endpoint. all-in-one defaults to
# 14269. Not exposed by this compose, so scraping it means adding that port.
# @docs("Monitoring Jaeger", https://www.jaegertracing.io/docs/1.76/monitoring/)
ADMIN_HTTP_HOST_PORT=:14269

# Minimum log level (zap levels).
# @type=enum(debug, info, warn, error, dpanic, panic, fatal)
LOG_LEVEL=info

# "json" for machine-parseable logs, "console" for human-readable ones.
# @type=enum(json, console)
LOG_ENCODING=json

# Internal metrics backend. "none" disables the /metrics endpoint entirely.
# @type=enum(prometheus, none)
METRICS_BACKEND=prometheus

# Route on the admin server where metrics are exposed.
METRICS_HTTP_ROUTE=/metrics

# Optional path to a JSON/TOML/YAML/HCL/properties file inside the container
# holding the same settings; viper merges it under the flags and env. Needs a
# mounted file.
CONFIG_FILE=

# OTLP/gRPC endpoint for Jaeger's OWN internal traces, used when
# QUERY_ENABLE_TRACING is on. A non-https:// value (or the default) exports
# insecurely; set OTEL_EXPORTER_OTLP_INSECURE=false to force TLS on an
# https:// endpoint (internal/jtracer/jtracer.go).
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=

# ─── TLS: the only transport protection available ─────────────────────────
# Jaeger v1 has no login, no API key and no RBAC. Enabling TLS here encrypts a
# hop and, with a client-CA, restricts WHO may connect via mutual TLS. That
# mTLS client certificate is the closest thing to authentication this version
# offers. All paths are paths INSIDE the container, so certificates have to be
# mounted. Setting any `*.tls.*` value while its `*.tls.enabled` is false is a
# fatal config error, not a warning.

# TLS on the UI / query HTTP server (port 16686). CLIENT_CA turns it into mTLS:
# with it unset, every client that completes the handshake is allowed.
# @type=boolean
# @docs("Securing a Jaeger installation", https://www.jaegertracing.io/docs/1.76/deployment/security/)
QUERY_HTTP_TLS_ENABLED=false
QUERY_HTTP_TLS_CERT=
# @sensitive
QUERY_HTTP_TLS_KEY=
QUERY_HTTP_TLS_CLIENT_CA=

# TLS on the query gRPC server (port 16685).
# @type=boolean
QUERY_GRPC_TLS_ENABLED=false
QUERY_GRPC_TLS_CERT=
# @sensitive
QUERY_GRPC_TLS_KEY=
QUERY_GRPC_TLS_CLIENT_CA=

# TLS on the OTLP/gRPC receiver (port 4317). With CLIENT_CA set, only
# exporters holding a certificate signed by that CA can submit spans, the
# practical way to stop span spoofing on an exposed collector.
# @type=boolean
COLLECTOR_OTLP_GRPC_TLS_ENABLED=false
COLLECTOR_OTLP_GRPC_TLS_CERT=
# @sensitive
COLLECTOR_OTLP_GRPC_TLS_KEY=
COLLECTOR_OTLP_GRPC_TLS_CLIENT_CA=

# TLS on the OTLP/HTTP receiver (port 4318).
# @type=boolean
COLLECTOR_OTLP_HTTP_TLS_ENABLED=false
COLLECTOR_OTLP_HTTP_TLS_CERT=
# @sensitive
COLLECTOR_OTLP_HTTP_TLS_KEY=
COLLECTOR_OTLP_HTTP_TLS_CLIENT_CA=

# CORS for the OTLP/HTTP receiver: which browser origins may POST spans
# directly from a page (browser-side OTel SDKs). Comma-separated; empty means
# no cross-origin browser exporter can reach it.
COLLECTOR_OTLP_HTTP_CORS_ALLOWED_ORIGINS=
COLLECTOR_OTLP_HTTP_CORS_ALLOWED_HEADERS=

# ─── Multi-tenancy ────────────────────────────────────────────────────────

# Partitions spans by a tenant header on both write and read. This is data
# SEPARATION, not access control: the header is self-asserted by the caller
# and nothing verifies it, so it only means anything behind a proxy that sets
# the header itself and strips any incoming copy.
# @type=boolean
MULTI_TENANCY_ENABLED=false
# HTTP header carrying the tenant name.
MULTI_TENANCY_HEADER=x-tenant
# Comma-separated allow-list of tenant values. Empty means any value is
# accepted.
MULTI_TENANCY_TENANTS=
