# Directus 12.3.1 environment schema (@env-spec / varlock format).
#
# Source: the canonical key list (packages/env/src/constants/directus-variables.ts),
# the canonical default list (packages/env/src/constants/defaults.ts) and a grep
# of `env['...']` across api/src at v12.3.1. The compose pins
# directus/directus:12.3.1; on 2026-09-03 the floating `12`, `12.3` and
# `latest` tags all resolve to the same digest
# (sha256:8978edf633ae28aa31464bb71c55300c94d8bc771ff3727b5fac485173283869).
#
# What the documented config reference does not tell you at this version:
#
#  * KEY is dead. Directus 9/10 wanted both KEY and SECRET; v12 reads only
#    SECRET. `KEY` survives as a stale entry in packages/env type-map.ts and
#    is not even in DIRECTUS_VARIABLES, so setting it does nothing.
#  * Directus 12 turned on active license enforcement and relicensed to
#    MSCL-1.0-GPL. Self-hosted runs on the free Core tier by default; SSO
#    login, custom permission rules on access policies, custom/self-hosted
#    LLMs and AI translations now require a license key. New instances are
#    enforced immediately, upgrades get a 30-day grace period. Everything in
#    the Auth/SSO section below is therefore inert without LICENSE_KEY.
#  * IP_TRUST_PROXY flipped from true to false in 12.0.0. Behind
#    otterdeploy's proxy every request now looks like it comes from the proxy
#    unless you turn it back on, which changes what the rate limiter and the
#    activity log record as the client IP.
#  * GET /server/health requires authentication since 12.0.0 and answers 404
#    to anonymous callers. /server/ping is the unauthenticated liveness probe.
#  * Any key matching DIRECTUS_VARIABLES also accepts a `<KEY>_FILE` twin
#    (SECRET_FILE, DB_PASSWORD_FILE, ADMIN_PASSWORD_FILE,
#    EMAIL_SMTP_PASSWORD_FILE, ...) whose value is a path read at boot. Set
#    both a key and its _FILE twin and the container exits.
#  * Any value may carry a cast prefix (`number:`, `boolean:`, `array:`,
#    `json:`, `regex:`, `string:`) to override how Directus parses it, e.g.
#    `CORS_ORIGIN=regex:.*\.example\.com`.
#  * DB_*, REDIS_*, SERVER_*, LOGGER_*, HASH_*, CONTENT_SECURITY_POLICY_*,
#    HSTS_*, STORAGE_<LOCATION>_*, AUTH_<PROVIDER>_* and EMAIL_SES_* are open
#    prefixes: every matching variable is camelCased and handed to the
#    underlying library (knex, ioredis, node http.Server, pino, argon2,
#    helmet, the storage driver, the auth driver, the AWS SDK). `__` in a key
#    becomes a nested object, so DB_SSL__REJECT_UNAUTHORIZED sets
#    `ssl.rejectUnauthorized`. The families below list the members that are
#    actually used in practice, not every reachable option.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Directus configuration reference", https://directus.com/docs/configuration/intro)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# Signs and verifies every session token, refresh token, share token and
# password-reset link. There is NO built-in value: if SECRET is empty
# Directus logs a warning and generates a random one with nanoid at boot, so
# every restart silently invalidates every session and every outstanding
# reset link, and each pm2 worker in a clustered instance signs with a
# DIFFERENT secret (logins then succeed or fail depending on which worker
# answers). Shorter than 32 bytes also warns. Generate 32+ bytes of random
# and never rotate it casually, since rotating logs everyone out.
# @required @sensitive @type=string(minLength=32)
DIRECTUS_SECRET=

# The compose passes DIRECTUS_SECRET through under the name the app reads.
# @required @sensitive
SECRET=${DIRECTUS_SECRET}

# The address Directus advertises for itself: OAuth/SSO callbacks, password
# reset and invite emails, and asset URLs are all built from it. The default
# is the relative "/" which works for browsing but produces unusable links in
# email and breaks SSO redirects; the app logs `"PUBLIC_URL" should be a full
# URL` when it is not absolute. Set it to the URL you actually open Directus
# at.
# @type=url
# @docs("General configuration", https://directus.com/docs/configuration/general)
PUBLIC_URL=

# Bind address inside the container. 0.0.0.0 is what the container network
# needs; narrowing it makes the service unreachable.
HOST=0.0.0.0

# Port the API listens on. The compose exposes container port 8055 with no
# override, so this is that port's twin. Change one without the other and
# routing breaks.
# @type=port
PORT=8055

# Listen on a unix socket instead of HOST/PORT. Set only if you also bind the
# socket path into another container; otterdeploy routes over TCP.
UNIX_SOCKET_PATH=

# Written into the project settings on first bootstrap only (the CLI
# `bootstrap` step the container entrypoint runs). Later changes are ignored;
# rename the project from Settings > Project Settings instead.
PROJECT_NAME=

# Email of the person accountable for the instance, stored in settings and
# reported with telemetry. Must parse as an email or it is skipped.
# @type=email
PROJECT_OWNER=

# Set false to stop Directus asking for / syncing project-owner info.
# @type=boolean
PROJECT_OWNER_ENABLED=true

# Where GET / redirects to. Accepts a relative path, an absolute URL, or
# false to serve nothing at the root.
ROOT_REDIRECT=./admin

# Serves the admin app under /admin. Set false for a headless API-only
# instance.
# @type=boolean
SERVE_APP=true

# Body of /robots.txt. The built-in default is the two-line
# "User-agent: *" / "Disallow: /" pair, which keeps the instance out of
# search engines; an @env-spec value is single-line, so leave this empty to
# keep that default and set it in the compose if you need a custom one.
ROBOTS_TXT=

# Max request body size. Uploads larger than this are rejected before the
# storage layer sees them.
MAX_PAYLOAD_SIZE=1mb

# Scratch directory for the extension bundler and image transforms, relative
# to /directus in the image.
TEMP_PATH=./node_modules/.directus

# Acknowledges the MSCL license terms; consumed by the license-banner and
# project-owner migrations. Leaving it false only means the banner shows.
# @type=boolean
# @docs("Licensing overview", https://directus.com/docs/licensing/overview)
ACCEPT_TERMS=false

# Node's own runtime mode. The image bakes "production" in; "development"
# loosens caching and error masking and is not appropriate for a deployment.
# @type=enum(production, development)
NODE_ENV=production

# ─── First admin account ──────────────────────────────────────────────────
# Read once, by the `directus bootstrap` step in the container entrypoint,
# when the database has no users yet. Both must be present or no admin is
# created and the UI falls through to its onboarding flow. Changing them
# later does nothing; reset the password from the UI instead.

# @required @type=email
ADMIN_EMAIL=

# @required @sensitive
ADMIN_PASSWORD=

# Optional static API token given to that first admin user. A token here is a
# permanent, non-expiring credential with full access. Prefer creating a
# scoped token from the UI.
# @sensitive
ADMIN_TOKEN=

# ─── Licensing ────────────────────────────────────────────────────────────

# License key for tiers above Core. Free for organizations under $5M revenue
# and 50 employees. Without it SSO login, custom policy rules, custom LLM
# connections and AI translations are disabled on a fresh v12 instance.
# LICENSE_KEY and LICENSE_TOKEN are mutually exclusive: setting both is a
# fatal error at boot.
# @sensitive
# @docs("Licensing overview", https://directus.com/docs/licensing/overview)
LICENSE_KEY=

# Offline/air-gapped alternative to LICENSE_KEY: a pre-signed entitlement
# token instead of one validated against Directus' license service.
# @sensitive
LICENSE_TOKEN=

# Cache namespace the resolved entitlements are stored under.
LICENSE_NAMESPACE=license

# Set false to stop the admin UI offering to add or change the license key.
# @type=boolean
LICENSE_KEY_MANAGEMENT_ENABLED=true

# ─── Database ─────────────────────────────────────────────────────────────
# Every DB_* variable is camelCased and passed straight into knex's
# connection config, so anything the driver accepts works here.

# knex client id. The image defaults to sqlite3; the compose overrides it to
# Postgres.
# @required @type=enum(pg, mysql, mariadb, sqlite3, mssql, oracledb, cockroachdb)
# @docs("Database configuration", https://directus.com/docs/configuration/database)
DB_CLIENT=pg

# PLATFORM-OWNED: the bundled Postgres service's hostname.
# @required
DB_HOST=${{stack.db.HOST}}

# @required @type=port
DB_PORT=5432

# @required
DB_DATABASE=directus

# @required
DB_USER=directus

# @required @sensitive
DB_PASSWORD=${POSTGRES_PASSWORD}

# Full connection string instead of the host/port/user fields above. When set
# for pg or cockroachdb the individual fields are ignored.
# @sensitive
DB_CONNECTION_STRING=

# TLS to the database. `true` turns it on with the driver defaults; the
# nested forms configure it: DB_SSL__REJECT_UNAUTHORIZED=false accepts a
# self-signed server cert, DB_SSL__CA takes the PEM inline and
# DB_SSL__CA_FILE takes a path to it inside the container. Not needed for the
# bundled Postgres, which is on the private stack network.
DB_SSL=
# @type=boolean
DB_SSL__REJECT_UNAUTHORIZED=
DB_SSL__CA=
DB_SSL__CA_FILE=

# knex connection pool bounds. Raise the max only alongside Postgres'
# max_connections; each pm2 worker keeps its own pool.
# @type=number
DB_POOL__MIN=
# @type=number
DB_POOL__MAX=
# @type=number
DB_POOL__IDLE_TIMEOUT_MILLIS=

# Postgres search_path / schema to use, when Directus does not live in
# `public`.
DB_SEARCH_PATH=

# Tables the schema inspector must ignore. The default hides the extension
# tables PostGIS and MSSQL create, which otherwise show up as broken
# collections.
DB_EXCLUDE_TABLES=spatial_ref_sys,sysdiagrams

# Pin the server version when auto-detection is wrong (e.g. a Postgres-wire
# proxy that misreports itself).
DB_VERSION=

# Milliseconds the database may take to answer before the `database`
# healthcheck reports degraded.
# @type=number
DB_HEALTHCHECK_THRESHOLD=

# Driver-specific alternatives to a TCP host: SQLite's file path, MySQL's
# unix socket, Oracle's connect string and MSSQL's connection type. Unused
# with the bundled Postgres.
DB_FILENAME=
DB_SOCKET_PATH=
DB_CONNECT_STRING=
DB_TYPE=

# ─── Bundled Postgres ─────────────────────────────────────────────────────
# Consumed by the postgres:16-alpine sidecar the compose runs, not by
# Directus. They must stay in step with DB_USER / DB_PASSWORD / DB_DATABASE
# above; the volume keeps whatever they were at first boot, so changing them
# later locks the app out.

POSTGRES_USER=directus

# Generated at install. Also the value DB_PASSWORD is derived from.
# @required @sensitive
POSTGRES_PASSWORD=

POSTGRES_DB=directus

# ─── Sessions, tokens & security ──────────────────────────────────────────

# Lifetime of the short-lived access token handed to the SDK/API clients.
# @docs("Security and limits", https://directus.com/docs/configuration/security-limits)
ACCESS_TOKEN_TTL=15m

# How long a refresh token, and the session cookie the admin app uses, stay
# valid. SESSION_* covers the cookie-based session mode the admin app runs
# on; REFRESH_TOKEN_* covers the json/cookie login modes.
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_COOKIE_NAME=directus_refresh_token
REFRESH_TOKEN_COOKIE_DOMAIN=
# Must be true once Directus is served over HTTPS, or the browser refuses to
# store the cookie back.
# @type=boolean
REFRESH_TOKEN_COOKIE_SECURE=false
# `none` is required for cross-site embedding and itself requires secure=true.
# @type=enum(lax, strict, none)
REFRESH_TOKEN_COOKIE_SAME_SITE=lax

SESSION_COOKIE_TTL=1d
SESSION_COOKIE_NAME=directus_session_token
SESSION_COOKIE_DOMAIN=
# @type=boolean
SESSION_COOKIE_SECURE=false
# @type=enum(lax, strict, none)
SESSION_COOKIE_SAME_SITE=lax
# Window in which a just-rotated session token is still accepted, so parallel
# requests during a refresh do not fail.
SESSION_REFRESH_GRACE_PERIOD=10s

# Lifetime of the emailed invite and address-verification links.
USER_INVITE_TOKEN_TTL=7d
EMAIL_VERIFICATION_TOKEN_TTL=7d

# Comma-separated allow-lists for the `reset_url` / `invite_url` /
# `verification_url` a caller may pass to the auth endpoints. Empty means
# only PUBLIC_URL is accepted. Leave it that way unless a separate frontend
# hosts those pages, since anything listed here is a place a password-reset
# token can be sent.
PASSWORD_RESET_URL_ALLOW_LIST=
USER_INVITE_URL_ALLOW_LIST=
USER_REGISTER_URL_ALLOW_LIST=

# Milliseconds a failed login / registration is padded out to, so response
# time cannot be used to tell an existing account from a missing one.
# @type=number
LOGIN_STALL_TIME=500
# @type=number
REGISTER_STALL_TIME=750

# Whether to believe X-Forwarded-For when resolving the client IP. Changed
# from true to false in 12.0.0 to stop IP spoofing on directly-exposed
# instances. Behind otterdeploy's proxy every request otherwise records the
# proxy's address in the activity log and shares one rate-limit bucket; set
# `true`, a hop count, or a subnet/CIDR list to trust the proxy.
IP_TRUST_PROXY=false

# Read the client IP from this header instead (e.g. CF-Connecting-IP). Only
# safe when the proxy always overwrites it.
IP_CUSTOM_HEADER=

# helmet's Content-Security-Policy directives, one variable per directive:
# CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC, __SCRIPT_SRC, __IMG_SRC and
# so on. Relaxing script-src is what most custom-extension or embedded-map
# setups need, and also what removes the protection.
CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC=
CONTENT_SECURITY_POLICY_DIRECTIVES__SCRIPT_SRC=
CONTENT_SECURITY_POLICY_DIRECTIVES__IMG_SRC=

# Separate CSP applied to /assets responses, same nested form.
ASSETS_CONTENT_SECURITY_POLICY=

# HTTP Strict-Transport-Security. Only enable once HTTPS is permanent for the
# domain. Browsers cache the max-age and will refuse plain HTTP afterwards.
# @type=boolean
HSTS_ENABLED=false
# @type=number
HSTS_MAX_AGE=
# @type=boolean
HSTS_INCLUDE_SUBDOMAINS=
# @type=boolean
HSTS_PRELOAD=

# Cross-Origin-Opener-Policy. The default still allows OAuth popups to talk
# back to the opener; `same-origin` breaks popup-based SSO.
# @type=boolean
CROSS_ORIGIN_OPENER_POLICY_ENABLED=true
# @type=enum(same-origin, same-origin-allow-popups, unsafe-none)
CROSS_ORIGIN_OPENER_POLICY=same-origin-allow-popups

# argon2 parameters for password and token hashing, passed through as
# HASH_MEMORY_COST (KiB), HASH_TIME_COST (iterations), HASH_PARALLELISM,
# HASH_HASH_LENGTH, HASH_TYPE (0=argon2d, 1=argon2i, 2=argon2id),
# HASH_ASSOCIATED_DATA. Empty means the argon2 library defaults. Raising
# these invalidates nothing, but every login gets slower.
# @type=number
HASH_MEMORY_COST=
# @type=number
HASH_TIME_COST=
# @type=number
HASH_PARALLELISM=
# @type=number
HASH_HASH_LENGTH=
# @type=number
HASH_TYPE=

# ─── CORS ─────────────────────────────────────────────────────────────────
# Off by default: a browser app on another origin cannot call this API until
# you turn it on. `CORS_ORIGIN=true` reflects whatever Origin the caller
# sends, which combined with CORS_CREDENTIALS is effectively "any site may
# make authenticated requests". Name the origins instead.

# @type=boolean
CORS_ENABLED=false
CORS_ORIGIN=false
CORS_METHODS=GET,POST,PATCH,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=Content-Range
# @type=boolean
CORS_CREDENTIALS=true
# @type=number
CORS_MAX_AGE=18000

# ─── Rate limiting & backpressure ─────────────────────────────────────────
# All off by default except the registration, MCP-OAuth and pressure
# limiters. `memory` counts per pm2 worker, so with more than one worker the
# effective limit is points x workers; use `redis` to share the counter.

# @type=boolean
RATE_LIMITER_ENABLED=false
# @type=number
RATE_LIMITER_POINTS=50
# @type=number
RATE_LIMITER_DURATION=1
# @type=enum(memory, redis)
RATE_LIMITER_STORE=memory

# Instance-wide ceiling, independent of the per-IP limiter above.
# @type=boolean
RATE_LIMITER_GLOBAL_ENABLED=false
# @type=number
RATE_LIMITER_GLOBAL_POINTS=1000
# @type=number
RATE_LIMITER_GLOBAL_DURATION=1

# Caps public sign-ups; on by default because the endpoint is unauthenticated.
# @type=boolean
RATE_LIMITER_REGISTRATION_ENABLED=true
# @type=number
RATE_LIMITER_REGISTRATION_POINTS=5
# @type=number
RATE_LIMITER_REGISTRATION_DURATION=60

# Caps outbound mail, so a flow loop cannot burn an SMTP quota. The queue
# holds mails that exceeded the rate rather than dropping them.
# @type=boolean
RATE_LIMITER_EMAIL_ENABLED=false
# @type=number
RATE_LIMITER_EMAIL_POINTS=60
# @type=number
RATE_LIMITER_EMAIL_DURATION=60
# @type=number
RATE_LIMITER_EMAIL_QUEUE_SIZE=1000000

# Sheds load when the event loop stalls or memory climbs, answering 503
# instead of timing out. RSS/heap limits are off unless you set a byte count.
# @type=boolean
PRESSURE_LIMITER_ENABLED=true
# @type=number
PRESSURE_LIMITER_SAMPLE_INTERVAL=250
PRESSURE_LIMITER_MAX_EVENT_LOOP_UTILIZATION=0.99
# @type=number
PRESSURE_LIMITER_MAX_EVENT_LOOP_DELAY=500
PRESSURE_LIMITER_MAX_MEMORY_RSS=false
PRESSURE_LIMITER_MAX_MEMORY_HEAP_USED=false
PRESSURE_LIMITER_RETRY_AFTER=false

# ─── Redis (not bundled) ──────────────────────────────────────────────────
# This template ships Directus + Postgres only. Point these at a Redis
# service if you run more than one Directus instance or more than one pm2
# worker: without it the cache, the rate limiter, the lock/bus and the
# schema-sync are per-process, and workers can disagree about the schema.
# REDIS is a connection string; the REDIS_* fields are the same thing
# spelled out, and any other ioredis option can be added with the same
# prefix.

# @sensitive
# @docs("Cache configuration", https://directus.com/docs/configuration/cache)
REDIS=
# Force the Redis features on or off regardless of the other variables.
# @type=boolean
REDIS_ENABLED=
REDIS_HOST=
# @type=port
REDIS_PORT=
REDIS_USERNAME=
# @sensitive
REDIS_PASSWORD=
# @type=number
REDIS_DB=
REDIS_BUS_NAMESPACE=directus:bus
REDIS_LOCK_NAMESPACE=directus:lock
REDIS_COUNTERS_NAMESPACE=directus:counters
REDIS_PERMISSIONS_NAMESPACE=permissions

# Coordinates schema changes between instances. `redis` is required for a
# multi-instance deployment; `memory` is correct for a single container.
# @type=enum(memory, redis)
# @docs("Synchronization", https://directus.com/docs/configuration/synchronization)
SYNCHRONIZATION_STORE=memory
SYNCHRONIZATION_NAMESPACE=directus-sync

# ─── Cache ────────────────────────────────────────────────────────────────

# Off by default. Turning it on caches GET responses for CACHE_TTL, which is
# the single biggest read-throughput win and also the thing that makes stale
# content appear after an edit unless CACHE_AUTO_PURGE is on.
# @type=boolean
# @docs("Cache configuration", https://directus.com/docs/configuration/cache)
CACHE_ENABLED=false
# @type=enum(memory, redis)
CACHE_STORE=memory
CACHE_TTL=5m
CACHE_NAMESPACE=system-cache
# Flush the whole data cache whenever any item is created, updated or deleted.
# @type=boolean
CACHE_AUTO_PURGE=false
CACHE_AUTO_PURGE_IGNORE_LIST=directus_activity,directus_presets
# TTL of the internal system cache (permissions, settings). Falls back to
# CACHE_TTL when empty.
CACHE_SYSTEM_TTL=
CACHE_DEPLOYMENT_TTL=
# max-age sent to browsers and CDNs in Cache-Control. "0" keeps caching
# server-side only.
CACHE_CONTROL_S_MAXAGE=0
# Adds an X-Cache-Status: HIT/MISS response header.
CACHE_STATUS_HEADER=
# Lets a caller bypass the cache with `Cache-Control: no-store`. Off, because
# it hands any anonymous client a way to force uncached work.
# @type=boolean
CACHE_SKIP_ALLOWED=false
# Skip caching values larger than this (e.g. "5mb"); false caches everything.
CACHE_VALUE_MAX_SIZE=false
# Milliseconds the cache may take to answer before the healthcheck degrades.
# @type=number
CACHE_HEALTHCHECK_THRESHOLD=

# The schema snapshot cache, separate from the response cache and on by
# default, because reading the schema from the database on every request is
# what makes an uncached Directus slow.
# @type=boolean
CACHE_SCHEMA=true
# @type=number
CACHE_SCHEMA_MAX_ITERATIONS=100
# @type=number
CACHE_SCHEMA_SYNC_TIMEOUT=10000
# @type=boolean
CACHE_SCHEMA_FREEZE_ENABLED=false

# ─── File storage ─────────────────────────────────────────────────────────
# Comma-separated list of storage locations; each name expands into its own
# STORAGE_<NAME>_* block, and the first location listed is where new uploads
# go. The compose mounts a volume at /directus/uploads, which is what the
# default `local` location writes to. Change STORAGE_LOCAL_ROOT and the
# volume stops covering the files.

# @docs("File storage configuration", https://directus.com/docs/configuration/files)
STORAGE_LOCATIONS=local
# @type=enum(local, s3, gcs, azure, cloudinary, supabase)
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# An S3 / S3-compatible (MinIO, R2, Spaces) location. Declared as one
# representative of the driver family: every driver takes
# STORAGE_<NAME>_DRIVER plus its own fields, and swapping the driver name
# swaps which of the fields below apply. Leave key/secret empty on AWS to use
# the instance role. STORAGE_S3_FORCE_PATH_STYLE=true is required by MinIO
# and most non-AWS endpoints.
# @type=enum(local, s3, gcs, azure, cloudinary, supabase)
STORAGE_S3_DRIVER=
STORAGE_S3_ROOT=
# @sensitive
STORAGE_S3_KEY=
# @sensitive
STORAGE_S3_SECRET=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
# @type=boolean
STORAGE_S3_FORCE_PATH_STYLE=
STORAGE_S3_ACL=
STORAGE_S3_SERVER_SIDE_ENCRYPTION=
STORAGE_S3_SERVER_SIDE_ENCRYPTION_KMS_KEY_ID=
# Milliseconds the bucket may take to answer before the storage healthcheck
# degrades.
# @type=number
STORAGE_S3_HEALTHCHECK_THRESHOLD=

# Google Cloud Storage: KEY_FILENAME is the path to a service-account JSON
# file mounted into the container.
STORAGE_GCS_DRIVER=
STORAGE_GCS_ROOT=
STORAGE_GCS_BUCKET=
# @sensitive
STORAGE_GCS_KEY_FILENAME=
STORAGE_GCS_API_ENDPOINT=

# Azure Blob Storage.
STORAGE_AZURE_DRIVER=
STORAGE_AZURE_ROOT=
STORAGE_AZURE_CONTAINER_NAME=
STORAGE_AZURE_ACCOUNT_NAME=
# @sensitive
STORAGE_AZURE_ACCOUNT_KEY=
STORAGE_AZURE_ENDPOINT=

# Cloudinary. ACCESS_MODE `authenticated` makes every delivery URL signed.
STORAGE_CLOUDINARY_DRIVER=
STORAGE_CLOUDINARY_ROOT=
STORAGE_CLOUDINARY_CLOUD_NAME=
# @sensitive
STORAGE_CLOUDINARY_API_KEY=
# @sensitive
STORAGE_CLOUDINARY_API_SECRET=
# @type=enum(public, authenticated)
STORAGE_CLOUDINARY_ACCESS_MODE=

# Supabase Storage. SERVICE_ROLE is the service-role JWT, which bypasses RLS
# entirely.
STORAGE_SUPABASE_DRIVER=
STORAGE_SUPABASE_ROOT=
STORAGE_SUPABASE_BUCKET=
STORAGE_SUPABASE_PROJECT_ID=
STORAGE_SUPABASE_ENDPOINT=
# @sensitive
STORAGE_SUPABASE_SERVICE_ROLE=

# ─── Files, uploads & assets ──────────────────────────────────────────────

# Upload ceiling, e.g. "100mb". Empty means unlimited, and MAX_PAYLOAD_SIZE
# still applies to non-multipart bodies.
FILES_MAX_UPLOAD_SIZE=
FILES_MAX_UPLOAD_CONCURRENCY=Infinity
# Mime types accepted on upload; "*/*" accepts anything, including HTML and
# SVG that will be served from your own origin.
FILES_MIME_TYPE_ALLOW_LIST=*/*
FILES_CONTENT_TYPE_ALLOW_LIST=
# Delete the source file after a successful move between storage locations.
# @type=boolean
FILES_DELETE_ORIGINAL_ON_MOVE=false
# EXIF/IPTC fields copied into the file record. Widening it can persist GPS
# coordinates from user uploads.
FILE_METADATA_ALLOW_LIST=ifd0.Make,ifd0.Model,exif.FNumber,exif.ExposureTime,exif.FocalLength,exif.ISOSpeedRatings

# Resumable (tus) uploads, for large files over flaky connections. Off by
# default; the chunk size must be at least 5mb for S3 multipart.
# @type=boolean
TUS_ENABLED=false
TUS_CHUNK_SIZE=8mb
TUS_UPLOAD_EXPIRATION=10m
TUS_CLEANUP_SCHEDULE=0 * * * *

# Cache-Control lifetime on /assets responses and whether the browser must
# revalidate. These are the numbers that decide how long a replaced image
# keeps showing the old bytes.
ASSETS_CACHE_TTL=30d
# @type=boolean
ASSETS_CACHE_REVALIDATE=false
# On-the-fly image transform limits: concurrency, source and output pixel
# bounds (both 6000 since 12.3.0; the output bound used to be 3000), how
# many operations one preset may chain, and the per-image deadline. These are
# the guard against an unauthenticated caller asking for expensive resizes.
# @type=number
ASSETS_TRANSFORM_MAX_CONCURRENT=25
# @type=number
ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION=6000
# @type=number
ASSETS_TRANSFORM_IMAGE_MAX_OUTPUT_DIMENSION=6000
# @type=number
ASSETS_TRANSFORM_MAX_OPERATIONS=5
ASSETS_TRANSFORM_TIMEOUT=7500ms
# How strict sharp is about malformed images. "error" rejects them outright.
# @type=enum(none, truncated, warning, error)
ASSETS_INVALID_IMAGE_SENSITIVITY_LEVEL=warning

# Import/export guards: the deny-list blocks server-side fetches to link-local
# and unspecified addresses (SSRF via "import from URL"), and the size /
# timeout / concurrency caps bound a single import. IMPORT_MAX_FILE_SIZE is
# new in 12.2.0. Imports used to be unbounded.
IMPORT_IP_DENY_LIST=0.0.0.0,169.254.169.254
IMPORT_TIMEOUT=1h
# @type=number
IMPORT_MAX_CONCURRENCY=20
IMPORT_MAX_FILE_SIZE=50mb
IMPORT_EXPORT_NAMESPACE=directus:import-export
# @type=number
EXPORT_BATCH_SIZE=5000

# ─── Email ────────────────────────────────────────────────────────────────
# Password resets, invites and address verification all go through here. The
# default transport is `sendmail`, and the image has no MTA, so out of the
# box every one of those mails fails silently. Pick smtp/ses/mailgun and
# fill in the matching block, or accept that users cannot reset passwords.

# @type=email
# @docs("Email configuration", https://directus.com/docs/configuration/email)
EMAIL_FROM=no-reply@example.com
# @type=enum(sendmail, smtp, mailgun, ses)
EMAIL_TRANSPORT=sendmail
# Verify the transport at boot and log the result instead of failing at the
# first send.
# @type=boolean
EMAIL_VERIFY_SETUP=true
# Directory of Liquid templates overriding the built-in mails.
EMAIL_TEMPLATES_PATH=./templates

# sendmail transport.
EMAIL_SENDMAIL_NEW_LINE=unix
EMAIL_SENDMAIL_PATH=/usr/sbin/sendmail

# SMTP transport. SECURE=true means implicit TLS (port 465); leave it false
# for STARTTLS on 587. IGNORE_TLS disables encryption entirely, so use it
# only for a relay on the same private network.
EMAIL_SMTP_HOST=
# @type=port
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
# @sensitive
EMAIL_SMTP_PASSWORD=
# @type=boolean
EMAIL_SMTP_SECURE=
# @type=boolean
EMAIL_SMTP_IGNORE_TLS=
# @type=boolean
EMAIL_SMTP_POOL=
# Hostname used in the SMTP HELO/EHLO greeting.
EMAIL_SMTP_NAME=

# Mailgun transport.
# @sensitive
EMAIL_MAILGUN_API_KEY=
EMAIL_MAILGUN_DOMAIN=
# Set to api.eu.mailgun.net for EU-region accounts.
EMAIL_MAILGUN_HOST=

# Amazon SES v2 transport. The double underscore is required: it nests the
# keys under `credentials` for the AWS SDK. Leave the credentials empty to
# use an instance role.
EMAIL_SES_REGION=
# @sensitive
EMAIL_SES_CREDENTIALS__ACCESS_KEY_ID=
# @sensitive
EMAIL_SES_CREDENTIALS__SECRET_ACCESS_KEY=

# ─── Auth & SSO ───────────────────────────────────────────────────────────
# Comma-separated provider names; each name expands into its own
# AUTH_<NAME>_* block whose DRIVER decides which fields apply. Requires a
# license on v12. With the free Core tier the providers register, log a
# warning and SSO login does not work. `directus` is reserved and cannot be
# overridden. The OpenID block below stands in for the whole family
# (oauth2 / openid / ldap / saml share the naming, the driver-specific
# fields differ).

# @docs("SSO configuration", https://directus.com/docs/configuration/auth-sso)
AUTH_PROVIDERS=
# Removes email+password login entirely, leaving only the configured SSO
# providers. Lock yourself out here and the only way back is the database.
# @type=boolean
AUTH_DISABLE_DEFAULT=false
# Extra URLs the login flow may redirect back to, beyond PUBLIC_URL.
AUTH_ALLOWED_PUBLIC_URLS=

# @type=enum(local, oauth2, openid, ldap, saml)
AUTH_OIDC_DRIVER=
AUTH_OIDC_CLIENT_ID=
# @sensitive
AUTH_OIDC_CLIENT_SECRET=
# Discovery document URL, e.g. https://idp.example.com/.well-known/openid-configuration
AUTH_OIDC_ISSUER_URL=
AUTH_OIDC_SCOPE=openid profile email
# Claim used as the stable account identifier, and the claims mapped onto the
# Directus user record.
AUTH_OIDC_IDENTIFIER_KEY=
AUTH_OIDC_EMAIL_KEY=
AUTH_OIDC_FIRST_NAME_KEY=
AUTH_OIDC_LAST_NAME_KEY=
# Creates a Directus user on first SSO login. Without a DEFAULT_ROLE_ID this
# means anyone your IdP will authenticate gets an account. Scope the app
# registration, not just this flag.
# @type=boolean
AUTH_OIDC_ALLOW_PUBLIC_REGISTRATION=
AUTH_OIDC_DEFAULT_ROLE_ID=
# Re-apply the claim mapping on every login instead of only at creation.
# @type=boolean
AUTH_OIDC_SYNC_USER_INFO=
# Reject logins whose token says the address is unverified.
# @type=boolean
AUTH_OIDC_AUTH_REQUIRE_VERIFIED_EMAIL=
# Label and icon shown on the login screen.
AUTH_OIDC_LABEL=
AUTH_OIDC_ICON=
# Extra query parameters added to the authorize request, as JSON.
AUTH_OIDC_PARAMS=
# Post-login redirect targets this provider may send users to.
AUTH_OIDC_REDIRECT_ALLOW_LIST=

# ─── Realtime (WebSockets) ────────────────────────────────────────────────
# Off by default. `handshake` authenticates once with the connection;
# `strict` requires an auth message before anything else; `public` requires
# nothing and exposes whatever the public role can read.

# @type=boolean
# @docs("Realtime configuration", https://directus.com/docs/configuration/realtime)
WEBSOCKETS_ENABLED=false
# @type=boolean
WEBSOCKETS_REST_ENABLED=true
WEBSOCKETS_REST_PATH=/websocket
# @type=enum(public, handshake, strict)
WEBSOCKETS_REST_AUTH=handshake
# @type=number
WEBSOCKETS_REST_AUTH_TIMEOUT=10
# @type=boolean
WEBSOCKETS_GRAPHQL_ENABLED=true
WEBSOCKETS_GRAPHQL_PATH=/graphql
# @type=enum(public, handshake, strict)
WEBSOCKETS_GRAPHQL_AUTH=handshake
# @type=number
WEBSOCKETS_GRAPHQL_AUTH_TIMEOUT=10
# @type=boolean
WEBSOCKETS_HEARTBEAT_ENABLED=true
# @type=number
WEBSOCKETS_HEARTBEAT_PERIOD=30
# Streams the server log over a websocket for the admin app's log viewer;
# forces LOG_STYLE to raw internally.
# @type=boolean
WEBSOCKETS_LOGS_ENABLED=true
WEBSOCKETS_LOGS_PATH=/websocket/logs
WEBSOCKETS_LOGS_LEVEL=
# Collaborative editing presence/awareness. Multi-instance collab needs Redis.
# @type=boolean
WEBSOCKETS_COLLAB_ENABLED=true
WEBSOCKETS_COLLAB_STORE_NAMESPACE=collab

# ─── Extensions & Marketplace ─────────────────────────────────────────────

# Where extensions are loaded from inside the container. The compose mounts
# no volume here, so anything installed from the Marketplace lives in the
# container's writable layer and is lost on recreate unless you add one.
# @docs("Extensions configuration", https://directus.com/docs/configuration/extensions)
EXTENSIONS_PATH=./extensions
# Refuse to boot if an extension fails to load, instead of logging and
# continuing without it.
# @type=boolean
EXTENSIONS_MUST_LOAD=false
# Watch and reload extensions on change. Development only.
# @type=boolean
EXTENSIONS_AUTO_RELOAD=false
# Per-extension sandbox budget for sandboxed (untrusted) extensions: MiB of
# memory and milliseconds per invocation.
# @type=number
EXTENSIONS_SANDBOX_MEMORY=100
# @type=number
EXTENSIONS_SANDBOX_TIMEOUT=1000
# @type=number
EXTENSIONS_STORAGE_MAX_CONCURRENCY=20
# Storage location extensions are read from, when not the local filesystem.
EXTENSIONS_LOCATION=
EXTENSIONS_CACHE_TTL=
# @type=number
EXTENSIONS_LIMIT=

# What the Marketplace will install. `sandbox` allows only sandboxed
# extensions; `all` allows extensions that run with full API access, which is
# arbitrary code in your container with your database credentials.
# @type=enum(sandbox, all)
MARKETPLACE_TRUST=sandbox
MARKETPLACE_REGISTRY=

# ─── Flows ────────────────────────────────────────────────────────────────

# Which environment variables a "Run Script" operation may read. `false`
# exposes none, `true` exposes ALL of them, including SECRET and DB_PASSWORD,
# to anyone who can edit a flow. Prefer a comma-separated allow-list of
# specific keys.
# @docs("Flows configuration", https://directus.com/docs/configuration/flows)
FLOWS_ENV_ALLOW_LIST=false
# MiB and milliseconds a Run Script operation gets before it is killed.
# @type=number
FLOWS_RUN_SCRIPT_MAX_MEMORY=32
# @type=number
FLOWS_RUN_SCRIPT_TIMEOUT=10000

# ─── Query limits ─────────────────────────────────────────────────────────

# Page size when a request does not ask for one, and the hard ceiling a
# caller may ask for. QUERY_LIMIT_MAX empty means unlimited, so one
# `?limit=-1` can pull an entire collection into memory.
# @type=number
QUERY_LIMIT_DEFAULT=100
QUERY_LIMIT_MAX=
# @type=number
MAX_RELATIONAL_DEPTH=10
# @type=number
MAX_JSON_QUERY_DEPTH=10
# @type=number
QUERYSTRING_MAX_PARSE_DEPTH=10
# @type=number
QUERYSTRING_ARRAY_LIMIT=500
MAX_BATCH_MUTATION=Infinity
# @type=number
MAX_IMPORT_ERRORS=1000
# @type=number
RELATIONAL_BATCH_SIZE=25000

# Seat caps enforced on user creation, per access type.
USERS_ADMIN_ACCESS_LIMIT=Infinity
USERS_APP_ACCESS_LIMIT=Infinity
USERS_API_ACCESS_LIMIT=Infinity

# GraphQL surface. Introspection on lets any caller enumerate the schema
# their role can see.
# @type=boolean
OPENAPI_ENABLED=true
# @type=boolean
GRAPHQL_INTROSPECTION=true
# @type=number
GRAPHQL_QUERY_TOKEN_LIMIT=5000
# @type=number
GRAPHQL_SCHEMA_GENERATION_MAX_CONCURRENT=5
GRAPHQL_SCHEMA_CACHE_CAPACITY=

# ─── Retention ────────────────────────────────────────────────────────────
# Off by default, which means the activity, revision and flow-log tables grow
# forever, the usual cause of a Directus database that is mostly history.
# Turning it on runs a nightly prune to the ages below.

# @type=boolean
RETENTION_ENABLED=false
RETENTION_SCHEDULE=0 0 * * *
# @type=number
RETENTION_BATCH=500
ACTIVITY_RETENTION=90d
REVISIONS_RETENTION=90d
FLOW_LOGS_RETENTION=90d
# Seconds between auto-saved revision snapshots while editing.
# @type=number
AUTOSAVE_REVISION_INTERVAL=300

# ─── Logging ──────────────────────────────────────────────────────────────
# LOGGER_* passes anything else straight to pino, and LOGGER_HTTP_* to
# pino-http (e.g. LOGGER_HTTP_AUTOLOGGING=false to stop per-request lines).

# @type=enum(fatal, error, warn, info, debug, trace, silent)
# @docs("Logging configuration", https://directus.com/docs/configuration/logging)
LOG_LEVEL=info
# `pretty` is human readable; `raw` emits JSON lines for a log shipper and is
# forced internally when the realtime log stream is on.
# @type=enum(pretty, raw)
LOG_STYLE=pretty
# Request paths excluded from the HTTP log, e.g. /server/ping.
LOG_HTTP_IGNORE_PATHS=

# ─── Health & metrics ─────────────────────────────────────────────────────

# GET /server/health. Authenticated since 12.0.0. Anonymous callers get 404,
# so a container healthcheck should hit /server/ping instead. Results are
# cached and, with Redis, shared across instances.
# @type=boolean
# @docs("Healthcheck configuration", https://directus.com/docs/configuration/healthcheck)
HEALTHCHECK_ENABLED=true
HEALTHCHECK_SERVICES=database,redis,storage,email
HEALTHCHECK_NAMESPACE=directus:healthcheck
HEALTHCHECK_CACHE_TTL=5m

# Prometheus metrics on /metrics, off by default. METRICS_TOKENS is the
# comma-separated list of bearer tokens allowed to scrape it. Leave the
# endpoint disabled rather than unauthenticated.
# @type=boolean
# @docs("Metrics configuration", https://directus.com/docs/configuration/metrics)
METRICS_ENABLED=false
# @sensitive
METRICS_TOKENS=
METRICS_SERVICES=database,cache,redis,storage
METRICS_SCHEDULE=*/1 * * * *
METRICS_NAME_PREFIX=directus_
METRICS_HEALTH_CHECK_PREFIX=directus-metric-

# ─── Telemetry ────────────────────────────────────────────────────────────
# On by default: Directus periodically posts anonymised usage counts (item,
# user and collection counts, version, project owner) to telemetry.directus.io.
# Set false to switch it off entirely.

# @type=boolean
# @docs("General configuration", https://directus.com/docs/configuration/general)
TELEMETRY=true
# @type=url
TELEMETRY_URL=https://telemetry.directus.io
# @type=url
COMPLIANCE_URL=https://telemetry.directus.io
# @sensitive
TELEMETRY_AUTHORIZATION=

# ─── AI & MCP ─────────────────────────────────────────────────────────────
# The MCP server exposes your collections to an AI client. It is enabled at
# the env level by default but still has to be switched on in project
# settings and is bound by the calling user's permissions. MCP_OAUTH_* adds
# dynamic client registration, and every extra flag there widens who may
# register a client.

# @type=boolean
# @docs("AI configuration", https://directus.com/docs/configuration/ai)
AI_ENABLED=true
# @type=boolean
AI_DEVTOOLS_ENABLED=false
# @type=boolean
AI_TELEMETRY_ENABLED=false
# @type=enum(langfuse, braintrust)
AI_TELEMETRY_PROVIDER=langfuse
# Records full prompt and completion bodies in the telemetry provider:
# content, not just counts.
# @type=boolean
AI_TELEMETRY_RECORD_IO=false
# @sensitive
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# @type=url
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# @sensitive
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=
BRAINTRUST_API_URL=

# @type=boolean
# @docs("Directus MCP server", https://directus.com/docs/guides/ai/mcp)
MCP_ENABLED=true
# @type=boolean
MCP_OAUTH_ENABLED=false
MCP_OAUTH_AUTH_CODE_TTL=60s
# @type=number
MCP_OAUTH_MAX_CLIENTS=10000
# @type=boolean
MCP_OAUTH_REQUIRE_RESOURCE=false
MCP_OAUTH_ALLOWED_REDIRECT_DOMAINS=
MCP_OAUTH_ALLOWED_CUSTOM_REDIRECTS=raycast://oauth,cursor://cursor.mcp,cursor://anysphere.cursor-mcp
# Dynamic client registration: lets an unknown MCP client register itself.
# @type=boolean
MCP_OAUTH_DCR_ENABLED=false
# @type=boolean
MCP_OAUTH_CIMD_ENABLED=false
# @type=boolean
MCP_OAUTH_CIMD_ALLOW_HTTP=false
MCP_OAUTH_CIMD_ALLOWED_DOMAINS=
MCP_OAUTH_CIMD_BLOCKED_TLDS=test,localhost,invalid,example,local,onion

# ─── Process manager & HTTP server ────────────────────────────────────────
# The image's entrypoint runs `directus bootstrap` and then hands off to
# pm2-runtime, so these tune the supervisor rather than Directus itself. More
# than one instance without Redis (and without SECRET set) is the classic
# "random logouts" configuration.

# @type=number
# @docs("PM2 configuration", https://directus.com/docs/configuration/pm2)
PM2_INSTANCES=1
# @type=enum(cluster, fork)
PM2_EXEC_MODE=cluster
# Restart a worker whose memory passes this, e.g. "1G".
PM2_MAX_MEMORY_RESTART=
PM2_MIN_UPTIME=
PM2_LISTEN_TIMEOUT=
PM2_KILL_TIMEOUT=
PM2_MAX_RESTARTS=
PM2_RESTART_DELAY=0
# Note the inversion: pm2 only restarts crashed workers when this is the
# literal string "true".
# @type=boolean
PM2_AUTO_RESTART=
PM2_LOG_ERROR_FILE=
PM2_LOG_OUT_FILE=

# Milliseconds in-flight requests get to finish on SIGTERM before the process
# exits. Any other SERVER_* variable is camelCased onto node's http.Server,
# e.g. SERVER_KEEP_ALIVE_TIMEOUT.
# @type=number
SERVER_SHUTDOWN_TIMEOUT=1000
SERVER_KEEP_ALIVE_TIMEOUT=

# ─── Migrations ───────────────────────────────────────────────────────────

# Directory of custom migrations run alongside Directus' own during the
# bootstrap step at every container start.
# @docs("Migrations configuration", https://directus.com/docs/configuration/migrations)
MIGRATIONS_PATH=./migrations
