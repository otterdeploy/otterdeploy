# NocoDB 2026.08.1 environment schema (@env-spec / varlock format).
#
# The compose pins nocodb/nocodb:2026.08.1. On 2026-09-04 (research date) the
# newest stable release is 2026.08.2, pushed to docker.io the day before and
# what the floating `latest` tag resolves to (both
# sha256:4b760f0d25471fb4…). 2026.08.1 is taken instead because it has had
# sixteen days in the wild and 2026.08.2 carries no security fix: every
# advisory GitHub publishes for nocodb/nocodb is marked patched at or before
# 2026.05.1, so 2026.08.1 is already past all of them. The repo is very much
# alive (releases roughly fortnightly through 2026-09-03, docker.io tags
# pushed the same day), so this is a deliberate one-release lag, not a frozen
# image. The pinned tag resolves (sha256:2aacc3c704d4f74b…, image config
# created 2026-08-19).
#
# Source: grep of `process.env` across packages/nocodb/src at tag 2026.08.1
# (186 distinct names), plus the amd64 image config for what the container
# already bakes in: NC_TOOL_DIR=/usr/app/data/, PORT=8080,
# NODE_ENV=production, NC_DOCKER=0.6, WORKDIR /usr/src/app, entrypoint
# dumb-init -> start.sh -> `node docker/main.js`.
#
# Where nocodb.com/docs/self-hosting/environment-variables and the 2026.08.1
# code disagree, the code wins here:
#  - NC_REQUEST_BODY_SIZE: docs say the default is 1048576 (1 MB). The code
#    passes `process.env.NC_REQUEST_BODY_SIZE || '50mb'` to body-parser
#    (middlewares/json-body.middleware.ts), so the real default is 50mb.
#  - NC_DB_QUERY_LIMIT_GROUP_BY_GROUP: docs say 10, helpers/
#    extractLimitAndOffset.ts defaults it to 25. NC_DB_QUERY_LIMIT_MIN: docs
#    say 10, the code floor is 1.
#  - NC_WORKER_MODE_ENABLED is documented as the new name for
#    NC_WORKER_CONTAINER. Nothing in the tree reads it; only
#    NC_WORKER_CONTAINER works at this version.
#  - NC_DASHBOARD_URL: docs say it defaults to /dashboard. Every read in the
#    code is `process.env.NC_DASHBOARD_URL ?? '/'`.
#  - NC_INVITE_ONLY_SIGNUP is documented but is not an environment variable
#    any more (see the signup note further down). It is a row in the app
#    settings table, edited from the super-admin UI.
#  - The whole documented NC_RATE_LIMIT_* / NC_*_TTL / NC_*_COUNT rate-limit
#    family, NC_COMPUTE_E2B_*, NC_WEB_EXA_API_KEY, NC_CHAT_*_TIMEOUT_MS and
#    NC_ALLOW_LEGACY_API_TOKENS are marked "(On-premise only)" or
#    licensed-build features; no read of them exists in this source, so the
#    community image this template runs ignores them. They are omitted rather
#    than listed as knobs that do nothing.
#  - Undocumented but read, and both security-relevant: NC_TRUST_PROXY and
#    NC_DISABLE_SSRF_PROTECTION. Both are declared below.
#
# The LITESTREAM_* and AWS_* backup variables are omitted: docker/
# start-litestream.sh only runs them against the SQLite meta database, and
# this template's NC_DB is the bundled Postgres. Cloud-only (NC_CLOUD_*,
# NC_ONE_CLICK, NC_TRY), build-time (NC_VERSION, NC_GUI_DIST_PATH,
# NC_BINARY_BUILD) and test-harness names are omitted for the same reason.

# @defaultSensitive=false @defaultRequired=infer
# @docs("NocoDB environment variables", https://nocodb.com/docs/self-hosting/environment-variables)
# ---

# ─── Metadata database ───────────────────────────────────────────────────

# The one database NocoDB stores everything in: its own metadata AND, for
# bases created inside the product, the data tables themselves. Platform-owned:
# it points at the bundled Postgres service and is assembled from
# POSTGRES_PASSWORD, so the two can never drift. Unset, NocoDB silently falls
# back to a SQLite file (noco.db) under the data directory instead, which is
# not what this template deploys. The `p=` value is decoded with
# `new URL(...).searchParams` (utils/nc-config/helpers.ts), so a password
# containing `+` arrives as a space and `%` must be percent-escaped, so keep
# generated passwords hex.
# @required @sensitive
# @docs("NC_DB connection string", https://nocodb.com/docs/self-hosting/environment-variables)
NC_DB=pg://${{stack.db.HOST}}:5432?u=nocodb&p=${POSTGRES_PASSWORD}&d=nocodb

# Alternatives to NC_DB, checked only if NC_DB is unset: a knex connection
# object as a JSON string, or a path to a file holding one. NC_DB_JSON_FILE
# throws at boot if the path does not exist.
# @sensitive
NC_DB_JSON=
NC_DB_JSON_FILE=

# JDBC-style URLs, read by `prepareEnv()` BEFORE the app looks at NC_DB, and
# they do not fall back, they OVERWRITE process.env.NC_DB. Setting any of these
# here replaces the platform-owned connection above and points NocoDB at a
# different database. Order: NC_DATABASE_URL_FILE, DATABASE_URL_FILE,
# NC_DATABASE_URL, DATABASE_URL. Leave them empty.
# @sensitive
NC_DATABASE_URL=
# @sensitive
DATABASE_URL=
NC_DATABASE_URL_FILE=
DATABASE_URL_FILE=

# Maximum size of the knex connection pool to the metadata database (the pool
# minimum is fixed at 0). Raise it only alongside the Postgres server's own
# max_connections.
# @type=number
NC_DB_POOL_MAX=10

# Encrypts the stored credentials of EXTERNAL data sources and integrations at
# rest. Unset, those connection details sit in the metadata database as plain
# text. Changing it after data sources exist requires the nc-secret-mgr CLI to
# re-encrypt them first; changing it in place bricks every external source.
# @sensitive
# @docs("Updating the data-source secret", https://nocodb.com/docs/product/integrations/data-sources/updating-secret)
NC_CONNECTION_ENCRYPT_KEY=

# ─── Bundled PostgreSQL ──────────────────────────────────────────────────

# Password for the bundled Postgres `nocodb` role, and the same value embedded
# in NC_DB above. Generate it as hex, not base64: NC_DB is a URL and its query
# parser turns a `+` into a space, so a base64 password that happens to
# contain `+` fails authentication with no useful error.
# @required @sensitive
POSTGRES_PASSWORD=

# Role and database the bundled Postgres container creates on first boot.
# These are the `u=` and `d=` values inside NC_DB; changing either without
# changing NC_DB breaks the connection.
POSTGRES_USER=nocodb
POSTGRES_DB=nocodb

# ─── Sessions & authentication ───────────────────────────────────────────

# Signs every NocoDB session/auth JWT (and, for installs upgraded from older
# versions, is the fallback key that decrypts stored data-source credentials).
# If it is unset, Noco.initJwt() looks for a `nc_auth_jwt_secret` row in the
# metadata store and, finding none, generates a **uuidv4** and persists it
# there in plain text, so an unset secret means the signing key is a v4 UUID
# readable by anyone who can read the metadata database, which on this stack
# includes anyone who can point a NocoDB base at it. Whoever knows the value
# can mint a token for any account, including the super admin, without a
# password. Set it explicitly, keep it out of the database, and treat a
# rotation as logging everyone out.
# @required @sensitive
# @docs("Authentication variables", https://nocodb.com/docs/self-hosting/environment-variables)
NC_AUTH_JWT_SECRET=

# Lifetime of an issued access token, as a `jsonwebtoken` expiresIn string
# ("10h", "45m", "7d").
NC_JWT_EXPIRES_IN=10h

# Lifetime in days of the refresh token that silently renews a session.
# @type=number
NC_REFRESH_TOKEN_EXP_IN_DAYS=30

# First-run super admin. Both must be set together or neither is used, and
# they are re-applied on EVERY boot: with no users yet they create the super
# admin; with a super admin already present they reset that account's email
# and password back to these values, so leaving them set pins the admin
# credentials to whatever the environment says. The password is validated at
# startup (at least 8 characters, one uppercase, one number, one special
# character) and the container exits 1 if it fails, as it does on a malformed
# email. Left empty, NocoDB prompts for the admin account on first visit to
# the UI instead. Do that promptly, since the first person to reach the URL
# gets it.
# @type=email
NC_ADMIN_EMAIL=
# @sensitive
NC_ADMIN_PASSWORD=

# Signup on a self-hosted instance is OPEN by default: the `invite_only_signup`
# app setting ships false (interface/AppSettings.ts) and only then does
# users.service.ts require an invite token. There is no environment variable
# for it at this version: the documented NC_INVITE_ONLY_SIGNUP is not read
# anywhere in 2026.08.1. Turn signup off in the super-admin settings straight
# after creating the first account, or put the deployment behind your own
# access control. NC_DISABLE_EMAIL_AUTH is the only env-level lever: ANY
# non-empty value (it is read as `!!process.env...`) removes email/password
# login entirely, which only makes sense once Google or SSO works.
NC_DISABLE_EMAIL_AUTH=

# Regex, unanchored, that a user's email must match to sign up or be invited,
# e.g. `@example\.com$` to keep an open instance to one domain. Invalid regex
# syntax throws at boot. NC_AUTH_EMAIL_PATTERN is the legacy name, checked
# second.
NC_USER_ALLOWED_EMAIL_PATTERN=
NC_AUTH_EMAIL_PATTERN=

# Google OAuth. Both are needed before the "Sign in with Google" button
# appears; the redirect URI is <site url>/auth/google/genTokenByCode. Values
# set in the super-admin UI overwrite these at runtime.
# @docs("Google API credentials console", https://console.cloud.google.com/apis/credentials)
NC_GOOGLE_CLIENT_ID=
# @sensitive
NC_GOOGLE_CLIENT_SECRET=

# GitHub OAuth pair. Undocumented; at 2026.08.1 the code only uses them to
# report whether GitHub auth is configured, so treat the flow as incomplete on
# the community build.
NC_GITHUB_CLIENT_ID=
# @sensitive
NC_GITHUB_CLIENT_SECRET=

# Enterprise SSO. `oidc` or `saml` turns the corresponding provider button on;
# the provider names are only the labels shown on the login page. The
# providers themselves are configured from the admin panel and need a licence.
# @type=enum(oidc, saml)
# @docs("Authentication settings", https://nocodb.com/docs/product/account-settings/authentication)
NC_SSO=
NC_OIDC_PROVIDER_NAME=OpenID Connect
NC_SSO_SAML_PROVIDER_NAME=SAML

# Self-hosted licence key. Unlocks the paid on-premise features and, as a side
# effect, stops NocoDB from auto-populating the default S3/SES plugin config.
# @sensitive
# @docs("Activating a licence", https://nocodb.com/docs/self-hosting/license)
NC_LICENSE_KEY=

# Basic-auth pair used by a small number of internal/diagnostic routes. The
# code substitutes the literals "defaultusername"/"defaultpassword" when they
# are unset, so set both if anything reachable depends on them.
NC_HTTP_BASIC_USER=
# @sensitive
NC_HTTP_BASIC_PASS=

# ─── Networking, URLs & routing ──────────────────────────────────────────

# Port the HTTP server binds. The image already sets 8080 and the compose
# exposes container port 8080 with no override, so this is that port's twin:
# changing it here without changing the exposed port breaks routing. NC_PORT
# is a separate, older name read only into NcConfig and does NOT move the
# listener; leave it empty.
# @type=port
PORT=8080
NC_PORT=

# Public origin NocoDB believes it is served from, scheme included. Invitation
# and password-reset emails, the Swagger docs URL and the socket.io origin are
# all built from it; unset, NocoDB guesses from the incoming request, which is
# wrong behind a proxy that rewrites Host. NC_PUBLIC_URL is the legacy name,
# checked second.
# @type=url
NC_SITE_URL=
# @type=url
NC_PUBLIC_URL=

# Path the dashboard SPA is served from. "/" (the default) serves it at the
# root and answers non-browser GETs on / with 200, which is what a health
# check wants. A non-root path redirects that path back to the root; a full
# http(s) URL switches to split-frontend mode and redirects browsers there.
NC_DASHBOARD_URL=/

# Whether to believe X-Forwarded-* headers. Default is OFF at this version
# (deliberately, per CWE-346: without it any client can spoof the source IP
# that lands in the audit log). "true" trusts the immediate upstream, a number
# trusts that many hops, and anything else is handed to Express verbatim
# ("loopback", "10.0.0.0/8", a comma-separated list). Undocumented.
NC_TRUST_PROXY=

# Comma-separated domain patterns allowed to embed NocoDB shared views in an
# iframe, e.g. `*.example.com,app.example.org`. Empty means the default
# framing policy stays in force. NC_IFRAME_WHITELIST_DOMAINS is the legacy
# name, checked second.
NC_IFRAME_ALLOWED_DOMAINS=
NC_IFRAME_WHITELIST_DOMAINS=

# Subdomain label used when NocoDB builds workspace-scoped URLs. Only
# meaningful on a wildcard-DNS install.
NC_MAIN_SUBDOMAIN=app

# ─── Data directory ──────────────────────────────────────────────────────

# Directory for local files: the SQLite meta DB when NC_DB is unset, plus
# locally-stored attachments. The image bakes NC_TOOL_DIR=/usr/app/data/,
# which is exactly where the compose mounts the nocodb-data volume. Override
# either of these and the volume stops covering the data directory.
# NC_APP_DATA_DIR wins over NC_TOOL_DIR; with both unset the code falls back
# to the process working directory (/usr/src/app), which is NOT on a volume.
NC_APP_DATA_DIR=
NC_TOOL_DIR=/usr/app/data/

# ─── Redis: cache, jobs, rate limiting ───────────────────────────────────

# NocoDB runs happily with no Redis at all (an in-process cache, an in-process
# fallback job queue and in-memory rate limiting), which is what this template
# deploys. Point these at a Redis to share state across replicas. NC_REDIS_URL
# is the single fallback for all three roles; the specific names win over it.
NC_CACHE_REDIS_URL=
# @sensitive
NC_REDIS_URL=

# Job queue (BullMQ). NC_REDIS_JOB_URL is checked first, then
# NC_JOBS_REDIS_URL, then NC_REDIS_URL.
NC_REDIS_JOB_URL=
NC_JOBS_REDIS_URL=

# Rate-limiter store. NC_RATE_LIMIT_REDIS_URL first, then NC_THROTTLER_REDIS,
# then NC_REDIS_URL.
NC_RATE_LIMIT_REDIS_URL=
NC_THROTTLER_REDIS=

# Seconds a cached metadata entry lives, and the extra grace window during
# which a stale entry may still be served.
# @type=number
NC_REDIS_TTL=259200
# @type=number
NC_REDIS_GRACE_TTL=86400

# "true" bypasses the cache and reads metadata from the database every time.
# A debugging switch; it makes the UI markedly slower.
# @type=boolean
NC_DISABLE_CACHE=false

# ─── Background workers ──────────────────────────────────────────────────

# "true" turns this container into a job processor only: it stops serving the
# app, forces telemetry off, and REQUIRES a Redis URL (it throws
# "NC_REDIS_URL is required" at boot without one). This template runs a single
# all-in-one container, so leave it empty. NC_WORKER is a separate internal
# flag on NcConfig and is not the way to do this.
# @type=boolean
NC_WORKER_CONTAINER=false
NC_WORKER=

# Jobs a worker runs at once. Parsed with a floor of 1; anything unparseable
# falls back to 10.
# @type=number
NC_WORKER_CONCURRENCY=10

# Concurrency of the in-process fallback queue (used when there is no Redis),
# of NcHelp's bulk operation runner, and of the per-request database query
# queue.
# @type=number
NC_FALLBACK_QUEUE_CONCURRENCY=
# @type=number
NC_EXECUTE_OPERATIONS_CONCURRENCY=5
# @type=number
NC_DB_QUERY_QUEUE_CONCURRENCY=1

# ─── Attachment storage ──────────────────────────────────────────────────

# Moves attachments off the container's data volume into S3-compatible object
# storage. The plugin only activates when NC_S3_BUCKET_NAME is set AND at
# least one of NC_S3_REGION / NC_S3_ENDPOINT is; the access key pair is
# additionally needed unless the host has an IAM role. Set
# NC_S3_FORCE_PATH_STYLE=true for MinIO and most non-AWS endpoints.
# @docs("Attachment field", https://nocodb.com/docs/product/tables/fields/field-types/custom-types/attachment)
NC_S3_BUCKET_NAME=
NC_S3_REGION=
# @type=url
NC_S3_ENDPOINT=
NC_S3_ACCESS_KEY=
# @sensitive
NC_S3_ACCESS_SECRET=
# @type=boolean
NC_S3_FORCE_PATH_STYLE=false
NC_S3_ACL=

# "true" stops serving attachments from stable public URLs and hands out
# expiring pre-signed ones instead. Worth enabling on an instance holding
# anything private, but it invalidates every attachment link already shared.
# NC_SECURE_ATTACHMENTS is the legacy name; either being "true" is enough.
# @type=boolean
NC_ATTACHMENT_ACCESS_CONTROL_ENABLED=false
# @type=boolean
NC_SECURE_ATTACHMENTS=false

# Seconds before a pre-signed attachment URL starts to expire; the real expiry
# is this plus up to ten minutes, because issue times are rounded up to a
# ten-minute boundary so URLs stay cacheable. Only used when access control is
# on.
# @type=number
NC_ATTACHMENT_EXPIRE_SECONDS=7200

# Upload ceilings, all in bytes: one attachment, one non-attachment field in a
# shared-form multipart submission (raise it when long text or JSON trips
# "Field value too long"), and one file handed to the CSV/Excel/JSON importer.
# NC_NON_ATTACHMENT_FIELD_SIZE is the legacy name for the form-field limit and
# is checked second.
# @type=number
NC_ATTACHMENT_FIELD_SIZE=20971520
# @type=number
NC_FORM_FIELD_MAX_SIZE=10485760
# @type=number
NC_NON_ATTACHMENT_FIELD_SIZE=
# @type=number
NC_DATA_IMPORT_FILE_SIZE=104857600

# Attachments per cell, and how many days an orphaned file stays on storage
# after the last reference to it is deleted (0 keeps them forever).
# @type=number
NC_MAX_ATTACHMENTS_ALLOWED=10
# @type=number
NC_ATTACHMENT_RETENTION_DAYS=10

# Thumbnail generation guards, in bytes and in pixels (width x height).
# Images over the size limit get no thumbnail; images over the pixel limits
# are skipped so a decompression bomb cannot exhaust the container's memory.
# @type=number
NC_THUMBNAIL_MAX_SIZE=3145728
# @type=number
NC_THUMBNAIL_MAX_INPUT_PIXELS=24000000
# @type=number
NC_THUMBNAIL_MAX_INPUT_PIXELS_SHRINKABLE=100000000

# ─── Outbound email (SMTP) ───────────────────────────────────────────────

# The SMTP plugin is configured only if FROM, HOST and PORT are all three
# present; username and password are optional on relays that do not
# authenticate. Without it NocoDB cannot send invitations or password resets,
# so an admin has to hand out invite links manually. Pair it with NC_SITE_URL
# or the links in those emails point at the wrong host.
NC_SMTP_FROM=
NC_SMTP_HOST=
# @type=port
NC_SMTP_PORT=
NC_SMTP_USERNAME=
# @sensitive
NC_SMTP_PASSWORD=

# TLS behaviour, each compared literally against the string "true"; anything
# else is false. SECURE means implicit TLS (port 465). IGNORE_TLS disables
# STARTTLS even where the server offers it, which sends credentials in the
# clear. REJECT_UNAUTHORIZED=true is the one to turn ON: it refuses relays
# presenting an invalid or self-signed certificate.
# @type=boolean
NC_SMTP_SECURE=false
# @type=boolean
NC_SMTP_IGNORE_TLS=false
# @type=boolean
NC_SMTP_REJECT_UNAUTHORIZED=false

# ─── Outbound requests & SSRF ────────────────────────────────────────────

# NocoDB fetches URLs on a user's behalf in three places (webhooks, external
# database connections, and "add from URL" imports), and by default a
# request-filtering agent blocks private and loopback addresses so an editor
# cannot use the instance to reach your internal network. Each variable below
# removes that protection for one of those; all are compared against "true".
# @type=boolean
NC_WEBHOOK_ALLOW_PRIVATE_NETWORK=false
# Legacy name for the webhook bypass; either being "true" is enough. Note the
# behaviour change at this version: it no longer also unblocks URL imports.
# @type=boolean
NC_ALLOW_LOCAL_HOOKS=false
# @type=boolean
NC_ALLOW_LOCAL_EXTERNAL_DBS=false
# @type=boolean
NC_ALLOW_LOCAL_DATA_IMPORT=false

# The blanket override: "true" disables SSRF filtering for all three sources
# at once. Undocumented, and strictly worse than the three targeted switches.
# @type=boolean
NC_DISABLE_SSRF_PROTECTION=false

# "true" blocks external database connections that reference SSL certificate
# FILE paths (which would otherwise let a base creator read files from inside
# the container). Off by default on self-hosted; undocumented.
# @type=boolean
NC_DISABLE_DB_SSL_FILE_PATHS=false

# Node's own TLS switch. Setting it at all is also what makes NocoDB add
# `ssl: true` to the metadata database connection (utils/nc-config/
# helpers.ts), so it has a side effect beyond certificate checking; "0"
# disables verification for every outbound TLS connection the container makes.
NODE_TLS_REJECT_UNAUTHORIZED=

# ─── Request and query limits ────────────────────────────────────────────

# Maximum JSON request body, as a body-parser size string. The docs claim
# 1 MB; the code default is 50mb.
NC_REQUEST_BODY_SIZE=50mb

# Bytes of an outgoing webhook's request/response body NocoDB will buffer, so
# one enormous webhook payload cannot exhaust memory.
# @type=number
NC_WEBHOOK_MAX_BODY_SIZE=10485760

# Character ceiling on generated text: NC_MAX_TEXT_LENGTH is the global one,
# NC_FORMULA_MAX_OUTPUT_LENGTH overrides it for formula output specifically
# (longer results are truncated).
# @type=number
NC_MAX_TEXT_LENGTH=100000
# @type=number
NC_FORMULA_MAX_OUTPUT_LENGTH=

# Records allowed in one bulk insert/update/delete. The v3 API defaults to 10
# and v1/v2 to 100; setting either variable overrides BOTH.
# NC_DATA_PAYLOAD_LIMIT is the legacy name, checked second.
# @type=number
NC_API_BULK_OPERATION_MAX_RECORDS=
# @type=number
NC_DATA_PAYLOAD_LIMIT=

# Cells the grid will let one selection cover before refusing.
# @type=number
NC_GRID_MAX_SELECTION_LIMIT=1000

# Pagination for record listings: page size when the caller asks for none, and
# the floor and ceiling it is clamped to. Each has a DB_QUERY_LIMIT_* legacy
# twin, checked second. Note the docs are wrong on two of these: the code's
# minimum is 1, not 10.
# @type=number
NC_DB_QUERY_LIMIT_DEFAULT=25
# @type=number
NC_DB_QUERY_LIMIT_MIN=1
# @type=number
NC_DB_QUERY_LIMIT_MAX=1000
# @type=number
NC_DB_QUERY_LIMIT_LTAR_V3_LIMIT=1000
# @type=number
DB_QUERY_LIMIT_DEFAULT=
# @type=number
DB_QUERY_LIMIT_MIN=
# @type=number
DB_QUERY_LIMIT_MAX=
# @type=number
DB_QUERY_LIMIT_LTAR_V3_LIMIT=

# Groups per page and records per group in a grouped grid view. The docs say
# the group default is 10; the code says 25.
# @type=number
NC_DB_QUERY_LIMIT_GROUP_BY_GROUP=25
# @type=number
NC_DB_QUERY_LIMIT_GROUP_BY_RECORD=10
# @type=number
DB_QUERY_LIMIT_GROUP_BY_GROUP=
# @type=number
DB_QUERY_LIMIT_GROUP_BY_RECORD=

# "true" turns off the per-group row limit and the per-group aggregations in
# grouped views. These are escape hatches for very wide group-by queries.
# @type=boolean
NC_DISABLE_GROUP_BY_LIMIT=false
# @type=boolean
NC_DISABLE_GROUP_BY_AGG=false

# In-memory LRU caps: cached SQL managers, and cached knex connections to
# external data sources.
# @type=number
NC_SQL_MGR_CACHE_MAX_SIZE=500
# @type=number
NC_CONNECTION_CACHE_MAX_SIZE=500

# ─── Product behaviour ───────────────────────────────────────────────────

# Any non-empty value stops users creating bases on external databases, so
# NocoDB only ever talks to its own metadata database. NC_MINIMAL_DBS=true
# sets this for you at boot. Worth setting on a multi-user instance: an
# external-database base is a live credentialed connection any base creator
# can point wherever the container can reach.
NC_CONNECT_TO_EXTERNAL_DB_DISABLED=
# @type=boolean
NC_MINIMAL_DBS=false

# "true" stops NocoDB creating a Postgres schema per base to mirror it back
# into the database, and the host/port the reflection endpoint advertises.
# Reflection is on by default when the database user has the rights for it.
# @type=boolean
NC_DISABLE_PG_DATA_REFLECTION=false
NC_DATA_REFLECTION_HOST=
# @type=port
NC_DATA_REFLECTION_PORT=5433

# Column-name sanitisation on creation, which is what keeps a crafted field
# title out of generated SQL. Enabled unless explicitly set to "false". Do
# not turn it off. NC_SANITIZE_COLUMN_NAME is the legacy name.
# @type=boolean
NC_DATABASE_COLUMN_NAME_SANITIZE_ENABLED=true
# @type=boolean
NC_SANITIZE_COLUMN_NAME=true

# Any non-empty value skips NocoDB's schema migrations. Only for a
# maintenance window where you run them yourself; a version upgrade with this
# set leaves the schema behind the code.
NC_MIGRATIONS_DISABLED=

# Audit log. It records who changed what, and is on unless NC_DISABLE_AUDIT is
# exactly "true". NC_ENABLE_AUDIT is a separate, narrower flag read only by
# NcConfig.isAuditEnabled and defaults to off.
# @type=boolean
NC_DISABLE_AUDIT=false
# @type=boolean
NC_ENABLE_AUDIT=false

# Days a soft-deleted record stays recoverable in the record trash before the
# cleanup job removes it for good.
# @type=number
NC_RECORD_TRASH_RETENTION_DAYS=30

# "true" disables the undo/redo stack, the first-run onboarding questionnaire,
# and the in-product news feed respectively. All three are UI-only.
# @type=boolean
NC_DISABLE_UNDO_REDO=false
# @type=boolean
NC_DISABLE_ONBOARDING_FLOW=false
# @type=boolean
NC_DISABLE_PRODUCT_FEED=false

# "true" removes the embedded Chatwoot support widget, which otherwise loads
# third-party JavaScript into the dashboard for every user.
# @type=boolean
NC_DISABLE_SUPPORT_CHAT=false

# "true" lets the API write to system fields (created_at, created_by and the
# like) instead of rejecting the attempt. For data migrations.
# @type=boolean
NC_SYSTEM_FIELD_API_UPDATE=false

# ─── Telemetry, error reporting, logging ─────────────────────────────────

# Anonymous usage telemetry. It is on by default; ANY non-empty value turns
# the event stream off (`!!process.env.NC_DISABLE_TELE`), but the dashboard's
# own "telemetry enabled" indicator compares against the literal "true", so
# set it to exactly "true" and both agree. Worker containers force it off.
# @type=boolean
# @docs("Telemetry", https://nocodb.com/docs/self-hosting/environment-variables)
NC_DISABLE_TELE=false

# Sentry. NC_SENTRY_DSN sends this instance's errors to your own Sentry
# project; NC_DISABLE_ERR_REPORTS="true" switches off the default upstream
# error reporting.
# @sensitive
NC_SENTRY_DSN=
# @type=boolean
NC_DISABLE_ERR_REPORTS=false

# What webhook executions get written to the hook log: OFF records nothing,
# ERROR only failures, ALL every call including the request body, which puts
# record data in the log table. NC_AUTOMATION_LOG_LEVEL is the legacy name,
# checked second.
# @type=enum(OFF, ERROR, ALL)
# @docs("Webhooks", https://nocodb.com/docs/product/tables/table-operations/webhook/create-webhook)
NC_WEBHOOK_LOG_LEVEL=OFF
# @type=enum(OFF, ERROR, ALL)
NC_AUTOMATION_LOG_LEVEL=

# Debug logging namespaces. The container's own entry point sets `xc*`;
# "nc:*" turns on all NocoDB debug output and "nc:*,knex:*" adds every SQL
# query (which will include data). Verbose enough to matter for disk.
DEBUG=

# "true" logs the full body of API errors rather than the summary, and
# "true" (or any value in ENABLE_PROFILER) turns on per-stage timing logs.
# Both are for debugging a specific problem, not for steady state.
# @type=boolean
NC_ENABLE_ALL_API_ERROR_LOGGING=false
# @type=boolean
NC_PERF_LOG=false
ENABLE_PROFILER=

# ─── Node.js runtime ─────────────────────────────────────────────────────

# The image sets NODE_ENV=production; "development" changes framework
# behaviour and is not meant for a deployed instance. NODE_OPTIONS passes
# flags to the node process itself (`--max-old-space-size=4096` is the usual
# one on a large import).
# @type=enum(production, development)
NODE_ENV=production
NODE_OPTIONS=

# Container timezone, honoured by the OS and by date formatting in exports.
TZ=
