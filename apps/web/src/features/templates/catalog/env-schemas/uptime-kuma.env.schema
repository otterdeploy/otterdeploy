# Uptime Kuma 2.5.3 — environment schema (@env-spec / varlock format).
#
# The compose pins louislam/uptime-kuma:2. On 2026-08-29 (research date) that
# tag shares its digest with 2.5.3, the newest 2.x release (docker.io tag
# list: `2` == `2.5.3` == `next`).
#
# Source: grep of process.env across server/, src/, and extra/ at v2.5.3.
# Cross-checked against the wiki's "Environment Variables" page, which is
# accurate except: it calls the container-detection flag
# `UPTIME_KUMA_IN_CONTAINER`; the code only ever reads
# `UPTIME_KUMA_IS_CONTAINER` (server/uptime-kuma-server.js,
# server/server.js, server/client.js, real-browser-monitor-type.js) — baked
# into the image at build (docker/dockerfile: `ENV UPTIME_KUMA_IS_CONTAINER=1`),
# not something the compose or an operator needs to set. The docs also omit
# the `*_FILE` docker-secrets variants (documented separately, further down
# the same page) and the fact that `extra/healthcheck.js` — what the
# compose's healthcheck actually runs — reads HOST/PORT/SSL_* itself, so a
# custom bind address or TLS setup must be mirrored there too or the
# container reports unhealthy while the app is fine.
#
# The compose sets no environment at all: an out-of-the-box Uptime Kuma
# needs nothing filled in. The service prompts for its admin account on
# first visit to the UI.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variables", https://github.com/louislam/uptime-kuma/wiki/Environment-Variables)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Host/IP to bind to. Empty binds the unspecified address (dual-stack `::`,
# or `0.0.0.0` where IPv6 isn't available) — what the container network
# needs. `HOST` is read too (checked second) except on FreeBSD, where it
# collides with a system variable and is ignored.
UPTIME_KUMA_HOST=
HOST=

# Port the server listens on. The compose exposes container port 3001 with
# no override, so this is that port's twin: changing it here without also
# updating the exposed port breaks routing. `PORT` is the third fallback
# (after `UPTIME_KUMA_PORT`), used by some PaaS conventions.
# @type=port
UPTIME_KUMA_PORT=3001
PORT=

# Where SQLite data / config / uploads live, relative to the image's /app
# WORKDIR unless absolute. The compose volume is mounted at /app/data,
# matching this default — change it and the volume stops covering the data
# directory.
DATA_DIR=./data/

# TLS for the built-in server (terminates HTTPS in the container itself,
# separate from any reverse proxy). Both key and cert are required together;
# paths must exist inside the container (mount them). `SSL_KEY`/`SSL_CERT`
# are read as fallbacks.
# @docs("How to add HTTPS/SSL", https://github.com/louislam/uptime-kuma/wiki/%F0%9F%94%92-How-to-add-HTTPS-SSL)
UPTIME_KUMA_SSL_KEY=
SSL_KEY=
UPTIME_KUMA_SSL_CERT=
SSL_CERT=
# Passphrase for an encrypted SSL_KEY, since 1.21.1.
# @sensitive
UPTIME_KUMA_SSL_KEY_PASSPHRASE=
# @sensitive
SSL_KEY_PASSPHRASE=

# Runs an outbound Cloudflare Tunnel instead of (or alongside) publishing a
# port; the token is the tunnel's connector secret from the Cloudflare
# dashboard.
# @sensitive
# @docs("Cloudflare Tunnel", https://github.com/louislam/uptime-kuma/wiki/%E2%98%81%EF%B8%8F-Cloudflare-Tunnel)
UPTIME_KUMA_CLOUDFLARED_TOKEN=

# Uptime Kuma refuses to render inside an <iframe> from a different origin
# (anti-clickjacking). Set to "true" to allow embedding; only do this behind
# your own auth.
# @type=boolean
UPTIME_KUMA_DISABLE_FRAME_SAMEORIGIN=false

# WebSocket requests are rejected unless their Origin header matches the
# server's own host (GHSA-mj22-23ff-2hrr). "bypass" turns that check off —
# only safe behind a proxy that already enforces Origin/Host itself.
# @type=enum(cors-like, bypass)
UPTIME_KUMA_WS_ORIGIN_CHECK=cors-like

# Outbound HTTP(S)/SOCKS proxy used only when SENDING notifications (not for
# monitor checks). Accepts http:, https:, socks:, socks4:, socks5:,
# socks5h: URLs. The lowercase `notification_proxy` is checked first,
# `NOTIFICATION_PROXY` second — either works, first non-empty wins.
notification_proxy=
NOTIFICATION_PROXY=

# ─── Real Browser monitors (Chromium) ───────────────────────────────────
# @docs("Monitor Type - Real Browser", https://github.com/louislam/uptime-kuma/wiki/Monitor-Type-List#real-browser-http)

# Lets a "Real Browser" monitor point at ANY executable path as its
# Chromium binary, not just the auto-detected ones. Only turn on if you
# trust everyone who can edit monitors.
# @type=boolean
UPTIME_KUMA_ALLOW_ALL_CHROME_EXEC=false

# ─── External database (MariaDB) ─────────────────────────────────────────
# Presence of UPTIME_KUMA_DB_TYPE is what switches Uptime Kuma off its
# default embedded SQLite and skips the setup wizard; every field below is
# only read once, at first boot with no db-config.json, to write that file.
# Changing these later does nothing until the container's data volume is
# reset.
# @docs("Database Backend and Adapter", https://github.com/louislam/uptime-kuma/wiki/%F0%9F%92%BE-Database-Backend-and-Adapter)

# @type=enum(sqlite, mariadb, embedded-mariadb)
UPTIME_KUMA_DB_TYPE=
UPTIME_KUMA_DB_HOSTNAME=
# @type=port
UPTIME_KUMA_DB_PORT=
# Database name to connect to (mariadb) or create (embedded-mariadb).
UPTIME_KUMA_DB_NAME=
UPTIME_KUMA_DB_USERNAME=
# @sensitive
UPTIME_KUMA_DB_PASSWORD=
# Unix socket path; when set, UPTIME_KUMA_DB_HOSTNAME/PORT are ignored.
UPTIME_KUMA_DB_SOCKET=
# Max concurrent pool connections.
# @type=number
UPTIME_KUMA_DB_POOL_MAX_CONNECTIONS=10
# @type=boolean
UPTIME_KUMA_DB_SSL=false
# CA certificate content (PEM), for TLS to the database.
UPTIME_KUMA_DB_CA=

# Docker-secrets variants: read the value from the file at this path instead
# of the variable itself. Setting both a var and its _FILE twin is an error
# at boot. Only these four have a _FILE form.
UPTIME_KUMA_DB_USERNAME_FILE=
UPTIME_KUMA_DB_PASSWORD_FILE=
UPTIME_KUMA_DB_SSL_FILE=
UPTIME_KUMA_DB_CA_FILE=

# Runs a MariaDB server inside the SAME container alongside Uptime Kuma,
# instead of connecting to an external one. Combine with UPTIME_KUMA_DB_TYPE=
# embedded-mariadb.
# @type=boolean
UPTIME_KUMA_ENABLE_EMBEDDED_MARIADB=false

# ─── Logging & diagnostics ────────────────────────────────────────────────

# Comma-separated log categories to silence, e.g.
# "debug_monitor,info_monitor,debug_cert,warn_monitor".
UPTIME_KUMA_HIDE_LOG=

# "json" switches every log line to structured JSON; anything else keeps
# the default human-readable text.
# @type=enum(json)
UPTIME_KUMA_LOG_FORMAT=

# "1" prints a monitor's full response body to the console on every check —
# for debugging one specific monitor by its numeric ID, not for normal use.
# @type=number
UPTIME_KUMA_LOG_RESPONSE_BODY_MONITOR_ID=

# "1" enables SQL query logging.
# @type=boolean
SQL_LOG=

# One-time migration workaround (see issue history around the 1.x -> 2.x
# aggregate-table migration). Leave off unless a maintainer told you to set
# it for a stuck migration.
# @type=boolean
SET_MIGRATE_AGGREGATE_TABLE_TO_TRUE=false

# Binds the Node.js inspector to 127.0.0.1:9229 inside the container. For
# attaching a debugger, not for production.
# @type=boolean
UPTIME_KUMA_DEBUG_INSPECTOR=false

# Forces the Node.js runtime mode. The image sets this to "production" at
# boot if unset (server/server.js); "development" turns on verbose dev
# behavior and is not meant for a deployed instance.
# @type=enum(production, development)
NODE_ENV=production

# ─── Node.js TLS/runtime knobs ────────────────────────────────────────────
# Standard Node.js flags, honored by the container's node process itself —
# not read by Uptime Kuma's own code, but documented on the same wiki page
# because they're the usual fix for monitors hitting a self-signed target.

# Path to extra trusted CA certificates (PEM) inside the container.
NODE_EXTRA_CA_CERTS=
# "0" disables ALL certificate validation for outbound Node requests —
# every monitor and notification, not just one target. Prefer
# NODE_EXTRA_CA_CERTS or a monitor's own "ignore TLS errors" toggle.
# @type=boolean
NODE_TLS_REJECT_UNAUTHORIZED=
# Set to "--insecure-http-parser" if a monitored site behind a WAF returns
# "Invalid header value char".
NODE_OPTIONS=

# ─── Timezone ──────────────────────────────────────────────────────────────

# If set, ALWAYS wins over the timezone chosen in Settings > Appearance —
# checked first, on every boot (server/uptime-kuma-server.js). Leave empty
# to manage timezone from the UI instead.
TZ=
