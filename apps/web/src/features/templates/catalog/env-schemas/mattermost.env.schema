# Mattermost Team Edition 11.7.10 (image mattermost/mattermost-team-edition:11.7.10)
# environment schema (@env-spec / varlock format).
#
# v11.7 is the current Extended Support Release: released 2026-05-15,
# supported through 2027-05-15, patched to 11.7.10 on 2026-08-26. The
# previous ESR (v10.11) reached end-of-life 2026-08-15 and feature releases
# such as 11.10 only receive security backports for three months, so an ESR
# is the right line for a self-hosted instance. Release cadence and life
# cycles: https://docs.mattermost.com/product-overview/release-policy
#
# Source: the config model at the pinned tag,
# https://github.com/mattermost/mattermost/blob/v11.7.10/server/public/model/config.go
# Every key below is a real field of `model.Config` and every default is the
# value that struct's `SetDefaults` writes. Mattermost has no per-variable
# env parsing: `applyEnvironmentMap` in
# https://github.com/mattermost/mattermost/blob/v11.7.10/server/config/environment.go
# walks `model.Config` by reflection and maps `MM_<SECTION>_<SETTING>`
# (case-insensitive, one underscore per struct level) onto the matching
# field, so the variable set IS the config.json tree. A name that matches no
# field is silently ignored, with no error and no warning. Slice fields
# are split on spaces, map/json fields are parsed as JSON.
#
# Because the surface is the whole config tree it is far too large to list;
# the sections here are the ones the compose sets plus the groups an operator
# of this stack actually touches (ServiceSettings, SqlSettings, FileSettings,
# EmailSettings, TeamSettings, LogSettings, PluginSettings). The full,
# section-by-section reference lives upstream at
# https://docs.mattermost.com/administration-guide/configure/configuration-settings
#
# Two behaviours worth knowing before you set anything here. First, a setting
# supplied through the environment cannot be edited in the System Console:
# it is greyed out, and any unrelated save writes the env value back into
# config.json. Second, config.json lives on the `mattermost-config` volume,
# so anything you do NOT set here is persisted there instead, including the
# two secrets Mattermost generates for itself on first boot.
#
# Cross-checked against the image's own baked environment
# (`MM_SERVICESETTINGS_ENABLELOCALMODE=true`, `MM_INSTALL_TYPE=docker`), which
# the published docs do not mention and which changes the security posture of
# a stock container. See MM_SERVICESETTINGS_ENABLELOCALMODE below.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment variables", https://docs.mattermost.com/administration-guide/configure/environment-variables)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Public base URL of this instance, scheme + host (+ port if non-standard),
# no trailing slash. Set by the compose from the prompted MATTERMOST_URL.
# Mattermost refuses to serve a usable instance without it: permalinks,
# OAuth/webhook callbacks, email links, the mobile app's server URL and the
# CSRF/cookie origin checks are all derived from this one value. An https://
# value is what makes the session cookie Secure.
# @required
# @type=url
# @docs("Web server configuration", https://docs.mattermost.com/administration-guide/configure/environment-configuration-settings)
MM_SERVICESETTINGS_SITEURL=${MATTERMOST_URL}

# The URL the operator types; the compose threads it into
# MM_SERVICESETTINGS_SITEURL. Same rules apply (origin only, no trailing
# slash).
# @required
# @type=url
MATTERMOST_URL=

# host:port the server binds inside the container. The compose exposes 8065,
# which is this default's port: change one without the other and nothing
# routes. Leading colon means "all interfaces".
MM_SERVICESETTINGS_LISTENADDRESS=:8065

# Runs an unauthenticated admin control socket inside the container, which
# `mmctl --local` attaches to. Anything that can reach that socket path is a
# full system admin with no login, including any process sharing the
# container or a bind-mount that exposes /var/tmp. THE IMAGE SHIPS THIS ON:
# `mattermost/mattermost-team-edition:11.7.10` bakes
# MM_SERVICESETTINGS_ENABLELOCALMODE=true into its config, so the socket
# exists unless you set this to "false" here. Mattermost's own default (in
# model.Config) is false. Leave it on only if you rely on `mmctl --local` for
# the first admin account or recovery; turn it off otherwise.
# @type=boolean
# @docs("mmctl local mode", https://docs.mattermost.com/administration-guide/manage/mmctl-command-line-tool)
MM_SERVICESETTINGS_ENABLELOCALMODE=true

# Filesystem path of that socket, inside the container. Only meaningful when
# local mode is enabled. Do not put it on a mounted volume.
MM_SERVICESETTINGS_LOCALMODESOCKETLOCATION=/var/tmp/mattermost_local.socket

# Lets users mint long-lived personal access tokens for the REST API. Each
# token carries the user's full permissions and does not expire, so turning
# this on widens the blast radius of any leaked credential. Off by default.
# @type=boolean
MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS=false

# Second factor (TOTP) for password logins. Enable turns it on as an option;
# EnforceMultifactorAuthentication (not listed here) makes it mandatory.
# @type=boolean
MM_SERVICESETTINGS_ENABLEMULTIFACTORAUTHENTICATION=false

# Failed logins before the account is locked out and has to reset by email.
# @type=number
MM_SERVICESETTINGS_MAXIMUMLOGINATTEMPTS=10

# Incoming/outgoing webhooks and slash commands. All three are on by default
# and all three let any user with the permission make the server issue HTTP
# requests; pair them with
# MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS below if the stack
# shares a network with anything private.
# @type=boolean
MM_SERVICESETTINGS_ENABLEINCOMINGWEBHOOKS=true
# @type=boolean
MM_SERVICESETTINGS_ENABLEOUTGOINGWEBHOOKS=true
# @type=boolean
MM_SERVICESETTINGS_ENABLECOMMANDS=true

# Lets other applications use this server as an OAuth 2.0 provider.
# @type=boolean
MM_SERVICESETTINGS_ENABLEOAUTHSERVICEPROVIDER=true

# Space-separated allowlist of hosts/CIDRs that integrations, link previews
# and the image proxy may fetch from on private ranges. Empty (the default)
# blocks all private-address fetches. That block is what stops a user-created
# webhook or a pasted link from reaching this stack's own Postgres or a
# neighbouring service (SSRF). Widen it only to specific hostnames.
MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS=

# Space-separated request headers to trust for the client's real IP when
# something sits in front of this container (e.g. "X-Forwarded-For"). Empty
# means trust none, so rate limiting and audit logs see the proxy's address.
# Only list headers your proxy actually overwrites.
MM_SERVICESETTINGS_TRUSTEDPROXYIPHEADER=

# Origins allowed to call the API cross-site. "*" allows every site, which
# combined with cookie auth is how a third-party page reads a logged-in
# user's messages. Empty (default) means same-origin only.
MM_SERVICESETTINGS_ALLOWCORSFROM=

# How static assets are served: "gzip" compresses them, "disabled" turns the
# built-in file server off entirely (only for a front proxy that serves the
# web app itself). "regular" is silently rewritten to "gzip".
# @type=enum(gzip, disabled)
MM_SERVICESETTINGS_WEBSERVERMODE=gzip

# Server-side request timeouts, in seconds. Raise ReadTimeout if large
# uploads are cut off behind a slow link.
# @type=number
MM_SERVICESETTINGS_READTIMEOUT=300
# @type=number
MM_SERVICESETTINGS_WRITETIMEOUT=300
# @type=number
MM_SERVICESETTINGS_IDLETIMEOUT=60

# Max size of a non-upload API request body, in bytes. Uploads are governed
# by MM_FILESETTINGS_MAXFILESIZE instead.
# @type=number
MM_SERVICESETTINGS_MAXIMUMPAYLOADSIZEBYTES=300000

# Emails the admins when Mattermost publishes a security update for the
# version you run. Leave on.
# @type=boolean
MM_SERVICESETTINGS_ENABLESECURITYFIXALERT=true

# Developer/testing modes: verbose client errors, the /test commands, and
# permission to talk to endpoints with invalid TLS certificates. All three
# leak information or weaken transport security. Keep them false.
# @type=boolean
MM_SERVICESETTINGS_ENABLEDEVELOPER=false
# @type=boolean
MM_SERVICESETTINGS_ENABLETESTING=false
# @type=boolean
MM_SERVICESETTINGS_ENABLEINSECUREOUTGOINGCONNECTIONS=false

# ─── Database ──────────────────────────────────────────────────────────────

# Storage driver. PostgreSQL is the only supported value on v11: MySQL
# support ended in v11.0 and the server refuses to validate any other name.
# @required
# @type=enum(postgres)
# @docs("Database configuration", https://docs.mattermost.com/administration-guide/configure/environment-configuration-settings)
MM_SQLSETTINGS_DRIVERNAME=postgres

# Connection string, assembled by the compose from the prompted
# POSTGRES_PASSWORD and the bundled database's hostname. Mattermost creates
# and migrates its own schema on boot, so there is no separate migration
# step. v11.7 requires PostgreSQL 14 or newer, which the stack's
# postgres:16-alpine satisfies. Special characters in the password must be
# URL-encoded here.
# @required
# @sensitive
# @docs("Software and hardware requirements", https://docs.mattermost.com/deployment-guide/software-hardware-requirements)
MM_SQLSETTINGS_DATASOURCE=postgres://mattermost:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/mattermost?sslmode=disable&connect_timeout=10

# Space-separated read-replica connection strings. Empty means every query
# goes to the primary, which is what this single-database stack wants.
# @sensitive
MM_SQLSETTINGS_DATASOURCEREPLICAS=

# The key that encrypts secrets AT REST inside config.json and the database:
# the SMTP password, LDAP/SAML/OAuth client secrets, and other stored
# credentials. Minimum 32 characters; the server rejects anything shorter.
# Leave it empty and Mattermost generates a random key on first boot and
# writes it into config.json on the `mattermost-config` volume: lose or
# recreate that volume and every value it encrypted becomes permanently
# unreadable, and the instance comes back with blank SMTP and SSO
# credentials. Set it here so the key lives with the stack's other secrets
# and survives a volume rebuild.
# @required
# @sensitive
# @type=string(minLength=32)
MM_SQLSETTINGS_ATRESTENCRYPTKEY=

# Connection pool. MaxOpenConns is per Mattermost process; the bundled
# Postgres accepts 100 connections in total, so the default already sits at
# that ceiling. Lower it before adding replicas or anything else that
# connects to the same database.
# @type=number
MM_SQLSETTINGS_MAXIDLECONNS=50
# @type=number
MM_SQLSETTINGS_MAXOPENCONNS=100
# @type=number
MM_SQLSETTINGS_CONNMAXLIFETIMEMILLISECONDS=3600000
# @type=number
MM_SQLSETTINGS_CONNMAXIDLETIMEMILLISECONDS=300000

# Seconds a normal query / an analytics query may run before it is cancelled.
# @type=number
MM_SQLSETTINGS_QUERYTIMEOUT=30
# @type=number
MM_SQLSETTINGS_ANALYTICSQUERYTIMEOUT=300

# Turns off Postgres full-text search. On this stack that means NO message or
# file search at all: v11.0 retired the experimental Bleve engine (the old
# MM_BLEVESETTINGS_* section no longer exists in the config model), and
# Elasticsearch is not available in Team Edition. Leave false.
# @type=boolean
MM_SQLSETTINGS_DISABLEDATABASESEARCH=false

# Logs every SQL statement the server issues. Extremely noisy and it puts
# query parameters in the logs; debugging only.
# @type=boolean
MM_SQLSETTINGS_TRACE=false

# ─── Bundled Postgres ──────────────────────────────────────────────────────

# Role Mattermost connects as, created by the postgres:16-alpine image on
# first boot. It is baked into MM_SQLSETTINGS_DATASOURCE above; changing it
# here alone only breaks the pair.
POSTGRES_USER=mattermost

# Password for that role, used by both the database container and the
# datasource above. Only reachable on the stack's private network, but a weak
# value is still a full read/write path to every message, file record and
# password hash.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot. Baked into MM_SQLSETTINGS_DATASOURCE above.
POSTGRES_DB=mattermost

# ─── File storage ──────────────────────────────────────────────────────────

# Where uploads go: "local" writes to MM_FILESETTINGS_DIRECTORY inside the
# container, "amazons3" to any S3-compatible bucket (MinIO included).
# @type=enum(local, amazons3)
# @docs("File storage configuration", https://docs.mattermost.com/administration-guide/configure/environment-configuration-settings)
MM_FILESETTINGS_DRIVERNAME=local

# Upload directory, relative to /mattermost (the image's WORKDIR) unless
# absolute. The default resolves to /mattermost/data, which is exactly where
# the stack mounts the `mattermost-data` volume. Change it and the volume
# stops covering uploads.
MM_FILESETTINGS_DIRECTORY=./data/

# Largest single upload, in bytes. Default is 100 MiB. A reverse proxy in
# front of this stack usually has a lower body limit of its own; raise both.
# @type=number
MM_FILESETTINGS_MAXFILESIZE=104857600

# Lets users generate a public link to any file they can see. A public link
# needs no login and is not revocable per file. The only way to invalidate
# every issued link is to change the salt below. Off by default.
# @type=boolean
# @docs("Public links", https://docs.mattermost.com/administration-guide/configure/site-configuration-settings)
MM_FILESETTINGS_ENABLEPUBLICLINK=false

# The HMAC salt that signs those public links, minimum 32 characters. Empty
# means the server invents one on first boot and stores it in config.json on
# the `mattermost-config` volume; rebuilding that volume silently rotates it
# and breaks every link already shared. Anyone who learns this value can
# forge a valid link to ANY file on the instance, so treat it as a signing
# key, not a nonce. Set it here even if public links are off, so enabling
# them later does not depend on container state.
# @required
# @sensitive
# @type=string(minLength=32)
MM_FILESETTINGS_PUBLICLINKSALT=

# Indexes the text inside uploaded documents so search can match on it.
# Costs CPU and memory per upload; ExtractContentTimeout caps it in seconds
# (0 disables the cap), ArchiveRecursion also opens up nested archives.
# @type=boolean
MM_FILESETTINGS_EXTRACTCONTENT=true
# @type=number
MM_FILESETTINGS_EXTRACTCONTENTTIMEOUT=10
# @type=boolean
MM_FILESETTINGS_ARCHIVERECURSION=false

# S3 / MinIO target, read only when DriverName is "amazons3". Endpoint
# defaults to AWS; point it at your MinIO host (host:port, no scheme) and
# turn AMAZONS3SSL off for a plaintext in-cluster MinIO. SignV2 is only for
# gateways too old for AWS Signature v4.
MM_FILESETTINGS_AMAZONS3BUCKET=
# @sensitive
MM_FILESETTINGS_AMAZONS3ACCESSKEYID=
# @sensitive
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY=
MM_FILESETTINGS_AMAZONS3REGION=
MM_FILESETTINGS_AMAZONS3ENDPOINT=s3.amazonaws.com
# @type=boolean
MM_FILESETTINGS_AMAZONS3SSL=true
# @type=boolean
MM_FILESETTINGS_AMAZONS3SIGNV2=false
MM_FILESETTINGS_AMAZONS3PATHPREFIX=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────

# SMTP relay. The built-in defaults (localhost:10025) are the development
# inbucket and deliver nothing in this stack, so until you fill these in,
# password resets, email invitations and notification digests are dead,
# which also means the very first account has to be created through the
# signup page rather than an invite.
# @docs("SMTP email setup", https://docs.mattermost.com/administration-guide/configure/smtp-email)
MM_EMAILSETTINGS_SMTPSERVER=localhost
# @type=port
MM_EMAILSETTINGS_SMTPPORT=10025
MM_EMAILSETTINGS_SMTPUSERNAME=
# @sensitive
MM_EMAILSETTINGS_SMTPPASSWORD=

# Transport security to the relay: "" is plaintext, "TLS" is implicit TLS
# (usually port 465), "STARTTLS" upgrades an initial plaintext connection
# (usually 587). Only "", "TLS" and "STARTTLS" validate ("PLAIN" is accepted
# and rewritten to ""). EnableSMTPAuth must be true for username/password to
# be offered at all; it defaults to true whenever ConnectionSecurity is not "".
MM_EMAILSETTINGS_CONNECTIONSECURITY=
# @type=boolean
MM_EMAILSETTINGS_ENABLESMTPAUTH=false
# Skips verification of the relay's certificate, so it accepts any
# certificate, including an attacker's. Only for a relay with a self-signed
# cert on a trusted network.
# @type=boolean
MM_EMAILSETTINGS_SKIPSERVERCERTIFICATEVERIFICATION=false
# @type=number
MM_EMAILSETTINGS_SMTPSERVERTIMEOUT=10

# From: address and display name on every outbound email, and the address
# replies go to. The upstream defaults are literally test@example.com; most
# relays will refuse to send from an address they do not own, so set these.
# @type=email
MM_EMAILSETTINGS_FEEDBACKEMAIL=test@example.com
MM_EMAILSETTINGS_FEEDBACKNAME=
# @type=email
MM_EMAILSETTINGS_REPLYTOADDRESS=test@example.com
MM_EMAILSETTINGS_FEEDBACKORGANIZATION=

# Master switch for notification emails, and whether a new account must click
# a verification link before it can sign in. Requiring verification is what
# stops an open signup from accepting made-up addresses, but it needs
# working SMTP above, or nobody can complete signup.
# @type=boolean
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
# @type=boolean
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false

# Email/username sign-in and email sign-up. Setting EnableSignUpWithEmail to
# false closes the self-service registration form; combined with
# MM_TEAMSETTINGS_ENABLEUSERCREATION it is how you lock an instance down to
# invited users only.
# @type=boolean
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL=true
# @type=boolean
MM_EMAILSETTINGS_ENABLESIGNINWITHEMAIL=true
# @type=boolean
MM_EMAILSETTINGS_ENABLESIGNINWITHUSERNAME=true

# Batches notification emails instead of sending one per mention. Interval is
# in seconds.
# @type=boolean
MM_EMAILSETTINGS_ENABLEEMAILBATCHING=false
# @type=number
MM_EMAILSETTINGS_EMAILBATCHINGINTERVAL=30

# Mobile push. The default points at Mattermost's PUBLIC TEST push proxy
# (push-test.mattermost.com), which is rate-limited, unsupported for
# production, and relays your notification payloads through a third party.
# Point it at your own mattermost-push-proxy, or set
# PUSHNOTIFICATIONCONTENTS to "generic_no_channel"/"generic" so message text
# never leaves the server.
# @type=url
MM_EMAILSETTINGS_PUSHNOTIFICATIONSERVER=https://push-test.mattermost.com
# @type=enum(generic_no_channel, generic, full, id_loaded)
MM_EMAILSETTINGS_PUSHNOTIFICATIONCONTENTS=full
# @type=boolean
MM_EMAILSETTINGS_SENDPUSHNOTIFICATIONS=true

# ─── Teams, signup and branding ────────────────────────────────────────────

# Name shown in the browser title, on the login page and in emails. Longer
# than 30 characters fails config validation and the server will not start.
# @docs("Users and teams", https://docs.mattermost.com/administration-guide/configure/user-management-configuration-settings)
MM_TEAMSETTINGS_SITENAME=Mattermost

# OPEN SIGNUP. EnableUserCreation true (the default) means anyone who can
# reach MM_SERVICESETTINGS_SITEURL can create an account; EnableOpenServer
# additionally lets them join teams without an invitation, turning a public
# instance into one anybody on the internet can walk into. Set
# ENABLEUSERCREATION to false once your users exist, or restrict signup to
# your own domains with RESTRICTCREATIONTODOMAINS (comma-separated, e.g.
# "example.com,example.org") and require email verification above.
# @type=boolean
# @docs("Signup configuration", https://docs.mattermost.com/administration-guide/configure/authentication-configuration-settings)
MM_TEAMSETTINGS_ENABLEUSERCREATION=true
# @type=boolean
MM_TEAMSETTINGS_ENABLEOPENSERVER=false
MM_TEAMSETTINGS_RESTRICTCREATIONTODOMAINS=

# Caps per team. MaxUsersPerTeam is the one people hit first. The default of
# 50 silently blocks the 51st join.
# @type=number
MM_TEAMSETTINGS_MAXUSERSPERTEAM=50
# @type=number
MM_TEAMSETTINGS_MAXCHANNELSPERTEAM=2000

# Who a user may direct-message: "any" is anyone on the server, "team"
# restricts it to people who share a team.
# @type=enum(any, team)
MM_TEAMSETTINGS_RESTRICTDIRECTMESSAGE=any

# Custom text on the login page. EnableCustomBrand must be true for
# CustomBrandText to render; CustomDescriptionText replaces the tagline
# regardless.
# @type=boolean
MM_TEAMSETTINGS_ENABLECUSTOMBRAND=false
MM_TEAMSETTINGS_CUSTOMBRANDTEXT=
MM_TEAMSETTINGS_CUSTOMDESCRIPTIONTEXT=

# ─── Logging ───────────────────────────────────────────────────────────────

# Console logging is what `docker logs` shows. The stock ConsoleLevel is
# DEBUG, which is very chatty for a production instance. INFO or WARN is the
# usual choice. ConsoleJson controls structured vs. human-readable output.
# @type=boolean
# @docs("Logging configuration", https://docs.mattermost.com/administration-guide/configure/environment-configuration-settings)
MM_LOGSETTINGS_ENABLECONSOLE=true
# @type=enum(TRACE, DEBUG, INFO, WARN, ERROR, FATAL, PANIC)
MM_LOGSETTINGS_CONSOLELEVEL=DEBUG
# @type=boolean
MM_LOGSETTINGS_CONSOLEJSON=true

# File logging, written to MM_LOGSETTINGS_FILELOCATION, which when empty
# means ./logs relative to /mattermost, i.e. exactly where the stack mounts
# the `mattermost-logs` volume. Nothing rotates these for you.
# @type=boolean
MM_LOGSETTINGS_ENABLEFILE=true
# @type=enum(TRACE, DEBUG, INFO, WARN, ERROR, FATAL, PANIC)
MM_LOGSETTINGS_FILELEVEL=INFO
# @type=boolean
MM_LOGSETTINGS_FILEJSON=true
MM_LOGSETTINGS_FILELOCATION=

# Logs the full request and response body of every webhook and slash command,
# including whatever secrets they carry. Debugging only.
# @type=boolean
MM_LOGSETTINGS_ENABLEWEBHOOKDEBUGGING=true

# Telemetry to Mattermost, and Sentry error reporting (which follows
# EnableDiagnostics unless set on its own). Turning EnableDiagnostics off
# also disables the bundled NPS survey plugin by default.
# @type=boolean
MM_LOGSETTINGS_ENABLEDIAGNOSTICS=true
# @type=boolean
MM_LOGSETTINGS_ENABLESENTRY=true

# Full advanced-logging configuration as one JSON document (multiple targets,
# syslog, TCP sinks, per-level filters). Parsed as JSON, and an invalid
# document fails config validation. Empty means "{}". Use the simple
# settings above instead.
MM_LOGSETTINGS_ADVANCEDLOGGINGJSON=

# ─── Plugins ───────────────────────────────────────────────────────────────

# Master switch for the plugin subsystem. Off disables every bundled plugin
# (Calls, Playbooks, the AI agent, NPS) as well as anything you installed.
# @type=boolean
# @docs("Plugins configuration", https://docs.mattermost.com/administration-guide/configure/plugins-configuration-settings)
MM_PLUGINSETTINGS_ENABLE=true

# Lets an admin upload a plugin bundle through the System Console or the API.
# A plugin runs server-side Go code with full access to the database and the
# filesystem, so this is remote code execution by any system admin. It is
# off by default, and AllowInsecureDownloadURL additionally permits
# installing from a plain-http URL. RequirePluginSignature makes the server
# verify bundles against SIGNATUREPUBLICKEYFILES (space-separated paths
# inside the container) before it will load them.
# @type=boolean
MM_PLUGINSETTINGS_ENABLEUPLOADS=false
# @type=boolean
MM_PLUGINSETTINGS_ALLOWINSECUREDOWNLOADURL=false
# @type=boolean
MM_PLUGINSETTINGS_REQUIREPLUGINSIGNATURE=false
MM_PLUGINSETTINGS_SIGNATUREPUBLICKEYFILES=

# Where plugin bundles and their web assets are unpacked, relative to
# /mattermost. These two defaults are the mount points of the stack's
# `mattermost-plugins` and `mattermost-client-plugins` volumes. Change them
# and installed plugins stop surviving a container restart.
MM_PLUGINSETTINGS_DIRECTORY=./plugins
MM_PLUGINSETTINGS_CLIENTDIRECTORY=./client/plugins

# The in-product plugin marketplace. EnableRemoteMarketplace is what actually
# contacts MARKETPLACEURL; set it false for an air-gapped instance.
# AutomaticPrepackagedPlugins installs the plugins shipped inside the image
# on boot.
# @type=boolean
MM_PLUGINSETTINGS_ENABLEMARKETPLACE=true
# @type=boolean
MM_PLUGINSETTINGS_ENABLEREMOTEMARKETPLACE=true
# @type=url
MM_PLUGINSETTINGS_MARKETPLACEURL=https://api.integrations.mattermost.com
# @type=boolean
MM_PLUGINSETTINGS_AUTOMATICPREPACKAGEDPLUGINS=true

# Per-plugin settings and enable/disable state, each as one JSON document,
# and the only way to configure a plugin from the environment. Example for
# the state map:
# {"com.mattermost.calls":{"Enable":true},"com.mattermost.nps":{"Enable":false}}
MM_PLUGINSETTINGS_PLUGINS=
MM_PLUGINSETTINGS_PLUGINSTATES=

# ─── Misc ──────────────────────────────────────────────────────────────────

# Enterprise license, supplied as the CONTENTS of the license file (not a
# path). Team Edition needs nothing here; an invalid value is ignored and the
# server starts unlicensed rather than failing.
# @sensitive
MM_LICENSE=

# Baked into the image as "docker". It matches no field of model.Config, so
# the MM_-prefixed environment pass ignores it entirely; it is a marker on
# the image, not a setting. Listed only so its presence in `docker inspect`
# is not mistaken for one.
MM_INSTALL_TYPE=docker
