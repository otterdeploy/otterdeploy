# Mautic 7.1.3 (image mautic/mautic:7.1.3-apache) environment schema
# (@env-spec / varlock format).
#
# Source: the image's own startup scripts at the tag the compose pins
# (`common/docker-entrypoint.sh`, `common/startup/*.sh`, `common/templates/*`
# and the `ENV` block of `Dockerfile` in mautic/docker-mautic, branch `main`,
# last pushed 2026-05-05, which is the tree that built both 7.1.3 and 7.2.0),
# cross-read against Mautic 7.1.3 itself: `ParameterLoader.php`,
# `app/bundles/CoreBundle/Loader/EnvVars/*` and every `%env(MAUTIC_…)%` in
# `app/config/` and `app/bundles/*/Config/`.
#
# Mautic is PHP/Symfony and its real configuration file is
# `<config>/local.php`. There is no `.env` the app reads. Two mechanisms
# bridge env into it, and they behave very differently:
#
#  1. FIRST RUN ONLY. If `local.php` is absent the entrypoint copies a
#     template whose db_* entries are literal `getenv()` calls, so
#     MAUTIC_DB_HOST/PORT/DATABASE/USER/PASSWORD populate the installer's
#     database step. As soon as the web installer finishes, Mautic REWRITES
#     `local.php` with the resolved literal values; from then on the
#     MAUTIC_DB_* variables no longer move the app's database. They are
#     still read by the entrypoint's `mysqladmin ping` wait, so a mismatch
#     shows up as a container that starts against one database and talks to
#     another. Changing the database after install means editing `local.php`
#     in the config volume.
#  2. EVERY BOOT. `MAUTIC_CONFIG_PARAMETERS` (a JSON object) is merged OVER
#     `local.php` by `ParameterLoader::loadLocalParameters()` on every
#     request and every console command. It is the only env-based route to
#     an arbitrary Mautic setting, and this template uses it for `site_url`.
#
# Three variables this template used to set are read by NOTHING in this image
# or in Mautic 7.1.3 and have been removed from the compose: `MAUTIC_URL`,
# `MAUTIC_RUN_CRON_JOBS` and `MAUTIC_TRUSTED_PROXIES` (all belonged to the
# pre-5.x image). `MAUTIC_DB_NAME` was likewise dead: the entrypoint's
# `local.php` template reads `MAUTIC_DB_DATABASE`. The image also ships
# `DOCKER_MAUTIC_RUN_MIGRATIONS=false`, which no script consults: the web
# role runs `doctrine:migrations:migrate -n` unconditionally whenever
# `local.php` already has a db_driver and a site_url.
#
# The README's claim that "every setting of Mautic can be set as environment
# variable" is only half true. `ConfigEnvVars` EXPORTS each local.php key as
# `MAUTIC_<KEY>`, and Symfony's Dotenv::populate does not overwrite a
# variable the operator already set, so an operator value wins, but only for
# the handful of keys some config file actually consumes as `%env(…)%`
# (listed under "Mautic settings" below). `site_url`, `trusted_proxies` and
# `trusted_hosts` are NOT among them: they are read straight off the
# parameter bag (and `trusted_proxies`/`trusted_hosts` by a middleware that
# reads `local.php` directly, so not even MAUTIC_CONFIG_PARAMETERS reaches
# them; set those two in the UI under Configuration → System Settings once
# the stack is behind the proxy, or Mautic will log the proxy's IP as the
# visitor's).
#
# SECURITY: READ THIS FIRST. `/installer` is a PUBLIC route with no
# authentication, and it stays open until `local.php` holds both a `db_driver`
# and a `site_url`. The image's generated `local.php` has db_driver from the
# first second, but never a site_url, so a freshly deployed Mautic is an open
# installer: the FIRST visitor completes setup and chooses the admin e-mail
# and password. This image has no admin bootstrap variables at all (the old
# `MAUTIC_ADMIN_EMAIL` / `MAUTIC_ADMIN_PASSWORD` are gone), so the only ways
# to close the window are to finish the installer yourself before the URL is
# shared, or to run `php bin/console mautic:install <url>
# --admin_email=… --admin_password=…` in the container first.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Official Mautic Docker image", https://github.com/mautic/docker-mautic)
# ---

# ─── Database (first run: fills the installer; always: the startup ping) ───

# Hostname of the MySQL server. Platform-owned: the compose points it at the
# bundled `db` service on both the web and the cron container. The entrypoint
# refuses to start without it, and blocks for up to 31s waiting on
# `mysqladmin ping` at this host before handing over to Apache.
# @required @docs("Docker image environment variables", https://github.com/mautic/docker-mautic#environment-variables)
MAUTIC_DB_HOST=${{stack.db.HOST}}

# MySQL port. Defaulted by the entrypoint itself, not by Mautic.
# @type=port
MAUTIC_DB_PORT=3306

# Database that holds Mautic's tables. This is the name the generated
# `local.php` reads. `MAUTIC_DB_NAME` is NOT read by anything, which is why
# this template used to arrive at the installer with an empty database field.
# @required
MAUTIC_DB_DATABASE=mautic

# MySQL user. Matches `MYSQL_USER` on the bundled database.
# @required
MAUTIC_DB_USER=mautic

# MySQL password, rendered from the stack's prompted `MYSQL_PASSWORD` so the
# app and the bundled database agree.
# @required @sensitive
MAUTIC_DB_PASSWORD=${MYSQL_PASSWORD}

# Docker-secret variants: each is read only when its plain twin is empty, and
# the value is the PATH of a file whose whole contents become the setting
# (`getenv(X) ?: file_get_contents(getenv(X_FILE))`). There is no
# `MAUTIC_DB_DATABASE_FILE`, because the database name has no secret form.
MAUTIC_DB_HOST_FILE=
MAUTIC_DB_PORT_FILE=
MAUTIC_DB_USER_FILE=
# @sensitive
MAUTIC_DB_PASSWORD_FILE=

# Doctrine's `server_version`, consumed as `%env(mauticconst:…)%` in
# `app/config/config.php`. Left empty Doctrine connects once to detect the
# server; setting it (e.g. `8.4.0`) removes that round trip. Wrong values
# make Doctrine emit SQL the server rejects.
MAUTIC_DB_SERVER_VERSION=

# ─── Bundled MySQL 8.4 ───────────────────────────────────────────────────

# Database, user and password the bundled MySQL creates on first boot, from
# an empty data directory only. Changing them later does nothing to an
# existing volume. They are the twins of the MAUTIC_DB_* values above.
# @docs("MySQL image environment variables", https://hub.docker.com/_/mysql)
MYSQL_DATABASE=mautic
MYSQL_USER=mautic
# @required @sensitive
MYSQL_PASSWORD=${MYSQL_PASSWORD}

# Generates a random root password at initialization and prints it once to
# the container log. Mautic never uses root; there is deliberately no stored
# root credential.
MYSQL_RANDOM_ROOT_PASSWORD=1

# ─── Container role ──────────────────────────────────────────────────────

# Which of the three programs this container runs. The image defaults to
# `mautic_web` (Apache); the compose starts a second container of the same
# image with `mautic_cron`, which is how Mautic's scheduled work actually
# happens: `mautic:segments:update`, `mautic:campaigns:update` and
# `mautic:campaigns:trigger` every 15 minutes from the image's crontab. With
# no cron container the install looks completely healthy and silently never
# segments, never advances a campaign and never sends. The cron role blocks
# until `local.php` has a site_url, i.e. until the installer is finished.
# `mautic_worker` runs the Messenger consumers under supervisord and is only
# useful once a queue DSN is configured.
# @type=enum(mautic_web, mautic_cron, mautic_worker)
# @docs("Cron jobs", https://docs.mautic.org/en/latest/configuration/cron_jobs.html)
DOCKER_MAUTIC_ROLE=mautic_web

# Verbose startup logging from the entrypoint scripts (volume, env and
# database checks). Costs nothing; useful when a container exits early.
# @type=boolean
DEBUG=false

# First-run demo instance: installs Mautic non-interactively with the
# throwaway account willchange@mautic.org / `willchange`, then loads Doctrine
# fixtures over it. NEVER true on anything reachable, since it publishes a
# known admin credential. Only consulted by the `mautic_web` role.
# @type=boolean
DOCKER_MAUTIC_LOAD_TEST_DATA=false

# Number of `messenger:consume` processes supervisord starts per queue in the
# `mautic_worker` role. Ignored by the web and cron roles.
# @type=number
# @docs("Message queue", https://docs.mautic.org/en/latest/queue/queue.html)
DOCKER_MAUTIC_WORKERS_CONSUME_EMAIL=2
# @type=number
DOCKER_MAUTIC_WORKERS_CONSUME_HIT=2
# @type=number
DOCKER_MAUTIC_WORKERS_CONSUME_FAILED=2

# Which server the web role execs after its checks. Baked at build time
# (`ARG FLAVOUR`) and matched to the image tag: `-apache` images are built
# with `apache`, `-fpm` with `fpm`. Overriding it on an `-apache` image makes
# the entrypoint exec `php-fpm` with nothing in front of it, so the service
# comes up unreachable.
# @type=enum(apache, fpm)
FLAVOUR=apache

# ─── Mautic settings ─────────────────────────────────────────────────────

# JSON object merged over `local.php` on every boot, the one env route to an
# arbitrary Mautic parameter. The compose uses it to hold the site URL, which
# Mautic needs for tracking pixels, e-mail links and every absolute URL a
# console command generates (a CLI run has no request to infer a host from).
# Invalid JSON is a fatal error at boot, not a warning. Note it does NOT
# reach `trusted_proxies` / `trusted_hosts`, and it does not close the
# installer: `checkIfInstalled()` reads `local.php` on disk.
# @docs("Mautic configuration settings", https://docs.mautic.org/en/latest/configuration/settings.html)
MAUTIC_CONFIG_PARAMETERS={"site_url":"${MAUTIC_URL}"}

# The stack's public origin, e.g. `https://mautic.example.com`, prompted at
# install and interpolated into MAUTIC_CONFIG_PARAMETERS above. Mautic reads
# no variable of this name. It is a template-level input, and setting it in
# the container instead has no effect. Must be the URL visitors actually use;
# a wrong one produces tracking pixels and e-mail links pointing elsewhere.
# @required @type=url
MAUTIC_URL=

# Symfony Mailer DSN for all outbound mail, consumed as
# `%env(urlencoded-dsn:MAUTIC_MAILER_DSN)%`. Empty here means Mautic uses
# whatever the UI's e-mail settings wrote into `local.php`. Password and
# username inside a DSN must be URL-encoded.
# @sensitive
# @docs("Email settings", https://docs.mautic.org/en/latest/configuration/settings.html#email-settings)
MAUTIC_MAILER_DSN=

# Messenger transports. Left empty Mautic processes e-mails and page hits
# synchronously in the request; pointing these at a real broker (AMQP,
# Doctrine, Redis) is what the `mautic_worker` role consumes. `_FAILED` is
# the retry queue and accepts an empty value meaning "no failure transport".
# @sensitive
# @docs("Message queue", https://docs.mautic.org/en/latest/queue/queue.html)
MAUTIC_MESSENGER_DSN_EMAIL=
# @sensitive
MAUTIC_MESSENGER_DSN_HIT=
# @sensitive
MAUTIC_MESSENGER_DSN_FAILED=

# Name of the session cookie. Two Mautic instances on the same parent domain
# with the same name will overwrite each other's sessions.
MAUTIC_SESSION_NAME=

# Table Doctrine records applied migrations in. Change it only when Mautic
# shares a schema with something else; a wrong value makes the migration
# runner believe nothing has ever been applied.
MAUTIC_MIGRATIONS_TABLE_NAME=

# OAuth2 token lifetimes in seconds for the REST API, consumed as
# `%env(int:…)%`. Empty falls back to the values in `local.php`.
# @type=number
MAUTIC_API_OAUTH2_ACCESS_TOKEN_LIFETIME=
# @type=number
MAUTIC_API_OAUTH2_REFRESH_TOKEN_LIFETIME=

# SAML single sign-on, wired through `%env(bool:MAUTIC_SAML_ENABLED)%` and
# friends in the security configuration. Enabling it without a matching IdP
# metadata upload locks the login form out.
# @type=boolean
# @docs("Authentication", https://docs.mautic.org/en/latest/authentication/authentication.html)
MAUTIC_SAML_ENABLED=
MAUTIC_SAML_ENTITY_ID=
MAUTIC_SAML_LOGIN_PATH=
MAUTIC_SAML_LOGIN_CHECK_PATH=

# Paths and URL of the elFinder media browser, resolved into the elFinder
# bundle configuration. They follow the media volume; move one without the
# other and the file manager renders broken thumbnails.
MAUTIC_EL_FINDER_URL=
MAUTIC_EL_FINDER_PATH=

# Where compiled Twig templates are cached in prod. Derived from Mautic's
# tmp path when unset; only worth setting to move it onto faster storage.
MAUTIC_TWIG_CACHE_DIR=

# ─── PHP runtime ─────────────────────────────────────────────────────────

# Written into `/usr/local/etc/php/php.ini` at build and expanded at start.
# The upload limits are the ceiling on asset and theme uploads through the
# UI; the execution time is what a long segment rebuild or a large import
# runs against before PHP kills it.
# @docs("Docker image environment variables", https://github.com/mautic/docker-mautic#environment-variables)
PHP_INI_VALUE_DATE_TIMEZONE=UTC
PHP_INI_VALUE_MEMORY_LIMIT=512M
PHP_INI_VALUE_UPLOAD_MAX_FILESIZE=512M
PHP_INI_VALUE_POST_MAX_FILESIZE=512M
# @type=number
PHP_INI_VALUE_MAX_EXECUTION_TIME=300

# Apache's DocumentRoot, substituted into the vhost files at build and
# expanded by Apache at start. Mautic 5+ serves out of `docroot/`; pointing
# this at the project root exposes `config/local.php` and `var/` to the web.
APACHE_DOCUMENT_ROOT=/var/www/html/docroot

# ─── Paths and ownership ─────────────────────────────────────────────────

# Every path the entrypoint asserts exists and chowns to the web user before
# starting anything; a missing one is a hard exit with a "volume is not
# mounted correctly" error. These must agree with the compose's volume
# targets: the config, logs and media volumes are mounted at exactly these
# defaults, and `_FILES` / `_IMAGES` live inside the media volume.
# @docs("Docker image environment variables", https://github.com/mautic/docker-mautic#environment-variables)
MAUTIC_VOLUME_CONFIG=/var/www/html/config
MAUTIC_VOLUME_LOGS=/var/www/html/var/logs
MAUTIC_VOLUME_MEDIA=/var/www/html/docroot/media
MAUTIC_VOLUME_FILES=/var/www/html/docroot/media/files
MAUTIC_VOLUME_IMAGES=/var/www/html/docroot/media/images
MAUTIC_VAR=/var/www/html/var

# Path to the Symfony console binary the entrypoints, the crontab and every
# `doctrine:migrations:migrate` invocation use.
# @docs("Command Line Interface (CLI) commands", https://docs.mautic.org/en/latest/configuration/command_line_interface.html)
MAUTIC_CONSOLE=/var/www/html/bin/console

# User and group the volumes are chowned to and every PHP process drops to.
# Only change these when the host's ownership on a bind mount forces it.
MAUTIC_WWW_USER=www-data
MAUTIC_WWW_GROUP=www-data
