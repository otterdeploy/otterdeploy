# Activepieces 0.90.1 environment schema (@env-spec / varlock format).
#
# The compose pins ghcr.io/activepieces/activepieces:0.90.1, the newest stable
# release (published 2026-09-03; the tag resolves on ghcr.io). Bumped from this
# template's prior pin of 0.75.0. Nothing between 0.75.0 and 0.90.1 required a
# compose edit: the image still EXPOSEs 80 and the entrypoint still defaults
# AP_PORT to 80 (nginx was dropped in 0.80.0 but Fastify took over the same
# port, only moving the health probe to /api/v1/health, which this compose does
# not use), AP_CONTAINER_TYPE still defaults to WORKER_AND_APP so one container
# runs both halves, and none of the twelve variables this compose sets was
# renamed or removed. The renames/removals in that window all concern keys this
# template never set: AP_MAX_CONCURRENT_JOBS_PER_PROJECT -> AP_DEFAULT_CONCURRENT_JOBS_LIMIT
# (0.82.0), AP_MAX_FILE_SIZE_MB -> AP_MAX_FLOW_RUN_LOG_SIZE_MB for run logs
# (0.77.0), and AP_PRE_WARM_CACHE deleted (0.86.0, superseded by
# AP_PREWARM_CACHE_ON_STARTUP).
#
# Source: the AppSystemProp / WorkerSystemProp enums plus the direct
# `process.env.AP_*` reads across packages/server and packages/core at tag
# 0.90.1 (system-props.ts, system.ts for defaults, system-validator.ts for
# shapes, worker/src/lib/config/configs.ts, docker-entrypoint.sh), cross-checked
# against the live "Environment Variables" reference (verified below).
#
# Four things that reference page and the repo's own .env.example get wrong at
# this version:
#   * `AP_MAX_STORE_ENTRY_VALUE_SIZE_KB` is documented in the Limits table;
#     nothing in the 0.90.1 source reads it. Omitted here.
#   * `AP_QUEUE_UI_ENABLED` is documented as defaulting to `true`; the code
#     defaults it to `false` (bullboard.ts) and has no entry for it in the
#     default map, so the queue dashboard is off unless you turn it on.
#   * `.env.example` still lists `AP_TEMPLATES_SOURCE_URL` and
#     `AP_ENGINE_EXECUTABLE_PATH`; neither is read anywhere at 0.90.1 (the
#     templates URL is a hardcoded const in community-templates.service.ts).
#     Both omitted.
#   * The docs mark `AP_REDIS_USER` and `AP_REDIS_PASSWORD` as required for a
#     production deployment; they are optional, and this stack's bundled Redis
#     has no auth, so both stay empty.
#
# Also omitted deliberately: `AP_CODE_SANDBOX_TYPE`, which is read at boot only
# to throw. Setting it aborts startup with "deprecated, please use
# AP_EXECUTION_MODE instead". And the engine-internal variables the sandbox
# injects into its own child process (AP_BASE_CODE_DIRECTORY,
# AP_CUSTOM_PIECES_PATHS, AP_SANDBOX_WS_PORT, AP_SANDBOX_WS_TOKEN,
# AP_TEST_MODE), which are never operator input.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variables", https://www.activepieces.com/docs/install/reference/environment-variables)
# ---

# ─── Core identity ───────────────────────────────────────────────────────────

# The public URL this instance is reached at. Every webhook URL, app-trigger
# callback and emailed link is built from it, so a third party must be able to
# resolve it: a flow's webhook trigger is dead until this is right. No
# default: the boot-time validator only checks that what you give it is an
# http(s) URL.
# @required @type=url
AP_FRONTEND_URL=

# 32-character key that encrypts every stored piece connection. Must match
# /^[A-Za-z0-9]{32}$/ exactly (it is used as raw AES-256 key material) or the
# server refuses to start; generate with `openssl rand -hex 16`. Changing it
# after connections exist makes those connections undecryptable.
# @required @sensitive @type=string(matches=/^[A-Za-z0-9]{32}$/)
AP_ENCRYPTION_KEY=

# Signs every JWT the platform issues: sessions, worker tokens, invitation and
# file-read links. The container entrypoint also derives AP_WORKER_TOKEN from
# it at boot. Rotating it signs everyone out and invalidates outstanding
# invitations. Generate with `openssl rand -hex 32`.
# @required @sensitive
AP_JWT_SECRET=

# Which halves run in this container: APP (API + frontend), WORKER (flow
# execution), or WORKER_AND_APP (both). The entrypoint defaults it to
# WORKER_AND_APP, which is what this single-container template relies on.
# Setting APP here leaves no worker and no flow ever runs.
# @type=enum(APP, WORKER, WORKER_AND_APP)
AP_CONTAINER_TYPE=WORKER_AND_APP

# Port the API/frontend listens on inside the container. The entrypoint forces
# 80 when unset, which is the port the image EXPOSEs and this compose routes
# to; change it here and the service becomes unreachable. Note the worker's own
# fallback for this variable is 3000, so a worker in a separate container that
# talks to an app on a non-default port must be told the same value.
# @type=port
AP_PORT=80

# Runtime posture. `prod` is the default and what a deployed instance wants;
# `dev` turns on development behaviour (dev-piece watching, looser assets) and
# `test` is for the project's own test suite.
# @type=enum(prod, dev, test)
AP_ENVIRONMENT=prod

# Feature edition. `ce` (Community, the default) is the only one that works
# without a licence. An `ee` instance with no key is enrolled on the free plan
# and has credit limits enforced against it since 0.87.0.
# @type=enum(ce, ee, cloud)
# @docs("Enterprise license", https://www.activepieces.com/docs/install/configure-operate/enterprise-license)
AP_EDITION=ce

# Anonymous usage telemetry back to Activepieces. Upstream defaults it to true;
# this compose turns it off.
# @type=boolean
# @docs("Telemetry", https://www.activepieces.com/docs/install/configure-operate/telemetry)
AP_TELEMETRY_ENABLED=false

# (Beta) Internal base URL the platform uses for SSO callbacks when the API is
# reachable at a different address than AP_FRONTEND_URL, e.g.
# https://demo.activepieces.com/api. Leave empty and AP_FRONTEND_URL is used.
AP_INTERNAL_URL=

# Directory for the embedded PGLite database and local settings. Defaults to
# ~/.activepieces, which is /root/.activepieces in this image and is NOT on a
# volume in this template (irrelevant while AP_DB_TYPE stays POSTGRES).
AP_CONFIG_PATH=

# Static API key for the platform (management) API, sent as a bearer token.
# Community edition does not serve most platform endpoints, so this is only
# useful on an Enterprise instance.
# @sensitive
AP_API_KEY=

# "true" lets anyone who reaches the sign-in page create an account. Left off,
# only the first account (the one you create on the fresh instance) plus
# invited members can join. Turn it on only behind your own access control.
# @type=boolean
AP_ALLOW_OPEN_SIGN_UP=false

# Comma-separated origins pre-allowed to embed this instance in an iframe.
# Since 0.84.0 embedding requires an explicit allow list; wildcards are
# supported. Origins added through the API are merged with these.
AP_ALLOWED_EMBED_ORIGINS=

# Header to read the client's real IP from, behind a proxy. Used for rate
# limiting and audit records; trust it only if your proxy actually sets it.
AP_CLIENT_REAL_IP_HEADER=x-real-ip

# ─── Bundled Postgres ────────────────────────────────────────────────────────
# The `db` service in this stack. AP_POSTGRES_HOST is derived by the platform
# from that service and is never typed by hand.

# Platform prompt key for the database password. Threaded unchanged into
# AP_POSTGRES_PASSWORD below and into the db service's own POSTGRES_PASSWORD,
# so the two always agree.
# @required @sensitive
POSTGRES_PASSWORD=

# Which store the platform uses. POSTGRES is the default and what this stack
# provides; PGLITE is an embedded single-process database meant for local
# trials. The deprecated value SQLITE3 is silently migrated to PGLITE.
# @type=enum(POSTGRES, PGLITE)
AP_DB_TYPE=POSTGRES

# Hostname of the bundled Postgres, derived by the platform from the `db`
# service, never typed by the operator.
AP_POSTGRES_HOST=${{stack.db.HOST}}

# Port the bundled Postgres listens on. The `db` service publishes no custom
# port, so this is its twin: changing one without the other breaks the
# connection.
# @type=port
AP_POSTGRES_PORT=5432

# Database name. Matches POSTGRES_DB on the `db` service, which is what
# creates it on that container's first boot.
AP_POSTGRES_DATABASE=activepieces

# Role Activepieces connects as. Matches POSTGRES_USER on the `db` service.
AP_POSTGRES_USERNAME=activepieces

# The prompted password, threaded through unchanged so it always matches the
# `db` service's own POSTGRES_PASSWORD.
# @sensitive
AP_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# Full connection string. When set it wins outright and every discrete
# AP_POSTGRES_* field above is ignored. Only use it to point at a database
# outside this stack.
# @sensitive
AP_POSTGRES_URL=

# TLS to the database. The bundled Postgres speaks plaintext on the stack's
# private network, so both stay empty here; AP_POSTGRES_SSL_CA takes the CA
# certificate itself, not a path.
# @type=boolean
AP_POSTGRES_USE_SSL=false
# The CA certificate itself (PEM contents), not a path to one.
AP_POSTGRES_SSL_CA=

# Connection pool size (unset lets the driver decide) and how long an idle
# pooled connection is kept, in milliseconds.
# @type=number
AP_POSTGRES_POOL_SIZE=
# How long an idle pooled connection is held open, in milliseconds.
# @type=number
AP_POSTGRES_IDLE_TIMEOUT_MS=300000

# Set on the `db` service by the compose. Not read by Activepieces: these are
# the official Postgres image's own first-boot bootstrap variables, matched to
# the AP_POSTGRES_* values above.

# Superuser role created on the db container's first boot.
# @docs("Postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=activepieces

# Database created on the db container's first boot. Both are read only when
# the data volume is empty, so editing them later renames nothing.
POSTGRES_DB=activepieces

# ─── Bundled Redis ───────────────────────────────────────────────────────────
# Redis backs the BullMQ job queue: every flow run, trigger poll and webhook
# is a job on it. AP_REDIS_HOST is derived by the platform from the `redis`
# service in this stack.

# Where Redis lives: STANDALONE (this stack's dedicated service, the default),
# SENTINEL for a monitored cluster, or MEMORY for an in-process queue with no
# Redis at all. MEMORY loses every queued job on restart and cannot be shared
# by a second container.
# @type=enum(STANDALONE, SENTINEL, MEMORY)
AP_REDIS_TYPE=STANDALONE

# Hostname of the bundled Redis, derived by the platform from the `redis`
# service, never typed by the operator.
AP_REDIS_HOST=${{stack.redis.HOST}}

# Port the bundled Redis listens on; the twin of the `redis` service's own
# port.
# @type=port
AP_REDIS_PORT=6379

# Full Redis URL. When set, every other AP_REDIS_* setting is ignored.
# @sensitive
AP_REDIS_URL=

# Credentials for a Redis that requires auth. The bundled `redis` service has
# none, so both stay empty; the docs list them as required, which they are not.
AP_REDIS_USER=
# @sensitive
AP_REDIS_PASSWORD=


# Logical database index on the Redis server.
# @type=number
AP_REDIS_DB=0

# TLS to Redis. The CA variable is a path to a file inside the container, so
# it has to be mounted.
# @type=boolean
AP_REDIS_USE_SSL=false
# Path to a CA file inside the container; it has to be mounted to exist.
AP_REDIS_SSL_CA_FILE=

# Sentinel topology, used only when AP_REDIS_TYPE=SENTINEL. Hosts are
# comma-separated host:port pairs; the name is the monitored master's name.
AP_REDIS_SENTINEL_HOSTS=
# Name of the master the sentinels monitor.
AP_REDIS_SENTINEL_NAME=
# Which member to connect to.
# @type=enum(master, slave)
AP_REDIS_SENTINEL_ROLE=

# How long failed jobs are kept in Redis before they are trimmed, by age and
# by count. Lower them if Redis memory is tight on a noisy instance.
# @type=number
AP_REDIS_FAILED_JOB_RETENTION_DAYS=30
# The count-based half of the same trim.
# @type=number
AP_REDIS_FAILED_JOB_RETENTION_MAX_COUNT=100000

# Bull Board, a raw job-queue dashboard served at /api/ui. Off by default
# (despite the docs saying otherwise); when enabled BOTH credentials below are
# mandatory and the app throws at startup without them.
# @type=boolean
# @docs("Queue dashboard (Bull Board)", https://www.activepieces.com/docs/install/troubleshooting/bullboard)
AP_QUEUE_UI_ENABLED=false

# Basic-auth credentials guarding that dashboard. Both are mandatory whenever
# it is enabled.
AP_QUEUE_UI_USERNAME=
# @sensitive
AP_QUEUE_UI_PASSWORD=

# ─── Execution & sandboxing ──────────────────────────────────────────────────
# @docs("Sandboxing", https://www.activepieces.com/docs/install/architecture/sandboxing)

# How flow code is isolated. UNSANDBOXED (what this compose sets) runs pieces
# and user code in the worker process itself: fastest, and correct only when
# everyone who can author a flow is already trusted with the container.
# The SANDBOX_* modes use isolate/child processes and cost startup latency.
# @type=enum(UNSANDBOXED, SANDBOX_PROCESS, SANDBOX_CODE_ONLY, SANDBOX_CODE_AND_PROCESS)
AP_EXECUTION_MODE=UNSANDBOXED

# Jobs one worker runs at once; each occupies a sandbox slot. Raise it for
# throughput on a machine with headroom, lower it toward 1 if you would rather
# scale by adding worker containers.
# @type=number
AP_WORKER_CONCURRENCY=5

# Default cap on concurrent runs per project, overridable per project in the
# UI. Renamed from AP_MAX_CONCURRENT_JOBS_PER_PROJECT in 0.82.0, where the
# default also dropped from 100 to 5.
# @type=number
# @docs("Manage concurrency", https://www.activepieces.com/docs/admin-guide/guides/manage-concurrency)
AP_DEFAULT_CONCURRENT_JOBS_LIMIT=5

# Enforce the per-project limit above as a rate limiter rather than advisory.
# @type=boolean
AP_PROJECT_RATE_LIMITER_ENABLED=false

# Memory ceiling in KB for a single sandboxed engine process. Only meaningful
# in the SANDBOX_* execution modes.
# @type=number
AP_SANDBOX_MEMORY_LIMIT=1048576

# Comma-separated variable names copied from the container's environment into
# sandboxed code. Anything you list here becomes readable by every flow author
# on the instance. Prefer putting secrets in a connection.
AP_SANDBOX_PROPAGATED_ENV_VARS=

# Reuse a sandbox between runs instead of building a fresh one each time.
# Faster, at the cost of leaking state between runs of the same flow.
# @type=boolean
AP_REUSE_SANDBOX=false

# Directory the worker keeps its piece/code cache in, relative to the image's
# /usr/src/app WORKDIR unless absolute. This template mounts no volume there,
# so the cache is rebuilt from scratch after every restart, and the first run
# of each piece pays the download again.
AP_CACHE_BASE_PATH=cache

# Resolve and compile every enabled flow at worker startup instead of lazily on
# first run. Removes cold-start latency, but the warm-up itself scales with
# flow count and can OOM a small worker. Replaced AP_PRE_WARM_CACHE, removed in
# 0.86.0.
# @type=boolean
AP_PREWARM_CACHE_ON_STARTUP=false

# Ceiling on a single flow run, in seconds. Since this version it also bounds a
# single action run (an agent's piece tool, a chat action, MCP ap_run_action),
# which used to be capped at a hardcoded 120s, so raising it lets those hold a
# worker slot for just as long.
# @type=number
AP_FLOW_TIMEOUT_SECONDS=600

# Ceiling on one polling-trigger check, and on a trigger's enable/disable hooks
# (which do piece work such as registering a remote webhook).
# @type=number
AP_TRIGGER_TIMEOUT_SECONDS=60

# Ceiling on a trigger's enable/disable hooks specifically, which may call out
# to a provider to register or tear down a remote webhook.
# @type=number
AP_TRIGGER_HOOKS_TIMEOUT_SECONDS=180

# Ceiling on one outbound event-destination (audit webhook) delivery.
# @type=number
AP_EVENT_DESTINATION_TIMEOUT_SECONDS=10

# How many run-metadata updates are flushed to the database in parallel.
# @type=number
AP_RUNS_METADATA_UPDATE_CONCURRENCY=2

# Egress posture for user code. STRICT installs an in-process SSRF guard that
# blocks private, loopback, link-local and cloud-metadata addresses across
# axios/fetch/undici/http, which also blocks flows that call other services on
# this stack's own network. UNRESTRICTED (the default) disables the guard.
# @type=enum(UNRESTRICTED, STRICT)
# @docs("Network security", https://www.activepieces.com/docs/install/architecture/network-security)
AP_NETWORK_MODE=UNRESTRICTED

# Comma-separated IPs or CIDRs that bypass the guard, e.g.
# 10.0.5.12,192.168.10.0/24. Only consulted when AP_NETWORK_MODE=STRICT. The
# server's own outbound HTTP (OAuth token endpoints, Vault, event
# destinations, on-call pager) has been SSRF-filtered since 0.82.0 and uses
# this same list.
AP_SSRF_ALLOW_LIST=

# Worker-group name this container belongs to, so a project can be pinned to
# dedicated workers. Empty means the shared pool. AP_PROJECT_WORKER (default
# true) controls whether this worker accepts project flow jobs at all.
# @docs("Worker groups", https://www.activepieces.com/docs/install/configure-operate/worker-groups)
AP_WORKER_GROUP_ID=

# Whether this worker accepts project flow jobs at all. Set false only for a
# worker dedicated to internal system jobs.
# @type=boolean
AP_PROJECT_WORKER=true

# JWT a WORKER-only container presents to the app. The entrypoint mints one
# from AP_JWT_SECRET at boot when it is unset, which is what this
# single-container deployment relies on; only set it when the worker runs
# apart from the app and cannot see the JWT secret.
# @sensitive
# @docs("Separate workers", https://www.activepieces.com/docs/install/configure-operate/separate-workers)
AP_WORKER_TOKEN=

# ─── Limits & retention ──────────────────────────────────────────────────────
# @docs("Limits", https://www.activepieces.com/docs/install/reference/limits)

# Days of run history, logs and events kept before the cleanup job deletes
# them. AP_PAUSED_FLOW_TIMEOUT_DAYS is the longest a flow may sit paused
# (approval steps, delays) and must not exceed it, or the app refuses to
# start if it does.
# @type=number
AP_EXECUTION_DATA_RETENTION_DAYS=30

# Longest a run may sit paused on an approval step or delay. Must not exceed
# the retention window above, or the app refuses to start.
# @type=number
AP_PAUSED_FLOW_TIMEOUT_DAYS=30

# Days an untouched issue waits before it is archived automatically.
# @type=number
AP_ISSUE_ARCHIVE_DAYS=7

# Largest file (MB) a step or trigger may handle. Larger ones are rejected.
# @type=number
AP_MAX_FILE_SIZE_MB=25

# Combined size (MB) of all step inputs and outputs in one run. Exceeding it
# ends the run with LOG_SIZE_EXCEEDED rather than silently trimming, since
# 0.84.0. Before 0.77.0 this was AP_MAX_FILE_SIZE_MB's job.
# @type=number
AP_MAX_FLOW_RUN_LOG_SIZE_MB=50

# Step outputs above this size (KB) are offloaded to file storage instead of
# being inlined in the run log; step inputs above the second threshold are
# replaced with a "(truncated…)" placeholder in the log only. The step still
# receives the full value at runtime.
# @type=number
AP_FLOW_RUN_LOG_SLICE_THRESHOLD_KB=32

# The input-side threshold: above this, the run log shows a placeholder while
# the step still receives the real value.
# @type=number
AP_FLOW_RUN_LOG_INPUT_TRUNCATE_THRESHOLD_KB=2

# Largest incoming webhook body (MB); anything bigger gets HTTP 413. Bodies
# under the inline threshold (KB) are held in Redis, larger ones spill to file
# storage so a burst cannot exhaust Redis memory.
# @type=number
AP_MAX_WEBHOOK_PAYLOAD_SIZE_MB=25

# Below this, a webhook body is held inline in Redis; above it, the body goes
# to file storage so a burst cannot exhaust Redis memory.
# @type=number
AP_WEBHOOK_PAYLOAD_INLINE_THRESHOLD_KB=512

# How long a synchronous webhook waits for its flow to finish before replying.
# Since 0.90.0 a synchronous webhook whose run fails answers 500 rather than a
# success shape.
# @type=number
AP_WEBHOOK_TIMEOUT_SECONDS=30

# Caps on the built-in Tables feature.
# @type=number
AP_MAX_RECORDS_PER_TABLE=10000
# Columns per table.
# @type=number
AP_MAX_FIELDS_PER_TABLE=100

# Rate limit on unauthenticated auth endpoints: on/off, attempts, and the
# window as a human duration ("1 minute"). The third caps wrong emailed-code
# guesses per account per hour.
# @type=boolean
AP_API_RATE_LIMIT_AUTHN_ENABLED=true
# Attempts allowed inside the window below.
# @type=number
AP_API_RATE_LIMIT_AUTHN_MAX=50

# The window the count above applies to, written as a human duration.
AP_API_RATE_LIMIT_AUTHN_WINDOW=1 minute

# Wrong emailed-code guesses allowed per account per rolling hour. Only
# relevant on Activepieces Cloud, which is the sole edition serving that flow
# since 0.90.0.
# @type=number
AP_API_RATE_LIMIT_EMAIL_CODE_MAX=5

# Skips the per-project resource checks. Meant for the hosted service; leaving
# it unset is correct for a self-hosted instance.
# @type=boolean
AP_SKIP_PROJECT_LIMITS_CHECK=

# ─── File storage ────────────────────────────────────────────────────────────
# @docs("Setup S3", https://www.activepieces.com/docs/install/configure-operate/setup-s3)

# Where step/trigger files and offloaded run logs live. DB (the default) keeps
# them as rows in Postgres, which is simplest and grows the database; S3 moves
# them to a bucket and is what a busy instance wants. Switching to S3 makes
# the app validate the bucket at startup and refuse to boot if it cannot reach
# it.
# @type=enum(DB, S3)
AP_FILE_STORAGE_LOCATION=DB

# Endpoint of the S3-compatible service, e.g. https://s3.amazonaws.com or a
# MinIO address. Unnecessary if AWS_ENDPOINT_URL is already in the
# environment.
AP_S3_ENDPOINT=

# Bucket name, and its region (e.g. us-east-1; unnecessary if AWS_REGION is
# set).
AP_S3_BUCKET=
# Region of that bucket, e.g. us-east-1.
AP_S3_REGION=

# Static credentials for the bucket. Not needed when AP_S3_USE_IRSA is true.
# @sensitive
AP_S3_ACCESS_KEY_ID=
# @sensitive
AP_S3_SECRET_ACCESS_KEY=

# Hand clients pre-signed URLs so file bytes go straight to the bucket instead
# of through the API. Keep the bucket private if you enable this.
# @type=boolean
AP_S3_USE_SIGNED_URLS=false

# Authenticate to S3 with an IAM Role for Service Accounts (EKS) instead of
# access keys; when true the two key variables are not needed.
# @type=boolean
AP_S3_USE_IRSA=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Outbound mail for invitations, alerts and password resets. These are read
# ONLY when the admin screen holds no email configuration, and only when host,
# port, username and password are all four set.

# Relay hostname and port, e.g. mail.example.com and 587.
AP_SMTP_HOST=
# @type=port
AP_SMTP_PORT=

# Credentials for the relay. All four of host/port/username/password must be
# present or the whole block is ignored.
AP_SMTP_USERNAME=
# @sensitive
AP_SMTP_PASSWORD=

# Envelope sender: the address mail comes from, and the display name shown
# beside it.
# @type=email
AP_SMTP_SENDER_EMAIL=
# Display name shown beside that address.
AP_SMTP_SENDER_NAME=
# "false" accepts a self-signed or otherwise unverifiable certificate from the
# SMTP server. Only for an internal relay you control.
# @type=boolean
AP_SMTP_TLS_REJECT_UNAUTHORIZED=

# ─── Authentication & SSO ────────────────────────────────────────────────────

# "Sign in with Google". Since 0.86.0 this is the ONLY way to configure it
# (the admin SSO page no longer offers it), and the button appears only when
# both halves are set. Create the OAuth client in Google Cloud Console with
# <AP_FRONTEND_URL>/redirect as an authorized redirect URI.
# @docs("Google Cloud Console credentials", https://console.cloud.google.com/apis/credentials)
AP_GOOGLE_CLIENT_ID=
# The matching client secret; the button appears only when both are present.
# @sensitive
AP_GOOGLE_CLIENT_SECRET=

# Lets piece connections use Activepieces' own hosted OAuth2 apps, so an
# operator does not have to register a client with every SaaS provider. Set to
# false to force your own OAuth apps for every piece.
# @type=boolean
AP_CLOUD_AUTH_ENABLED=true

# Project role given to members provisioned through SCIM group sync
# (Enterprise).
# @type=enum(Admin, Editor, Viewer)
# @docs("SCIM provisioning", https://www.activepieces.com/docs/admin-guide/guides/scim/overview)
AP_SCIM_DEFAULT_PROJECT_ROLE=Editor

# Cloudflare Turnstile in front of sign-in. Both halves must be set for the
# challenge to be served; without them nothing is verified and no Cloudflare
# account is needed. Since 0.90.0 the emailed-sign-in-code endpoints exist only
# on Activepieces Cloud and only when this pair is set, so on a self-hosted
# instance they are simply not served.
# @docs("Cloudflare Turnstile", https://developers.cloudflare.com/turnstile/get-started/)
AP_TURNSTILE_SITE_KEY=
# The server-side half, used to verify a solved challenge.
# @sensitive
AP_TURNSTILE_SECRET_KEY=

# ZeroBounce key used to check each new sign-up address. Unset, no check runs.
# A validation outage never blocks sign-up: the attempt is allowed and logged.
# @sensitive
# @docs("ZeroBounce email validation API", https://www.zerobounce.net/docs/email-validation-api-quickstart/)
AP_ZEROBOUNCE_API_KEY=

# ─── Pieces & flows ──────────────────────────────────────────────────────────
# @docs("Piece syncing", https://www.activepieces.com/docs/install/architecture/piece-syncing)

# OFFICIAL_AUTO pulls the official piece catalogue from the Activepieces cloud
# on a schedule; NONE freezes the catalogue at whatever the image shipped,
# which is what an air-gapped instance wants.
# @type=enum(OFFICIAL_AUTO, NONE)
AP_PIECES_SYNC_MODE=OFFICIAL_AUTO

# Serve official piece bundles from cdn.activepieces.com instead of
# registry.npmjs.org, falling back to npm when the CDN lacks a version. The
# docs say this defaults to true since 0.87.0; the code's default map at
# 0.90.1 says false, so a fresh install fetches from npm until you turn it on.
# Custom and private-registry pieces never use the CDN.
# @type=boolean
AP_USE_CDN_FOR_BUNDLES=false

# Minutes between polls for pieces whose triggers are scheduled rather than
# webhook-driven.
# @type=number
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5

# Whether publishing a new version of a flow also enables it.
# @type=boolean
AP_ENABLE_FLOW_ON_PUBLISH=true

# Reject a step at runtime when its connection was created for a different
# piece. Off by default for backward compatibility.
# @type=boolean
AP_ENFORCE_CONNECTION_PIECE_BINDING=false

# Comma-separated piece names loaded from the local filesystem instead of the
# registry, for developing a piece against a running instance. Only meaningful
# with AP_ENVIRONMENT=dev; the second flag also loads their translations.
AP_DEV_PIECES=
# Off by default in development mode since 0.75.0.
# @type=boolean
AP_LOAD_TRANSLATIONS_FOR_DEV_PIECES=false

# JSON map of app-webhook secrets, keyed by piece name, used to verify
# incoming webhooks from providers that sign them (Slack, Square…).
# @sensitive
# @docs("Setup app webhooks", https://www.activepieces.com/docs/install/configure-operate/setup-app-webhooks)
AP_APP_WEBHOOK_SECRETS={}

# ─── AI & agents ─────────────────────────────────────────────────────────────

# Exposes the Agents feature in the UI. Defaults to off at this version.
# @type=boolean
AP_AGENTS_ENABLED=false

# Registers the ap_search_actions / ap_search_triggers MCP tools, which find a
# piece action by meaning rather than by name. Read live, so toggling it needs
# no restart.
# @type=boolean
# @docs("Tool search", https://www.activepieces.com/docs/mcp/tool-search)
AP_TOOL_SEARCH_ENABLED=false

# OpenAI key that pays for tool-search embeddings (catalogue backfill, reindex
# on new pieces, and each query). Unset, the platform's configured OpenAI
# provider is used; with neither, tool search degrades to keyword matching.
# @sensitive
# @docs("Setup AI providers", https://www.activepieces.com/docs/admin-guide/guides/setup-ai-providers)
AP_OPENAI_API_KEY=

# Where the model catalogue (context window, pricing, capabilities shown beside
# each model) is fetched from, once every 24 hours. An instance with no egress
# to the default CDN just shows models without that metadata; point this at a
# mirror of the same JSON to restore it.
# @type=url
AP_MODEL_CATALOG_URL=https://cdn.activepieces.com/ai/model-catalog.json

# ─── Logging & observability ─────────────────────────────────────────────────
# Logging is evlog since 0.85.4: one wide event per request/job instead of many
# lines, and OpenTelemetry TRACES and METRICS are no longer exported at all.

# Lowest severity written. `debug` and `trace` are very loud with wide events.
# @type=enum(error, warn, info, debug, trace)
AP_LOG_LEVEL=info
# Human-readable coloured output instead of JSON. For a terminal, not a drain.
# @type=boolean
AP_LOG_PRETTY=false
# Also write logs to a file inside the container, and serve the browser's own
# client logs endpoint. Inert on the cloud edition.
# @type=boolean
AP_LOG_FILE=false

# Percentage of info-level events kept (0-100); errors and warnings are always
# kept. Any request slower than the second value is kept regardless of
# sampling. Both arrived with the evlog switch in 0.85.4.
# @type=number
AP_LOG_SAMPLE_RATE_INFO=100
# Any request slower than this (ms) is kept whatever the sample rate says.
# @type=number
AP_LOG_KEEP_SLOW_MS=2000

# Ship logs over OTLP. Since 0.85.4 this sends LOGS ONLY; the tracing and
# metrics exporters were removed. The endpoint and headers come from the
# standard OTEL_EXPORTER_* variables below, not from an AP_ one.
# @type=boolean
# @docs("Setup OpenTelemetry", https://www.activepieces.com/docs/install/configure-operate/setup-opentelemetry)
AP_OTEL_ENABLED=false

# Separately exports BullMQ queue depth/latency metrics over OTLP. This is the
# one metrics exporter that survived; it reads the OTEL_EXPORTER_* variables
# directly.
# @type=boolean
AP_OTEL_QUEUE_METRICS_ENABLED=false

# Standard OpenTelemetry collector settings, read by the OTLP drain and the
# queue-metrics exporter rather than by any AP_ variable. Headers are
# comma-separated key=value pairs, typically an auth token.
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value pairs sent with every export, typically an auth
# token.
# @sensitive
OTEL_EXPORTER_OTLP_HEADERS=

# Hosted log drains. Each is used only when its token is present; they can run
# alongside the OTLP drain.
# Axiom: API token and the dataset events land in.
# @sensitive
AP_AXIOM_TOKEN=
# Dataset the events land in.
AP_AXIOM_DATASET=
# HyperDX: ingestion key.
# @sensitive
AP_HYPERDX_TOKEN=

# Grafana Loki: push URL plus basic-auth credentials, if the endpoint needs
# them.
# @type=url
AP_LOKI_URL=
# Basic-auth credentials, if that endpoint asks for them.
AP_LOKI_USERNAME=
# @sensitive
AP_LOKI_PASSWORD=

# Better Stack: source token and the ingesting host for that source.
# @sensitive
AP_BETTERSTACK_TOKEN=
# Ingesting host for that source.
AP_BETTERSTACK_HOST=

# Sentry DSNs for server-side and browser-side error reporting. Separate
# projects; the frontend one is served to the browser and is public by nature.
# @type=url
# @sensitive
AP_SENTRY_DSN=

# The browser-side DSN, served to every page load, so treat it as public.
# @type=url
AP_FRONTEND_SENTRY_DSN=

# Webhook the server posts to when it wants a human: an outbound URL, called
# for conditions the platform treats as page-worthy.
# @type=url
AP_PAGE_ONCALL_WEBHOOK=
