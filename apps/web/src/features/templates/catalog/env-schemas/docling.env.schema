# Docling Serve v1.32.0 environment schema (@env-spec / varlock format).
#
# Source: docling_serve/settings.py at v1.32.0. Almost nothing here is a
# literal `os.getenv`: a grep of the source finds exactly four raw reads
# (DOCLING_SERVE_CONFIG_FILE, DOCLING_SERVE_ARTIFACTS_PATH,
# DOCLING_SERVE_ENABLE_UI, DOCLING_SERVE_ENG_RAY_REDIS_URL). Every other key
# is derived by pydantic-settings from a field name on one of the two
# BaseSettings classes: `UvicornSettings` (env_prefix `UVICORN_`) and
# `DoclingServeSettings` (env_prefix `DOCLING_SERVE_`). Field `api_key`
# becomes `DOCLING_SERVE_API_KEY`, `eng_rq_redis_url` becomes
# `DOCLING_SERVE_ENG_RQ_REDIS_URL`, and so on for ~200 fields. Both classes
# are `extra="allow"`, so an unknown DOCLING_SERVE_* / UVICORN_* variable is
# accepted silently rather than rejected, so a typo is a no-op, not an error.
#
# Cross-checked against docs/configuration.md at the same tag. Where they
# disagree, the code wins:
#   - The docs' "Configuration File Support" section links to
#     `examples/config.yaml` and `examples/config.json`. Neither file exists
#     at v1.32.0 (examples/ only holds the OTEL sample stack). The feature
#     itself is real: DOCLING_SERVE_CONFIG_FILE is read, and env vars beat
#     config-file values.
#   - The docs omit a number of settings the code reads, all declared below:
#     API_HOST, MAX_SOURCES_PER_REQUEST, ALLOWED_IMAGE_EXPORT_MODES,
#     MAX_IMAGES_SCALE, the OCR/chunking preset controls, four more
#     ALLOW_CUSTOM_*_CONFIG flags, DEFAULT_PICTURE_CLASSIFICATION_PRESET, and
#     the RQ failure-TTL / connection-gate / zombie-reaper knobs.
#   - The Ray engine (DOCLING_SERVE_ENG_KIND=ray) has ~60 further
#     DOCLING_SERVE_ENG_RAY_* settings with zero documentation. Only the
#     three that select and locate a cluster are declared here; the rest are
#     autoscaler/actor tuning that means nothing without an external Ray
#     cluster, which this single-container template does not run.
#
# The image bakes DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models
# with the layout, tableformer, picture-classifier, rapidocr and easyocr
# weights already downloaded there, plus TESSDATA_PREFIX, OMP_NUM_THREADS=4
# and LD_PRELOAD (mimalloc). Repointing ARTIFACTS_PATH at an empty directory
# makes the container fetch models from HuggingFace at boot instead.
#
# The compose sets two variables and exposes container port 5001, which is
# already the server's default port. An out-of-the-box instance needs
# nothing else filled in beyond the API key.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Docling Serve configuration reference", https://github.com/docling-project/docling-serve/blob/v1.32.0/docs/configuration.md)
# ---

# ─── Authentication ───────────────────────────────────────────────────────

# The API key every request must carry in an `X-Api-Key` header. Generated at
# install; wired into DOCLING_SERVE_API_KEY below. Docling Serve ships with
# NO authentication: auth.py short-circuits to "valid" whenever the
# configured key is the empty string, so an instance without this is an open
# document-conversion endpoint (and, with the UI enabled, an open web app)
# for anyone who can reach it.
# @required @sensitive @type=string(minLength=32)
DOCLING_API_KEY=

# What the server compares the `X-Api-Key` header against. Empty disables the
# check entirely for every route including the UI and /v1/convert.
# @required @sensitive
DOCLING_SERVE_API_KEY=${DOCLING_API_KEY}

# ─── Core ─────────────────────────────────────────────────────────────────

# Serves the Gradio demonstrator UI at the server root. Turned on by this
# template; with it off, only the JSON API answers. The UI is a demo surface,
# not an admin console, and it sits behind the same API key.
# @required @type=boolean
DOCLING_SERVE_ENABLE_UI=true

# Host the Gradio UI calls back to when it talks to the API from inside the
# container ("http://<api_host>:<uvicorn port>"). The default is correct for
# a single container; only change it if the UI and the API are split across
# pods. Undocumented.
DOCLING_SERVE_API_HOST=localhost

# Verbosity of the app's own logs. Unset behaves as WARNING. Accepted
# case-insensitively; the CLI's -v / -vv win over this.
# @type=enum(WARNING, INFO, DEBUG)
DOCLING_SERVE_LOG_LEVEL=

# "json" emits one structured JSON object per log line (recommended when
# shipping logs anywhere); "text" is the colored console format.
# @type=enum(text, json)
DOCLING_SERVE_LOG_FORMAT=text

# Request headers with this prefix are stripped of the prefix and attached to
# every log line emitted during that request, e.g. `X-Docling-Log-RequestID`
# becomes a `RequestID` field. Matched case-insensitively.
DOCLING_SERVE_LOG_HEADER_PREFIX=X-Docling-Log-

# Directory the model weights are loaded from. The image pre-downloads them
# to /opt/app-root/src/.cache/docling/models and sets this there at build
# time; leaving it empty here keeps that baked value. Pointing it somewhere
# empty means a first-boot download from HuggingFace.
# @docs("Model prefetching", https://github.com/docling-project/docling-serve/blob/v1.32.0/docs/models.md)
DOCLING_SERVE_ARTIFACTS_PATH=

# Directory the docs and UI static assets are loaded from. Unset uses the
# assets bundled in the image.
DOCLING_SERVE_STATIC_PATH=

# Scratch workspace where conversion results wait until they are fetched.
# Unset creates a temporary directory per boot, which lives on the
# container's writable layer and is lost on restart.
DOCLING_SERVE_SCRATCH_PATH=

# Path to a YAML or JSON file supplying any of these settings by their
# unprefixed field name. Environment variables win over it. Note the docs
# link to example config files that do not exist at this version.
DOCLING_SERVE_CONFIG_FILE=

# Loads the default pipeline's models during startup rather than on the first
# request. Keeps the first conversion fast at the cost of a slower, more
# memory-hungry boot.
# @type=boolean
DOCLING_SERVE_LOAD_MODELS_AT_BOOT=true

# How many DocumentConverter objects (each holding its own copy of the
# loaded models) stay cached for distinct option sets. Raising this
# multiplies resident memory.
# @type=number
DOCLING_SERVE_OPTIONS_CACHE_SIZE=2

# Results can be fetched exactly once, then deleted. Set false to let them
# accumulate in the scratch directory instead (and grow it unbounded).
# @type=boolean
DOCLING_SERVE_SINGLE_USE_RESULTS=true

# Seconds between a result being fetched and it being dropped from the task
# registry, when SINGLE_USE_RESULTS is on.
# @type=number
DOCLING_SERVE_RESULT_REMOVAL_DELAY=300

# Exposes the /v1/memory endpoints; they return 403 while this is off.
# @type=boolean
DOCLING_SERVE_ENABLE_MANAGEMENT_ENDPOINTS=false

# Lets /version report the versions of every bundled Docling package. Off
# returns 403; turn it off if you would rather not advertise them.
# @type=boolean
DOCLING_SERVE_SHOW_VERSION_INFO=true

# Returns raw internal exception detail in API responses. Debugging only:
# with it off, infrastructure-origin errors are sanitized before they reach a
# client.
# @type=boolean
DOCLING_SERVE_DEBUG_ERROR_DETAILS=false

# ─── Web server (uvicorn) ─────────────────────────────────────────────────
# Read by UvicornSettings, which is a separate settings class with its own
# UVICORN_ prefix and also `extra="allow"`.
# @docs("Webserver configuration", https://github.com/docling-project/docling-serve/blob/v1.32.0/docs/configuration.md)

# Address the server binds to. The default (from the `run` command) is
# 0.0.0.0, which is what the container network needs; narrowing it makes the
# published port unreachable.
UVICORN_HOST=0.0.0.0

# Port the server listens on. The compose exposes container port 5001 with no
# override, so this is that port's twin: change one without the other and
# routing breaks.
# @type=port
UVICORN_PORT=5001

# Path prefix to tell the app it is mounted under, when a proxy serves it
# somewhere other than the domain root.
UVICORN_ROOT_PATH=

# Trusts X-Forwarded-Proto / -For / -Port for client address and scheme.
# Correct behind the platform's proxy; only meaningful because nothing
# reaches the container except through it.
# @type=boolean
UVICORN_PROXY_HEADERS=true

# Seconds an idle keep-alive connection is held open. Long conversions are
# unaffected, since this bounds the connection, not the job.
# @type=number
UVICORN_TIMEOUT_KEEP_ALIVE=60

# Number of worker processes. Every worker loads its own copy of the models,
# so this multiplies memory; prefer the engine's worker settings below.
# Leaving it unset means one process.
# @type=number
UVICORN_WORKERS=

# Terminates TLS in the container itself, in front of any external proxy.
# Both files must exist inside the container (mount them); setting the
# keyfile alone also flips the UI's self-reference to https.
UVICORN_SSL_CERTFILE=
UVICORN_SSL_KEYFILE=
# @sensitive
UVICORN_SSL_KEYFILE_PASSWORD=

# Restarts the server when files change. Development only, and it spawns
# subprocesses that ignore CLI options.
# @type=boolean
UVICORN_RELOAD=false

# ─── Request limits and policy ────────────────────────────────────────────
# The guardrails on what one caller can ask a shared instance to do. Every
# one of them is off or effectively unbounded out of the box.

# Seconds a single document may take before it is abandoned. The default is
# seven days, i.e. no practical limit.
# @type=number
DOCLING_SERVE_MAX_DOCUMENT_TIMEOUT=604800

# Page cap per document. Unset means sys.maxsize (unlimited).
# @type=number
DOCLING_SERVE_MAX_NUM_PAGES=

# Upload size cap in bytes. Unset means sys.maxsize (unlimited).
# @type=number
DOCLING_SERVE_MAX_FILE_SIZE=

# How many sources one request may carry. Undocumented; the code defaults
# it to 3.
# @type=number
DOCLING_SERVE_MAX_SOURCES_PER_REQUEST=3

# Seconds between polls of the task status inside the synchronous endpoints.
# @type=number
DOCLING_SERVE_SYNC_POLL_INTERVAL=2

# Seconds a synchronous endpoint waits for completion before giving up and
# telling the caller to use the async API.
# @type=number
DOCLING_SERVE_MAX_SYNC_WAIT=120

# Restricts which batch source kinds are accepted (JSON array or
# comma-separated). Unset allows the built-in API sources; `local_path` is
# never reachable remotely regardless. Plugin-provided sources must be listed
# explicitly.
DOCLING_SERVE_ALLOWED_SOURCE_TYPES=

# Same, for target kinds. This is what gates the presigned-URL targets
# configured under Artifact storage below.
DOCLING_SERVE_ALLOWED_TARGET_TYPES=

# Which image export modes a request may ask for. Undocumented; unset allows
# all of them.
DOCLING_SERVE_ALLOWED_IMAGE_EXPORT_MODES=

# Upper bound on the scale factor for exported page images, the knob that
# stops one request rendering enormous bitmaps. Undocumented.
# @type=number
DOCLING_SERVE_MAX_IMAGES_SCALE=2.0

# Allows pipeline components to make outbound connections, which is what
# using a hosted vision-language model or OCR API requires. Off by default:
# with it off, no document content leaves the container.
# @type=boolean
DOCLING_SERVE_ENABLE_REMOTE_SERVICES=false

# Allows third-party Docling plugins that are installed in the image to
# register themselves. Off by default; the connector package must be present
# in every API and worker process.
# @type=boolean
DOCLING_SERVE_ALLOW_EXTERNAL_PLUGINS=false

# ─── Converter presets ────────────────────────────────────────────────────
# Which model presets a caller may pick, and whether a caller may hand the
# server a fully custom model configuration instead of naming a preset. Every
# ALLOW_CUSTOM_* flag is a trust decision: on, a caller can point a pipeline
# stage at arbitrary model settings. Only the first three are documented; the
# rest exist in settings.py all the same.
# @docs("DoclingConverterManager configuration", https://github.com/docling-project/docling-serve/blob/v1.32.0/docs/configuration.md)

# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_VLM_CONFIG=false
# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_PICTURE_DESCRIPTION_CONFIG=false
# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_CODE_FORMULA_CONFIG=false
# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_TABLE_STRUCTURE_CONFIG=false
# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_LAYOUT_CONFIG=false
# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_PICTURE_CLASSIFICATION_CONFIG=false
# @type=boolean
DOCLING_SERVE_ALLOW_CUSTOM_OCR_CONFIG=false

# Vision-language pipeline. The default preset is what a request asking for
# "default" gets; ALLOWED_* is a JSON array or comma-separated allowlist
# (unset = all); CUSTOM_* is a JSON object mapping new preset IDs to their
# options and is silently ignored if it is not valid JSON.
DOCLING_SERVE_DEFAULT_VLM_PRESET=granite_docling
DOCLING_SERVE_ALLOWED_VLM_PRESETS=
DOCLING_SERVE_ALLOWED_VLM_ENGINES=
DOCLING_SERVE_CUSTOM_VLM_PRESETS=

# Picture description (image captioning).
DOCLING_SERVE_DEFAULT_PICTURE_DESCRIPTION_PRESET=smolvlm
DOCLING_SERVE_ALLOWED_PICTURE_DESCRIPTION_PRESETS=
DOCLING_SERVE_ALLOWED_PICTURE_DESCRIPTION_ENGINES=
DOCLING_SERVE_CUSTOM_PICTURE_DESCRIPTION_PRESETS=

# Code and formula understanding.
DOCLING_SERVE_DEFAULT_CODE_FORMULA_PRESET=default
DOCLING_SERVE_ALLOWED_CODE_FORMULA_PRESETS=
DOCLING_SERVE_ALLOWED_CODE_FORMULA_ENGINES=
DOCLING_SERVE_CUSTOM_CODE_FORMULA_PRESETS=

# Picture classification. The default preset is undocumented.
DOCLING_SERVE_DEFAULT_PICTURE_CLASSIFICATION_PRESET=document_figure_classifier_v2
DOCLING_SERVE_ALLOWED_PICTURE_CLASSIFICATION_PRESETS=
DOCLING_SERVE_CUSTOM_PICTURE_CLASSIFICATION_PRESETS=

# Table structure recovery. The default kind is always implicitly allowed
# even when ALLOWED_TABLE_STRUCTURE_KINDS is set: the allowlist exists to
# block plugin-provided kinds, not to lock out the built-in one.
DOCLING_SERVE_DEFAULT_TABLE_STRUCTURE_KIND=docling_tableformer
DOCLING_SERVE_ALLOWED_TABLE_STRUCTURE_KINDS=
DOCLING_SERVE_DEFAULT_TABLE_STRUCTURE_PRESET=tableformer_v1_accurate
DOCLING_SERVE_ALLOWED_TABLE_STRUCTURE_PRESETS=
DOCLING_SERVE_CUSTOM_TABLE_STRUCTURE_PRESETS=

# Layout analysis. Same "default kind is always allowed" rule.
DOCLING_SERVE_DEFAULT_LAYOUT_KIND=docling_layout_default
DOCLING_SERVE_ALLOWED_LAYOUT_KINDS=
DOCLING_SERVE_DEFAULT_LAYOUT_PRESET=docling_layout_default
DOCLING_SERVE_ALLOWED_LAYOUT_PRESETS=
DOCLING_SERVE_CUSTOM_LAYOUT_PRESETS=

# OCR. Undocumented; "auto" picks an engine from what is installed in the
# image (rapidocr and easyocr weights are pre-fetched at build).
DOCLING_SERVE_DEFAULT_OCR_KIND=auto
DOCLING_SERVE_DEFAULT_OCR_PRESET=auto
DOCLING_SERVE_ALLOWED_OCR_KINDS=
DOCLING_SERVE_ALLOWED_OCR_PRESETS=
DOCLING_SERVE_CUSTOM_OCR_PRESETS=

# Chunking, for the /v1/chunk endpoints. Undocumented.
DOCLING_SERVE_DEFAULT_CHUNKING_PRESET=granite_embedding_278m
DOCLING_SERVE_ALLOWED_CHUNKING_PRESETS=
DOCLING_SERVE_CUSTOM_CHUNKING_PRESETS=

# ─── Artifact storage (presigned-URL targets) ─────────────────────────────
# Only needed when callers use a PresignedUrlTarget: the server writes the
# converted output to object storage and hands back a time-limited URL
# instead of the bytes. Off by default, and nothing else in this section is
# read while it is off.

# @type=boolean
DOCLING_SERVE_ARTIFACT_STORAGE_ENABLED=false

# @type=enum(s3, azure)
DOCLING_SERVE_ARTIFACT_STORAGE_BACKEND=s3

# S3 endpoint WITHOUT a protocol scheme (host[:port]); an https:// prefix
# here is a common misconfiguration.
DOCLING_SERVE_ARTIFACT_STORAGE_ENDPOINT=
DOCLING_SERVE_ARTIFACT_STORAGE_BUCKET=
# @sensitive
DOCLING_SERVE_ARTIFACT_STORAGE_ACCESS_KEY=
# @sensitive
DOCLING_SERVE_ARTIFACT_STORAGE_SECRET_KEY=
# Object-key prefix every stored artifact goes under.
DOCLING_SERVE_ARTIFACT_STORAGE_KEY_PREFIX=converted/
# Set false only for plain-HTTP or self-signed MinIO endpoints.
# @type=boolean
DOCLING_SERVE_ARTIFACT_STORAGE_VERIFY_SSL=true

# Azure Blob backend. The connection string must carry both AccountName and
# AccountKey: managed identity, SAS-only strings and
# UseDevelopmentStorage=true are all rejected, because the server needs the
# account key to sign SAS URLs itself. ACCOUNT_NAME must match the
# AccountName inside the connection string.
# @sensitive
DOCLING_SERVE_ARTIFACT_STORAGE_AZURE_CONNECTION_STRING=
DOCLING_SERVE_ARTIFACT_STORAGE_AZURE_CONTAINER=
DOCLING_SERVE_ARTIFACT_STORAGE_AZURE_ACCOUNT_NAME=
DOCLING_SERVE_ARTIFACT_STORAGE_AZURE_BLOB_PREFIX=converted/

# Lifetime of the returned presigned S3 URL or Azure SAS URL. Accepted range
# is 60 to 604800 seconds.
# @type=number
DOCLING_SERVE_ARTIFACT_STORAGE_PRESIGN_TTL_SECONDS=3600

# ─── Pipeline batching ────────────────────────────────────────────────────
# Throughput/memory trade-offs for the threaded conversion pipeline. All
# unset by default, which means each stage uses the pipeline's own defaults.

# Pages that may be open in the queue at once, the main lever on peak
# memory per document.
# @type=number
DOCLING_SERVE_QUEUE_MAX_SIZE=
# @type=number
DOCLING_SERVE_OCR_BATCH_SIZE=
# @type=number
DOCLING_SERVE_LAYOUT_BATCH_SIZE=
# @type=number
DOCLING_SERVE_TABLE_BATCH_SIZE=
# Seconds a stage waits to gather pages before it starts processing.
# @type=number
DOCLING_SERVE_BATCH_POLLING_INTERVAL_SECONDS=

# ─── CORS ─────────────────────────────────────────────────────────────────
# Accepted as a JSON array or a comma-separated string. The defaults are
# fully open, which is only tolerable because the API key gates every route;
# narrow them if the UI is embedded anywhere.

DOCLING_SERVE_CORS_ORIGINS=*
DOCLING_SERVE_CORS_METHODS=*
DOCLING_SERVE_CORS_HEADERS=*

# ─── Compute engine ───────────────────────────────────────────────────────
# Which backend runs async conversion jobs. This template runs a single
# container, so "local" is the only kind that works without further
# infrastructure: "rq" needs a Redis and separate worker containers, "ray"
# needs a Ray cluster. Choosing either without its URL raises at startup and
# the container never becomes healthy.

# @type=enum(local, rq, ray)
DOCLING_SERVE_ENG_KIND=local

# Local engine: worker threads inside this process. Raising it raises
# concurrency and memory together.
# @type=number
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2

# One shared copy of the models across all local worker threads instead of a
# private copy per thread. Much lower memory; the threads then contend for
# the same model.
# @type=boolean
DOCLING_SERVE_ENG_LOC_SHARE_MODELS=false

# RQ engine: Redis connection URL, e.g. redis://host:6379/. Required when
# ENG_KIND=rq; startup fails without it.
# @sensitive @docs("RQ engine configuration", https://github.com/docling-project/docling-serve/blob/v1.32.0/docs/configuration.md)
DOCLING_SERVE_ENG_RQ_REDIS_URL=

# Queue name shared by the API instances and the workers; both sides must
# agree or jobs are enqueued where nothing is listening.
DOCLING_SERVE_ENG_RQ_QUEUE_NAME=convert

# Redis key prefixes for stored results and for the worker/orchestrator
# update channel.
DOCLING_SERVE_ENG_RQ_RESULTS_PREFIX=docling:results
DOCLING_SERVE_ENG_RQ_SUB_CHANNEL=docling:updates

# Seconds a finished result, and a failed job, are kept in Redis.
# @type=number
DOCLING_SERVE_ENG_RQ_RESULTS_TTL=14400
# Undocumented.
# @type=number
DOCLING_SERVE_ENG_RQ_FAILURE_TTL=14400

# Maximum runtime of one RQ job. Baked into each job at enqueue time, so it
# must be set on the API instances, not the workers, and queued jobs keep the
# value they were enqueued with. -1 disables the limit; 0 is a trap, since
# RQ reads it as unset and falls back to its own 180 s default.
# @type=number
DOCLING_SERVE_ENG_RQ_JOB_TIMEOUT=14400

# Redis connection pool size. Upstream suggests ~100 for 10+ workers and
# 150-200 beyond that; the Redis server's own maxclients has to cover the sum
# across every API instance and worker.
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_MAX_CONNECTIONS=50

# Socket timeouts for Redis operations and for establishing connections.
# Unset uses the Redis client defaults; 5.0 is the usual value when a slow
# network is causing hangs.
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_SOCKET_TIMEOUT=
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_SOCKET_CONNECT_TIMEOUT=

# Connection-gate and zombie-reaper knobs, all undocumented: how many
# connections the gate may hand out, how many it holds back, how long a
# caller waits for one, and how often orphaned jobs are swept and at what
# age. Defaults are sensible; they exist for large RQ fleets.
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_GATE_CONCURRENCY=
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_GATE_RESERVED_CONNECTIONS=10
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_GATE_WAIT_TIMEOUT=0.25
# @type=number
DOCLING_SERVE_ENG_RQ_REDIS_GATE_STATUS_POLL_WAIT_TIMEOUT=5.0
# @type=number
DOCLING_SERVE_ENG_RQ_ZOMBIE_REAPER_INTERVAL=300.0
# @type=number
DOCLING_SERVE_ENG_RQ_ZOMBIE_REAPER_MAX_AGE=3600.0

# Ray engine: the three settings that select and locate a cluster. Both the
# Redis URL and the address are required when ENG_KIND=ray. The address takes
# "auto", "local", or a cluster address. The remaining ~60
# DOCLING_SERVE_ENG_RAY_* autoscaling, actor-sizing, retry and mTLS settings
# are undocumented upstream and are not declared here.
# @sensitive
DOCLING_SERVE_ENG_RAY_REDIS_URL=
DOCLING_SERVE_ENG_RAY_ADDRESS=
DOCLING_SERVE_ENG_RAY_NAMESPACE=docling

# ─── Telemetry ────────────────────────────────────────────────────────────
# @docs("OpenTelemetry deployment examples", https://github.com/docling-project/docling-serve/blob/v1.32.0/examples/OTEL.md)

# In-process metric collection, and the Prometheus /metrics endpoint that
# exposes it. Both on by default.
# @type=boolean
DOCLING_SERVE_OTEL_ENABLE_METRICS=true
# @type=boolean
DOCLING_SERVE_OTEL_ENABLE_PROMETHEUS=true

# Serves /metrics on its own port instead of the API port. Unset keeps it on
# the API port, where the API key does not protect it. Set this and leave
# the port unpublished if the metrics should not be world-readable.
# @type=port
DOCLING_SERVE_METRICS_PORT=

# Trace collection, and OTLP metric export. Both require a working
# OTEL_EXPORTER_OTLP_ENDPOINT; turning traces on without one produces export
# errors on every request.
# @type=boolean
DOCLING_SERVE_OTEL_ENABLE_TRACES=false
# @type=boolean
DOCLING_SERVE_OTEL_ENABLE_OTLP_METRICS=false

# Name this instance reports itself as to the collector.
DOCLING_SERVE_OTEL_SERVICE_NAME=docling-serve

# Standard OTLP collector endpoint, read by the OpenTelemetry SDK rather than
# by Docling Serve itself, e.g. http://collector:4318.
# @type=url
# @docs("OTLP exporter configuration", https://opentelemetry.io/docs/languages/sdk-configuration/otlp-exporter/)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Docling library knobs ────────────────────────────────────────────────
# Read by the underlying `docling` package (its own DOCLING_ prefix), not by
# Docling Serve, but they are the levers that decide how fast a conversion is
# on a CPU-only container.

# Threads torch uses for CPU execution. The image also sets OMP_NUM_THREADS=4
# at build; both matter, and setting this far above the container's CPU quota
# makes conversions slower, not faster.
# @type=number
DOCLING_NUM_THREADS=4

# Execution device. Unset auto-selects the best available, which on the
# -cpu image this template runs is always cpu. cuda / cuda:0 / mps only mean
# something on the GPU image variants.
DOCLING_DEVICE=

# Pages per pipeline batch, and document items per enrichment batch.
# @type=number
DOCLING_PERF_PAGE_BATCH_SIZE=4
# @type=number
DOCLING_PERF_ELEMENTS_BATCH_SIZE=8

# Emits detailed per-stage timing information. Diagnostics only.
# @type=boolean
DOCLING_DEBUG_PROFILE_PIPELINE_TIMINGS=false

# ─── Misc ─────────────────────────────────────────────────────────────────

# Read by Gradio itself, not by Docling Serve. The UI keeps generated
# download files in a cache that is swept hourly for anything older than ten
# hours; pointing this at the same absolute path as
# DOCLING_SERVE_SCRATCH_PATH is upstream's workaround for keeping them
# longer.
# @docs("Gradio file access and cache", https://www.gradio.app/guides/file-access)
GRADIO_TEMP_DIR=
