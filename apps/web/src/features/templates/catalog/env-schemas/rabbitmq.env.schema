# RabbitMQ 4.3.5 environment schema (@env-spec / varlock format).
#
# The compose pins rabbitmq:4.3.5-management, the Debian/Ubuntu-based
# `-management` variant (NOT `-alpine`), which is the plain image plus the
# rabbitmq_management plugin enabled offline and the rabbitmqadmin CLI. The
# Erlang/OTP runtime is baked into the image: OTP 27.3.4.17 with OpenSSL
# 3.5.8 (4.3/ubuntu/Dockerfile). 4.3.5-management resolves to OCI index
# sha256:ffd1b50c522ad20172ffd6716a2f41db375c7269560c8f3fb9a694e210ef0852
# (verified 2026-09-04 against registry-1.docker.io).
#
# Series support: 4.3 is the only series still under community support
# (ends 30 Nov 2026). The previous pin, `3.13-management`, was a floating
# minor that resolved to 3.13.7, a release from Aug 2024 whose series left
# community support on 30 Sept 2024; the image was rebuilt as recently as
# 2025-12-02 but only for base-image refreshes, no broker fixes.
#
# Source: deps/rabbit_common/src/rabbit_env.erl at tag v4.3.5 (the single
# module that reads every RABBITMQ_* variable the broker honours) plus
# deps/rabbit/scripts/rabbitmq-env and rabbitmq-server (the runtime/VM flag
# variables), and the official image's docker-entrypoint.sh,
# 4.3/ubuntu/Dockerfile and conf.d/10-defaults.conf. Cross-checked against
# the Docker Hub image docs (docker-library/docs/rabbitmq/content.md).
#
# There is NO generic "any rabbitmq.conf key as an environment variable"
# mapping. RabbitMQ is configured through rabbitmq.conf / advanced.config;
# the environment only covers node identity, file and directory locations,
# first-boot seeding, and Erlang VM flags: exactly the fixed list below
# (rabbit_env.erl's own `?USED_ENV_VARS`). Everything else must go into a
# config file mounted at /etc/rabbitmq/conf.d/.
#
# Prefix fallback: every RABBITMQ_-prefixed name below is also read WITHOUT
# the prefix if the prefixed one is unset (rabbit_env.erl
# get_prefixed_env_var/2, where "RABBITMQ_" ++ Suffix falls back to Suffix).
# So a stray `NODENAME`, `LOG` or `DEFAULT_USER` in the container environment
# silently configures the broker. The bare names are not declared here
# because they are too generic to suggest.
#
# FIRST BOOT ONLY (an empty data directory): RABBITMQ_DEFAULT_USER,
# RABBITMQ_DEFAULT_PASS, RABBITMQ_DEFAULT_VHOST and RABBITMQ_FEATURE_FLAGS.
# rabbit.erl's insert_default_data/0 runs only when rabbit_db:needs_default_data()
# is true and no definitions are configured for import; after that, changing
# the user or password variables does nothing. Rotate with
# `rabbitmqctl change_password`. Every other variable here is re-read on
# every boot.
#
# SECURITY: the built-in `guest` account. Upstream defaults at v4.3.5
# (deps/rabbit/Makefile) are default_user=guest, default_pass=guest,
# default_user_tags=[administrator], default_permissions=[".*",".*",".*"],
# loopback_users=[guest], i.e. guest is a full administrator that upstream
# confines to localhost. THIS IMAGE DISABLES THAT CONFINEMENT: the official
# image ships /etc/rabbitmq/conf.d/10-defaults.conf containing
# `loopback_users.guest = false`, so if guest is ever seeded it can log in
# from anywhere the ports are reachable, including the management UI. The
# compose avoids that by seeding a different user from RABBITMQ_USER /
# RABBITMQ_PASSWORD, which means `guest` is never created, but only if
# those two are actually supplied at first boot. Leave them empty and the
# node seeds guest/guest, network-reachable, with administrator rights.
#
# SECURITY: the management UI. The compose publishes 15672 as well as 5672,
# so the plugin's HTTP API and UI are exposed on the generated domain with
# no TLS of its own and no rate limiting; the seeded user is an
# administrator, so that login is full control of the broker (users, vhosts,
# policies, message publish/get). Put it behind the platform's proxy/auth or
# treat RABBITMQ_PASSWORD as an internet-facing admin credential.
#
# Baked into the image, do not set: RABBITMQ_HOME=/opt/rabbitmq,
# RABBITMQ_DATA_DIR=/var/lib/rabbitmq, HOME=/var/lib/rabbitmq,
# RUNNING_UNDER_SYSTEMD=true, LANG/LANGUAGE/LC_ALL=C.UTF-8.
#
# HARD-FAIL variables (docker-entrypoint.sh exits 1 if ANY is set, non-empty,
# since RabbitMQ 3.9): RABBITMQ_DEFAULT_USER_FILE, RABBITMQ_DEFAULT_PASS_FILE,
# RABBITMQ_SSL_CACERTFILE, RABBITMQ_SSL_CERTFILE, RABBITMQ_SSL_DEPTH,
# RABBITMQ_SSL_FAIL_IF_NO_PEER_CERT, RABBITMQ_SSL_KEYFILE,
# RABBITMQ_SSL_VERIFY, the five RABBITMQ_MANAGEMENT_SSL_* twins, and
# RABBITMQ_VM_MEMORY_HIGH_WATERMARK. They are deliberately NOT declared
# below: setting one does not misconfigure the node, it stops it booting.
# TLS and the memory watermark are config-file settings now.
#
# Also not declared: RABBITMQ_DEFAULT_ALLOC_ARGS. rabbitmq-server assigns it
# unconditionally at the top of the script at this version, so an
# environment value is overwritten and has no effect.

# @defaultSensitive=false @defaultRequired=infer
# @docs("RabbitMQ configuration reference", https://www.rabbitmq.com/docs/configure)
# ---

# ─── Platform prompt keys ──────────────────────────────────────────────────

# Platform prompt key for the broker's administrator username; threaded
# unchanged into RABBITMQ_DEFAULT_USER below. Seeded once, on first boot into
# an empty data directory. Supplying it is what stops the well-known
# guest/guest account from being created at all.
# @required
# @docs("Access control (loopback users)", https://www.rabbitmq.com/docs/access-control)
RABBITMQ_USER=

# Platform prompt key for that account's password; threaded unchanged into
# RABBITMQ_DEFAULT_PASS below. Stored hashed after first boot, so changing
# this value later has no effect. Use `rabbitmqctl change_password` instead.
# It is simultaneously the AMQP credential and the management UI login.
# @required
# @sensitive
# @docs("Passwords", https://www.rabbitmq.com/docs/passwords)
RABBITMQ_PASSWORD=

# ─── First-boot seeding ────────────────────────────────────────────────────

# Username of the single user created when the node initialises an empty
# database. Set by the compose from RABBITMQ_USER. Overrides the `guest`
# default; the user gets the `administrator` tag and full
# configure/write/read permissions on the default vhost. Ignored on every
# subsequent boot.
# @required
RABBITMQ_DEFAULT_USER=${RABBITMQ_USER}

# Cleartext password for that user, set by the compose from
# RABBITMQ_PASSWORD. Read only during first-boot seeding; RabbitMQ stores
# only the salted hash. It stays in the container environment afterwards, so
# `docker inspect` and `env` inside the container reveal it.
# @required
# @sensitive
RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD}

# Name of the virtual host created on first boot and granted to the default
# user. Empty means the RabbitMQ default, `/` (which clients write as
# `%2F` in a URI). Changing it later does not rename or create a vhost.
# @docs("Virtual hosts", https://www.rabbitmq.com/docs/vhosts)
RABBITMQ_DEFAULT_VHOST=

# Comma-separated list of feature flags to enable when the node initialises
# for the FIRST time (rabbit_env.erl forced_feature_flags_on_init). An empty
# string is meaningful here: it means "enable no feature flag", while
# leaving the variable unset enables the release's stable defaults, which is
# what you want. Ignored on an already-initialised data directory.
# @docs("Feature flags", https://www.rabbitmq.com/docs/feature-flags)
RABBITMQ_FEATURE_FLAGS=

# ─── Node identity and clustering ──────────────────────────────────────────

# Erlang node name, default `rabbit@<short hostname>`. It is part of the data
# directory path (/var/lib/rabbitmq/mnesia/<nodename>), so it is effectively
# part of the storage identity. Rename the node and the broker boots as a
# brand-new empty one while the old queues sit orphaned in the volume. The
# compose pins `hostname: rabbitmq` for exactly this reason, which makes the
# node `rabbit@rabbitmq` and keeps it stable across container recreates.
# Setting this variable overrides that; if you do, keep the value fixed
# forever, and never let it follow the container ID.
# @docs("Node names", https://www.rabbitmq.com/docs/cli)
RABBITMQ_NODENAME=

# Use fully qualified (long) Erlang node names instead of short ones.
# Accepted true values are `1`, `yes` or `true`, case-insensitive; anything
# else is false. The image's entrypoint sets it to true automatically when
# the container's `hostname` differs from `hostname -s`. Long and short names
# are not interchangeable: switching after first boot changes the node name
# and therefore the data directory.
# @type=boolean
RABBITMQ_USE_LONGNAME=

# Overrides the on-disk Erlang cookie (/var/lib/rabbitmq/.erlang.cookie,
# generated on first boot). The cookie is the ONLY authentication on Erlang
# distribution (port 25672): anyone who knows it and can reach that port gets
# a remote shell on the node (read every message, change every permission,
# run arbitrary code as the rabbitmq user). It is not an AMQP credential and
# it is not scoped. Only set it to join a cluster, use a long random value,
# never publish port 25672, and prefer mounting a cookie file (mode 0600) as
# a secret so it is not visible in `docker inspect`.
# @sensitive
# @docs("Clustering: the Erlang cookie", https://www.rabbitmq.com/docs/clustering)
RABBITMQ_ERLANG_COOKIE=

# IP address the AMQP listener binds to. Empty listens on all interfaces,
# which is what a container needs.
RABBITMQ_NODE_IP_ADDRESS=

# AMQP 0-9-1 / 1.0 TCP port. The compose exposes container port 5672 with no
# override, so this is that port's twin: change it here without changing the
# exposed port and clients can no longer reach the broker. It also moves the
# Erlang distribution port, which is derived from it.
# @type=port
RABBITMQ_NODE_PORT=5672

# Erlang distribution (inter-node and rabbitmqctl) TCP port. Empty means
# RABBITMQ_NODE_PORT + 20000, i.e. 25672 by default. The compose does not
# publish it, and it should stay unpublished. See the cookie warning above.
# @type=port
RABBITMQ_DIST_PORT=

# Port range CLI tools (rabbitmqctl, rabbitmq-diagnostics, including the
# compose's healthcheck) bind to for their own distribution endpoint. Empty
# means 35672 for MIN and MIN+10 for MAX.
# Lowest port a CLI tool may bind; empty means 35672.
# @type=port
RABBITMQ_CTL_DIST_PORT_MIN=
# Highest port in that range; empty means RABBITMQ_CTL_DIST_PORT_MIN + 10.
# @type=port
RABBITMQ_CTL_DIST_PORT_MAX=

# Extra `erl` flags for CLI tools only (not the broker). Rarely needed
# outside TLS-secured Erlang distribution.
RABBITMQ_CTL_ERL_ARGS=

# ─── Configuration files ───────────────────────────────────────────────────

# Main configuration file, extension optional: `.conf` for the modern
# sysctl-style format, `.config` for the legacy Erlang-term one. Defaults to
# /etc/rabbitmq/rabbitmq. Most settings that are NOT in this schema
# (listeners, TLS, memory watermark, loopback_users) live here.
# @docs("Configuration file locations", https://www.rabbitmq.com/docs/configure)
RABBITMQ_CONFIG_FILE=

# Additional `.conf` files merged over the main one: a directory, or a glob.
# Defaults to /etc/rabbitmq/conf.d/*.conf, which is where the image drops
# 10-defaults.conf (`loopback_users.guest = false`, `log.console = true`).
# Overriding this path drops those image defaults.
RABBITMQ_CONFIG_FILES=

# Erlang-term configuration file for the handful of settings the `.conf`
# format cannot express. Defaults to /etc/rabbitmq/advanced.config.
# @docs("The advanced.config file", https://www.rabbitmq.com/docs/configure)
RABBITMQ_ADVANCED_CONFIG_FILE=

# Shell script sourced before the node starts, to set the very variables in
# this file. Defaults to /etc/rabbitmq/rabbitmq-env.conf. It is executed as
# a shell script by the boot scripts, so treat it as code, not config.
RABBITMQ_CONF_ENV_FILE=

# A "message of the day" file whose contents are appended to the startup
# banner and log. Defaults to /etc/rabbitmq/motd.
RABBITMQ_MOTD_FILE=

# ─── Plugins ───────────────────────────────────────────────────────────────

# Plugins to enable at startup, comma-separated; `ALL` enables everything,
# an empty string enables nothing. HAZARD on this image: when set, it REPLACES
# the enabled_plugins file that the `-management` image was built with, so
# omitting `rabbitmq_management` from the list silently turns off the UI on
# port 15672 that this template exposes.
# @docs("Plugins", https://www.rabbitmq.com/docs/plugins)
RABBITMQ_ENABLED_PLUGINS=

# File that records which plugins are enabled; defaults to
# /etc/rabbitmq/enabled_plugins (the image writes `rabbitmq_management`
# into it at build time).
RABBITMQ_ENABLED_PLUGINS_FILE=

# Colon-separated list of directories searched for plugin archives.
# Defaults to /opt/rabbitmq/plugins.
RABBITMQ_PLUGINS_DIR=

# Scratch directory where plugin archives are expanded. Defaults to
# <mnesia base>/<nodename>-plugins-expand, inside the data volume.
RABBITMQ_PLUGINS_EXPAND_DIR=

# ─── Data directories ──────────────────────────────────────────────────────

# Parent directory for the node's database directory. Defaults to
# /var/lib/rabbitmq/mnesia, which is inside the compose's rabbitmq-data
# volume. Moving it outside /var/lib/rabbitmq puts the broker's state on the
# container filesystem, where it is lost on recreate.
# @docs("File and directory locations", https://www.rabbitmq.com/docs/relocate)
RABBITMQ_MNESIA_BASE=

# The node's own database directory. Defaults to
# <RABBITMQ_MNESIA_BASE>/<nodename>. Note the node name in the path, which
# is why RABBITMQ_NODENAME must be stable.
RABBITMQ_MNESIA_DIR=

# Where the Raft log and state for quorum queues live. Defaults to
# <RABBITMQ_MNESIA_DIR>/quorum. Point it at faster storage only if it is as
# durable as the rest of the data directory, since losing it loses messages.
# @docs("Quorum queues", https://www.rabbitmq.com/docs/quorum-queues)
RABBITMQ_QUORUM_DIR=

# Where stream segment files and their Raft state live. Defaults to
# <RABBITMQ_MNESIA_DIR>/stream. Streams are usually the largest thing on
# disk, so this is the one worth relocating to a bigger volume.
# @docs("Streams", https://www.rabbitmq.com/docs/streams)
RABBITMQ_STREAM_DIR=

# File recording which feature flags are enabled. Defaults to
# <RABBITMQ_MNESIA_BASE>/<nodename>-feature_flags. It must sit alongside the
# database it describes; a mismatch makes the node refuse to boot.
RABBITMQ_FEATURE_FLAGS_FILE=

# File the Erlang VM's OS PID is written to; defaults to
# <RABBITMQ_MNESIA_DIR>.pid.
RABBITMQ_PID_FILE=

# Whether the PID file survives Erlang VM exit. Default is true.
# @type=boolean
RABBITMQ_KEEP_PID_FILE_ON_EXIT=true

# ─── Logging ───────────────────────────────────────────────────────────────

# Main log file target. The image ships `log.console = true`, so logs already
# go to the container's stdout where `docker logs` and the platform's log
# view can read them; setting a file path here sends them into the container
# instead, and `-` means stdout explicitly.
# @docs("Logging", https://www.rabbitmq.com/docs/logging)
RABBITMQ_LOGS=

# Directory for log files, default /var/log/rabbitmq. Only relevant if
# RABBITMQ_LOGS names a file.
RABBITMQ_LOG_BASE=

# Log level, overriding whatever the config file says. Takes a level
# (`debug`, `info`, `warning`, `error`, `none`), optionally per category as
# `connection=debug`, and a `+color` suffix. `debug` is very loud on a busy
# broker.
RABBITMQ_LOG=

# Erlang `dbg` tracing targets, given as `module`, `module:function` or
# `module:function/arity`, comma-separated. Debugging aid; it traces inside
# the running broker and can slow it to a crawl.
RABBITMQ_DBG=

# ─── Erlang VM / runtime flags ─────────────────────────────────────────────

# The supported way to append flags to the `erl` command line that starts the
# broker, for example `+S 4:4` to cap schedulers, or `-rabbit channel_max
# 4007` to set a `rabbit` application setting (note the space becomes the
# comma of the equivalent rabbitmq.conf entry). Appended after
# RABBITMQ_SERVER_ERL_ARGS, so it wins on conflicts.
# @docs("Runtime tuning", https://www.rabbitmq.com/docs/runtime)
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=

# REPLACES the computed set of standard VM flags (`+P`, `+t`, `+stbt`,
# `+zdbbl`, `+sbwt*`) rather than adding to them, which also silently voids
# the four tuning variables below. Use RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS
# unless you mean to take over the whole set.
RABBITMQ_SERVER_ERL_ARGS=

# Flags appended last, after the additional args; intended for the `rabbit`
# application's own start arguments.
RABBITMQ_SERVER_START_ARGS=

# Extra code path (`erl -pa`) for the server, used when loading plugins or
# patched modules from a mounted directory.
RABBITMQ_SERVER_CODE_PATH=

# Maximum Erlang processes (`+P`). Default 1048576. Each connection, channel
# and queue costs several; raise it only for very large brokers.
# @type=number
RABBITMQ_MAX_NUMBER_OF_PROCESSES=1048576

# Maximum Erlang atoms (`+t`). Default 5000000. Atoms are never garbage
# collected, so a node that creates unbounded distinct names can exhaust it.
# @type=number
RABBITMQ_MAX_NUMBER_OF_ATOMS=5000000

# Scheduler bind type (`+stbt`), default `db` (default_bind). Change only
# with a measured reason; on shared or CPU-limited hosts binding schedulers
# usually hurts.
RABBITMQ_SCHEDULER_BIND_TYPE=db

# Scheduler busy-wait threshold (`+sbwt`, `+sbwtdcpu`, `+sbwtdio`), default
# `none`. RabbitMQ deliberately turns busy waiting off to keep idle CPU
# near zero. Values are `none`, `very_short`, `short`, `medium`, `long`,
# `very_long`; raising it trades CPU for latency.
RABBITMQ_SCHEDULER_BUSY_WAIT_THRESHOLD=none

# Erlang distribution buffer busy limit in kB (`+zdbbl`), default 128000.
# Relevant to clustering throughput; irrelevant to a single node.
# @type=number
RABBITMQ_DISTRIBUTION_BUFFER_SIZE=128000

# If non-empty, `ulimit -n` is set to this value before the VM starts, and
# the container fails to start if the limit cannot be raised. RabbitMQ needs
# roughly one file handle per connection.
# @type=number
# @docs("Production checklist: open file limits", https://www.rabbitmq.com/docs/production-checklist)
RABBITMQ_MAX_OPEN_FILES=

# When set to any non-empty value, the broker starts WITHOUT `-noinput`,
# i.e. with an interactive Erlang shell attached to the container's stdin.
# Debugging only: anyone who can attach to the container then has a shell
# with full control of the node. Default is false.
# @type=boolean
RABBITMQ_ALLOW_INPUT=false

# Whether the VM ignores SIGINT (`+B i`). Default true, which is what keeps
# a stray Ctrl-C on an attached terminal from killing the broker.
# @type=boolean
RABBITMQ_IGNORE_SIGINT=true

# ─── Reported identity ─────────────────────────────────────────────────────

# Cosmetic overrides for the product name and version shown in the startup
# banner, the management UI and the AMQP server properties. Setting
# RABBITMQ_PRODUCT_VERSION to something other than the real one misleads
# monitoring and support; the actual broker is 4.3.5 either way.
# @docs("Management plugin", https://www.rabbitmq.com/docs/management)
RABBITMQ_PRODUCT_NAME=
# Version string reported instead of the real broker version.
RABBITMQ_PRODUCT_VERSION=

# ─── Erlang runtime environment ────────────────────────────────────────────

# Read by rabbitmq-env directly, not by RabbitMQ itself. ERL_EPMD_PORT and
# ERL_EPMD_ADDRESS are exported to the VM when set, moving or binding the
# port mapper daemon (default 4369, which the image EXPOSEs). ERL_MAX_ETS_TABLES
# and ERL_MAX_PORTS are only set to RabbitMQ's own defaults (50000 and 65536)
# if the environment does not already define them, so a value here wins.
# @type=port
# @docs("Networking and ports", https://www.rabbitmq.com/docs/networking)
ERL_EPMD_PORT=
# Address the port mapper binds to; empty binds all interfaces.
ERL_EPMD_ADDRESS=
# Maximum ETS tables the VM may create. RabbitMQ raises the OTP default to
# 50000 unless this is already set.
# @type=number
ERL_MAX_ETS_TABLES=50000
# Maximum Erlang ports (sockets, files, drivers) the VM may open. RabbitMQ
# sets 65536 unless this is already set; it caps concurrent connections.
# @type=number
ERL_MAX_PORTS=65536
