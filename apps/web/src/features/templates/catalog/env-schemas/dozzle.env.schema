# Dozzle 10.7.5 environment schema (@env-spec / varlock format).
#
# The compose pins amir20/dozzle:latest. On 2026-08-29 (research date) that
# tag shares its digest with v10.7.5, the newest tag on Docker Hub (also
# pushed as v10.7, v10, alpine and v10.7.5-alpine within the same batch).
#
# Source: internal/support/cli/args.go (the go-arg `Args` struct: every
# field's `env:"DOZZLE_*"` tag) plus a grep of os.Getenv/os.LookupEnv across
# the v10.7.5 tarball, cross-checked against dozzle.dev/guide. The Dockerfile
# ENTRYPOINT is `/dozzle` with no arguments, so Args.Mode defaults to
# "server", which is what our compose runs.
#
# Two vars the code reads are left out on purpose: DEV and LIVE_FS. Both are
# internal dev-loop toggles (console log formatting, serving assets from an
# on-disk ./dist instead of the binary's embedded one) undocumented anywhere
# and meaningless in the published scratch/alpine image, which has no
# ./dist directory to fall back to.
#
# The compose sets DOZZLE_LEVEL and DOZZLE_NO_ANALYTICS on the dozzle
# service; both are declared below at the compose's values.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Dozzle getting started", https://dozzle.dev/guide/getting-started)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# host:port the server binds to. Rarely needed inside a container, since the
# compose maps the container's 8080 to the host instead of changing this.
DOZZLE_ADDR=:8080

# Base path for the HTTP router. Change this to run Dozzle behind a reverse
# proxy at a sub-path (e.g. /dozzle); must match the proxy's strip/rewrite.
DOZZLE_BASE=/

# Display name shown in the UI header. Useful when running several Dozzle
# instances so operators can tell them apart.
DOZZLE_HOSTNAME=

# @type=enum(trace, debug, info, warn, error, fatal, panic)
DOZZLE_LEVEL=info

# server: watches the local Docker Engine (+ any DOZZLE_REMOTE_HOST/AGENT
# peers). swarm: runs an embedded agent server on :7007 for swarm-wide
# aggregation. k8s: watches a Kubernetes cluster via DOZZLE_NAMESPACE
# instead of Docker.
# @type=enum(server, swarm, k8s)
DOZZLE_MODE=server

# Timeout for calls to the Docker client (and, in swarm mode, to remote
# agents). Go duration syntax (10s, 1m).
DOZZLE_TIMEOUT=10s

# ─── Authentication ──────────────────────────────────────────────────────
# @docs("Authentication", https://dozzle.dev/guide/authentication)
# Without one of these, anyone who can reach the port has full log access.

# none: no auth. simple: Dozzle's own login form and user store (set up
# with the `generate` subcommand). forward-proxy: trusts the
# DOZZLE_AUTH_HEADER_* headers set by an upstream proxy (e.g. Authelia,
# Authentik). Dozzle exits at startup if this is set to anything else.
# @type=enum(none, simple, forward-proxy)
DOZZLE_AUTH_PROVIDER=none

# How long a session/token stays valid. "session" ties it to the browser
# session; otherwise a Go duration (12h, 24h).
DOZZLE_AUTH_TTL=session

# @docs("Forward Proxy auth", https://dozzle.dev/guide/authentication#forward-proxy)
DOZZLE_AUTH_HEADER_USER=Remote-User
DOZZLE_AUTH_HEADER_EMAIL=Remote-Email
DOZZLE_AUTH_HEADER_NAME=Remote-Name
DOZZLE_AUTH_HEADER_FILTER=Remote-Filter
DOZZLE_AUTH_HEADER_ROLES=Remote-Roles

# Where the "logout" link in the UI sends the browser; typically the
# forward-proxy's own logout endpoint.
# @type=url
DOZZLE_AUTH_LOGOUT_URL=

# ─── Actions & access ────────────────────────────────────────────────────

# Turns on container actions (start/stop/restart/remove) from the web UI.
# Requires the Docker socket mount to allow write operations, which this
# template's read-only :ro mount does not.
# @type=boolean
DOZZLE_ENABLE_ACTIONS=false

# Turns on an in-browser shell into containers. Same :ro socket caveat.
# @type=boolean
DOZZLE_ENABLE_SHELL=false

# Exposes the MCP (Model Context Protocol) endpoint for LLM tool
# integration against this Dozzle instance's logs and containers.
# @docs("MCP", https://dozzle.dev/guide/mcp)
# @type=boolean
DOZZLE_ENABLE_MCP=false

# Hides Gravatar/identicon avatars for authenticated users.
# @type=boolean
DOZZLE_DISABLE_AVATARS=false

# ─── Filtering ───────────────────────────────────────────────────────────
# @docs("Filters", https://dozzle.dev/guide/filters)
# Docker filter syntax (label=value, name=value, ...), repeatable. Limits
# which containers Dozzle shows across every mode.

DOZZLE_FILTER=

# ─── Remote hosts & swarm ────────────────────────────────────────────────
# @docs("Remote hosts", https://dozzle.dev/guide/remote-hosts)

# Additional Docker Engine hosts to connect to directly (tcp://host:2375).
DOZZLE_REMOTE_HOST=

# Other Dozzle instances running in agent mode to aggregate logs from
# (host:port). Used together with DOZZLE_MODE=swarm's embedded agent
# server, or standalone `dozzle agent` deployments.
# @docs("Swarm mode", https://dozzle.dev/guide/swarm-mode)
DOZZLE_REMOTE_AGENT=

# Kubernetes namespaces to watch when DOZZLE_MODE=k8s. Empty watches every
# namespace the service account can see.
DOZZLE_NAMESPACE=

# ─── Release checks & telemetry ─────────────────────────────────────────

# automatic checks GitHub for newer Dozzle releases and shows a banner;
# manual disables the check entirely.
# @type=enum(automatic, manual)
DOZZLE_RELEASE_CHECK_MODE=automatic

# Disables Dozzle's anonymous usage analytics ping.
# @type=boolean
DOZZLE_NO_ANALYTICS=true

# ─── TLS (swarm agent listener) ──────────────────────────────────────────
# Only read when DOZZLE_MODE=swarm; used for the mutual-TLS link between
# the swarm manager and its agents. Paths are inside the container.

DOZZLE_CERT=dozzle_cert.pem
DOZZLE_KEY=dozzle_key.pem

# ─── Kubernetes client (DOZZLE_MODE=k8s) ─────────────────────────────────
# Not Dozzle-specific flags, but direct os.Getenv/os.LookupEnv reads that
# pick in-cluster vs. kubeconfig-file auth for client-go. Leave empty when
# running in-cluster with a mounted service account (the usual case).

# Set automatically by Kubernetes inside a pod; presence alone switches
# Dozzle to in-cluster auth. Do not set this by hand outside a cluster.
KUBERNETES_SERVICE_HOST=

# Path to a kubeconfig file, used only outside a cluster. Falls back to
# $HOME/.kube/config when empty.
KUBECONFIG=
