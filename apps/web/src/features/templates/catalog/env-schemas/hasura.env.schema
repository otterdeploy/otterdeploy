# Hasura GraphQL Engine v2.50.1 environment schema (@env-spec / varlock
# format). This is the v2 `graphql-engine` line (Community Edition), NOT the
# separate v3/DDN product; none of the DDN variables apply here.
#
# Source: the pinned tag's own option definitions, all read at
# github.com/hasura/graphql-engine tag v2.50.1:
# server/src-lib/Hasura/Server/Init/Arg/Command/Serve.hs (80 `_envVar`
# entries, each with its `_default` and `_helpMessage`),
# server/src-lib/Hasura/Server/Init/Arg.hs (the three global ones:
# DATABASE_URL, METADATA_DATABASE_URL, NO_OF_RETRIES),
# server/src-lib/Hasura/Server/Init/Config.hs and Hasura/Server/Types.hs for
# the closed value sets, and Hasura/Logging.hs for the log-type defaults.
#
# Cross-checked against the docs' "GraphQL Engine server config reference".
# Where they disagree, the code wins and this file follows the code:
#   * The docs page lists 22 variables the CE binary never reads, all of them
#     Hasura EE/Cloud only: HASURA_GRAPHQL_ADMIN_SECRETS,
#     HASURA_GRAPHQL_JWT_SECRETS, HASURA_GRAPHQL_READ_REPLICA_URL,
#     HASURA_GRAPHQL_CONNECTIONS_PER_READ_REPLICA,
#     HASURA_GRAPHQL_STRIPES_PER_READ_REPLICA, HASURA_GRAPHQL_REDIS_URL and
#     the other REDIS_*/RATE_LIMIT_REDIS_* keys, HASURA_GRAPHQL_MAX_CACHE_SIZE,
#     HASURA_GRAPHQL_CACHE_MAX_ENTRY_TTL, HASURA_GRAPHQL_QUERY_PLAN_CACHE_SIZE,
#     HASURA_GRAPHQL_SSO_PROVIDERS, HASURA_GRAPHQL_ENABLE_LOG_COMPRESSION,
#     HASURA_GRAPHQL_METRICS_ENABLE_HIGH_CARDINALITY_LABELS,
#     HASURA_GRAPHQL_DYNAMIC_SECRETS_ALLOWED_PATH_PREFIX,
#     HASURA_GRAPHQL_BIGQUERY_STRING_NUMERIC_INPUT and
#     HASURA_GRAPHQL_PG_SSL_CERTIFICATE_PATH (that last one appears ONLY in
#     docs/ and a test README; no Haskell source at this tag reads it).
#     None of them are declared here.
#   * The docs name the pool-acquire timeout HASURA_GRAPHQL_POOL_TIMEOUT; the
#     code reads HASURA_GRAPHQL_PG_POOL_TIMEOUT. The prefixed name is the real
#     one.
#   * Ten variables the code reads are missing from the docs page and are
#     declared below anyway: HASURA_GRAPHQL_ACCESS_KEY (deprecated alias),
#     HASURA_CONSOLE_SENTRY_DSN, HASURA_GRAPHQL_DISABLE_EVENTING,
#     HASURA_GRAPHQL_DISABLE_EVENT_PROCESSING, HASURA_GRAPHQL_ENABLE_RELAY,
#     HASURA_GRAPHQL_HTTP_LOG_QUERY_ONLY_ON_ERROR,
#     HASURA_GRAPHQL_LOG_MASKED_VARIABLES, HASURA_GRAPHQL_METADATA_DEFAULTS,
#     HASURA_GRAPHQL_SERVER_TIMEOUT and HASURA_GRAPHQL_WEBSOCKET_QUEUE_SIZE.
#
# The image's own config sets HGE_BINARY=graphql-engine and runs
# `"${HGE_BINARY}" serve` as its CMD. That is baked into the image, not
# something the compose or an operator sets, so it is not declared here.
#
# Hasura also reads the WHOLE process environment (Main.hs `getEnvironment`)
# so that metadata can interpolate `{{$env.MY_VAR}}` into connection strings,
# action handler URLs, remote schema URLs and webhook headers. Any extra
# variable you add to this stack becomes available to metadata that way; only
# the engine's own configuration surface is enumerated below.

# @defaultSensitive=false @defaultRequired=infer
# @docs("GraphQL Engine server config reference", https://hasura.io/docs/2.0/deployment/graphql-engine-flags/reference/)
# @docs("Server config examples", https://hasura.io/docs/2.0/deployment/graphql-engine-flags/config-examples/)
# @docs("Production checklist", https://hasura.io/docs/2.0/deployment/production-checklist/)
# ---

# ─── Admin access (READ THIS FIRST) ───────────────────────────────────────
# @docs("Securing the GraphQL endpoint", https://hasura.io/docs/2.0/deployment/securing-graphql-endpoint/)

# The single key that protects this instance. WITHOUT IT THERE IS NO
# AUTHENTICATION AT ALL: every request that reaches the port is treated as
# the `admin` role, which means the web console, the full GraphQL API
# (read AND write on every table), the metadata API and `/v2/query`
# `run_sql` are open to anyone who can reach port 8080. Hasura logs a
# warning at startup when it is unset and starts anyway.
#
# With it set, a request must carry `x-hasura-admin-secret: <this value>`
# (or a JWT / auth-webhook identity, see below) to do anything at all.
# Generated at install and injected by the platform from HASURA_ADMIN_SECRET.
# @required @sensitive
# @docs("Admin secret access", https://hasura.io/docs/2.0/auth/authentication/admin-secret-access/)
HASURA_GRAPHQL_ADMIN_SECRET=${HASURA_ADMIN_SECRET}

# The admin secret as the operator supplies it, generated at install. This
# is the value the compose interpolates into HASURA_GRAPHQL_ADMIN_SECRET
# above; treat it as the root password for the whole stack.
# @required @sensitive
# @docs("Securing the GraphQL endpoint", https://hasura.io/docs/2.0/deployment/securing-graphql-endpoint/)
HASURA_ADMIN_SECRET=

# Pre-2.0 name for the same thing. Still read at this version, but setting
# BOTH it and HASURA_GRAPHQL_ADMIN_SECRET is an error at startup. Leave empty.
# @sensitive
HASURA_GRAPHQL_ACCESS_KEY=

# ─── Bundled Postgres ─────────────────────────────────────────────────────
# One Postgres serves both roles here: the user data source AND Hasura's own
# metadata catalog (the `hdb_catalog` schema it creates in the same
# database). Hasura will not start if it cannot reach it.
# @docs("Postgres requirements", https://hasura.io/docs/2.0/deployment/postgres-requirements/)

# PLATFORM-OWNED: the sibling `db` service plus this stack's own password.
# The primary data source Hasura tracks tables from.
# @required @sensitive
HASURA_GRAPHQL_DATABASE_URL=postgres://hasura:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/hasura
# PLATFORM-OWNED: where Hasura stores its metadata catalog. Pointed at the
# same database as above, which is the supported single-Postgres layout. If
# this is unset Hasura falls back to HASURA_GRAPHQL_DATABASE_URL, so the two
# are deliberately identical rather than one being omitted.
# @required @sensitive
HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://hasura:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/hasura

# Password for the bundled Postgres. Generated at install; it is what both
# URLs above interpolate.
# @required @sensitive
POSTGRES_PASSWORD=

# Set by the compose on the `db` service itself (Postgres reads these at
# first boot to create the role and database). Informational: the database
# Hasura connects to is named "hasura", owned by role "hasura". Changing
# either without changing the two URLs above breaks the connection.
# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=hasura
# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_DB=hasura

# Name of the schema Hasura is allowed to install Postgres extensions into
# (it needs pgcrypto). Default: public.
HASURA_GRAPHQL_METADATA_DATABASE_EXTENSIONS_SCHEMA=public

# Number of retries if the initial Postgres connection fails at startup.
# Default: 1.
# @type=number
HASURA_GRAPHQL_NO_OF_RETRIES=

# ─── Postgres connection pool ─────────────────────────────────────────────
# @docs("Performance tuning", https://hasura.io/docs/2.0/deployment/performance-tuning/)

# Distinct sub-pools to maintain; a new connection is taken from a stripe
# pseudo-randomly. Total connections is stripes x connections-per-stripe, so
# the pinned defaults ask Postgres for up to 50 connections.
# @type=number
HASURA_GRAPHQL_PG_STRIPES=1
# Max Postgres connections per stripe. At the maximum, Hasura blocks waiting
# for a free connection even if another stripe has capacity.
# @type=number
HASURA_GRAPHQL_PG_CONNECTIONS=50
# Seconds a connection may sit idle before it is closed.
# @type=number
HASURA_GRAPHQL_PG_TIMEOUT=180
# Seconds after which a connection is destroyed and recreated, so memory from
# large query results is reclaimed. 0 means never destroy an active one.
# @type=number
HASURA_GRAPHQL_PG_CONN_LIFETIME=600
# Seconds to wait when acquiring a connection from the pool. Empty is the
# default and means wait forever. (The docs call this HASURA_GRAPHQL_POOL_TIMEOUT;
# the code only reads the PG_-prefixed name.)
# @type=number
HASURA_GRAPHQL_PG_POOL_TIMEOUT=
# Use Postgres prepared statements for queries. Default: true. Turn off only
# behind a connection pooler that cannot handle them (PgBouncer in
# transaction mode).
# @type=boolean
HASURA_GRAPHQL_USE_PREPARED_STATEMENTS=true
# Transaction isolation level for Hasura's own queries.
# @type=enum(read-committed, repeatable-read, serializable)
HASURA_GRAPHQL_TX_ISOLATION=read-committed

# ─── Console, CORS and dev mode (production hardening) ────────────────────
# These three are what separates a demo instance from a deployed one. The
# console is served by the engine itself at /console; CORS defaults to
# allow-all; dev mode leaks internals into error responses.
# @docs("Production checklist", https://hasura.io/docs/2.0/deployment/production-checklist/)

# Serves the admin web console at /console. Hasura's own default is FALSE;
# this stack turns it on so the instance is usable out of the box. The
# console is only as safe as HASURA_GRAPHQL_ADMIN_SECRET. With the secret
# set it prompts for it; with no secret set, enabling the console hands full
# admin over to anyone who can load the page. Set to "false" once you manage
# metadata with the Hasura CLI instead.
# @type=boolean
# @docs("Securing the GraphQL endpoint", https://hasura.io/docs/2.0/deployment/securing-graphql-endpoint/)
HASURA_GRAPHQL_ENABLE_CONSOLE=true

# Includes an `internal` key in the `extensions` of error responses: the
# failing SQL, the generated query, connection details. Kept "false"
# here on purpose; turning it on exposes schema internals to every client
# that can trigger an error.
# @type=boolean
# @docs("Dev mode", https://hasura.io/docs/2.0/deployment/graphql-engine-flags/config-examples/#dev-mode)
HASURA_GRAPHQL_DEV_MODE=false

# CSV of domains allowed to make browser requests, excluding scheme and
# including port, wildcards allowed (e.g. "https://*.example.com:8080").
# Default is "*" (ALL origins). Narrow this to your own front-end origins in
# production.
# @docs("CORS domain", https://hasura.io/docs/2.0/deployment/graphql-engine-flags/config-examples/#cors-domain)
HASURA_GRAPHQL_CORS_DOMAIN=*
# Sends no CORS headers at all on any response. Default: false. Use only when
# a reverse proxy in front of Hasura is doing CORS itself.
# @type=boolean
HASURA_GRAPHQL_DISABLE_CORS=false
# Read cookies on the WebSocket initial handshake even when CORS is disabled.
# The engine's own help calls this "a potential security flaw"; it only
# applies when HASURA_GRAPHQL_DISABLE_CORS is true. Default: false.
# @type=boolean
HASURA_GRAPHQL_WS_READ_COOKIE=false

# Serve the console's static assets from a directory inside the container
# instead of Hasura's CDN. "/srv/console-assets" is the path baked into this
# image; set it for an air-gapped deployment.
HASURA_GRAPHQL_CONSOLE_ASSETS_DIR=

# Sentry DSN the CONSOLE (browser) reports its own JS errors to. Empty
# disables console error reporting. Undocumented on the reference page.
# @sensitive
HASURA_CONSOLE_SENTRY_DSN=

# Anonymous usage telemetry from both server and console. Default: true.
# @type=boolean
# @docs("Telemetry policy", https://hasura.io/docs/2.0/policies/telemetry/)
HASURA_GRAPHQL_ENABLE_TELEMETRY=true

# ─── Authentication for non-admin clients ─────────────────────────────────
# Set at most ONE of JWT_SECRET or AUTH_HOOK. With neither, the only identity
# Hasura understands is "presented the admin secret". Every other request is
# rejected unless HASURA_GRAPHQL_UNAUTHORIZED_ROLE gives it a role.

# JSON describing the JWT verification key, e.g.
# {"type":"HS256","key":"<hmac secret>"} or
# {"type":"RS256","key":"<PEM public key>"}; also accepts jwk_url,
# claims_namespace, claims_format, audience, issuer, allowed_skew.
# @sensitive
# @docs("JWT authentication", https://hasura.io/docs/2.0/auth/authentication/jwt/)
HASURA_GRAPHQL_JWT_SECRET=

# URL of a webhook Hasura calls to resolve the session variables of each
# request. Mutually exclusive with JWT.
# @type=url
# @docs("Webhook authentication", https://hasura.io/docs/2.0/auth/authentication/webhook/)
HASURA_GRAPHQL_AUTH_HOOK=
# HTTP method used for that webhook. Default: GET (headers are forwarded);
# POST sends a JSON body instead.
# @type=enum(GET, POST)
HASURA_GRAPHQL_AUTH_HOOK_MODE=GET
# Include the original request body in the POST sent to the auth webhook.
# Default: true. Only meaningful when AUTH_HOOK_MODE is POST.
# @type=boolean
HASURA_GRAPHQL_AUTH_HOOK_SEND_REQUEST_BODY=true

# Role applied to requests that carry no admin secret and no valid JWT /
# webhook identity. Empty means such requests are rejected outright; set it
# (e.g. "anonymous" or "public") only after you have written row-level
# permissions for that role.
# @docs("Unauthenticated / public access", https://hasura.io/docs/2.0/auth/authentication/unauthenticated-access/)
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=

# Return the webhook's / JWT layer's real HTTP 401 instead of mapping every
# auth failure to 200 with a GraphQL error. Default: false.
# @type=boolean
HASURA_GRAPHQL_PRESERVE_401_ERRORS=

# Include `internal` error details in responses made BY the admin role.
# Default: true. Independent of DEV_MODE, which applies to all roles.
# @type=boolean
HASURA_GRAPHQL_ADMIN_INTERNAL_ERRORS=true

# ─── HTTP server ──────────────────────────────────────────────────────────

# Port the engine listens on. The compose exposes container port 8080 with no
# override, so this is that port's twin; change it here and routing breaks
# unless the exposed port changes too.
# @type=port
HASURA_GRAPHQL_SERVER_PORT=8080
# Interface to bind. "*" is the default and what the container network needs.
HASURA_GRAPHQL_SERVER_HOST=*
# Seconds before a slow request is dropped. Default: 30; connections making
# slow progress may survive up to roughly twice this.
# @type=number
HASURA_GRAPHQL_SERVER_TIMEOUT=30
# Max cumulative length of all request headers, in bytes. Default: 1 MiB.
# Raise it if large JWTs plus forwarded headers overflow.
# @type=number
HASURA_GRAPHQL_MAX_TOTAL_HEADER_LENGTH=1048576
# Seconds to let in-flight scheduled events, cron events and async actions
# finish during shutdown. Default: 60.
# @type=number
HASURA_GRAPHQL_GRACEFUL_SHUTDOWN_TIMEOUT=60

# ─── Exposed APIs and schema behaviour ────────────────────────────────────

# Comma-separated list of API surfaces to serve. Recognised values:
# metadata, graphql, pgdump, developer, config, metrics. Dropping "metadata"
# and "pgdump" is the usual production hardening once metadata is managed by
# CI, though it also disables the console's ability to edit anything.
# @docs("Metadata API reference", https://hasura.io/docs/2.0/api-reference/metadata-api/index/)
HASURA_GRAPHQL_ENABLED_APIS=metadata,graphql,pgdump,config

# Serve the Relay endpoints /v1beta1/relay. Default: true; when disabled the
# endpoint returns an error. Undocumented on the reference page.
# @type=boolean
# @docs("Relay GraphQL API", https://hasura.io/docs/2.0/api-reference/relay-graphql-api/index/)
HASURA_GRAPHQL_ENABLE_RELAY=true

# Reject any GraphQL operation not in the metadata allow-list. Default:
# false. A strong production control, but you must populate the allow-list
# first or every query fails.
# @type=boolean
# @docs("Allow list", https://hasura.io/docs/2.0/security/allow-list/)
HASURA_GRAPHQL_ENABLE_ALLOWLIST=false

# Automated persisted queries: clients send a hash instead of the query text.
# Default: false; TTL is in seconds (default 5).
# @type=boolean
HASURA_GRAPHQL_ENABLE_PERSISTED_QUERIES=false
# @type=number
HASURA_GRAPHQL_PERSISTED_QUERIES_TTL=5

# Expose this instance as an Apollo Federation subgraph. Default: false.
# @type=boolean
# @docs("Apollo Federation", https://hasura.io/docs/2.0/data-federation/apollo-federation/)
HASURA_GRAPHQL_ENABLE_APOLLO_FEDERATION=false

# Enforce per-role permissions on remote schemas instead of exposing them
# whole. Default: false.
# @type=boolean
# @docs("Remote schema permissions", https://hasura.io/docs/2.0/remote-schemas/auth/remote-schema-permissions/)
HASURA_GRAPHQL_ENABLE_REMOTE_SCHEMA_PERMISSIONS=false
# Drop null arguments before forwarding a field to a remote schema, instead
# of forwarding the explicit null. Default: false.
# @type=boolean
HASURA_GRAPHQL_REMOTE_SCHEMA_SKIP_NULLS=false
# Return remote-schema data even when the remote also returned errors.
# Default: false (errors win).
# @type=boolean
HASURA_GRAPHQL_REMOTE_SCHEMA_PRIORITIZE_DATA=false

# Auto-generated GraphQL naming style. hasura-default is snake_case
# throughout; graphql-default is camelCase fields / PascalCase types.
# Changing it rewrites your whole API surface. Requires
# `naming_convention` in HASURA_GRAPHQL_EXPERIMENTAL_FEATURES.
# @type=enum(hasura-default, graphql-default)
# @docs("Naming convention", https://hasura.io/docs/2.0/schema/postgres/naming-convention/)
HASURA_GRAPHQL_DEFAULT_NAMING_CONVENTION=hasura-default

# Return numeric (bigint, numeric) values as strings so JS clients do not
# lose precision. Default: false.
# @type=boolean
HASURA_GRAPHQL_STRINGIFY_NUMERIC_TYPES=false

# Give tracked SQL functions the permissions of the role that owns the
# underlying table, rather than requiring explicit function permissions.
# Default: true.
# @type=boolean
# @docs("Custom SQL functions", https://hasura.io/docs/2.0/schema/postgres/custom-functions/)
HASURA_GRAPHQL_INFER_FUNCTION_PERMISSIONS=true

# Skip validation of Native Queries against the database at metadata-apply
# time. Default: false (always validate).
# @type=boolean
# @docs("Native Queries", https://hasura.io/docs/2.0/schema/postgres/native-queries/)
HASURA_GRAPHQL_DISABLE_NATIVE_QUERY_VALIDATION=false

# JSON merged underneath every metadata document, a way to pin defaults
# (e.g. backend_configs) without editing metadata. Undocumented on the
# reference page; empty means no defaults.
# @docs("Metadata format", https://hasura.io/docs/2.0/migrations-metadata-seeds/metadata-format/)
HASURA_GRAPHQL_METADATA_DEFAULTS=

# Milliseconds between polls of the metadata catalog for changes made by
# another replica. Default: 1000; 0 disables schema sync.
# @type=number
HASURA_GRAPHQL_SCHEMA_SYNC_POLL_INTERVAL=1000

# Refuse all writes: mutations, metadata API and run_sql are blocked while
# the engine keeps serving reads. For running a database migration under a
# live instance. Default: false.
# @type=boolean
# @docs("Maintenance mode", https://hasura.io/docs/2.0/deployment/graphql-engine-flags/reference/#enable-maintenance-mode)
HASURA_GRAPHQL_ENABLE_MAINTENANCE_MODE=false

# Comma-separated experimental features. Recognised at this version:
# inherited_roles, optimize_permission_filters, naming_convention,
# streaming_subscriptions, apollo_federation, hide_update_many_fields,
# bigquery_string_numeric_input, hide_aggregation_predicates,
# hide_stream_fields, group_by_aggregations, disable_postgres_arrays,
# no_null_unbound_variable_default, remove_empty_subscription_responses.
# (inherited_roles is now always on and is accepted only for compatibility.)
# @docs("Inherited roles", https://hasura.io/docs/2.0/auth/authorization/inherited-roles/)
HASURA_GRAPHQL_EXPERIMENTAL_FEATURES=

# ─── Subscriptions and WebSockets ─────────────────────────────────────────
# @docs("Subscriptions", https://hasura.io/docs/2.0/subscriptions/overview/)

# Live queries that can be multiplexed are batched; refetch interval is in
# milliseconds. Defaults: batch 100, interval 1000.
# @type=number
# @docs("Live query execution", https://hasura.io/docs/2.0/subscriptions/postgres/livequery/execution/)
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_BATCH_SIZE=100
# @type=number
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_REFETCH_INTERVAL=1000
# Same two knobs for streaming subscriptions (requires
# `streaming_subscriptions` in HASURA_GRAPHQL_EXPERIMENTAL_FEATURES).
# @type=number
# @docs("Streaming subscriptions", https://hasura.io/docs/2.0/subscriptions/postgres/streaming/index/)
HASURA_GRAPHQL_STREAMING_QUERIES_MULTIPLEXED_BATCH_SIZE=100
# @type=number
HASURA_GRAPHQL_STREAMING_QUERIES_MULTIPLEXED_REFETCH_INTERVAL=1000

# Seconds between WebSocket keep-alive frames. Default: 5.
# @type=number
HASURA_GRAPHQL_WEBSOCKET_KEEPALIVE=5
# Seconds a client has to send `connection_init` after opening the socket.
# Default: 3.
# @type=number
HASURA_GRAPHQL_WEBSOCKET_CONNECTION_INIT_TIMEOUT=3
# Messages buffered per WebSocket connection before older ones are dropped.
# Default: 100 (1000 when streaming subscriptions are enabled); minimum 1.
# Undocumented on the reference page.
# @type=number
HASURA_GRAPHQL_WEBSOCKET_QUEUE_SIZE=100
# permessage-deflate compression on WebSocket frames. Default: false.
# @type=boolean
HASURA_GRAPHQL_CONNECTION_COMPRESSION=false
# Close every open WebSocket (code 1012) whenever metadata changes, so
# clients resubscribe against the new schema. Default: true.
# @type=boolean
HASURA_GRAPHQL_CLOSE_WEBSOCKETS_ON_METADATA_CHANGE=true

# ─── Eventing: event triggers, cron, async actions ────────────────────────
# @docs("Event triggers", https://hasura.io/docs/2.0/event-triggers/overview/)

# Max concurrent HTTP threads delivering events. Default: 100.
# @type=number
HASURA_GRAPHQL_EVENTS_HTTP_POOL_SIZE=100
# Milliseconds to sleep after a fetch that returned no events. Default: 1000.
# @type=number
HASURA_GRAPHQL_EVENTS_FETCH_INTERVAL=1000
# Events pulled from the events table per batch. Default: 100; 0 disables
# fetching events entirely.
# @type=number
HASURA_GRAPHQL_EVENTS_FETCH_BATCH_SIZE=100

# Milliseconds between polls for new async action invocations. Default: 1000;
# 0 disables async action processing.
# @type=number
# @docs("Async actions", https://hasura.io/docs/2.0/actions/async-actions/)
HASURA_GRAPHQL_ASYNC_ACTIONS_FETCH_INTERVAL=1000
# Async action requests processed concurrently. Default: 10.
# @type=number
HASURA_GRAPHQL_ASYNC_ACTIONS_FETCH_BATCH_SIZE=10

# Turn the whole eventing subsystem off (event triggers, cron triggers,
# scheduled events and async actions) so its background pollers stop
# competing for database connections. Default: false.
# @type=boolean
# @docs("Scheduled triggers", https://hasura.io/docs/2.0/scheduled-triggers/overview/)
HASURA_GRAPHQL_DISABLE_EVENTING=false
# Softer variant: stop the pollers from delivering, but still run the
# eventing catalog migrations so the tables exist. Default: false.
# Undocumented on the reference page.
# @type=boolean
HASURA_GRAPHQL_DISABLE_EVENT_PROCESSING=false

# Log trigger delivery failures at level "error" rather than "info".
# Default: false.
# @type=boolean
HASURA_GRAPHQL_ENABLE_TRIGGERS_ERROR_LOG_LEVEL=false

# Forward metadata-configured headers with higher precedence than client
# headers when calling action / input-validation webhooks. Default: false
# (client headers win).
# @type=boolean
# @docs("Action handlers", https://hasura.io/docs/2.0/actions/action-handlers/)
HASURA_GRAPHQL_CONFIGURED_HEADER_PRECEDENCE=false

# ─── Logging ──────────────────────────────────────────────────────────────
# @docs("Logging", https://hasura.io/docs/2.0/deployment/logging/)

# Comma-separated log types to emit. Default:
# startup, http-log, webhook-log, websocket-log, jwk-refresh-log.
# Also settable: query-log, execution-log, livequery-poller-log,
# action-handler-log, data-connector-log, validate-input-log. Adding
# query-log prints every operation's GraphQL and generated SQL.
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,jwk-refresh-log
# @type=enum(error, warn, info, debug)
HASURA_GRAPHQL_LOG_LEVEL=info
# Include the query field in http-logs for METADATA API calls. Default: false.
# @type=boolean
HASURA_GRAPHQL_ENABLE_METADATA_QUERY_LOGGING=false
# Only attach the query to the http log when the request errored. Default:
# false. Undocumented on the reference page.
# @type=boolean
HASURA_GRAPHQL_HTTP_LOG_QUERY_ONLY_ON_ERROR=false
# Comma-separated GraphQL variable names whose values are replaced with
# "[MASKED]" in query-log output, the way to keep passwords and tokens out
# of logs when query-log is on. Undocumented on the reference page.
HASURA_GRAPHQL_LOG_MASKED_VARIABLES=
# Emit a trace for every query. Default: false.
# @type=boolean
HASURA_GRAPHQL_ENABLE_QUERY_TRACING=false

# ─── Backwards-compatibility shims ────────────────────────────────────────
# Both restore pre-2.x behaviour and both are marked DEPRECATED, WILL BE
# REMOVED SOON in the engine's own help text. Leave them off unless an old
# client depends on the old semantics.

# Treat an explicit `null` in a boolean expression as "ignore this field"
# (v1 behaviour) instead of as a filter.
# @type=boolean
HASURA_GRAPHQL_V1_BOOLEAN_NULL_COLLAPSE=false
# Accept `null` for non-nullable variables, as versions before v2.34.0 did.
# @type=boolean
HASURA_GRAPHQL_BACKWARDS_COMPAT_NULL_IN_NONNULLABLE_VARIABLES=false
