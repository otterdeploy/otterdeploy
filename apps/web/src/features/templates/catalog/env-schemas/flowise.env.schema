# Flowise 3.1.4 environment schema (@env-spec / varlock format).
#
# The compose pins flowiseai/flowise:3.1.4 (digest
# sha256:3922767afb52a5777759fd8b28a3c9eee864daea96018a791f2429eae2a76571,
# pushed 2026-07-29). 3.1.4 is taken over the more-matured 3.1.3 for
# security: GitHub advisories GHSA-9gvv-qjj3-2p6g, GHSA-vmv7-4m6c-3cg5,
# GHSA-4j8x-x6v7-w9rq, GHSA-x3hf-7cj6-3r4m, GHSA-5xvg-pmgg-3mxr and
# GHSA-c5hr-rc98-xp3g (all "critical", all authenticated RCE / sandbox
# escape through the CSV / Airtable agents, the SQLite record manager and
# the puppeteer allowlist) are fixed only in 3.1.4.
#
# Source: grep of `process.env.*` across packages/server/src and
# packages/components (src + nodes) at tag flowise@3.1.4, cross-checked
# against packages/server/src/commands/base.ts (the oclif flag table that
# enumerates every name Flowise recognises) and docker/.env.example.
#
# What the docs get wrong at this version:
#   * FLOWISE_USERNAME / FLOWISE_PASSWORD DO NOT EXIST. Zero references in
#     the 3.1.4 tree. App-level auth moved to a Passport.js account system
#     in 3.0.1; the pair survives only in stale prose on the docs' "Auth >
#     Application" page. A compose that still sets them protects nothing.
#     See "Who can get in" below for what actually guards the instance.
#   * APIKEY_PATH is likewise gone (API keys live in the database now).
#   * The docs' env table says CUSTOM_MCP_PROTOCOL defaults to `stdio`. It
#     does not: CustomMCP.ts only picks stdio when the value is literally
#     "stdio", so the effective default is `sse` (remote HTTP MCP only).
#   * docker/.env.example spells the password-reset knob
#     PASSWORD_RESET_TOKEN_EXPIRY_IN_MINS (so does the base.ts CLI flag);
#     the code reads PASSWORD_RESET_TOKEN_EXPIRY_IN_MINUTES. The short
#     spelling does nothing.
#   * base.ts also declares NUMBER_OF_PROXIES, DISABLE_FLOWISE_TELEMETRY,
#     PUPPETEER_EXECUTABLE_FILE_PATH and PLAYWRIGHT_EXECUTABLE_FILE_PATH,
#     but nothing in the 3.1.4 tree reads them. They are omitted here.
#
# Two consequences of the 3.x image running as the non-root `node` user
# (uid 1000, HOME=/home/node), both of which shape the paths below:
#   * /root is unwritable, so nothing may live there any more.
#   * Docker gives a fresh named volume the ownership of its mountpoint AS
#     IT EXISTS IN THE IMAGE. /home/node/.flowise does not exist in the
#     image, so a volume mounted there lands root:root 0755 and uid 1000
#     cannot write it (verified against flowiseai/flowise:3.1.4's layout on
#     Docker 28.3.3). The compose therefore mounts the volume on
#     /home/node, which does exist and is owned by node:node, and lets
#     Flowise create .flowise inside it.
#   * LOG_PATH is the one path NOT under .flowise, deliberately:
#     utils/logger.ts runs at module load, before DataSource.init() creates
#     $HOME/.flowise, and calls a NON-recursive fs.mkdirSync(LOG_PATH), so
#     a LOG_PATH whose parent does not exist yet is a permanent boot loop on
#     a fresh volume.
#
# The compose also sets EXPIRE_AUTH_TOKENS_ON_RESTART=true, which is not a
# preference: without it the published 3.1.4 image cannot start at all. See
# that key's note. The whole configuration above was booted against the
# pinned digest and answers 200 on /api/v1/ping.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variables", https://docs.flowiseai.com/configuration/environment-variables)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Port the Express server listens on. The compose exposes container port
# 3000 with this value as its twin: change one without the other and
# routing breaks.
# @required @type=port
PORT=3000

# Public origin of this instance. Not cosmetic at 3.x: it is the sole
# allowed CORS origin for the session-issuing endpoints (/auth/login,
# /auth/refreshtoken, /account/register), it is what makes session cookies
# `Secure` when it starts with https, and it is the base for the invite,
# email-verification and password-reset links Flowise mails out, which throw
# outright if it is unset. Platform-owned: otterdeploy resolves it to this
# service's own https domain.
# @required @type=url
# @docs("Auth: Application", https://docs.flowiseai.com/configuration/authorization/app-level)
APP_URL=${{stack.flowise.PUBLIC_URL}}

# Directory holding database.sqlite when DATABASE_TYPE is unset/sqlite.
# Sits inside the compose's flowise-data volume (mounted on /home/node).
# Point it outside and the flows stop surviving a redeploy.
DATABASE_PATH=/home/node/.flowise

# Directory holding encryption.key plus the auto-generated auth secrets
# (token_hash_secret.key, express_session_secret.key, jwt_*_secret.key).
# Must be on the persistent volume: losing this directory makes every
# stored credential undecryptable and logs every session out.
SECRETKEY_PATH=/home/node/.flowise

# Where uploaded files, images and chat attachments land when
# STORAGE_TYPE is local (the default). Defaults to $HOME/.flowise/storage;
# the compose states it so it is visibly on the persistent volume. Created
# recursively, so a missing parent is fine here.
BLOB_STORAGE_PATH=/home/node/.flowise/storage

# Directory for server.log / server-error.log / the request jsonl. On the
# volume so a restart does not lose the trail, but ONE LEVEL UP from
# .flowise on purpose: logger.ts creates this directory non-recursively at
# module load, before anything has created .flowise, so nesting it there
# bricks the first boot of a fresh volume.
LOG_PATH=/home/node/logs

# Winston level for both file and console transports.
# @type=enum(error, warn, info, verbose, debug)
LOG_LEVEL=info

# "true" adds a console transport (and console exception/rejection
# handlers) on top of the log files. Verbose; leave off in production.
# @type=boolean
DEBUG=false

# Request-log redaction. BOTH DEFAULT TO EMPTY, i.e. Flowise redacts
# NOTHING from logged request bodies and headers out of the box. Set them,
# or passwords, bearer tokens and provider API keys land in server.log in
# clear text. The values upstream recommends are:
# "password,pwd,pass,secret,token,apikey,api_key,accesstoken,access_token,
#  refreshtoken,refresh_token,clientsecret,client_secret,privatekey,
#  private_key,secretkey,secret_key,auth,authorization,credential,credentials"
# and "authorization,x-api-key,x-auth-token,cookie".
LOG_SANITIZE_BODY_FIELDS=
LOG_SANITIZE_HEADER_FIELDS=

# Forces the Node.js runtime mode. Leave unset/development-neutral unless
# you terminate TLS in front: at NODE_ENV=production Flowise hard-forces
# `Secure` session cookies and ignores SECURE_COOKIES entirely, so a plain
# HTTP instance can never complete a login.
# @type=enum(production, development)
NODE_ENV=

# ─── Who can get in ──────────────────────────────────────────────────────
# There is NO env-var admin login at 3.1.4. On first visit Flowise serves
# a registration page and whoever submits it becomes the organisation
# owner, so between `deploy` and your own sign-up, anyone who can reach
# the port can claim the instance and, from there, read every credential,
# flow and stored LLM API key it will ever hold. Register immediately, or
# keep the port private until you have. Setting FLOWISE_USERNAME /
# FLOWISE_PASSWORD (the pre-3.0.1 mechanism, still shown by some blog
# posts) does nothing whatsoever at this version.

# Password hashing cost factor for account passwords (bcrypt rounds).
# @type=number
# @docs("Auth: Application", https://docs.flowiseai.com/configuration/authorization/app-level)
PASSWORD_SALT_HASH_ROUNDS=10

# Access-token lifetime in minutes; a refresh token silently renews it.
# @type=number
JWT_TOKEN_EXPIRY_IN_MINUTES=60

# Refresh-token lifetime in minutes. Code default is 129600 (90 days);
# docker/.env.example ships 43200 (30 days).
# @type=number
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=129600

# Signing/validation secrets and claims for the session JWTs. Leave EMPTY:
# initAuthSecrets() generates 32 random bytes for each on first boot and
# persists them under SECRETKEY_PATH, which is stronger than anything typed
# here. Supplying one of the historical weak defaults ("flowise",
# "popcorn", "AABBCC…") is detected and ignored. Set them only to share one
# session realm across several Flowise instances.
# @sensitive
JWT_AUTH_TOKEN_SECRET=
# @sensitive
JWT_REFRESH_TOKEN_SECRET=
# @sensitive
EXPRESS_SESSION_SECRET=
# Secret used to hash invite / password-reset tokens before storage.
# @sensitive
TOKEN_HASH_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Forces the `Secure` flag on session cookies on or off. Only consulted
# when NODE_ENV is not "production"; otherwise Secure is unconditional.
# Unset falls back to "is APP_URL https?".
# @type=boolean
SECURE_COOKIES=

# "true" skips the persistent session store entirely and keeps sessions in
# process memory, so a restart logs everyone out. Normally a development
# convenience; here it is REQUIRED, and the compose sets it. The published
# flowiseai/flowise:3.1.4 image is built with `npm install -g flowise`,
# which ignores the repo lockfile's connect-sqlite3 0.9.15 and resolves the
# `^0.9.15` range to 0.9.17 (published 2026-07-13, two weeks before the
# image). 0.9.17 expects `options.db` to be an open Database; Flowise still
# passes a filename, so the SQLite session store throws
# "TypeError: this.db.exec is not a function" and the container exits 1 on
# every boot. Reproduced against the pinned digest. Setting this to "false"
# again is only safe once you move to DATABASE_TYPE=postgres/mysql (their
# session stores are unaffected) or upstream re-pins the dependency.
# @required @type=boolean
EXPIRE_AUTH_TOKENS_ON_RESTART=true

# Lifetime of a workspace-invite token, and of a password-reset token.
# Note the spelling: the ..._IN_MINS form printed in .env.example is not
# what the code reads.
# @type=number
INVITE_TOKEN_EXPIRY_IN_HOURS=24
# @type=number
PASSWORD_RESET_TOKEN_EXPIRY_IN_MINUTES=15

# Absolute path to a custom Handlebars template for the workspace-invite
# email, replacing the built-in one.
WORKSPACE_INVITE_TEMPLATE_PATH=

# ─── Credential encryption ───────────────────────────────────────────────

# The AES key that encrypts every credential you store in Flowise:
# OpenAI/Anthropic keys, database passwords, OAuth secrets. Leave EMPTY and
# Flowise generates one on first boot into SECRETKEY_PATH/encryption.key,
# which the volume already persists. Set it ONLY if you must hold the key
# outside the volume, and then treat it as irreversible: changing it, or
# losing the value while credentials exist, makes every stored credential
# permanently undecryptable. They cannot be recovered, only re-entered.
# @sensitive
# @docs("Credentials & encryption key", https://docs.flowiseai.com/configuration/environment-variables)
FLOWISE_SECRETKEY_OVERWRITE=

# "aws" reads the encryption key and the auth secrets from AWS Secrets
# Manager instead of SECRETKEY_PATH; "local" (default) uses the filesystem.
# @type=enum(local, aws)
SECRETKEY_STORAGE_TYPE=local

# Only read when SECRETKEY_STORAGE_TYPE=aws. NAME is the secret id holding
# the encryption key; AUTH_PREFIX prefixes the derived auth-secret ids
# (e.g. "Flowise" -> FlowiseTokenHashSecret). Leave the AWS credentials
# empty to use the instance role.
# @sensitive
SECRETKEY_AWS_ACCESS_KEY=
# @sensitive
SECRETKEY_AWS_SECRET_KEY=
SECRETKEY_AWS_REGION=
SECRETKEY_AWS_NAME=
SECRETKEY_AWS_AUTH_PREFIX=

# ─── External database ───────────────────────────────────────────────────

# Empty or "sqlite" keeps the embedded SQLite file at DATABASE_PATH, which
# is what this template ships. Set a server type and the DATABASE_PATH
# volume stops being the source of truth; migrate before switching.
# @type=enum(sqlite, mysql, mariadb, postgres)
# @docs("Databases", https://docs.flowiseai.com/configuration/databases)
DATABASE_TYPE=
DATABASE_HOST=
# Defaults to 3306 for mysql/mariadb and 5432 for postgres.
# @type=port
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
# @sensitive
DATABASE_PASSWORD=
# "true" opens the connection over TLS.
# @type=boolean
DATABASE_SSL=false
# Base64-encoded PEM CA/client certificate for that TLS connection; takes
# precedence over DATABASE_SSL.
# @sensitive
DATABASE_SSL_KEY_BASE64=
# Only consulted when DATABASE_SSL_KEY_BASE64 is set, and only "true"
# counts: unset means Flowise does NOT verify the database certificate
# against the CA you supplied. Set it explicitly to "true" if you want that
# verification.
# @type=boolean
DATABASE_REJECT_UNAUTHORIZED=false

# ─── File storage ────────────────────────────────────────────────────────

# Where uploads live. "local" writes to BLOB_STORAGE_PATH on the volume;
# the other three need the matching block below filled in.
# @type=enum(local, s3, gcs, azure)
STORAGE_TYPE=local

# S3 (or any S3-compatible endpoint). S3_ENDPOINT_URL + S3_FORCE_PATH_STYLE
# are what make MinIO/R2/Wasabi work.
S3_STORAGE_BUCKET_NAME=
# @sensitive
S3_STORAGE_ACCESS_KEY_ID=
# @sensitive
S3_STORAGE_SECRET_ACCESS_KEY=
S3_STORAGE_REGION=
# @type=url
S3_ENDPOINT_URL=
# @type=boolean
S3_FORCE_PATH_STYLE=false

# Google Cloud Storage: path to a service-account key file mounted into the
# container, plus project and bucket.
GOOGLE_CLOUD_STORAGE_CREDENTIAL=
GOOGLE_CLOUD_STORAGE_PROJ_ID=
GOOGLE_CLOUD_STORAGE_BUCKET_NAME=
# Read as Boolean(process.env.…) at 3.1.4, so it is a presence flag, not a
# boolean: unset/empty is false and ANY non-empty value, including the
# string "false", turns uniform bucket-level access on.
# @type=boolean
GOOGLE_CLOUD_UNIFORM_BUCKET_ACCESS=

# Azure Blob Storage: supply EITHER the connection string OR the account
# name + key pair.
# @sensitive
AZURE_BLOB_STORAGE_CONNECTION_STRING=
AZURE_BLOB_STORAGE_ACCOUNT_NAME=
# @sensitive
AZURE_BLOB_STORAGE_ACCOUNT_KEY=
AZURE_BLOB_STORAGE_CONTAINER_NAME=

# ─── Code execution in custom tools ──────────────────────────────────────

# A Custom Tool is JavaScript a flow author writes and the server runs, in
# a NodeVM whose module allowlist these three knobs widen. Everything here
# is "who may run what inside my container": only loosen it if every
# account that can edit a flow is one you would give a shell to.

# Extra Node.js BUILT-IN modules the tool sandbox may require, on top of
# the always-allowed assert, buffer, crypto, events, path, querystring,
# timers, url, zlib. Adding "fs" or "child_process" here is equivalent to
# handing flow authors the filesystem / a shell. "*" allows all of them.
# @docs("Custom Tool", https://docs.flowiseai.com/integrations/langchain/tools/custom-tool)
TOOL_FUNCTION_BUILTIN_DEP=

# Extra NPM packages the sandbox may require, comma separated (axios and
# node-fetch are always available). The recommended way to widen the
# sandbox (narrower than ALLOW_BUILTIN_DEP).
TOOL_FUNCTION_EXTERNAL_DEP=

# "true" exposes EVERY dependency Flowise itself bundles (pg, mysql2,
# mongodb, typeorm, puppeteer, playwright, ioredis, …) to custom tool code
# in one go. Effectively arbitrary code execution by anyone who can save a
# flow; prefer TOOL_FUNCTION_EXTERNAL_DEP.
# @type=boolean
ALLOW_BUILTIN_DEP=false

# With an E2B key set, Python/JS interpreter nodes run in E2B's remote
# sandbox instead of in this container, the safer placement for untrusted
# generated code. Empty means the in-process NodeVM is used.
# @sensitive
# @docs("Code Interpreter by E2B", https://docs.flowiseai.com/integrations/langchain/tools/python-interpreter)
E2B_APIKEY=

# Wall-clock cap in milliseconds on a single sandboxed execution. The code
# default is 300000 (5 minutes) when unset.
# @type=number
SANDBOX_TIMEOUT=

# Hard cap on agent tool-calling loops and on Loop-node iterations, so a
# runaway flow cannot bill your provider forever.
# @type=number
MAX_ITERATIONS=1000
# @type=number
MAX_LOOP_COUNT=10

# Floor, in seconds, on how often a scheduled flow may fire.
# @type=number
MIN_SCHEDULE_INTERVAL_SECONDS=60

# ─── Custom MCP servers ──────────────────────────────────────────────────

# "false" DISABLES validation of Custom MCP server configs and, per
# upstream's own warning, allows arbitrary command execution. Keep it on.
# @type=boolean
# @docs("MCP security variables", https://docs.flowiseai.com/configuration/environment-variables)
CUSTOM_MCP_SECURITY_CHECK=true

# Only the literal "stdio" makes Flowise spawn local MCP processes; any
# other value (including unset, which is the real default at 3.1.4,
# contrary to the docs table) forces remote SSE/HTTP MCP servers only.
# "stdio" means flow authors can start processes in this container, which
# is why 3.1.4 also requires the two allowlists below before anything will
# actually run.
# @type=enum(stdio, sse)
CUSTOM_MCP_PROTOCOL=

# Allowlist of commands a stdio MCP config may execute. EMPTY = NONE
# ALLOWED, which is the 3.1.4 default and the fix for GHSA-vcwp-f9rq-3887
# (npx package execution as authenticated RCE). Only add what you need,
# from node|npx|python|python3|docker.
CUSTOM_MCP_ALLOWED_COMMANDS=

# Allowlist of absolute script paths a stdio MCP config may run. Empty =
# none allowed. Only list scripts you control; a wrong entry here is
# arbitrary code execution.
CUSTOM_MCP_ALLOWED_ABSOLUTE_SCRIPT_PATHS=

# Comma-separated names of environment variables a stdio MCP config is
# permitted to set on the child process (e.g. BRAVE_API_KEY). Empty = none.
CUSTOM_MCP_ALLOWED_ENV_VARS=

# Cap on the serialized tools payload an MCP server may return, in bytes
# (default 524288), and on the handshake, in ms (default 15000, floor
# 1000). Both exist to stop a hostile MCP server hanging or flooding the
# authorize step.
# @type=number
CUSTOM_MCP_TOOLS_MAX_BYTES=524288
# @type=number
CUSTOM_MCP_AUTHORIZE_TIMEOUT_MS=15000

# Caps on MCP tool names and descriptions before they reach the LLM, the
# prompt-injection surface an untrusted MCP server gets to write into.
# @type=number
CUSTOM_MCP_TOOL_NAME_MAX_LENGTH=128
# @type=number
CUSTOM_MCP_TOOL_DESCRIPTION_MAX_LENGTH=1024

# ─── Network exposure ────────────────────────────────────────────────────

# Comma-separated origins allowed to call the API from a browser. Empty
# means same-origin only; "*" allows any page on the internet to script
# your endpoints. The session endpoints ignore "*" and honour APP_URL.
# @docs("Environment Variables", https://docs.flowiseai.com/configuration/environment-variables)
CORS_ORIGINS=

# "true" sends Access-Control-Allow-Credentials. Flowise refuses to combine
# it with CORS_ORIGINS=* and forces it back to false, with a warning.
# @type=boolean
CORS_ALLOW_CREDENTIALS=false

# Separate allowlist for the /mcp endpoint. When empty, only requests with
# no Origin header (server-to-server) reach it.
MCP_CORS_ORIGINS=

# CSP frame-ancestors for the embedded chat widget. Defaults to 'self';
# "*" lets any site frame your instance (clickjacking, fixed in 3.1.3).
IFRAME_ORIGINS=

# How Express interprets X-Forwarded-For. Unset/"true" trusts every proxy
# in the chain: fine behind otterdeploy's own proxy, wrong if the port is
# also reachable directly, since a client can then forge its own IP for
# rate limiting. A number trusts exactly that many hops.
# @docs("Rate Limit", https://docs.flowiseai.com/configuration/rate-limit)
TRUST_PROXY=true

# SSRF guard on outbound HTTP from nodes and MCP servers: blocks a built-in
# list of dangerous destinations (link-local metadata, loopback). "false"
# turns the whole check off. HTTP_DENY_LIST adds your own hosts/URLs,
# comma separated.
# @type=boolean
HTTP_SECURITY_CHECK=true
HTTP_DENY_LIST=

# "false" disables the guard against path traversal in file and folder
# inputs. Keep it on.
# @type=boolean
PATH_TRAVERSAL_SAFETY=true

# "false" disables validation of OAuth2 token endpoints;
# OAUTH2_ALLOWED_TOKEN_DOMAINS adds trusted IdP domains (comma separated,
# e.g. keycloak.mycompany.com) instead of switching the check off.
# @type=boolean
# @docs("SSO", https://docs.flowiseai.com/configuration/sso)
OAUTH2_SECURITY_CHECK=true
OAUTH2_ALLOWED_TOKEN_DOMAINS=

# Comma-separated API paths to REMOVE from the unauthenticated allowlist
# (the routes reachable without a session, e.g. the public chatbot
# endpoints). Use it to shut off public prediction on a private instance.
# @docs("Auth: Flows", https://docs.flowiseai.com/configuration/authorization/flows)
DENYLIST_URLS=

# ─── Email (invites, verification, password reset) ───────────────────────
# Without a working SMTP block, account invites, email verification and
# password resets cannot be delivered. On a single-admin instance that
# means a forgotten password is unrecoverable.

# @docs("Auth: Application", https://docs.flowiseai.com/configuration/authorization/app-level)
SMTP_HOST=
# @type=port
SMTP_PORT=
SMTP_USER=
# @sensitive
SMTP_PASSWORD=
# "true" for implicit TLS (usually port 465); false upgrades with STARTTLS.
# @type=boolean
SMTP_SECURE=
# "true" accepts a self-signed SMTP certificate.
# @type=boolean
ALLOW_UNAUTHORIZED_CERTS=false
# From: address on every message Flowise sends.
# @type=email
SENDER_EMAIL=

# ─── Nodes & limits ──────────────────────────────────────────────────────

# "true" surfaces community-contributed nodes in the palette. Off by
# default: those nodes are third-party code running in your container.
# @type=boolean
SHOW_COMMUNITY_NODES=false

# Comma-separated node names to remove from the palette entirely, e.g.
# "bufferMemory,chatOpenAI". The blunt way to keep a shared instance away
# from a node you do not want executed.
DISABLED_NODES=

# Absolute path to a models.json inside the container that replaces the
# built-in model catalogue shown in the UI.
MODEL_LIST_CONFIG_JSON=

# Body-size ceiling for JSON and form uploads, as an express `limit`
# string (e.g. "50mb").
FLOWISE_FILE_SIZE_LIMIT=50mb

# ─── Queue mode ──────────────────────────────────────────────────────────

# "queue" splits execution into a main process plus separate worker
# containers over Redis/BullMQ. This template runs the single-container
# "main" mode, so everything below is inert unless you add workers.
# @type=enum(main, queue)
# @docs("Running Flowise using Queue", https://docs.flowiseai.com/configuration/running-flowise-using-queue)
MODE=main
QUEUE_NAME=flowise-queue
# @type=number
WORKER_CONCURRENCY=100000
# @type=number
QUEUE_REDIS_EVENT_STREAM_MAX_LEN=10000
# Seconds / count after which finished jobs are trimmed; -1 keeps them.
# @type=number
REMOVE_ON_AGE=-1
# @type=number
REMOVE_ON_COUNT=-1

# Redis connection for queue mode. REDIS_URL, when set, supersedes the
# host/port/username/password quartet.
# @sensitive
REDIS_URL=
REDIS_HOST=
# @type=port
REDIS_PORT=6379
REDIS_USERNAME=
# @sensitive
REDIS_PASSWORD=
# @type=boolean
REDIS_TLS=false
# PEM contents (not paths) for a TLS Redis connection.
# @sensitive
REDIS_CERT=
# @sensitive
REDIS_KEY=
REDIS_CA=
# @type=number
REDIS_KEEP_ALIVE=

# "true" mounts the BullMQ dashboard at /admin/queues. It shows job
# payloads (i.e. prompts and their data), so only enable it while
# debugging.
# @type=boolean
ENABLE_BULLMQ_DASHBOARD=false

# ─── LangSmith tracing ───────────────────────────────────────────────────
# Setting the flag plus an API key streams every run (prompts, tool calls
# and completions) to LangSmith. Read once at first use and cached for the
# process lifetime, so a change needs a restart.

# @type=boolean
# @docs("Analytics", https://docs.flowiseai.com/using-flowise/analytics)
LANGSMITH_TRACING=false
# @sensitive
LANGSMITH_API_KEY=
# @type=url
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=

# Legacy names for the same four, read as fallbacks.
# @type=boolean
LANGCHAIN_TRACING_V2=false
# @sensitive
LANGCHAIN_API_KEY=
# @type=url
LANGCHAIN_ENDPOINT=
LANGCHAIN_PROJECT=

# ─── Metrics ─────────────────────────────────────────────────────────────

# "true" turns on the metrics exporter; anything else leaves it off.
# @type=boolean
# @docs("Running in Production", https://docs.flowiseai.com/configuration/running-in-production)
ENABLE_METRICS=false
# Unset behaves as prometheus (scrape endpoint on the app port).
# @type=enum(prometheus, open_telemetry)
METRICS_PROVIDER=prometheus
# "false" drops the default process/heap metrics from the export.
# @type=boolean
METRICS_INCLUDE_NODE_METRICS=true
METRICS_SERVICE_NAME=FlowiseAI
# Only read when METRICS_PROVIDER=open_telemetry.
# @type=url
METRICS_OPEN_TELEMETRY_METRIC_ENDPOINT=
# @type=enum(http, grpc, proto)
METRICS_OPEN_TELEMETRY_PROTOCOL=http
# @type=boolean
METRICS_OPEN_TELEMETRY_DEBUG=false

# Product-analytics key for Flowise's own PostHog project. Leave empty; an
# empty value is how you keep usage events from being emitted at all.
# @sensitive
POSTHOG_PUBLIC_API_KEY=

# ─── Outbound proxy ──────────────────────────────────────────────────────
# Consumed by the `global-agent` bootstrap the server imports, not by
# Flowise code, so they route ALL outbound HTTP (every LLM provider, every
# loader) through a corporate proxy. HTTP_PROXY/HTTPS_PROXY are ignored;
# the GLOBAL_AGENT_ prefix is required.

# @type=url
# @docs("Running Flowise behind company proxy", https://docs.flowiseai.com/configuration/running-flowise-behind-company-proxy)
GLOBAL_AGENT_HTTP_PROXY=
# @type=url
GLOBAL_AGENT_HTTPS_PROXY=
GLOBAL_AGENT_NO_PROXY=

# ─── Enterprise edition ──────────────────────────────────────────────────
# Unset, Flowise runs its open-source feature set. A key unlocks SSO,
# workspaces and RBAC and makes the instance phone home to LICENSE_URL.

# @sensitive
# @docs("SSO", https://docs.flowiseai.com/configuration/sso)
FLOWISE_EE_LICENSE_KEY=
# @type=url
LICENSE_URL=
# "true" skips the license check for an air-gapped deployment.
# @type=boolean
OFFLINE=false

# ─── Misc ────────────────────────────────────────────────────────────────

# Base URL written into exported chatflow bundles. Falls back to
# http://localhost:${PORT}; set it to the same value as APP_URL if exports
# need to be shareable.
# @type=url
BASE_URL=
