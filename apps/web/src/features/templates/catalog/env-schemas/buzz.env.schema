# Buzz relay 0.2.1 environment schema (@env-spec / varlock format).
#
# The template used to pin the floating tag `ghcr.io/block/buzz:main`. On
# 2026-09-03 (research date) the newest STABLE relay release is 0.2.1: git tag
# `relay-v0.2.1` (crates/buzz-relay/Cargo.toml `version = "0.2.1"`), and the
# single digest sha256:4e31b7c7abb7d00b6f513dc559e58d2b980416f1dc400aa01bcf762cf2989cfc
# that ghcr's `0`, `0.2`, `0.2.1` and `latest` tags all point at. `main` is the
# rolling per-commit tag and a different digest. The compose now pins 0.2.1.
#
# Source: grep of `std::env::var(...)` across crates/ at relay-v0.2.1. The
# relay has no config file: crates/buzz-relay/src/config.rs reads the whole
# configuration from the environment, with a handful more in main.rs (startup,
# background tasks), storage_sweep.rs, telemetry.rs, mesh_boot.rs, nip11.rs,
# buzz-db/relay_members.rs and buzz-workflow/executor.rs. Keys that only the
# CLI, desktop, mobile, admin, pair-relay, push-gateway or test binaries read
# are deliberately absent: this image runs the relay.
#
# Cross-checked against deploy/compose/.env.example, which is wrong in two
# ways at this version. It advertises `BUZZ_MEDIA_SERVER_DOMAIN`, which no
# code at relay-v0.2.1 reads (only a benchmark harness sets it). Omitted
# here. And it stops at about twenty keys, so every knob below the S3 block is
# undocumented upstream.
#
# Two traps worth knowing before you fill anything in. (1) With
# BUZZ_REQUIRE_AUTH_TOKEN unset (its default is false) and no
# BUZZ_RELAY_PRIVATE_KEY, the relay boots on a HARDCODED dev keypair
# (private key 0x00…01, main.rs) and REST calls skip token auth. A public
# deployment must set both. (2) `BUZZ_REPLICA_HEAD_MAX_AGE_SECS` was renamed
# to BUZZ_REPLICA_READ_MAX_AGE_MS; the old name is a hard startup error, not
# an alias, so it is not declared here. `BUZZ_REQUIRE_MEDIA_GET_AUTH` and
# `BUZZ_REQUIRE_MEDIA_READ_AUTH` are inert since #4610 (media reads always
# require Blossom auth) and only produce a warning; neither is declared here.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Buzz Docker Compose deployment guide", https://github.com/block/buzz/blob/relay-v0.2.1/deploy/compose/README.md)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Address the relay's HTTP + WebSocket listener binds inside the container.
# The compose exposes container port 3000, so the port here is that port's
# twin: change one without the other and nothing routes.
# @required
BUZZ_BIND_ADDR=0.0.0.0:3000

# Plain-HTTP port serving `/_liveness` and `/_readiness`, separate from the
# main listener so a saturated relay still answers probes. Upstream's
# healthcheck talks to it over /dev/tcp because the runtime image ships no
# curl.
# @required @type=port
BUZZ_HEALTH_PORT=8080

# Prometheus scrape port (`/metrics`), also on its own listener.
# @required @type=port
BUZZ_METRICS_PORT=9102

# Public WebSocket URL clients dial, advertised in the NIP-11 document and
# used to derive which community a request resolves to. The code falls back
# to ws://localhost:3000, which is only correct for a laptop. Set your own
# wss:// origin before inviting anyone.
# @type=url
RELAY_URL=

# Extra Unix domain socket to accept connections on, alongside the TCP bind.
# Empty disables it. Only useful when something else in the same container
# namespace speaks to the relay without TCP.
BUZZ_UDS_PATH=

# Comma-separated origins allowed to call the REST API from a browser. Empty
# (the default) permits none, which is right when only the desktop/mobile
# apps talk to this relay and wrong the moment you host the web client.
BUZZ_CORS_ORIGINS=

# Directory of a prebuilt web client to serve as static files. Startup fails
# if the path exists but has no index.html. Empty serves no web UI.
BUZZ_WEB_DIR=

# Serves the built-in git web browser at /git. Off by default; it exposes
# repository contents to anyone who can reach the relay.
# @type=boolean
BUZZ_SERVE_GIT_WEB_GUI=false

# Exact host authority (no scheme, no path) that routes to the moderation
# admin surface, e.g. admin.example.com. Empty disables the admin host
# entirely. A value containing / \ or @ is a startup error.
BUZZ_ADMIN_HOST=

# Directory of the prebuilt admin SPA, only read when BUZZ_ADMIN_HOST is set.
# Must contain index.html or startup fails.
BUZZ_ADMIN_WEB_DIR=

# ─── Bundled Postgres ────────────────────────────────────────────────────
# The compose runs postgres:17-alpine as a sibling service. DATABASE_URL below
# hardcodes the `buzz` role and `buzz` database, so changing POSTGRES_USER or
# POSTGRES_DB alone leaves the relay pointing at a role that does not exist.

# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
# @required
POSTGRES_DB=buzz
# @required
POSTGRES_USER=buzz
# Generated at install; also the password embedded in DATABASE_URL.
# @required @sensitive
POSTGRES_PASSWORD=

# PLATFORM-OWNED: the sibling Postgres host is derived, never typed.
# @required @sensitive
DATABASE_URL=postgres://buzz:${POSTGRES_PASSWORD}@${{stack.postgres.HOST}}:5432/buzz

# Optional read-replica connection string. Empty means every read goes to the
# writer, which is what a single-node compose stack wants.
# @sensitive
READ_DATABASE_URL=

# Writer pool size. 50 is sized for a multi-vCPU relay; Postgres' own
# max_connections is the ceiling you actually have to respect.
# @type=number
BUZZ_DB_POOL_SIZE=50

# Reader pool size. Empty (or a non-positive value) means "same as
# BUZZ_DB_POOL_SIZE". Only meaningful with READ_DATABASE_URL set.
# @type=number
BUZZ_DB_READ_POOL_SIZE=

# Milliseconds of replica staleness a read may tolerate before it is routed
# back to the writer. 0 disables bounded-staleness routing, the default and
# the only sane value without a replica. Note the unit: the older
# seconds-denominated name refuses to start.
# @type=number
BUZZ_REPLICA_READ_MAX_AGE_MS=0

# ─── Bundled Redis ───────────────────────────────────────────────────────
# The compose runs redis:7-alpine with `--requirepass ${REDIS_PASSWORD}`;
# Redis takes the password on the command line, not from the environment, so
# REDIS_PASSWORD exists here to be interpolated into that command and into
# REDIS_URL.

# Generated at install. Rotating it means editing both the relay's REDIS_URL
# and the Redis service's own --requirepass, together.
# @required @sensitive
REDIS_PASSWORD=

# PLATFORM-OWNED: the sibling Redis host is derived, never typed. Redis backs
# pub/sub fan-out, presence and rate-limit counters; the relay does not start
# without it.
# @required @sensitive
REDIS_URL=redis://:${REDIS_PASSWORD}@${{stack.redis.HOST}}:6379

# Connections in the Redis pool.
# @type=number
BUZZ_REDIS_POOL_SIZE=16

# ─── Bundled MinIO (media object storage) ────────────────────────────────
# The compose runs MinIO plus a one-shot `mc` job that creates the bucket.
# The relay, MinIO and mc are all handed the SAME credential pair, so the two
# keys below are the operator's single S3 secret for this stack.

# Doubles as MINIO_ROOT_USER. Any non-empty string; MinIO requires at least
# three characters.
# @docs("MinIO root credentials", https://min.io/docs/minio/linux/reference/minio-server/settings/root-credentials.html)
# @required @sensitive
BUZZ_S3_ACCESS_KEY=

# Doubles as MINIO_ROOT_PASSWORD. MinIO requires at least eight characters.
# @required @sensitive
BUZZ_S3_SECRET_KEY=

# PLATFORM-OWNED: the sibling MinIO host is derived, never typed.
# @required @type=url
BUZZ_S3_ENDPOINT=http://${{stack.minio.HOST}}:9000

# path puts the bucket in the URL path; virtual puts it in the hostname.
# Docker DNS resolves `minio`, not `<bucket>.minio`, so the bundled stack
# only works with path. Switch to virtual only when pointing at a provider
# that demands it, and then BUZZ_S3_ENDPOINT is no longer the sibling.
# @required @type=enum(path, virtual)
BUZZ_S3_ADDRESSING_STYLE=path

# Bucket the `mc` init job creates and the relay writes media into. Renaming
# it after first boot orphans everything already uploaded.
# @required
BUZZ_S3_BUCKET=buzz-media

# Region sent with S3 requests. MinIO ignores it; a real S3 provider does
# not. AWS_REGION is the fallback the code reads second.
BUZZ_S3_REGION=us-east-1
AWS_REGION=

# Credentials the MinIO server itself boots with (the same pair as above), so
# the relay's client credentials are by construction the server's.
# @required @sensitive
MINIO_ROOT_USER=${BUZZ_S3_ACCESS_KEY}
# @required @sensitive
MINIO_ROOT_PASSWORD=${BUZZ_S3_SECRET_KEY}

# PLATFORM-OWNED: the one-shot `mc mb` job's alias, in mc's env-var form
# (MC_HOST_<alias>). It is how the bucket gets created before the relay first
# writes to it.
# @docs("mc alias environment variables", https://min.io/docs/minio/linux/reference/minio-mc/mc-alias-set.html)
# @required @sensitive
MC_HOST_local=http://${BUZZ_S3_ACCESS_KEY}:${BUZZ_S3_SECRET_KEY}@${{stack.minio.HOST}}:9000

# ─── Media uploads ───────────────────────────────────────────────────────

# Public base URL clients fetch uploaded media from. Startup FAILS unless it
# ends with `/media` and does not end with a slash. The code's fallback is
# http://localhost:3000/media, so a public deployment must set this to
# https://<your-host>/media or every attachment link points at the browser's
# own machine.
# @type=url
BUZZ_MEDIA_BASE_URL=

# Per-kind upload ceilings, in bytes. Defaults are 50 MiB image, 10 MiB GIF,
# 500 MiB video, 100 MiB file. GIF must be > 0 and <= image or startup fails.
# @type=number
BUZZ_MAX_IMAGE_BYTES=52428800
# @type=number
BUZZ_MAX_GIF_BYTES=10485760
# @type=number
BUZZ_MAX_VIDEO_BYTES=524288000
# @type=number
BUZZ_MAX_FILE_BYTES=104857600

# Writes a per-upload moderation record (the `_uploads/` side channel). Off
# by default. The three knobs are checked for coherence at startup: setting
# an IP header without enabling records, or a port header without an IP
# header, is a hard error rather than a silent no-op.
# @type=boolean
BUZZ_MEDIA_UPLOAD_RECORDS=false
# Header your reverse proxy puts the client IP in, e.g. x-forwarded-for.
# Lowercased when read. Only set behind a proxy you control; a client can
# forge it otherwise.
BUZZ_MEDIA_UPLOAD_IP_HEADER=
# Header carrying the client source port; only recorded alongside the IP.
BUZZ_MEDIA_UPLOAD_PORT_HEADER=

# Upload concurrency. The per-pubkey cap is clamped to the global one, so a
# per-pubkey value above the global is silently the global.
# @type=number
BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS=8
# @type=number
BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS_PER_PUBKEY=2
# @type=number
BUZZ_MEDIA_UPLOADS_PER_MINUTE=30

# Background sweep that reconciles object storage against the database and
# emits storage-usage gauges. Interval and timeout are seconds. Set
# BUZZ_STORAGE_METRICS to `off` to disable the sweep; any other value, or
# unset, leaves it on.
# @type=number
BUZZ_STORAGE_SWEEP_INTERVAL_SECS=3600
# @type=number
BUZZ_STORAGE_SWEEP_TIMEOUT_SECS=120
# @type=number
BUZZ_STORAGE_SWEEP_MAX_OBJECTS=1000000
# @type=enum(on, off)
BUZZ_STORAGE_METRICS=on

# ─── Identity, auth and access control ───────────────────────────────────

# The relay's own 64-hex Nostr secret key. It signs NIP-43 membership events
# and the addressable events that describe this deployment, so it must stay
# stable across restarts and across a redeploy. Leaving it empty is only
# viable in development: the relay then either uses a well-known hardcoded
# dev key (when BUZZ_REQUIRE_AUTH_TOKEN is false) or panics at boot (when it
# is true).
# @docs("Nostr identity and NIP support in Buzz", https://github.com/block/buzz/blob/relay-v0.2.1/NOSTR.md)
# @sensitive @type=string(matches=/^[0-9a-f]{64}$/)
BUZZ_RELAY_PRIVATE_KEY=

# 64-hex Nostr pubkey of the human who owns this relay; bootstrapped as the
# first community owner. An invalid value is warned about and ignored rather
# than rejected, so a typo silently leaves the relay ownerless.
# @type=string(matches=/^[0-9a-f]{64}$/)
RELAY_OWNER_PUBKEY=

# Comma-separated 64-hex pubkeys allowed to call the deployment-admin
# provisioning API. Empty disables community provisioning entirely, which
# is the fail-closed default. Unlike the owner key, an invalid entry here is
# a hard startup error.
RELAY_OPERATOR_PUBKEYS=

# Origin the operator API is served from. REQUIRED whenever
# RELAY_OPERATOR_PUBKEYS is non-empty; the relay refuses to start otherwise.
# @type=url
RELAY_OPERATOR_API_ORIGIN=

# Requires a bearer token on REST API requests. FALSE is the shipped default
# and it means the REST API accepts unauthenticated calls (WebSocket protocol
# auth is unaffected). The relay logs a warning about it at every boot. Set
# true for anything reachable from outside your network.
# @type=boolean
BUZZ_REQUIRE_AUTH_TOKEN=false

# Closed-relay mode: callers must hold a NIP-43 membership event for this
# relay. Setting it true without BUZZ_RELAY_PRIVATE_KEY is a hard startup
# error, because memberships signed with an ephemeral key stop verifying
# after a restart.
# @type=boolean
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false

# Restricts connections to an explicit pubkey allowlist held in the database.
# @type=boolean
BUZZ_PUBKEY_ALLOWLIST=false

# Accepts NIP-OA (OAuth-style) authentication in addition to raw key auth.
# @type=boolean
BUZZ_ALLOW_NIP_OA_AUTH=false

# Writes the moderation/administration audit log. On by default; turning it
# off loses the record of who banned or removed what.
# @type=boolean
BUZZ_AUDIT_ENABLED=true

# Join-gate policy shown before a user can enter. Setting any of the three
# turns the gate on; leaving all three unset means no gate. The two markdown
# values are the document bodies themselves, inline, not paths. Each is
# capped at the relay's policy-size limit.
# @type=boolean
BUZZ_AGE_ATTESTATION_REQUIRED=
BUZZ_TERMS_OF_SERVICE_MARKDOWN=
BUZZ_PRIVACY_POLICY_MARKDOWN=

# How many communities a single owner may host on this relay. Read once and
# cached for the process lifetime; a missing or non-positive value falls back
# to 5.
# @docs("Multi-tenant relay design", https://github.com/block/buzz/blob/relay-v0.2.1/docs/multi-tenant-relay.md)
# @type=number
BUZZ_MAX_COMMUNITIES_PER_OWNER=5

# ─── Rate limits ─────────────────────────────────────────────────────────
# Per-identity quotas, keyed in Redis and scoped per community. Every value
# must be a positive integer; a zero or unparsable value is a startup error
# rather than "unlimited".

# @type=number
BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=60
# @type=number
BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=300
# @type=number
BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=10
# @type=number
BUZZ_RATE_LIMIT_AGENT_STANDARD_MESSAGES_PER_MIN=120
# @type=number
BUZZ_RATE_LIMIT_AGENT_STANDARD_API_CALLS_PER_MIN=600
# @type=number
BUZZ_RATE_LIMIT_AGENT_ELEVATED_MESSAGES_PER_MIN=300
# @type=number
BUZZ_RATE_LIMIT_AGENT_PLATFORM_MESSAGES_PER_MIN=600

# ─── Connection limits ───────────────────────────────────────────────────

# Concurrent WebSocket connections the relay accepts.
# @type=number
BUZZ_MAX_CONNECTIONS=10000
# Concurrent in-flight message handlers.
# @type=number
BUZZ_MAX_CONCURRENT_HANDLERS=1024
# Per-connection outbound queue depth before a client is considered slow.
# @type=number
BUZZ_SEND_BUFFER=1000
# Largest single WebSocket frame accepted, in bytes (512 KiB).
# @type=number
BUZZ_MAX_FRAME_BYTES=524288
# How many times a slow client may overflow its send buffer before it is
# dropped.
# @type=number
BUZZ_SLOW_CLIENT_GRACE_LIMIT=15
# Milliseconds of random delay spread across close frames during a graceful
# drain, so a restart does not reconnect every client at once. 0 (default,
# and what an empty value means) disables jitter; oversized values are
# clamped to leave ten seconds of the hard-drain budget.
# @type=number
BUZZ_DRAIN_JITTER_MS=0

# ─── Git hosting ─────────────────────────────────────────────────────────
# Where bare repositories live inside the container. The compose mounts the
# buzz_git volume exactly here; point it elsewhere and pushes stop surviving
# a restart.
# @docs("Git on object storage", https://github.com/block/buzz/blob/relay-v0.2.1/docs/git-on-object-storage.md)
# @required
BUZZ_GIT_REPO_PATH=/data/git

# Local pack cache directory. Empty puts it at <BUZZ_GIT_REPO_PATH>/.pack-cache.
BUZZ_GIT_PACK_CACHE_PATH=

# Shared secret the git hooks sign their callbacks to the relay with. Must be
# at least 32 characters when set; leaving it empty makes the relay derive an
# ephemeral one, which breaks hook verification across a restart.
# @sensitive @type=string(minLength=32)
BUZZ_GIT_HOOK_HMAC_SECRET=

# Size ceilings in bytes: one pack (500 MiB), one repository (defaults to
# twice the pack limit) and the pack cache (defaults to five times the repo
# limit). Leaving the latter two empty keeps them tied to the first.
# @type=number
BUZZ_GIT_MAX_PACK_BYTES=524288000
# @type=number
BUZZ_GIT_MAX_REPO_BYTES=1048576000
# @type=number
BUZZ_GIT_PACK_CACHE_MAX_BYTES=5242880000
# @type=number
BUZZ_GIT_PACK_CACHE_MAX_CONCURRENT_POPULATIONS=2
# @type=number
BUZZ_GIT_MAX_REPOS_PER_PUBKEY=100
# @type=number
BUZZ_GIT_MAX_CONCURRENT_OPS=20

# One-time conformance probe at startup that races concurrent writers against
# the object-storage backend to prove compare-and-swap works. On by default;
# only the literal string "false" turns it off. It costs a few seconds of
# boot and some S3 requests.
# @type=boolean
BUZZ_GIT_CONFORMANCE_PROBE=true
# @type=number
BUZZ_GIT_PROBE_WRITERS=32
# @type=number
BUZZ_GIT_PROBE_ROUNDS=3

# ─── Migrations ──────────────────────────────────────────────────────────

# Runs the embedded SQLx migrations at startup. Accepts true/1/yes/on;
# anything else, including unset, skips them. Upstream ships it off and
# expects `buzz-admin migrate`; this template turns it on because a fresh
# stack has no other way to get a schema.
# @required @type=boolean
BUZZ_AUTO_MIGRATE=true

# ─── Background tasks ────────────────────────────────────────────────────
# Intervals in seconds. Every one of these has a working default; they exist
# for tuning a busy relay, not for first boot.

# Ephemeral-channel reaper.
# @type=number
BUZZ_REAPER_INTERVAL_SECS=60
# Forces every ephemeral channel to this TTL in seconds, ignoring what the
# client asked for. Empty (or a non-positive value) honours the client. The
# relay warns loudly at boot when it is set.
# @type=number
BUZZ_EPHEMERAL_TTL_OVERRIDE=
# NIP-43 membership reconciliation.
# @type=number
BUZZ_NIP43_RECONCILE_INTERVAL_SECS=60
# Community metadata revalidation. Clamped to 1..=300.
# @type=number
BUZZ_COMMUNITY_REVALIDATE_INTERVAL_SECS=30
# Set to any value to run a one-shot channel reconciliation at startup.
# Presence is what counts, not the content.
BUZZ_RECONCILE_CHANNELS=
# Connection-pool gauge sampling.
# @type=number
BUZZ_POOL_METRICS_INTERVAL_SECS=10
# Usage-metric poller: sampling interval (floored at 5) and how long a gauge
# series survives with no activity.
# @type=number
BUZZ_USAGE_METRICS_INTERVAL_SECS=300
# @type=number
BUZZ_USAGE_METRICS_IDLE_TIMEOUT_SECS=900
# Per-community gauge cardinality. `all` (or empty) emits a series per
# community, which is what makes a metrics bill on a relay hosting thousands
# of them; `off` emits only the aggregate.
# @type=enum(all, off)
BUZZ_USAGE_METRICS_PER_COMMUNITY=all
# NIP-ER reminder scheduler: tick interval and rows per tick.
# @type=number
SPROUT_REMINDER_SCHEDULER_INTERVAL_SECS=10
# @type=number
SPROUT_REMINDER_SCHEDULER_BATCH_LIMIT=100
# How far in the future a scheduled event's not-before may sit, in seconds.
# Default is one year; advertised in the NIP-11 document.
# @type=number
SPROUT_MAX_NOT_BEFORE_DELTA=31536000

# ─── Huddles, mesh and push ──────────────────────────────────────────────

# Whether this relay can serve huddle audio. True suits a single instance;
# a horizontally scaled deployment sets it false on the pods that cannot.
# Only the literal "false" or "0" turn it off.
# @type=boolean
BUZZ_HUDDLE_AUDIO_AVAILABLE=true

# Opt-in clustering. Mesh forms ONLY when this is exactly `on`; absent, `off`
# or anything else keeps single-instance behaviour and binds no extra UDP
# port. Leave empty on a single-node compose stack.
# @type=enum(on, off)
BUZZ_MESH=
# UDP address the mesh binds when enabled. The compose publishes no such
# port, so enabling mesh here also means opening it.
BUZZ_MESH_BIND_ADDR=0.0.0.0:3478
# Address peers should reach this node at, when it differs from the bind
# address (NAT, overlay network). Empty falls back to POD_IP, then to the
# bound address.
BUZZ_MESH_ADVERTISE_ADDR=
# Kubernetes-style downward-API IP, used only to derive the mesh advertise
# address when BUZZ_MESH_ADVERTISE_ADDR is empty.
POD_IP=
# Mesh echo demo endpoint. Diagnostics only.
# @type=boolean
BUZZ_MESH_DEMO_ECHO=false

# Where APNs/FCM deliveries are POSTed. Unset uses Block's hosted gateway at
# push.buzz.xyz; an explicitly EMPTY value disables push entirely, which is
# what a self-hosted relay that does not want to phone home wants.
# @docs("Push gateway deployment", https://github.com/block/buzz/blob/relay-v0.2.1/docs/push-gateway-deployment.md)
# @type=url
BUZZ_PUSH_GATEWAY_DELIVERY_URL=
# Per-delivery timeout in milliseconds. Must be 100..=10000 when set;
# anything outside that range is a startup error.
# @type=number
BUZZ_PUSH_GATEWAY_TIMEOUT_MS=2000
# Key id the relay stamps on push executor tokens, so the gateway can tell
# which signing key to verify against.
BUZZ_PUSH_EXECUTOR_KEY_ID=relay-v1

# WebSocket URL of a dedicated device-pairing relay, when you run one
# separately. Must be ws:// or wss:// if set; empty pairs against this relay.
# @type=url
BUZZ_PAIRING_RELAY_URL=

# ─── Workflow actions ────────────────────────────────────────────────────
# The workflow engine runs in-process and calls the relay's own REST API to
# apply reactions. Defaults point at localhost:3000 inside the container,
# which is correct for the bundled stack.

# @type=url
BUZZ_RELAY_BASE_URL=
# Bearer token those internal calls present. Preferred over BUZZ_RELAY_PUBKEY;
# needed once BUZZ_REQUIRE_AUTH_TOKEN is true.
# @sensitive
BUZZ_API_TOKEN=
# Fallback identity header used only when BUZZ_API_TOKEN is unset.
BUZZ_RELAY_PUBKEY=

# ─── Logging and tracing ─────────────────────────────────────────────────

# Rust tracing filter for the relay's own logs. Upstream's production
# suggestion is
# buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info.
# Empty uses the built-in default filter.
# @docs("EnvFilter directive syntax", https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html)
RUST_LOG=

# Separate filter for the OTLP export layer, so traces can be noisier or
# quieter than stdout. Empty reuses the default.
BUZZ_OTEL_FILTER=

# OTLP collector endpoint. Tracing export is DISABLED unless this is set
# (that single check is the on/off switch).
# @docs("OTLP exporter configuration", https://opentelemetry.io/docs/specs/otel/protocol/exporter/)
# @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=

# service.name on exported spans. Empty falls back to buzz-relay.
OTEL_SERVICE_NAME=buzz-relay
