# AFFiNE 0.27.4 environment schema (@env-spec / varlock format).
#
# The compose now pins ghcr.io/toeverything/affine:0.27.4 (previously the
# floating `stable` tag; digest-verified identical to 0.27.4 on 2026-09-03,
# the research date).
#
# Source: grep of every `env:` entry in
# packages/backend/server/src/**/config.ts (the defineModuleConfig calls that
# generate config.schema.json's documented aliases) at v0.27.4. Cross-checked
# against docs.affine.pro/self-host-affine/references/environment-variables.
# The two agree exactly; nothing the code reads is missing from that page.
#
# Starting at 0.27, env vars are a compatibility layer, not the primary
# config source: upstream's own reference compose
# (docs.affine.pro/self-host-affine/references/docker-compose-yml) now
# configures the public URL through config/config.json's `server.externalUrl`
# instead. This template keeps using AFFINE_SERVER_EXTERNAL_URL because the
# docs confirm every alias below is still read on every boot, with no
# config.json required (otterdeploy's compose doesn't mount one).
#
# env.ts (same version) also reads AFFINE_ENV, DEPLOYMENT_TYPE, SERVER_FLAVOR
# and DEPLOYMENT_PLATFORM, but the reference page explicitly calls these
# "internal build, test, or managed-deployment controls...not a stable
# self-host configuration interface", so they are omitted here.
#
# AFFINE_PRIVATE_KEY is read too (src/base/helpers/config.ts) but the docs
# warn against setting it: affine_migration's self-host-predeploy step
# generates and persists config/private.key on first run, and overwriting it
# can invalidate already-encrypted or already-signed data.

# @defaultSensitive=false @defaultRequired=infer
# @docs("AFFiNE Self-host Environment Variables Guide", https://docs.affine.pro/self-host-affine/references/environment-variables)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# Password for the bundled Postgres `affine` role. Also embedded into
# DATABASE_URL below.
# @required @sensitive
POSTGRES_PASSWORD=

# PLATFORM-OWNED: derived from the sibling Postgres service, never typed.
# Alias for db.datasourceUrl (src/base/prisma/config.ts), the supported way
# to point both the server and the one-shot affine_migration predeploy job
# at Postgres.
# @required @sensitive
DATABASE_URL=postgresql://affine:${POSTGRES_PASSWORD}@${{stack.postgres.HOST}}:5432/affine

# PLATFORM-OWNED: derived from the sibling Redis service. Alias for
# redis.host (src/base/redis/config.ts).
# @required
REDIS_SERVER_HOST=${{stack.redis.HOST}}

# The public URL you open AFFiNE at. Alias for server.externalUrl
# (src/core/config/config.ts), which builds every external/share link the
# server hands out. Empty falls back to `[protocol]://[host][:port]`, which
# is wrong behind a reverse proxy.
# @required @type=url
AFFINE_URL=

# The name the server actually reads for its external URL; the compose passes
# AFFINE_URL through under it, so this is wired, not typed. Set AFFINE_URL.
# @required @type=url
AFFINE_SERVER_EXTERNAL_URL=${AFFINE_URL}

# ─── Bundled Postgres ────────────────────────────────────────────────────
# Fixed by the compose, not operator-editable. Declared because every key
# the compose sets on the bundled Postgres service belongs in this schema.

POSTGRES_USER=affine
POSTGRES_DB=affine
POSTGRES_INITDB_ARGS=--data-checksums

# ─── Server (compatibility aliases) ─────────────────────────────────────
# Read on every boot (src/core/config/config.ts). The compose leaves these
# unset, so the server falls back to its own defaults shown below; override
# only for a non-default deployment shape (subpath, custom listen address).

# @type=boolean
AFFINE_SERVER_HTTPS=false
AFFINE_SERVER_HOST=localhost
# Address the server process listens on inside the container.
LISTEN_ADDR=0.0.0.0
# @type=port
AFFINE_SERVER_PORT=3010
# Subpath if AFFiNE is served under e.g. /affine instead of the domain root.
AFFINE_SERVER_SUB_PATH=

# ─── Redis (advanced) ────────────────────────────────────────────────────
# Only for pointing at Redis infrastructure other than the bundled service;
# the compose leaves all four unset and relies on REDIS_SERVER_HOST above.

# @type=port
REDIS_SERVER_PORT=6379
REDIS_SERVER_USERNAME=
# @sensitive
REDIS_SERVER_PASSWORD=
# First Redis DB index AFFiNE claims; it also uses the next four.
# @type=number
REDIS_SERVER_DATABASE=0

# ─── Indexer ─────────────────────────────────────────────────────────────
# Server-side full-text search. Disabled by default, which matches the
# server's own default (upstream's reference compose sets it to the same
# value explicitly). Enabling it requires a Manticoresearch or Elasticsearch
# endpoint this stack doesn't bundle; leave off unless one is provisioned
# separately.
# @docs("Self-host Indexer Guide", https://docs.affine.pro/self-host-affine/administer/indexer)
# @type=boolean
AFFINE_INDEXER_ENABLED=false
# @type=enum(manticoresearch, elasticsearch)
AFFINE_INDEXER_SEARCH_PROVIDER=manticoresearch
AFFINE_INDEXER_SEARCH_ENDPOINT=http://localhost:9308
# @sensitive
AFFINE_INDEXER_SEARCH_API_KEY=
AFFINE_INDEXER_SEARCH_USERNAME=
# @sensitive
AFFINE_INDEXER_SEARCH_PASSWORD=

# ─── Email ───────────────────────────────────────────────────────────────
# Outgoing mail: invitations, magic links, notifications. AFFiNE boots fine
# without these; those emails just silently never send.

MAILER_SERVERNAME=
MAILER_HOST=
# @type=port
MAILER_PORT=465
MAILER_USER=
# @sensitive
MAILER_PASSWORD=
MAILER_SENDER=AFFiNE Self Hosted <noreply@example.com>
# @type=boolean
MAILER_IGNORE_TLS=false

# ─── Telemetry ───────────────────────────────────────────────────────────
# GA4 Measurement Protocol. Both empty disables it entirely.

GA4_MEASUREMENT_ID=
# @sensitive
GA4_API_SECRET=

# ─── Misc ────────────────────────────────────────────────────────────────

# Endpoint of an external doc-rendering service; empty uses the built-in one.
DOC_SERVICE_ENDPOINT=

# Do not set. affine_migration's predeploy step generates and persists
# config/private.key on first run; overwriting it can invalidate already
# encrypted or already signed data.
# @sensitive
AFFINE_PRIVATE_KEY=
