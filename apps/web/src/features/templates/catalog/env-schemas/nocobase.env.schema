# NocoBase 2.2.6 environment schema (@env-spec / varlock format).
#
# The compose pins nocobase/nocobase:2.2.6, an exact tag (digest
# sha256:3e0299a4…, pushed 2026-09-02), also what `latest` and `2.2` point at
# on the research date. Bumped from this template's prior pin of 1.6.15, which
# was pushed 2025-04-01 and sits on a line that ended at 1.9.63 in June 2026.
# 2.2.6 is taken over the marginally more matured 2.2.5 because it carries a
# security fix: stored XSS in rich-text fields written through the API and
# rendered in display or edit mode (PR #10425).
#
# Source: grep of `process.env.[A-Z0-9_]+` across packages/ at v2.2.6,
# plus the image's own `docker/nocobase/Dockerfile` + `docker-entrypoint.sh`
# (the entrypoint is a shell script and reads several variables of its own).
# Cross-checked against the "Environment Variables" reference (linked below)
# and the repo's `.env.example`.
#
# Three things upstream's own material gets wrong at this version:
#   * `.env.example` and the docs list `LOGGER_BASE_PATH`. No code reads it at
#     2.2.6; the log directory is always `<STORAGE_PATH>/logs`
#     (packages/core/logger/src/config.ts), so it is NOT declared here.
#   * The upstream `docker/app-postgres/docker-compose.yml` sets
#     `ENCRYPTION_FIELD_KEY`. Nothing in the open-source tree reads that name
#     at 2.2.6 (it belongs to a commercial plugin that is not in this image),
#     so it is NOT declared here either.
#   * The docs' install section lists INIT_ROOT_EMAIL / _PASSWORD / _NICKNAME
#     but omits `INIT_ROOT_USERNAME`, which the code does read
#     (plugin-users/src/server/server.ts).
#
# The compose sets APP_KEY, the DB_* connection to the bundled Postgres, and
# TZ. Everything else below is the real configuration surface of the image;
# leaving it blank is a working install.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variables", https://docs.nocobase.com/get-started/installation/env)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# The secret NocoBase signs user tokens (JWT) with. Anyone who knows it can
# mint a token for any user, including root, so treat it as the root password.
# Beware the failure mode at this version: the image is built with an EMPTY
# APP_KEY in its baked .env, and the CLI's initEnv then substitutes the
# hard-coded literal `test-jwt-secret` for any falsy APP_KEY
# (packages/core/cli-v1/src/util.js). The JWT layer only rejects the two
# sample values `your-secret-key` and `test-key`
# (packages/core/auth/src/auth-manager.ts), so an unset APP_KEY does NOT get a
# random key. It silently signs every session with a value published in this
# repo. Set it, keep it secret, keep it stable: changing it invalidates every
# issued token at once and logs everybody out.
# @required @sensitive
# @docs("APP_KEY", https://docs.nocobase.com/get-started/installation/env#app_key)
APP_KEY=

# Uses APP_KEY verbatim as the JWT secret and skips the
# storage/apps/main/jwt_secret.dat fallback entirely. Only ever set by the
# project's own test harness; "true" here means a weak APP_KEY is used with no
# safety net at all.
# @type=boolean
UNSAFE_USE_DEFAULT_JWT_SECRET=

# Lifetime of an issued token. Default `7d`. A UI-side "Token Security Policy"
# (Security > Token policy) supersedes this for most flows; this env value is
# the fallback the JwtService constructs with.
# @docs("Token Security Policy", https://docs.nocobase.com/security/token-policy)
JWT_EXPIRES_IN=

# Runtime mode. The image is built with `APP_ENV=production` in its baked
# .env, so that is the effective default here; `development` turns on debug
# logging and console log formatting and is not meant for a deployed instance.
# @type=enum(production, development)
APP_ENV=production

# Port the Node process listens on INSIDE the container. The image's nginx
# fronts it and is what listens on 80 (the port this compose exposes), so
# changing this also means regenerating the nginx upstream. Leave it alone
# unless you also set NOCOBASE_PROXY_UPSTREAM_PORT to match.
# @type=port
APP_PORT=13000

# Address the Node process binds to inside the container. Default `0.0.0.0`.
APP_HOST=

# Sub-path the app is served under, e.g. `/nocobase/`. Default `/`. Setting it
# also re-prefixes API_BASE_PATH, WS_PATH and PLUGIN_STATICS_PATH at boot, and
# is what the generated nginx config is built around.
APP_PUBLIC_PATH=

# URL prefix for the REST API. Default `/api/`. Prefixed with
# APP_PUBLIC_PATH when that is not `/`.
API_BASE_PATH=

# Absolute API base the browser should call. Empty (the default) means
# same-origin `${APP_PUBLIC_PATH}api/`, which is what a normal reverse-proxy
# deployment wants. Only set this when pages and API sit on different origins,
# and then CORS_ORIGIN_WHITELIST must list the page origin or the login cookie
# is never stored.
# @type=url
API_BASE_URL=

# Comma-separated origins allowed to call the API cross-origin WITH cookies.
# Empty means only same-origin requests are trusted; the sign-in endpoint
# rejects cross-origin requests from origins outside this list with 403.
CORS_ORIGIN_WHITELIST=

# "true" also rejects requests that carry no Origin/Referer header at all
# (curl, server-to-server). Off by default.
# @type=boolean
CORS_DISALLOW_NO_ORIGIN=

# Path the websocket upgrade is served on. Default `/ws`, prefixed by
# APP_PUBLIC_PATH.
WS_PATH=

# Absolute websocket URL handed to the browser. Empty means derive it from the
# page origin; only needed when the socket is served from another host.
WEBSOCKET_URL=

# Max request body size for the koa body parser. Default `10mb`; raise it if
# large attachment uploads are rejected with 413.
REQUEST_BODY_LIMIT=

# Timezone the app and its date handling run in. The compose pins UTC; changing
# it changes how existing date values are interpreted, so pick one and keep it.
TZ=UTC

# Absolute or cwd-relative path of the app storage root (uploads, logs,
# generated nginx config, plugin files). Defaults to `<cwd>/storage`, i.e.
# /app/nocobase/storage, exactly what this compose mounts a volume at. Point
# it elsewhere and the volume stops covering your data.
STORAGE_PATH=

# Where downloaded/uploaded plugin packages live. Defaults to
# `<STORAGE_PATH>/plugins`.
PLUGIN_STORAGE_PATH=

# Comma-separated package-name prefixes the plugin manager will resolve.
# Default `@nocobase/plugin-,@nocobase/plugin-sample-,@nocobase/preset-`;
# extend it only if you install plugins published under your own scope.
PLUGIN_PACKAGE_PREFIX=

# Extra salt mixed into the cache-busting hash of plugin client bundle URLs.
# Empty by default; APP_KEY already contributes to that hash.
# @sensitive
PLUGIN_URL_HASH_SALT=

# ─── Bundled PostgreSQL ───────────────────────────────────────────────────

# Which database driver to use. The compose runs a bundled Postgres 16 and
# pins this to `postgres`; `sqlite` would ignore every DB_* below and use
# DB_STORAGE instead.
# @type=enum(postgres, mysql, mariadb, kingbase, sqlite)
# @docs("DB_DIALECT", https://docs.nocobase.com/get-started/installation/env#db_dialect)
DB_DIALECT=postgres

# Hostname of the bundled Postgres service, resolved by otterdeploy.
DB_HOST=${{stack.db.HOST}}

# @type=port
DB_PORT=5432

DB_DATABASE=nocobase

DB_USER=nocobase

# Password for DB_USER. The compose feeds it the same POSTGRES_PASSWORD the
# bundled Postgres is created with, so the two must always match.
# @required @sensitive
DB_PASSWORD=

# Only used when DB_DIALECT=sqlite: path of the .sqlite file. Defaults to
# `<STORAGE_PATH>/db/nocobase.sqlite`. Irrelevant to this compose.
DB_STORAGE=

# Prefix applied to every table NocoBase creates. Set it BEFORE the first
# install; changing it afterwards makes the app look at a different, empty set
# of tables.
DB_TABLE_PREFIX=

# Postgres schema to use. Empty means the connection's default (`public`).
DB_SCHEMA=

# "true" makes NocoBase name columns/tables in snake_case. Install-time
# decision, same caveat as DB_TABLE_PREFIX.
# @type=boolean
DB_UNDERSCORED=

# "on" prints every SQL statement to the log. Debugging only: very noisy and
# it echoes bound parameters.
DB_LOGGING=

# Timezone offset passed to Sequelize, e.g. `+00:00`. Empty means the driver
# default; TZ above is the setting you normally want.
DB_TIMEZONE=

# Sequelize connection pool. Empty values keep Sequelize's own defaults.
# @type=number
DB_POOL_MAX=
# @type=number
DB_POOL_MIN=
# @type=number
DB_POOL_IDLE=
# @type=number
DB_POOL_ACQUIRE=
# @type=number
DB_POOL_EVICT=
# @type=number
DB_POOL_MAX_USES=

# TLS to the database. Each of these also accepts a `_FILE` twin (the loader
# reads the file's contents when the plain variable is empty), which is how you
# mount a CA as a docker secret. Not needed for the bundled Postgres, which is
# reached over the stack's private network.
DB_DIALECT_OPTIONS_SSL_MODE=
DB_DIALECT_OPTIONS_SSL_CA=
# @sensitive
DB_DIALECT_OPTIONS_SSL_KEY=
DB_DIALECT_OPTIONS_SSL_CERT=
# @type=boolean
DB_DIALECT_OPTIONS_SSL_REJECT_UNAUTHORIZED=

# "on" skips the startup check that the server meets NocoBase's minimum
# (PostgreSQL >= 10). The bundled Postgres 16 passes, so leave it off.
DB_SKIP_VERSION_CHECK=

# Superuser role the bundled postgres:16-alpine container creates on first
# boot, and the account NocoBase connects as (DB_USER above).
POSTGRES_USER=nocobase

# Password for that role. Prompted for by this template and reused as
# DB_PASSWORD. Only read on the Postgres volume's very first boot. Changing
# it later does not change the existing role's password.
# @required @sensitive
POSTGRES_PASSWORD=

# Database created on that first boot; must equal DB_DATABASE.
POSTGRES_DB=nocobase

# ─── Cache ────────────────────────────────────────────────────────────────

# Which cache store the server uses by default. `memory` (the default) needs
# nothing external; `redis` requires CACHE_REDIS_URL and is the setting cluster
# mode expects.
# @type=enum(memory, redis)
# @docs("CACHE_DEFAULT_STORE", https://docs.nocobase.com/get-started/installation/env#cache_default_store)
CACHE_DEFAULT_STORE=memory

# Max number of entries held in the in-process memory cache.
# @type=number
CACHE_MEMORY_MAX=2000

# Redis connection URL, e.g. redis://redis:6379. This compose ships no Redis,
# so it is empty; setting it registers the `redis` store (`REDIS_URL` is read
# as a fallback name for the same thing).
# @sensitive
CACHE_REDIS_URL=
# @sensitive
REDIS_URL=

# ─── First-run admin bootstrap ────────────────────────────────────────────

# Read ONLY while the app installs itself (the first boot against an empty
# database), by `getInstallingData()` in plugin-users. On every later boot they
# are ignored, and even during install the root user is skipped if one already
# exists with that email. Change the password from the UI afterwards; these
# variables cannot rotate it.
# @docs("Temporary Environment Variables", https://docs.nocobase.com/get-started/installation/env#init_root_email)
# @type=email
INIT_ROOT_EMAIL=

# Defaults to `admin123` when unset, a published default on a service exposed
# to the internet. Set it, or change the password immediately after install.
# @sensitive
INIT_ROOT_PASSWORD=

# Login name for that first user. Defaults to `nocobase`. Read by the code but
# absent from the docs' list.
INIT_ROOT_USERNAME=

# Display name for that first user. Defaults to `Super Admin`.
INIT_ROOT_NICKNAME=

# Interface language chosen at install time, e.g. `en-US`, `zh-CN`. INIT_LANG
# is the i18n bootstrap twin read by the server core; both default to `en-US`.
INIT_APP_LANG=
INIT_LANG=

# ─── Clustering & workers ─────────────────────────────────────────────────

# Passed to `pm2 start -i <n>`: `max`, `-1`, or a core count. Empty (default)
# runs a single process. Only enable alongside the cluster-mode plugins. A
# bare multi-process NocoBase misbehaves, and it wants a shared Redis cache.
# @docs("Cluster Mode", https://docs.nocobase.com/cluster-mode)
CLUSTER_MODE=

# Splits HTTP serving from background job processing across containers.
# Empty = this process does both. `!` = serve HTTP only, no background jobs.
# `*` = background jobs only. `topic1,topic2` = only those job topics.
# `-` marks a transient one-shot process. Empty is right for a single node.
WORKER_MODE=

# ─── Outbound request allowlist ───────────────────────────────────────────

# Comma-separated allowlist of targets the SERVER may call out to: workflow
# HTTP Request nodes, custom request buttons, AI providers. Accepts exact IPs,
# CIDRs, exact hostnames, and single-level wildcards (`*.example.com`). When
# empty every http/https target is allowed and only a warning is logged for
# loopback/private/metadata addresses, so an operator who lets untrusted users
# build workflows should set this (it is the SSRF boundary).
# @docs("SERVER_REQUEST_WHITELIST", https://docs.nocobase.com/get-started/installation/env#server_request_whitelist)
SERVER_REQUEST_WHITELIST=

# ─── Logging ──────────────────────────────────────────────────────────────

# Comma-separated sinks. Default `console,dailyRotateFile`; files land in
# <STORAGE_PATH>/logs, i.e. inside the mounted volume.
# @docs("Logger", https://docs.nocobase.com/log-and-monitor/logger)
LOGGER_TRANSPORT=

# Default `info` (`debug` when APP_ENV=development).
# @type=enum(error, warn, info, debug, trace)
LOGGER_LEVEL=

# Default `json` (`console` when APP_ENV=development).
# @type=enum(console, json, logfmt, delimiter)
LOGGER_FORMAT=

# Rotation retention: a count for the plain `file` transport (default 10), or
# a duration like `14d` for `dailyRotateFile` (the default there).
LOGGER_MAX_FILES=

# Max bytes per log file before rotating. Default 20971520 (20 MB).
# @type=number
LOGGER_MAX_SIZE=

# "true" silences the logger entirely.
# @type=boolean
LOGGER_SILENT=

# ─── Telemetry (OpenTelemetry) ────────────────────────────────────────────

# "on" turns on OpenTelemetry collection. Off by default; the exporters
# themselves come from plugins (e.g. the Prometheus one).
# @docs("Telemetry", https://docs.nocobase.com/log-and-monitor/telemetry)
TELEMETRY_ENABLED=

# service.name reported in traces/metrics. Default `nocobase`.
TELEMETRY_SERVICE_NAME=

# Comma-separated metric reader names registered by collector plugins, e.g.
# `console,prometheus`.
TELEMETRY_METRIC_READER=

# Comma-separated trace processor names registered by exporter plugins.
TELEMETRY_TRACE_PROCESSOR=

# ─── File storage ─────────────────────────────────────────────────────────

# Directory the built-in "local" storage writes uploads to. Defaults to
# <STORAGE_PATH>/uploads, inside the mounted volume. An absolute path outside
# the volume is not persisted across a container rebuild.
# @docs("Storage engines", https://docs.nocobase.com/file-manager/storage)
LOCAL_STORAGE_DEST=

# Extra comma-separated directories the local storage engine is allowed to
# serve files from, on top of LOCAL_STORAGE_DEST. Widening this widens what a
# file record can point the download endpoint at.
LOCAL_STORAGE_ALLOWED_ROOTS=

# Lifetime of the signed URL used for temporary file access. Default `10m`;
# the app refuses to start a request if the value is outside 5m–10m.
# @docs("Stable file URL", https://docs.nocobase.com/file-manager/stable-url)
TEMPORARY_FILE_ACCESS_EXPIRES_IN=

# Seed values for the cloud storage engines. They are read only when the
# storage RECORD is first created (each engine's static `defaults()`), so
# editing them later does nothing; change the storage in the UI instead.
# Leave the whole group empty unless you are pre-seeding a cloud bucket.
AWS_S3_REGION=
AWS_S3_BUCKET=
# @sensitive
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
# @type=url
AWS_S3_STORAGE_BASE_URL=

ALI_OSS_REGION=
ALI_OSS_BUCKET=
# @sensitive
ALI_OSS_ACCESS_KEY_ID=
# @sensitive
ALI_OSS_ACCESS_KEY_SECRET=
# @type=url
ALI_OSS_STORAGE_BASE_URL=

TX_COS_REGION=
TX_COS_BUCKET=
# @sensitive
TX_COS_SECRET_ID=
# @sensitive
TX_COS_SECRET_KEY=
# @type=url
TX_COS_STORAGE_BASE_URL=

# ─── Workflow ─────────────────────────────────────────────────────────────

# Caps how many nodes one workflow may contain. Empty = no cap.
# @type=number
# @docs("Loop node", https://docs.nocobase.com/workflow/nodes/loop)
WORKFLOW_NODES_LIMIT=

# Caps iterations of a Loop node. Empty = no cap, so a runaway loop over a
# large collection can pin the worker.
# @type=number
WORKFLOW_LOOP_LIMIT=

# Comma-separated Node module names a workflow JavaScript node may `require`.
# Setting ANY value switches that node off the sandboxed QuickJS/WASM runtime
# onto Node's `vm` with require support, which upstream states is not a
# security boundary: a workflow author then has the container's full Node
# runtime. Leave empty unless every workflow author is trusted as an admin.
# @docs("JavaScript node modules", https://docs.nocobase.com/workflow/nodes/javascript)
WORKFLOW_SCRIPT_MODULES=

# ─── Container entrypoint ─────────────────────────────────────────────────

# Read by the image's docker-entrypoint.sh rather than the app. Truthy makes
# the entrypoint extract the client bundle to storage/dist-client and generate
# the proxy config from it (versioned static assets); the default path just
# runs `nocobase create-nginx-conf`.
# @docs("Docker installation (built-in nginx)", https://docs.nocobase.com/get-started/installation/docker)
NOCOBASE_EXTRACT_CLIENT_ASSETS=

# Which proxy config the entrypoint generates. `nginx` (default) is the one
# actually installed and started in this image; `caddy` only writes a config
# file for an external Caddy and leaves nothing listening on 80, which breaks
# this template's port mapping.
# @type=enum(nginx, caddy)
NOCOBASE_PROXY_PROVIDER=nginx

# Upstream the generated proxy config points at. Defaults are 127.0.0.1 and
# APP_PORT (13000); change them together with APP_PORT or not at all.
NOCOBASE_PROXY_UPSTREAM_HOST=
# @type=port
NOCOBASE_PROXY_UPSTREAM_PORT=

# Base URL client assets are loaded from. Empty lets the entrypoint derive it
# from the extracted bundle's active version (or APP_PUBLIC_PATH); set it only
# when serving the bundle from a real CDN.
# @type=url
CDN_BASE_URL=
