# WordPress 7.1 (image wordpress:7.1.0-apache) environment schema
# (@env-spec / varlock format).
#
# Source: the pinned image itself. The two files that read environment were
# pulled straight out of the 7.1.0-apache manifest
# (digest sha256:5a93c470ae8220fddf71f6ebe3bc94e615ddc2ae4d9810f795b830fb11c41a17,
# linux/amd64) and read verbatim: /usr/local/bin/docker-entrypoint.sh and
# /usr/src/wordpress/wp-config-docker.php, byte-identical to the 7.0.4-apache
# copies and to the repo's master copies at
# https://github.com/docker-library/wordpress/blob/master/latest/php8.3/apache/docker-entrypoint.sh
# and https://github.com/docker-library/wordpress/blob/master/wp-config-docker.php
# Cross-checked with a grep of `getenv(` across the WordPress 7.1 tree shipped
# in the same image (wp-includes/, wp-admin/), which turned up five variables
# core reads on its own that the Docker Hub page never mentions:
# WP_ENVIRONMENT_TYPE and the four "update PHP / update HTTPS" URL overrides.
#
# 7.1.0-apache is WordPress 7.1 on PHP 8.3 + Apache (the tag the Docker
# official-images library currently builds). It is also the ONLY WordPress line
# it builds: the library file lists 7.1.0 and nothing else, which is why the
# previous pin (`wordpress:6-apache`) froze on 2026-05-20 at WordPress 6.9.4.
# api.wordpress.org/core/stable-check marks 6.9.4 "insecure" (6.9.5/6.9.6/6.9.7
# exist upstream but were never published as images) and 6.9.4 predates the
# 7.0.4 security release (CVE-2026-65640, authenticated Author+ RCE via
# Imagick/Ghostscript). 7.0.4 carries that fix but its tags stopped being
# rebuilt when 7.1 shipped, so it would go stale against Debian/PHP CVEs the
# same way. Details: https://wordpress.org/news/2026/08/wordpress-7-0-4-release/
#
# What is FIRST-RUN ONLY (docker-entrypoint.sh, once per volume):
#   * copying WordPress core into /var/www/html, skipped when index.php or
#     wp-includes/version.php already exist. Bumping the image tag therefore
#     does NOT upgrade an existing site; WordPress updates its own core files
#     on the volume from the admin updater.
#   * writing wp-config.php, only when it is missing/empty AND at least one
#     WORDPRESS_* variable is set. The compose sets four, so it is written.
#   * substituting the eight "put your unique phrase here" placeholders with
#     fresh `head -c1m /dev/urandom | sha1sum` values while that copy is made.
#     Those randoms are baked into wp-config.php on the `wordpress-html` volume
#     and are what the site uses whenever the matching variable is unset.
#
# Everything else is honoured on EVERY boot: the generated wp-config.php is
# still full of getenv_docker() calls, so DB settings, the table prefix,
# WORDPRESS_DEBUG, WORDPRESS_CONFIG_EXTRA and any key/salt supplied as a
# variable are re-read on each request and always beat the baked fallback.
#
# getenv_docker() checks `<VAR>_FILE` first, then `<VAR>`, then the default,
# so every WORDPRESS_* item below has a `_FILE` twin (listed together near the
# bottom). Unlike some images, setting both is not an error here: `_FILE` just
# silently wins.
#
# The compose prompts for MYSQL_PASSWORD and MYSQL_ROOT_PASSWORD and threads
# the first into both WORDPRESS_DB_PASSWORD and the bundled MariaDB's own
# MARIADB_PASSWORD.

# @defaultSensitive=false @defaultRequired=infer
# @docs("WordPress Docker image reference", https://hub.docker.com/_/wordpress)
# ---

# ─── Platform prompts ────────────────────────────────────────────────────────

# Password for the `wordpress` database account. Used twice: it initialises the
# bundled MariaDB user, and the compose threads the same value into
# WORDPRESS_DB_PASSWORD below. Changing it after first boot does not change the
# password already stored in the MariaDB data volume.
# @required
# @sensitive
# @docs("MariaDB image reference", https://hub.docker.com/_/mariadb)
MYSQL_PASSWORD=

# Root password for the bundled MariaDB, set when its data directory is first
# initialised. WordPress never uses it; it exists for maintenance and restores.
# @required
# @sensitive
MYSQL_ROOT_PASSWORD=

# ─── Database connection (read by WordPress) ─────────────────────────────────

# DB_HOST in wp-config.php. Derived by the platform from the bundled `db`
# service, with MariaDB's port appended (never typed by the operator). The
# `host:port` form is what WordPress's mysqli connector expects; a
# `host:/path/to/socket` form is also accepted for a unix socket.
# @required
# @docs("wp-config.php: database settings", https://developer.wordpress.org/advanced-administration/wordpress/wp-config/#database-settings)
WORDPRESS_DB_HOST=${{stack.db.HOST}}:3306

# Database account WordPress connects as. Matches MARIADB_USER below; the image
# default if unset is the literal "example username", which cannot connect.
# @required
WORDPRESS_DB_USER=wordpress

# Set by the compose from the MYSQL_PASSWORD prompt. The image default if unset
# is the literal "example password".
# @required
# @sensitive
WORDPRESS_DB_PASSWORD=${MYSQL_PASSWORD}

# Schema WordPress uses. Matches MARIADB_DATABASE below, which is the database
# the bundled MariaDB creates at init.
# @required
WORDPRESS_DB_NAME=wordpress

# DB_CHARSET. The image's own default; utf8mb4 is what WordPress 7 expects for
# full 4-byte Unicode (emoji) support. Only change it for a legacy schema.
# @docs("wp-config.php: database character set", https://developer.wordpress.org/advanced-administration/wordpress/wp-config/#database-character-set)
WORDPRESS_DB_CHARSET=utf8mb4

# DB_COLLATE. Empty is correct in almost all cases: MariaDB then picks the
# collation that goes with the charset above.
WORDPRESS_DB_COLLATE=

# ─── Bundled database (MariaDB) ──────────────────────────────────────────────

# Set on the `db` service by the compose. These are the MariaDB image's own
# bootstrap variables, read once when the data directory is initialised, not
# WordPress configuration. WordPress itself never reads a MARIADB_* variable.
# Database created at first init, and the account WordPress connects as.
MARIADB_DATABASE=wordpress
# Account created at first init; must match WORDPRESS_DB_USER above.
MARIADB_USER=wordpress

# Password for MARIADB_USER, set at init from the MYSQL_PASSWORD prompt. It must
# stay in step with WORDPRESS_DB_PASSWORD or WordPress cannot connect.
# @required
# @sensitive
MARIADB_PASSWORD=${MYSQL_PASSWORD}

# MariaDB's own root account, set at init from the MYSQL_ROOT_PASSWORD prompt.
# @required
# @sensitive
MARIADB_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}

# ─── Authentication keys and salts ───────────────────────────────────────────

# The eight secrets behind AUTH_KEY/SECURE_AUTH_KEY/LOGGED_IN_KEY/NONCE_KEY and
# their four _SALT twins in wp-config.php. They sign login cookies and nonces:
# anyone who knows them can mint a valid session cookie for any user and forge
# nonces, so a shared, copied or leaked value is a full authentication bypass
# with no password needed. Never reuse a set between sites, and never paste a
# value from a tutorial or another install.
#
# Leaving them empty is NOT fatal: the entrypoint substitutes a random sha1 per
# placeholder while it writes wp-config.php, on first run only. Those randoms
# live in wp-config.php on the `wordpress-html` volume, so they survive restarts
# and image bumps, but if that volume is ever lost, rebuilt, or restored from a
# backup taken without it, the site comes up with a brand new set and every
# logged-in user is signed out. Supplying them here is what makes the site
# reproducible and the volume replaceable. Rotating any of them deliberately
# invalidates all existing cookies, which is the recommended response to a
# suspected compromise.
#
# Generate a full set with the WordPress.org secret-key service (64 random
# characters each); it is fine to paste its output one line per variable.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("WordPress.org secret-key service", https://api.wordpress.org/secret-key/1.1/salt/)
WORDPRESS_AUTH_KEY=
# SECURE_AUTH_KEY signs the session cookie sent over HTTPS. See
# WORDPRESS_AUTH_KEY above.
# @required
# @sensitive
# @type=string(minLength=32)
# @docs("wp-config.php: security keys", https://developer.wordpress.org/advanced-administration/wordpress/wp-config/#security-keys)
WORDPRESS_SECURE_AUTH_KEY=
# LOGGED_IN_KEY signs the “is logged in” cookie. See WORDPRESS_AUTH_KEY
# above.
# @required
# @sensitive
# @type=string(minLength=32)
WORDPRESS_LOGGED_IN_KEY=
# NONCE_KEY signs the nonces guarding every admin form and AJAX action. See
# WORDPRESS_AUTH_KEY above.
# @required
# @sensitive
# @type=string(minLength=32)
WORDPRESS_NONCE_KEY=
# AUTH_SALT is the salt paired with AUTH_KEY. See WORDPRESS_AUTH_KEY above.
# @required
# @sensitive
# @type=string(minLength=32)
WORDPRESS_AUTH_SALT=
# SECURE_AUTH_SALT is the salt paired with SECURE_AUTH_KEY. See
# WORDPRESS_AUTH_KEY above.
# @required
# @sensitive
# @type=string(minLength=32)
WORDPRESS_SECURE_AUTH_SALT=
# LOGGED_IN_SALT is the salt paired with LOGGED_IN_KEY. See WORDPRESS_AUTH_KEY
# above.
# @required
# @sensitive
# @type=string(minLength=32)
WORDPRESS_LOGGED_IN_SALT=
# NONCE_SALT is the salt paired with NONCE_KEY. See WORDPRESS_AUTH_KEY above.
# @required
# @sensitive
# @type=string(minLength=32)
WORDPRESS_NONCE_SALT=

# ─── Site behaviour ──────────────────────────────────────────────────────────

# $table_prefix in wp-config.php, the prefix on every core table name, which is
# how several sites can share one database. Re-read on every boot, but it is
# effectively first-run only in practice: change it after install and WordPress
# looks for tables that do not exist and reports itself as not installed. Only
# letters, numbers and underscores.
# @type=string(matches=/^[A-Za-z0-9_]+$/)
# @docs("wp-config.php: table prefix", https://developer.wordpress.org/advanced-administration/wordpress/wp-config/#table-prefix)
WORDPRESS_TABLE_PREFIX=wp_

# WP_DEBUG. Leave EMPTY in production: with it on, PHP notices, warnings, fatal
# errors and failing SQL are printed into the page, which leaks absolute
# filesystem paths, table names, plugin internals and query text to anyone who
# can trigger an error. Note the truthiness trap: wp-config.php evaluates this
# as a PHP boolean, so only "" and "0" are OFF; the string "false" is ON.
# @docs("Debugging in WordPress", https://developer.wordpress.org/advanced-administration/debug/debug-wordpress/)
WORDPRESS_DEBUG=

# Arbitrary PHP, eval()'d inside wp-config.php on every request, for constants
# the image has no dedicated variable for (WP_HOME, WP_SITEURL, WP_MEMORY_LIMIT,
# DISALLOW_FILE_EDIT, …). This is remote code execution by design: whatever is
# written here runs as the web server user with full access to the database and
# the uploads volume, so treat write access to this value as equivalent to
# shell access to the container. Single-line only. Separate statements with
# `;`, e.g. define('WP_MEMORY_LIMIT','256M'); define('DISALLOW_FILE_EDIT',true);
# @docs("wp-config.php reference", https://developer.wordpress.org/advanced-administration/wordpress/wp-config/)
WORDPRESS_CONFIG_EXTRA=

# ─── Docker secrets: _FILE twins ─────────────────────────────────────────────

# getenv_docker() looks up "<VAR>_FILE" before "<VAR>", reads the file at that
# path and strips the trailing newline, so any variable above can be delivered
# as a mounted secret instead of an environment value. If both forms are set the
# _FILE one wins silently. Paths are inside the container.
WORDPRESS_DB_HOST_FILE=
WORDPRESS_DB_USER_FILE=
WORDPRESS_DB_PASSWORD_FILE=
WORDPRESS_DB_NAME_FILE=
WORDPRESS_DB_CHARSET_FILE=
WORDPRESS_DB_COLLATE_FILE=
WORDPRESS_AUTH_KEY_FILE=
WORDPRESS_SECURE_AUTH_KEY_FILE=
WORDPRESS_LOGGED_IN_KEY_FILE=
WORDPRESS_NONCE_KEY_FILE=
WORDPRESS_AUTH_SALT_FILE=
WORDPRESS_SECURE_AUTH_SALT_FILE=
WORDPRESS_LOGGED_IN_SALT_FILE=
WORDPRESS_NONCE_SALT_FILE=
WORDPRESS_TABLE_PREFIX_FILE=
WORDPRESS_DEBUG_FILE=
WORDPRESS_CONFIG_EXTRA_FILE=

# ─── WordPress core environment ──────────────────────────────────────────────

# Read by wp_get_environment_type() in wp-includes/load.php on every request.
# It is core, not the Docker image, so it is absent from the Docker Hub page.
# Plugins and themes branch on it, and anything other than "production" is a
# signal to them that this site is safe to be noisy or destructive on. An
# unrecognised value falls back to "production". A WP_ENVIRONMENT_TYPE constant
# defined via WORDPRESS_CONFIG_EXTRA overrides this variable.
# @type=enum(local, development, staging, production)
# @docs("wp_get_environment_type()", https://developer.wordpress.org/reference/functions/wp_get_environment_type/)
WP_ENVIRONMENT_TYPE=production

# Overrides the "Learn more about updating PHP" link shown in Site Health when
# the container's PHP is out of date. Meant for hosts pointing at their own
# instructions; the _DIRECT_ variant additionally renders a second button that
# only appears when it is set. Same pair exists for the HTTPS notice. All four
# are read on every request; an empty value keeps the WordPress.org default.
# @type=url
# @docs("wp_get_update_php_url()", https://developer.wordpress.org/reference/functions/wp_get_update_php_url/)
WP_UPDATE_PHP_URL=
# Adds a second, host-specific button to the same "update PHP" notice. Renders
# only when set.
# @type=url
WP_DIRECT_UPDATE_PHP_URL=
# Overrides the "Learn more about HTTPS" link in the Site Health HTTPS notice.
# @type=url
WP_UPDATE_HTTPS_URL=
# Adds a second, host-specific button to the HTTPS notice. Renders only when set.
# @type=url
WP_DIRECT_UPDATE_HTTPS_URL=

# ─── Apache runtime ──────────────────────────────────────────────────────────

# The user/group the entrypoint chowns the copied WordPress tree and the
# generated wp-config.php to, and that Apache drops privileges to. Defaults to
# www-data; a leading "#" plus a numeric id is valid Apache syntax and the
# entrypoint strips it before chown. Only change these to line the container up
# with the ownership of an existing bind-mounted html directory.
# @docs("Apache mpm_common: User", https://httpd.apache.org/docs/2.4/mod/mpm_common.html#user)
APACHE_RUN_USER=www-data
# Group half of the pair above; keep the two in step.
APACHE_RUN_GROUP=www-data
