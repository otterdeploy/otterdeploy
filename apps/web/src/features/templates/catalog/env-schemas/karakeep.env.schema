# Karakeep 0.33.2 environment schema (@env-spec / varlock format).
#
# The compose used to float on ghcr.io/karakeep-app/karakeep:release and
# ghcr.io/karakeep-app/karakeep-chrome:release; both are now pinned to what
# those tags resolved to on 2026-09-04 (research date): `release` ==
# `0.33.2` (same digest sha256:b069e430…, GitHub release 2026-08-11) and the
# chrome sidecar `release` == `151.0.7922.47-r1` (sha256:5b19bbb1…). The
# project renamed from Hoarder to Karakeep: github.com/hoarder-app/hoarder now
# redirects to karakeep-app/karakeep, which is the live repo (not archived,
# last push 2026-08-31, 0.33.x cut from it), so this is the CURRENT image
# repo, not the abandoned hoarder one. Meilisearch moved off the floating
# minor tag `v1.53` to the exact `v1.53.1` it pointed at (same digest,
# pushed 2026-08-13). 0.33.1 is a security release: it patched
# GHSA-vc53-r298-c6h6 (SSRF via a DNS-resolution TOCTOU in the crawler),
# GHSA-4vx2-9j8p-jg8v (stored XSS through tag names / `javascript:` URLs in
# the Netscape bookmark export) and GHSA-hjm9-gc55-5hgv (non-constant-time
# comparison of API keys and signed asset tokens), so 0.33.x is taken over
# staying on 0.32.
#
# Source: the zod schema that IS the key list, `allEnv` in
# packages/shared/config.ts at tag v0.33.2, which the app parses over
# `process.env` at import time (`serverConfigSchema.parse(process.env)`), plus
# the three plugin schemas that parse process.env on their own at
# packages/plugins/{search-meilisearch,vectorstore-meilisearch,queue-restate}
# /src/env.ts (every plugin is imported unconditionally by
# packages/shared-server/src/plugins.ts, so their keys are always live).
# Cross-checked against docker/.env.sample and the docs' environment-variables
# table. Where they differ, the code wins:
#
#  - MEILI_ADDR / MEILI_MASTER_KEY are NOT in config.ts at this version; they
#    moved into the meilisearch search plugin, which is what makes them
#    optional-with-empty-default there. Karakeep still refuses to search
#    without MEILI_ADDR (`isConfigured()` is `!!envConfig.MEILI_ADDR`).
#  - MEILI_BATCH_SIZE / MEILI_BATCH_TIMEOUT_MS / MEILI_VECTOR_* exist only in
#    the plugin schemas and are absent from .env.sample and the docs table.
#  - The RESTATE_* block is a whole alternative queue backend that the docs
#    table never mentions; it is dormant unless RESTATE_LISTEN_PORT is set
#    (queue-restate `isConfigured()`), and the default queue is liteque
#    (SQLite in DATA_DIR).
#  - DATABASE_URL does not exist. Karakeep is SQLite-only; the database lives
#    in DATA_DIR on the karakeep-data volume.
#
# The compose sets six variables on the web service (NEXTAUTH_URL,
# NEXTAUTH_SECRET, DATA_DIR, MEILI_ADDR, MEILI_MASTER_KEY, BROWSER_WEB_URL)
# and two on the bundled Meilisearch (MEILI_NO_ANALYTICS, MEILI_MASTER_KEY).
# The chrome sidecar takes no environment at all; its entrypoint supplies
# --no-sandbox and forwards container port 9222 itself.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# The public URL you open Karakeep at, scheme included, no trailing slash
# (the app strips one if present). Every sign-in callback, share link and
# emailed link is built from it, and the browser extension / mobile app
# point at it. Prompted at install.
# @required @type=url
# @docs("Installing with Docker", https://docs.karakeep.app/Installation/docker)
KARAKEEP_URL=

# PLATFORM-OWNED: the same value, handed to the app. NextAuth's canonical
# origin. Sign-in redirects and CSRF checks are validated against it, so a
# value that is not the address users actually browse to produces a redirect
# loop at login.
# @required @type=url
# @docs("NEXTAUTH_URL", https://next-auth.js.org/configuration/options#nextauth_secret)
NEXTAUTH_URL=${KARAKEEP_URL}

# Signs and encrypts the session JWTs and CSRF tokens. Karakeep boots
# without it but throws the moment anything asks for the signing secret
# ("NEXTAUTH_SECRET is not set"), so in practice sign-in is dead without it;
# a guessable value lets anyone mint a session cookie for any account.
# Rotating it invalidates every existing session. Generate with
# `openssl rand -base64 36`. Prompted at install.
# @required @sensitive @type=string(minLength=32)
NEXTAUTH_SECRET=

# Where the workers reach the API internally. The default is correct for the
# single-container image, where web and workers share the process namespace;
# only change it in a split deployment.
# @type=url
API_URL=http://localhost:3000

# Port the web server listens on inside the container. The compose exposes
# container port 3000 with no override, so changing this here without also
# changing the exposed port breaks routing.
# @type=port
PORT=3000

# PLATFORM-OWNED: the SQLite database, the liteque job queue and (by default)
# every stored asset live here, and the karakeep-data volume is mounted at
# exactly this path. Point it elsewhere and the volume stops covering your
# data. Upstream's own compose says DON'T CHANGE THIS.
# @required
DATA_DIR=/data

# Overrides where assets (screenshots, PDFs, full-page archives, videos) are
# written. Empty means `<DATA_DIR>/assets`, which is inside the volume.
ASSETS_DIR=

# Largest single upload/asset Karakeep will accept, in megabytes.
# @type=number
MAX_ASSET_SIZE_MB=50

# HTML content smaller than this many bytes is stored inline in the database
# instead of as a separate asset file.
# @type=number
HTML_CONTENT_SIZE_INLINE_THRESHOLD_BYTES=5120

# Turns on SQLite write-ahead logging. Faster under concurrent writes, but
# WAL on a network filesystem (NFS/SMB) corrupts the database, so leave it
# off unless DATA_DIR is on real local storage.
# @type=boolean
DB_WAL_MODE=false

# Set only if you are still running the pre-0.23 layout with separate web /
# workers / redis containers; it makes the app warn instead of assuming the
# all-in-one image. This compose is the all-in-one image, so leave it false.
# @type=boolean
# @docs("Legacy container upgrade", https://docs.karakeep.app/administration/legacy-container-upgrade)
USING_LEGACY_SEPARATE_CONTAINERS=false

# "true" stops the UI from calling out to GitHub on load to compare your
# version against the latest release. Turn it on if you do not want the
# instance making that outbound request, or if it is air-gapped.
# @type=boolean
DISABLE_NEW_RELEASE_CHECK=false

# Version strings the UI shows in the "about" panel and the changelog dialog.
# Both are baked into the published image at build time; setting them here
# only mislabels what you are running.
SERVER_VERSION=
CHANGELOG_VERSION=

# ─── Search: bundled Meilisearch ──────────────────────────────────────────

# PLATFORM-OWNED: where the search plugin reaches the bundled Meilisearch.
# Its presence is the on/off switch for search entirely: with it empty the
# plugin reports itself unconfigured and bookmarks are never indexed.
# @required @type=url
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
MEILI_ADDR=http://${{stack.meilisearch.HOST}}:7700

# The single credential guarding the search index. The same value is given
# to the Meilisearch server (as its master key) and to Karakeep (as the API
# key it authenticates with). Anyone who reaches the Meilisearch port with
# it can read, dump or wipe every indexed bookmark title, URL and body, and
# Meilisearch has no other auth. Leave it empty and Meilisearch starts with
# NO protection at all. Generate with `openssl rand -base64 36`. Prompted at
# install; must be identical on both services.
# @required @sensitive @type=string(minLength=16)
# @docs("Meilisearch security", https://www.meilisearch.com/docs/learn/security/basic_security)
MEILI_MASTER_KEY=

# Set on the bundled Meilisearch service: "true" opts its telemetry out, so
# the search engine makes no outbound calls.
# @type=boolean
# @docs("Meilisearch telemetry", https://www.meilisearch.com/docs/learn/resources/telemetry)
MEILI_NO_ANALYTICS=true

# How many documents the indexing worker batches per request to Meilisearch,
# and how long it waits before flushing a partial batch. Plugin-only knobs;
# raise the batch on a large import, lower it if Meilisearch OOMs.
# @type=number
MEILI_BATCH_SIZE=50
# @type=number
MEILI_BATCH_TIMEOUT_MS=500

# A SEPARATE Meilisearch instance for the semantic-search vector store. Both
# empty (the default) means the vector store shares the instance above.
# @type=url
MEILI_VECTOR_ADDR=
# @sensitive
MEILI_VECTOR_MASTER_KEY=

# Indexing worker concurrency and the per-job timeout, in seconds.
# @type=number
SEARCH_NUM_WORKERS=1
# @type=number
SEARCH_JOB_TIMEOUT_SEC=30

# Exposes the experimental semantic / hybrid search modes in the search bar.
# They only actually work once embeddings are configured and indexed
# (EMBEDDING_* below); with no embedding provider this flag changes nothing.
# @type=boolean
SEMANTIC_SEARCH_ENABLED=true

# ─── Headless browser (chrome sidecar) ────────────────────────────────────

# PLATFORM-OWNED: the chrome sidecar's DevTools HTTP endpoint. This is what
# turns a saved link into a readable archive and a screenshot; point it at
# nothing reachable and every crawl fails while the bookmark is still saved.
# The 0.33.2 image is Karakeep's own chrome build (chromedp headless-shell
# 151), which replaced the abandoned alpine-chrome and supplies
# --no-sandbox and the 9222 forwarding in its own entrypoint.
# @required @type=url
# @docs("Chrome image migration", https://docs.karakeep.app/administration/chrome-image-migration)
BROWSER_WEB_URL=http://${{stack.chrome.HOST}}:9222

# Use a raw CDP websocket (ws://…) instead of the HTTP endpoint above, which
# is what a hosted browser service such as browserless hands you. Takes
# precedence over BROWSER_WEB_URL when set.
BROWSER_WEBSOCKET_URL=

# "true" opens the browser connection per crawl instead of holding it open.
# Required by most hosted browser services, which bill per session.
# @type=boolean
BROWSER_CONNECT_ONDEMAND=false

# Path inside the container to a cookies file (Netscape format) the crawler
# loads, so paywalled or login-gated pages archive correctly. Treat that
# file as a credential, because it is your live sessions.
BROWSER_COOKIE_PATH=

# "false" turns the browser off entirely: Karakeep falls back to a plain
# HTTP fetch, so no screenshots, no full-page archives, and JS-rendered
# pages come back empty.
# @type=boolean
CRAWLER_HEADLESS_BROWSER=true

# Crawl concurrency and per-job / per-navigation timeouts, in seconds. More
# workers means more simultaneous Chrome tabs and proportionally more RAM.
# @type=number
CRAWLER_NUM_WORKERS=1
# @type=number
CRAWLER_JOB_TIMEOUT_SEC=60
# @type=number
CRAWLER_NAVIGATE_TIMEOUT_SEC=30

# What the crawler keeps for each bookmark. Screenshots and banner images
# are on by default; PDF and the full-page (SingleFile/monolith) archive are
# off because they are the expensive ones for disk.
# @type=boolean
CRAWLER_DOWNLOAD_BANNER_IMAGE=true
# @type=boolean
CRAWLER_STORE_SCREENSHOT=true
# @type=boolean
CRAWLER_FULL_PAGE_SCREENSHOT=false
# @type=boolean
CRAWLER_STORE_PDF=false
# @type=boolean
CRAWLER_FULL_PAGE_ARCHIVE=false

# Downloads the video on a bookmarked page with yt-dlp, capped at
# CRAWLER_VIDEO_DOWNLOAD_MAX_SIZE megabytes and the timeout in seconds.
# @type=boolean
CRAWLER_VIDEO_DOWNLOAD=false
# @type=number
CRAWLER_VIDEO_DOWNLOAD_MAX_SIZE=50
# @type=number
CRAWLER_VIDEO_DOWNLOAD_TIMEOUT_SEC=600

# Blocks ads during crawls, and (new in 0.33) auto-dismisses cookie/GDPR
# consent dialogs before capturing the article, screenshot and PDF.
# @type=boolean
CRAWLER_ENABLE_ADBLOCKER=true
# @type=boolean
CRAWLER_ENABLE_AUTOCONSENT=true

# Extra CLI arguments passed to yt-dlp and to monolith. Note the separator
# is `%%`, not a space or a comma: "--a%%--b" is two arguments.
CRAWLER_YTDLP_ARGS=
CRAWLER_MONOLITH_ARGS=
# @type=number
CRAWLER_MONOLITH_TIMEOUT_SEC=5

# Guards for the HTML parser: memory ceiling in MB and wall-clock timeout in
# seconds for parsing one page, plus the screenshot capture timeout. The
# memory limit is what stops a huge archive from OOM-ing the container.
# @type=number
CRAWLER_PARSER_MEM_LIMIT_MB=512
# @type=number
CRAWLER_PARSE_TIMEOUT_SEC=60
# @type=number
CRAWLER_SCREENSHOT_TIMEOUT_SEC=5

# SSRF defense: how long the pre-crawl DNS resolution may take before the
# URL is rejected. Karakeep resolves the hostname and refuses private /
# link-local addresses; anyone who can add a bookmark can otherwise make
# your server fetch internal endpoints.
# @type=number
# @docs("Security considerations", https://docs.karakeep.app/administration/security-considerations)
CRAWLER_IP_VALIDATION_DNS_RESOLVER_TIMEOUT_SEC=1

# Per-domain crawl rate limit. BOTH must be set for it to take effect; with
# either empty there is no per-domain limiting at all.
# @type=number
CRAWLER_DOMAIN_RATE_LIMIT_WINDOW_MS=
# @type=number
CRAWLER_DOMAIN_RATE_LIMIT_MAX_REQUESTS=

# User-Agent sent on the cheap HEAD/GET preflight the crawler does before
# spending a browser tab on a URL.
CRAWLER_PREFLIGHT_USER_AGENT=

# Route crawler traffic through a proxy so untrusted bookmarks are not
# fetched from your own IP or inside your own network. That is the mitigation
# upstream recommends for a multi-user instance. Comma-separated lists; the
# proxy URL may carry credentials, hence sensitive.
# @sensitive
# @docs("Security considerations", https://docs.karakeep.app/administration/security-considerations)
CRAWLER_HTTP_PROXY=
# @sensitive
CRAWLER_HTTPS_PROXY=
CRAWLER_NO_PROXY=

# AUTH-WEAKENING: comma-separated hostnames exempted from the private-IP /
# internal-address check, so the crawler is allowed to fetch them. Every
# entry is a hole in the SSRF protection above; only list hosts you are
# happy for any user of the instance to reach.
CRAWLER_ALLOWED_INTERNAL_HOSTNAMES=

# ─── Authentication ───────────────────────────────────────────────────────

# "true" closes self-registration: the sign-up form disappears and only
# existing users (or accounts an admin creates) can sign in. Set this on any
# instance reachable from the internet; the default leaves registration
# open to anyone who finds the URL, and every registered user can make your
# server crawl arbitrary URLs.
# @type=boolean
# @docs("Security considerations", https://docs.karakeep.app/administration/security-considerations)
DISABLE_SIGNUPS=false

# AUTH-WEAKENING in the other direction: "true" removes email+password
# sign-in entirely, leaving only the OAuth provider below. Turn it on ONLY
# after OAuth is proven working, or you lock yourself out.
# @type=boolean
DISABLE_PASSWORD_AUTH=false

# Requires a verified email before a new account can be used. Boot FAILS
# with "To enable email verification, SMTP settings must be configured" if
# this is true and SMTP_HOST is empty.
# @type=boolean
EMAIL_VERIFICATION_REQUIRED=false

# Generic OIDC provider. The well-known URL is the discovery document
# (…/.well-known/openid-configuration); its presence is what enables the
# provider. The client secret is the credential your IdP issued.
# @type=url
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
OAUTH_WELLKNOWN_URL=
OAUTH_CLIENT_ID=
# @sensitive
OAUTH_CLIENT_SECRET=

# Scopes requested from the provider, and the button label shown on the
# sign-in page.
OAUTH_SCOPE=openid email profile
OAUTH_PROVIDER_NAME=Custom Provider

# ID-token signature algorithm to demand. Only asymmetric algorithms are
# accepted by design, because the token is verified against the provider's
# JWKS, and symmetric HS*/"none" are deliberately not options.
# @type=enum(RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384, ES512, EdDSA)
OAUTH_ID_TOKEN_SIGNED_RESPONSE_ALG=
# Timeout for calls to the provider, in milliseconds.
# @type=number
OAUTH_TIMEOUT=3500

# "true" skips the Karakeep sign-in page and bounces straight to the IdP.
# Convenient, but it also hides the password form you may need as a fallback.
# @type=boolean
OAUTH_AUTO_REDIRECT=false

# AUTH-WEAKENING, and upstream names it "dangerous" for a reason: "true"
# links an OAuth identity to an existing local account whenever the email
# addresses match. An IdP that does not verify email ownership then becomes
# an account-takeover path. Leave false unless you control the IdP.
# @type=boolean
OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING=false

# Cloudflare Turnstile on the sign-up / sign-in forms. Setting the site key
# turns the check on, and boot FAILS if the secret key is then missing.
# @docs("Cloudflare Turnstile", https://developers.cloudflare.com/turnstile/get-started/)
TURNSTILE_SITE_KEY=
# @sensitive
TURNSTILE_SECRET_KEY=

# ─── AI: tagging, summaries, chat, embeddings ─────────────────────────────

# STORED CREDENTIAL: your OpenAI API key, kept in the container's
# environment and sent with every tagging, summarization, chat and embedding
# call. Setting it is what switches inference on (`isConfigured` is
# OPENAI_API_KEY or OLLAMA_BASE_URL), and it also flips embeddings /
# semantic indexing on by default. Billed to your account, and anyone with
# shell access to this container has the key.
# @sensitive
# @docs("Setting up OpenAI", https://docs.karakeep.app/administration/openai)
OPENAI_API_KEY=

# Point the OpenAI client at a compatible endpoint instead (OpenRouter,
# LiteLLM, vLLM, Azure-compatible gateways). Setting it also changes two
# defaults: max-completion-tokens and embedding auto-indexing stop
# defaulting to on, because those defaults assume real OpenAI models.
# @type=url
# @docs("Using different AI providers", https://docs.karakeep.app/configuration/different-ai-providers)
OPENAI_BASE_URL=

# HTTP(S) proxy for the OpenAI client only, and the per-request timeout in
# seconds. The proxy URL may carry credentials.
# @sensitive
OPENAI_PROXY_URL=
# @type=number
OPENAI_TIMEOUT_SEC=

# OpenAI-specific request knobs. "flex" is the cheaper, slower service tier;
# reasoning effort applies to the reasoning models.
# @type=enum(auto, default, flex)
OPENAI_SERVICE_TIER=
# @type=enum(none, minimal, low, medium, high, xhigh)
OPENAI_REASONING_EFFORT=

# STORED CREDENTIAL-adjacent: base URL of a local Ollama, used instead of
# OpenAI. Its presence alone enables inference, and it is the fully
# self-hosted option: no bookmark content leaves your network. KEEP_ALIVE
# is how long Ollama holds the model in memory (e.g. "5m", "-1").
# @type=url
# @docs("Using different AI providers", https://docs.karakeep.app/configuration/different-ai-providers)
OLLAMA_BASE_URL=
OLLAMA_KEEP_ALIVE=

# Models used for text and for images (vision, used on screenshots and
# uploaded pictures), and the language auto-generated tags are written in.
INFERENCE_TEXT_MODEL=gpt-5.6-luna
INFERENCE_IMAGE_MODEL=gpt-4o-mini
INFERENCE_LANG=english

# Prompt/response sizing, in tokens. Raise the context length for a
# large-context local model; the output cap bounds each tagging response.
# @type=number
INFERENCE_CONTEXT_LENGTH=2048
# @type=number
INFERENCE_MAX_OUTPUT_TOKENS=2048

# Empty auto-selects: true on a stock OpenAI setup (the default 5.6-series
# model requires `max_completion_tokens` instead of `max_tokens`, fixed in
# 0.33.2), false for Ollama or a custom base URL. Set explicitly only if a
# gateway rejects the parameter Karakeep chose.
# @type=boolean
INFERENCE_USE_MAX_COMPLETION_TOKENS=

# How the model is asked to return JSON. The boolean is the legacy switch
# and wins when set (true -> structured, false -> plain); otherwise the enum
# applies. Local models that choke on structured outputs want "json" or
# "plain".
# @type=boolean
INFERENCE_SUPPORTS_STRUCTURED_OUTPUT=
# @type=enum(structured, json, plain)
INFERENCE_OUTPUT_SCHEMA=structured

# Whether new bookmarks are auto-tagged and auto-summarized. Both are no-ops
# until an inference provider is configured.
# @type=boolean
INFERENCE_ENABLE_AUTO_TAGGING=true
# @type=boolean
INFERENCE_ENABLE_AUTO_SUMMARIZATION=false

# Inference worker concurrency, per-job timeout and the timeout for fetching
# the content being summarized, in seconds.
# @type=number
INFERENCE_NUM_WORKERS=1
# @type=number
INFERENCE_JOB_TIMEOUT_SEC=30
# @type=number
INFERENCE_FETCH_TIMEOUT_SEC=300

# Adds the "chat with your bookmarks" UI. Empty CHAT_MODEL falls back to
# INFERENCE_TEXT_MODEL.
# @type=boolean
CHAT_ENABLED=false
CHAT_MODEL=

# Embeddings power semantic / hybrid search and the smarter auto-tagging
# added in 0.33. Empty auto-indexing means "on when using a stock OpenAI
# setup, off otherwise". Turning it on re-embeds your whole library, which
# costs one API call per bookmark.
# @type=boolean
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
EMBEDDING_ENABLE_AUTO_INDEXING=

# STORED CREDENTIAL: a separate key/endpoint for the embedding provider, so
# embeddings can run on a different (usually cheaper or local) service than
# tagging. Empty falls back to the OPENAI_*/OLLAMA_* settings above.
# @sensitive
EMBEDDING_OPENAI_API_KEY=
# @type=url
EMBEDDING_OPENAI_BASE_URL=

# Embedding model and its vector width. EMBEDDING_DIMENSIONS must match what
# the model emits, and if you set the override it must equal
# EMBEDDING_DIMENSIONS or the app refuses to boot. Changing either after
# indexing invalidates the existing vectors.
EMBEDDING_TEXT_MODEL=text-embedding-3-small
# @type=number
EMBEDDING_DIMENSIONS=1536
# @type=number
EMBEDDING_TEXT_MODEL_DIMENSION_OVERRIDE=

# How much text per bookmark is embedded, plus embedding worker concurrency
# and per-job timeout in seconds.
# @type=number
EMBEDDING_CONTEXT_LENGTH=8000
# @type=number
EMBEDDING_NUM_WORKERS=1
# @type=number
EMBEDDING_JOB_TIMEOUT_SEC=60

# OCR of images and scanned PDFs. Languages are comma-separated tesseract
# codes; the confidence threshold (0-100) drops low-quality text. OCR_USE_LLM
# sends the image to the configured vision model instead of tesseract, which
# is better but costs an API call per asset.
OCR_LANGS=eng
# @type=number
OCR_CONFIDENCE_THRESHOLD=50
# @type=boolean
OCR_USE_LLM=false
# Directory for tesseract's trained-data cache; empty uses the image default.
OCR_CACHE_DIR=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────

# Outbound mail for verification and list invitations. SMTP_HOST is the
# switch: with it empty there is no mailer, and EMAIL_VERIFICATION_REQUIRED
# then fails the boot. SMTP_SECURE means implicit TLS (port 465); leave it
# false for STARTTLS on 587.
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
SMTP_HOST=
# @type=port
SMTP_PORT=587
# @type=boolean
SMTP_SECURE=false
SMTP_USER=
# @sensitive
SMTP_PASSWORD=
# @type=email
SMTP_FROM=

# ─── Asset storage (optional S3) ──────────────────────────────────────────

# Setting the endpoint switches asset storage from the local filesystem
# (DATA_DIR/assets, i.e. the karakeep-data volume) to S3-compatible object
# storage. Assets already written locally are NOT migrated.
# @type=url
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
ASSET_STORE_S3_ENDPOINT=
ASSET_STORE_S3_REGION=
ASSET_STORE_S3_BUCKET=
# @sensitive
ASSET_STORE_S3_ACCESS_KEY_ID=
# @sensitive
ASSET_STORE_S3_SECRET_ACCESS_KEY=
# Path-style addressing (bucket in the path, not the hostname), which MinIO
# and most non-AWS gateways need.
# @type=boolean
ASSET_STORE_S3_FORCE_PATH_STYLE=false

# ─── Workers, queue and rate limiting ─────────────────────────────────────

# Address the worker process binds for its Prometheus /metrics endpoint.
# The default 127.0.0.1 is unreachable from outside the container, and port
# 0 picks a random one, so set both to scrape metrics.
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
WORKERS_HOST=127.0.0.1
# @type=port
WORKERS_PORT=0

# Comma-separated allow/deny lists of worker names (crawler, inference,
# search, adminMaintenance, video, feed, assetPreprocessing, webhook,
# ruleEngine, backup). Empty runs them all; the disabled list wins over the
# enabled one. Used to split workloads across containers.
WORKERS_ENABLED_WORKERS=
WORKERS_DISABLED_WORKERS=

# Concurrency for the remaining worker pools, and their per-job timeout in
# seconds.
# @type=number
ASSET_PREPROCESSING_NUM_WORKERS=1
# @type=number
ASSET_PREPROCESSING_JOB_TIMEOUT_SEC=60
# @type=number
RULE_ENGINE_NUM_WORKERS=1

# Enables per-user API rate limiting. Without REDIS_URL the limiter is
# in-memory and therefore per-process only.
# @type=boolean
RATE_LIMITING_ENABLED=false

# Optional Redis, used only as the shared backend for rate limiting. It is
# NOT the job queue (that is SQLite/liteque in DATA_DIR). The URL may carry
# a password.
# @sensitive @type=url
REDIS_URL=

# Restate is an alternative, durable queue backend. It is dormant unless
# RESTATE_LISTEN_PORT is set (that single variable is what activates it),
# and it needs a Restate server this compose does not run, so leave it
# empty. The rest of the block only matters once it is on.
# @type=port
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
RESTATE_LISTEN_PORT=
# @type=url
RESTATE_INGRESS_ADDR=http://localhost:8080
# @type=url
RESTATE_ADMIN_ADDR=http://localhost:9070
# Restate's request-signing public key. Without it Karakeep accepts
# unsigned invocations on the listen port, so anything that can reach that
# port can drive the queue.
# @sensitive
RESTATE_PUB_KEY=
# @type=boolean
RESTATE_EXPOSE_CORE_SERVICES=true
# @type=boolean
RESTATE_ENABLE_DISPATCHERS=true
# @type=boolean
RESTATE_ENABLE_RUNNERS=true
# @type=number
RESTATE_DISPATCHER_INACTIVITY_TIMEOUT_SECS=10

# ─── Webhooks and feeds ───────────────────────────────────────────────────

# Outbound webhook delivery: worker concurrency, request timeout in seconds,
# and how many times a failed delivery is retried.
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
# @type=number
WEBHOOK_NUM_WORKERS=1
# @type=number
WEBHOOK_TIMEOUT_SEC=5
# @type=number
WEBHOOK_RETRY_TIMES=3

# Per-user ceilings on webhooks and RSS feeds. These bound how much
# outbound traffic one account can make the server generate.
# @type=number
MAX_WEBHOOKS_PER_USER=100
# @type=number
MAX_RSS_FEEDS_PER_USER=1000

# ─── Logging and observability ────────────────────────────────────────────

# Winston log level. The image default is "debug", which is very chatty for
# a production instance; "info" or "warn" is usually what you want.
# @type=enum(error, warn, info, http, verbose, debug, silly)
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
LOG_LEVEL=debug

# "true" strips ANSI colour from log output, for log collectors that do not
# handle escape codes.
# @type=boolean
NO_COLOR=false

# Bearer token required to scrape the workers' /metrics endpoint. Leave it
# empty and Karakeep generates a random one at boot, which effectively
# closes the endpoint (nobody knows the token) but also means scraping is
# impossible until you set a value here.
# @sensitive
PROMETHEUS_AUTH_TOKEN=

# OpenTelemetry tracing. Enabling it without an OTLP traces endpoint just
# drops the spans. Sample rate is 0.0-1.0.
# @type=boolean
# @docs("OTLP exporter configuration", https://opentelemetry.io/docs/specs/otel/protocol/exporter/)
OTEL_TRACING_ENABLED=false
# @type=url
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=karakeep
# @type=number
OTEL_SAMPLE_RATE=1.0

# Structured event logs (who did what), and shipping them over OTLP. Boot
# FAILS if the OTLP export is enabled with no logs endpoint set.
# @type=boolean
EVENT_LOGS_ENABLED=false
# @type=boolean
OTEL_EVENT_LOGS_EXPORT_ENABLED=false
# @type=url
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# ─── Legal links, demo mode and managed-cloud only ────────────────────────

# Shown as footer links in the UI when set. Only useful if you host the
# instance for other people.
# @type=url
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
TERMS_OF_SERVICE_URL=
# @type=url
PRIVACY_POLICY_URL=

# AUTH-WEAKENING: demo mode prefills the sign-in form with the credentials
# below and makes the instance a public playground. Never enable it on an
# instance holding real bookmarks.
# @type=boolean
DEMO_MODE=false
# @type=email
DEMO_MODE_EMAIL=
# @sensitive
DEMO_MODE_PASSWORD=

# Billing, for running Karakeep as a paid service. Stripe is considered
# configured only when BOTH the secret and publishable keys are set; the
# quota variables then split users into free and paid tiers (empty = no
# limit). Irrelevant to a self-hosted single-tenant instance.
# @sensitive
# @docs("Karakeep environment variables", https://docs.karakeep.app/configuration/environment-variables)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# @sensitive
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
# @type=number
FREE_QUOTA_BOOKMARK_LIMIT=
# @type=number
FREE_QUOTA_ASSET_SIZE_BYTES=
# @type=boolean
FREE_BROWSER_CRAWLING_ENABLED=
# @type=number
PAID_QUOTA_BOOKMARK_LIMIT=
# @type=number
PAID_QUOTA_ASSET_SIZE_BYTES=
# @type=boolean
PAID_BROWSER_CRAWLING_ENABLED=
