# Nextcloud 34.0.3 (image nextcloud:34.0.3-apache) environment schema
# (@env-spec / varlock format).
#
# Source: the official image's OWN startup code at the pinned tag, not a docs
# page. nextcloud/docker `34/apache/Dockerfile` carries
# `ENV NEXTCLOUD_VERSION 34.0.3`, so that directory IS the pinned image:
#   - `34/apache/entrypoint.sh`: every `$VAR` / `${VAR+x}` / `file_env` read;
#   - `34/apache/config/*.config.php`: every `getenv()` read (autoconfig,
#     redis, smtp, s3, swift, reverse-proxy);
#   - `34/apache/Dockerfile`: PHP_MEMORY_LIMIT / PHP_UPLOAD_LIMIT /
#     PHP_OPCACHE_MEMORY_CONSUMPTION / APACHE_BODY_LIMIT, written into
#     php.ini and apache conf as LITERAL `${VAR}` placeholders (single-quoted
#     in the RUN block), which PHP and Apache expand from the environment at
#     RUNTIME, so they are real runtime knobs, not baked build args.
# Cross-checked against the image README and Nextcloud 34's admin manual.
#
# TWO LIFETIMES, and mixing them up is the usual Nextcloud support ticket:
#
#   FIRST RUN ONLY (entrypoint; consumed by `occ maintenance:install` and
#   burned into config/config.php, then never looked at again):
#     NEXTCLOUD_ADMIN_USER / _PASSWORD (+_FILE), NEXTCLOUD_DATA_DIR,
#     NEXTCLOUD_TRUSTED_DOMAINS, SQLITE_DATABASE, MYSQL_* and POSTGRES_*.
#   Changing any of these against an already-installed volume does nothing:
#   the entrypoint only enters that branch when /var/www/html/version.php is
#   absent. Rotating the admin password means `occ user:resetpassword`;
#   adding a domain means `occ config:system:set trusted_domains N`.
#
#   EVERY REQUEST (the config/*.config.php templates are real PHP, and
#   lib/private/Config.php loads config.php first then natsorts every other
#   *.config.php over it, so these override the installed config live):
#     REDIS_*, SMTP_*/MAIL_*, OVERWRITE*, TRUSTED_PROXIES,
#     FORWARDED_FOR_HEADERS, OBJECTSTORE_*. REDIS_HOST is additionally read
#     by the entrypoint on every start to write redis-session.ini.
#   The README's warning still applies in one direction: values present at
#   install time were also merged into config.php, so REMOVING the variable
#   later leaves the old value behind and it must be cleared with `occ`.
#
# Also true at this version and not in the README: Config.php honours any
# `NC_`-prefixed environment variable as an override for the config.php key of
# the same name, ahead of every file. It is a dynamic prefix, not a fixed key,
# so nothing below can declare it, but it is how a system value gets forced
# without touching config.php.
#
# Docker-secrets `_FILE` twins exist for NEXTCLOUD_ADMIN_USER/_PASSWORD,
# MYSQL_DATABASE/_USER/_PASSWORD, POSTGRES_DB/_USER/_PASSWORD,
# REDIS_HOST_PASSWORD, SMTP_PASSWORD, OBJECTSTORE_S3_KEY/_SECRET and
# OBJECTSTORE_S3_SSE_C_KEY (the README omits that last one, but s3.config.php
# reads it).
# Setting a variable AND its `_FILE` twin is a hard error: the entrypoint
# prints "both X and X_FILE are set (but are exclusive)" and exits 1.
#
# This stack bundles PostgreSQL and Redis, so the MySQL/MariaDB, SQLite and
# object-storage families below are declared because the image reads them,
# not because the compose uses them. Leave them empty.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Auto configuration via environment variables", https://github.com/nextcloud/docker#auto-configuration-via-environment-variables)
# ---

# ─── Core (first run only) ─────────────────────────────────────────────────

# Platform prompt key for the hostname Nextcloud is served on, threaded
# unchanged into NEXTCLOUD_TRUSTED_DOMAINS below. Bare hostname, no scheme
# and no path (`cloud.example.com`).
# @required
# @docs("Trusted domains", https://docs.nextcloud.com/server/34/admin_manual/configuration_server/config_sample_php_parameters.html#trusted-domains)
NEXTCLOUD_TRUSTED_DOMAIN=

# Space-separated allow-list of hostnames Nextcloud will answer on, set by the
# compose from NEXTCLOUD_TRUSTED_DOMAIN above. Nextcloud refuses to serve a
# Host header that is not on the list ("You are accessing the server from an
# untrusted domain"), so a wrong value here is a hard lockout on first visit.
# Applied ONCE, immediately after `occ maintenance:install`, as
# trusted_domains[1..n]; index 0 is whatever the installer detected. Adding a
# domain later needs `occ config:system:set trusted_domains N --value=...`.
# @required
NEXTCLOUD_TRUSTED_DOMAINS=${NEXTCLOUD_TRUSTED_DOMAIN}

# Login name of the first administrator, created during the unattended
# install. Both this and NEXTCLOUD_ADMIN_PASSWORD must be present or the
# entrypoint skips the automated install entirely and drops you on the public
# web installation wizard, an unauthenticated form that lets whoever reaches
# the URL first claim the admin account and the database credentials.
# @required
# @docs("Initial admin account", https://github.com/nextcloud/docker#initial-admin-account)
NEXTCLOUD_ADMIN_USER=

# Password for that administrator. Passed on the `occ maintenance:install`
# command line inside the container, then stored hashed. Read only at first
# install: once the instance exists this variable is inert, and rotating the
# password means `occ user:resetpassword <user>`, not editing this. An empty
# or weak value here is a full-control account on an internet-facing file
# server. Generate it, never reuse one.
# @required
# @sensitive
NEXTCLOUD_ADMIN_PASSWORD=

# Docker-secrets twins: read the admin credentials from a file inside the
# container instead of the environment. Mutually exclusive with the plain
# variable above; setting both aborts startup.
# @docs("Docker Secrets", https://github.com/nextcloud/docker#docker-secrets)
NEXTCLOUD_ADMIN_USER_FILE=
NEXTCLOUD_ADMIN_PASSWORD_FILE=

# Where user files are stored, passed to the installer as --data-dir and
# frozen into config.php's `datadirectory`. The compose's only volume covers
# /var/www/html, so the default keeps user data on that volume; pointing this
# anywhere else without adding a matching volume puts every uploaded file on
# the container's writable layer, where a redeploy destroys it.
# @docs("datadirectory", https://docs.nextcloud.com/server/34/admin_manual/configuration_server/config_sample_php_parameters.html#datadirectory)
NEXTCLOUD_DATA_DIR=/var/www/html/data

# ─── Bundled PostgreSQL (first run only) ───────────────────────────────────

# Hostname of the database server, resolved by the platform to the bundled
# `db` service. Accepts `host:port` if the server is not on 5432. All four
# POSTGRES_* values must be present together or the entrypoint falls through
# to the web wizard instead of installing.
# @required
# @docs("Database parameters", https://github.com/nextcloud/docker#database-parameters)
POSTGRES_HOST=${{stack.db.HOST}}

# Database name and role, matching what the bundled Postgres container creates
# from its own POSTGRES_DB / POSTGRES_USER on first boot.
# @required
POSTGRES_DB=nextcloud
# @required
POSTGRES_USER=nextcloud

# Password for the `nextcloud` Postgres role. Platform prompt key, generated
# once and used by BOTH containers: it initialises the role in the bundled
# Postgres and is written into Nextcloud's config.php at install. Both sides
# freeze it (Postgres ignores the variable after initdb, Nextcloud after
# install), so changing it later just breaks the connection until the role's
# password is reset in SQL and config.php is edited to match.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Docker-secrets twins for the three values above.
POSTGRES_DB_FILE=
POSTGRES_USER_FILE=
POSTGRES_PASSWORD_FILE=

# ─── Other database backends (unused by this stack) ────────────────────────

# MySQL/MariaDB instead of PostgreSQL. All four are required together, and
# only one database family may be set: the entrypoint checks SQLite first,
# then MySQL, then PostgreSQL, and the first complete set wins.
# @docs("Using an external database", https://github.com/nextcloud/docker#using-an-external-database)
MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
# @sensitive
MYSQL_PASSWORD=
MYSQL_DATABASE_FILE=
MYSQL_USER_FILE=
MYSQL_PASSWORD_FILE=

# SQLite database name. Careful: the entrypoint tests this one for PRESENCE
# (`${SQLITE_DATABASE+x}`), not for a non-empty value. Exporting it as an
# empty string is enough to make the installer choose SQLite and ignore the
# bundled PostgreSQL entirely. Leave it unset on this stack.
SQLITE_DATABASE=

# ─── Bundled Redis (live) ──────────────────────────────────────────────────

# Redis host, resolved by the platform to the bundled `redis` service. Its
# presence is what switches on distributed cache AND file locking
# (memcache.distributed / memcache.locking) in redis.config.php, and what
# makes the entrypoint write redis-session.ini so PHP sessions live in Redis.
# A leading `/` is treated as a unix socket path instead of a hostname.
# Unlike the install variables, this is re-read on every request.
# @docs("Memory caching", https://docs.nextcloud.com/server/34/admin_manual/configuration_server/caching_configuration.html)
REDIS_HOST=${{stack.redis.HOST}}

# Port for a TCP Redis; ignored when REDIS_HOST is a socket path. Defaults to
# 6379 when unset.
# @type=port
REDIS_HOST_PORT=6379

# Credentials for a Redis that requires auth. The bundled container runs
# without a password, so both stay empty here. If only the password is set it
# is sent as a bare `auth`; with a user set too, both are sent as an ACL pair.
REDIS_HOST_USER=
# @sensitive
REDIS_HOST_PASSWORD=
REDIS_HOST_PASSWORD_FILE=

# ─── Reverse proxy (live) ──────────────────────────────────────────────────

# Scheme Nextcloud believes it is reached over, written to `overwriteprotocol`.
# The platform terminates TLS in front of the container, which still speaks
# plain HTTP, so without `https` here Nextcloud builds every absolute URL,
# redirect and asset link as http://; the browser blocks them as mixed
# content and login bounces back to the login page in a loop. Only ever
# `https` or `http`; anything else is written through verbatim and breaks
# every generated URL.
# @type=enum(http, https)
# @docs("Reverse proxy configuration", https://docs.nextcloud.com/server/34/admin_manual/configuration_server/reverse_proxy_configuration.html)
OVERWRITEPROTOCOL=https

# Fixed hostname (optionally `host:port`) to substitute for the Host header,
# for when the proxy cannot be trusted to forward it. Setting this to the
# wrong value has the same effect as a wrong trusted domain: every link points
# somewhere unreachable. Leave empty unless links come out wrong.
OVERWRITEHOST=

# Absolute base URL used for URLs generated OUTSIDE a request: cron jobs,
# emailed share links, activity notifications. Empty means Nextcloud guesses
# from the last request it saw, which is why emailed links sometimes carry an
# internal hostname. Set it to the same origin users browse.
# @type=url
OVERWRITECLIURL=

# Absolute path Nextcloud is mounted under when it is not at the domain root
# (e.g. `/cloud`). Empty is correct for a dedicated hostname.
OVERWRITEWEBROOT=

# Regex over the remote address; when set, the OVERWRITE* values above apply
# only to requests whose client IP matches. Used to keep direct/internal
# access working while rewriting for proxied traffic.
OVERWRITECONDADDR=

# Space-separated list of proxy addresses (CIDR allowed for IPv4) whose
# X-Forwarded-* headers Nextcloud will believe. Trusting too wide a range lets
# a client spoof its own source IP, which defeats brute-force protection and
# IP-based access rules; trusting nothing makes every request appear to come
# from the proxy, so rate limiting punishes all users at once.
TRUSTED_PROXIES=

# Space-separated headers to read the original client IP from, e.g.
# `HTTP_X_FORWARDED_FOR`. Only honoured for requests from TRUSTED_PROXIES.
FORWARDED_FOR_HEADERS=

# Presence (any value, even empty) disables the image's Apache `remoteip`
# module, which by default rewrites the client IP from X-Real-IP for requests
# out of 10/8, 172.16/12 and 192.168/16. Disable it when you would rather have
# Nextcloud itself do the rewriting via TRUSTED_PROXIES; leaving both off
# means Nextcloud sees the proxy's IP for every user.
APACHE_DISABLE_REWRITE_IP=

# ─── Email / SMTP (live) ───────────────────────────────────────────────────

# Outbound SMTP server. smtp.config.php only activates when SMTP_HOST,
# MAIL_FROM_ADDRESS and MAIL_DOMAIN are ALL set; with any of the three missing
# the whole block is skipped and Nextcloud falls back to sendmail, which the
# image does not run, so password resets and share notifications silently fail.
# While these are set they also override anything configured in the admin UI.
# @docs("Email configuration", https://docs.nextcloud.com/server/34/admin_manual/configuration_server/email_configuration.html)
SMTP_HOST=

# Port. Defaults to 465 when SMTP_SECURE is set, 25 when it is not; use 587
# for submission with STARTTLS.
# @type=port
SMTP_PORT=

# `ssl` for implicit TLS (465), `tls` for STARTTLS (587). Empty means the
# connection is made in the clear, so credentials below cross the network
# unprotected unless the relay is on a private network.
# @type=enum(ssl, tls)
SMTP_SECURE=

# Authentication mechanism; `LOGIN` when unset. Use `PLAIN` for relays that
# want it.
# @type=enum(LOGIN, PLAIN, NTLM)
SMTP_AUTHTYPE=LOGIN

# SMTP username and password. Auth is only attempted when SMTP_NAME is set
# together with SMTP_PASSWORD (or SMTP_PASSWORD_FILE).
SMTP_NAME=
# @sensitive
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=

# The LOCAL PART only of the From address. Nextcloud joins it to MAIL_DOMAIN
# itself, so `nextcloud` plus `example.com` sends as nextcloud@example.com.
# Putting a full address here produces `user@example.com@example.com` and the
# relay rejects it.
MAIL_FROM_ADDRESS=

# Domain half of the From address. Use a domain the relay is authorised to
# send for, or SPF/DKIM will fail and mail will be dropped.
MAIL_DOMAIN=

# ─── Primary storage: S3 (live, unused by this stack) ──────────────────────

# Setting a bucket replaces the local data directory as PRIMARY storage: files
# stop being written to the volume and are stored as opaque objects instead.
# Only ever do this on a fresh instance: switching an installed Nextcloud to
# object storage does not migrate the files already on disk, it orphans them.
# @docs("Primary storage (S3)", https://docs.nextcloud.com/server/34/admin_manual/configuration_files/primary_storage.html)
OBJECTSTORE_S3_BUCKET=
OBJECTSTORE_S3_REGION=
OBJECTSTORE_S3_HOST=
# @type=port
OBJECTSTORE_S3_PORT=

# Access key and secret. Scope the credential to this one bucket: it is the
# key to every file every user has ever uploaded.
# @sensitive
OBJECTSTORE_S3_KEY=
OBJECTSTORE_S3_KEY_FILE=
# @sensitive
OBJECTSTORE_S3_SECRET=
OBJECTSTORE_S3_SECRET_FILE=

# TLS to the object store. Compared as a string: only the literal `false`
# turns it off, and turning it off sends the access key and every file body in
# the clear.
# @type=boolean
OBJECTSTORE_S3_SSL=true

# Path-style addressing (`host/bucket` instead of `bucket.host`) and the
# pre-v4 signature. Both are compatibility switches for non-AWS
# implementations such as MinIO or Ceph; leave off for AWS.
# @type=boolean
OBJECTSTORE_S3_USEPATH_STYLE=false
# @type=boolean
OBJECTSTORE_S3_LEGACYAUTH=false

# Create the bucket if it is missing. On by default (only the literal `false`
# disables it), which requires the credential to hold CreateBucket.
# @type=boolean
OBJECTSTORE_S3_AUTOCREATE=true

# Storage class for new objects (e.g. STANDARD_IA). Empty uses the bucket's
# default; a cold/archival class makes file reads fail or bill unexpectedly.
OBJECTSTORE_S3_STORAGE_CLASS=

# Prefix prepended to every object key. Defaults to `urn:oid:`. Changing it on
# a populated bucket makes the existing objects unfindable.
OBJECTSTORE_S3_OBJECT_PREFIX=urn:oid:

# Customer-provided server-side encryption key (SSE-C): base64, at most 32
# bytes. Nextcloud holds the only copy. Lose it and every object in the
# bucket is unrecoverable. The image README omits the `_FILE` twin, but
# s3.config.php reads it.
# @sensitive
OBJECTSTORE_S3_SSE_C_KEY=
OBJECTSTORE_S3_SSE_C_KEY_FILE=

# SSE-KMS. Either flag alone (bucket default key) or a key ARN/ID, which
# implies the flag. New in the 34 line; older servers ignore both.
# @type=boolean
OBJECTSTORE_S3_SSE_KMS_ENABLED=
OBJECTSTORE_S3_SSE_KMS_KEY_ID=

# ─── Primary storage: OpenStack Swift (live, unused by this stack) ─────────

# The Keystone identity endpoint. Its presence alone selects Swift as primary
# storage, and swift.config.php is loaded after s3.config.php, so setting both
# families leaves Swift in charge. Same one-way warning as S3: only on a fresh
# instance.
# @type=url
# @docs("Primary storage (OpenStack Swift)", https://docs.nextcloud.com/server/34/admin_manual/configuration_files/primary_storage.html#openstack-swift)
OBJECTSTORE_SWIFT_URL=

# Create the container if missing. Off unless explicitly enabled.
# @type=boolean
OBJECTSTORE_SWIFT_AUTOCREATE=false

# Keystone user. There is no `_FILE` twin for the password on this family.
OBJECTSTORE_SWIFT_USER_NAME=
# @sensitive
OBJECTSTORE_SWIFT_USER_PASSWORD=
OBJECTSTORE_SWIFT_USER_DOMAIN=Default

# Project (tenant) the container lives in, and its domain.
OBJECTSTORE_SWIFT_PROJECT_NAME=
OBJECTSTORE_SWIFT_PROJECT_DOMAIN=Default

# Catalog service name and region used to pick the object-store endpoint.
OBJECTSTORE_SWIFT_SERVICE_NAME=swift
OBJECTSTORE_SWIFT_REGION=

# Swift container that holds the files.
OBJECTSTORE_SWIFT_CONTAINER_NAME=

# ─── PHP and Apache limits (live) ──────────────────────────────────────────

# memory_limit for PHP. The Dockerfile writes `memory_limit=${PHP_MEMORY_LIMIT}`
# into nextcloud.ini as a literal placeholder, so PHP resolves it from the
# environment at startup. Below ~512M the upgrade step and preview generation
# start dying with out-of-memory errors.
# @docs("Big file upload configuration", https://docs.nextcloud.com/server/34/admin_manual/configuration_files/big_file_upload_configuration.html)
PHP_MEMORY_LIMIT=512M

# Sets both upload_max_filesize and post_max_size. It is the PHP half of the
# upload ceiling; APACHE_BODY_LIMIT below is the other half and the smaller of
# the two wins.
PHP_UPLOAD_LIMIT=512M

# opcache.memory_consumption, in megabytes. Nextcloud's admin overview warns
# when the opcode cache is too small for its ~10k files.
# @type=number
# @docs("Server tuning", https://docs.nextcloud.com/server/34/admin_manual/installation/server_tuning.html)
PHP_OPCACHE_MEMORY_CONSUMPTION=128

# Apache LimitRequestBody, in BYTES (default 1 GiB). Caps the size of any
# request body, so it caps uploads too; 0 means unlimited.
# @type=number
# @docs("Apache configuration", https://github.com/nextcloud/docker#apache-configuration)
APACHE_BODY_LIMIT=1073741824

# User and group Apache drops to, and that the entrypoint chowns
# /var/www/html to. Only change these when running the container as a
# non-default UID; a mismatch leaves the web server unable to write its own
# data directory.
APACHE_RUN_USER=www-data
APACHE_RUN_GROUP=www-data

# ─── Install and upgrade control (every start) ─────────────────────────────

# The install/upgrade step normally runs only for the image's own commands
# (`apache-foreground`, `php-fpm`). Set to 1 to force it for a custom command.
# Numeric comparison, so 0 or 1.
# @type=number
# @docs("Image specific", https://github.com/nextcloud/docker#image-specific)
NEXTCLOUD_UPDATE=0

# Presence (any value) makes the entrypoint run
# `occ maintenance:update:htaccess` after initialising an already-installed
# instance, which is what keeps pretty URLs working across image upgrades.
NEXTCLOUD_INIT_HTACCESS=
