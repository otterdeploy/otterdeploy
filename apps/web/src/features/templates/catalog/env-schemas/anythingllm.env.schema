# AnythingLLM 1.16.1 environment schema (@env-spec / varlock format).
#
# The compose was bumped off mintplexlabs/anythingllm:latest to the pinned
# stable tag 1.16.1 (docker.io tag list: `1.16.1` == `1.16` == `latest`, so
# no behavior change today; the pin just stops the tag moving under an
# operator later).
#
# Source: grep of process.env across server/ and collector/ at v1.16.1.
# Cross-checked against docker/.env.example, the file the upstream Docker
# Compose reference itself env_file's in (the closest thing this project has
# to a canonical list), and the configuration reference linked below.
#
# Where this schema differs from a quick read of the docs:
# - JWT_SECRET is not just a "multi-user" setting. It signs every session
#   JWT in BOTH single-password mode (AUTH_TOKEN set) and multi-user mode
#   (server/utils/http/index.js, server/endpoints/system.js); leaving it
#   unset falls back to a fresh random secret every boot, silently logging
#   everyone out on each container restart.
# - SIG_KEY / SIG_SALT (the AES key/salt EncryptionManager uses to encrypt
#   stored provider API keys and other secrets in the DB) self-generate on
#   first boot if unset and get written back to /app/server/.env
#   (server/utils/EncryptionManager/index.js, server/utils/helpers/
#   updateENV.js:dumpENV). That file lives INSIDE the image layer, not on
#   the compose's `anythingllm-storage` volume, so on a container recreate
#   (not just a restart) a fresh pair is generated and every previously
#   encrypted secret in the persisted SQLite DB becomes undecryptable. Pin
#   both explicitly to avoid this.
# - UID/GID in docker/.env.example only matter when building the image from
#   source (docker/Dockerfile build args); the compose runs the published
#   image directly, so they are not runtime environment otterdeploy needs to
#   set and are left out here.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Configuration reference", https://docs.anythingllm.com/configuration)
# @docs("Docker quickstart", https://docs.anythingllm.com/installation-docker/quickstart)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Where uploaded documents, the SQLite DB, vector cache and downloaded models
# live. The compose mounts the `anythingllm-storage` volume here; changing
# this without moving the mount loses persistence.
STORAGE_DIR=/app/server/storage

# Signs every session JWT (server/utils/http/index.js) in both single-user
# and multi-user auth modes. Required for login sessions to survive a
# container restart; without it a new random secret is minted on every boot.
# @required
# @sensitive
JWT_SECRET=${JWT_SECRET}

# Blocks anonymous usage telemetry and update pings (server/utils/telemetry,
# server/models/telemetry.js). The compose hardcodes this on.
# @type=boolean
DISABLE_TELEMETRY=true

# Port the server listens on inside the container. The compose exposes
# container port 3001 with no override; changing this without also updating
# the exposed port breaks routing.
# @type=port
SERVER_PORT=3001

# AES key/salt pair EncryptionManager uses to encrypt provider API keys and
# other secrets before they hit the SQLite DB. Self-generated and persisted
# to /app/server/.env on first boot if left empty. See the header note on
# why that self-generation does not survive a container recreate on this
# compose. Set both together to a random 32+ char string (both empty, or
# both filled: the pair is used together or not at all).
# @sensitive
SIG_KEY=
# @sensitive
SIG_SALT=

# Single-password ("cloud") auth mode: the app-wide login password. Requires
# JWT_SECRET to also be set, or the server ignores it and runs unauthenticated
# (server/utils/middleware/validatedRequest.js). Leave unset to configure
# multi-user auth from the UI's onboarding flow instead.
# @sensitive
AUTH_TOKEN=

# How long an issued session JWT stays valid, e.g. "30d", "12h".
# @docs("Custom TTL for sessions", https://docs.anythingllm.com/configuration#custom-ttl-for-sessions)
JWT_EXPIRY=

# ─── HTTPS (built-in server) ────────────────────────────────────────────────
# Terminates TLS inside the container itself, separate from any reverse
# proxy in front of it. All three are required together; cert/key paths must
# exist inside the container (mount them onto the storage volume or bake
# them into a derived image).

# @type=boolean
ENABLE_HTTPS=
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# ─── Password complexity ────────────────────────────────────────────────────
# Enforced on new multi-user accounts; only read at account-creation time.
# @docs("joi-password-complexity", https://github.com/kamronbatman/joi-password-complexity)

# @type=number
PASSWORDMINCHAR=8
# @type=number
PASSWORDMAXCHAR=250
# @type=number
PASSWORDLOWERCASE=1
# @type=number
PASSWORDUPPERCASE=1
# @type=number
PASSWORDNUMERIC=1
# @type=number
PASSWORDSYMBOL=1
# @type=number
PASSWORDREQUIREMENTS=4

# ─── LLM provider ────────────────────────────────────────────────────────
# Pre-seeds the chat model on first boot (server/endpoints/*.js default to
# "openai" if unset); operators can also pick and configure a provider from
# the UI instead of env vars. Only set the block for the ONE provider in use;
# credentials for a provider you are not selecting here just sit unused.
# @type=enum(openai, gemini, azure, anthropic, lmstudio, localai, ollama, togetherai, mistral, perplexity, openrouter, groq, koboldcpp, textgenwebui, generic-openai, litellm, novita, cometapi, cohere, bedrock, fireworksai, apipie, xai, zai, nvidia-nim, deepseek, ppio, moonshotai, foundry, giteeai, docker-model-runner, privatemode, sambanova, minimax, cerebras, omlx)
LLM_PROVIDER=
# @sensitive
OPEN_AI_KEY=
OPEN_MODEL_PREF=
# @sensitive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PREF=
# @sensitive
GEMINI_API_KEY=
GEMINI_LLM_MODEL_PREF=
OLLAMA_BASE_PATH=
OLLAMA_MODEL_PREF=
GENERIC_OPEN_AI_BASE_PATH=
GENERIC_OPEN_AI_MODEL_PREF=
# @sensitive
GENERIC_OPEN_AI_API_KEY=
# @sensitive
GROQ_API_KEY=
GROQ_MODEL_PREF=
AZURE_OPENAI_ENDPOINT=
# @sensitive
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL_PREF=

# ─── Embedding provider ──────────────────────────────────────────────────
# "native" (default) runs the bundled Xenova model locally; any other engine
# needs its own credentials, most of which double up with the LLM keys above
# for the OpenAI/Azure/Ollama cases.
# @type=enum(native, openai, azure, localai, ollama, cohere, litellm, generic-openai, gemini, openrouter, lemonade)
EMBEDDING_ENGINE=
EMBEDDING_MODEL_PREF=

# ─── Vector database ─────────────────────────────────────────────────────
# "lancedb" (embedded, no external service) is the default when unset.
# @docs("Vector DB", https://docs.anythingllm.com/configuration)
# @type=enum(lancedb, pgvector, chroma, chromacloud, pinecone, weaviate, qdrant, milvus, zilliz, astra)
VECTOR_DB=
PGVECTOR_CONNECTION_STRING=
CHROMA_ENDPOINT=
# @sensitive
CHROMA_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
WEAVIATE_ENDPOINT=
# @sensitive
WEAVIATE_API_KEY=
QDRANT_ENDPOINT=
# @sensitive
QDRANT_API_KEY=

# ─── Audio (speech-to-text / text-to-speech) ────────────────────────────
# Each defaults to the bundled local/native model when unset.
WHISPER_PROVIDER=
TTS_PROVIDER=
STT_PROVIDER=

# ─── Agent web search tools ──────────────────────────────────────────────
# Optional; agent skills that need live web search fall back to no results
# without a key for the engine selected in a workspace's agent config.
# @docs("Agent skills", https://docs.anythingllm.com/agent/custom/introduction)
# @sensitive
AGENT_TAVILY_API_KEY=
# @sensitive
AGENT_SERPER_DEV_KEY=
# @sensitive
AGENT_SEARCHAPI_API_KEY=

# ─── Collector (document ingestion) ─────────────────────────────────────
# Port the sidecar collector process listens on internally.
# @type=port
COLLECTOR_PORT=8888

# Allows the web-page scraper to target any IP, including private/internal
# ranges (SSRF risk). Only enable on a trusted network.
# @docs("Local IP address scraping", https://docs.anythingllm.com/configuration#local-ip-address-scraping)
# @type=boolean
COLLECTOR_ALLOW_ANY_IP=false

# Comma-separated Tesseract language codes for OCR of scanned PDFs/images.
TARGET_OCR_LANG=eng

# ─── Other configuration flags ──────────────────────────────────────────
# Every flag below is read with `"KEY" in process.env`, so presence alone
# turns it on, regardless of the value; an explicit "true"/"1" is written
# here for clarity but any non-empty value has the same effect.

# Hides chat history from the UI/API entirely, for all users.
# @docs("Disable view chat history", https://docs.anythingllm.com/configuration#disable-view-chat-history)
# @type=boolean
DISABLE_VIEW_CHAT_HISTORY=
# @type=boolean
WORKSPACE_DELETION_PROTECTION=
# Turns off the /api/docs Swagger UI; recommended for production.
# @type=boolean
DISABLE_SWAGGER_DOCS=

# Public chat-embed widgets with no allowed-domains allowlist configured
# answer requests from any origin unless this is set, which makes them
# reject instead.
# @type=boolean
EMBED_REQUIRE_ALLOWLIST=

# Pre-authenticates users from a third-party auth layer sitting in front of
# AnythingLLM instead of its own login screen.
# @docs("Simple SSO passthrough", https://docs.anythingllm.com/configuration#simple-sso-passthrough)
# @type=boolean
SIMPLE_SSO_ENABLED=
# @type=boolean
SIMPLE_SSO_NO_LOGIN=
# @type=url
SIMPLE_SSO_NO_LOGIN_REDIRECT=
