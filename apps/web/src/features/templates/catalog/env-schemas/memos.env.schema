# Memos 0.30.0 environment schema (@env-spec / varlock format).
#
# The compose pins neosmemo/memos:0.30.0. On 2026-09-04 (research date) that
# tag and the floating `stable` tag share one digest
# (sha256:71a5b4738d1bed96e92112004054f0888e92791b64eb78afd79077c96e6f9327,
# pushed 2026-07-26), so pinning changed nothing about what runs.
#
# Source: cmd/memos/main.go at v0.30.0. Memos is a Go/cobra binary whose
# ENTIRE environment surface is viper's `AutomaticEnv` over the persistent
# flags: `viper.SetEnvPrefix("memos")` +
# `SetEnvKeyReplacer(strings.NewReplacer("-", "_"))`, so every flag `--foo-bar`
# is `MEMOS_FOO_BAR` and nothing else is read. That is ten variables, full
# stop. Plus three from the image itself: `MEMOS_UID`/`MEMOS_GID` and the
# `MEMOS_DSN_FILE` docker-secret convention in scripts/entrypoint.sh, and `TZ`
# from scripts/Dockerfile. This file is short because Memos is genuinely
# configured this way. It is not an omission.
#
# EVERYTHING ELSE LIVES IN THE DATABASE, edited from the in-app Settings UI
# (or the API): storage backend and S3 credentials, SMTP/notification email,
# SSO / OAuth2 identity providers, AI + transcription providers, registration
# and password-auth policy, memo defaults, reactions, content limits. There is
# no env variable for any of them. 0.30.0 adds one alternative to the UI:
# validated protobuf-JSON files mounted under `/etc/secrets` override selected
# identity-provider and instance settings for the process lifetime and make
# them read-only in the UI. They are still not environment variables.
#
# MEMOS_MODE DOES NOT EXIST AT THIS VERSION. `--mode` (prod/dev/demo, default
# "dev") was replaced by the boolean `--demo` in 0.26.0; from 0.26.0 onward a
# `MEMOS_MODE` in the environment is silently ignored. The SQLite filename is
# unaffected (non-demo still resolves to `memos_prod.db`), which is why the
# template dropped it rather than translating it.
#
# Blank is safe here: viper's `allowEmptyEnv` is false (v1.21.0, never
# enabled in this codebase), so a present-but-EMPTY `MEMOS_*` variable is
# treated as unset and the flag default applies. Nothing in this file zeroes a
# setting by being declared empty.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment Variables", https://www.usememos.com/docs/configuration/environment-variables)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# HTTP listen port inside the container. The upstream flag default is 8081,
# but scripts/Dockerfile bakes `MEMOS_PORT="5230"` into the image and the
# compose sets it again explicitly; container port 5230 is what the compose
# exposes. Change it here and the exposed port must change with it or routing
# breaks.
# @required @type=port
# @docs("Docker deployment", https://www.usememos.com/docs/deploy/docker)
MEMOS_PORT=5230

# Bind address. Empty listens on all interfaces, which is what the container
# network needs; a loopback value here makes the service unreachable from the
# proxy.
MEMOS_ADDR=

# Path to a Unix socket to serve on INSTEAD of TCP. Setting it overrides both
# MEMOS_ADDR and MEMOS_PORT, so the exposed TCP port stops answering. Only
# useful when a proxy shares the container's filesystem; leave empty here.
MEMOS_UNIX_SOCK=

# Data directory (SQLite file, attachments on local storage). Empty
# auto-resolves to /var/opt/memos inside the image when that path exists and
# is writable, which is exactly where the compose mounts the `memos-data`
# volume. Pointing this anywhere else moves the data off the volume and it is
# lost on redeploy.
MEMOS_DATA=

# ─── Access mode and security ─────────────────────────────────────────────

# The canonical external URL of this instance, INCLUDING the scheme. In 0.30.0
# this doubles as the public/private switch: empty means PRIVATE. Anonymous
# visitors are redirected to sign-in, RSS is disabled, and anonymous API
# access is limited to the auth-bootstrap set. Set it to the instance's public
# URL only when anonymous reads (Explore, public memos, public profiles, RSS)
# are intended; it must match what the reverse proxy serves.
#
# It does NOT gate account creation. `UserService/CreateUser` is in the
# auth-bootstrap allowlist, so on a fresh database the FIRST person to
# register (anyone who can reach the instance, private mode included) is
# created with the ADMIN role and owns the instance. Claim the host
# account before exposing the URL. (The role was renamed HOST -> ADMIN by the
# 0.26 migration; older docs still say HOST.)
# @type=url
# @docs("Security", https://www.usememos.com/docs/configuration/security)
MEMOS_INSTANCE_URL=

# Demo mode. NEVER enable on a real instance: it replaces the per-instance
# JWT secret (a UUID generated on first run and stored in the DB) with the
# hardcoded literal `usememos`, so anyone can forge a valid token for any
# user. It also seeds the database with sample memos on boot and turns on
# stacktrace logging. Registration policy is separate and unaffected: open
# signup is ON by default at this version (the instance general setting is a
# zero-valued proto, so `DisallowUserRegistration` and `DisallowPasswordAuth`
# are both false). Turn it off in Settings once the accounts you want exist.
# @type=boolean
MEMOS_DEMO=false

# Allows outbound webhook targets to resolve to private/reserved IP ranges,
# i.e. disables the SSRF guard added in 0.26.2. Only for webhooks that
# genuinely point at a sibling service on a trusted network.
# @type=boolean
MEMOS_ALLOW_PRIVATE_WEBHOOKS=false

# ─── Database ─────────────────────────────────────────────────────────────

# Storage backend. `sqlite` is self-contained in MEMOS_DATA and is what this
# template's single-container, single-volume shape assumes. `mysql` and
# `postgres` require MEMOS_DSN and an external server; switching drivers on an
# existing instance is a data migration, not a config change. Memos has no
# built-in converter.
# @type=enum(sqlite, mysql, postgres)
# @docs("Database", https://www.usememos.com/docs/configuration/database)
MEMOS_DRIVER=sqlite

# Database connection string. Empty with the sqlite driver resolves to
# `<MEMOS_DATA>/memos_prod.db` (`memos_demo.db` when MEMOS_DEMO is true).
# REQUIRED and has no default for mysql/postgres, e.g.
# postgres://user:password@host:5432/memos?sslmode=disable
# @sensitive
MEMOS_DSN=

# Docker-secret variant: path to a file inside the container whose contents
# become MEMOS_DSN. Read by scripts/entrypoint.sh, not by the Go binary.
# Setting BOTH this and MEMOS_DSN is a hard startup error, not a fallback.
# @docs("Deployment-managed configuration", https://www.usememos.com/docs/configuration/deployment-configuration)
MEMOS_DSN_FILE=

# ─── Container runtime ────────────────────────────────────────────────────

# UID/GID the entrypoint drops to after chown-ing /var/opt/memos; they must
# match the ownership of anything pre-existing on the volume. The image's
# `nonroot` user is 10001:10001. A value of 0 keeps the process as root
# (supported since 0.30.0, which fixed the restart loop it used to cause).
# @type=number
MEMOS_UID=10001

# Group half of the pair above; set both together or the chown and the
# su-exec disagree and the data directory ends up unwritable.
# @type=number
MEMOS_GID=10001

# Log verbosity. `debug` is noisy enough to matter on a busy instance.
# @type=enum(debug, info, warn, error)
MEMOS_LOG_LEVEL=info

# Container timezone, used for timestamps in logs and in the calendar/heatmap
# views. The image sets UTC.
TZ=UTC
