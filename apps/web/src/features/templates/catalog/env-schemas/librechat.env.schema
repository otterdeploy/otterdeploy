# LibreChat v0.8.7 (image ghcr.io/danny-avila/librechat:v0.8.7) environment
# schema (@env-spec / varlock format).
#
# v0.8.7 is the newest non-RC release (published 2026-06-24; the image was
# built 2026-06-24 and today shares its digest with `latest`,
# sha256:c5db3331b845e1f289f8d04c0c77936c4bbe372f76730a804abc1c37e44d23a9).
# v0.8.8-rc1/rc2 exist but are release candidates. Every published GHSA for
# this project is patched at or before v0.8.5, so v0.8.7 carries no known
# outstanding security fix.
#
# Source: grep of process.env across api/ and packages/ in the v0.8.7 source
# tarball, cross-checked against the shipped .env.example. The env surface is
# ~490 variables; this schema covers what the compose sets plus the groups an
# operator of THIS stack actually touches (server/domains, secrets, auth and
# registration, sessions, MongoDB, Meilisearch, mail, moderation and rate
# limits, file storage, and one representative member per AI-provider family).
# It is deliberately not exhaustive. The full list is in the dotenv reference
# linked below.
#
# Note the code reads several variables by destructuring (`const { LOGIN_MAX =
# 7 } = process.env`), so a plain `process.env.X` grep misses them; defaults
# below come from the destructuring sites, not from .env.example.
#
# The compose prompts for LIBRECHAT_URL, CREDS_KEY, CREDS_IV, JWT_SECRET,
# JWT_REFRESH_SECRET and MEILI_MASTER_KEY and threads them, unchanged, into
# the container's own variables of the same name (and into DOMAIN_CLIENT /
# DOMAIN_SERVER for the URL).
#
# SECURITY: upstream's docs and .env.example ship WORKING example values for
# CREDS_KEY, CREDS_IV, JWT_SECRET and JWT_REFRESH_SECRET
# (packages/api/src/app/checks.ts `secretDefaults` matches .env.example lines
# 414-415 and 594-595 exactly). LibreChat only logs a warning when it sees
# them, and starts anyway. Anyone who has read the public repo can decrypt
# your users' stored API keys and mint valid session tokens if you leave them
# in place. Generate your own.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment variables reference (.env)", https://www.librechat.ai/docs/configuration/dotenv)
# ---

# ─── Core server ───────────────────────────────────────────────────────────

# Public URL of this instance. Platform prompt key; threaded unchanged into
# DOMAIN_CLIENT and DOMAIN_SERVER below, which is what every generated link,
# email link and OAuth callback is built from.
# @required
# @type=url
# @docs("Application domains", https://www.librechat.ai/docs/configuration/dotenv#application-domains)
LIBRECHAT_URL=

# Origin the browser client is served from. Set by the compose from
# LIBRECHAT_URL. A mismatch with the address people actually visit breaks
# CORS and the OAuth round-trip.
# @required
# @type=url
DOMAIN_CLIENT=${LIBRECHAT_URL}

# Origin the API answers on, used to build social-login callback URLs
# (api/strategies/*Strategy.js) and links in verification/reset emails.
# Set by the compose from LIBRECHAT_URL.
# @required
# @type=url
DOMAIN_SERVER=${LIBRECHAT_URL}

# Address the Express server binds to. The code defaults to `localhost`
# (api/server/index.js), which is unreachable from outside the container, so
# the compose pins 0.0.0.0.
# @required
HOST=0.0.0.0

# Port the server listens on inside the container; the code falls back to
# 3080 when unset. The compose exposes container port 3080, so changing this
# without also changing the exposed port breaks routing.
# @required
# @type=port
# @docs("PORT", https://www.librechat.ai/docs/configuration/dotenv#port)
PORT=3080

# Node runtime mode. `production` is what the image is built for; anything
# else turns on dev behaviour and verbose output.
# @type=enum(production, development, ci)
NODE_ENV=production

# Number of proxy hops Express trusts when deriving the client IP
# (`app.set('trust proxy', n)`, default 1). The IP-based rate limiters and
# ban list key off that IP, so a wrong value here either bans everyone
# behind the proxy or nobody.
# @type=number
# @docs("Trust proxy", https://www.librechat.ai/docs/configuration/dotenv#trust-proxy)
TRUST_PROXY=1

# Path (or https:// URL) to librechat.yaml, which configures endpoints,
# agents, MCP servers, file limits and balances. Defaults to
# /app/librechat.yaml inside the container; this stack mounts no config
# file, so leave empty unless you add one.
# @docs("Configuration path - librechat.yaml", https://www.librechat.ai/docs/configuration/dotenv#configuration-path---librechatyaml)
CONFIG_PATH=

# Browser tab title and the app name used in verification emails and TOTP
# issuer strings. Falls back to "LibreChat".
# @docs("App title and footer", https://www.librechat.ai/docs/configuration/dotenv#app-title-and-footer)
APP_TITLE=

# Text shown in the footer under the chat box. Empty keeps the default
# footer; the literal string "false" (not empty) removes it entirely.
CUSTOM_FOOTER=

# Sends `X-Robots-Tag: noindex` on every response. Anything other than the
# exact string "false" leaves indexing blocked (api/server/middleware/
# noIndex.js), which is the right default for a private instance.
# @type=boolean
# @docs("Prevent public search engines indexing", https://www.librechat.ai/docs/configuration/dotenv#prevent-public-search-engines-indexing)
NO_INDEX=true

# Outbound HTTP/HTTPS proxy for calls to model providers. Leave empty for a
# direct connection.
PROXY=

# ─── Secrets ───────────────────────────────────────────────────────────────
# Generate all four with `openssl rand -hex 32` (CREDS_IV: `-hex 16`), or
# with upstream's generator. NEVER use the values printed in upstream's docs
# or .env.example: they are real, published keys.

# AES-256 key (64 hex chars) that encrypts every credential LibreChat stores
# in MongoDB: user-supplied provider API keys, MCP server secrets, OAuth
# tokens (packages/data-schemas/src/crypto). Platform prompt key. Changing
# it after first boot leaves every already-stored key undecryptable: users
# must re-enter them.
# @required
# @sensitive
# @type=string(matches=/^[0-9a-fA-F]{64}$/)
# @docs("Credentials generator", https://www.librechat.ai/toolkit/creds_generator)
CREDS_KEY=${CREDS_KEY}

# Initialization vector for that AES-256 key (32 hex chars). Must be rotated
# together with CREDS_KEY, and rotating it has the same effect: previously
# stored credentials stop decrypting.
# @required
# @sensitive
# @type=string(matches=/^[0-9a-fA-F]{32}$/)
# @docs("Credentials configuration", https://www.librechat.ai/docs/configuration/dotenv#credentials-configuration)
CREDS_IV=${CREDS_IV}

# Signs the short-lived access JWT that authenticates every API request
# (api/strategies/jwtStrategy.js). Platform prompt key. Anyone holding this
# value can mint a token for any account, including admins.
# @required
# @sensitive
# @type=string(minLength=32)
JWT_SECRET=${JWT_SECRET}

# Signs the long-lived refresh token, and also the tokens that authorize
# image and shared-file reads (api/server/middleware/validateImageRequest.js,
# optionalShareFileAuth.js). Platform prompt key, and must differ from
# JWT_SECRET. Rotating it logs everyone out, which is the intended break-glass.
# @required
# @sensitive
# @type=string(minLength=32)
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}

# ─── MongoDB ───────────────────────────────────────────────────────────────

# Connection string for the bundled MongoDB 8.0, which the compose runs with
# `--noauth` on the private stack network, hence no credentials in the URI.
# LibreChat stores users, conversations, messages, agents and encrypted
# credentials here; it will not start without a reachable Mongo.
# @required
# @sensitive
# @docs("MongoDB database", https://www.librechat.ai/docs/configuration/dotenv#mongodb-database)
MONGO_URI=mongodb://${{stack.mongodb.HOST}}:27017/LibreChat

# Mongoose connection-pool ceiling. Raise it only if you see connection
# queueing under load; the driver default (100) is what applies when empty.
# @type=number
# @docs("MongoDB connection pool configuration", https://www.librechat.ai/docs/configuration/dotenv#mongodb-connection-pool-configuration)
MONGO_MAX_POOL_SIZE=

# Lets Mongoose build indexes on boot. Leave empty (driver default: on) for a
# single instance; set false in large deployments where you manage indexes
# yourself.
# @type=boolean
MONGO_AUTO_INDEX=

# ─── Search (Meilisearch) ──────────────────────────────────────────────────

# Master switch for conversation/message search. Only the exact string "true"
# turns it on (packages/data-schemas/src/models/plugins/mongoMeili.ts); with
# it off the search bar disappears and nothing is indexed. The compose runs a
# Meilisearch sidecar, so it is on.
# @type=boolean
# @docs("Search (Meilisearch)", https://www.librechat.ai/docs/configuration/dotenv#search-meilisearch)
SEARCH=true

# URL of the Meilisearch instance. Set by the compose to the bundled
# `meilisearch` service on the stack network.
# @required
MEILI_HOST=http://${{stack.meilisearch.HOST}}:7700

# Shared secret between LibreChat and Meilisearch: the compose sets the SAME
# generated value on both services, so it must be changed in one place or not
# at all. Anyone with it can read and write the whole search index, which
# contains conversation text.
# @required
# @sensitive
MEILI_MASTER_KEY=${MEILI_MASTER_KEY}

# Set on the Meilisearch container itself; disables its anonymous usage
# telemetry to Meilisearch's servers.
# @type=boolean
MEILI_NO_ANALYTICS=true

# Skips the boot-time reindex that syncs Mongo into Meilisearch
# (api/db/indexSync.js). Useful on very large databases where the sync is
# expensive; new documents are still indexed as they are written.
# @type=boolean
MEILI_NO_SYNC=

# ─── Registration, login and sessions ──────────────────────────────────────

# Allows anyone who can reach this URL to create an account. The compose ships
# it ON so the first operator can sign up. An instance left this way is an
# OPEN instance, and every new user gets to spend whatever provider keys you
# configured. Set to false immediately after creating your account.
# @required
# @type=boolean
# @docs("Registration and login", https://www.librechat.ai/docs/configuration/dotenv#registration-and-login)
ALLOW_REGISTRATION=true

# Email + password sign-in. Undefined counts as enabled
# (api/server/routes/config.js); set false only once an SSO provider works,
# or nobody can log in.
# @type=boolean
ALLOW_EMAIL_LOGIN=true

# Enables the social/OIDC login buttons. Off unless you configure a provider
# below.
# @type=boolean
# @docs("Social logins", https://www.librechat.ai/docs/configuration/dotenv#social-logins)
ALLOW_SOCIAL_LOGIN=false

# Lets a social/OIDC login CREATE an account that does not exist yet
# (api/strategies/socialLogin.js). This is a second open-registration door:
# leaving it on with a public IdP means anyone with an account there gets in.
# @type=boolean
ALLOW_SOCIAL_REGISTRATION=false

# Lets accounts sign in before confirming their email address. Unset counts
# as off in code, though upstream's .env.example ships it on. Turning it on
# means the email address on an account is never proven.
# @type=boolean
ALLOW_UNVERIFIED_EMAIL_LOGIN=false

# Shows the "forgot password" flow. It needs working SMTP/Mailgun: with mail
# unconfigured LibreChat logs a warning at boot and the reset link is printed
# to the server log instead of sent.
# @type=boolean
ALLOW_PASSWORD_RESET=false

# Lets users delete their own account and all its data. Undefined counts as
# enabled (api/server/middleware/canDeleteAccount.js).
# @type=boolean
ALLOW_ACCOUNT_DELETION=true

# Lets users create share links for conversations. Undefined counts as
# enabled.
# @type=boolean
# @docs("Shared links", https://www.librechat.ai/docs/configuration/dotenv#shared-links)
ALLOW_SHARED_LINKS=true

# Makes those share links readable by anyone with the URL, with no login.
# Only meaningful when ALLOW_SHARED_LINKS is on; this is what turns a private
# instance into one that serves conversation text to the internet. Unset
# counts as off (api/server/routes/config.js).
# @type=boolean
ALLOW_SHARED_LINKS_PUBLIC=false

# Minimum password length enforced at registration (api/strategies/
# validators.js); the code default is 8.
# @type=number
MIN_PASSWORD_LENGTH=8

# Lifetime of the session/access cookie, as a millisecond arithmetic
# expression evaluated at boot. Default is 15 minutes; the refresh token
# below is what keeps people signed in past it.
SESSION_EXPIRY=1000 * 60 * 15

# Lifetime of the refresh token, same arithmetic-expression format. Default
# is 7 days.
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# Forces the `Secure` flag on session cookies regardless of NODE_ENV
# (packages/api/src/oauth/csrf.ts). Leave empty to let the heuristic decide;
# set true when terminating TLS at a proxy in front of this stack.
# @type=boolean
SESSION_COOKIE_SECURE=

# ─── OpenID Connect / SSO ──────────────────────────────────────────────────

# Discovery URL of the identity provider. All five OPENID_* values below plus
# ALLOW_SOCIAL_LOGIN must be set together or the strategy is not registered
# (api/server/socialLogins.js).
# @type=url
# @docs("OpenID Connect authentication", https://www.librechat.ai/docs/configuration/authentication/OAuth2-OIDC)
OPENID_ISSUER=
OPENID_CLIENT_ID=
# @sensitive
OPENID_CLIENT_SECRET=
# Secret for the express-session cookie used during the OIDC round-trip.
# @sensitive
OPENID_SESSION_SECRET=
# Scopes requested from the IdP; "openid profile email" is the usual set.
OPENID_SCOPE=
# Path appended to DOMAIN_SERVER to form the redirect URI registered with the
# IdP; upstream's default is /oauth/openid/callback.
OPENID_CALLBACK_URL=
# Restricts sign-in to members of one IdP role/group. Empty means any account
# at the IdP may sign in.
OPENID_REQUIRED_ROLE=

# ─── Email (verification, password reset) ──────────────────────────────────

# Named transport shortcut (e.g. gmail) for nodemailer. Set EITHER this or
# EMAIL_HOST/EMAIL_PORT, not both. With no mail configured, email
# verification and password reset are unavailable.
# @docs("SMTP configuration", https://www.librechat.ai/docs/configuration/dotenv#smtp-configuration)
EMAIL_SERVICE=
EMAIL_HOST=
# @type=port
EMAIL_PORT=25
EMAIL_USERNAME=
# @sensitive
EMAIL_PASSWORD=
# Envelope From address. Must be one the relay is allowed to send as.
# @type=email
EMAIL_FROM=
# Display name on outgoing mail; falls back to APP_TITLE.
EMAIL_FROM_NAME=
# "starttls" or "tls"; empty lets nodemailer infer from the port.
EMAIL_ENCRYPTION=
# Accepts a self-signed certificate from the mail server.
# @type=boolean
EMAIL_ALLOW_SELFSIGNED=

# Mailgun HTTP API as an alternative to SMTP; when set it takes precedence
# over the EMAIL_* transport.
# @sensitive
# @docs("Mailgun configuration", https://www.librechat.ai/docs/configuration/dotenv#mailgun-configuration-recommended)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─── Moderation, bans and rate limits ──────────────────────────────────────

# Runs every user message through OpenAI's moderation endpoint and blocks
# flagged input. Needs its own API key below.
# @type=boolean
# @docs("Moderation", https://www.librechat.ai/docs/configuration/dotenv#moderation)
OPENAI_MODERATION=false

# Key used only for the moderation call (api/server/middleware/
# moderateText.js); it is not reused for chat completions.
# @sensitive
OPENAI_MODERATION_API_KEY=

# Alternate moderation endpoint; defaults to
# https://api.openai.com/v1/moderations when empty.
# @type=url
OPENAI_MODERATION_REVERSE_PROXY=

# Temporarily bans a user/IP once their violation score crosses the
# threshold. Unset counts as off in code (violations are only logged); this
# schema keeps upstream's recommended value from .env.example.
# @type=boolean
# @docs("Banning settings", https://www.librechat.ai/docs/configuration/dotenv#banning-settings)
BAN_VIOLATIONS=true

# How long a ban lasts, as a millisecond arithmetic expression. An invalid or
# empty value means no ban is ever applied (api/cache/banViolation.js), so
# clearing this silently disables banning.
BAN_DURATION=1000 * 60 * 60 * 2

# Number of violations between bans; 20 when unset (api/cache/banViolation.js).
# @type=number
BAN_INTERVAL=20

# Failed logins allowed per LOGIN_WINDOW minutes per IP; code defaults are
# 7 attempts in 5 minutes.
# @type=number
# @docs("Login and registration rate limiting", https://www.librechat.ai/docs/configuration/dotenv#login-and-registration-rate-limiting)
LOGIN_MAX=7
# @type=number
LOGIN_WINDOW=5

# Registrations allowed per REGISTER_WINDOW minutes per IP; code defaults are
# 5 in 60 minutes. Worth tightening while ALLOW_REGISTRATION is on.
# @type=number
REGISTER_MAX=5
# @type=number
REGISTER_WINDOW=60

# Caps how many messages one user may have in flight at once. Unset counts
# as off in code; this schema keeps upstream's recommended value.
# @type=boolean
# @docs("Message rate limiting per user / IP", https://www.librechat.ai/docs/configuration/dotenv#message-rate-limiting-per-user--ip)
LIMIT_CONCURRENT_MESSAGES=true
# Concurrent in-flight messages per user; 2 when unset.
# @type=number
CONCURRENT_MESSAGE_MAX=2

# Per-IP message rate limit (MESSAGE_IP_MAX per minute). Unset counts as off
# in code; this schema keeps upstream's recommended value. With TRUST_PROXY
# wrong, every request looks like it comes from one IP and this limiter
# throttles the whole instance.
# @type=boolean
LIMIT_MESSAGE_IP=true
# @type=number
MESSAGE_IP_MAX=40

# Per-user message rate limit, applied in addition to the per-IP one. Off in
# both the code and upstream's .env.example.
# @type=boolean
LIMIT_MESSAGE_USER=false
# @type=number
MESSAGE_USER_MAX=40

# ─── File storage ──────────────────────────────────────────────────────────

# Where uploads and generated images are written. Empty means `local`, which
# is what this stack is built for: the compose mounts named volumes at
# /app/uploads and /app/client/public/images. Pick another value only if you
# also fill in that provider's credentials below.
# @type=enum(local, s3, azure_blob, firebase)
# @docs("File uploads", https://www.librechat.ai/docs/configuration/dotenv#file-uploads)
CDN_PROVIDER=

# S3-compatible object storage for uploads (CDN_PROVIDER=s3). AWS_ENDPOINT_URL
# is what points these at MinIO or R2 instead of AWS.
# @docs("Amazon S3 and CloudFront", https://www.librechat.ai/docs/configuration/dotenv#amazon-s3-and-cloudfront)
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
# @type=url
AWS_ENDPOINT_URL=

# Azure Blob storage for uploads (CDN_PROVIDER=azure_blob).
# @sensitive
# @docs("Azure Blob storage CDN", https://www.librechat.ai/docs/configuration/dotenv#azure-blob-storage-cdn)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# Firebase Storage for uploads (CDN_PROVIDER=firebase). All five values come
# from the same Firebase web-app config object.
# @sensitive
# @docs("Firebase CDN", https://www.librechat.ai/docs/configuration/dotenv#firebase-cdn)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=

# ─── AI providers ──────────────────────────────────────────────────────────
# One representative key per family; each provider has further *_MODELS,
# *_REVERSE_PROXY and region variants documented upstream. The literal string
# `user_provided` (upstream's own default) does NOT configure a server-side
# key. It tells LibreChat to prompt each user for their own, encrypted at
# rest with CREDS_KEY. Leave a family empty to hide that endpoint entirely.

# OpenAI API key, or `user_provided` to let each user supply their own.
# @sensitive
# @docs("OpenAI", https://www.librechat.ai/docs/configuration/dotenv#openai)
OPENAI_API_KEY=

# Comma-separated model allow-list for the OpenAI endpoint; empty fetches the
# provider's list.
OPENAI_MODELS=

# Base URL override for OpenAI-compatible gateways (LiteLLM, Ollama's OpenAI
# shim, a proxy). Include the /v1 suffix.
# @type=url
OPENAI_REVERSE_PROXY=

# Anthropic API key, or `user_provided`.
# @sensitive
# @docs("Anthropic", https://www.librechat.ai/docs/configuration/dotenv#anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=

# Google AI Studio / Vertex key, or `user_provided`.
# @sensitive
# @docs("Google", https://www.librechat.ai/docs/configuration/dotenv#google)
GOOGLE_KEY=
GOOGLE_MODELS=

# Azure OpenAI, addressed per-deployment. Upstream now prefers the
# `azureOpenAI` block in librechat.yaml over these variables.
# @sensitive
# @docs("librechat.yaml reference", https://www.librechat.ai/docs/configuration/librechat_yaml)
AZURE_API_KEY=

# AWS Bedrock credentials; BEDROCK_AWS_DEFAULT_REGION is required alongside
# them for the endpoint to appear.
# @sensitive
# @docs("AWS Bedrock", https://www.librechat.ai/docs/configuration/dotenv#aws-bedrock)
BEDROCK_AWS_ACCESS_KEY_ID=
# @sensitive
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_DEFAULT_REGION=

# Comma-separated allow-list of which endpoints appear in the UI, e.g.
# "openAI,anthropic,google". Empty shows every endpoint that has credentials.
# @docs("Endpoints", https://www.librechat.ai/docs/configuration/dotenv#endpoints)
ENDPOINTS=

# ─── Optional external services ────────────────────────────────────────────

# Base URL of the RAG API that powers file-based retrieval. This stack does
# not run one (upstream's compose adds a rag_api + pgvector pair that needs
# bind-mounted config), so file chat stays unavailable until you point this
# at your own deployment.
# @type=url
# @docs("RAG API", https://www.librechat.ai/docs/configuration/dotenv#rag-api)
RAG_API_URL=

# Moves caches, rate-limit counters and resumable streams into Redis instead
# of process memory. Needed only when running more than one API replica.
# Enabling it without REDIS_URI makes the server throw at boot
# (packages/api/src/cache/cacheConfig.ts).
# @type=boolean
# @docs("Redis", https://www.librechat.ai/docs/configuration/dotenv#redis)
USE_REDIS=false

# Redis connection string; required whenever USE_REDIS is on.
# @sensitive
REDIS_URI=

# ─── Logging ───────────────────────────────────────────────────────────────

# Verbose request/response logging. Upstream's .env.example ships this ON;
# it is noisy and can echo prompt content into the log volume.
# @type=boolean
# @docs("Logging", https://www.librechat.ai/docs/configuration/dotenv#logging)
DEBUG_LOGGING=false

# Mirrors the debug logs to stdout as well as to the log files.
# @type=boolean
DEBUG_CONSOLE=false

# Writes logs to disk. The compose mounts a volume at /app/api/logs to hold
# them; set false to keep logs on stdout only.
# @type=boolean
LOG_TO_FILE=true

# Emits console output as structured JSON instead of human-readable text.
# @type=boolean
CONSOLE_JSON=false

# Overrides where log files are written; defaults to /app/api/logs, which is
# where the compose's volume is mounted.
LIBRECHAT_LOG_DIR=
