# Mailpit 1.31.0 environment schema (@env-spec / varlock format).
#
# The compose pins axllent/mailpit:v1.31.0 (previously the floating `latest`).
# On 2026-09-04 (research date) v1.31.0 is the newest GitHub release
# (2026-08-22) and its Docker Hub manifest (digest
# sha256:c96991d9bef73594c246d89ca81411d4e916f03e76a7d2d72fa2ab5dd3c9ce24)
# is byte-identical to the `latest` and `v1.31` tags. The repo is alive:
# `edge` was rebuilt 2026-09-03. 1.31.0 is taken over the more matured
# 1.30.7 because it carries security fixes: SMTP command injection via a
# drainData fragment-boundary bypass, and IsInternalIP missing IANA
# special-use IPv4 ranges (which the link checker and screenshotter use to
# decide what counts as "internal").
#
# Source: cmd/root.go at tag v1.31.0. `initConfigFromEnv()` and
# `initDeprecatedConfigFromEnv()` are where every MP_* twin of a CLI flag is
# read, one os.Getenv per flag. Defaults come from config/config.go and
# server/webhook/webhook.go (RateLimit = 1, Delay = 0), not from the docs.
# Booleans go through `getEnabledFromEnv()`, which accepts only "1", "true"
# or "yes" (case-insensitive); ANY other non-empty value, "0" and "false"
# included, reads as off.
#
# MP_SENDMAIL_SMTP_ADDR and MP_SENDMAIL_FROM are deliberately absent: they
# are read by sendmail/, i.e. the `mailpit sendmail` subcommand, and the
# image's ENTRYPOINT is `/mailpit` with no arguments, so this container only
# ever runs the server.
#
# SECURITY: read this before exposing the service. Mailpit's web UI, its
# REST API and its SMTP listener are ALL unauthenticated out of the box, and
# the instance holds the full body of every email your app ever sent at it:
# password-reset links, magic-link tokens, invite codes, one-time passcodes.
# Anyone who can reach port 8025 can read them and can take over accounts in
# whatever app is pointed at this Mailpit. The real controls are MP_UI_AUTH
# (or MP_UI_AUTH_FILE) for the UI/API and MP_SMTP_AUTH (or MP_SMTP_AUTH_FILE)
# for the SMTP listener. Set at least the first before this is reachable by
# anything but your own machine. The compose ships MP_SMTP_AUTH_ACCEPT_ANY=1
# and MP_SMTP_AUTH_ALLOW_INSECURE=1 so any app can send without credentials;
# both are documented below as the footguns they are.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Mailpit runtime options", https://mailpit.axllent.org/docs/configuration/runtime-options/)
# ---

# ─── Storage ─────────────────────────────────────────────────────────────

# Path to the SQLite database file. The compose points it at /data, the
# mailpit-data volume's mount point, so captured mail survives a restart.
# Leave it unset or off /data and every message lives in the container's
# ephemeral filesystem instead. A directory path here is treated as a
# directory and mailpit.db is created inside it.
# @docs("Email storage", https://mailpit.axllent.org/docs/configuration/email-storage/)
MP_DATABASE=/data/mailpit.db

# Turns off SQLite write-ahead logging. Only needed when the database file
# lives on a filesystem that cannot do WAL (some network mounts); it makes
# writes slower everywhere else.
# @type=boolean
MP_DISABLE_WAL=

# Skips the periodic VACUUM that reclaims space after messages are pruned.
# The file then only ever grows.
# @type=boolean
MP_DISABLE_AUTO_VACUUM=

# Compression level for raw messages stored in the database: 0 = off,
# 1 = fastest, 2 = standard, 3 = best. Applied per message at insert, so
# changing it does not rewrite what is already stored.
# @type=enum(0, 1, 2, 3)
# @docs("Compression", https://mailpit.axllent.org/docs/configuration/compression/)
MP_COMPRESSION=1

# Table-name prefix that lets several isolated Mailpit instances share one
# database file. Empty means the normal single-tenant table names; this
# stack runs one instance on its own volume, so leave it empty.
MP_TENANT_ID=

# Free-text label for this instance, shown in the web UI title and announced
# by the SMTP and POP3 servers. Useful when you run more than one.
MP_LABEL=

# Maximum number of messages kept; the oldest are pruned every minute once
# the mailbox is over. The compose raises Mailpit's own default of 500 to
# 5000 and lets you override it. 0 disables pruning entirely, which on a
# long-lived test instance means unbounded disk growth.
# @type=number
MP_MAX_MESSAGES=5000

# Maximum age of a message before it is pruned (hourly sweep), written as
# <int>h or <int>d, e.g. "72h" or "30d". Empty means age is not a criterion
# and only MP_MAX_MESSAGES prunes.
MP_MAX_AGE=

# Maximum size of an inbound message in MiB, applied to both SMTP DATA and
# the HTTP send API. 0 removes the limit, which is not something to do on a
# listener anything else can reach.
# @type=number
MP_MAX_MESSAGE_SIZE=50

# Sort and display messages by the date in their own Date: header instead of
# by when Mailpit received them. Handy when replaying a captured mailbox,
# confusing when a client sends a wrong date.
# @type=boolean
MP_USE_MESSAGE_DATES=

# Drops an incoming message whose Message-ID has already been stored, rather
# than storing a second copy. Only matters if something retries sends.
# @type=boolean
MP_IGNORE_DUPLICATE_IDS=

# Stops the periodic call to GitHub that checks whether a newer Mailpit
# exists. Set it on an instance that should make no outbound requests.
# @type=boolean
MP_DISABLE_VERSION_CHECK=

# ─── Logging ─────────────────────────────────────────────────────────────

# Write logs to this file inside the container instead of stdout. Doing so
# hides them from `docker logs` and from otterdeploy's log view; prefer
# leaving it empty.
# @docs("Troubleshooting", https://mailpit.axllent.org/docs/configuration/troubleshooting/)
MP_LOG_FILE=

# Errors only.
# @type=boolean
MP_QUIET=

# Adds per-message debug logging (including SMTP conversation detail). Verbose
# logs can echo message metadata, so treat them as containing test-mail
# contents.
# @type=boolean
MP_VERBOSE=

# ─── Web UI & API ────────────────────────────────────────────────────────

# host:port the HTTP server (web UI + REST API) binds to inside the
# container. The compose exposes container port 8025 and does not override
# this, so changing the port here without changing the exposed port breaks
# routing. Note the interface is the unspecified address: the UI is reachable
# from anywhere the container is, with no login unless MP_UI_AUTH is set.
# @docs("HTTP configuration", https://mailpit.axllent.org/docs/configuration/http/)
MP_UI_BIND_ADDR="[::]:8025"

# Basic-auth credentials for the web UI *and* the whole REST API, the single
# switch that turns an open archive of your test mail into a private one. The
# format is one or more space- or newline-separated "user:password" pairs;
# the password may be plain text or a bcrypt hash. Setting this is the
# recommended first move before the service is reachable by anyone else.
# @sensitive
# @docs("Password protection", https://mailpit.axllent.org/docs/configuration/passwords/)
MP_UI_AUTH=

# Same credentials, read from a file inside the container instead of the
# environment (mount it as a secret). Mailpit exits at boot if the path is
# missing or unreadable. Use one or the other, not both.
MP_UI_AUTH_FILE=

# Serve the UI/API over HTTPS from Mailpit itself. Both paths are required
# together and must exist inside the container. Unnecessary behind
# otterdeploy's proxy, which already terminates TLS.
# @docs("TLS certificates", https://mailpit.axllent.org/docs/configuration/certificates/)
MP_UI_TLS_CERT=
MP_UI_TLS_KEY=

# Path prefix the UI and API are served under, for hosting Mailpit at a
# sub-path of another domain. "/" is the default and what a dedicated
# hostname wants.
# @docs("Running behind a proxy", https://mailpit.axllent.org/docs/configuration/proxy/)
MP_WEBROOT=/

# Access-Control-Allow-Origin for the API, comma-separated (e.g.
# "example.com,foo.com"). "*" lets ANY page in a developer's browser call
# this API and read every captured message; only widen this deliberately, and
# never together with an unauthenticated UI.
MP_API_CORS=

# Blocks the message preview from loading remote stylesheets and fonts, so
# rendering a message cannot phone home to the sender. Off by default.
# @type=boolean
# @docs("UI security policies", https://mailpit.axllent.org/docs/configuration/ui-security-policies/)
MP_BLOCK_REMOTE_CSS_AND_FONTS=

# Lets the link checker, HTML checker and screenshotter fetch private/internal
# IP ranges. That turns the UI into a server-side request forgery tool against
# your own network: anything that can post a message to this Mailpit chooses
# the URL it fetches. Leave off unless you are deliberately checking links on
# a private host.
# @type=boolean
# @docs("Link check", https://mailpit.axllent.org/docs/usage/link-check/)
MP_ALLOW_INTERNAL_HTTP_REQUESTS=

# Removes the per-domain rate limit and result cache in front of the link
# checker. Without it, one message with many links can hammer a third party
# from your IP.
# @type=boolean
MP_DISABLE_LINK_CHECK_RATE_LIMIT=

# Skips HTTPS certificate verification for the link checker and screenshot
# service. Scoped to those outbound features, not to SMTP.
# @type=boolean
# @docs("HTML screenshots", https://mailpit.axllent.org/docs/usage/html-screenshots/)
MP_ALLOW_UNTRUSTED_TLS=

# Turns off gzip/deflate for HTTP responses. Only for debugging a proxy that
# mishandles compressed bodies.
# @type=boolean
MP_DISABLE_HTTP_COMPRESSION=

# Hides the "Delete all" button in the web UI. Cosmetic only: the API
# endpoint still deletes, so this is not an access control.
# @type=boolean
MP_HIDE_DELETE_ALL_BUTTON=

# Scores messages with SpamAssassin. Value is either "<host>:<port>" of a
# spamd instance or the literal "postmark" to use Postmark's public
# SpamCheck API, which means sending the full message body to a third
# party. Empty disables the integration.
# @docs("SpamAssassin integration", https://mailpit.axllent.org/docs/configuration/spamassassin/)
MP_ENABLE_SPAMASSASSIN=

# Disables SMTP relay, link checking and the HTTP send API, which is the
# read-only mode used for the public demo. A reasonable hardening switch for
# a shared instance.
# @type=boolean
MP_DEMO_MODE=

# ─── Send API ────────────────────────────────────────────────────────────

# Credentials for the HTTP send endpoint (POST /api/v1/send), which makes
# Mailpit generate and store mail from a JSON body. Same "user:password"
# format as MP_UI_AUTH. Note that MP_UI_AUTH already covers this endpoint;
# this exists to give the send API its own, separate credentials.
# @sensitive
# @docs("Sending messages", https://mailpit.axllent.org/docs/usage/sending-messages/)
MP_SEND_API_AUTH=

# The same credentials read from a file inside the container.
MP_SEND_API_AUTH_FILE=

# Accepts ANY username and password on the send endpoint, including none, so
# with MP_UI_AUTH set for humans, this leaves a machine-writable hole.
# Only for a Mailpit nothing untrusted can reach.
# @type=boolean
MP_SEND_API_AUTH_ACCEPT_ANY=

# ─── SMTP server ─────────────────────────────────────────────────────────

# host:port the SMTP listener binds to inside the container. The compose
# exposes container port 1025 and does not override this; change one and you
# must change the other. This is the address your app's mail transport points
# at.
# @docs("SMTP configuration", https://mailpit.axllent.org/docs/configuration/smtp/)
MP_SMTP_BIND_ADDR="[::]:1025"

# SMTP credentials, one or more space- or newline-separated "user:password"
# pairs (plain text or bcrypt). Setting this is what stops an arbitrary host
# from injecting mail into your capture, and, combined with MP_UI_AUTH, what
# makes an internet-reachable Mailpit defensible at all.
# @sensitive
# @docs("Password protection", https://mailpit.axllent.org/docs/configuration/passwords/)
MP_SMTP_AUTH=

# The same credentials read from a file inside the container.
MP_SMTP_AUTH_FILE=

# FOOTGUN, and the compose turns it on: accept any SMTP username and
# password, including none. It is what makes "just point your app at
# mailpit:1025" work with no setup, and it means anything that can open a
# TCP connection to this port can deposit mail. Keep it only while the SMTP
# port is reachable solely from inside the stack; set MP_SMTP_AUTH and clear
# this the moment it is not.
# @type=boolean
MP_SMTP_AUTH_ACCEPT_ANY=1

# FOOTGUN, and the compose turns it on: allow PLAIN and LOGIN SMTP
# authentication over an unencrypted connection. Credentials then cross the
# network in the clear (base64 is not encryption). Fine on a private
# container network, wrong anywhere a packet can be observed.
# @type=boolean
MP_SMTP_AUTH_ALLOW_INSECURE=1

# TLS certificate and key for the SMTP listener; both are required together
# and enable STARTTLS. Without them MP_SMTP_REQUIRE_STARTTLS and
# MP_SMTP_REQUIRE_TLS cannot be satisfied.
# @docs("TLS certificates", https://mailpit.axllent.org/docs/configuration/certificates/)
MP_SMTP_TLS_CERT=
MP_SMTP_TLS_KEY=

# Refuse mail from a client that has not issued STARTTLS. Requires the cert
# and key above; without them, clients simply cannot send.
# @type=boolean
MP_SMTP_REQUIRE_STARTTLS=

# Require implicit SSL/TLS on the listener (TLS from the first byte) rather
# than STARTTLS. Also requires the cert and key above.
# @type=boolean
MP_SMTP_REQUIRE_TLS=

# Return an SMTP error when message headers contain <CR><CR><LF>. Catches a
# malformed-header bug in your own mail generation that lenient production
# servers would silently accept.
# @type=boolean
MP_SMTP_STRICT_RFC_HEADERS=

# Maximum recipients per message. The RFC floor is 100, which is the
# default; raise it only to mirror a production MTA that allows more.
# @type=number
MP_SMTP_MAX_RECIPIENTS=100

# Regular expression; only recipients matching it are accepted. Empty allows
# every recipient. A useful guard when MP_SMTP_RELAY_ALL could otherwise send
# real mail to real people.
MP_SMTP_ALLOWED_RECIPIENTS=

# Answer 2xx for recipients that were actually rejected, so a sending app
# that cannot cope with a rejection still proceeds. Hides real delivery
# failures from your tests.
# @type=boolean
MP_SMTP_IGNORE_REJECTED_RECIPIENTS=

# Skip the reverse-DNS lookup on the connecting client. Set it when the
# container has no working resolver for private addresses and every SMTP
# connection is stalling on the lookup.
# @type=boolean
MP_SMTP_DISABLE_RDNS=

# ─── SMTP relay (releasing captured mail to a real server) ───────────────

# Path to a YAML relay configuration file inside the container. It is an
# alternative to the MP_SMTP_RELAY_* variables below and, unlike them, can
# also be reloaded from disk. Setting either enables the "Release" button in
# the UI, which sends a captured message onward for real.
# @docs("SMTP relay", https://mailpit.axllent.org/docs/configuration/smtp-relay/)
MP_SMTP_RELAY_CONFIG=

# Automatically relay EVERY message Mailpit receives to the relay server;
# upstream's own docs mark this "caution!". With a misconfigured test suite
# this mails your customers. Prefer MP_SMTP_RELAY_MATCHING.
# @type=boolean
MP_SMTP_RELAY_ALL=

# Regular expression; only messages whose recipients match are auto-relayed.
# The safer form of MP_SMTP_RELAY_ALL, e.g. one that matches only your own
# domain.
MP_SMTP_RELAY_MATCHING=

# Hostname and port of the real SMTP server to relay through. The host being
# empty is what keeps relaying off.
MP_SMTP_RELAY_HOST=
# @type=port
MP_SMTP_RELAY_PORT=

# Transport security to the relay server: STARTTLS upgrades a plain
# connection, TLS is implicit TLS from the first byte. Set one, not both.
# @type=boolean
MP_SMTP_RELAY_STARTTLS=
# @type=boolean
MP_SMTP_RELAY_TLS=

# Skip certificate verification when connecting to the relay server. Only
# for a relay with a self-signed certificate that you control.
# @type=boolean
MP_SMTP_RELAY_ALLOW_INSECURE=

# Authentication mechanism for the relay server.
# @type=enum(none, plain, login, cram-md5)
MP_SMTP_RELAY_AUTH=

# Username for plain/login/cram-md5 relay authentication.
MP_SMTP_RELAY_USERNAME=

# Password for plain/login relay authentication. These are credentials for a
# real mail provider, so treat a leak as one.
# @sensitive
MP_SMTP_RELAY_PASSWORD=

# Shared secret for cram-md5 relay authentication.
# @sensitive
MP_SMTP_RELAY_SECRET=

# Overrides the SMTP envelope return path (bounce address) on relayed
# messages, for providers that reject a return path they do not own.
MP_SMTP_RELAY_RETURN_PATH=

# Overrides the From address on relayed messages, for providers that only
# accept a verified sender.
MP_SMTP_RELAY_OVERRIDE_FROM=

# Regular expressions restricting which recipients may (allowed) or may not
# (blocked) be relayed. The blocklist is the cheap insurance against
# accidentally mailing production addresses from a test run.
MP_SMTP_RELAY_ALLOWED_RECIPIENTS=
MP_SMTP_RELAY_BLOCKED_RECIPIENTS=

# Keep the original Message-ID when relaying instead of letting the relay
# generate a new one. Needed when a downstream system threads on that ID.
# @type=boolean
MP_SMTP_RELAY_PRESERVE_MESSAGE_IDS=

# Return the relay server's SMTP error to the original sending client rather
# than accepting the message and logging the failure.
# @type=boolean
MP_SMTP_RELAY_FWD_SMTP_ERRORS=

# ─── SMTP forwarding (a copy of every message, elsewhere) ────────────────

# Path to a YAML forwarding configuration file inside the container, the
# alternative to the MP_SMTP_FORWARD_* variables below. Forwarding differs
# from relaying: it copies EVERY received message to one fixed address,
# automatically. Every secret in your test mail then also lives in that
# mailbox.
# @docs("SMTP forwarding", https://mailpit.axllent.org/docs/configuration/smtp-forward/)
MP_SMTP_FORWARD_CONFIG=

# Hostname and port of the SMTP server to forward through.
MP_SMTP_FORWARD_HOST=
# @type=port
MP_SMTP_FORWARD_PORT=

# Transport security to the forwarding server: STARTTLS upgrades a plain
# connection, TLS is implicit TLS. Set one, not both.
# @type=boolean
MP_SMTP_FORWARD_STARTTLS=
# @type=boolean
MP_SMTP_FORWARD_TLS=

# Skip certificate verification when connecting to the forwarding server.
# @type=boolean
MP_SMTP_FORWARD_ALLOW_INSECURE=

# Authentication mechanism for the forwarding server.
# @type=enum(none, plain, login, cram-md5)
MP_SMTP_FORWARD_AUTH=

# Username for plain/login/cram-md5 forwarding authentication.
MP_SMTP_FORWARD_USERNAME=

# Password for plain/login forwarding authentication.
# @sensitive
MP_SMTP_FORWARD_PASSWORD=

# Shared secret for cram-md5 forwarding authentication.
# @sensitive
MP_SMTP_FORWARD_SECRET=

# Overrides the envelope return path on forwarded messages.
MP_SMTP_FORWARD_RETURN_PATH=

# Overrides the From address on forwarded messages, for providers that only
# accept a verified sender.
MP_SMTP_FORWARD_OVERRIDE_FROM=

# The single address every received message is forwarded to. Setting this is
# what switches forwarding on.
# @type=email
MP_SMTP_FORWARD_TO=

# Return the forwarding server's SMTP error to the original sending client
# instead of accepting the message and logging the failure.
# @type=boolean
MP_SMTP_FORWARD_FWD_SMTP_ERRORS=

# ─── POP3 server ─────────────────────────────────────────────────────────

# host:port the POP3 server binds to inside the container, for test clients
# that fetch mail rather than read the UI. The compose exposes only 8025 and
# 1025, so POP3 is unreachable from outside the stack unless you also expose
# 1110.
# @docs("POP3 server", https://mailpit.axllent.org/docs/configuration/pop3/)
MP_POP3_BIND_ADDR="[::]:1110"

# POP3 credentials as "user:password" pairs. Unlike the UI and SMTP, POP3
# will not serve mail without them: an empty value means the POP3 server
# stays off, which is the safe default. Since 1.30.6 repeated failed logins
# are tracked and the connection is dropped.
# @sensitive
MP_POP3_AUTH=

# The same credentials read from a file inside the container.
MP_POP3_AUTH_FILE=

# Optional TLS certificate and key for the POP3 server; both are required
# together.
# @docs("TLS certificates", https://mailpit.axllent.org/docs/configuration/certificates/)
MP_POP3_TLS_CERT=
MP_POP3_TLS_KEY=

# ─── Tagging ─────────────────────────────────────────────────────────────

# Inline tag rules: comma-separated "tagname:filter" pairs using Mailpit's
# own search syntax, applied to each new message.
# @docs("Message tagging", https://mailpit.axllent.org/docs/usage/tagging/)
MP_TAG=

# Path to a YAML file of the same tag rules inside the container, for more
# than fits on one line.
MP_TAGS_CONFIG=

# TitleCase tags auto-derived from plus-addresses and X-Tags headers.
# @type=boolean
MP_TAGS_TITLE_CASE=

# Turns off automatic tag sources, comma-separated: "plus-addresses",
# "x-tags", or both.
MP_TAGS_DISABLE=

# Tag each message with the SMTP username that sent it. Only meaningful when
# MP_SMTP_AUTH is set, since with MP_SMTP_AUTH_ACCEPT_ANY there is no
# trustworthy username to tag with.
# @type=boolean
MP_TAGS_USERNAME=

# ─── Chaos ───────────────────────────────────────────────────────────────

# Enables Chaos: Mailpit deliberately returns SMTP failures so you can test
# how your app handles a broken mail server. Never leave on for an instance
# whose captured mail you rely on.
# @type=boolean
# @docs("Chaos", https://mailpit.axllent.org/docs/integration/chaos/)
MP_ENABLE_CHAOS=

# The failure rules, comma-separated "trigger:code:probability", e.g.
# "Sender:451:5,Recipient:451:5,Authentication:535:5". Setting this also
# enables Chaos on its own.
MP_CHAOS_TRIGGERS=

# ─── Metrics & webhook ───────────────────────────────────────────────────

# Prometheus metrics. "true" serves /metrics from the existing HTTP server
# (so it inherits MP_UI_AUTH); "<ip>:<port>", e.g. "0.0.0.0:9090", starts a
# SEPARATE listener that has no authentication at all and is not exposed by
# this compose. "false" or empty disables it.
# @docs("Prometheus metrics", https://mailpit.axllent.org/docs/configuration/prometheus/)
MP_ENABLE_PROMETHEUS=

# URL that receives a JSON POST for every new message. Mailpit does not sign
# these requests, so the receiver must not trust the payload's origin. The
# payload carries message metadata, so point it somewhere private.
# @type=url
# @docs("Webhook", https://mailpit.axllent.org/docs/integration/webhook/)
MP_WEBHOOK_URL=

# Minimum seconds between webhook requests (a rate limit, not a batch size).
# 0 removes the limit and lets a burst of mail become a burst of POSTs.
# @type=number
MP_WEBHOOK_LIMIT=1

# Seconds to wait before sending each webhook request, for a receiver that
# needs the message to have settled first.
# @type=number
MP_WEBHOOK_DELAY=0

# ─── Deprecated aliases ──────────────────────────────────────────────────

# Still read at 1.31.0 (initDeprecatedConfigFromEnv), each logging a warning
# at boot and each overriding its modern twin. They exist so an old compose
# keeps working; do not set them in a new one. Two caveats from the code:
# MP_DISABLE_HTML_CHECK is inert (it warns and does nothing), and
# MP_SMTP_SSL_KEY is broken upstream at this version: its presence makes
# Mailpit read a third, undocumented variable named MP_SMTP_SMTP_KEY for the
# actual value, so setting MP_SMTP_SSL_KEY alone blanks the SMTP TLS key.
# Use MP_SMTP_TLS_KEY.
MP_DATA_FILE=
MP_UI_SSL_CERT=
MP_UI_SSL_KEY=
MP_SMTP_SSL_CERT=
MP_SMTP_SSL_KEY=
MP_STRICT_RFC_HEADERS=
MP_SMTP_TLS_REQUIRED=
MP_DISABLE_HTML_CHECK=
