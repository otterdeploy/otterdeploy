# CNCF Distribution (Docker Registry) v3.1.1 environment schema (@env-spec / varlock format).
#
# The compose pins registry:3. On 2026-08-29 (research date) that tag
# resolves to 3.1.1 (sha256:7518da9b...), the newest v3 release.
#
# Source: grep of the v3.1.1 tarball (distribution/distribution). There is no
# fixed list of environment variables: configuration/parser.go walks the
# Configuration struct by reflection and lets ANY key in config.yaml be set
# as REGISTRY_<SECTION>_<KEY> (nested underscores match YAML indentation,
# e.g. storage.filesystem.rootdirectory -> REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY).
# The full space is the config schema documented at the @docs link below, not
# a fixed list. This declares only what this template's compose sets, plus the
# storage/auth/http keys a single-node self-hosted registry commonly touches.
#
# The published `registry:3` image bakes cmd/registry/config-dev.yml as
# /etc/distribution/config.yml (the Dockerfile's final stage COPYs that file,
# not config-example.yml). Its relevant defaults: storage.delete.enabled=true,
# storage.filesystem.rootdirectory=/var/lib/registry, http.addr=:5000,
# storage.maintenance.uploadpurging.enabled=false. No auth backend is
# configured by default or by this template: an instance with REGISTRY_AUTH
# unset accepts anonymous pull AND push.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Distribution configuration reference", https://distribution.github.io/distribution/about/configuration/)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# storage.delete.enabled. Required for garbage collection (`registry
# garbage-collect`) to reclaim blobs of overwritten/deleted tags; without it
# DELETE requests to the API are rejected outright. The image default is
# already true (config-dev.yml), the compose sets it explicitly.
# @required @type=boolean
REGISTRY_STORAGE_DELETE_ENABLED=true

# ─── Storage ─────────────────────────────────────────────────────────────
# storage.filesystem.* is the local-disk driver this template runs. Object
# storage below is an alternative, not additive: setting REGISTRY_STORAGE
# switches the active driver away from filesystem.

# storage.filesystem.rootdirectory. The path INSIDE the container the
# registry writes blobs/manifests to. Defaults to /var/lib/registry, which is
# exactly what the compose volume mounts. Changing this without changing the
# volume's mount path leaves the data unpersisted.
REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY=

# storage.maintenance.readonly.enabled. Puts the registry into read-only
# mode: pulls work, pushes and deletes 405. Useful while running GC, which
# upstream docs require the registry to be read-only or stopped for.
# @docs("Distribution garbage collection", https://distribution.github.io/distribution/about/garbage-collection/)
# @type=boolean
REGISTRY_STORAGE_MAINTENANCE_READONLY_ENABLED=false

# ─── Storage: S3-compatible object storage (optional) ───────────────────
# Setting REGISTRY_STORAGE=s3 switches the driver from local disk to S3;
# leave all four empty to keep the filesystem driver the compose runs.

# storage.driver selector. Only "s3" is declared here; filesystem (the
# compose default) needs no selector set.
# @type=enum(s3)
REGISTRY_STORAGE=

# storage.s3.bucket. Required once REGISTRY_STORAGE=s3.
REGISTRY_STORAGE_S3_BUCKET=

# storage.s3.region. Required for AWS S3; S3-compatible providers may accept
# any placeholder and rely on regionendpoint instead.
REGISTRY_STORAGE_S3_REGION=

# storage.s3.regionendpoint. Set for any S3-compatible provider that is not
# AWS (MinIO, R2, Spaces, ...); leave empty for AWS itself.
# @type=url
REGISTRY_STORAGE_S3_REGIONENDPOINT=

# storage.s3.accesskeyid / secretaccesskey. Falls back to the IAM instance
# role or the standard AWS_* environment variables when omitted.
# @sensitive
REGISTRY_STORAGE_S3_ACCESSKEY=
# @sensitive
REGISTRY_STORAGE_S3_SECRETKEY=

# ─── Auth ────────────────────────────────────────────────────────────────
# No auth backend is set by this template: the registry accepts anonymous
# pull and push. htpasswd is the simplest backend for a single node; a
# htpasswd file must be volume-mounted at the path given below for it to
# have anything to check against.

# auth backend selector.
# @docs("Distribution authentication", https://distribution.github.io/distribution/about/configuration/)
# @type=enum(silly, htpasswd, token)
REGISTRY_AUTH=

# auth.htpasswd.realm. The realm string returned in the WWW-Authenticate
# challenge; cosmetic.
REGISTRY_AUTH_HTPASSWD_REALM=

# auth.htpasswd.path. Path INSIDE the container to a bcrypt htpasswd file
# (`htpasswd -bBc`). Only read when REGISTRY_AUTH=htpasswd.
REGISTRY_AUTH_HTPASSWD_PATH=

# ─── HTTP ────────────────────────────────────────────────────────────────

# http.secret. Signs state (e.g. multi-part upload UUIDs) the client may
# hold between requests, and MUST be identical across replicas behind the
# same load balancer or uploads break. A single instance without this set
# gets an auto-generated secret at boot, which is fine here, but that secret
# does not survive a restart, so any upload in flight during a restart fails.
# @sensitive
REGISTRY_HTTP_SECRET=

# http.host. The externally-reachable base URL the registry puts in
# redirect Location headers (used by some storage drivers) and in the token
# auth `service` matching. Leave empty unless a storage driver's redirects
# come back wrong.
# @type=url
REGISTRY_HTTP_HOST=

# http.relativeurls. When true, Location headers are relative instead of
# absolute. Needed behind some reverse proxies that rewrite the Host header.
# @type=boolean
REGISTRY_HTTP_RELATIVEURLS=false
