# Healthchecks v4.4 environment schema (@env-spec / varlock format).
#
# The compose pins healthchecks/healthchecks:v4.4 (released 2026-08-31). It is
# only days old, but it carries a security fix that outweighs the usual
# preference for the matured release (v4.3): the email-verification link no
# longer stays valid after the address it was issued for changes. The previous
# pin, v3.10, was an explicit tag but a 16-month-old build predating the
# Django 6 upgrade.
#
# Source: grep of `os.getenv` / `os.environ` / the `envbool`, `envint` and
# `envsecret` helpers across hc/settings.py at tag v4.4, plus docker/uwsgi.ini
# and docker/README.md for the container-only knobs. The env surface is
# unchanged from v4.3 (no key added, removed, renamed, or re-defaulted), but
# the Django 6.1 upgrade changed HOW the EMAIL_* keys are consumed; see the
# "Outgoing email" section.
#
# Healthchecks is Django. Three coercion helpers define the accepted spellings
# and they are strict:
#   * envbool(name, default) accepts ONLY "True", "False" or an empty string.
#     Any other value (`true`, `1`, `yes`) raises ImproperlyConfigured at
#     import time and the container never starts. Every boolean below is
#     typed as that closed set, not as @type=boolean, because lowercase is a
#     hard boot failure.
#   * envint(name, default) parses an int, with the literal string "None"
#     meaning "no limit / unset". Those keys carry no @type so the editor does
#     not reject the sentinel.
#   * envsecret(name) reads <NAME>_FILE as a path first and falls back to the
#     variable. If <NAME>_FILE is set but unreadable it raises
#     ImproperlyConfigured rather than silently falling back. Added in v3.13;
#     every _FILE twin below exists because its base key goes through
#     envsecret, not because it is special-cased anywhere.
#
# Where the docs and the code disagree, the code wins:
#   * The configuration reference's anchor for the master-badge label is still
#     `#MASTER_BADGE_URL`; the variable v4.4 actually reads is
#     MASTER_BADGE_LABEL. There is no MASTER_BADGE_URL in the code.
#   * The reference omits five variables settings.py reads: METRICS_KEY,
#     SUPPORT_EMAIL, EMAIL_MAIL_FROM_TMPL, STATSD_HOST and USE_GZIP_MIDDLEWARE.
#   * LISTEN_IPV6 and UWSGI_PROCESSES are read by docker/uwsgi.ini, not by
#     settings.py, and only exist in the official image.
#
# The compose prompts for SITE_ROOT, SECRET_KEY and POSTGRES_PASSWORD, and
# threads POSTGRES_PASSWORD into both DB_PASSWORD and the bundled Postgres.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Self-hosted configuration reference", https://healthchecks.io/docs/self_hosted_configuration/)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# The instance's own public base URL, with scheme and no trailing slash (a
# trailing slash is stripped). It is not cosmetic: PING_ENDPOINT, LOGIN_URL,
# STATIC_URL and the default ALLOWED_HOSTS are all derived from it, every
# ping URL shown in the UI and every link in an alert email is built from it,
# and a subpath (SITE_ROOT ending in /hc) is supported. Wrong here means users
# copy ping URLs that point somewhere else.
# @required
# @type=url
SITE_ROOT=

# Display name for this instance, used in page titles, email subjects, and
# the default MASTER_BADGE_LABEL.
SITE_NAME=Mychecks

# Absolute or site-relative URL of a logo image shown instead of the wordmark.
SITE_LOGO_URL=

# Label rendered on the "overall status" badge for a project. Defaults to
# SITE_NAME. The docs page anchors this section as `#MASTER_BADGE_URL`, which
# is a stale id. The variable is MASTER_BADGE_LABEL.
MASTER_BADGE_LABEL=

# Django's signing key for this instance. It signs session cookies, login
# ("magic link") tokens, email-verification and unsubscribe links, and the
# bounce-tracking signatures. The image ships the default "---" if unset, and
# any weak or shared value lets an attacker who knows it forge a session
# cookie or a login link for ANY account, including staff: a full
# authentication bypass with no password involved. Generate 64+ random
# characters, keep it out of version control, and rotate it by restarting
# (rotation logs everyone out and invalidates outstanding email links).
# @required
# @sensitive
# @type=string(minLength=32)
SECRET_KEY=

# Docker-secret twin: path INSIDE the container to a file holding the secret
# key. If set, it wins over SECRET_KEY; if the path is unreadable the app
# raises instead of falling back.
# @docs("Docker secrets", https://www.docker.com/blog/docker-secrets-management/)
SECRET_KEY_FILE=

# Django's DEBUG. The compose sets "False" and it must stay that way in
# production: DEBUG=True serves full tracebacks with local variables, settings
# and SQL to anyone who triggers an error, disables ALLOWED_HOSTS enforcement,
# and leaks the database password in the error page. Upstream's own default is
# "True", so this is a knob you can only get wrong by touching it.
# @required
# @type=enum(True, False)
# @docs("Django DEBUG", https://docs.djangoproject.com/en/6.1/ref/settings/#debug)
DEBUG=False

# Comma-separated Host header allowlist. The compose sets "*" (accept any
# Host), which is safe only because otterdeploy terminates and routes by
# hostname in front of the container; exposed directly it enables Host-header
# poisoning of the password-reset and login links Healthchecks emails out.
# Narrow it to your real hostname(s) once routing is fixed. If left EMPTY,
# v3.9+ derives it from the domain part of SITE_ROOT, which is the safer
# default.
# @required
# @docs("Django ALLOWED_HOSTS", https://docs.djangoproject.com/en/6.1/ref/settings/#allowed-hosts)
ALLOWED_HOSTS=*

# Whether strangers can create accounts on this instance. Upstream defaults to
# open. Set "False" after you have created your own account, otherwise your
# monitoring instance is a public sign-up form.
# @type=enum(True, False)
REGISTRATION_OPEN=True

# Enables the hosted-service billing UI (Stripe plans, invoices). Meaningless
# for a self-hosted instance; leave off.
# @type=enum(True, False)
USE_PAYMENTS=False

# Comma-separated email addresses that receive Django's server-error mail.
ADMINS=

# Address shown to users as the contact for this instance.
# @type=email
SUPPORT_EMAIL=

# Two comma-separated values, "HEADER,VALUE" (e.g.
# "HTTP_X_FORWARDED_PROTO,https"), telling Django the request was HTTPS at the
# proxy. Without it Django builds http:// URLs behind a TLS-terminating proxy
# and marks session cookies as non-secure. Only set it if the proxy in front
# strips client-supplied copies of that header.
# @docs("Django SECURE_PROXY_SSL_HEADER", https://docs.djangoproject.com/en/6.1/ref/settings/#secure-proxy-ssl-header)
SECURE_PROXY_SSL_HEADER=

# Appends Django's GZipMiddleware. Only useful when nothing in front of the
# container already compresses responses.
# @type=enum(True, False)
USE_GZIP_MIDDLEWARE=False

# Name of a request header carrying an already-authenticated username, for
# putting Healthchecks behind an external SSO proxy. Setting it REPLACES all
# normal authentication backends with CustomHeaderBackend: anyone who can send
# that header to the container is logged in as that user, so the container must
# be unreachable except through the proxy that sets it.
REMOTE_USER_HEADER=

# ─── Pings ─────────────────────────────────────────────────────────────────

# Base URL handed to users for their ping URLs. Defaults to SITE_ROOT + "/ping/".
# Override only when pings should arrive on a different hostname than the UI.
# @type=url
PING_ENDPOINT=

# Domain part of the "ping by email" addresses (<uuid>@this-domain). Only
# meaningful when the SMTP listener is running; see SMTPD_PORT.
PING_EMAIL_DOMAIN=localhost

# Max bytes of a ping request body kept per ping. Read with envint, so the
# literal string "None" means "store the whole body, no limit". Values above
# 2621440 also raise Django's DATA_UPLOAD_MAX_MEMORY_SIZE to match.
PING_BODY_LIMIT=10000

# ─── Database ──────────────────────────────────────────────────────────────
# Setting DB to "postgres" is what switches Healthchecks off its default
# embedded SQLite file. Migrations run automatically on every boot
# (docker/uwsgi.ini: `hook-pre-app = exec:./manage.py migrate`).

# Database engine selector. Only "postgres", "mysql" and "mariadb" change
# anything; any other value (or unset) leaves the SQLite default in place,
# which would silently ignore every DB_* value below.
# @required
# @type=enum(postgres, mysql, mariadb)
DB=postgres

# Hostname of the bundled Postgres on the stack's private network, resolved
# by otterdeploy, never typed by hand.
# @required
DB_HOST=${{stack.db.HOST}}

# @required
# @type=port
DB_PORT=5432

# @required
DB_NAME=healthchecks

# @required
DB_USER=healthchecks

# Password for DB_USER, taken from the prompted POSTGRES_PASSWORD so the app
# and the database container always agree.
# @required
# @sensitive
DB_PASSWORD=${POSTGRES_PASSWORD}

# Docker-secret twin: path inside the container to a file holding the database
# password. Wins over DB_PASSWORD when set.
DB_PASSWORD_FILE=

# Seconds a database connection is reused before being closed. "0" opens a
# fresh connection per request; the string "None" means unlimited persistent
# connections. Raise it only if you have a connection pooler or headroom in
# Postgres's max_connections: Healthchecks runs sendalerts and sendreports as
# extra long-lived processes.
DB_CONN_MAX_AGE=0

# libpq sslmode for the Postgres connection. The bundled database is reachable
# only on the stack's private network, so "prefer" is fine; an external managed
# Postgres usually wants "require" or stricter.
# @type=enum(disable, allow, prefer, require, verify-ca, verify-full)
DB_SSLMODE=prefer

# libpq target_session_attrs, for pointing at a replica set and demanding a
# writable node.
# @type=enum(any, read-write, read-only, primary, standby, prefer-standby)
DB_TARGET_SESSION_ATTRS=read-write

# ─── Bundled Postgres ──────────────────────────────────────────────────────
# The stack runs its own postgres:17-alpine beside the app; these three
# initialize that container's role and database on first boot only. Changing
# them later does not rename anything in an existing volume.

POSTGRES_USER=healthchecks

# Password for that role, used by both the database container and DB_PASSWORD.
# Only reachable on the stack's private network, but a weak value is still a
# full read/write path to every check, ping history, API key hash and account
# record for anything else that lands on that network.
# @required
# @sensitive
POSTGRES_PASSWORD=

POSTGRES_DB=healthchecks

# ─── Outgoing email ────────────────────────────────────────────────────────
# Healthchecks sends login links, email verification, alerts and reports over
# SMTP. EMAIL_HOST is the switch for the whole section: v4.4 moved onto Django
# 6.1's MAILERS setting and only builds a mailer when EMAIL_HOST is non-empty,
# so with it blank the other EMAIL_* keys below are never read at all. An
# instance with no mailer starts fine but emits the `hc.api.W002` system-check
# warning on boot, hides the "email me a login link" form entirely, and
# asserts if anything tries to send. Since the magic link is the only way in
# when no password is set, configure this before you need it.
# @docs("Django MAILERS", https://docs.djangoproject.com/en/6.1/ref/settings/#mailers)
EMAIL_HOST=

# Read with envint; "None" is accepted and means unset. Only consulted when
# EMAIL_HOST is set.
EMAIL_PORT=587

EMAIL_HOST_USER=

# @sensitive
EMAIL_HOST_PASSWORD=

# Docker-secret twin: path inside the container to a file holding the SMTP
# password. Wins over EMAIL_HOST_PASSWORD when set.
EMAIL_HOST_PASSWORD_FILE=

# STARTTLS on a plaintext port (usually 587). Mutually exclusive with
# EMAIL_USE_SSL.
# @type=enum(True, False)
EMAIL_USE_TLS=True

# Implicit TLS from the first byte (usually port 465). Do not enable together
# with EMAIL_USE_TLS.
# @type=enum(True, False)
EMAIL_USE_SSL=False

# Whether a newly entered email address must be confirmed by clicking a link
# before it is used. Unlike the rest of this section it is read regardless of
# EMAIL_HOST. Turning it off means a typo'd or hostile address is trusted
# immediately; v4.4 hardened exactly this path by binding the verification
# link to the address it was issued for, so a link no longer stays valid after
# the pending address changes. Only set "False" on
# an instance where every account is created by you.
# @type=enum(True, False)
EMAIL_USE_VERIFICATION=True

# Python format template for the SMTP envelope sender, e.g.
# "bounces+%s@example.org", where %s is the per-message bounce token. Enables
# bounce tracking. Undocumented on the configuration reference page.
EMAIL_MAIL_FROM_TMPL=

# Address the "From" header uses.
# @type=email
DEFAULT_FROM_EMAIL=healthchecks@example.org

# ─── Container / uWSGI ─────────────────────────────────────────────────────
# Read by docker/uwsgi.ini in the official image, not by settings.py.
# @docs("Docker image notes", https://github.com/healthchecks/healthchecks/tree/v4.4/docker)

# If set to any non-empty value, the container ALSO runs the inbound SMTP
# listener on this port, so checks can be pinged by email. Unset, the listener
# does not run at all. The compose exposes only 8000, so this port would need
# publishing too.
SMTPD_PORT=

# Any non-empty value switches the HTTP socket from 0.0.0.0:8000 to
# [::]:8000. The stack's network is IPv4, so leaving this empty is correct;
# setting it makes the container unreachable.
LISTEN_IPV6=

# uWSGI worker process count. Defaults to 4 when unset. Lower it on a small
# instance, since each worker is a full Django process holding its own
# database connection.
# @type=number
UWSGI_PROCESSES=

# ─── Metrics ───────────────────────────────────────────────────────────────

# Shared secret for the Prometheus metrics endpoint, sent as the
# X-Metrics-Key header or as a Bearer token. If EMPTY the endpoint is disabled
# entirely (it returns 404), which is the safe default. Set it only when you
# have a scraper, since the metrics expose every check name and status.
# @sensitive
# @docs("Prometheus metrics", https://healthchecks.io/docs/configuring_prometheus/)
METRICS_KEY=

# Whether the Prometheus integration is offered in the UI at all.
# @type=enum(True, False)
PROMETHEUS_ENABLED=True

# "host" or "host:port" of a statsd collector for internal timing metrics.
# Undocumented on the configuration reference page.
STATSD_HOST=

# ─── Object storage for ping bodies (optional S3) ──────────────────────────
# Without these, large ping bodies are stored in Postgres. All of
# S3_ENDPOINT, S3_BUCKET and the credentials must be present for the S3 path
# to activate; v3.10+ backs off from GetObject calls after repeated errors.
# @docs("S3-compatible API", https://developers.cloudflare.com/r2/api/s3/api/)

S3_ACCESS_KEY=

# @sensitive
S3_SECRET_KEY=

# Docker-secret twin: path inside the container to a file holding the S3
# secret key.
S3_SECRET_KEY_FILE=

# @type=url
S3_ENDPOINT=

S3_REGION=

S3_BUCKET=

# Per-request timeout in seconds, read with envint ("None" accepted).
S3_TIMEOUT=60

# TLS to the object store. Only turn off for a plaintext endpoint on a trusted
# private network.
# @type=enum(True, False)
S3_SECURE=True

# ─── WebAuthn ──────────────────────────────────────────────────────────────

# Relying Party ID for hardware-key / passkey second factors: the registrable
# domain of SITE_ROOT, with no scheme and no port (e.g. "checks.example.org").
# Leave EMPTY to disable WebAuthn entirely. A mismatch with the browser's
# origin makes every registered key fail to verify, and credentials registered
# under one RP_ID cannot be used after it changes.
# @docs("Web Authentication API", https://developer.mozilla.org/en-US/docs/Web/API/Web_Authentication_API)
RP_ID=

# ─── Notification integrations ─────────────────────────────────────────────
# The *_ENABLED flags only decide whether an integration is offered in the
# "Add integration" UI; they need no credentials. The ones with client
# IDs/secrets are dead without them, whatever the flag says.

# Routes notifications through an Apprise instance. Requires the optional
# `apprise` package, which the official image does not install, so enabling
# this on the stock image has no effect.
# @type=enum(True, False)
# @docs("Apprise", https://github.com/caronc/apprise)
APPRISE_ENABLED=False

# Discord OAuth app credentials, from the Discord developer portal. Both are
# required for the Discord integration to appear and complete its OAuth flow.
# @docs("Discord developer portal", https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
# @sensitive
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_SECRET_FILE=

# GitHub App credentials for the "GitHub issues" integration added in v3.10.
# GITHUB_PRIVATE_KEY is the App's PEM private key. It authenticates AS the
# App, so anyone holding it can act on every repository the App is installed
# on. Prefer the _FILE form and mount it as a secret; a PEM does not survive a
# single-line env var without escaping anyway.
# @docs("GitHub Apps", https://github.com/settings/apps)
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_SECRET_FILE=
# @sensitive
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=
# Public "install this App" URL shown to users.
# @type=url
GITHUB_PUBLIC_LINK=

# Matrix bot account used to post alerts. v4.0 moved this to the Matrix v3
# API. The access token is a long-lived credential for that bot account.
# @docs("Matrix", https://matrix.org/docs/guides/)
# @type=url
MATRIX_HOMESERVER=
MATRIX_USER_ID=
# @sensitive
MATRIX_ACCESS_TOKEN=
MATRIX_ACCESS_TOKEN_FILE=

# @type=enum(True, False)
MATTERMOST_ENABLED=True

# @type=enum(True, False)
MSTEAMS_ENABLED=True

# Default ntfy.sh access token, added in v3.12, used when a user does not
# supply their own. Only needed for protected topics.
# @sensitive
# @docs("ntfy access tokens", https://ntfy.sh/docs/config/)
NTFY_SH_TOKEN=
NTFY_SH_TOKEN_FILE=

# @type=enum(True, False)
OPSGENIE_ENABLED=True

# @type=enum(True, False)
PAGERTREE_ENABLED=True

# @type=enum(True, False)
PD_ENABLED=True
# PagerDuty app id; set it to use PagerDuty's "Connect" OAuth flow instead of
# asking users to paste an integration key.
PD_APP_ID=

# Pushover application token plus the subscription URL users are sent to. Both
# are needed; the integration is hidden without the token.
# @sensitive
# @docs("Pushover API", https://www.pushover.net/api)
PUSHOVER_API_TOKEN=
PUSHOVER_API_TOKEN_FILE=
# @type=url
PUSHOVER_SUBSCRIPTION_URL=
# Seconds between retries of an emergency-priority notification.
# @type=number
PUSHOVER_EMERGENCY_RETRY_DELAY=300
# Seconds an unacknowledged emergency notification keeps retrying.
# @type=number
PUSHOVER_EMERGENCY_EXPIRATION=86400

# Pushbullet OAuth app credentials.
PUSHBULLET_CLIENT_ID=
# @sensitive
PUSHBULLET_CLIENT_SECRET=
PUSHBULLET_CLIENT_SECRET_FILE=

# @type=enum(True, False)
ROCKETCHAT_ENABLED=True

# Lets users attach arbitrary SHELL COMMANDS to a check, executed inside this
# container by the sendalerts process, with the check's name and last ping body
# interpolated in. Off by default for good reason: it turns any account that
# can edit a check into remote code execution on the container. Only enable on
# a single-operator instance.
# @type=enum(True, False)
SHELL_ENABLED=False

# Path to a signal-cli JSON-RPC socket (or "host:port") for Signal
# notifications. Requires running signal-cli yourself; the image does not.
# @docs("signal-cli", https://github.com/AsamK/signal-cli)
SIGNAL_CLI_SOCKET=

# Slack OAuth app credentials, used only for the "Add to Slack" button.
# SLACK_ENABLED alone still allows incoming-webhook style integrations.
# @docs("Slack apps", https://api.slack.com/apps)
SLACK_CLIENT_ID=
# @sensitive
SLACK_CLIENT_SECRET=
SLACK_CLIENT_SECRET_FILE=
# @type=enum(True, False)
SLACK_ENABLED=True

# @type=enum(True, False)
SPIKE_ENABLED=True

# Telegram bot identity from BotFather. The token is the whole bot: it can read
# and send every message that bot receives. The bot name is only what the UI
# tells users to add.
# @docs("BotFather", https://core.telegram.org/bots/features#botfather)
TELEGRAM_BOT_NAME=ExampleBot
# @sensitive
TELEGRAM_TOKEN=
TELEGRAM_TOKEN_FILE=

# Twilio credentials for SMS / voice-call / WhatsApp alerts. TWILIO_AUTH is the
# account auth token. It can spend money on the account, so scope it to a
# subaccount if you can.
# @docs("Twilio Messaging Services", https://www.twilio.com/docs/messaging/services)
TWILIO_ACCOUNT=
# @sensitive
TWILIO_AUTH=
TWILIO_AUTH_FILE=
# Sending number in E.164 form.
TWILIO_FROM=
# Use a Messaging Service SID instead of a single "from" number.
TWILIO_MESSAGING_SERVICE_SID=
# @type=enum(True, False)
TWILIO_USE_WHATSAPP=False
# WhatsApp template ("content") SIDs for the down/up messages. Required by
# WhatsApp for business-initiated messages; without them WhatsApp alerts fail.
WHATSAPP_DOWN_CONTENT_SID=
WHATSAPP_UP_CONTENT_SID=

# Trello API key, from https://trello.com/power-ups/admin (the older
# /app-key page now requires a login). Enables the Trello integration's OAuth
# flow.
# @sensitive
TRELLO_APP_KEY=
TRELLO_APP_KEY_FILE=

# @type=enum(True, False)
VICTOROPS_ENABLED=True

# @type=enum(True, False)
WEBHOOKS_ENABLED=True

# Whether outbound webhook / HTTP integrations may target private and
# loopback addresses. Off by default: leaving it off is the SSRF guard that
# stops a user-defined webhook from reaching other services on the stack's
# private network or a cloud metadata endpoint. Enable only if you genuinely
# need to call an internal host and you trust everyone with an account.
# @type=enum(True, False)
INTEGRATIONS_ALLOW_PRIVATE_IPS=False

# @type=enum(True, False)
ZULIP_ENABLED=True
