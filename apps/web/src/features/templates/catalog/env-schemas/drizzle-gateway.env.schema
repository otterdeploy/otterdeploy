# Drizzle Gateway 1.6.0 environment schema (@env-spec / varlock format).
#
# Drizzle Gateway is CLOSED SOURCE. `org.opencontainers.image.source` on the
# image points at github.com/drizzle-team/drizzle-gate, which 404s (private),
# and there is no public repo, no GitHub releases, and no tarball to grep.
# Per AUTHORING.md this schema therefore falls back to the documented
# configuration reference (gateway.drizzle.team/docs), CROSS-CHECKED against
# the shipped image itself: `docker export ghcr.io/drizzle-team/gateway:1.6.0`
# and a grep of `process.env.*` over the bundled /entry/index.js and
# /entry/healthcheck.js. Everything below is a read that exists in that
# bundle; nothing here is inferred from a docs page alone.
#
# The whole surface the application reads is five things: PORT, STORE_PATH,
# MASTERPASS, JWT_SECRET, and any `DATABASE_URL_*` variables. The docs page
# lists only the first three. The other two are real reads the docs never
# mention. Everything else about a connection is configured in the UI and
# persisted to the store file, not through the environment.
#
# SECURITY: READ THIS BEFORE DEPLOYING. Gateway is a database client with a
# web UI: whoever reaches it can browse, edit, insert, delete and run
# arbitrary SQL against every database attached to it, and can attach new
# ones by pasting a connection string. MASTERPASS is the ONLY authentication
# it has, and in the bundle it is optional: `pd = process.env.MASTERPASS ?
# ... : null`, and every privileged route is guarded by `if (Yn && !s) return
# 403`. With MASTERPASS unset, `Yn` is null and that guard never fires, so
# the UI and its whole API are open to anyone who can reach the port, with no
# login at all. That includes the `env:list` / `env:get` API routes, which
# return the value of ANY environment variable in the container (only
# MASTERPASS itself is filtered out), so an unauthenticated instance leaks
# JWT_SECRET and every DATABASE_URL_* connection string it was given. This
# template prompts for GATEWAY_MASTERPASS for exactly that reason: treat it
# as mandatory, not optional, and put the service behind your own auth or a
# private network on top.
#
# MATURITY: version 1.0.0 shipped 2025-08-04 and 1.6.0 on 2026-08-28, so
# releases are real and numbered rather than a bare `latest`, but there is
# no source, no advisory feed and no CVE process. The changelog is a web
# page, and the 1.6.0 entry reads, in full, "Improved security." An operator
# is signing up for a closed binary from a vendor R2 bucket / GHCR, with
# upgrades that cannot be diffed.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Drizzle Gateway: Docker", https://gateway.drizzle.team/docs/docker)
# ---

# ─── Storage ──────────────────────────────────────────────────────────────

# Root directory for Gateway's store file (`store.json`). Saved connections,
# sessions, the passcode hash and the generated JWT secret all live there.
# The compose sets it to /app, which is also the bundle's own default in a
# container, and mounts the `drizzle-gateway-data` volume at that same path;
# changing this without moving the volume mount loses every saved connection
# on restart. The `/health` endpoint reports unhealthy if `${STORE_PATH}/
# store.json` is not readable AND writable.
#
# First boot only (when the store has no `id` yet, i.e. a fresh volume),
# Gateway scans for `DATABASE_URL_<NAME>` variables and seeds one connection
# per match, so `DATABASE_URL_ANALYTICS` becomes a connection named
# "ANALYTICS". The dialect is sniffed from the value: `postgres…` →
# postgresql, `mysql…` → mysql, a path ending `.db`/`.sqlite`/`.sqlite3` →
# sqlite; anything else is silently skipped. The store keeps the literal
# `${DATABASE_URL_<NAME>}` reference rather than the URL, so the variable
# must stay set. The connection throws "Environment variable … is not
# defined" if it is later removed. These are per-deployment names, so they
# cannot be enumerated here; add them as extra variables yourself. They are
# connection strings with credentials in them: treat every one as sensitive,
# and see the security note in the header about `env:get` exposing them.
# @docs("How It Works", https://gateway.drizzle.team/docs/how-it-works)
STORE_PATH=/app

# ─── Access control ───────────────────────────────────────────────────────

# The master password for the admin UI. Set it. Unset, Gateway serves its
# entire UI and API (including "run this SQL" and "read my environment")
# with no authentication whatsoever. Set, it gates every privileged route and
# also unlocks the passcode feature (a second, weaker credential you can hand
# out that cannot change the passcode itself). Wired from GATEWAY_MASTERPASS
# below; it is never returned by the `env:get` route.
# @required @sensitive
# @docs("How It Works", https://gateway.drizzle.team/docs/how-it-works)
MASTERPASS=${GATEWAY_MASTERPASS}

# What the template prompts for at install; its value becomes MASTERPASS.
# Choose something long: this single string is all that stands between the
# public internet and full read/write access to every attached database.
# @required @sensitive @type=string(minLength=16)
GATEWAY_MASTERPASS=

# Signing key for the session JWTs the UI issues. Optional: if unset, Gateway
# generates one on first boot and persists it into the store file, which is
# the right behaviour for a single container with a durable volume. Set it
# only if you need sessions to survive the volume being recreated, or to
# share sessions across replicas. Changing it invalidates every live session.
# Undocumented upstream; read directly in the 1.6.0 bundle.
# @sensitive @type=string(minLength=32)
JWT_SECRET=

# ─── Networking ───────────────────────────────────────────────────────────

# Port the HTTP server binds, on 0.0.0.0 (the bind address is hardcoded).
# The compose publishes container port 4983, which is this default, and the
# image's healthcheck script reads PORT itself, so overriding it here
# without also changing the published port breaks both routing and the
# container health check.
# @type=port
PORT=4983

# ─── PostgreSQL client fallbacks ──────────────────────────────────────────
# Not Gateway's own configuration: these are read by the bundled node-postgres
# driver for any field a saved connection leaves blank. The rest of the libpq
# family (PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE, …) is resolved the
# same way, dynamically as `process.env["PG" + field]`, so it cannot be
# enumerated here. Normally you want none of this and configure connections
# in the UI, but a container-wide PGSSLMODE is the usual fix for a Postgres
# with a self-signed certificate.

# TLS mode used when a connection specifies no sslmode of its own.
# `no-verify` connects over TLS without validating the server certificate.
# @type=enum(disable, prefer, require, verify-ca, verify-full, no-verify)
# @docs("node-postgres: Connecting", https://node-postgres.com/features/connecting)
PGSSLMODE=

# Connection timeout in SECONDS (not milliseconds) for Postgres connections
# that set no timeout of their own. 0 means wait indefinitely.
# @type=number
PGCONNECT_TIMEOUT=
