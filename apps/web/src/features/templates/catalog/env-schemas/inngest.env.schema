# Inngest v1.44.0 environment schema (@env-spec / varlock format).
#
# Source: the flag definitions for `inngest start` in cmd/start/cmd.go at
# tag v1.44.0, plus cmd/internal/config/config.go, which is the only thing
# that turns those flags into environment variables. Inngest is Go/koanf
# (not viper): every CLI flag has an env twin built by stripping `INNGEST_`,
# lowercasing, and mapping `_` to `-`, so `--postgres-uri` is
# INNGEST_POSTGRES_URI. Precedence is flag > env > config file > default.
# Cross-checked with a grep of os.Getenv/os.LookupEnv across pkg/ and cmd/,
# which is where the handful of un-prefixed variables at the bottom of this
# file come from.
#
# PRODUCTION / PERSISTENCE: the fact an operator needs first. `inngest
# start` is the self-host entrypoint (`inngest dev` is the throwaway one),
# and at v1.44.0 its usage string reads "Run the Inngest server with
# external persistence"; the "[Beta] Run Inngest as a single-node service"
# wording still printed on the self-hosting docs page is stale help output.
# Self-hosting is supported as of the 1.0 release, but Inngest's support
# team explicitly does not guarantee support for self-hosted instances.
# Out of the box `inngest start` keeps the queue and run state in a Redis
# server running *inside its own process* and everything else in SQLite at
# ./.inngest/main.db, inside the container, on no volume, so a restart
# loses every app, function, event and run. THIS stack does not run that
# way: the compose sets INNGEST_POSTGRES_URI and INNGEST_REDIS_URI, which
# fully replace both (devserver.go only builds the SQLite/in-process paths
# when those are empty), so history lands in the bundled Postgres volume
# and queue + in-flight run state in the bundled Redis volume. Blank either
# one and you are back to in-container storage that does not survive a
# restart.
#
# SECURITY: `inngest start` refuses to boot without both a signing key and
# at least one event key (start.go exits 1 on either), and /e/{key} rejects
# an unrecognised event key with 401, so event ingestion IS authenticated.
# The dashboard is not. The SPA fallback, the GraphQL endpoint /v0/gql and
# the GraphQL playground at /v0/ are registered outside the signing-key
# middleware (pkg/devserver/api.go, pkg/coreapi/coreapi.go); only the v0
# REST routes, the v1 API and the connect mount are behind it. Anyone who
# can reach port 8288 can therefore read every app, function, event payload
# and the full run history (step inputs and outputs included) and drive
# GraphQL mutations, with no login anywhere. Keep 8288 private or behind
# the platform's own auth; INNGEST_NO_UI=true removes the UI and GraphQL.
#
# Two more things the docs get wrong at this tag: `--poll-interval` prints
# "(default: 0)" but start.go passes DefaultPollInterval and
# devserver/service.go coerces 0 to 5, so app-sync polling cannot actually
# be switched off; and the published `--help` omits the connect gRPC flags
# below. INNGEST_DEV and INNGEST_BASE_URL are SDK-side variables for your
# application container. The server never reads them, so they are not here.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Self-hosting Inngest", https://www.inngest.com/docs/self-hosting)
# ---

# ─── Core ──────────────────────────────────────────────────────────────────

# Port for the Event API, REST/GraphQL API and dashboard, all on one
# listener. The compose exposes container port 8288 with no override, so
# this is that port's twin. Hazard: integer options are read by koanf key
# EXISTENCE, so a present-but-blank value parses as 0 and binds a random
# port rather than falling back to 8288. Leave it unset or give it a real
# number.
# @type=port
# @docs("inngest start flags (v1.44.0)", https://github.com/inngest/inngest/blob/v1.44.0/cmd/start/cmd.go)
INNGEST_PORT=8288

# Address to bind to. Empty means the compiled default 0.0.0.0, which is
# what container port publishing needs; setting 127.0.0.1 here makes the
# service unreachable from outside the container.
INNGEST_HOST=

# Disables the dashboard UI *and* the GraphQL API/playground. Since neither
# is authenticated (see header), this is the one switch that closes that
# hole without a proxy, at the cost of having no run history view at all.
# @type=boolean
INNGEST_NO_UI=false

# Comma-separated serve endpoints of your own apps for the server to sync
# functions from, e.g. http://my-app:3000/api/inngest. Optional: apps that
# use the SDK's outbound sync or connect register themselves instead.
INNGEST_SDK_URL=

# Path to an inngest.yaml / inngest.json / inngest.toml holding the same
# options in file form (lowest precedence, env still wins). Unset, the
# server walks up from the working directory and then ~/.config/inngest
# looking for one; nothing in this image ships one.
# @docs("INNGEST_ env binding (v1.44.0)", https://github.com/inngest/inngest/blob/v1.44.0/cmd/internal/config/config.go)
INNGEST_CONFIG=

# ─── Authentication ────────────────────────────────────────────────────────

# Pre-shared secret between the server and your apps: it signs and verifies
# every server-to-SDK request and authenticates SDK calls to the v0/v1 REST
# APIs and the connect gateway. Must be a hex string with an even number of
# characters (`openssl rand -hex 32`); anything else and the process exits
# at startup. It does NOT protect the dashboard or GraphQL. Blast radius if
# leaked: an attacker can impersonate the server to your app endpoints and
# call the authenticated management APIs: cancelling, replaying and
# rescheduling runs.
# @required
# @sensitive
# @type=string(matches=/^[0-9a-fA-F]+$/)
# @docs("Signing keys", https://www.inngest.com/docs/platform/signing-keys)
INNGEST_SIGNING_KEY=

# The key(s) apps present when publishing events, as the path segment of
# POST /e/{key}. At least one is required or the server exits at startup;
# comma-separate to accept several. Blast radius if leaked: anyone can
# inject arbitrary events and therefore trigger any function in the system.
# @required
# @sensitive
# @docs("Creating an Event Key", https://www.inngest.com/docs/events/creating-an-event-key)
INNGEST_EVENT_KEY=

# ─── Persistence ───────────────────────────────────────────────────────────

# Postgres DSN for system data and history (apps, functions, events, run
# results and traces). Assembled by the compose from the prompted
# POSTGRES_PASSWORD and the bundled database's hostname. Blank it and the
# server silently falls back to SQLite inside the container, on no volume,
# which is wiped on every restart.
# @required
# @sensitive
# @docs("Using external services", https://www.inngest.com/docs/self-hosting)
INNGEST_POSTGRES_URI=postgres://inngest:${POSTGRES_PASSWORD}@${{stack.postgres.HOST}}:5432/inngest

# Redis URI for the queue and run state, pointed at the bundled Redis by
# the compose. Blank it and the server runs Redis in-process instead, with
# only periodic snapshots into SQLite. Do not do that here. Note that
# in-flight run state lives in Redis, so its durability is the bundled
# redis:7-alpine's default RDB snapshotting: a hard kill can lose the last
# snapshot window of in-progress steps even though history in Postgres is
# intact.
# @required
# @sensitive
INNGEST_REDIS_URI=redis://${{stack.redis.HOST}}:6379

# Directory for the SQLite database, used only when INNGEST_POSTGRES_URI is
# empty. With Postgres configured, as it is here, this is dead. Set it
# only if you deliberately drop Postgres, and then mount a volume at it.
INNGEST_SQLITE_DIR=

# Idle connections kept in the Postgres pool. Must not exceed
# INNGEST_POSTGRES_MAX_OPEN_CONNS or the process exits at startup.
# @type=number
INNGEST_POSTGRES_MAX_IDLE_CONNS=10

# Ceiling on open Postgres connections. Must be greater than 1 or the
# process exits at startup, which is what a present-but-blank value gives
# you, since a blank integer parses as 0 rather than falling back to 100.
# The bundled postgres:17-alpine allows 100 connections total, so this
# default already consumes the whole budget if the pool ever fills.
# @type=number
INNGEST_POSTGRES_MAX_OPEN_CONNS=100

# Minutes a pooled Postgres connection may sit idle before being closed.
# @type=number
INNGEST_POSTGRES_CONN_MAX_IDLE_TIME=5

# Minutes a pooled Postgres connection may be reused before being retired.
# @type=number
INNGEST_POSTGRES_CONN_MAX_LIFETIME=30

# ─── Bundled Postgres ──────────────────────────────────────────────────────

# Role the Postgres image creates on first boot; baked into
# INNGEST_POSTGRES_URI above, so changing it here alone only breaks the
# pair.
POSTGRES_USER=inngest

# Password for that role. Only reachable on the stack's private network,
# but it is a full read/write path to every event payload and every step
# input and output the server has recorded.
# @required
# @sensitive
POSTGRES_PASSWORD=

# Database created on first boot. Baked into INNGEST_POSTGRES_URI above.
POSTGRES_DB=inngest

# ─── Connect gateway ───────────────────────────────────────────────────────

# WebSocket port for apps that hold an outbound persistent connection
# instead of exposing a serve endpoint. The compose exposes container port
# 8289 with no override, so this is that port's twin.
# @type=port
# @docs("Connect", https://www.inngest.com/docs/setup/connect)
INNGEST_CONNECT_GATEWAY_PORT=8289

# Internal gRPC port the connect gateway listens on. Only matters if you
# run more than one server instance; nothing external needs to reach it.
# @type=port
INNGEST_CONNECT_GATEWAY_GRPC_PORT=50052

# Internal gRPC port the executor listens on, same caveat as above.
# @type=port
INNGEST_CONNECT_EXECUTOR_GRPC_PORT=50053

# Address other instances use to reach this gateway's gRPC server. Must
# parse as a literal IP. A hostname makes startup fail validation. The
# 127.0.0.1 default is correct for the single-instance stack here.
INNGEST_CONNECT_GATEWAY_GRPC_IP=127.0.0.1

# Address other instances use to reach this executor's gRPC server, same
# rules as above.
INNGEST_CONNECT_EXECUTOR_GRPC_IP=127.0.0.1

# ─── Executor tuning ───────────────────────────────────────────────────────

# Seconds between polls of each synced app URL for new or changed function
# definitions. The help text claims 0 disables polling. It does not: 0 is
# coerced back to 5, so polling always runs.
# @type=number
INNGEST_POLL_INTERVAL=5

# Executor workers pulling steps off the queue. The practical ceiling on
# concurrent step execution for this instance; raising it raises the load
# on both Redis and Postgres.
# @type=number
INNGEST_QUEUE_WORKERS=100

# Milliseconds between queue polls by the executor. Lower means snappier
# step pickup and more Redis traffic. A blank value parses as 0, which
# spins the executor, so give it a number or leave it unset.
# @type=number
INNGEST_TICK=150

# Seconds of linear backoff between function retries. 0 keeps the built-in
# backoff schedule; any override must be 1 or above.
# @type=number
INNGEST_RETRY_INTERVAL=0

# ─── Logging and telemetry ─────────────────────────────────────────────────

# Exposes the experimental Prometheus queue/lifecycle metrics. Off unless
# set to a truthy value; "0", "false" and "no" also count as off.
# @type=boolean
INNGEST_EXPERIMENTAL_PROM_METRICS=false

# Log verbosity: trace, debug, info, warn or error. Deliberately has no
# INNGEST_ prefix, and it takes precedence over the --log-level flag.
# @type=enum(trace, debug, info, warn, error)
LOG_LEVEL=info

# Log format. The server forces this to "json" on its own whenever stdout
# is not a TTY, which is always the case under compose, so setting it here
# changes nothing in this stack.
LOG_HANDLER=

# Any non-empty value opts the binary out of the anonymous usage telemetry
# it otherwise posts to Inngest (command invocations and dashboard loads),
# and also silences the update-version check.
DO_NOT_TRACK=
