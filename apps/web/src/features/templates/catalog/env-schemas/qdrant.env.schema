# Qdrant v1.13.4 environment schema (@env-spec / varlock format).
#
# Source: grep of env::var / clap `env =` / config-rs Environment across src/
# and lib/ at v1.13.4. Qdrant has no per-variable env list: settings.rs loads
# `Environment::with_prefix("QDRANT").separator("__")`, so ANY key in
# config/config.yaml is reachable as QDRANT__<SECTION>__<KEY>. Only the keys
# this template sets, plus the handful an operator of a single node plausibly
# touches, are declared here. The docs' configuration page omits the four
# bare reads outside that prefix (QDRANT_INIT_FILE_PATH, QDRANT_NUM_CPUS,
# RUN_MODE, and the cluster-only QDRANT_BOOTSTRAP / QDRANT_URI); the first
# two are listed below, the rest are single-node irrelevant.
#
# Qdrant ships with NO authentication: an instance without an api_key is an
# open read/write database with a dashboard. The key is required for that
# reason, not because the binary refuses to boot without it.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Qdrant configuration reference", https://qdrant.tech/documentation/guides/configuration/)
# ---

# ─── Core ────────────────────────────────────────────────────────────────

# The api-key every request must carry (`api-key: <key>` header or the
# `Authorization: Bearer` form). Generated at install; the value below is
# wired into QDRANT__SERVICE__API_KEY.
# @required @sensitive @type=string(minLength=32)
QDRANT_API_KEY=

# service.api_key. Rotating QDRANT_API_KEY rotates this; clients must follow.
# @docs("Qdrant authentication", https://qdrant.tech/documentation/guides/security/)
# @required @sensitive
QDRANT__SERVICE__API_KEY=${QDRANT_API_KEY}

# service.enable_tls. Off: the platform terminates TLS at its edge, and
# turning this on without a `tls:` cert/key block in the config makes the
# server fail to bind.
# @required @type=boolean
QDRANT__SERVICE__ENABLE_TLS=false

# telemetry_disabled. True stops the anonymous usage reports Qdrant sends
# by default.
# @docs("Qdrant telemetry", https://qdrant.tech/documentation/guides/telemetry/)
# @required @type=boolean
QDRANT__TELEMETRY_DISABLED=true

# ─── Optional service settings ───────────────────────────────────────────
# All map to `service:` keys in config.yaml; unset means the compiled-in
# default shown.

# service.read_only_api_key. A second key that may only read. Empty = none.
# @sensitive
QDRANT__SERVICE__READ_ONLY_API_KEY=

# service.jwt_rbac. Accept JWTs signed with QDRANT_API_KEY (HMAC-SHA256) as
# fine-grained bearer tokens. Qdrant warns at boot if the key is shorter
# than 32 bytes when this is on.
# @type=boolean
QDRANT__SERVICE__JWT_RBAC=false

# service.enable_cors. Browsers may query the REST API from any origin;
# required by the built-in dashboard when opened from a different host.
# @type=boolean
QDRANT__SERVICE__ENABLE_CORS=true

# service.max_request_size_mb. Cap on one POST body (batch upserts).
# @type=number
QDRANT__SERVICE__MAX_REQUEST_SIZE_MB=32

# service.http_port / service.grpc_port. The compose exposes 6333 and 6334;
# changing these without changing the ports block leaves nothing listening
# where the platform routes.
# @type=port
QDRANT__SERVICE__HTTP_PORT=6333
# @type=port
QDRANT__SERVICE__GRPC_PORT=6334

# Top-level log_level: TRACE, DEBUG, INFO, WARN, ERROR.
# @type=enum(TRACE, DEBUG, INFO, WARN, ERROR)
QDRANT__LOG_LEVEL=INFO

# ─── Misc (read directly, outside the QDRANT__ prefix) ───────────────────

# Path of the marker file written after first successful start; the
# greeting/first-run logic keys off its existence. Default .qdrant-initialized
# in the working dir.
QDRANT_INIT_FILE_PATH=

# Override the CPU count Qdrant sizes its thread pools from. Empty or 0 =
# detect from the container.
# @type=number
QDRANT_NUM_CPUS=
