# Cal.com 6.2.0 environment schema (@env-spec / varlock format).
#
# The compose now pins the OFFICIAL image, calcom/cal.com:v6.2.0. It used to
# run ghcr.io/dr34mw0rk5/calcom-web:latest, a third-party rebuild that no
# longer exists (the GHCR package 404s, so `latest` could not be resolved at
# all). v6.2.0 is the newest stable tag on Docker Hub (pushed 2026-03-02, same
# digest as `latest`); arm64 ships under the separate `v6.2.0-arm` tag.
#
# Source: grep of process.env across apps/web, apps/api/v2, packages/ and
# scripts/ at v6.2.0 (repo now redirects to github.com/calcom/cal.diy).
# Cross-checked against the 520-line .env.example, which is a superset of what
# this image reads. Where they disagree, the code wins:
#
#  - NEXT_PUBLIC_LICENSE_CONSENT is read by NOTHING at runtime in 6.2.0. It is
#    only a Dockerfile build ARG. The compose still sets it because every
#    self-hosting guide tells you to; it is inert on a prebuilt image.
#  - ZOOM_CLIENT_ID/SECRET, MS_GRAPH_CLIENT_ID/SECRET, ZOHOCRM_*, CLOSECOM_*
#    and friends appear only in packages/types/environment.d.ts (a type
#    declaration, not a read). Those app credentials are entered in the admin
#    app store (/settings/admin/apps), not in the environment, so they are not
#    declared here. Google, Daily, Stripe, Twilio, SendGrid, HubSpot and
#    Huddle01 genuinely are env-driven and are.
#  - DATABASE_HOST is in no .env.example section, but scripts/start.sh runs
#    `scripts/wait-for-it.sh ${DATABASE_HOST}` before `prisma migrate deploy`.
#    Leave it empty and wait-for-it exits immediately, so the first boot races
#    Postgres. The compose sets it; do not clear it.
#  - PGSSLMODE is listed upstream but read by libpq, never by Cal.com's code.
#
# BUILD-TIME CAVEAT, and it is the big one for a prebuilt image: Next.js
# inlines NEXT_PUBLIC_* into the client bundle when the image is built. Only
# NEXT_PUBLIC_WEBAPP_URL is fixed up at container start (start.sh rewrites the
# baked placeholder in .next/ via scripts/replace-placeholder.sh). Every other
# NEXT_PUBLIC_* below reaches server-side reads only; anything the browser
# renders from it (branding strings, PostHog key, Turnstile sitekey) keeps the
# value baked at build. Same for ORGANIZATIONS_ENABLED and
# NEXT_PUBLIC_SINGLE_ORG_SLUG, which apps/web/next.config.ts consumes to
# generate rewrites at build. Setting those here does not enable organizations
# on this image; they need a rebuild.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Self-hosting with Docker", https://cal.com/docs/self-hosting/docker)
# ---

# ─── Core ─────────────────────────────────────────────────────────────────

# The public URL you open Cal.com at, scheme included. Booking links, OAuth
# callbacks, ICS attachments and every emailed link are built from it, and
# start.sh rewrites the URL baked into the static bundle to match on boot, so
# it must be the address people actually browse to. Prompted at install.
# @required @type=url
CALCOM_URL=

# PLATFORM-OWNED: the same value, handed to the app. This is the one
# NEXT_PUBLIC_* the prebuilt image resolves at RUNTIME rather than build.
# @required @type=url
NEXT_PUBLIC_WEBAPP_URL=${CALCOM_URL}

# PLATFORM-OWNED. NextAuth's canonical origin for sign-in callbacks and
# CSRF checks. Upstream's own .env.example sets this to the bare webapp URL
# (not `<url>/api/auth`), which is what the compose does.
# @required @type=url
# @docs("NEXTAUTH_URL", https://next-auth.js.org/configuration/options#nextauth_secret)
NEXTAUTH_URL=${CALCOM_URL}

# Signs session JWTs and CSRF tokens. The build refuses to start without it
# (next.config.ts throws), and rotating it signs every user out. Generate with
# `openssl rand -base64 32`. Prompted at install.
# @required @sensitive @type=string(minLength=32)
NEXTAUTH_SECRET=

# AES-256 key that encrypts every stored calendar/app credential in the
# database. Must be 32 bytes. Change it after users have connected calendars
# and those credentials become undecryptable garbage. There is no re-key
# path. Generate with `openssl rand -base64 24`. Prompted at install.
# @required @sensitive @type=string(minLength=32)
CALENDSO_ENCRYPTION_KEY=

# Historically the "I accept the AGPL terms" flag. In 6.2.0 no code reads it;
# it survives as a Dockerfile build ARG only. Harmless, and left set because
# every self-hosting guide still asks for it.
NEXT_PUBLIC_LICENSE_CONSENT=agree

# Marketing-site URL used for footer/legal links. Left empty the build falls
# back to NEXT_PUBLIC_WEBAPP_URL (next.config.ts), so a self-hosted instance
# points at itself rather than at cal.com.
# @type=url
NEXT_PUBLIC_WEBSITE_URL=

# Parent domain for the session cookie, e.g. `.example.com`, so a session is
# shared across subdomains. Only needed for organizations or a split
# app/booking-page domain; empty scopes the cookie to the exact host.
NEXTAUTH_COOKIE_DOMAIN=

# Set to "1" to stop Cal.com phoning home with anonymous usage pings
# (packages/lib/telemetry.ts).
CALCOM_TELEMETRY_DISABLED=

# Overrides NODE_ENV for Cal.com's own environment checks only. Leave empty.
# @type=enum(production, development, test)
CALCOM_ENV=

# Baked into the image as "production". Anything else turns on dev behavior
# (verbose errors, relaxed TLS on SMTP) and is not meant for a deployed
# instance.
# @type=enum(production, development)
NODE_ENV=production

# Process timezone for the Node runtime. Not read by Cal.com's code, but the
# runtime honors it. Upstream's .env.example recommends UTC; empty inherits
# the container default, which is also UTC.
TZ=

# ─── Database (bundled Postgres) ──────────────────────────────────────────

# PLATFORM-OWNED: host:port of the sibling Postgres. scripts/start.sh feeds
# this to wait-for-it before running `prisma migrate deploy`; empty means it
# does not wait and the first boot can race the database.
# @required
DATABASE_HOST=${{stack.db.HOST}}:5432

# PLATFORM-OWNED: derived from the sibling db service, never written out.
# @required @sensitive
DATABASE_URL=postgresql://calcom:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/calcom

# PLATFORM-OWNED. The unpooled connection Prisma uses for migrations. It is
# identical to DATABASE_URL here because there is no PgBouncer in front.
# packages/prisma/auto-migrations.ts skips migrations entirely if it is unset.
# @required @sensitive
DATABASE_DIRECT_URL=postgresql://calcom:${POSTGRES_PASSWORD}@${{stack.db.HOST}}:5432/calcom

# Optional read-only replica for the Insights dashboards
# (packages/prisma/index.ts). Empty runs those queries on the primary.
# @sensitive
INSIGHTS_DATABASE_URL=

# Rows per batch when Cal.com chunks large writes/reads.
# @type=number
DATABASE_CHUNK_SIZE=25

# Bundled Postgres role, database and password. The password is generated at
# install and appears on both sides of the connection string above.
# @required
POSTGRES_USER=calcom
# @required @sensitive
POSTGRES_PASSWORD=
# @required
POSTGRES_DB=calcom

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
# packages/lib/serverConfig.ts picks a transport in this order: RESEND_API_KEY,
# then EMAIL_SERVER, then EMAIL_SERVER_HOST, then local `sendmail`, which does
# not exist in this image, so with none of these set every booking
# confirmation, reminder, password reset and team invite is silently dropped.
# @docs("Nodemailer SMTP options", https://nodemailer.com/smtp)

# The global From: address. next.config.ts warns at build when it is missing.
# @type=email
EMAIL_FROM=

# Display name on the From: header. Defaults to NEXT_PUBLIC_APP_NAME.
EMAIL_FROM_NAME=

# A complete nodemailer connection URL (smtps://user:pass@host:465). If set it
# wins over the EMAIL_SERVER_* fields below.
# @sensitive
EMAIL_SERVER=

EMAIL_SERVER_HOST=
# TLS is implicit only on 465; any other port is STARTTLS/plaintext.
# @type=port
EMAIL_SERVER_PORT=
# User and password are only applied together: set one alone and the
# transport is built with no auth at all.
EMAIL_SERVER_USER=
# @sensitive
EMAIL_SERVER_PASSWORD=

# Set this and Cal.com sends through Resend's SMTP instead, ignoring every
# EMAIL_SERVER_* value above.
# @sensitive
# @docs("Resend API keys", https://resend.com/docs/dashboard/api-keys/introduction)
RESEND_API_KEY=

# Inbox that the in-app feedback form delivers to.
# @type=email
SEND_FEEDBACK_EMAIL=

# Delay before the "awaiting payment" nudge goes out.
# @type=number
AWAITING_PAYMENT_EMAIL_DELAY_MINUTES=

# ─── Branding ─────────────────────────────────────────────────────────────
# Build-time on the client (see the header caveat): these change server-
# rendered strings and emails on a prebuilt image, not the client bundle.
# @docs("White labeling", https://cal.com/docs/self-hosting/guides/white-labeling/introduction)

NEXT_PUBLIC_APP_NAME=Cal.com
NEXT_PUBLIC_COMPANY_NAME=Cal.com, Inc.
# @type=email
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=help@cal.com

# Legal links in the footer and in emails. Empty points at cal.com's own
# terms and privacy policy, which is wrong for a self-hosted instance.
# @type=url
NEXT_PUBLIC_WEBSITE_TERMS_URL=
# @type=url
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=

# Raw HTML injected at the end of <body> on every page, for analytics
# snippets and the like. Trusted input only; it is not escaped.
NEXT_PUBLIC_BODY_SCRIPTS=

# ─── Sign-up & login ──────────────────────────────────────────────────────

# "true" closes public registration; existing users and invite links still
# work. The usual first move after creating your own account.
NEXT_PUBLIC_DISABLE_SIGNUP=

# Login with Google needs BOTH this set to "true" and GOOGLE_API_CREDENTIALS
# populated; either alone does nothing (next-auth-options.ts).
# @type=boolean
GOOGLE_LOGIN_ENABLED=false

# The whole `credentials.json` from a Google Cloud OAuth client, on one line.
# Also what switches the Google Calendar / Meet apps to "installed". Configure
# the OAuth client as Internal so outsiders cannot sign in to your instance.
# @sensitive
# @docs("Install the Google app", https://cal.com/docs/self-hosting/apps/install-apps/google)
GOOGLE_API_CREDENTIALS=

# "1"/"true" auto-joins new sign-ups to an existing organization when their
# email domain matches it.
ORGANIZATIONS_AUTOLINK=

# "true" lets team/org admins impersonate their members; "false" blocks it
# outright. The value is compared as a string, so only those two words count.
# @type=enum(true, false)
NEXT_PUBLIC_TEAM_IMPERSONATION=false

# ─── SAML / SSO (enterprise) ──────────────────────────────────────────────
# @docs("SSO setup", https://cal.com/docs/self-hosting/sso-setup)

# A SEPARATE Postgres database for the SAML Jackson tables. SSO is enabled
# only when this AND SAML_ADMINS are both set.
# @sensitive
SAML_DATABASE_URL=
# Comma-separated emails allowed to configure the SAML connection.
SAML_ADMINS=
# Extra client_secret checked during the OAuth 2.0 exchange.
# @sensitive
SAML_CLIENT_SECRET_VERIFIER=

# ─── Licence & hosted features ────────────────────────────────────────────

# Unlocks the /ee enterprise features (teams beyond the free tier, insights,
# admin controls) and is what usage reporting is keyed on.
# @sensitive
# @docs("License key", https://cal.com/docs/self-hosting/license-key)
CALCOM_LICENSE_KEY=

# Cal.com decides "am I self-hosted?" from the hostname in NEXT_PUBLIC_WEBAPP_URL
# (anything not under cal.com/.dev/.eu/.qa is self-hosted). Set this to force
# the hosted-only UI on. Almost always leave empty.
NEXT_PUBLIC_HOSTED_CAL_FEATURES=

# ─── Organizations ────────────────────────────────────────────────────────
# BUILD-TIME: next.config.ts reads ORGANIZATIONS_ENABLED and
# NEXT_PUBLIC_SINGLE_ORG_SLUG to generate subdomain rewrites. On a prebuilt
# image setting them here does not turn organizations on.
# @docs("Organization env variables", https://cal.com/docs/self-hosting/guides/organization/understanding-organization-env-variables)

ORGANIZATIONS_ENABLED=
# Serves one organization's booking pages from the root domain. Setting it
# also auto-enables ORGANIZATIONS_ENABLED and voids RESERVED_SUBDOMAINS.
NEXT_PUBLIC_SINGLE_ORG_SLUG=
# "1" exposes the self-serve org checkout, which needs Stripe.
NEXT_PUBLIC_ORG_SELF_SERVE_ENABLED=

# JSON array members, comma-separated and each double-quoted, WITHOUT the
# surrounding brackets, because the code parses `[${ALLOWED_HOSTNAMES}]`.
# Hostnames the app will answer organization subdomains on; subdomains it
# refuses to hand out. Both empty parse to [], which is correct for a
# single-tenant install.
ALLOWED_HOSTNAMES=
RESERVED_SUBDOMAINS=

# ─── Booking behaviour ────────────────────────────────────────────────────

# How long a slot stays reserved while a booker fills in the form.
# @type=number
NEXT_PUBLIC_MINUTES_TO_BOOK=5

# Cap the days of availability the booker loads per request. 0 means the
# default full range; lower it if slot queries get heavy.
# @type=number
NEXT_PUBLIC_BOOKER_NUMBER_OF_DAYS_TO_LOAD=0

# Granularity in minutes of the availability editor's time picker. Empty uses
# 15 in the schedule UI.
# @type=number
NEXT_PUBLIC_AVAILABILITY_SCHEDULE_INTERVAL=

# Comma-separated addresses that may never be added as booking guests.
BLACKLISTED_GUEST_EMAILS=

# Comma-separated domains exempt from the organizer-email privacy rules.
ORGANIZER_EMAIL_EXEMPT_DOMAINS=

# ─── Video & calendar integrations ────────────────────────────────────────
# @docs("Install apps when self-hosting", https://cal.com/docs/self-hosting/apps/install-apps/introduction)

# Presence of this key is what marks Cal Video (Daily.co) as installed and
# makes it the default location for new event types.
# @sensitive
# @docs("Install the Daily app", https://cal.com/docs/self-hosting/apps/install-apps/daily)
DAILY_API_KEY=
# Pin Daily rooms to one region, e.g. eu-central-1. Empty lets Daily choose.
DAILY_VIDEO_REGION=

# Google Calendar API key used only by the public-holidays lookup, separate
# from GOOGLE_API_CREDENTIALS.
# @sensitive
GOOGLE_CALENDAR_API_KEY=

# Shared secrets Cal.com requires back on incoming calendar push
# notifications, so a forged webhook cannot desync a calendar.
# @sensitive
GOOGLE_WEBHOOK_TOKEN=
# @sensitive
# @docs("Install the Microsoft app", https://cal.com/docs/self-hosting/apps/install-apps/microsoft)
MICROSOFT_WEBHOOK_TOKEN=

# Marks the HubSpot CRM app installed; the secret is entered in the admin app
# store, not here.
HUBSPOT_CLIENT_ID=

# Marks the Huddle01 video app installed.
# @sensitive
HUDDLE01_API_TOKEN=

# ─── Payments (Stripe) ────────────────────────────────────────────────────
# Paid bookings need all three of STRIPE_CLIENT_ID, NEXT_PUBLIC_STRIPE_PUBLIC_KEY
# and STRIPE_PRIVATE_KEY; the app-store entry stays hidden until then
# (packages/lib/constants.ts).
# @docs("Install the Stripe app", https://cal.com/docs/self-hosting/apps/install-apps/stripe)

# Secret key (sk_live_… / sk_test_…).
# @sensitive
STRIPE_PRIVATE_KEY=
# Publishable key (pk_live_…). Build-time on the client (see the header).
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# The Stripe Connect application's client id (ca_…), used for the OAuth
# connect flow.
STRIPE_CLIENT_ID=
# Signing secret (whsec_…) for the payment webhook endpoint.
# @sensitive
STRIPE_WEBHOOK_SECRET=

# ─── SMS & workflows ──────────────────────────────────────────────────────

# Twilio powers SMS and WhatsApp workflow reminders and phone verification.
# @docs("Install the Twilio app", https://cal.com/docs/self-hosting/apps/install-apps/twilio)
TWILIO_SID=
# @sensitive
TWILIO_TOKEN=
# Messaging Service SID (MG…) the reminders are sent through.
TWILIO_MESSAGING_SID=
TWILIO_PHONE_NUMBER=
# Verify service SID (VA…) for phone-number verification.
TWILIO_VERIFY_SID=
# Alphanumeric sender id shown on SMS: letters, digits and spaces, max 11
# characters. Defaults to "Cal".
NEXT_PUBLIC_SENDER_ID=

# SendGrid, used for workflow reminder emails and the internal sync service.
# @sensitive
# @docs("Install the SendGrid app", https://cal.com/docs/self-hosting/apps/install-apps/sendgrid)
SENDGRID_API_KEY=
# Verified sender address for those messages.
# @type=email
SENDGRID_EMAIL=

# ─── Anti-abuse & rate limiting ───────────────────────────────────────────

# Cloudflare Turnstile on the booking form and signup. Sitekey is public,
# secret is not; both are needed for verification to actually run.
# @docs("Turnstile", https://developers.cloudflare.com/turnstile/get-started/)
NEXT_PUBLIC_CLOUDFLARE_SITEKEY=
# @sensitive
CLOUDFLARE_TURNSTILE_SECRET=
# "1" also puts the widget in front of the public booker.
NEXT_PUBLIC_CLOUDFLARE_USE_TURNSTILE_IN_BOOKER=

# Upstash Redis (REST, not a TCP redis:// URL). Both must be set or the
# Redis-backed features (API-key auto-lock, no-slots notifications and
# caching) quietly no-op.
# @type=url
# @docs("Upstash Redis REST API", https://upstash.com/docs/redis/overall/getstarted)
UPSTASH_REDIS_REST_URL=
# @sensitive
UPSTASH_REDIS_REST_TOKEN=

# Unkey root key, only for API rate limiting. Not needed for self-hosting.
# @sensitive
UNKEY_ROOT_KEY=

# ─── Cron & background work ───────────────────────────────────────────────
# The /api/cron/* routes are HTTP endpoints, not an internal scheduler:
# nothing runs them unless you point an external scheduler at them. Both keys
# below are how those routes authenticate the caller. Leave them empty and
# every request is rejected, which is the safe default for an instance with no
# scheduler in front of it.

# Matched against the `apiKey` query parameter on every cron route.
# @sensitive
CRON_API_KEY=
# Accepted as `Authorization: Bearer <value>` by the newer calendar-
# subscription cron routes.
# @sensitive
CRON_SECRET=

# "true" lets the app-metadata sync cron actually write; anything else runs it
# as a reporting-only dry run.
# @type=boolean
CRON_ENABLE_APP_SYNC=false

# "1" queues webhook deliveries through the Tasker instead of firing them
# inline in the request.
TASKER_ENABLE_WEBHOOKS=0

# "true" moves Tasker work onto Trigger.dev. Needs a Trigger.dev project;
# leave off for a plain self-hosted instance.
# @type=boolean
ENABLE_ASYNC_TASKER=false

# ─── Browser push notifications ───────────────────────────────────────────
# A VAPID pair, generated together with `npx web-push generate-vapid-keys`.
# Mismatched halves fail silently at subscribe time.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# @sensitive
VAPID_PRIVATE_KEY=

# ─── Observability ────────────────────────────────────────────────────────

# Sentry DSN for error reporting. Empty disables Sentry entirely.
# @sensitive
# @docs("Sentry DSN", https://docs.sentry.io/product/sentry-basics/dsn-explainer/)
NEXT_PUBLIC_SENTRY_DSN=
# Fraction of transactions traced, 0 to 1.
# @type=number
SENTRY_TRACES_SAMPLE_RATE=

# PostHog product analytics. The host defaults to https://eu.i.posthog.com;
# point it at your own instance if you self-host PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
# @type=url
NEXT_PUBLIC_POSTHOG_HOST=

# Log verbosity: 0 silly, 1 trace, 2 debug, 3 info, 4 warn, 5 error, 6 fatal.
# @type=number
NEXT_PUBLIC_LOGGER_LEVEL=

# ─── Misc ─────────────────────────────────────────────────────────────────

# Prefix on generated API keys.
API_KEY_PREFIX=cal_

# "non-strict" turns on a Content-Security-Policy for the support pages.
# "strict" is not supported yet and throws at build in production.
# @type=enum(non-strict)
CSP_POLICY=

# Separate AES key for encrypting Google service-account credentials used by
# domain-wide delegation. Independent of CALENDSO_ENCRYPTION_KEY; generate
# with `openssl rand -base64 24`.
# @sensitive
CALCOM_SERVICE_ACCOUNT_ENCRYPTION_KEY=

# App-credential sync: push app credentials in from another system. All three
# are needed together, and it is an advanced multi-instance setup, so leave
# empty unless you are running one.
# @sensitive
CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY=
# @sensitive
CALCOM_CREDENTIAL_SYNC_SECRET=
# @type=url
CALCOM_CREDENTIAL_SYNC_ENDPOINT=

# Where the v2 REST API lives. This compose runs only the web service, so
# there is no v2 API to point at; leave empty unless you deploy one
# separately.
# @type=url
NEXT_PUBLIC_API_V2_URL=

# Override the URL the embed snippet loads its script from. Empty serves it
# from this instance at <webapp url>/embed/embed.js, which is what you want.
# @type=url
NEXT_PUBLIC_EMBED_LIB_URL=
