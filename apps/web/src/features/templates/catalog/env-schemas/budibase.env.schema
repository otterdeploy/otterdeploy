# Budibase 3.44.0 (single image) environment schema (@env-spec / varlock format).
#
# Source: grep of `process.env.` across packages/backend-core/src,
# packages/server/src and packages/worker/src at tag v3.44.0, plus the two
# shell entrypoints that actually run inside budibase/budibase:v3.44.0
# (hosting/single/runner.sh and hosting/couchdb/runner.sh).
#
# docs.budibase.com's environment-variables page is written for the
# multi-container docker-compose install and is behind a bot check, so it was
# used only as a cross-check; where it and the code disagree, the code wins.
# Things it does not tell you about this image at 3.44.0:
#
#  * The image is one container running nginx + CouchDB (with Clouseau and
#    SQS) + Redis + MinIO + the app and worker Node services + LiteLLM, all
#    under pm2. Nothing here points at a sibling container.
#  * COUCHDB_USER/COUCHDB_PASSWORD, MINIO_ACCESS_KEY/MINIO_SECRET_KEY,
#    INTERNAL_API_KEY, JWT_SECRET, REDIS_PASSWORD, LITELLM_MASTER_KEY,
#    LITELLM_SALT_KEY and LITELLM_DB_PASSWORD are generated from uuidgen on
#    first boot if unset, then written to ${DATA_DIR}/.env and re-sourced on
#    every later boot. Since 3.4x a value supplied at runtime that DIFFERS
#    from the persisted one is honoured and rewritten into that file, so these
#    can be rotated. CouchDB's admin credentials and the derived internal
#    COUCH_DB_URL are repaired in the same pass.
#  * If ${DATA_DIR} is not a persistent volume, those secrets are re-minted on
#    every restart: every session dies with "Auth Error: Session not found".
#    The container prints that warning unless BUDIBASE_ACK_EPHEMERAL_DATA=1.
#  * 3.4x added a bundled LiteLLM proxy with `store_model_in_db: true`, which
#    needs Postgres. With DATABASE_URL unset the image starts its own Postgres
#    under ${DATA_DIR}/litellm/postgres. A missing LITELLM_MASTER_KEY or
#    LITELLM_SALT_KEY is a hard exit, but the image generates both, so an
#    all-defaults install still boots.
#  * There is no PLATFORM_URL/PUBLIC_URL in the compose: self-hosted Budibase
#    takes its public URL from Settings > Organisation in the UI, and only
#    falls back to PLATFORM_URL (then a hardcoded localhost:10000) when that is
#    blank. Set PLATFORM_URL if you want email links correct before an admin
#    ever opens that screen.
#
# The compose sets seven keys, six of them plain `${VAR}` operator
# substitutions matching this template's requiredEnv, plus a literal
# COUCHDB_USER. Everything below documents the rest of the image's real
# configuration surface; leaving it all blank is a working install.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Environment variables", https://docs.budibase.com/docs/environment-variables)
# ---

# ─── Core secrets ─────────────────────────────────────────────────────────
# The compose passes these six in. Each is also self-generating (see header),
# but this template asks for them so they survive a container rebuild and are
# known to you rather than to a uuidgen call.
# @docs("Docker install", https://docs.budibase.com/docs/docker)

# Signs every session cookie and API token. Rotating it logs everyone out;
# losing it while ${DATA_DIR}/.env is also lost makes existing sessions
# unverifiable. Also the fallback value for API_ENCRYPTION_KEY.
# @required @sensitive
JWT_SECRET=

# Shared secret the app service and worker service use to authenticate their
# own internal HTTP calls to each other, and the value of the
# `x-budibase-api-key` header for the public API's admin endpoints. Wrong or
# empty and the two halves of the container 403 each other.
# @required @sensitive
INTERNAL_API_KEY=

# Second secret accepted for internal calls while INTERNAL_API_KEY is being
# rotated: set the old value here, the new one above, then drop this.
# @sensitive
INTERNAL_API_KEY_FALLBACK=

# Second JWT signing key accepted during a JWT_SECRET rotation, so tokens
# issued under the old secret stay valid until they expire.
# @sensitive
JWT_SECRET_FALLBACK=

# Encrypts secrets stored inside app definitions (data source passwords,
# REST auth configs, environment variables of your Budibase apps). Falls back
# to JWT_SECRET when unset, which is what a default install uses. Set it
# explicitly only if you want those two rotated independently.
# @sensitive
API_ENCRYPTION_KEY=

# Key used for the older attachment/field-level encryption path. Unset on a
# normal install.
# @sensitive
ENCRYPTION_KEY=

# ─── Bundled CouchDB ──────────────────────────────────────────────────────
# CouchDB, Clouseau (search) and SQS (SQL-over-Couch) all run inside this
# container against ${DATA_DIR}/couch. These credentials are the container
# talking to its own database; nothing outside it should need them.

# CouchDB admin user. The compose pins it to `budibase`; the entrypoint
# creates the admin, the `_users` and `_replicator` databases with it, and
# rebuilds COUCH_DB_URL from it on every boot.
COUCHDB_USER=budibase

# CouchDB admin password.
# @required @sensitive
COUCHDB_PASSWORD=

# Underscore aliases the Node services read (backend-core reads
# COUCH_DB_USER/COUCH_DB_PASSWORD, the CouchDB entrypoint reads
# COUCHDB_USER/COUCHDB_PASSWORD). The entrypoint copies whichever side you
# set onto the other, so setting these instead of the pair above also works;
# setting both to different values does not.
COUCH_DB_USER=
# @sensitive
COUCH_DB_PASSWORD=

# Full CouchDB connection URL. Left empty the entrypoint derives
# http://${COUCHDB_USER}:${COUCHDB_PASSWORD}@127.0.0.1:5984 and persists it;
# it also overwrites any value here whose embedded credentials no longer
# match. Point it elsewhere only if you are running CouchDB outside the
# container.
# @sensitive
COUCH_DB_URL=

# Endpoint for SQS, the service that answers Budibase's SQL-style queries
# against CouchDB. Defaults to http://127.0.0.1:4984 (set by the entrypoint
# when empty).
# @sensitive
COUCH_DB_SQL_URL=

# Port backend-core assumes SQS listens on when it builds that URL itself.
# @type=port
COUCH_DB_SQS_PORT=4984

# Erlang distribution cookie for the CouchDB/Clouseau node pair inside the
# container. The image ships a fixed default; only meaningful if you attach
# another Erlang node.
# @sensitive
COUCHDB_ERLANG_COOKIE=

# ─── Bundled Redis ────────────────────────────────────────────────────────
# Redis holds sessions, caches, locks and the automation queues. It is
# started by the entrypoint with --requirepass ${REDIS_PASSWORD}.

# Password for the bundled Redis, applied to the server and used by the app
# and worker to AUTH. Rotating it is safe (cache and session loss only).
# @required @sensitive
REDIS_PASSWORD=

# ACL username. Only useful with an external Redis; when set together with
# REDIS_PASSWORD the entrypoint declares that user on the bundled server with
# full access, matching what requirepass alone would give.
# @sensitive
REDIS_USERNAME=

# host:port of Redis (no scheme). Defaults to the in-container instance;
# change it only to point at an external Redis.
REDIS_URL=127.0.0.1:6379

# Set when REDIS_URL points at a Redis Cluster, so ioredis uses cluster mode.
# @type=boolean
REDIS_CLUSTERED=

# Path to a redis.conf inside the container. Empty uses the image's
# /etc/redis/redis.conf, which persists to ${DATA_DIR}/redis.
REDIS_CONFIG=

# Any non-empty value drops the image's redis.conf and starts redis-server
# with its own built-in defaults, which means no persistence for cached data.
# @type=boolean
USE_DEFAULT_REDIS_CONFIG=

# ─── Object storage (bundled MinIO, or S3) ────────────────────────────────
# Attachments, app bundles, plugins and backups are S3 objects. By default
# they live in the MinIO the entrypoint starts over ${DATA_DIR}/minio.

# Access key / secret key for object storage. With the bundled MinIO these
# are the credentials it is created with; with USE_S3 they are the AWS
# credentials. Rotate them together.
# @required @sensitive
MINIO_ACCESS_KEY=
# @required @sensitive
MINIO_SECRET_KEY=

# S3 endpoint the services talk to. The entrypoint sets
# http://127.0.0.1:9000 for the bundled MinIO; set an AWS/S3-compatible
# endpoint when using external storage.
MINIO_URL=

# Any non-empty value stops the bundled MinIO from starting, so MINIO_URL
# and the keys above must describe a real S3 bucket host instead.
# @type=boolean
USE_S3=

# Region passed to the S3 client.
AWS_REGION=eu-west-1

# Temporary-credentials session token, for STS/assumed-role S3 access.
# @sensitive
AWS_SESSION_TOKEN=

# Set to skip TLS verification against an S3 endpoint with a self-signed
# certificate.
# @type=boolean
S3_IGNORE_SELF_SIGNED=

# Switches all object storage off entirely; not a supported configuration for
# a normal install (defaults to 1).
# @type=boolean
MINIO_ENABLED=1

# Bucket names. Defaults are what a fresh MinIO gets created with. Changing
# one after data exists hides everything already stored under the old name.
BACKUPS_BUCKET_NAME=backups
APPS_BUCKET_NAME=prod-budi-app-assets
TEMPLATES_BUCKET_NAME=templates
GLOBAL_BUCKET_NAME=global
PLUGIN_BUCKET_NAME=plugins
TEMP_BUCKET_NAME=tmp-file-attachments

# Azure App Service builds of this image only: MinIO runs in Azure gateway
# mode and refuses to start unless both are set.
AZURE_STORAGE_ACCOUNT=
# @sensitive
AZURE_STORAGE_KEY=

# Azure App Service builds only: NFS file share mounted at ${DATA_DIR} before
# anything else starts.
FILESHARE_IP=
FILESHARE_NAME=

# ─── AI (bundled LiteLLM) ─────────────────────────────────────────────────
# 3.4x runs a LiteLLM proxy in-container for the AI features; model providers
# and keys are configured in the UI, not here.

# LiteLLM's own admin key (its `--master_key`) and the salt it encrypts
# stored provider keys with. Both are generated and persisted if unset;
# LiteLLM exits if either ends up empty. Changing LITELLM_SALT_KEY after
# provider keys are stored makes them undecryptable.
# @docs("AI", https://docs.budibase.com/docs/ai)
# @sensitive
LITELLM_MASTER_KEY=
# @sensitive
LITELLM_SALT_KEY=

# Postgres connection string for LiteLLM's metadata. Empty means "use the
# in-container Postgres": the entrypoint builds
# postgresql://${LITELLM_DB_USER}:${LITELLM_DB_PASSWORD}@127.0.0.1:${LITELLM_DB_PORT}/${LITELLM_DB_NAME}
# and starts it. A runtime value always wins over the persisted one.
# @sensitive
DATABASE_URL=

# "false" with a DATABASE_URL set uses that external Postgres and skips the
# internal one; "true" forces the internal instance. Empty auto-selects:
# internal when DATABASE_URL is empty, external when it is not.
# @type=boolean
LITELLM_INTERNAL_DB=

# Credentials and name for the internal LiteLLM Postgres role/database.
LITELLM_DB_USER=llmproxy
# @sensitive
LITELLM_DB_PASSWORD=
LITELLM_DB_NAME=litellm
# @type=port
LITELLM_DB_PORT=5432

# Data directory for the internal Postgres cluster, and the fallback used
# when the primary path cannot be made 0700-owned by postgres.
LITELLM_PGDATA=
LITELLM_PGDATA_FALLBACK=/var/lib/postgresql/budibase-litellm

# Seconds to wait for the internal Postgres, then for LiteLLM's
# /health/liveliness, before giving up. Startup continues either way: the app
# and worker still come up, only AI features stay dead until a restart.
# @type=number
LITELLM_DB_READY_TIMEOUT_SECONDS=60
# @type=number
LITELLM_READY_TIMEOUT_SECONDS=120

# Where the app service reaches LiteLLM. Defaults to
# http://localhost:${LITELLM_PORT}.
# @type=port
LITELLM_PORT=4000
# @type=url
LITELLM_URL=

# Milliseconds the app waits for LiteLLM to answer before treating AI as
# unavailable, and how often it polls while waiting.
# @type=number
LITELLM_READINESS_TIMEOUT_MS=30000
# @type=number
LITELLM_READINESS_POLL_MS=500

# Pre-provisioned LiteLLM virtual key used for Budibase's own hosted AI
# offering. Empty on a self-hosted install.
# @sensitive
BBAI_LITELLM_KEY=

# Base URL for OpenRouter-routed models.
# @type=url
# @docs("OpenRouter API reference", https://openrouter.ai/docs/api-reference/overview)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct Google Gemini key, read by the server for the Gemini-backed
# generation helpers rather than going through LiteLLM.
# @sensitive
GEMINI_API_KEY=

# Milliseconds allowed for AI table generation before it is abandoned.
# @type=number
TABLE_GENERATION_TIMEOUT_MS=240000

# ─── URLs, ports and the proxy ────────────────────────────────────────────

# Public URL of this Budibase, used in invitation and password-reset emails
# and in OAuth callback URLs. On self-host the value saved in Settings >
# Organisation wins; this is the fallback, and the effective default when
# both are empty is http://localhost:10000, which produces broken email
# links.
# @type=url
PLATFORM_URL=

# Hostname for the built-in Let's Encrypt flow: the entrypoint requests a
# certificate for it with certbot, installs a renewal cron job and serves
# HTTPS on 443. Leave empty when a reverse proxy in front terminates TLS.
# The certificate request is then skipped and only port 80 is served.
CUSTOM_DOMAIN=

# Port nginx listens on inside the container. The compose exposes container
# port 80 with no override, so changing this breaks routing unless the
# exposed port changes with it.
# @type=port
CLUSTER_PORT=80

# Internal ports of the app service and worker service behind nginx.
# @type=port
APP_PORT=4001
# @type=port
WORKER_PORT=4002

# Alternative names for the same two ports, read when APP_PORT/WORKER_PORT
# are unset (PORT is the last fallback for both services).
# @type=port
APPS_PORT=
# @type=port
PORT=

# Where each service reaches the other inside the container.
# @type=url
WORKER_URL=http://127.0.0.1:4002
# @type=url
APPS_URL=http://127.0.0.1:4001

# Cookie domain for the session cookie. Set to a parent domain (".example.com")
# only if Budibase and something else must share the session.
COOKIE_DOMAIN=

# nginx request rate limits, substituted into its config at boot: sustained
# requests per second for the API, and for the webhook/automation trigger
# endpoints.
# @type=number
PROXY_RATE_LIMIT_API_PER_SECOND=50
# @type=number
PROXY_RATE_LIMIT_WEBHOOKS_PER_SECOND=10

# ─── First admin user and tenancy ─────────────────────────────────────────

# If both are set on a self-hosted, single-tenant install, the app service
# creates this admin at startup instead of showing the "create admin"
# screen. Ignored once an admin exists.
# @type=email
BB_ADMIN_USER_EMAIL=
# @sensitive
BB_ADMIN_USER_PASSWORD=

# Multi-tenant mode (one Budibase serving several orgs on subdomains). Off,
# and unsupported, for a normal self-hosted install; also disables the
# BB_ADMIN_USER_* bootstrap above.
# @type=boolean
MULTI_TENANCY=

# Tells the code it is not running on Budibase Cloud: the image sets 1. Set
# to 0 only if you know exactly which cloud-only paths you want back.
# @type=boolean
SELF_HOSTED=1

# Budibase's hosted account portal, used for licence checks. The image
# defaults to https://account.budibase.app; DISABLE_ACCOUNT_PORTAL=1 cuts
# that call out for an air-gapped install.
# @type=url
ACCOUNT_PORTAL_URL=https://account.budibase.app
# @type=url
INTERNAL_ACCOUNT_PORTAL_URL=
# @type=boolean
DISABLE_ACCOUNT_PORTAL=

# Enterprise licence key applied at boot, for an install that cannot reach
# the account portal.
# @sensitive
DEFAULT_LICENSE=

# Skips every outbound call to Budibase's own services (licensing,
# telemetry). For air-gapped installs.
# @type=boolean
OFFLINE_MODE=

# Comma-separated per-tenant feature-flag overrides, e.g.
# "*:SOME_FLAG,default:!OTHER_FLAG" (tenant id, then flags, `!` to force a
# flag off).
TENANT_FEATURE_FLAGS=

# ─── Data, plugins and runtime ────────────────────────────────────────────

# Everything stateful lives under this path: CouchDB, Redis, MinIO, the
# LiteLLM Postgres and the generated .env. The compose mounts its volume at
# /data, matching this default. Azure App Service builds override it to
# /home.
DATA_DIR=/data

# Set to 1 to silence the startup warning about freshly generated secrets on
# a ${DATA_DIR} that may not be persistent. Only silence it once you have
# confirmed the volume is real.
# @type=boolean
BUDIBASE_ACK_EPHEMERAL_DATA=

# Directory watched for plugin bundles (.tar.gz); anything dropped in is
# imported automatically at boot. Mount a host directory here to preload
# custom components or data sources.
PLUGINS_DIR=/plugins

# Stamps GitHub origin metadata onto plugins imported before that field
# existed. Defaults on, and runs on every plugin-list request until there is
# nothing left to backfill; set to "false" if that lookup is slow on a
# network without outbound GitHub access.
# @type=boolean
ENABLE_PLUGIN_GH_ORIGIN_BACKFILL=true

# Skips the workspace/app schema migrations that normally run at startup.
# Only for recovering an install where a migration is the thing failing.
# @type=boolean
SKIP_WORKSPACE_MIGRATIONS=

# Milliseconds a single app migration may run before it is considered stuck,
# and how often the app polls to see whether another process finished one.
# @type=number
APP_MIGRATION_TIMEOUT=
# @type=number
SYNC_MIGRATION_CHECKS_MS=2000

# Free-text label for the deployment, logged at startup and attached to
# events. The image sets PRODUCTION; the only value the code treats specially
# is "QA", which switches on a few internal test behaviours.
BUDIBASE_ENVIRONMENT=PRODUCTION

# Reported with telemetry as how this instance is hosted; the single image
# sets "docker".
DEPLOYMENT_ENVIRONMENT=docker

# Node.js mode. Anything other than "production" turns on dev behaviour,
# including reading a .env from the source tree, which is not what you want
# in a deployed container.
# @type=enum(production, development)
NODE_ENV=production

# Root path the services resolve their bundled assets from inside the image.
# Baked in; changing it breaks the container.
SERVER_TOP_LEVEL_PATH=/app

# Runs the app service across multiple Node processes. Off in the single
# image, where memory is shared with CouchDB, MinIO, Redis and LiteLLM.
# @type=boolean
CLUSTER_MODE=

# Service names used as the `service` field in logs, when you want the two
# halves distinguishable in an aggregator.
SERVICE=
APPS_SERVICE=
WORKER_SERVICE=

# Skips the periodic sync of app-level users from the global users table.
# @type=boolean
DISABLE_USER_SYNC=

# Stops development apps auto-publishing changes to their production copy.
# @type=boolean
DISABLE_AUTO_PROD_APP_SYNC=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
# Budibase normally takes SMTP settings from Settings > Email in the UI.
# These variables are the fallback used when SMTP_FALLBACK_ENABLED is on,
# which is what lets a fresh install send its first invitation email before
# anyone has opened that screen.

# Enables the environment-variable SMTP fallback above.
# @docs("Email", https://docs.budibase.com/docs/email)
# @type=boolean
SMTP_FALLBACK_ENABLED=

SMTP_HOST=
# @type=port
SMTP_PORT=
SMTP_USER=
# @sensitive
SMTP_PASSWORD=
# @type=email
SMTP_FROM_ADDRESS=

# Set to "false" to accept a self-signed certificate on the SMTP server.
# @type=boolean
SMTP_REJECT_UNAUTHORIZED=

# Overrides where the worker loads its email templates from, for customised
# invitation and reset emails.
EMAIL_TEMPLATE_PATH=

# ─── Single sign-on ───────────────────────────────────────────────────────
# OIDC and the Google/Microsoft providers are normally configured in
# Settings > Auth; these boot-time values seed them and are what an
# infrastructure-managed install uses.

# Google OAuth client, also used by the Google Sheets data source.
# @docs("Google Cloud credentials", https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID app registration: client, secret and tenant. The tenant
# is also what the SharePoint RAG connector authenticates against.
MICROSOFT_CLIENT_ID=
# @sensitive
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Scopes requested when connecting SharePoint as a knowledge source.
RAG_SHAREPOINT_DEFAULT_SCOPE=offline_access User.Read https://graph.microsoft.com/Sites.Read.All

# Lets an OIDC login attach to an existing local account whose email the
# provider has not marked verified. Off by default because it lets a
# misconfigured provider take over accounts by email.
# @docs("Authentication", https://docs.budibase.com/docs/authentication)
# @type=boolean
OIDC_ALLOW_UNVERIFIED_EMAIL_LINKING=

# Keeps password login working for admins while SSO is enforced: the lockout
# escape hatch when an SSO config goes wrong. Self-host only.
# @type=boolean
ENABLE_SSO_MAINTENANCE_MODE=

# Where the browser lands after a successful or failed Google/OIDC callback.
PASSPORT_GOOGLEAUTH_SUCCESS_REDIRECT=/
PASSPORT_GOOGLEAUTH_FAILURE_REDIRECT=/error
PASSPORT_OIDCAUTH_SUCCESS_REDIRECT=/
PASSPORT_OIDCAUTH_FAILURE_REDIRECT=/error

# ─── Passwords, sessions and login limits ─────────────────────────────────

# bcrypt cost factor for stored passwords. Higher is slower to crack and
# slower to log in; existing hashes keep their original cost.
# @type=number
SALT_ROUNDS=

# Bounds enforced when a password is set. Defaults are 12 and 512;
# lowering the minimum does not re-check passwords already stored.
# @type=number
PASSWORD_MIN_LENGTH=
# @type=number
PASSWORD_MAX_LENGTH=

# Session lifetime in seconds (default 604800, seven days), and how often an
# active session's expiry is refreshed while it is in use. That second one is
# MILLISECONDS despite the name, default 60000.
# @type=number
SESSION_EXPIRY_SECONDS=
# @type=number
SESSION_UPDATE_PERIOD=

# Account lockout: failed attempts allowed before an account is locked, the
# lockout in seconds, and the separate per-IP attempt ceiling.
# @type=number
LOGIN_MAX_FAILED_ATTEMPTS=5
# @type=number
LOGIN_LOCKOUT_SECONDS=900
# @type=number
LOGIN_IP_LOCKOUT_LIMIT=10

# Password-reset throttling: requests per email and per IP inside their
# respective windows (seconds).
# @type=number
PASSWORD_RESET_RATE_EMAIL_LIMIT=3
# @type=number
PASSWORD_RESET_RATE_EMAIL_WINDOW_SECONDS=900
# @type=number
PASSWORD_RESET_RATE_IP_LIMIT=20
# @type=number
PASSWORD_RESET_RATE_IP_WINDOW_SECONDS=900

# reCAPTCHA on public app access is a licensed feature, normally configured
# per workspace in the UI; the server only reads this site key as a default.
# RECAPTCHA_SESSION_SECONDS is how long a passed challenge is remembered in
# Redis before the visitor is challenged again.
RECAPTCHA_SITE_KEY=
# @type=number
RECAPTCHA_SESSION_SECONDS=1800

# Silences the boot warning about a weak or default JWT_SECRET. Fix the
# secret instead.
# @type=boolean
DISABLE_JWT_WARNING=

# ─── Limits, timeouts and performance ─────────────────────────────────────

# Milliseconds a single data-source query may run in its worker thread.
# Raise for slow warehouses; it also raises the automation floor below.
# @type=number
QUERY_THREAD_TIMEOUT=15000

# Milliseconds a whole automation run may take (never lower than
# QUERY_THREAD_TIMEOUT), and the step/loop ceilings that stop a runaway
# automation from eating the container.
# @type=number
AUTOMATION_THREAD_TIMEOUT=120000
# @type=number
AUTOMATION_MAX_ITERATIONS=200
# @type=number
AUTOMATION_MAX_NESTED_LOOPS=3
# @type=number
AUTOMATION_MAX_STORED_LOOP_RESULTS=50
# @type=number
AUTOMATION_MAX_LOG_SIZE_MB=5

# Stops automation runs being written to the automation log at all, for an
# instance whose Couch storage is dominated by log documents.
# @type=boolean
DISABLE_AUTOMATION_LOGS=

# Lets automations run in development (unpublished) apps.
# @type=boolean
ALLOW_DEV_AUTOMATIONS=

# Milliseconds a single JS binding may execute for, and the budget shared by
# every binding in one request. Memory ceiling per JS runner in MB.
# @type=number
JS_PER_EXECUTION_TIME_LIMIT_MS=1500
# @type=number
JS_PER_REQUEST_TIME_LIMIT_MS=
# @type=number
JS_RUNNER_MEMORY_LIMIT=64

# Logs JS binding errors server-side instead of only returning them to the
# client.
# @type=boolean
LOG_JS_ERRORS=

# Runs queries and automations on the main thread instead of forking worker
# threads; a debugging aid, and a large throughput loss.
# @type=boolean
DISABLE_THREADING=

# Caps concurrent forked automation workers, and names the forked process in
# `ps`/logs.
# @type=number
MAX_WORKER_RUNS=
FORKED_PROCESS_NAME=main

# Turns off the app's own per-endpoint rate limiting (nginx's limits above
# still apply).
# @type=boolean
DISABLE_RATE_LIMITING=

# Requests per second allowed against the public API per key.
# @type=number
API_REQ_LIMIT_PER_SEC=

# Maximum request body size in MB, and the separate ceiling on app/CSV
# imports.
# @type=number
HTTP_MB_LIMIT=
# @type=number
MAX_IMPORT_SIZE_MB=

# Node HTTP server timeouts in milliseconds, applied to both services. Raise
# HTTP_SERVER_TIMEOUT_MS when long queries are cut off mid-response.
# @type=number
HTTP_SERVER_TIMEOUT_MS=
# @type=number
HTTP_HEADERS_TIMEOUT_MS=
# @type=number
HTTP_REQUEST_TIMEOUT_MS=
# @type=number
HTTP_KEEPALIVE_TIMEOUT_MS=

# Maximum BSON document buffer in bytes, for very wide rows.
# @type=number
BSON_BUFFER_SIZE=

# How long the worker caches the setup checklist, in seconds.
# @type=number
CHECKLIST_CACHE_TTL=3600

# ─── SQL data sources ─────────────────────────────────────────────────────

# Row ceiling on a single external SQL query, and on rows pulled through a
# relationship. Defaults are 5000 and 500. Raising them raises memory use on
# every grid load.
# @type=number
SQL_MAX_ROWS=
# @type=number
MAX_RELATED_ROWS=

# Disables the table-alias rewriting in generated SQL. A workaround for
# dialects that reject the aliased form; slower and more likely to hit
# identifier-length limits.
# @type=boolean
SQL_ALIASING_DISABLE=

# Set to "false" to accept self-signed certificates from REST data sources
# and webhook targets. Applies to every outbound REST call, not one.
# @type=boolean
REST_REJECT_UNAUTHORIZED=

# DynamoDB endpoint override, for a local or VPC-endpoint DynamoDB.
# @type=url
DYNAMO_ENDPOINT=

# Which git repository the app template gallery is fetched from.
TEMPLATE_REPOSITORY=app

# ─── Integrations ─────────────────────────────────────────────────────────

# Atlassian (Jira/Confluence) connector: API token, the account email it
# belongs to, and the site base URL.
# @sensitive
ATLASSIAN_API_TOKEN=
# @type=email
ATLASSIAN_EMAIL=
# @type=url
ATLASSIAN_BASE_URL=

# BambooHR connector: API key and the company subdomain it belongs to.
# @sensitive
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=

# SharePoint knowledge-source sync: how often a sync runs and how long one
# may take, both in milliseconds (defaults: one day, fifteen minutes).
# @type=number
SHAREPOINT_SYNC_INTERVAL_MS=86400000
# @type=number
SHAREPOINT_SYNC_TIMEOUT_MS=900000

# ─── Security headers and TLS ─────────────────────────────────────────────

# Turns the Content-Security-Policy header off entirely. Prefer the
# CUSTOM_CSP_* additions below; switching CSP off makes any XSS in a custom
# component a full account takeover.
# @type=boolean
DISABLE_CONTENT_SECURITY_POLICY=

# Extra origins appended to each CSP directive, space-separated, for embedding
# external images, fonts, scripts or iframes in your apps.
CUSTOM_CSP_MEDIA_SRC=
CUSTOM_CSP_SCRIPT_SRC=
CUSTOM_CSP_CONNECT_SRC=
CUSTOM_CSP_IMG_SRC=
CUSTOM_CSP_FONT_SRC=
CUSTOM_CSP_FRAME_SRC=

# Rejects any row whose string field matches Budibase's XSS pattern, with
# "Input not sanitised - potentially vulnerable to XSS", instead of storing
# it. Off by default because it also refuses legitimate HTML pasted into
# long-form text fields.
# @type=boolean
XSS_SAFE_MODE=

# Comma-separated IPs/CIDRs refused at the API layer.
BLACKLIST_IPS=

# Absolute path to an extra CA bundle inside the container, exported as
# NODE_EXTRA_CA_CERTS so data sources and REST calls trust an internal CA.
# The entrypoint also picks up ${DATA_DIR}/ca-bundle.pem or
# /etc/budibase/ca-bundle.pem without this being set.
CUSTOM_CA_BUNDLE_PATH=

# Records the client IP on audit-log entries.
# @type=boolean
ENABLE_AUDIT_LOG_IP_ADDR=

# Version below which the legacy POWER role is still granted; a migration
# knob, left at the default unless upgrading from before 3.0.
MIN_VERSION_WITHOUT_POWER_ROLE=3.0.0

# ─── Logging and telemetry ────────────────────────────────────────────────

# Pino log level for both services.
# @type=enum(trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Set to "false" to stop logging every HTTP request; the access log is the
# noisiest thing in the container.
# @type=boolean
HTTP_LOGGING=true

# Disables structured pino logging in favour of plain console output.
# @type=boolean
DISABLE_PINO_LOGGER=

# Logs every generated SQL statement. Useful when a data source returns the
# wrong rows, expensive and leaky in production.
# @type=boolean
SQL_LOGGING_ENABLE=

# Size at which the container's pm2 log files roll over.
ROLLING_LOG_MAX_SIZE=10M

# Logs SCIM provisioning requests, for debugging a directory-sync
# integration.
# @type=boolean
ENABLE_SCIM_LOGGER=

# Product analytics to Budibase's PostHog. On a self-hosted install this is
# ON unless Settings turns it off or this is set to 0/false. The setting in
# the UI takes precedence over this variable.
# @type=boolean
ENABLE_ANALYTICS=

# PostHog project key events are sent to. The entrypoint substitutes
# Budibase's own key whenever this is unset OR empty, so blanking it changes
# nothing: ENABLE_ANALYTICS=0 or the Settings toggle is what stops the
# sending. Set your own key to point events at your own PostHog.
POSTHOG_TOKEN=

# PostHog ingestion host, and the feature-flag polling switch and interval.
# @type=url
POSTHOG_API_HOST=https://us.i.posthog.com
# @type=boolean
POSTHOG_FEATURE_FLAGS_ENABLED=
# @type=number
POSTHOG_FEATURE_FLAGS_POLLING_INTERVAL_MS=
