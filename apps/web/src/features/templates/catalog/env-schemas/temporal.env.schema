# Temporal Server 1.29.7 + Web UI 2.53.3 environment schema (@env-spec / varlock format).
#
# Images: temporalio/auto-setup:1.29.7, temporalio/ui:2.53.3, postgres:17-alpine.
#
# Source. The server container is NOT configured by reading env in Go: its
# entrypoint renders /etc/temporal/config/docker.yaml from a Go text/template
# and temporal-server then only ever reads that file. So the authoritative
# surface is the image's shell + template layer, researched at the tags the
# compose pins:
#   temporalio/docker-builds @ release/v1.29.x: docker/entrypoint.sh,
#     docker/auto-setup.sh, docker/start-temporal.sh. That branch head
#     (2026-06-11) is what produced the 1.29.7 images (pushed 2026-06-12).
#   temporalio/temporal @ v1.29.7: docker/config_template.yaml, plus
#     cmd/server/main.go and common/config/loader.go for the three CLI flags
#     that also accept env.
#   temporalio/ui-server @ v2.53.3: config/docker.yaml (Sprig-templated, the
#     UI's entire env surface) and plugins/fs_config_provider/loader.go.
#
# SECURITY. Temporal ships with NO authentication and NO transport security
# turned on. Out of the box, anyone who can reach the frontend gRPC port
# (7233) has full control of every namespace: start, signal, terminate and
# reset workflows, and read every workflow input, result and history, which
# is where application payloads live. Anyone who can reach the UI (8080) gets
# the same power through a browser, with no login. Nothing below changes that
# by default. The knobs that do exist are real but all opt-in and all require
# work outside this file: on the server, TEMPORAL_AUTH_AUTHORIZER +
# TEMPORAL_AUTH_CLAIM_MAPPER with the TEMPORAL_JWT_* key sources (JWT bearer
# tokens), and the TEMPORAL_TLS_* pairs for mTLS; on the UI,
# TEMPORAL_AUTH_ENABLED with an OIDC provider. Until one of those is
# configured, treat both ports as private and never publish them.
#
# Deliberately not declared, because this stack cannot reach them: the
# Cassandra (CASSANDRA_*), MySQL (MYSQL_*, VISIBILITY_MYSQL_*) and
# Elasticsearch (ENABLE_ES, ES_*) branches of auto-setup.sh and
# config_template.yaml. DB is pinned to postgres12 and there is no
# Elasticsearch service, so every one of those keys is dead here.
#
# Honest note on the image: temporalio/auto-setup is deprecated upstream and
# is not recommended for production. It creates schemas and namespaces on
# every boot. Its newest published tag is 1.29.7; 1.30.x and 1.31.x exist
# only as temporalio/server + temporalio/admin-tools, which need a separate
# schema-setup step. This template stays on auto-setup deliberately.

# @defaultSensitive=false @defaultRequired=infer
# @docs("Temporal Cluster configuration reference", https://docs.temporal.io/references/configuration)
# ---

# ─── Bundled Postgres ────────────────────────────────────────────────────

# Password for the bundled Postgres, generated at install. It is the single
# secret this template needs: the compose feeds the same value to the `db`
# service (POSTGRES_PASSWORD) and to the server (POSTGRES_PWD). Change one
# without the other and the server never gets past "Waiting for PostgreSQL".
# @required @sensitive
POSTGRES_PASSWORD=

# Role the bundled Postgres creates at first boot, and the role the server
# authenticates as. The compose sets this identical value on both the `db`
# and `temporal` services on purpose.
# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_USER=temporal

# Database the bundled Postgres creates at first boot. This one matters more
# than it looks: auto-setup.sh only issues CREATE DATABASE for DBNAME when
# DBNAME differs from POSTGRES_USER (both are "temporal" here), so the main
# database is created by the Postgres container itself and by nothing else.
# Drop this key and the server starts against a database that does not exist.
# @docs("postgres image environment variables", https://hub.docker.com/_/postgres)
POSTGRES_DB=temporal

# ─── Server: database connection ─────────────────────────────────────────

# Persistence plugin. "postgres12" is the lib/pq driver and what this template
# runs; "postgres12_pgx" is the pgx driver for the same schema. auto-setup.sh
# refuses to start on any other value than these four.
# @required @type=enum(postgres12, postgres12_pgx, mysql8, cassandra)
DB=postgres12

# Postgres port, used both by auto-setup's readiness wait and by the rendered
# connectAddr. Twin of the port the `db` service listens on.
# @required @type=port
DB_PORT=5432

# Host (or comma-separated hosts) of the Postgres server. Platform-owned:
# resolved to the bundled `db` service at deploy time.
# @required
POSTGRES_SEEDS=${{stack.db.HOST}}

# Password the server and the schema tool present to Postgres. Platform-owned:
# the compose interpolates POSTGRES_PASSWORD above into it.
# @required @sensitive
POSTGRES_PWD=${POSTGRES_PASSWORD}

# Main (history/tasks/namespaces) database name. Leave it equal to
# POSTGRES_USER so the Postgres container creates it (see POSTGRES_DB).
DBNAME=temporal

# Visibility database name, the searchable index of workflow executions that
# backs the UI's list view. Unlike DBNAME this one differs from POSTGRES_USER,
# so auto-setup.sh does create it and apply its schema.
# @docs("Visibility store", https://docs.temporal.io/self-hosted-guide/visibility)
VISIBILITY_DBNAME=temporal_visibility

# Point visibility at a different Postgres than the main store. Each empty
# value falls back to its main-store twin (POSTGRES_SEEDS, DB_PORT,
# POSTGRES_USER, POSTGRES_PWD), which is what this stack wants.
VISIBILITY_POSTGRES_SEEDS=
# @type=port
VISIBILITY_DB_PORT=
VISIBILITY_POSTGRES_USER=
# @sensitive
VISIBILITY_POSTGRES_PWD=

# TLS for the connection the SCHEMA TOOL makes during auto-setup. These are
# read only by auto-setup.sh and are separate from the SQL_* pair below that
# the running server uses; turning on one and not the other is the usual way
# this goes wrong.
# @type=boolean
POSTGRES_TLS_ENABLED=false
# @type=boolean
POSTGRES_TLS_DISABLE_HOST_VERIFICATION=false
POSTGRES_TLS_CERT_FILE=
POSTGRES_TLS_KEY_FILE=
POSTGRES_TLS_CA_FILE=
POSTGRES_TLS_SERVER_NAME=

# TLS for the connections the RUNNING SERVER makes to Postgres (both the main
# and the visibility store). Paths must exist inside the container.
# @type=boolean
SQL_TLS_ENABLED=false
SQL_CA=
SQL_CERT=
SQL_CERT_KEY=
# @type=boolean
SQL_HOST_VERIFICATION=false
SQL_HOST_NAME=

# Connection pool for the main store. Each Temporal service (frontend,
# history, matching, worker) opens its own pool of this size, so the real
# ceiling on the bundled Postgres is roughly four times these numbers.
# @type=number
SQL_MAX_CONNS=20
# @type=number
SQL_MAX_IDLE_CONNS=20
SQL_MAX_CONN_TIME=1h

# Connection pool for the visibility store, sized independently.
# @type=number
SQL_VIS_MAX_CONNS=10
# @type=number
SQL_VIS_MAX_IDLE_CONNS=10
SQL_VIS_MAX_CONN_TIME=1h

# ─── Server: auto-setup bootstrap ────────────────────────────────────────

# auto-setup.sh runs on every container start. "true" skips creating and
# upgrading the SQL schemas: set it once the cluster is established and you
# would rather run temporal-sql-tool yourself, which is upstream's advice for
# anything you care about.
# @type=boolean
# @docs("auto-setup.sh at the 1.29.x release branch", https://github.com/temporalio/docker-builds/blob/release/v1.29.x/docker/auto-setup.sh)
SKIP_SCHEMA_SETUP=false

# "true" skips the CREATE DATABASE step (the visibility database here) and
# assumes both databases already exist.
# @type=boolean
SKIP_DB_CREATE=false

# auto-setup registers one namespace on first boot so the cluster is usable.
# Set SKIP_DEFAULT_NAMESPACE_CREATION=true if you provision namespaces
# yourself; workers pointed at a namespace that does not exist fail to poll.
# @type=boolean
# @docs("Namespaces", https://docs.temporal.io/namespaces)
SKIP_DEFAULT_NAMESPACE_CREATION=false
DEFAULT_NAMESPACE=default

# How long closed workflow histories are kept in the default namespace before
# deletion. The 24h default is a development value; raise it before you rely
# on being able to inspect finished workflows.
DEFAULT_NAMESPACE_RETENTION=24h

# auto-setup adds the stock custom search attributes (CustomKeywordField and
# friends) to the default namespace. Harmless, and skippable.
# @type=boolean
SKIP_ADD_CUSTOM_SEARCH_ATTRIBUTES=false

# ─── Server: cluster runtime ─────────────────────────────────────────────

# Number of history shards. Chosen ONCE, at first schema setup, and immutable
# afterwards: changing it on an existing database corrupts task routing. The
# image default of 4 is a development value; a real cluster wants 512 or more,
# decided before the first boot.
# @type=number
# @docs("Self-hosted defaults", https://docs.temporal.io/self-hosted-guide/defaults)
NUM_HISTORY_SHARDS=4

# Server log level, written to stdout.
# @type=enum(debug, info, warn, error, fatal)
LOG_LEVEL=info

# Address every Temporal service binds to. Empty is correct: entrypoint.sh
# resolves the container's own hostname, which is what the container network
# needs. Setting 127.0.0.1 here makes the frontend unreachable from the UI.
BIND_ON_IP=

# Address this node advertises to the membership ring. entrypoint.sh fills it
# from the container hostname when BIND_ON_IP is a wildcard; only set it by
# hand for multi-host clusters.
TEMPORAL_BROADCAST_ADDRESS=

# Frontend address the server's own internal clients dial. Only rendered into
# the config when an authorizer or claim mapper is set and the internal
# frontend is not in use; ignore it otherwise.
PUBLIC_FRONTEND_ADDRESS=

# Colon- or comma-separated subset of services this container should run
# (frontend, history, matching, worker, internal-frontend). Empty runs them
# all in one process, which is what a single-container deployment wants.
SERVICES=

# Set to any non-empty value to also run the internal-frontend role, which
# lets system workers bypass the authorizer. Only meaningful once
# authorization is on.
USE_INTERNAL_FRONTEND=

# Path to the dynamic config file inside the container. The default file ships
# in the image; point this at a mounted file to change runtime limits such as
# rate limits and retention without a rebuild.
# @docs("Dynamic configuration reference", https://docs.temporal.io/references/dynamic-configuration)
DYNAMIC_CONFIG_FILE_PATH=/etc/temporal/config/dynamicconfig/docker.yaml

# Frontend address, and the one key both containers read with different
# meanings. On the UI (where the compose sets it) it is the cluster the UI
# connects to. On the server container, auto-setup.sh uses it as the address
# its bundled CLI dials to register the default namespace, and entrypoint.sh
# derives it from BIND_ON_IP when unset. Platform-owned: resolved to the
# `temporal` service at deploy time.
# @required
TEMPORAL_ADDRESS=${{stack.temporal.HOST}}:7233

# Deprecated alias for TEMPORAL_ADDRESS, still honoured by entrypoint.sh at
# this version. Leave empty.
TEMPORAL_CLI_ADDRESS=

# ─── Server: service ports ───────────────────────────────────────────────

# Frontend gRPC port: the one workers and clients connect to, and the port
# the compose exposes. Change it and TEMPORAL_ADDRESS must change with it.
# @type=port
FRONTEND_GRPC_PORT=7233
# Frontend HTTP API port (the gRPC-gateway front door), not exposed by this
# compose.
# @type=port
FRONTEND_HTTP_PORT=7243
# @type=port
FRONTEND_MEMBERSHIP_PORT=6933

# Internal role ports. All four services run in this one container, so these
# only need changing on a port collision or a multi-container split.
# @type=port
MATCHING_GRPC_PORT=7235
# @type=port
MATCHING_MEMBERSHIP_PORT=6935
# @type=port
HISTORY_GRPC_PORT=7234
# @type=port
HISTORY_MEMBERSHIP_PORT=6934
# @type=port
WORKER_GRPC_PORT=7239
# @type=port
WORKER_MEMBERSHIP_PORT=6939

# Ports for the optional internal-frontend role; unused unless
# USE_INTERNAL_FRONTEND is set.
# @type=port
INTERNAL_FRONTEND_GRPC_PORT=7236
# @type=port
INTERNAL_FRONTEND_HTTP_PORT=7246
# @type=port
INTERNAL_FRONTEND_MEMBERSHIP_PORT=6936

# ─── Server: authorization ───────────────────────────────────────────────

# The switch that turns authentication on. Empty means the server accepts
# every gRPC call unauthenticated (the default this template ships with). The
# only value the bundled server implements is "default", which enables the
# JWT authorizer configured by the TEMPORAL_JWT_* keys below; it does nothing
# without a claim mapper.
# @docs("Self-hosted security", https://docs.temporal.io/self-hosted-guide/security)
TEMPORAL_AUTH_AUTHORIZER=

# Turns the bearer token on each request into Temporal claims. "default" reads
# a JWT from the Authorization header and maps its permissions claim. Must be
# set together with TEMPORAL_AUTH_AUTHORIZER; either one alone is a no-op.
# @docs("Self-hosted security", https://docs.temporal.io/self-hosted-guide/security)
TEMPORAL_AUTH_CLAIM_MAPPER=

# Where the public keys that verify those JWTs come from: a JWKS URL, or a
# file URI. Up to two sources; the server refuses every token if neither is
# reachable.
# @type=url
TEMPORAL_JWT_KEY_SOURCE1=
# @type=url
TEMPORAL_JWT_KEY_SOURCE2=

# How often the key sources are re-fetched, so rotated signing keys are picked
# up without a restart.
TEMPORAL_JWT_KEY_REFRESH=1m

# Name of the JWT claim carrying Temporal permissions, and an optional regex
# for parsing entries out of it. Leave the regex empty for the stock
# "<namespace>:<role>" format.
TEMPORAL_JWT_PERMISSIONS_CLAIM=permissions
TEMPORAL_JWT_PERMISSIONS_REGEX=

# Read by the server's --allow-no-auth flag: lets the process start with no
# authorizer configured. Empty here is equivalent to the flag's own default,
# and the rendered config already has no authorizer, so this changes nothing
# unless you are also setting an authorizer and want the escape hatch.
# @type=boolean
TEMPORAL_ALLOW_NO_AUTH=

# ─── Server: TLS ─────────────────────────────────────────────────────────

# Require clients to present a certificate, on both the internode and the
# frontend listener. This is the mTLS switch; without a server cert below it
# has nothing to enforce.
# @type=boolean
# @docs("Self-hosted security", https://docs.temporal.io/self-hosted-guide/security)
TEMPORAL_TLS_REQUIRE_CLIENT_AUTH=false

# Certificate the internal roles (history, matching, internal-frontend)
# present to each other. Either the *_CERT/*_KEY file paths or the inline
# *_DATA pair, not both.
TEMPORAL_TLS_SERVER_CERT=
# @sensitive
TEMPORAL_TLS_SERVER_KEY=
TEMPORAL_TLS_SERVER_CERT_DATA=
# @sensitive
TEMPORAL_TLS_SERVER_KEY_DATA=

# CA that signs those internode certificates; also the root the frontend's own
# clients trust.
TEMPORAL_TLS_SERVER_CA_CERT=
TEMPORAL_TLS_SERVER_CA_CERT_DATA=

# How internode clients verify the certificate they are shown.
TEMPORAL_TLS_INTERNODE_SERVER_NAME=
# @type=boolean
TEMPORAL_TLS_INTERNODE_DISABLE_HOST_VERIFICATION=false

# Certificate the FRONTEND presents to external clients (workers, CLI, the
# Web UI). This is the one that encrypts port 7233.
TEMPORAL_TLS_FRONTEND_CERT=
# @sensitive
TEMPORAL_TLS_FRONTEND_KEY=
TEMPORAL_TLS_FRONTEND_CERT_DATA=
# @sensitive
TEMPORAL_TLS_FRONTEND_KEY_DATA=
TEMPORAL_TLS_FRONTEND_SERVER_NAME=
# @type=boolean
TEMPORAL_TLS_FRONTEND_DISABLE_HOST_VERIFICATION=false

# Up to two CAs whose client certificates the frontend will accept when
# TEMPORAL_TLS_REQUIRE_CLIENT_AUTH is on. Setting CLIENT1 is what activates
# the clientCaFiles block at all.
TEMPORAL_TLS_CLIENT1_CA_CERT=
TEMPORAL_TLS_CLIENT2_CA_CERT=
TEMPORAL_TLS_CLIENT1_CA_CERT_DATA=
TEMPORAL_TLS_CLIENT2_CA_CERT_DATA=

# Reload certificates from disk on this interval; 0s never reloads, so rotated
# certs need a restart.
TEMPORAL_TLS_REFRESH_INTERVAL=0s

# Log a warning, then an error, as certificates approach expiry, checked on
# this interval. All 0s means the checks are off.
TEMPORAL_TLS_EXPIRATION_CHECKS_WARNING_WINDOW=0s
TEMPORAL_TLS_EXPIRATION_CHECKS_ERROR_WINDOW=0s
TEMPORAL_TLS_EXPIRATION_CHECKS_CHECK_INTERVAL=0s

# ─── Server: metrics ─────────────────────────────────────────────────────

# host:port the server binds a Prometheus scrape endpoint on. Ignored if
# STATSD_ENDPOINT is set; the two are mutually exclusive and StatsD wins.
# @docs("Cluster monitoring", https://docs.temporal.io/self-hosted-guide/monitoring)
PROMETHEUS_ENDPOINT=
# @type=enum(histogram, timer)
PROMETHEUS_TIMER_TYPE=histogram

# host:port of a StatsD sink. Setting this disables the Prometheus endpoint.
STATSD_ENDPOINT=

# Port for Go's pprof profiling handler. 0 keeps it off; it is unauthenticated
# and should never be exposed.
# @type=port
PPROF_PORT=0

# ─── Web UI: core ────────────────────────────────────────────────────────

# Port the UI listens on, and the port the compose exposes. Change it here
# without changing the exposed port and routing breaks.
# @type=port
# @docs("Web UI configuration reference", https://docs.temporal.io/references/web-ui-configuration)
TEMPORAL_UI_PORT=8080

# Sub-path the UI is served under, for hosting it behind a proxy at
# /temporal rather than at the root. Empty serves at /.
TEMPORAL_UI_PUBLIC_PATH=

# "false" serves only the UI's HTTP API and no web assets, useful when you
# front it with your own client.
# @type=boolean
TEMPORAL_UI_ENABLED=true

# Renders the Temporal Cloud variant of the UI. Leave false for self-hosted.
# @type=boolean
TEMPORAL_CLOUD_UI=false

# Namespace the UI opens on. Must be one that exists, so it tracks
# DEFAULT_NAMESPACE above.
TEMPORAL_DEFAULT_NAMESPACE=default

# Where the UI's "feedback" link points; empty uses the upstream GitHub issue
# tracker.
# @type=url
TEMPORAL_FEEDBACK_URL=

# The UI fetches a release-notes feed from temporal.io on load. Set true to
# stop that outbound call in an isolated network.
# @type=boolean
TEMPORAL_DISABLE_NEWS_FETCH=false

# Start with the left navigation collapsed.
# @type=boolean
TEMPORAL_NAV_COLLAPSED_BY_DEFAULT=false

# Re-read the UI's own config file on this interval. 0s reads it once at
# start, which is right for a container whose config comes from env.
TEMPORAL_CONFIG_REFRESH_INTERVAL=0s

# Show the internal temporal-system namespace in the namespace picker.
# @type=boolean
TEMPORAL_SHOW_TEMPORAL_SYSTEM_NAMESPACE=false

# Suppress the UI's own request logs on stdout.
# @type=boolean
TEMPORAL_HIDE_LOGS=false

# Comma-separated request headers the UI forwards to the frontend, which is
# how an authenticating proxy passes its token through. Empty forwards none.
TEMPORAL_FORWARD_HEADERS=

# ─── Web UI: write actions ───────────────────────────────────────────────

# The blunt read-only switch: "true" disables every mutating action in the UI
# at once. Because the UI has no login of its own, this is the cheapest way to
# make an internally-reachable UI less dangerous, though it does nothing
# about direct gRPC access to port 7233.
# @type=boolean
# @docs("Web UI configuration reference", https://docs.temporal.io/references/web-ui-configuration)
TEMPORAL_DISABLE_WRITE_ACTIONS=false

# The same power, per action, when you want to keep some of it.
# @type=boolean
TEMPORAL_WORKFLOW_TERMINATE_DISABLED=false
# @type=boolean
TEMPORAL_WORKFLOW_CANCEL_DISABLED=false
# @type=boolean
TEMPORAL_WORKFLOW_SIGNAL_DISABLED=false
# @type=boolean
TEMPORAL_WORKFLOW_UPDATE_DISABLED=false
# @type=boolean
TEMPORAL_WORKFLOW_RESET_DISABLED=false
# @type=boolean
TEMPORAL_WORKFLOW_PAUSE_DISABLED=false
# @type=boolean
TEMPORAL_START_WORKFLOW_DISABLED=false
# @type=boolean
TEMPORAL_ACTIVITY_COMMANDS_DISABLED=false

# Batch operations apply an action to every workflow matching a query, so this
# is the one that turns a mistake into a cluster-wide mistake.
# @type=boolean
TEMPORAL_BATCH_ACTIONS_DISABLED=false

# Hide errors raised by workflow queries in the UI, and stop the workflow list
# from re-counting on refresh (a heavy visibility query on large clusters).
# @type=boolean
TEMPORAL_HIDE_WORKFLOW_QUERY_ERRORS=false
# @type=boolean
TEMPORAL_REFRESH_WORKFLOW_COUNTS_DISABLED=false

# ─── Web UI: CORS and cookies ────────────────────────────────────────────

# Comma-separated origins allowed to call the UI's HTTP API. The image default
# is http://localhost:8080; this compose sets http://localhost:3000 instead,
# so a browser app on port 3000 can talk to it. Add your real UI origin here
# rather than reaching for the unsafe switch below.
# @required
# @docs("Web UI configuration reference", https://docs.temporal.io/references/web-ui-configuration)
TEMPORAL_CORS_ORIGINS=http://localhost:3000

# "true" allows every origin. Combined with the UI's lack of authentication,
# any page in the operator's browser can then drive the cluster. Leave false.
# @type=boolean
TEMPORAL_CORS_UNSAFE_ALLOW_ALL_ORIGINS=false

# Drops the Secure flag from the CSRF cookie so the UI works over plain HTTP.
# Only acceptable on a trusted network; over the public internet it makes the
# token interceptable.
# @type=boolean
TEMPORAL_CSRF_COOKIE_INSECURE=false

# ─── Web UI: TLS ─────────────────────────────────────────────────────────

# Client certificate material the UI presents to the frontend when the server
# requires mTLS. Files, or the inline *_DATA equivalents.
TEMPORAL_TLS_CA=
TEMPORAL_TLS_CERT=
# @sensitive
TEMPORAL_TLS_KEY=
TEMPORAL_TLS_CA_DATA=
TEMPORAL_TLS_CERT_DATA=
# @sensitive
TEMPORAL_TLS_KEY_DATA=

# Verify the frontend's certificate against this hostname. Verification is OFF
# by default, which means a UI configured for TLS still accepts any
# certificate until you set it to true.
# @type=boolean
TEMPORAL_TLS_ENABLE_HOST_VERIFICATION=false
TEMPORAL_TLS_SERVER_NAME=

# Certificate for the UI's OWN listener, so port 8080 serves HTTPS rather than
# HTTP. Independent of the client certificates above.
TEMPORAL_UI_SERVER_TLS_CERT=
# @sensitive
TEMPORAL_UI_SERVER_TLS_KEY=

# ─── Web UI: single sign-on ──────────────────────────────────────────────

# Puts a login in front of the UI, via OIDC. This is the only authentication
# the UI has; while it is false the UI is open to anyone who can reach it.
# Note it gates the UI only and does not authenticate the frontend's gRPC
# port, which needs the server-side authorizer above.
# @type=boolean
# @docs("Web UI configuration reference", https://docs.temporal.io/references/web-ui-configuration)
TEMPORAL_AUTH_ENABLED=false

# Skip the UI's own "sign in with" screen and bounce straight to the provider.
# @type=boolean
TEMPORAL_AUTH_REDIRECT_TO_PROVIDER=false

# Label shown on the sign-in button, and the provider protocol. "oidc" is the
# only type the UI implements at this version.
TEMPORAL_AUTH_LABEL=sso
# @type=enum(oidc)
TEMPORAL_AUTH_TYPE=oidc

# Issuer the UI runs OIDC discovery against, e.g.
# https://accounts.google.com or your Keycloak realm URL. Required once
# TEMPORAL_AUTH_ENABLED is true.
# @type=url
TEMPORAL_AUTH_PROVIDER_URL=

# Override the expected `iss` claim when the provider's discovery document
# advertises a different issuer than the URL you dialled. Usually empty.
# @type=url
TEMPORAL_AUTH_ISSUER_URL=

# OAuth client registered with that provider.
TEMPORAL_AUTH_CLIENT_ID=
# @sensitive
TEMPORAL_AUTH_CLIENT_SECRET=

# Redirect URI, which must match the one registered with the provider exactly:
# the UI's public origin plus /auth/sso/callback.
# @type=url
TEMPORAL_AUTH_CALLBACK_URL=

# Comma-separated scopes to request. Providers generally need at least
# openid,email,profile for the UI to identify the user.
TEMPORAL_AUTH_SCOPES=

# Send the OIDC id_token instead of the access token as the bearer credential
# to the frontend. Needed when the server's claim mapper reads id_token
# claims; wrong for most setups.
# @type=boolean
TEMPORAL_AUTH_USE_ID_TOKEN_AS_BEARER=false

# ─── Web UI: codec server ────────────────────────────────────────────────

# Endpoint of a remote codec server, so the UI can decode payloads that
# workers encrypted before storing them. Without it, encrypted workflow inputs
# and results show as opaque blobs, which is the point of encrypting them.
# @type=url
# @docs("Securing your data", https://docs.temporal.io/production-deployment/data-encryption)
TEMPORAL_CODEC_ENDPOINT=

# Forward the caller's access token to the codec server (so it can authorize
# the decode), and send cookies with the browser's decode requests. Both are
# off by default; passing the token means handing a third service a live
# credential, so only enable it for a codec server you run.
# @type=boolean
TEMPORAL_CODEC_PASS_ACCESS_TOKEN=false
# @type=boolean
TEMPORAL_CODEC_INCLUDE_CREDENTIALS=false

# Message and link shown when the codec server cannot be reached; empty uses
# the UI's own wording.
TEMPORAL_CODEC_DEFAULT_ERROR_MESSAGE=
# @type=url
TEMPORAL_CODEC_DEFAULT_ERROR_LINK=

# ─── Container plumbing ──────────────────────────────────────────────────

# Both binaries accept these as fallbacks for their --root and --config flags,
# and they mean different directories in the two images (/etc/temporal for the
# server, /home/ui-server for the UI). A value set here reaches both
# containers and breaks at least one of them, so leave both empty. The related
# TEMPORAL_ENVIRONMENT is inert: both entrypoints pass `--env docker`
# explicitly, and an explicit flag beats the environment.
TEMPORAL_ROOT=
TEMPORAL_CONFIG_DIR=

# Availability zone tag attached to this node's membership entry. Cosmetic for
# a single-host deployment. The misspelled TEMPORAL_AVAILABILTY_ZONE is still
# accepted as an alias at this version.
TEMPORAL_AVAILABILITY_ZONE=
