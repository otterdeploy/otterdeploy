# RustFS 1.0.0-rc.5 environment schema (@env-spec / varlock format).
#
# STABILITY: RustFS has never shipped a stable release. Every tag the project
# has ever published is a GitHub *prerelease*: 1.0.0-beta.1 … beta.12, then
# 1.0.0-rc.1 … rc.5 (2026-09-02, the newest at research time on 2026-09-04).
# There is no 1.0.0 GA. Its own SECURITY.md supports only "Latest" and marks
# "< 1.0" unsupported, which for now means: only the newest prerelease gets
# security fixes. This is a pre-1.0 object store; treat data on it as
# replaceable and keep a second copy elsewhere.
#
# The template previously pinned `rustfs/rustfs:latest`. On Docker Hub that
# tag still resolves to 1.0.0-beta.12 (pushed 2026-07-30,
# sha256:41fe89380f4120a337790c02af192c3fe7bb55c3edc2e6e9357b487b47c6ab21),
# five releases and five weeks stale, and a BETA rather than an RC. The
# compose now pins 1.0.0-rc.5
# (sha256:c36b3efea3d1e503f1a2581abd0e7611e0e5820dd30e1850a52384b3fc52bda4,
# linux/amd64 + linux/arm64), which is also the version the project's own
# README quickstart names. rc.5 was taken over the more-matured rc.3/rc.4
# because it carries security work beta.12 lacks: internode PUT bodies are
# authenticated (rc.2, PR #5868), outbound URLs are validated for every warm
# backend (rc.5, PR #6764), the yanked chacha20 0.10.1 dependency is dropped
# (rc.5, PR #6768), auth_token redaction in audit/notify config was fixed
# (rc.5, PR #6816), and startup no longer panics when the system CA bundle is
# missing (rc.5, PR #6769).
#
# Source: `#[arg(env = "…")]` on `ServerOpts` in rustfs/src/config/cli.rs,
# `pub const ENV_*` in crates/config/src/{constants,observability,notify,
# audit}/, crates/credentials/src/constants.rs, crates/utils/src/egress.rs,
# and `env::var` reads in crates/ecstore/, all at tag 1.0.0-rc.5; plus the
# image's own `entrypoint.sh` and the `ENV` block in its Dockerfile.
# Cross-checked against docs.rustfs.com/en/reference/environment-variables.
#
# Two things the docs do not make obvious:
#  1. The image bakes five variables at build time that no compose sets:
#     RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS="*" (the code's own default is ""),
#     RUSTFS_VOLUMES=/data, RUSTFS_OBS_LOGGER_LEVEL=warn,
#     RUSTFS_OBS_LOG_DIRECTORY=/logs, RUSTFS_OBS_ENVIRONMENT=production.
#     The CORS one is the notable change in posture: the running container
#     answers console requests from ANY origin unless you set it back.
#  2. RustFS reads MINIO_-prefixed variables too: at startup
#     `apply_external_env_compat()` (crates/utils/src/envs.rs) copies any
#     MINIO_<SUFFIX> whose suffix is on its allow-list into RUSTFS_<SUFFIX>
#     when the RUSTFS_ name is unset. That is a migration aid; RUSTFS_* wins
#     on conflict. Do not assume the rest of MinIO's variable names transfer;
#     they do not, and the ones below are RustFS's own.

# @defaultSensitive=false @defaultRequired=infer
# @docs("RustFS environment variable reference", https://docs.rustfs.com/en/reference/environment-variables)
# ---

# ─── Root credentials ──────────────────────────────────────────────────────

# The root access key ("username") for BOTH the S3 API on :9000 and the web
# console on :9001. The compose supplies it from the RUSTFS_ACCESS_KEY prompt.
#
# READ THIS: if you leave it unset, RustFS falls back to the built-in default
# `rustfsadmin` (crates/credentials/src/constants.rs, DEFAULT_ACCESS_KEY),
# and DEFAULT_SECRET_KEY is the same literal, `rustfsadmin`. The container
# still starts; the entrypoint only prints a WARNING. An instance left on
# that pair lets anyone who can reach either port sign in, list every bucket,
# read every object, and delete all of it. Set both, to values nobody else
# has. Note the entrypoint treats a present-but-EMPTY value as a hard error
# (exit 1), so an unexpanded interpolation fails loudly rather than silently
# running with a blank credential.
# @required
# @sensitive
# @docs("Credential management", https://docs.rustfs.com/en/operations/credentials)
RUSTFS_ACCESS_KEY=${RUSTFS_ACCESS_KEY}

# The root secret key, supplied by the compose from the RUSTFS_SECRET_KEY
# prompt. Same warning as above: the built-in fallback is the literal
# `rustfsadmin`. Generate it (`openssl rand -base64 24`), never reuse it.
# Rotating it later invalidates every presigned URL and console session
# derived from it.
# @required
# @sensitive
RUSTFS_SECRET_KEY=${RUSTFS_SECRET_KEY}

# Docker-secrets variants: RustFS reads the credential from the file at this
# path instead of from the variable. Setting a key AND its _FILE twin is a
# hard error at boot ("Set either … or …, not both"), as is pointing at an
# unreadable or empty file.
RUSTFS_ACCESS_KEY_FILE=
# @sensitive
RUSTFS_SECRET_KEY_FILE=

# Deprecated aliases, still honoured at this version: if the canonical
# RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY are unset, these are used and a
# "deprecated and will be removed at GA" warning is logged
# (rustfs/src/config/config_struct.rs). Their MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD twins feed the same path through the compat shim.
# Prefer the canonical names; these exist only for migrating an old config.
RUSTFS_ROOT_USER=
# @sensitive
RUSTFS_ROOT_PASSWORD=

# Shared secret for internode RPC auth in a MULTI-NODE cluster. Unset, it is
# derived from the access/secret key pair, which fails closed when that pair
# is still the all-default `rustfsadmin`, so a clustered deployment on
# default credentials cannot authenticate internode traffic at all. Single
# node: leave empty.
# @sensitive
# @docs("High availability", https://docs.rustfs.com/en/operations/high-availability)
RUSTFS_RPC_SECRET=

# ─── Server & storage ──────────────────────────────────────────────────────

# The disk path(s) holding object data, set by the compose to the container
# path the `rustfs-data` named volume is mounted at. Multiple volumes are
# space- or comma-separated, and the entrypoint expands `{0...3}` ranges
# (single-node erasure) and `http://host{1...4}:9000/data` forms
# (distributed). Changing this without moving the volume mount orphans the
# data that is already there.
# @required
# @docs("Docker installation", https://docs.rustfs.com/en/installation/container/docker)
RUSTFS_VOLUMES=/data

# ADDRESS:PORT for the S3 API. The compose binds all interfaces on 9000 so
# the platform can route to it; the binary's own default is `:9000`. This
# port speaks S3 only: a browser GET on it correctly answers AccessDenied.
RUSTFS_ADDRESS=0.0.0.0:9000

# Domain name(s) for virtual-hosted-style S3 addressing (comma-separated),
# e.g. `s3.example.com` so that `bucket.s3.example.com` routes to `bucket`.
# Empty means path-style ONLY: clients that default to virtual-hosted style
# (AWS SDKs, Terraform, Pulumi) must be configured with force_path_style /
# s3_use_path_style = true, or they will fail to resolve buckets.
RUSTFS_SERVER_DOMAINS=

# S3 region name used for SigV4 signing. Empty resolves to `us-east-1`
# (crates/config/src/constants/app.rs, RUSTFS_REGION). Clients must be
# configured with the same value or every signature mismatches.
RUSTFS_REGION=

# Number of drives per erasure set. Empty lets RustFS derive the layout from
# the volume list; with the single `/data` volume this template ships there
# is no erasure coding at all, just one disk and no redundancy. Only set this
# when you have given RUSTFS_VOLUMES several distinct disks.
# @type=number
RUSTFS_ERASURE_SET_DRIVE_COUNT=

# Skips the startup topology/disk sanity checks. `true` is documented by
# upstream as local testing only. It lets a mis-specified or partially
# mounted disk set come up and start accepting writes.
# @type=boolean
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=false

# fsync policy for object data writes: `strict` (default, every commit is
# synced), `relaxed`, or `none`. Anything other than strict trades
# power-loss durability for throughput. The legacy
# RUSTFS_DRIVE_SYNC_ENABLE=false switch disables fsync everywhere including
# system metadata; this variable supersedes it and wins when both are set.
# @type=enum(strict, relaxed, none)
# @docs("Durability modes", https://github.com/rustfs/rustfs/blob/1.0.0-rc.5/docs/operations/durability-modes.md)
RUSTFS_DURABILITY_MODE=strict

# ─── Console (web admin UI) ────────────────────────────────────────────────

# Runs the web administration console. The compose enables it and makes 9001
# the primary published port, so the generated domain lands on the UI. The
# console signs in with the SAME root access key / secret key as the S3 API,
# which is exactly why those two must not be left at `rustfsadmin`: the
# console is a full admin surface (buckets, objects, IAM users, policies).
# Set to false to take the UI off the network entirely and drive the server
# with the `rc` CLI or an S3 SDK instead.
# @type=boolean
# @docs("Console", https://docs.rustfs.com/en/administration/console)
RUSTFS_CONSOLE_ENABLE=true

# ADDRESS:PORT for the console. The compose binds all interfaces on 9001;
# the binary's own default is `:9001`. Change it and the published port has
# to change with it or the UI becomes unreachable.
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001

# Cross-origin allow-list for the console API. The CODE default is "" (same
# origin only), but the published image overrides it to `*` in its
# Dockerfile ENV, so as shipped, any web page on any origin can make
# credentialed-looking calls to the console API of a console the browser is
# logged into. Set your own origin (or `""`) here to close that back down.
# @docs("CORS configuration", https://docs.rustfs.com/en/administration/cors)
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=

# Same idea for the S3 endpoint itself; the code default is empty, meaning
# no generic CORS headers are emitted unless configured. The image does NOT
# override this one.
RUSTFS_CORS_ALLOWED_ORIGINS=

# How long a console sign-in stays valid, in seconds. Default 3600 (1 hour);
# accepted range is 300 to 86400.
# @type=number
RUSTFS_CONSOLE_AUTH_TIMEOUT=3600

# Per-client-IP rate limiting on the console. Off by default, which leaves
# the login form open to unlimited credential guessing from one address.
# Worth turning on for any console reachable from the internet.
# @type=boolean
RUSTFS_CONSOLE_RATE_LIMIT_ENABLE=false
# Requests per minute per client IP once the limiter is enabled.
# @type=number
RUSTFS_CONSOLE_RATE_LIMIT_RPM=100

# ─── S3 API limits ─────────────────────────────────────────────────────────

# Rate limiting for the S3 API on :9000, separate from the console limiter.
# Disabled by default, and the RPM/burst defaults of 0 mean "no limit", so
# enabling the switch alone changes nothing until you set a number.
# @type=boolean
RUSTFS_API_RATE_LIMIT_ENABLE=false
# @type=number
RUSTFS_API_RATE_LIMIT_RPM=0
# @type=number
RUSTFS_API_RATE_LIMIT_BURST=0
# Same pair, applied per bucket rather than per instance.
# @type=number
RUSTFS_API_RATE_LIMIT_BUCKET_RPM=0
# @type=number
RUSTFS_API_RATE_LIMIT_BUCKET_BURST=0

# Cap on concurrent API connections. 0 is unlimited.
# @type=number
RUSTFS_API_MAX_CONNECTIONS=0

# ─── TLS ───────────────────────────────────────────────────────────────────

# Directory inside the container holding `rustfs_cert.pem` and
# `rustfs_key.pem`. Setting it makes RustFS terminate HTTPS itself on BOTH
# the API and the console; leaving it empty means plaintext HTTP inside the
# container, which is the right choice when otterdeploy's proxy already
# terminates TLS in front of it. If you do mount certs, the directory must
# be readable by uid/gid 10001 (the non-root `rustfs` user the image runs
# as) or startup fails with permission denied.
# @docs("TLS configuration", https://docs.rustfs.com/en/integration/tls-configured)
RUSTFS_TLS_PATH=

# Picks up rotated certificates from RUSTFS_TLS_PATH without a restart.
# @type=boolean
RUSTFS_TLS_RELOAD_ENABLE=false

# Writes TLS pre-master secrets to an SSLKEYLOGFILE-style file so captured
# traffic can be decrypted. A debugging tool; anything that can read that
# file can read your traffic. Never enable on a live instance.
# @type=boolean
RUSTFS_TLS_KEYLOG=false

# Outbound TLS trust for RustFS's own client connections (replication
# targets, tiering backends, webhooks). Default false means only the CA
# material you supply is trusted, not the container's system bundle.
# @type=boolean
RUSTFS_TRUST_SYSTEM_CA=false
# Extra CA certificate (PEM) to trust for those outbound connections.
RUSTFS_EXTRA_CA_CERT=
# Accepts a target's own leaf certificate as its CA, a self-signed-cert
# shortcut that removes the chain check for that connection.
# @type=boolean
RUSTFS_TRUST_LEAF_CERT_AS_CA=false

# Mutual TLS: require client certificates on the server side, and present
# these when RustFS is the client. Requires RUSTFS_TLS_PATH to be set.
# @type=boolean
RUSTFS_SERVER_MTLS_ENABLE=false
RUSTFS_MTLS_CLIENT_CERT=
# @sensitive
RUSTFS_MTLS_CLIENT_KEY=

# ─── Server-side encryption (KMS) ──────────────────────────────────────────
# Objects are stored unencrypted at rest unless this is turned on.

# Master switch for SSE. Off by default.
# @type=boolean
# @docs("Data encryption", https://docs.rustfs.com/en/security-compliance/encryption)
RUSTFS_KMS_ENABLE=false
# Key backend. `local` (the default) and `static` are labelled
# development/testing only in the CLI's own help text; `vault`, `vault-kv2`,
# `vault-transit` and `aws` are the production options.
# @type=enum(local, static, vault, vault-kv2, vault-transit, aws)
RUSTFS_KMS_BACKEND=local
# Directory holding key files for the local backend. Put it on a path that
# is NOT the same volume as the objects it encrypts.
RUSTFS_KMS_KEY_DIR=
# Master key that encrypts the local backend's key files. Lose it and every
# encrypted object is unrecoverable.
# @sensitive
RUSTFS_KMS_LOCAL_MASTER_KEY=
# @type=url
RUSTFS_KMS_VAULT_ADDRESS=
# @sensitive
RUSTFS_KMS_VAULT_TOKEN=
RUSTFS_KMS_VAULT_MOUNT_PATH=
# Key ID used when a request asks for SSE without naming a key.
RUSTFS_KMS_DEFAULT_KEY_ID=
# Lets the KMS start with built-in development key material instead of
# refusing to boot. Exactly what it says: insecure, dev only.
# @type=boolean
RUSTFS_KMS_ALLOW_INSECURE_DEV_DEFAULTS=false

# ─── Event notifications ───────────────────────────────────────────────────
# Instance-scoped: each target gets a suffix, and `_PRIMARY` is the
# conventional first one (ARN `arn:rustfs:sqs::primary:webhook`). The
# unsuffixed names below are the base forms the code registers; the
# `_PRIMARY` spellings are what you actually set.

# Global switch for the notify subsystem. Off by default; none of the target
# settings do anything until this is true.
# @type=boolean
# @docs("Event notifications", https://docs.rustfs.com/en/operations/event-notifications)
RUSTFS_NOTIFY_ENABLE=false
# Enables the primary webhook target. Accepts on/true/1.
RUSTFS_NOTIFY_WEBHOOK_ENABLE_PRIMARY=
# @type=url
RUSTFS_NOTIFY_WEBHOOK_ENDPOINT_PRIMARY=
# Bearer token sent with each webhook POST.
# @sensitive
RUSTFS_NOTIFY_WEBHOOK_AUTH_TOKEN_PRIMARY=
# On-disk spool for events that could not be delivered. Defaults to
# /opt/rustfs/events, which must be writable by uid 10001.
RUSTFS_NOTIFY_WEBHOOK_QUEUE_DIR_PRIMARY=
# @type=number
RUSTFS_NOTIFY_WEBHOOK_QUEUE_LIMIT_PRIMARY=
# Turns off certificate verification for the webhook connection, which
# allows a MITM to read every event; RustFS logs a startup warning when it
# is on. Use RUSTFS_NOTIFY_WEBHOOK_CLIENT_CA_PRIMARY for a private CA
# instead.
# @type=boolean
RUSTFS_NOTIFY_WEBHOOK_SKIP_TLS_VERIFY_PRIMARY=false
RUSTFS_NOTIFY_WEBHOOK_CLIENT_CA_PRIMARY=
RUSTFS_NOTIFY_WEBHOOK_CLIENT_CERT_PRIMARY=
# @sensitive
RUSTFS_NOTIFY_WEBHOOK_CLIENT_KEY_PRIMARY=

# Since 1.0.0-beta.11, webhook and other outbound targets pointing at a
# private or container network (compose service names, host.docker.internal,
# RFC 1918 addresses) are BLOCKED unless their exact `scheme://host:port`
# origin (origin only, no path) is listed here, comma-separated. This is
# the SSRF guard; a webhook to a sibling service in the same stack will not
# fire until you add it.
# @docs("Outbound connection policy", https://github.com/rustfs/rustfs/blob/1.0.0-rc.5/docs/operations/outbound-connection-policy.md)
RUSTFS_OUTBOUND_ALLOW_ORIGINS=

# ─── Audit logging ─────────────────────────────────────────────────────────

# Global switch for audit targets (webhook, Kafka, MySQL, Postgres, MQTT,
# AMQP, …), each configured with its own RUSTFS_AUDIT_<TARGET>_*_<INSTANCE>
# variables. Off by default, so nothing records who deleted what until you
# turn it on and point it somewhere.
# @type=boolean
# @docs("Audit targets", https://docs.rustfs.com/en/security-compliance/audit-logs)
RUSTFS_AUDIT_ENABLE=false

# ─── Observability & logging ───────────────────────────────────────────────

# OTLP/HTTP base URL for traces, metrics and logs, e.g.
# http://otel-collector:4318. Empty disables OTLP export.
# @type=url
# @docs("Observability", https://docs.rustfs.com/en/operations/observability)
RUSTFS_OBS_ENDPOINT=

# Log verbosity. The binary's own default is `error`; the published image
# overrides it to `warn` in its Dockerfile ENV, so `warn`, not `error`, is
# what you get unless you set this.
# @type=enum(trace, debug, info, warn, error)
RUSTFS_OBS_LOGGER_LEVEL=

# Directory for rotated log files. The image bakes `/logs` (created and
# owned by uid 10001). This template mounts no volume there, so logs live
# in the container's writable layer and vanish on recreate. Set this to a
# path on a mounted volume if you need them to survive.
RUSTFS_OBS_LOG_DIRECTORY=

# Environment label attached to exported telemetry. The image bakes
# `production`.
# @type=enum(production, development, staging, test)
RUSTFS_OBS_ENVIRONMENT=

# Mirrors log lines to stdout so `docker logs` shows them. Default false,
# which is why an otherwise healthy container can look silent.
# @type=boolean
RUSTFS_OBS_LOG_STDOUT_ENABLED=false

# Service name reported to the tracing backend.
RUSTFS_OBS_SERVICE_NAME=

# Serves the /health readiness and liveness endpoints. On by default.
# @type=boolean
RUSTFS_HEALTH_ENDPOINT_ENABLE=true

# ─── Tuning & licensing ────────────────────────────────────────────────────

# Adaptive buffer sizing profile for the data path.
# @type=enum(GeneralPurpose, AiTraining, DataAnalytics, WebWorkload, IndustrialIoT, SecureStorage)
RUSTFS_BUFFER_PROFILE=GeneralPurpose
# Reverts to the legacy fixed-size buffers, ignoring the profile above.
# @type=boolean
RUSTFS_BUFFER_PROFILE_DISABLE=false

# License key for RustFS's commercial features. The open-source build runs
# without it.
# @sensitive
RUSTFS_LICENSE=
