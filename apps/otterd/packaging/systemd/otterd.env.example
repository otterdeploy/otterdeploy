# /etc/otterd/otterd.env (mode 0600). Every setting also has a command-line flag;
# see `otterd run --help`.

# The control plane, from the enrollment certificate (`otterd init` prints it).
OTTERD_CONTROL_URL=wss://cp.example.com/api/otterd/connect
# A self-hosted control plane with its own certificate authority:
#OTTERD_CONTROL_CA=/etc/otterd/control-ca.pem
#OTTERD_CONTROL_CA_ONLY=true

#OTTERD_JOURNAL=/var/lib/otterd/journal/node.journal
#OTTERD_KEYS_DIR=/etc/otterd/keys
#OTTERD_SOCKET=/run/otterd/otterd.sock
#OTTERD_STAGING_ROOT=/run/otterd/stage
#OTTERD_DOCKER_SOCKET=/var/run/docker.sock
#OTTERD_RECONCILE_MS=2000
#OTTERD_STOP_GRACE_S=10
#RUST_LOG=info
