# /etc/otterd/otterd.env (mode 0600). Every setting also has a command-line flag;
# see `otterd run --help`.

# The control plane, from the enrollment certificate (`otterd init` prints it).
OTTERD_CONTROL_URL=wss://cp.example.com/api/otterd/connect
# A self-hosted control plane with its own certificate authority:
#OTTERD_CONTROL_CA=/etc/otterd/control-ca.pem
#OTTERD_CONTROL_CA_ONLY=true

#OTTERD_JOURNAL=/var/lib/otterd/journal/node.journal
#OTTERD_KEYS_DIR=/etc/otterd/keys
#OTTERD_SOCKET=/run/otterd/otterd.sock
#OTTERD_STAGING_ROOT=/run/otterd/stage
#OTTERD_DOCKER_SOCKET=/var/run/docker.sock
#OTTERD_RECONCILE_MS=2000
#OTTERD_STOP_GRACE_S=10
# The workload network: endpoint book and VIP receiver state, the zone the
# otterd-dns responder serves, and the responder binary its unit runs.
#OTTERD_NET_STATE=/var/lib/otterd/net
#OTTERD_DNS_ZONE=/var/lib/otterd/dns/zone.json
#OTTERD_DNS_BINARY=/usr/lib/otterd/otterd-dns
# The packet policy otterd writes (default: policy.json under OTTERD_NET_STATE)
# and the otterd-net binary that applies it (see otterd-net.service).
#OTTERD_NET_POLICY=/var/lib/otterd/net/policy.json
#OTTERD_NET_BINARY=/usr/lib/otterd/otterd-net
# The edge proxy's bridges, comma-separated interface names (the installer
# writes them): their flows to a VIP reach the VIP's backends.
#OTTERD_EDGE_BRIDGES=
#RUST_LOG=info
