# otterdeploy adversarial test lab: environment schema (@env-spec / varlock format).
#
# Every secret the lab needs resolves from Infisical (self-hosted, project
# otter-lab). The ONLY values that live outside Infisical are the
# machine-identity credentials that unlock it:
#   - locally: export them in your shell (never commit them)
#   - CI: GitHub environment `lab` secrets INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET
#
# Expected secrets in the project, folder /otter-lab (environment LAB_INFISICAL_ENV):
#   HCLOUD_TOKEN   Hetzner Cloud API token (project otter-lab)
#   CF_DNS_TOKEN   Cloudflare token, Zone:DNS:Edit on otterstack.dev
#   CF_ZONE_ID     Cloudflare zone id of otterstack.dev
#
# Run anything that needs lab secrets through varlock:
#   bun varlock run -p ./test-infra/lab -- <command>
#
# @defaultRequired=infer
# @defaultSensitive=true
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=0a94327e-0b0a-4284-a5de-1248c282d677,
#   environment=$LAB_INFISICAL_ENV,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET,
#   secretPath=/otter-lab,
#   siteUrl=https://infisical.dr34mw0rk5.com
# )
# ---

# ============================================================
# Infisical bootstrap (set in shell env / CI secrets, not in Infisical)
# Plain strings on purpose: the plugin's own credential types are marked
# internal and would be dropped from the env handed to child processes.
# ============================================================

# Infisical environment slug inside the otter-lab project.
# @sensitive=false
LAB_INFISICAL_ENV=prod

# @sensitive=false
INFISICAL_CLIENT_ID=

INFISICAL_CLIENT_SECRET=

# ============================================================
# Hetzner Cloud (project: otter-lab)
# ============================================================

HCLOUD_TOKEN=infisical()

# ============================================================
# DNS: domain A (Cloudflare zone otterstack.dev)
# Per-run records live under LAB_DNS_SUFFIX, e.g. cp.<run>.lab.otterstack.dev
# ============================================================

CF_DNS_TOKEN=infisical()

# @sensitive=false
CF_ZONE_ID=infisical()

# @sensitive=false
LAB_DNS_SUFFIX=lab.otterstack.dev

# ============================================================
# Cost guards
# ============================================================

# Hard monthly ceiling; a run refuses to start once spend would exceed it.
# @sensitive=false @type=number
LAB_BUDGET_EUR=60

# Every lab resource carries an `expires` label this many minutes ahead;
# the sweeper deletes anything past it even if a run crashed.
# @sensitive=false @type=number
LAB_MAX_RUN_MINUTES=240

# ============================================================
# Later (not needed for the first smoke run): private artifact bucket.
# ============================================================

# @optional @sensitive=false
LAB_BUCKET_ENDPOINT=
# @optional @sensitive=false
LAB_BUCKET_NAME=
# @optional
LAB_BUCKET_ACCESS_KEY=
# @optional
LAB_BUCKET_SECRET_KEY=
